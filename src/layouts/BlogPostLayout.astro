---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  lastModified?: Date;
  author: string;
  authorUrl?: string;
  category: string;
  image: string;
  imageAlt: string;
  keywords: string[];
  slug: string;
  faq?: { question: string; answer: string }[];
}

const { title, description, date, lastModified, author, authorUrl, category, image, imageAlt, keywords, slug, faq } = Astro.props;

const canonical = `https://jraftcreative.com/blog/${slug}/`;
const ogImage = `https://jraftcreative.com${image}`;
const formattedDate = date.toLocaleDateString('en-SG', { year: 'numeric', month: 'long', day: 'numeric' });
const isoDate = date.toISOString();
const isoModified = lastModified ? lastModified.toISOString() : isoDate;

// Author lookup — maps frontmatter author string to a Person (or Organization) schema record.
// Add a new entry here when a new named author joins. If author isn't in the table,
// we fall back to the Jraft Creative Organization — never fabricate a Person.
const orgRef = {
  '@type': 'Organization',
  name: 'Jraft Creative Pte. Ltd.',
  url: 'https://jraftcreative.com/',
};

const authorRecords: Record<string, Record<string, unknown>> = {
  'Jeremy Cheong': {
    '@type': 'Person',
    '@id': 'https://jraftcreative.com/about/#jeremy-cheong',
    name: 'Jeremy Cheong',
    jobTitle: 'Founder & Managing Director',
    url: 'https://jraftcreative.com/about/jeremy/',
    worksFor: orgRef,
    sameAs: ['https://www.linkedin.com/in/jeremycheong'],
  },
  'Jeevan Aurol': {
    '@type': 'Person',
    '@id': 'https://jraftcreative.com/about/#jeevan-aurol',
    name: 'Jeevan Aurol',
    jobTitle: 'Account Director',
    url: 'https://jraftcreative.com/about/',
    worksFor: orgRef,
  },
};

const orgAuthor = {
  '@type': 'Organization',
  name: 'Jraft Creative',
  url: authorUrl
    ? (authorUrl.startsWith('http') ? authorUrl : `https://jraftcreative.com${authorUrl}`)
    : 'https://jraftcreative.com/about/',
};

const authorSchema = authorRecords[author] ?? orgAuthor;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  image: ogImage,
  datePublished: isoDate,
  dateModified: isoModified,
  author: authorSchema,
  publisher: {
    '@type': 'Organization',
    name: 'Jraft Creative',
    url: 'https://jraftcreative.com',
    logo: {
      '@type': 'ImageObject',
      url: 'https://jraftcreative.com/images/logo.png',
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonical,
  },
  keywords: keywords.join(', '),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://jraftcreative.com/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://jraftcreative.com/blog/' },
    { '@type': 'ListItem', position: 3, name: title, item: canonical },
  ],
};

// FAQ schema — only emitted when the post supplies faq entries, and it must
// mirror the visible FAQ accordion below exactly (Google penalises schema that
// doesn't match on-page content). Posts without faq are unaffected.
const faqSchema = faq && faq.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: f.answer },
      })),
    }
  : null;

const schemaData = faqSchema
  ? [articleSchema, breadcrumbSchema, faqSchema]
  : [articleSchema, breadcrumbSchema];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogTitle={title}
  ogDescription={description}
  ogImage={ogImage}
  ogType="article"
  keywords={keywords.join(', ')}
  schemaData={schemaData}
>
  <article class="blog-post">
    <div class="blog-post-hero">
      <div class="blog-post-hero-bg">
        <img src={image} alt={imageAlt} width="1200" height="630" loading="eager" class="blog-post-hero-img">
      </div>
      <div class="container">
        <nav class="blog-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">/</span>
          <a href="/blog/">Blog</a>
          <span aria-hidden="true">/</span>
          <span>{title}</span>
        </nav>
        <div class="blog-post-meta">
          <span class="blog-post-category">{category}</span>
          <time datetime={isoDate}>{formattedDate}</time>
          <span class="blog-post-author">By <a href={authorUrl || '/about/'}>{author}</a></span>
        </div>
        <h1>{title}</h1>
        <p class="blog-post-description">{description}</p>
      </div>
    </div>
    <div class="container blog-post-content">
      <slot />
    </div>
    {faq && faq.length > 0 && (
      <div class="container blog-post-faq">
        <h2>Frequently Asked Questions</h2>
        <div class="faq-list">
          {faq.map((f) => (
            <details class="faq-item">
              <summary>{f.question}</summary>
              <p>{f.answer}</p>
            </details>
          ))}
        </div>
      </div>
    )}
  </article>

  <style>
    .blog-post-faq {
      max-width: 760px;
      margin: 0 auto;
      padding: 1rem 1.25rem 3.5rem;
    }
    .blog-post-faq > h2 {
      font-size: 1.6rem;
      margin: 0 0 1.5rem;
      color: #1F1F1F;
    }
    .faq-list {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }
    .faq-item {
      border: 1px solid #e6e8e7;
      border-radius: 10px;
      background: #fff;
      overflow: hidden;
    }
    .faq-item > summary {
      cursor: pointer;
      list-style: none;
      padding: 1.05rem 1.25rem;
      font-weight: 600;
      color: #1F1F1F;
      position: relative;
      padding-right: 2.75rem;
    }
    .faq-item > summary::-webkit-details-marker { display: none; }
    .faq-item > summary::after {
      content: '+';
      position: absolute;
      right: 1.25rem;
      top: 50%;
      transform: translateY(-50%);
      font-size: 1.4rem;
      line-height: 1;
      color: #39BB9D;
      transition: transform 0.2s ease;
    }
    .faq-item[open] > summary::after {
      content: '\2212';
    }
    .faq-item > p {
      margin: 0;
      padding: 0 1.25rem 1.2rem;
      color: #4a4f4d;
      line-height: 1.7;
    }
    @media (prefers-color-scheme: dark) {
      .blog-post-faq > h2 { color: #f5f5f5; }
      .faq-item { background: #1b1b1b; border-color: #2c2c2c; }
      .faq-item > summary { color: #f5f5f5; }
      .faq-item > p { color: #c4c9c7; }
    }
  </style>

  <!-- WhatsApp Button -->
  <a href={`https://wa.me/6582234578?text=${encodeURIComponent(`Hi, I just read your blog post "${title}" and have a question.`)}`} class="whatsapp-btn" target="_blank" rel="noopener" aria-label="Chat on WhatsApp" slot="after-footer">
    <svg viewBox="0 0 32 32" width="28" height="28" fill="#fff" aria-hidden="true"><path d="M16.004 0h-.008C7.174 0 0 7.176 0 16.004c0 3.5 1.13 6.742 3.05 9.378L1.054 31.29l6.118-1.962A15.91 15.91 0 0 0 16.004 32C24.826 32 32 24.826 32 16.004S24.826 0 16.004 0zm9.302 22.602c-.39 1.1-2.276 2.106-3.156 2.17-.796.058-1.78.082-2.872-.278a26.3 26.3 0 0 1-2.6-1.074c-4.576-2.186-7.566-6.826-7.796-7.142-.222-.316-1.836-2.478-1.836-4.726 0-2.248 1.162-3.356 1.574-3.814.39-.434.858-.542 1.144-.542.286 0 .572.004.82.014.264.012.618-.1.966.738.39.938 1.294 3.224 1.408 3.458.112.234.19.508.038.82-.15.316-.226.512-.448.79-.222.278-.468.62-.668.832-.222.234-.454.49-.196.962.26.47 1.154 1.906 2.478 3.088 1.702 1.52 3.136 1.99 3.582 2.214.448.222.708.19.968-.114.26-.306 1.118-1.302 1.416-1.75.298-.448.596-.37.998-.222.404.148 2.566 1.21 3.006 1.432.44.222.734.334.844.518.112.186.112 1.074-.278 2.174z"/></svg>
  </a>
</BaseLayout>
