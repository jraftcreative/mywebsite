---
import ServiceLayout from '../layouts/ServiceLayout.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Coding School Website Design Singapore",
    "description": "Custom website design for coding schools, robotics academies and STEM programmes in Singapore — course pages by age and level, instructor profiles, student project showcases, holiday camp registration, and trial class booking.",
    "provider": {
      "@type": "Organization",
      "name": "Jraft Creative",
      "url": "https://jraftcreative.com/",
      "logo": "https://jraftcreative.com/images/logo.png",
      "telephone": "+6582234578",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "60 Paya Lebar Road, Paya Lebar Square",
        "postalCode": "409051",
        "addressLocality": "Singapore",
        "addressCountry": "SG"
      }
    },
    "areaServed": { "@type": "Country", "name": "Singapore" },
    "serviceType": "Coding School Website Design"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How much does a coding school website cost in Singapore?", "acceptedAnswer": { "@type": "Answer", "text": "Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote." } },
      { "@type": "Question", "name": "Can you add online trial class and holiday camp booking to our coding school website?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We build booking flows that let parents browse courses by age group, pick a preferred timing, and book a trial class or register for a holiday camp directly through your website. The form captures the child's age, coding experience, and preferred programme — so you receive qualified enquiries instead of vague messages, with automated confirmations that cut admin work for your front desk." } },
      { "@type": "Question", "name": "Can you build a student project showcase into our website?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We build dedicated showcase sections where completed student work — Scratch games, Python apps, robotics builds, and AI projects — is displayed with descriptions, screenshots, and embedded demos. Seeing tangible work gives parents confidence in what their child will learn, and featuring current students' projects motivates the rest of the class." } },
      { "@type": "Question", "name": "Can you help our coding school rank for 'coding class for kids near me' on Google?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We optimise your website for the terms parents actually search — like 'coding class for kids Tampines', 'robotics course Bishan', or 'Python class for children Singapore'. This includes on-page SEO, schema markup for educational organisations, Google Business Profile optimisation, and location-targeted content for each neighbourhood you serve, from Bukit Timah and Jurong to Punggol and Novena." } },
      { "@type": "Question", "name": "How long does it take to build a coding school website?", "acceptedAnswer": { "@type": "Answer", "text": "Most coding school websites go live within 2 weeks. Sites with individual course pages, project galleries, and trial booking typically take about 3 weeks, while larger builds with age-group learning pathways, holiday camp sections, and student portals take 4–5 weeks. We provide a clear timeline before starting so you can plan around your term and camp calendar." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "Coding School Website Singapore", "item": "https://jraftcreative.com/coding-school-website-singapore/" }
    ]
  }
];
---

<style is:global>
  /* Hide the global background grid pattern on this page only */
  .animated-bg__grid { display: none; }

  /* More-prominent related-service pills — match challenge-card-v2 green treatment */
  #related-services .related-service-link {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.35);
    color: var(--text);
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  #related-services .related-service-link:hover {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.22) 0%, rgba(73, 184, 137, 0.1) 100%), rgba(20, 28, 32, 0.7);
    border-color: rgba(73, 184, 137, 0.6);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(73, 184, 137, 0.3);
  }

  /* Separate the CTA section from related-services with bg-alt */
  .service-cta-section {
    background: var(--bg-alt) !important;
  }

  /* Trial-to-Enrolment Funnel — 5-stage horizontal flow with green accents */
  .renovation-funnel {
    list-style: none;
    padding: 0;
    margin: 56px 0 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 48px;
    counter-reset: funnel;
  }
  .funnel-stage {
    position: relative;
    text-align: center;
    padding: 28px 20px;
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.28);
    border-radius: 12px;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .funnel-stage:hover {
    transform: translateY(-4px);
    border-color: rgba(73, 184, 137, 0.55);
    box-shadow: 0 16px 40px -16px rgba(73, 184, 137, 0.3);
  }
  .funnel-stage h3 {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--accent);
    margin: 0 0 8px 0;
    letter-spacing: -0.01em;
  }
  .funnel-stage p {
    font-size: 0.82rem;
    color: var(--text);
    line-height: 1.5;
    margin: 0;
  }
  .funnel-stage:not(:last-child)::after {
    content: '→';
    position: absolute;
    right: -34px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--accent);
    font-size: 1.6rem;
    font-weight: 500;
    z-index: 2;
    line-height: 1;
    opacity: 0.7;
  }
  @media (max-width: 900px) {
    .renovation-funnel {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }
    .funnel-stage:nth-child(2n)::after,
    .funnel-stage:last-child::after {
      display: none;
    }
    .funnel-stage:nth-child(2n-1)::after {
      right: -22px;
    }
  }
  @media (max-width: 600px) {
    .renovation-funnel {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .funnel-stage::after {
      display: none;
    }
  }
</style>

<ServiceLayout
  title="Coding School Website Singapore — Web Design Agency"
  description="Web design agency for coding schools and robotics academies in Singapore — course pages by age, instructor profiles, project showcases, trial booking."
  canonical="https://jraftcreative.com/coding-school-website-singapore/"
  ogTitle="Coding School Website Singapore — Web Design Agency"
  ogDescription="Custom website design for coding schools and robotics academies in Singapore. Course pages by age and level, student project showcases, trial class booking, and local SEO."
  ogImage="https://jraftcreative.com/images/og-webdev.jpg"
  keywords="web design agency for coding schools, coding school website design singapore, coding school website singapore, robotics school website singapore, STEM education website singapore, kids coding website design, Jraft Creative"
  schemaData={schemaData}
  heroLabel="Web Design Agency for Coding Schools"
  heroTitle='Web Design Agency for <span class="highlight">Coding Schools in Singapore</span>'
  heroSubtitle="Parents are searching for coding, robotics, and STEM classes for their children before they enquire anywhere. We build websites that lay out your courses by age and level, showcase real student projects, and make trial booking effortless — so you can focus on teaching the next generation of builders."
  heroImage="/images/service-codingschool.webp"
  heroImageAlt="Coding school in Singapore"
  heroButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "Explore Website Development", href: "/services/website-development/", class: "btn btn-secondary" }
  ]}
  whatsappText="Hi Jraft Creative, I need a website for my coding school in Singapore."
  ctaLabel="Ready to Enrol More Students?"
  ctaTitle="Get Your Coding School Online"
  ctaDescription="Tell us about your coding school and we'll recommend the right website scope. Free consultation — no obligations, no pressure."
  ctaButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%20need%20a%20website%20for%20my%20coding%20school%20in%20Singapore.", class: "btn btn-secondary" }
  ]}
  hideDefaultCta={false}
>

  <!-- ========== THE CHALLENGE ========== -->
  <section class="section" id="challenge" aria-label="Website challenges for coding schools in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Challenge</p>
        <h2>Parents Are <span class="highlight">Searching</span> — Can They <span class="highlight">Find Your School</span>?</h2>
      </div>
      <div class="section-content reveal">
        <p>Parents compare coding schools side by side — courses, instructors, projects — long before they ever call or visit. A <a href="/blog/good-business-website-singapore/">well-built website</a> is what puts you on the shortlist.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>A Social Page Isn't Enough</h3>
            <p>Parents want the full course lineup, how classes are grouped by age and level, and real student work in one place. A directory listing answers none of it.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Parents Research Thoroughly</h3>
            <p>They check instructor backgrounds, compare Scratch, Python and robotics pathways, and look for trial classes. Anything missing is a reason to choose someone else.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>New Programmes Launch Monthly</h3>
            <p>Singapore's STEM scene is crowded, from chains to weekend studios. Your site is what decides whether a parent enquires or scrolls to the next school.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHAT WE BUILD ========== -->
  <section class="section" id="sub-services" style="background: var(--bg-alt);" aria-label="Coding school website design services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">What We Build</p>
        <h2>Six <span class="highlight">Pillars</span> of a Coding School <span class="highlight">Website</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Every site is built to turn a curious parent into a booked trial class, not just to look modern. Our <a href="/services/website-development/">website development</a> work for <a href="/industries/education/">education businesses</a> starts from how parents actually choose a coding school.</p>
      </div>
      <div class="service-details-grid deliver-grid">
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-business-website.webp');">
          <div class="service-detail-card__content">
            <h3>Course Pages by Age &amp; Level</h3>
            <p>A page per programme — Scratch for ages 6-8, Python for ages 9-12, robotics workshops, AI fundamentals for teens — so parents find the right fit for their child in seconds.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-landing-page.webp');">
          <div class="service-detail-card__content">
            <h3>Trial Class &amp; Enrolment Booking</h3>
            <p>Parents book a trial or enrol directly from the site. The flow captures the child's age, experience and preferred timing, with automated confirmations that cut front-desk calls.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-local-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Instructor Profiles &amp; Credentials</h3>
            <p>Qualifications, industry background and teaching approach for each instructor, so parents choosing an advanced Python, robotics or AI course know exactly who is teaching their child.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-graphic-design.webp');">
          <div class="service-detail-card__content">
            <h3>Student Project Showcases</h3>
            <p>Completed Scratch games, Python apps, robotics builds and AI projects shown with screenshots, descriptions and embedded demos — tangible proof of what a child will build.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-reels-video.webp');">
          <div class="service-detail-card__content">
            <h3>Holiday Camp Registration</h3>
            <p>Dedicated camp pages with dates, themes and age bands, plus a registration flow ready for the March, June, September and December peaks — no scrambling every school break.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-speed-vitals.webp');">
          <div class="service-detail-card__content">
            <h3>Mobile-First, Search-Ready</h3>
            <p>Fast mobile loads and clean structure with schema built in from day one, so the site works the moment a parent taps a search result — from Tampines to Punggol to Bukit Timah.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHY US ========== -->
  <section class="section" id="why-us" aria-label="Why choose Jraft Creative as your coding school web design agency">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2>A <span class="highlight">Web Design Agency</span> That Knows <span class="highlight">Coding Schools</span></h2>
      </div>
      <div class="section-content reveal">
        <p>We build for the specific problem coding schools have — competing locally for STEM searches, then turning a trial class into a term-long enrolment.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Education Industry Experience</h3>
            <p>We've built for tuition centres, enrichment centres and education businesses across Singapore, and we know what turns a browsing parent into an enrolled student.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Live Before the Next Intake</h3>
            <p>Most coding school sites go live within two weeks, so you start capturing registrations before the next holiday camp or term intake rather than after it.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Website, SEO &amp; Social Together</h3>
            <p>We also run <a href="/services/seo-performance/">SEO &amp; performance</a> and <a href="/services/social-media/">social media</a> — one connected system for filling class seats.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== ENROLMENT FUNNEL ========== -->
  <section class="section" id="buyer-funnel" style="background: var(--bg-alt);" aria-label="Where your website fits the coding-school parent journey">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Enrolment Funnel</p>
        <h2>Where Your <span class="highlight">Website</span> Fits the <span class="highlight">Parent Journey</span></h2>
      </div>
      <div class="section-content reveal" style="margin-bottom: 24px;">
        <p>Parents move through the same five stages before a child starts classes. Your website carries the middle three — it is where a parent validates your instructors, compares you against the shortlist, and finally books the trial.</p>
      </div>
      <ol class="renovation-funnel reveal">
        <li class="funnel-stage">
          <h3>Discover</h3>
          <p>A search or referral brings them to the site</p>
        </li>
        <li class="funnel-stage">
          <h3>Validate</h3>
          <p>Instructor profiles, curriculum, student projects</p>
        </li>
        <li class="funnel-stage">
          <h3>Compare</h3>
          <p>Course pages answer age, level and fit</p>
        </li>
        <li class="funnel-stage">
          <h3>Trial</h3>
          <p>Booking flow turns interest into a scheduled class</p>
        </li>
        <li class="funnel-stage">
          <h3>Enrol</h3>
          <p>Sign for the term, renew &amp; refer</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ========== PRICING ========== -->
  <!-- ========== FAQ ========== -->
  <section class="section faq-section" id="faq" style="background: var(--bg-alt);" aria-label="Frequently asked questions about coding school website design in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">FAQ</p>
        <h2>Coding School <span class="highlight">Website</span> Questions Answered</h2>
      </div>
      <div class="faq-list">
        <details class="faq-item reveal reveal-d1">
          <summary>How much does a coding school website cost in Singapore?</summary>
          <div class="faq-answer"><p>Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>Can you add online trial class and holiday camp booking to our coding school website?</summary>
          <div class="faq-answer"><p>Yes. We build booking flows that let parents browse courses by age group, pick a preferred timing, and book a trial class or register for a holiday camp directly through your website. The form captures the child's age, coding experience, and preferred programme — so you receive qualified enquiries instead of vague messages, with automated confirmations that cut admin work for your front desk.</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>Can you build a student project showcase into our website?</summary>
          <div class="faq-answer"><p>Yes. We build dedicated showcase sections where completed student work — Scratch games, Python apps, robotics builds, and AI projects — is displayed with descriptions, screenshots, and embedded demos. Seeing tangible work gives parents confidence in what their child will learn, and featuring current students' projects motivates the rest of the class.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>Can you help our coding school rank for "coding class for kids near me" on Google?</summary>
          <div class="faq-answer"><p>Yes. We optimise your website for the terms parents actually search — like "coding class for kids Tampines", "robotics course Bishan", or "Python class for children Singapore". This includes on-page SEO, schema markup for educational organisations, Google Business Profile optimisation, and location-targeted content for each neighbourhood you serve, from Bukit Timah and Jurong to Punggol and Novena.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>How long does it take to build a coding school website?</summary>
          <div class="faq-answer"><p>Most coding school websites go live within 2 weeks. Sites with individual course pages, project galleries, and trial booking typically take about 3 weeks, while larger builds with age-group learning pathways, holiday camp sections, and student portals take 4-5 weeks. We provide a clear timeline before starting so you can plan around your term and camp calendar.</p></div>
        </details>
      </div>
    </div>
  </section>


  <!-- Related Services -->
  <section class="section" id="related-services" aria-label="Related services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Explore More</p>
        <h2>More Ways We <span class="highlight">Help Coding Schools</span></h2>
      </div>
      <div class="related-services-grid reveal">
          <a href="/industries/education/" class="related-service-link">Education Marketing</a>
          <a href="/services/website-development/" class="related-service-link">Website Development</a>
          <a href="/services/seo-performance/" class="related-service-link">SEO &amp; Performance</a>
          <a href="/services/social-media/" class="related-service-link">Social Media</a>
      </div>
    </div>
  </section>
</ServiceLayout>
