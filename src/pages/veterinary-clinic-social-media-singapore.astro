---
import ServiceLayout from '../layouts/ServiceLayout.astro';
import RelatedServices from '../components/RelatedServices.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Veterinary Clinic Social Media Marketing Singapore",
    "description": "Social media marketing for veterinary clinics in Singapore. Pet care tips, engaging pet content, vaccination reminders, and community-building campaigns across Instagram and Facebook.",
    "provider": {
      "@type": "Organization",
      "name": "Jraft Creative",
      "url": "https://jraftcreative.com/",
      "logo": "https://jraftcreative.com/images/logo.png",
      "telephone": "+6582234578",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "60 Paya Lebar Road, Paya Lebar Square",
        "postalCode": "409051",
        "addressLocality": "Singapore",
        "addressCountry": "SG"
      }
    },
    "areaServed": { "@type": "Country", "name": "Singapore" },
    "serviceType": "Veterinary Clinic Social Media Marketing"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How much does social media marketing cost for veterinary clinics in Singapore?", "acceptedAnswer": { "@type": "Answer", "text": "Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote." } },
      { "@type": "Question", "name": "What social media content works best for vet clinics?", "acceptedAnswer": { "@type": "Answer", "text": "The most effective veterinary clinic content includes pet care tips, seasonal health reminders (tick prevention, heatstroke awareness), behind-the-scenes clinic moments, team introductions, and heartwarming patient stories. Pet photos and short videos naturally generate high engagement. Educational content about vaccinations, dental care, and nutrition positions your clinic as a trusted authority." } },
      { "@type": "Question", "name": "Can social media help my vet clinic attract new clients?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Pet owners in Singapore are highly active on social media and often choose vets based on recommendations and online presence. A well-managed social media profile with educational content, caring team photos, and positive client interactions builds the trust that drives new registrations. Targeted local campaigns can reach pet owners within your catchment area effectively." } },
      { "@type": "Question", "name": "How do you handle sensitive content for veterinary clinics?", "acceptedAnswer": { "@type": "Answer", "text": "We maintain a careful balance between informative and sensitive content. We avoid graphic clinical imagery and focus on positive, educational, and heartwarming content. Pet loss support posts are handled with empathy and care. All content is reviewed by your clinic team before publishing to ensure it aligns with your values and communication standards." } },
      { "@type": "Question", "name": "Which social media platforms are best for vet clinics in Singapore?", "acceptedAnswer": { "@type": "Answer", "text": "Instagram and Facebook are the most effective platforms for veterinary clinics in Singapore. Instagram is ideal for pet photos, Reels, and health tip carousels. Facebook is strong for community building, reviews, and reaching pet owners in neighbourhood groups. TikTok is growing rapidly for engaging, shareable pet content that can significantly expand your reach." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "Social Media Marketing Singapore", "item": "https://jraftcreative.com/services/social-media/" },
      { "@type": "ListItem", "position": 3, "name": "Veterinary Clinic Social Media", "item": "https://jraftcreative.com/veterinary-clinic-social-media-singapore/" }
    ]
  }
];
---

<style is:global>
  /* Hide the global background grid pattern on this page only */
  .animated-bg__grid { display: none; }

  /* More-prominent related-service pills — match challenge-card-v2 green treatment */
  #related-services .related-service-link {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.35);
    color: var(--text);
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  #related-services .related-service-link:hover {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.22) 0%, rgba(73, 184, 137, 0.1) 100%), rgba(20, 28, 32, 0.7);
    border-color: rgba(73, 184, 137, 0.6);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(73, 184, 137, 0.3);
  }
  .service-cta-section { background: var(--bg-alt) !important; }
  .renovation-funnel { list-style: none; padding: 0; margin: 56px 0 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 48px; }
  .funnel-stage { position: relative; text-align: center; padding: 28px 20px; background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6); border: 1px solid rgba(73, 184, 137, 0.28); border-radius: 12px; transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease; }
  .funnel-stage:hover { transform: translateY(-4px); border-color: rgba(73, 184, 137, 0.55); box-shadow: 0 16px 40px -16px rgba(73, 184, 137, 0.3); }
  .funnel-stage h3 { font-size: 1.05rem; font-weight: 600; color: var(--accent); margin: 0 0 8px 0; letter-spacing: -0.01em; }
  .funnel-stage p { font-size: 0.82rem; color: var(--text); line-height: 1.5; margin: 0; }
  .funnel-stage:not(:last-child)::after { content: '→'; position: absolute; right: -34px; top: 50%; transform: translateY(-50%); color: var(--accent); font-size: 1.6rem; font-weight: 500; z-index: 2; line-height: 1; opacity: 0.7; }
  @media (max-width: 900px) { .renovation-funnel { grid-template-columns: repeat(2, 1fr); gap: 32px; } .funnel-stage:nth-child(2n)::after, .funnel-stage:last-child::after { display: none; } .funnel-stage:nth-child(2n-1)::after { right: -22px; } }
  @media (max-width: 600px) { .renovation-funnel { grid-template-columns: 1fr; gap: 20px; } .funnel-stage::after { display: none; } }
</style>

<ServiceLayout
  title="Social Media Agency for Veterinary Clinics"
  description="Social media marketing for veterinary clinics in Singapore. Pet care tips, engaging pet content, vaccination reminders, and community-building campaigns."
  canonical="https://jraftcreative.com/veterinary-clinic-social-media-singapore/"
  ogTitle="Social Media Agency for Veterinary Clinics"
  ogDescription="Social media marketing for vet clinics in Singapore. Engaging pet content, health education, and appointment-driving campaigns. Plans"
  ogImage="https://jraftcreative.com/images/og-webdev.jpg"
  keywords="veterinary clinic social media singapore, vet clinic marketing singapore, veterinary instagram marketing, pet clinic social media, animal hospital marketing singapore, vet digital marketing singapore, Jraft Creative"
  schemaData={schemaData}
  heroLabel="Social Media Agency for Veterinary Clinics"
  heroTitle='Social Media Agency for <span class="highlight">Veterinary Clinics in Singapore</span>'
  heroSubtitle="Pet care tips, heartwarming content, and vaccination reminders that build trust with pet owners. We help veterinary clinics in Singapore grow their client base, strengthen community ties, and become the neighbourhood's first-choice vet."
  heroImage="/images/service-veterinary.webp"
  heroButtons={[
    { text: "Get a Free Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "See How We Work", href: "/process/", class: "btn btn-secondary" }
  ]}
  whatsappText="Hi Jraft Creative, I need social media marketing for my veterinary clinic in Singapore."
  ctaLabel="Ready to Get Started?"
  ctaTitle="Grow Your Vet Clinic with Social Media"
  ctaDescription="Book a free consultation and tell us about your clinic. We'll get back to you within 24 hours with a tailored social media strategy for your veterinary practice."
  ctaButtons={[
    { text: "Get a Free Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%20need%20social%20media%20marketing%20for%20my%20veterinary%20clinic%20in%20Singapore.", class: "btn btn-secondary" }
  ]}
>

  <!-- ========== THE CHALLENGE ========== -->
  <section class="section" id="challenge" aria-label="Social challenges for veterinary clinics in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Challenge</p>
        <h2>Owners Choose Their Vet Long Before an <span class="highlight">Emergency</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Pet owners are among the most engaged, loyal audiences on social. The clinic that earns their trust in the feed is the one they call when it matters.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Loyalty Is Built in the Feed</h3>
            <p>Owners follow clinics that feel warm and knowledgeable. That relationship is what turns a follower into a client for the pet's whole life.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>An Empty Feed Reads as Distant</h3>
            <p>A quiet or clinical profile makes a new owner hesitate. Consistent, human content signals a clinic that will care for their pet.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Emotional, So Handle It Well</h3>
            <p>Pet content is joyful and sometimes heartbreaking. It has to be handled with genuine sensitivity, not stock captions.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHAT WE DELIVER ========== -->
  <section class="section" id="sub-services" style="background: var(--bg-alt);" aria-label="Social services for veterinary clinics">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">What We Deliver</p>
        <h2>Six <span class="highlight">Content Workstreams</span> for Vet <span class="highlight">Clinics</span></h2>
      </div>
      <div class="section-content reveal">
        <p>We build a cadence around what your clinic already does each week, turning everyday care into trust.</p>
      </div>
      <div class="service-details-grid deliver-grid">
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-reels-video.webp');">
          <div class="service-detail-card__content">
            <h3>Pet Care &amp; Health Reels</h3>
            <p>Short video of your vets on common worries — 'is this an emergency', 'when to sterilise' — building trust in the person, not just the clinic.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-content-strategy.webp');">
          <div class="service-detail-card__content">
            <h3>Educational &amp; Seasonal Content</h3>
            <p>Clear posts on vaccinations, parasite season, festive-period pet safety — the content that keeps owners engaged year-round.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-graphic-design.webp');">
          <div class="service-detail-card__content">
            <h3>Patient Spotlights &amp; Recoveries</h3>
            <p>Feel-good patient stories, shared with owner consent — the posts that owners love, share and remember.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-community-mgmt.webp');">
          <div class="service-detail-card__content">
            <h3>Community Management</h3>
            <p>Prompt, warm handling of DMs, comments and enquiries — nurturing an owner from first message to booked visit.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-meta-ads.webp');">
          <div class="service-detail-card__content">
            <h3>Check-up &amp; Vaccination Campaigns</h3>
            <p>Gentle reminder campaigns for annual check-ups and boosters that fill quieter periods and keep pets healthy.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-campaign-analytics.webp');">
          <div class="service-detail-card__content">
            <h3>Reporting on Enquiries</h3>
            <p>We track profile-to-enquiry and bookings that mention social — follower count is context, not the result.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHY US ========== -->
  <section class="section" id="why-us" aria-label="Why choose Jraft Creative for veterinary social">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2>A <span class="highlight">Social Media Agency</span> That Loves <span class="highlight">Animals Too</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Vet social lives or dies on warmth and sensitivity. We handle both, with your clinical team in control of every post.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Pet Industry Understanding</h3>
            <p>We know what an owner audience responds to — reassurance, education and genuine warmth — and what falls flat.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Sensitive Content Handling</h3>
            <p>Pet content ranges from joyful to grief. We handle every post with the care the subject deserves, never a stock caption.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>You Approve Before Publishing</h3>
            <p>You and your clinical team sign off every post, caption and visual. Nothing goes live without your approval.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== FUNNEL ========== -->
  <section class="section" id="buyer-funnel" style="background: var(--bg-alt);" aria-label="Where social fits the pet-owner journey">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Owner Journey</p>
        <h2>Where <span class="highlight">Social</span> Fits the <span class="highlight">Pet-Owner Journey</span></h2>
      </div>
      <div class="section-content reveal" style="margin-bottom: 24px;">
        <p>A pet owner moves through five stages before booking. Social rarely wins the first search — its job is Validate and Compare, where warm, expert content earns the trust to choose you.</p>
      </div>
      <ol class="renovation-funnel reveal">
        <li class="funnel-stage"><h3>Discover</h3><p>A reel or a share puts you on the radar</p></li>
        <li class="funnel-stage"><h3>Validate</h3><p>Vet-led content builds warmth and trust</p></li>
        <li class="funnel-stage"><h3>Compare</h3><p>Reviews and personality weigh the clinics</p></li>
        <li class="funnel-stage"><h3>Book</h3><p>DMs and profile link turn interest into a visit</p></li>
        <li class="funnel-stage"><h3>Care</h3><p>A good first visit, then a lifetime of loyalty</p></li>
      </ol>
    </div>
  </section>

  <!-- ========== PRICING ========== -->
  <!-- ========== FAQ ========== -->
  <section class="section faq-section" id="faq" style="background: var(--bg-alt);" aria-label="Frequently asked questions about veterinary clinic social media marketing">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">FAQ</p>
        <h2>Veterinary Clinic Social Media — Questions Answered</h2>
      </div>
      <div class="faq-list">
        <details class="faq-item reveal reveal-d1">
          <summary>How much does social media marketing cost for veterinary clinics in Singapore?</summary>
          <div class="faq-answer"><p>Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>What social media content works best for vet clinics?</summary>
          <div class="faq-answer"><p>The most effective veterinary clinic content includes pet care tips, seasonal health reminders (tick prevention, heatstroke awareness), behind-the-scenes clinic moments, team introductions, and heartwarming patient stories. Pet photos and short videos naturally generate high engagement. Educational content about vaccinations, dental care, and nutrition positions your clinic as a trusted authority.</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>Can social media help my vet clinic attract new clients?</summary>
          <div class="faq-answer"><p>Yes. Pet owners in Singapore are highly active on social media and often choose vets based on recommendations and online presence. A well-managed social media profile with educational content, caring team photos, and positive client interactions builds the trust that drives new registrations. Targeted local campaigns can reach pet owners within your catchment area effectively.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>How do you handle sensitive content for veterinary clinics?</summary>
          <div class="faq-answer"><p>We maintain a careful balance between informative and sensitive content. We avoid graphic clinical imagery and focus on positive, educational, and heartwarming content. Pet loss support posts are handled with empathy and care. All content is reviewed by your clinic team before publishing to ensure it aligns with your values and communication standards.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>Which social media platforms are best for vet clinics in Singapore?</summary>
          <div class="faq-answer"><p>Instagram and Facebook are the most effective platforms for veterinary clinics in Singapore. Instagram is ideal for pet photos, Reels, and health tip carousels. Facebook is strong for community building, reviews, and reaching pet owners in neighbourhood groups. TikTok is growing rapidly for engaging, shareable pet content that can significantly expand your reach.</p></div>
        </details>
      </div>
    </div>
  </section>


  <section class="section" id="related-services" aria-label="Related services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Explore More</p>
        <h2>More <span class="highlight">Veterinary Clinic</span> Services</h2>
      </div>
      <div class="related-services-grid reveal">
          <a href="/veterinary-clinic-seo-singapore/" class="related-service-link">Veterinary SEO</a>
          <a href="/veterinary-clinic-website-singapore/" class="related-service-link">Veterinary Website Design</a>
          <a href="/veterinary-clinic-google-ads-singapore/" class="related-service-link">Veterinary Google Ads</a>
          <a href="/veterinary-clinic-branding-singapore/" class="related-service-link">Veterinary Branding</a>
          <a href="/veterinary-clinic-marketing-singapore/" class="related-service-link">Full-Service Veterinary Marketing</a>
          <a href="/veterinary-clinic-ai-search-optimisation-singapore/" class="related-service-link">Veterinary GEO / AI Search</a>
      </div>
    </div>
  </section>

</ServiceLayout>
