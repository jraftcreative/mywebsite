---
import ServiceLayout from '../layouts/ServiceLayout.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Marketing Agency for Event Companies Singapore",
    "description": "Full-service marketing agency for event companies in Singapore — corporate events, MICE and planners. SEO, AI search, ads, social, branding and websites that win briefs.",
    "provider": {
      "@type": "Organization",
      "name": "Jraft Creative",
      "url": "https://jraftcreative.com/",
      "logo": "https://jraftcreative.com/images/logo.png",
      "telephone": "+6582234578",
      "address": { "@type": "PostalAddress", "streetAddress": "60 Paya Lebar Road, Paya Lebar Square", "postalCode": "409051", "addressLocality": "Singapore", "addressCountry": "SG" }
    },
    "areaServed": { "@type": "Country", "name": "Singapore" },
    "serviceType": "Event Company Marketing"
  },
  { "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [
      { "@type": "Question", "name": "What does marketing for an event company involve?", "acceptedAnswer": { "@type": "Answer", "text": "Being found in event-type and B2B search, named by AI assistants, visible in paid results and remarketing to decision-makers, proving capability through case studies and film, branded as a credible partner, and a website that turns a search into a qualified brief." } },
      { "@type": "Question", "name": "We win work on referrals — why market?", "acceptedAnswer": { "@type": "Answer", "text": "Referrals are excellent and finite. They can't reach the new decision-makers actively searching for an event partner right now, and a weak online presence undermines even a warm referral when the client checks you out." } },
      { "@type": "Question", "name": "Does this suit corporate and MICE specifically?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. B2B event buyers research deliberately and vet hard, so search visibility, credible case studies and a professional site matter more here than in consumer marketing. We build for exactly that buyer." } },
      { "@type": "Question", "name": "How quickly does it work?", "acceptedAnswer": { "@type": "Answer", "text": "Paid search can produce enquiries within weeks; organic and content take a few months to compound. Because event budgets are large and cycles longer, the payback per enquiry is high even at lower volume." } },
      { "@type": "Question", "name": "How do you measure success?", "acceptedAnswer": { "@type": "Answer", "text": "Qualified enquiries and cost per enquiry, then enquiry-to-win. Impressions and reach are context, never the result." } }
    ] },
  { "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "Marketing Agency for Event Companies Singapore", "item": "https://jraftcreative.com/event-company-marketing-singapore/" }
  ] }
];
---

<style is:global>
  /* Hide the global background grid pattern on this page only */
  .animated-bg__grid { display: none; }

  /* More-prominent related-service pills — match challenge-card-v2 green treatment */
  #related-services .related-service-link {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.35);
    color: var(--text);
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  #related-services .related-service-link:hover {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.22) 0%, rgba(73, 184, 137, 0.1) 100%), rgba(20, 28, 32, 0.7);
    border-color: rgba(73, 184, 137, 0.6);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(73, 184, 137, 0.3);
  }
  .service-cta-section { background: var(--bg-alt) !important; }
  .renovation-funnel { list-style: none; padding: 0; margin: 56px 0 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 48px; }
  .funnel-stage { position: relative; text-align: center; padding: 28px 20px; background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6); border: 1px solid rgba(73, 184, 137, 0.28); border-radius: 12px; transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease; }
  .funnel-stage:hover { transform: translateY(-4px); border-color: rgba(73, 184, 137, 0.55); box-shadow: 0 16px 40px -16px rgba(73, 184, 137, 0.3); }
  .funnel-stage h3 { font-size: 1.05rem; font-weight: 600; color: var(--accent); margin: 0 0 8px 0; letter-spacing: -0.01em; }
  .funnel-stage p { font-size: 0.82rem; color: var(--text); line-height: 1.5; margin: 0; }
  .funnel-stage:not(:last-child)::after { content: '→'; position: absolute; right: -34px; top: 50%; transform: translateY(-50%); color: var(--accent); font-size: 1.6rem; font-weight: 500; z-index: 2; line-height: 1; opacity: 0.7; }
  @media (max-width: 900px) { .renovation-funnel { grid-template-columns: repeat(2, 1fr); gap: 32px; } .funnel-stage:nth-child(2n)::after, .funnel-stage:last-child::after { display: none; } .funnel-stage:nth-child(2n-1)::after { right: -22px; } }
  @media (max-width: 600px) { .renovation-funnel { grid-template-columns: 1fr; gap: 20px; } .funnel-stage::after { display: none; } }
</style>

<ServiceLayout
  title="Marketing Agency for Event Companies Singapore"
  description="Marketing agency for event companies in Singapore — corporate events, MICE and planners. SEO, social and websites that win briefs and enquiries."
  canonical="https://jraftcreative.com/event-company-marketing-singapore/"
  ogTitle="Marketing Agency for Event Companies Singapore"
  ogDescription="Full-service marketing for Singapore event companies. Six channels that win corporate briefs and enquiries."
  ogImage="https://jraftcreative.com/images/og-webdev.jpg"
  keywords="marketing agency for event companies, event company marketing singapore, event management marketing, MICE marketing singapore, corporate events marketing, Jraft Creative"
  schemaData={schemaData}
  heroLabel="Marketing Agency for Event Companies"
  heroTitle='Marketing Agency for <span class="highlight">Event Companies in Singapore</span>'
  heroSubtitle="Corporate clients shortlist an event partner from a Google search and a portfolio, then send the brief. We run the channels that put you on that shortlist — search, content, ads, brand and website — judged on qualified enquiries, not impressions."
  heroImage="/images/service-event.webp"
  heroImageAlt="Corporate event in Singapore — event company marketing"
  heroButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "See Event Company Websites", href: "/event-company-website-singapore/", class: "btn btn-secondary" }
  ]}
  whatsappText="Hi Jraft Creative, I'd like to talk about marketing for my event company in Singapore."
  ctaLabel="Win More Briefs"
  ctaTitle="Get a Free Event Company Marketing Review"
  ctaDescription="Book a free consultation and we'll look at how corporate clients find you now, where enquiries stall, and which channel wins more briefs. We'll get back to you within 24 hours."
  ctaButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%27d%20like%20to%20talk%20about%20marketing%20for%20my%20event%20company%20in%20Singapore.", class: "btn btn-secondary" }
  ]}
  hideDefaultCta={false}
>

  <!-- ========== THE CHALLENGE ========== -->
  <section class="section" id="challenge" aria-label="Marketing challenges for event companies in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Challenge</p>
        <h2>The Brief Goes to Whoever the Client <span class="highlight">Finds and Trusts First</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Corporate event decisions start with a Google search and a portfolio review. An event company that isn't visible and credible online never gets the brief, however good its shows are.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>You're Judged Before You Pitch</h3>
            <p>A client vets you from your website and search presence before any conversation. A thin online presence gets you cut before you can show what you do.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Clients Search by Event Type</h3>
            <p>'Corporate event company Singapore', 'D&amp;D organiser', 'product launch agency', 'MICE company' — specific B2B searches. If those don't find you, a rival is briefed.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Great Work, Invisible Proof</h3>
            <p>Your best shows are the pitch — and if the case studies, films and results aren't findable, prospects can't be convinced by them.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== SIX CHANNELS ========== -->
  <section class="section" id="sub-services" style="background: var(--bg-alt);" aria-label="Marketing channels for event companies">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">What We Deliver</p>
        <h2>Six <span class="highlight">Marketing Channels</span> Every Event Company <span class="highlight">Needs</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Each channel does a different job in the same journey — from a client's first search to a qualified brief.</p>
      </div>
      <div class="service-details-grid deliver-grid">
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-local-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Search &amp; Local SEO</h3>
            <p>Rank for event-type and B2B searches — 'corporate event company', 'D&amp;D organiser Singapore', 'MICE agency' — that decision-makers actually use.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-ai.webp');">
          <div class="service-detail-card__content">
            <h3>AI Search &amp; GEO</h3>
            <p>Get named when a client asks an AI to recommend an event company for a launch, conference or dinner in Singapore.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-google-ads.webp');">
          <div class="service-detail-card__content">
            <h3>Google Ads</h3>
            <p>Capture high-intent B2B searches and remarket to decision-makers who viewed your work, timed to budgeting and planning cycles.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-reels-video.webp');">
          <div class="service-detail-card__content">
            <h3>Social Content</h3>
            <p>Event films, behind-the-scenes and results that make a corporate buyer confident you can deliver at scale.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-graphic-design.webp');">
          <div class="service-detail-card__content">
            <h3>Brand &amp; Positioning</h3>
            <p>A brand and positioning that read as a capable, established partner — the credibility a six-figure brief requires.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-business-website.webp');">
          <div class="service-detail-card__content">
            <h3>Website That Converts</h3>
            <p>An <a href="/event-company-website-singapore/">event company website</a> with case studies, capabilities and an enquiry flow built for corporate buyers.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHY US ========== -->
  <section class="section" id="why-us" aria-label="Why choose Jraft Creative for event companies marketing">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2>One <span class="highlight">Agency</span>, All Six <span class="highlight">Channels</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Most event companies rely on referrals and a dated site, and miss the buyers searching with real briefs. We run it as one system.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Channels That Feed Each Other</h3>
            <p>Search captures the buyer with a brief, content proves you can deliver, and the site converts the enquiry — each feeding the next.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Measured on Enquiries, Not Clicks</h3>
            <p>We report qualified enquiries and cost per enquiry — the briefs that become revenue — not impressions or reach.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>One Team, Every Channel</h3>
            <p>Case studies, search, content and enquiry flow move as one, so a decision-maker searching 'corporate event company' meets proof and a clear next step.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== FUNNEL ========== -->
  <section class="section" id="buyer-funnel" style="background: var(--bg-alt);" aria-label="How customers choose a event company">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Client Journey</p>
        <h2>How Clients <span class="highlight">Choose an Event Company</span></h2>
      </div>
      <div class="section-content reveal" style="margin-bottom: 24px;">
        <p>Corporate buyers research before they reach out. Search and content decide whether you're found and credible, brand decides whether you're shortlisted, and the site takes the brief.</p>
      </div>
      <ol class="renovation-funnel reveal">
        <li class="funnel-stage"><h3>Discover</h3><p>A B2B search, a referral or a past event</p></li>
        <li class="funnel-stage"><h3>Validate</h3><p>Case studies, films and results prove capability</p></li>
        <li class="funnel-stage"><h3>Shortlist</h3><p>Fit, scale and credibility settle the shortlist</p></li>
        <li class="funnel-stage"><h3>Enquire</h3><p>A qualified brief — the real conversion</p></li>
        <li class="funnel-stage"><h3>Win</h3><p>A signed client, then repeat &amp; referral</p></li>
      </ol>
    </div>
  </section>

  <!-- ========== FAQ ========== -->
  <section class="section faq-section" id="faq" style="background: var(--bg-alt);" aria-label="Frequently asked questions about event companies marketing">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">FAQ</p>
        <h2>Event Company <span class="highlight">Marketing</span> — Questions Answered</h2>
      </div>
      <div class="faq-list">
        <details class="faq-item reveal reveal-d1">
          <summary>What does marketing for an event company involve?</summary>
          <div class="faq-answer"><p>Being found in event-type and B2B search, named by AI assistants, visible in paid results and remarketing to decision-makers, proving capability through case studies and film, branded as a credible partner, and a website that turns a search into a qualified brief.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>We win work on referrals — why market?</summary>
          <div class="faq-answer"><p>Referrals are excellent and finite. They can't reach the new decision-makers actively searching for an event partner right now, and a weak online presence undermines even a warm referral when the client checks you out.</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>Does this suit corporate and MICE specifically?</summary>
          <div class="faq-answer"><p>Yes. B2B event buyers research deliberately and vet hard, so search visibility, credible case studies and a professional site matter more here than in consumer marketing. We build for exactly that buyer.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>How quickly does it work?</summary>
          <div class="faq-answer"><p>Paid search can produce enquiries within weeks; organic and content take a few months to compound. Because event budgets are large and cycles longer, the payback per enquiry is high even at lower volume.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>How do you measure success?</summary>
          <div class="faq-answer"><p>Qualified enquiries and cost per enquiry, then enquiry-to-win. Impressions and reach are context, never the result.</p></div>
        </details>
      </div>
    </div>
  </section>

  <!-- Related Services -->
  <section class="section" id="related-services" aria-label="Related services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Explore More</p>
        <h2>More <span class="highlight">Event Company</span> Services</h2>
      </div>
      <div class="related-services-grid reveal">
          <a href="/event-company-website-singapore/" class="related-service-link">Event Company Website Design</a>
          <a href="/wedding-marketing-singapore/" class="related-service-link">Wedding Marketing</a>
          <a href="/branding-agency-singapore/" class="related-service-link">Branding Agency</a>
          <a href="/services/seo-performance/" class="related-service-link">SEO &amp; Performance</a>
          <a href="/services/paid-ads/" class="related-service-link">Paid Ads</a>
      </div>
    </div>
  </section>
</ServiceLayout>
