---
import ServiceLayout from '../layouts/ServiceLayout.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Yoga Studio Website Design Singapore",
    "description": "Professional website design for yoga studios in Singapore — vinyasa, hatha, hot yoga, yin, prenatal, aerial, power yoga and ashtanga style pages, instructor profiles with RYT certifications, online class schedule and trial-class booking, and mobile-first speed that turns a scroll into a booked trial.",
    "provider": {
      "@type": "Organization",
      "name": "Jraft Creative",
      "url": "https://jraftcreative.com/",
      "logo": "https://jraftcreative.com/images/logo.png",
      "telephone": "+6582234578",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "60 Paya Lebar Road, Paya Lebar Square",
        "postalCode": "409051",
        "addressLocality": "Singapore",
        "addressCountry": "SG"
      }
    },
    "areaServed": { "@type": "Country", "name": "Singapore" },
    "serviceType": "Yoga Studio Website Design"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How much does a yoga studio website cost in Singapore?", "acceptedAnswer": { "@type": "Answer", "text": "Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote." } },
      { "@type": "Question", "name": "Can you integrate online class booking for my yoga studio?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We integrate the booking system your studio already uses — Mindbody, Momence, or a direct-booking setup as a ClassPass alternative — so students see live class availability, book a trial or drop-in, and get automated confirmations and reminders. If you don't have a system yet, we'll recommend one that fits your class formats and how you like to run the front desk." } },
      { "@type": "Question", "name": "Do you display yoga instructor certifications on the website?", "acceptedAnswer": { "@type": "Answer", "text": "Absolutely. Each instructor gets a dedicated profile page featuring their Yoga Alliance credentials (RYT-200, RYT-500, E-RYT), specialisations such as prenatal or yin therapy, teaching philosophy, and a personal bio. Students want to know their teacher before they commit, and clear profiles give them that confidence." } },
      { "@type": "Question", "name": "Can you build pages for yoga workshops and retreats?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We create dedicated pages for upcoming workshops, teacher training, and retreats — with schedules, instructor details, and online registration. Past events can be archived with photos and testimonials so new students can see the community they'd be joining." } },
      { "@type": "Question", "name": "How long does it take to build a yoga studio website?", "acceptedAnswer": { "@type": "Answer", "text": "Most yoga studio websites go live within about 2 weeks. Sites with online booking, instructor profiles, and workshop registration take a little longer, and multi-location builds with member portals longer still. We give you a clear timeline before we start." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "Yoga Studio Website Singapore", "item": "https://jraftcreative.com/yoga-studio-website-singapore/" }
    ]
  }
];
---

<style is:global>
  /* Hide the global background grid pattern on this page only */
  .animated-bg__grid { display: none; }

  /* More-prominent related-service pills — match challenge-card-v2 green treatment */
  #related-services .related-service-link {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.35);
    color: var(--text);
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  #related-services .related-service-link:hover {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.22) 0%, rgba(73, 184, 137, 0.1) 100%), rgba(20, 28, 32, 0.7);
    border-color: rgba(73, 184, 137, 0.6);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(73, 184, 137, 0.3);
  }

  /* Separate the CTA section from related-services with bg-alt */
  .service-cta-section {
    background: var(--bg-alt) !important;
  }

  /* Force even service card grid on desktop per locked landing-page pattern */
  #sub-services .deliver-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }
  @media (max-width: 900px) {
    #sub-services .deliver-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 600px) {
    #sub-services .deliver-grid { grid-template-columns: 1fr; }
  }

  /* Yoga Website Flow — horizontal process flow with green accents */
  .renovation-funnel {
    list-style: none;
    padding: 0;
    margin: 56px 0 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 48px;
    counter-reset: funnel;
  }
  .funnel-stage {
    position: relative;
    text-align: center;
    padding: 28px 20px;
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.28);
    border-radius: 12px;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .funnel-stage:hover {
    transform: translateY(-4px);
    border-color: rgba(73, 184, 137, 0.55);
    box-shadow: 0 16px 40px -16px rgba(73, 184, 137, 0.3);
  }
  .funnel-stage h3 {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--accent);
    margin: 0 0 8px 0;
    letter-spacing: -0.01em;
  }
  .funnel-stage p {
    font-size: 0.82rem;
    color: var(--text);
    line-height: 1.5;
    margin: 0;
  }
  .funnel-stage:not(:last-child)::after {
    content: '→';
    position: absolute;
    right: -34px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--accent);
    font-size: 1.6rem;
    font-weight: 500;
    z-index: 2;
    line-height: 1;
    opacity: 0.7;
  }
  @media (max-width: 900px) {
    .renovation-funnel {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }
    .funnel-stage:nth-child(2n)::after,
    .funnel-stage:last-child::after {
      display: none;
    }
    .funnel-stage:nth-child(2n-1)::after {
      right: -22px;
    }
  }
  @media (max-width: 600px) {
    .renovation-funnel {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .funnel-stage::after {
      display: none;
    }
  }
</style>

<ServiceLayout
  title="Yoga Studio Website Singapore — Jraft Creative"
  description="Website design for yoga studios in Singapore — style pages, instructor bios with RYT certifications, online schedule and trial-class booking."
  canonical="https://jraftcreative.com/yoga-studio-website-singapore/"
  ogTitle="Yoga Studio Website Singapore — Jraft Creative"
  ogDescription="Website design for yoga studios in Singapore. Class schedule and trial booking, instructor bios, style pages, mobile-first speed."
  ogImage="https://jraftcreative.com/images/og-yoga.jpg"
  keywords="yoga studio website design singapore, yoga studio website singapore, vinyasa yoga website singapore, hot yoga website singapore, hatha yoga website singapore, yoga class booking website, yoga web design, Jraft Creative"
  schemaData={schemaData}
  heroLabel="Yoga Studio Websites"
  heroTitle='Website Design for <span class="highlight">Yoga Studios in Singapore</span>'
  heroSubtitle="Students in Singapore research a studio online before they ever unroll a mat. We build yoga studio websites that show your class styles, prove your teachers' RYT credentials, and make booking a trial effortless on a phone — so a late-night scroll turns into a booked first class."
  heroImage="/images/service-yoga.webp"
  heroButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "See How We Work", href: "/process/", class: "btn btn-secondary" }
  ]}
  whatsappText="Hi Jraft Creative, I need a website for my yoga studio in Singapore."
  ctaLabel="Ready to Grow Your Yoga Studio?"
  ctaTitle="Get Your Yoga Studio Online"
  ctaDescription="Tell us about your studio and we'll recommend the right website approach. Free consultation — no obligations, no pressure."
  ctaButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%20need%20a%20website%20for%20my%20yoga%20studio%20in%20Singapore.", class: "btn btn-secondary" }
  ]}
>

  <!-- ========== THE CHALLENGE ========== -->
  <section class="section" id="challenge" aria-label="Why yoga studios need a proper website">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Challenge</p>
        <h2>Students Compare Studios <span class="highlight">Online</span> — Is Yours <span class="highlight">Winning the Trial</span>?</h2>
      </div>
      <div class="section-content reveal">
        <p>Yoga is everywhere in Singapore, from Tanjong Pagar to Katong, and a first-timer weighs three or four studios before booking a trial. If your website doesn't answer their questions fast, they book the one that does.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>The Online Comparison</h3>
            <p>Before booking, students scan class styles, check teacher certifications, and hunt for an easy trial sign-up. A thin or dated site quietly loses them to the studio down the road that presents itself clearly.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Instagram Isn't Enough</h3>
            <p>A feed builds awareness but a story vanishes in a day. A beginner deciding between vinyasa and yin needs structured info — styles, class sizes, RYT credentials, how to book a trial — available around the clock.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>The Beginner Gap</h3>
            <p>Newcomers don't know hatha from ashtanga, or whether hot yoga is safe for them. With no page that explains each style plainly, a nervous first-timer hesitates and never books.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHAT WE BUILD ========== -->
  <section class="section" id="sub-services" style="background: var(--bg-alt);" aria-label="Yoga studio website design services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">What We Build</p>
        <h2>What We Build for <span class="highlight">Yoga Studios</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Every yoga site we build is purpose-made for the studio — style pages that explain each practice, teacher bios that carry the RYT credentials, a live schedule, and trial booking wired for the phone. Pair it with <a href="/yoga-studio-seo-singapore/">yoga studio SEO</a> to rank for local searches, <a href="/yoga-studio-social-media-singapore/">social media</a> to grow the community on Instagram, and <a href="/yoga-studio-google-ads-singapore/">Google Ads</a> to catch high-intent searches during January and post-holiday enrolment spikes.</p>
      </div>
      <div class="service-details-grid deliver-grid">
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-business-website.webp');">
          <div class="service-detail-card__content">
            <h3>Class Styles &amp; Live Schedule</h3>
            <p>Dedicated pages for vinyasa, hatha, hot yoga, yin, prenatal, aerial, power yoga, and ashtanga — each explaining the pace, intensity, and who it suits. A filterable weekly schedule lets students sort by style, teacher, or location and see what's on today.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-landing-page.webp');">
          <div class="service-detail-card__content">
            <h3>Trial Sign-Up &amp; Online Booking</h3>
            <p>Students book a trial or drop-in straight from the site with live availability, drop-in or package credits, and automated reminders. We plug into Mindbody, Momence, or a direct-booking setup as a ClassPass alternative, so fewer no-shows and a fuller schedule.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-local-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Instructor Bios &amp; RYT Certifications</h3>
            <p>Profile pages featuring Yoga Alliance credentials (RYT-200, RYT-500, E-RYT) and specialisations like prenatal or yin therapy. Training and teaching philosophy give a first-timer the confidence to book before they meet you.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-graphic-design.webp');">
          <div class="service-detail-card__content">
            <h3>Mobile-First Speed &amp; Workshops</h3>
            <p>Most students find you on a phone at night, so we build for speed and a thumb — fast pages, clear buttons, effortless booking. Plus workshop, teacher-training, and retreat pages with schedules and online registration.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHY CHOOSE US ========== -->
  <section class="section" id="why-us" aria-label="Why choose Jraft Creative for yoga studio website design">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2>Why Choose Us for Your <span class="highlight">Yoga Website</span></h2>
      </div>
      <div class="section-content reveal">
        <p>We know the wellness scene in Singapore — from explaining the difference between vinyasa and yin to turning a curious first-timer into a member who keeps coming back in a crowded boutique market.</p>
      </div>
      <div class="service-details-grid" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Wellness Studio Experience</h3>
            <p>We design for yoga studios and boutique wellness brands across neighbourhoods like Tiong Bahru, Holland Village, and Bugis, translating the calm, grounded feel of a studio into a site that looks the part — not a generic gym template.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Fast Turnaround</h3>
            <p>Most yoga sites go live in about 2 weeks — quick enough to catch a new location opening in Novena or Orchard, a rebrand, or a workshop-series push without missing the demand.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>One Agency, All Channels</h3>
            <p>Beyond the site, we run <a href="/yoga-studio-seo-singapore/">SEO</a>, social, and Google Ads — so your whole online presence pulls in one direction while you concentrate on teaching and growing the studio.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WEBSITE FLOW ========== -->
  <section class="section" id="website-flow" style="background: var(--bg-alt);" aria-label="How we build your yoga studio website">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">How It Works</p>
        <h2>From First Call to <span class="highlight">Booked Trials</span></h2>
      </div>
      <div class="section-content reveal" style="margin-bottom: 24px;">
        <p>We run the same four-step build on every yoga studio — clear, quick, and made to start taking trial bookings the moment you go live.</p>
      </div>
      <ol class="renovation-funnel reveal">
        <li class="funnel-stage">
          <h3>Discover</h3>
          <p>We map your styles, teachers, and booking needs</p>
        </li>
        <li class="funnel-stage">
          <h3>Design</h3>
          <p>Bespoke, calm yoga design, built mobile-first</p>
        </li>
        <li class="funnel-stage">
          <h3>Build</h3>
          <p>Schedule, trial booking, and pages wired and tested</p>
        </li>
        <li class="funnel-stage">
          <h3>Launch</h3>
          <p>Live in about 2 weeks, tuned for trial sign-ups</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ========== FAQ ========== -->
  <section class="section faq-section" id="faq" aria-label="Frequently asked questions about yoga studio website design in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">FAQ</p>
        <h2><span class="highlight">Yoga Studio Website</span> — Questions <span class="highlight">Answered</span></h2>
      </div>
      <div class="faq-list">
        <details class="faq-item reveal reveal-d1">
          <summary>How much does a yoga studio website cost in Singapore?</summary>
          <div class="faq-answer"><p>Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>Can you integrate online class booking for my yoga studio?</summary>
          <div class="faq-answer"><p>Yes. We integrate the booking system your studio already uses — Mindbody, Momence, or a direct-booking setup as a ClassPass alternative — so students see live class availability, book a trial or drop-in, and get automated confirmations and reminders. If you don't have a system yet, we'll recommend one that fits your class formats and how you like to run the front desk.</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>Do you display yoga instructor certifications on the website?</summary>
          <div class="faq-answer"><p>Absolutely. Each instructor gets a dedicated profile page featuring their Yoga Alliance credentials (RYT-200, RYT-500, E-RYT), specialisations such as prenatal or yin therapy, teaching philosophy, and a personal bio. Students want to know their teacher before they commit, and clear profiles give them that confidence.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>Can you build pages for yoga workshops and retreats?</summary>
          <div class="faq-answer"><p>Yes. We create dedicated pages for upcoming workshops, teacher training, and retreats — with schedules, instructor details, and online registration. Past events can be archived with photos and testimonials so new students can see the community they'd be joining.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>How long does it take to build a yoga studio website?</summary>
          <div class="faq-answer"><p>Most yoga studio websites go live within about 2 weeks. Sites with online booking, instructor profiles, and workshop registration take a little longer, and multi-location builds with member portals longer still. We give you a clear timeline before we start.</p></div>
        </details>
      </div>
    </div>
  </section>


  <!-- Related Services -->
  <section class="section" id="related-services" aria-label="Related services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Explore More</p>
        <h2>More Yoga Studio Services</h2>
      </div>
      <div class="related-services-grid reveal">
          <a href="/yoga-studio-marketing-singapore/" class="related-service-link">Yoga Studio Marketing</a>
          <a href="/yoga-studio-seo-singapore/" class="related-service-link">Yoga Studio SEO</a>
          <a href="/yoga-studio-geo-singapore/" class="related-service-link">Yoga Studio GEO</a>
          <a href="/yoga-studio-google-ads-singapore/" class="related-service-link">Yoga Studio Google Ads</a>
          <a href="/yoga-studio-social-media-singapore/" class="related-service-link">Yoga Studio Social Media</a>
          <a href="/yoga-studio-branding-singapore/" class="related-service-link">Yoga Studio Branding</a>
      </div>
    </div>
  </section>
</ServiceLayout>
</content>
</invoke>
