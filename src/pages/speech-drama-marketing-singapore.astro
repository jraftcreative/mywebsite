---
import ServiceLayout from '../layouts/ServiceLayout.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Marketing Agency for Speech &amp; Drama Schools Singapore",
    "description": "Full-service marketing agency for speech and drama schools in Singapore — SEO, AI search, Google Ads, social, branding and websites that fill classes and exam programmes.",
    "provider": {
      "@type": "Organization",
      "name": "Jraft Creative",
      "url": "https://jraftcreative.com/",
      "logo": "https://jraftcreative.com/images/logo.png",
      "telephone": "+6582234578",
      "address": { "@type": "PostalAddress", "streetAddress": "60 Paya Lebar Road, Paya Lebar Square", "postalCode": "409051", "addressLocality": "Singapore", "addressCountry": "SG" }
    },
    "areaServed": { "@type": "Country", "name": "Singapore" },
    "serviceType": "Speech &amp; Drama Marketing"
  },
  { "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [
      { "@type": "Question", "name": "What does marketing for a speech and drama school involve?", "acceptedAnswer": { "@type": "Answer", "text": "Being found in outcome and exam search, named by AI assistants, visible in paid results during intake windows, showing confidence transformations on social, positioning the value clearly, and a website that converts a parent into a booked trial." } },
      { "@type": "Question", "name": "We rely on word of mouth — why market?", "acceptedAnswer": { "@type": "Answer", "text": "Referrals plateau and rarely arrive in the levels or exam cohorts where you have space. Marketing reaches parents actively searching for confidence and public-speaking help who'd never hear about you otherwise." } },
      { "@type": "Question", "name": "How quickly does it work?", "acceptedAnswer": { "@type": "Answer", "text": "Paid search produces enquiries within days; organic and AI visibility take three to five months. We launch the fastest channel that fits your budget and build the durable ones underneath." } },
      { "@type": "Question", "name": "Should we market the LAMDA / Trinity exams?", "acceptedAnswer": { "@type": "Answer", "text": "Yes — exam pathways are one of the strongest enrolment drivers and most schools under-use them. We make the certification pathway and its benefits front and centre." } },
      { "@type": "Question", "name": "How do you measure success?", "acceptedAnswer": { "@type": "Answer", "text": "Booked trials and cost per trial, then how many become enrolled students across your levels. Views and reach are context, not the outcome." } }
    ] },
  { "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "Marketing Agency for Speech &amp; Drama Schools Singapore", "item": "https://jraftcreative.com/speech-drama-marketing-singapore/" }
  ] }
];
---

<style is:global>
  /* Hide the global background grid pattern on this page only */
  .animated-bg__grid { display: none; }

  /* More-prominent related-service pills — match challenge-card-v2 green treatment */
  #related-services .related-service-link {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.35);
    color: var(--text);
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  #related-services .related-service-link:hover {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.22) 0%, rgba(73, 184, 137, 0.1) 100%), rgba(20, 28, 32, 0.7);
    border-color: rgba(73, 184, 137, 0.6);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(73, 184, 137, 0.3);
  }
  .service-cta-section { background: var(--bg-alt) !important; }
  .renovation-funnel { list-style: none; padding: 0; margin: 56px 0 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 48px; }
  .funnel-stage { position: relative; text-align: center; padding: 28px 20px; background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6); border: 1px solid rgba(73, 184, 137, 0.28); border-radius: 12px; transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease; }
  .funnel-stage:hover { transform: translateY(-4px); border-color: rgba(73, 184, 137, 0.55); box-shadow: 0 16px 40px -16px rgba(73, 184, 137, 0.3); }
  .funnel-stage h3 { font-size: 1.05rem; font-weight: 600; color: var(--accent); margin: 0 0 8px 0; letter-spacing: -0.01em; }
  .funnel-stage p { font-size: 0.82rem; color: var(--text); line-height: 1.5; margin: 0; }
  .funnel-stage:not(:last-child)::after { content: '→'; position: absolute; right: -34px; top: 50%; transform: translateY(-50%); color: var(--accent); font-size: 1.6rem; font-weight: 500; z-index: 2; line-height: 1; opacity: 0.7; }
  @media (max-width: 900px) { .renovation-funnel { grid-template-columns: repeat(2, 1fr); gap: 32px; } .funnel-stage:nth-child(2n)::after, .funnel-stage:last-child::after { display: none; } .funnel-stage:nth-child(2n-1)::after { right: -22px; } }
  @media (max-width: 600px) { .renovation-funnel { grid-template-columns: 1fr; gap: 20px; } .funnel-stage::after { display: none; } }
</style>

<ServiceLayout
  title="Marketing Agency for Speech &amp; Drama Singapore"
  description="Marketing agency for speech and drama schools in Singapore — SEO, ads, social and websites that fill classes, LAMDA and Trinity exam programmes."
  canonical="https://jraftcreative.com/speech-drama-marketing-singapore/"
  ogTitle="Marketing Agency for Speech &amp; Drama Singapore"
  ogDescription="Full-service marketing for Singapore speech and drama schools. Six channels that fill classes and exam programmes."
  ogImage="https://jraftcreative.com/images/og-webdev.jpg"
  keywords="marketing agency for speech and drama, speech and drama marketing singapore, drama school marketing, LAMDA class marketing, public speaking school advertising, Jraft Creative"
  schemaData={schemaData}
  heroLabel="Marketing Agency for Speech &amp; Drama"
  heroTitle='Marketing Agency for <span class="highlight">Speech &amp; Drama Schools in Singapore</span>'
  heroSubtitle="Parents want confident, articulate children — and they're searching for it. We run the channels that fill your classes and exam programmes — search, ads, social, brand and website — judged on booked trials and enrolled students."
  heroImage="/images/service-speechdrama.webp"
  heroImageAlt="Speech and drama class in Singapore — speech and drama marketing"
  heroButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "See Speech &amp; Drama Websites", href: "/speech-drama-website-singapore/", class: "btn btn-secondary" }
  ]}
  whatsappText="Hi Jraft Creative, I'd like to talk about marketing for my speech and drama school in Singapore."
  ctaLabel="Fill Your Classes"
  ctaTitle="Get a Free Speech &amp; Drama Marketing Review"
  ctaDescription="Book a free consultation and we'll look at how parents find you now, which classes and exam levels are under-filled, and which channel fills them fastest. We'll get back to you within 24 hours."
  ctaButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%27d%20like%20to%20talk%20about%20marketing%20for%20my%20speech%20and%20drama%20school%20in%20Singapore.", class: "btn btn-secondary" }
  ]}
  hideDefaultCta={false}
>

  <!-- ========== THE CHALLENGE ========== -->
  <section class="section" id="challenge" aria-label="Marketing challenges for speech and drama schools in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Challenge</p>
        <h2>Parents Want <span class="highlight">Confident Kids</span> — Do They Know You <span class="highlight">Deliver It</span>?</h2>
      </div>
      <div class="section-content reveal">
        <p>Speech and drama sells an outcome parents deeply want — confidence and articulation — but the value is invisible until it's explained and shown.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>The Benefit Needs Explaining</h3>
            <p>'Speech and drama' means little to a parent until you connect it to confidence, public speaking and even exam credits. Unexplained, it loses to tuition.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Parents Search by Outcome</h3>
            <p>They search 'public speaking for kids', 'LAMDA classes', 'build my child's confidence' — not your programme name. If those don't find you, someone else answers.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Exams Are an Untold Story</h3>
            <p>LAMDA and Trinity certifications are a powerful proof point and enrolment driver — and most schools barely mention them.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== SIX CHANNELS ========== -->
  <section class="section" id="sub-services" style="background: var(--bg-alt);" aria-label="Marketing channels for speech and drama schools">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">What We Deliver</p>
        <h2>Six <span class="highlight">Marketing Channels</span> Every Speech &amp; Drama School <span class="highlight">Needs</span></h2>
      </div>
      <div class="section-content reveal">
        <p>From a parent searching for confidence to a booked trial class, each channel plays its own part.</p>
      </div>
      <div class="service-details-grid deliver-grid">
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-local-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Search &amp; Local SEO</h3>
            <p>Rank for outcome and exam searches — 'public speaking for kids', 'LAMDA class Singapore', 'drama class [estate]' — plus neighbourhood terms.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-ai.webp');">
          <div class="service-detail-card__content">
            <h3>AI Search &amp; GEO</h3>
            <p>Get named when a parent asks an AI how to build their child's confidence or find a LAMDA teacher near them.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-google-ads.webp');">
          <div class="service-detail-card__content">
            <h3>Google Ads</h3>
            <p>Capture intake and exam-registration demand with campaigns built around the outcomes parents actually search for.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-reels-video.webp');">
          <div class="service-detail-card__content">
            <h3>Social Content</h3>
            <p>Showcase performances, exam successes and shy-to-confident stories — the transformation is your most persuasive content.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-graphic-design.webp');">
          <div class="service-detail-card__content">
            <h3>Brand &amp; Positioning</h3>
            <p>Positioning that makes the confidence outcome and exam pathway unmistakable, so you're chosen on value, not price.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-business-website.webp');">
          <div class="service-detail-card__content">
            <h3>Website That Converts</h3>
            <p>A <a href="/speech-drama-website-singapore/">speech and drama website</a> with class levels, exam pathways, showcase clips and easy trial booking.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHY US ========== -->
  <section class="section" id="why-us" aria-label="Why choose Jraft Creative for speech and drama schools marketing">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2>One <span class="highlight">Agency</span>, All Six <span class="highlight">Channels</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Most schools use separate vendors who never share what's converting. We run it as one system.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Channels That Feed Each Other</h3>
            <p>A campaign surfaces which outcomes — confidence, exams, public speaking — parents act on; that shapes every page and post. Split vendors never connect it.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Measured on Enquiries, Not Clicks</h3>
            <p>We count trials booked and enrolments by class and exam level — the number that fills your studio, not applause on a showcase clip.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>One Team, Every Channel</h3>
            <p>Site, search, social and ads work as one, so a parent searching 'build my child's confidence' meets the exact class and exam pathway that answers it.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== FUNNEL ========== -->
  <section class="section" id="buyer-funnel" style="background: var(--bg-alt);" aria-label="How customers choose a speech and drama school">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Enrolment Funnel</p>
        <h2>How Parents <span class="highlight">Choose a Speech &amp; Drama School</span></h2>
      </div>
      <div class="section-content reveal" style="margin-bottom: 24px;">
        <p>Every channel owns a stage — search and AI decide whether you're considered, social and brand prove the outcome, and the website turns interest into a booked trial.</p>
      </div>
      <ol class="renovation-funnel reveal">
        <li class="funnel-stage"><h3>Discover</h3><p>A search, AI answer or a parent's recommendation</p></li>
        <li class="funnel-stage"><h3>Validate</h3><p>Performances, exam results and confidence stories</p></li>
        <li class="funnel-stage"><h3>Compare</h3><p>Age fit, exam pathway, location and price</p></li>
        <li class="funnel-stage"><h3>Trial</h3><p>A booked class — the only real conversion</p></li>
        <li class="funnel-stage"><h3>Enrol</h3><p>Sign for the term, progress &amp; refer</p></li>
      </ol>
    </div>
  </section>

  <!-- ========== FAQ ========== -->
  <section class="section faq-section" id="faq" style="background: var(--bg-alt);" aria-label="Frequently asked questions about speech and drama schools marketing">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">FAQ</p>
        <h2>Speech &amp; Drama <span class="highlight">Marketing</span> — Questions Answered</h2>
      </div>
      <div class="faq-list">
        <details class="faq-item reveal reveal-d1">
          <summary>What does marketing for a speech and drama school involve?</summary>
          <div class="faq-answer"><p>Being found in outcome and exam search, named by AI assistants, visible in paid results during intake windows, showing confidence transformations on social, positioning the value clearly, and a website that converts a parent into a booked trial.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>We rely on word of mouth — why market?</summary>
          <div class="faq-answer"><p>Referrals plateau and rarely arrive in the levels or exam cohorts where you have space. Marketing reaches parents actively searching for confidence and public-speaking help who'd never hear about you otherwise.</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>How quickly does it work?</summary>
          <div class="faq-answer"><p>Paid search produces enquiries within days; organic and AI visibility take three to five months. We launch the fastest channel that fits your budget and build the durable ones underneath.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>Should we market the LAMDA / Trinity exams?</summary>
          <div class="faq-answer"><p>Yes — exam pathways are one of the strongest enrolment drivers and most schools under-use them. We make the certification pathway and its benefits front and centre.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>How do you measure success?</summary>
          <div class="faq-answer"><p>Booked trials and cost per trial, then trial-to-enrolment. Follower count and impressions are context, never the result.</p></div>
        </details>
      </div>
    </div>
  </section>

  <!-- Related Services -->
  <section class="section" id="related-services" aria-label="Related services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Explore More</p>
        <h2>More <span class="highlight">Speech &amp; Drama</span> Services</h2>
      </div>
      <div class="related-services-grid reveal">
          <a href="/speech-drama-website-singapore/" class="related-service-link">Speech &amp; Drama Website Design</a>
          <a href="/education-marketing-agency-singapore/" class="related-service-link">Full-Service Education Marketing</a>
          <a href="/education-ai-search-optimisation-singapore/" class="related-service-link">Education GEO / AI Search</a>
          <a href="/enrichment-centre-marketing-singapore/" class="related-service-link">Enrichment Centre Marketing</a>
          <a href="/music-school-marketing-singapore/" class="related-service-link">Music School Marketing</a>
      </div>
    </div>
  </section>
</ServiceLayout>
