---
import ServiceLayout from '../layouts/ServiceLayout.astro';
import RelatedServices from '../components/RelatedServices.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Construction Company Website Design Singapore",
    "description": "Professional website design for construction companies in Singapore. Project portfolios, quote request forms, and BCA and safety credential showcases.",
    "provider": {
      "@type": "Organization",
      "name": "Jraft Creative",
      "url": "https://jraftcreative.com/",
      "logo": "https://jraftcreative.com/images/logo.png",
      "telephone": "+6582234578",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "60 Paya Lebar Road, Paya Lebar Square",
        "postalCode": "409051",
        "addressLocality": "Singapore",
        "addressCountry": "SG"
      }
    },
    "areaServed": { "@type": "Country", "name": "Singapore" },
    "serviceType": "Construction Company Website Design"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How much does a construction company website cost in Singapore?", "acceptedAnswer": { "@type": "Answer", "text": "Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote." } },
      { "@type": "Question", "name": "Can you showcase our BCA registration and safety certifications?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We prominently display your BCA registration and grading, bizSAFE level, ISO standards, and any other safety or quality credentials. In Singapore's construction industry, these are often the first thing developers and project managers check before shortlisting a contractor." } },
      { "@type": "Question", "name": "Can clients request quotes or send enquiries through the website?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We build structured quote and enquiry forms that let potential clients submit project details, upload drawings or specifications, and reach your team directly. It captures qualified leads around the clock and feeds straight into your business development pipeline." } },
      { "@type": "Question", "name": "Do you help construction companies rank on Google?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We offer SEO with keyword targeting for searches like 'construction company Singapore', 'A&A contractor Singapore', or 'building contractor Singapore'. We also set up Google Business Profile and industry schema markup. Book a consultation and we'll scope the right SEO setup for your goals." } },
      { "@type": "Question", "name": "How long does it take to build a construction company website?", "acceptedAnswer": { "@type": "Answer", "text": "Most construction company websites go live within 2 to 3 weeks. A five-page site can be ready in about two weeks, while larger projects with detailed project galleries or quote systems may take three to four weeks. We provide a clear timeline before starting." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "Construction Website Singapore", "item": "https://jraftcreative.com/construction-website-singapore/" }
    ]
  }
];
---

<style is:global>
  /* Hide the global background grid pattern on this page only */
  .animated-bg__grid { display: none; }

  /* More-prominent related-service pills — match challenge-card-v2 green treatment */
  #related-services .related-service-link {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.35);
    color: var(--text);
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  #related-services .related-service-link:hover {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.22) 0%, rgba(73, 184, 137, 0.1) 100%), rgba(20, 28, 32, 0.7);
    border-color: rgba(73, 184, 137, 0.6);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(73, 184, 137, 0.3);
  }

  /* Separate the CTA section from related-services with bg-alt */
  .service-cta-section {
    background: var(--bg-alt) !important;
  }

  /* Enrolment Funnel — 5-stage horizontal flow with green accents */
  .renovation-funnel {
    list-style: none;
    padding: 0;
    margin: 56px 0 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 48px;
    counter-reset: funnel;
  }
  .funnel-stage {
    position: relative;
    text-align: center;
    padding: 28px 20px;
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.28);
    border-radius: 12px;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .funnel-stage:hover {
    transform: translateY(-4px);
    border-color: rgba(73, 184, 137, 0.55);
    box-shadow: 0 16px 40px -16px rgba(73, 184, 137, 0.3);
  }
  .funnel-stage h3 {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--accent);
    margin: 0 0 8px 0;
    letter-spacing: -0.01em;
  }
  .funnel-stage p {
    font-size: 0.82rem;
    color: var(--text);
    line-height: 1.5;
    margin: 0;
  }
  .funnel-stage:not(:last-child)::after {
    content: '→';
    position: absolute;
    right: -34px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--accent);
    font-size: 1.6rem;
    font-weight: 500;
    z-index: 2;
    line-height: 1;
    opacity: 0.7;
  }
  @media (max-width: 900px) {
    .renovation-funnel {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }
    .funnel-stage:nth-child(2n)::after,
    .funnel-stage:last-child::after {
      display: none;
    }
    .funnel-stage:nth-child(2n-1)::after {
      right: -22px;
    }
  }
  @media (max-width: 600px) {
    .renovation-funnel {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .funnel-stage::after {
      display: none;
    }
  }
</style>

<ServiceLayout
  title="Construction Website Singapore — Jraft Creative"
  description="Website design for construction firms in Singapore. Project portfolios, quote request forms, BCA and safety credentials, built mobile-first to win work."
  canonical="https://jraftcreative.com/construction-website-singapore/"
  ogTitle="Construction Website Singapore — Jraft Creative"
  ogDescription="Website design for construction firms in Singapore. Project portfolios, quote request forms, BCA and safety credential badges."
  ogImage="https://jraftcreative.com/images/og-webdev.jpg"
  keywords="construction website singapore, building contractor website, construction company web design, A&A contractor website singapore, builder website design, renovation contractor website singapore, Jraft Creative"
  schemaData={schemaData}
  heroLabel="Construction Websites"
  heroTitle='Website Design for <span class="highlight">Construction Companies in Singapore</span>'
  heroSubtitle="Your company builds structures that last — your website should carry the same weight. We build professional, mobile-first websites for construction firms and contractors — with project portfolios, quote request forms, and BCA and safety credentials built in."
  heroImage="/images/service-construction.webp"
  heroImageAlt="Construction company website in Singapore"
  heroButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "See Our Work", href: "/about/", class: "btn btn-secondary" }
  ]}
  whatsappText="Hi Jraft Creative, I need a website for my construction company in Singapore."
  ctaLabel="Ready to Get Started?"
  ctaTitle="Get Your Construction Business Online"
  ctaDescription="Book a free consultation and tell us about your construction company. We'll get back to you within 24 hours with a tailored proposal."
  ctaButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%20need%20a%20website%20for%20my%20construction%20company%20in%20Singapore.", class: "btn btn-secondary" }
  ]}
  hideDefaultCta={false}
>

  <!-- ========== THE CHALLENGE ========== -->
  <section class="section" id="challenge" aria-label="Why construction companies need a proper website in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Challenge</p>
        <h2>Developers and PMs <span class="highlight">Vet Your Firm Online</span> Before They <span class="highlight">Issue a Tender</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Property developers, project managers, and procurement teams research contractors online before they schedule a site meeting or send an invitation to tender. They open three or four company websites, scan for completed projects, check that you're properly registered, and shortlist the firms that look capable. If your site is dated — or missing — the work quietly goes to a competitor whose track record is visible. A <a href="/blog/good-business-website-singapore/" class="inline-link">well-built business website</a> does that vetting in your favour, around the clock, even when your team is on-site island-wide.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Credentials Are Checked First</h3>
            <p>Before anyone trusts you with a build, they look for proof — BCA registration and grading, bizSAFE level, ISO standards, and a documented track record. If those signals aren't obvious on the page, a developer or main contractor assumes the risk isn't worth it and moves to the next firm on the list.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>A Crowded, Price-Driven Market</h3>
            <p>Singapore has thousands of registered contractors chasing the same projects, and most websites read identically — "general construction, A&amp;A works, M&amp;E, specialist trades". Without a real project portfolio and clear proof of capacity, you blur into the crowd and end up competing on price alone.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Enquiries That Never Arrive</h3>
            <p>A brochure site that just sits there isn't enough. The job of the website is to turn a cautious visitor into a quote request or a site call — with visible certifications, a browsable portfolio, and an easy enquiry path. Most contractor sites leave prospects with no obvious next step, so the lead disappears.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHAT WE DELIVER ========== -->
  <section class="section" id="sub-services" style="background: var(--bg-alt);" aria-label="Construction company website design deliverables">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">What We Deliver</p>
        <h2>Six <span class="highlight">Pillars</span> of a Construction Company <span class="highlight">Website</span></h2>
      </div>
      <div class="section-content reveal">
        <p>A construction website isn't an online store or a generic brochure. Developers, project managers, and homeowners arrive cautious, comparing you against other contractors, and they need to see capability, credentials, and a clear way to get a quote. We build every element around how work is actually won in Singapore — anchored on solid <a href="/services/website-development/" class="inline-link">website development</a> and shaped for the <a href="/industries/home-trade/" class="inline-link">home and trade sector</a>.</p>
      </div>
      <div class="service-details-grid deliver-grid">
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-business-website.webp');">
          <div class="service-detail-card__content">
            <h3>Credibility-Led Design</h3>
            <p>A clean, professional layout that signals capability the moment the page loads. Considered structure, strong project imagery, and a hierarchy that puts credentials and completed work first — so a prospect's instinctive "can this firm handle my project?" is answered before they read a word.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-onpage-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Project Portfolio &amp; Case Studies</h3>
            <p>Completed projects shown with professional photography, scope of work, and client references — organised by type, whether residential, commercial, industrial, or A&amp;A. Prospects browse relevant experience quickly and arrive at the enquiry already convinced you can deliver.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-graphic-design.webp');">
          <div class="service-detail-card__content">
            <h3>Certifications &amp; Licences</h3>
            <p>Prominently displayed BCA registration and grading, bizSAFE level, ISO certifications, and other industry credentials. In Singapore's construction sector these are often the first thing a client or PM checks — positioned above the fold and on every service page, not buried on an About page.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-local-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Quote &amp; Enquiry Forms</h3>
            <p>Structured forms that let clients submit project details, upload drawings or specifications, and request a quotation directly through the site. Spam protection, SSL, tap-to-call and WhatsApp options, so an interested developer or homeowner can reach your team in a single tap.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-speed-vitals.webp');">
          <div class="service-detail-card__content">
            <h3>Mobile Speed &amp; Core Web Vitals</h3>
            <p>Site supervisors and clients research contractors on their phones, often from the field. Every site is built mobile-first and tuned for fast load times and strong Core Web Vitals, so the page is ready the moment a prospect arrives and Google rewards the performance.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-ai.webp');">
          <div class="service-detail-card__content">
            <h3>Services &amp; Capability Pages</h3>
            <p>Dedicated pages for each capability — general construction, A&amp;A and renovation works, demolition, piling, M&amp;E, or specialist trades — each structured with clean titles, metas, local schema, and Google Business Profile setup so your firm surfaces for searches like "A&amp;A contractor Singapore" instead of being invisible.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHY CHOOSE US ========== -->
  <section class="section" id="why-us" aria-label="Why choose Jraft Creative for construction website design">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2>A <span class="highlight">Web Design Partner</span> Built for the <span class="highlight">Building Trade</span></h2>
      </div>
      <div class="section-content reveal">
        <p>We've built websites for trade and construction firms across Singapore — from CBD offices to contractors based in the industrial estates — and we know what turns a cautious developer or homeowner into a quote request: visible credentials, a real portfolio, and a frictionless enquiry path. We design every element of your site around that outcome.</p>
      </div>
      <div class="service-details-grid" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Construction Industry Experience</h3>
            <p>We understand the sector — from BCA grading and bizSAFE requirements to how project managers evaluate main contractors, A&amp;A specialists, and sub-contractors. Your website speaks the language of the industry, with credential displays and capability pages built in, not generic marketing copy.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Built to Win Work, Not Just Look Good</h3>
            <p>A handsome site that generates no enquiries is a wasted investment. We structure pages around the questions developers and homeowners ask, with the portfolio, certifications, and quote request placed exactly where they tip a visitor into getting in touch.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>One Agency, All Channels</h3>
            <p>A website is the foundation, but discovery and lead flow depend on more. We handle SEO, social, and paid ads in-house — an integrated system that brings the right developers, homeowners, and project managers to a site built to win them.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== THE BUYER FUNNEL ========== -->
  <section class="section" id="buyer-funnel" style="background: var(--bg-alt);" aria-label="The buyer funnel — where your website fits the client journey">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Buyer Funnel</p>
        <h2>Where Your <span class="highlight">Website</span> Fits the <span class="highlight">Buyer Journey</span></h2>
      </div>
      <div class="section-content reveal" style="margin-bottom: 24px;">
        <p>Every developer, project manager, and homeowner moves through the same five stages before appointing a contractor. Your website carries them from the first search to a submitted quote request — and feeds proof of capability into every stage along the way.</p>
      </div>
      <ol class="renovation-funnel reveal">
        <li class="funnel-stage">
          <h3>Research</h3>
          <p>Google search, Maps, referrals</p>
        </li>
        <li class="funnel-stage">
          <h3>Shortlist</h3>
          <p>Compare 3–4 contractors in seconds</p>
        </li>
        <li class="funnel-stage">
          <h3>Validate</h3>
          <p>BCA, bizSAFE, portfolio &amp; reviews</p>
        </li>
        <li class="funnel-stage">
          <h3>Enquire</h3>
          <p>Request a quote or site call</p>
        </li>
        <li class="funnel-stage">
          <h3>Engage</h3>
          <p>Award, deliver &amp; refer</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ========== FAQ ========== -->
  <section class="section faq-section" id="faq" style="background: var(--bg-alt);" aria-label="Frequently asked questions about construction website design in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">FAQ</p>
        <h2>Construction Website <span class="highlight">Questions Answered</span></h2>
      </div>
      <div class="faq-list">
        <details class="faq-item reveal reveal-d1">
          <summary>How much does a construction company website cost in Singapore?</summary>
          <div class="faq-answer"><p>Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>Can you showcase our BCA registration and safety certifications?</summary>
          <div class="faq-answer"><p>Yes. We prominently display your BCA registration and grading, bizSAFE level, ISO standards, and any other safety or quality credentials. In Singapore's construction industry, these are often the first thing developers and project managers check before shortlisting a contractor.</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>Can clients request quotes or send enquiries through the website?</summary>
          <div class="faq-answer"><p>Yes. We build structured quote and enquiry forms that let potential clients submit project details, upload drawings or specifications, and reach your team directly. It captures qualified leads around the clock and feeds straight into your business development pipeline.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>Do you help construction companies rank on Google?</summary>
          <div class="faq-answer"><p>Yes. We offer SEO with keyword targeting for searches like "construction company Singapore", "A&amp;A contractor Singapore", or "building contractor Singapore". We also set up Google Business Profile and industry schema markup. Book a consultation and we'll scope the right SEO setup for your goals.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>How long does it take to build a construction company website?</summary>
          <div class="faq-answer"><p>Most construction company websites go live within 2 to 3 weeks. A five-page site can be ready in about two weeks, while larger projects with detailed project galleries or quote systems may take three to four weeks. We provide a clear timeline before starting.</p></div>
        </details>
      </div>
    </div>
  </section>


  <RelatedServices
    topic="website"
    links={[
      { href: '/industries/home-trade/', label: 'Home &amp; Trade Marketing' },
      { href: '/services/website-development/', label: 'Website Development' },
      { href: '/services/seo-performance/', label: 'SEO &amp; Performance' },
      { href: '/services/paid-ads/', label: 'Paid Ads' }
    ]}
  />

</ServiceLayout>
