---
import ServiceLayout from '../layouts/ServiceLayout.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Spa Website Design Singapore",
    "description": "Professional website design for spas in Singapore. Treatment menus, online booking with therapist and time-slot selection, gift vouchers, and ambience galleries that turn visitors into booked appointments.",
    "provider": {
      "@type": "Organization",
      "name": "Jraft Creative",
      "url": "https://jraftcreative.com/",
      "logo": "https://jraftcreative.com/images/logo.png",
      "telephone": "+6582234578",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "60 Paya Lebar Road, Paya Lebar Square",
        "postalCode": "409051",
        "addressLocality": "Singapore",
        "addressCountry": "SG"
      }
    },
    "areaServed": { "@type": "Country", "name": "Singapore" },
    "serviceType": "Spa Website Design"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How much does a spa website cost in Singapore?", "acceptedAnswer": { "@type": "Answer", "text": "Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote." } },
      { "@type": "Question", "name": "Can you add online booking to my spa website?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We integrate with Fresha, Booksy, and other booking platforms used by spas in Singapore. Clients browse the treatment menu, pick a therapist, choose a time slot, and confirm — all on your website. That removes the phone tag and reduces no-shows because the booking is locked in the moment they decide." } },
      { "@type": "Question", "name": "Can you sell gift vouchers on my spa website?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We build voucher purchase into the site so clients can buy a fixed treatment or a monetary value online at any hour — useful around Mother's Day, birthdays, anniversaries, and corporate gifting in Singapore. Vouchers keep earning even when your treatment rooms are full." } },
      { "@type": "Question", "name": "Can you convey my spa's ambience on the website?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Atmosphere is what sells a spa, so we lead with high-quality imagery, a calm colour palette, and optional ambient video. A gallery gives first-time visitors a feel for the room, the treatments, and the mood before they arrive — which makes booking a smaller leap." } },
      { "@type": "Question", "name": "Will my spa website work well on mobile?", "acceptedAnswer": { "@type": "Answer", "text": "Yes, and it's the priority. Most spa bookings happen on a phone, often late in the evening. Every page is built mobile-first with fast loads, clear navigation, and a tap-to-book button always within reach, so a tired visitor can go from browsing to booked in a few taps." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "Spa Website Design Singapore", "item": "https://jraftcreative.com/spa-website-design-singapore/" }
    ]
  }
];
---

<style is:global>
  /* Hide the global background grid pattern on this page only */
  .animated-bg__grid { display: none; }

  /* More-prominent related-service pills — match challenge-card-v2 green treatment */
  #related-services .related-service-link {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.35);
    color: var(--text);
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  #related-services .related-service-link:hover {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.22) 0%, rgba(73, 184, 137, 0.1) 100%), rgba(20, 28, 32, 0.7);
    border-color: rgba(73, 184, 137, 0.6);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(73, 184, 137, 0.3);
  }

  /* Separate the CTA section from related-services with bg-alt */
  .service-cta-section {
    background: var(--bg-alt) !important;
  }

  /* Patient Journey Funnel — 5-stage horizontal flow with green accents */
  .renovation-funnel {
    list-style: none;
    padding: 0;
    margin: 56px 0 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 48px;
    counter-reset: funnel;
  }
  .funnel-stage {
    position: relative;
    text-align: center;
    padding: 28px 20px;
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.28);
    border-radius: 12px;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .funnel-stage:hover {
    transform: translateY(-4px);
    border-color: rgba(73, 184, 137, 0.55);
    box-shadow: 0 16px 40px -16px rgba(73, 184, 137, 0.3);
  }
  .funnel-stage h3 {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--accent);
    margin: 0 0 8px 0;
    letter-spacing: -0.01em;
  }
  .funnel-stage p {
    font-size: 0.82rem;
    color: var(--text);
    line-height: 1.5;
    margin: 0;
  }
  .funnel-stage:not(:last-child)::after {
    content: '→';
    position: absolute;
    right: -34px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--accent);
    font-size: 1.6rem;
    font-weight: 500;
    z-index: 2;
    line-height: 1;
    opacity: 0.7;
  }
  @media (max-width: 900px) {
    .renovation-funnel {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }
    .funnel-stage:nth-child(2n)::after,
    .funnel-stage:last-child::after {
      display: none;
    }
    .funnel-stage:nth-child(2n-1)::after {
      right: -22px;
    }
  }
  @media (max-width: 600px) {
    .renovation-funnel {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .funnel-stage::after {
      display: none;
    }
  }
</style>

<ServiceLayout
  title="Spa Website Design Singapore — Web Design Agency"
  description="Website design for spas in Singapore. Treatment menus, online booking with therapist and slot selection, gift vouchers, and ambience galleries."
  canonical="https://jraftcreative.com/spa-website-design-singapore/"
  ogTitle="Spa Website Design Singapore — Web Design Agency"
  ogDescription="Website design for spas in Singapore. Treatment menus, online booking, gift vouchers, and immersive ambience galleries."
  ogImage="https://jraftcreative.com/images/og-spa.jpg"
  keywords="spa website design singapore, spa website singapore, spa booking website, wellness website design, massage spa website, day spa web design, spa gift voucher website, Jraft Creative"
  schemaData={schemaData}
  heroLabel="Web Design Agency for Spas"
  heroTitle='Web Design Agency for <span class="highlight">Spas in Singapore</span>'
  heroSubtitle="Your spa sells calm — the website is where a stressed visitor decides to book that feeling. We build elegant, mobile-first spa websites with online booking, a full treatment menu, gift-voucher purchase, and galleries that carry your ambience, so a browse turns into a confirmed appointment."
  heroImage="/images/service-spa.webp"
  heroImageAlt="Tranquil spa treatment room in Singapore — spa web design"
  heroButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "See Our Work", href: "/about/", class: "btn btn-secondary" }
  ]}
  whatsappText="Hi Jraft Creative, I need a website for my spa in Singapore."
  ctaLabel="Ready to Get Started?"
  ctaTitle="Get Your Spa Online"
  ctaDescription="Book a free consultation and tell us about your spa. We'll get back to you within 24 hours with a tailored proposal covering design, booking integration, and gift-voucher purchase."
  ctaButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%20need%20a%20website%20for%20my%20spa%20in%20Singapore.", class: "btn btn-secondary" }
  ]}
  hideDefaultCta={false}
>

  <!-- ========== THE CHALLENGE ========== -->
  <section class="section" id="challenge" aria-label="Why spas need a proper website">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Challenge</p>
        <h2>People Book a Spa on Feeling — Is Your <span class="highlight">Website Selling the Calm</span>?</h2>
      </div>
      <div class="section-content reveal">
        <p>A spa visit is an emotional purchase. Someone searching "massage near me" late at night wants to feel the room before they arrive, see the treatment they need, and lock a time without a phone call. A thin website leaves them guessing — and they book the spa that answered them first.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Booking Happens in the Moment</h3>
            <p>The urge to book a massage or facial passes fast. If a visitor has to WhatsApp and wait for a reply, that intent cools. A site that takes the booking there and then captures it.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Ambience Doesn't Travel on a Listing</h3>
            <p>A marketplace tile or a busy Instagram feed can't convey the hush of your room, the scent, the ritual. First-time visitors need to feel welcome before they'll trust you with an hour of quiet.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>The Menu Is Doing the Selling</h3>
            <p>Swedish, deep tissue, aromatherapy, hot stone, facials, body scrubs, foot reflexology — visitors need it laid out clearly to choose. A confusing menu sends them elsewhere.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHAT WE BUILD ========== -->
  <section class="section" id="sub-services" style="background: var(--bg-alt);" aria-label="Spa website design services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">What We Build</p>
        <h2>Six <span class="highlight">Pillars</span> of a Spa <span class="highlight">Website That Books</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Every element is built to carry your atmosphere and shorten the path from browsing to a confirmed appointment.</p>
        <p>Once the site is live, pair it with <a href="/spa-seo-singapore/" class="inline-link">spa SEO</a> to rank for "spa near me" searches, <a href="/spa-social-media-singapore/" class="inline-link">spa social media</a> to keep your ambience in the feed, and <a href="/spa-google-ads-singapore/" class="inline-link">spa Google Ads</a> to push seasonal packages and gift-voucher campaigns.</p>
      </div>
      <div class="service-details-grid deliver-grid">
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-business-website.webp');">
          <div class="service-detail-card__content">
            <h3>Treatment &amp; Service Menu</h3>
            <p>Clear pages grouped by type — massage, facials, body scrubs and wraps, foot reflexology, sauna and steam — each with duration and what to expect, so visitors browse, compare, and pick with confidence.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-landing-page.webp');">
          <div class="service-detail-card__content">
            <h3>Online Booking</h3>
            <p>Pick a service, choose a therapist, take a time slot, and confirm — right on the site, at any hour. It closes the gap between "I need this" and "it's booked", and cuts the no-shows.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-local-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Gift-Voucher Purchase</h3>
            <p>Vouchers for a set treatment or a monetary value, bought online in minutes — the go-to for Mother's Day, birthdays, anniversaries, and corporate gifting, earning even when the rooms are full.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-graphic-design.webp');">
          <div class="service-detail-card__content">
            <h3>Ambience Gallery</h3>
            <p>Immersive imagery, a calm palette, and optional ambient video that carry the mood of your space online. An optional 360-degree tour lets visitors walk the room before they book.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-onpage-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Couples &amp; Package Rituals</h3>
            <p>Dedicated pages for couples suites, spa-day packages, and signature rituals — bundled and presented so visitors reach for the higher-value experience, not just a single treatment.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-speed-vitals.webp');">
          <div class="service-detail-card__content">
            <h3>Mobile-First, Fast Foundations</h3>
            <p>Clean structure, schema, and quick mobile loads built in, with a tap-to-book button always in reach — so a tired evening visitor can book in a few taps, and the site can rank on its own merits.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHY CHOOSE US ========== -->
  <section class="section" id="why-us" aria-label="Why choose Jraft Creative for spa website design">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2>A <span class="highlight">Web Design Agency</span> That Builds for <span class="highlight">Bookings</span></h2>
      </div>
      <div class="section-content reveal">
        <p>We build across the wider world of <a href="/industries/beauty-aesthetics/">beauty and aesthetics marketing</a>, so we know how a spa client decides — mood, treatment choice, therapist, and how easy it is to book. If you want the fuller picture of what makes a site earn its keep, our guide on <a href="/blog/good-business-website-singapore/">what makes a good business website in Singapore</a> is a useful starting point.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Designed Around the Booking</h3>
            <p>Every layout choice points toward the same action — a confirmed appointment. Menu, gallery, and booking all sit where a visitor expects them, so nothing gets in the way of the tap.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Atmosphere That Reads as Calm</h3>
            <p>Spacing, palette, imagery, and pace are tuned to feel unhurried. The site should lower a visitor's shoulders the way the treatment does — that feeling is what converts.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Website, SEO &amp; Ads Together</h3>
            <p>We also run <a href="/spa-seo-singapore/">spa SEO</a> and <a href="/spa-google-ads-singapore/">spa Google Ads</a> — one agency for your spa's whole online presence, so the pieces pull in the same direction.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== CLIENT JOURNEY FUNNEL ========== -->
  <section class="section" id="buyer-funnel" style="background: var(--bg-alt);" aria-label="Where your website fits the client journey">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Client Journey</p>
        <h2>Where Your <span class="highlight">Website</span> Fits the <span class="highlight">Client Journey</span></h2>
      </div>
      <div class="section-content reveal" style="margin-bottom: 24px;">
        <p>A spa client moves through the same five stages before they walk in — across Orchard, Tanjong Pagar, Bugis, Dempsey, Holland Village, Tampines, and Sentosa. Your website carries the middle three: it's where they browse the menu, weigh you against nearby spas, and book the slot.</p>
      </div>
      <ol class="renovation-funnel reveal">
        <li class="funnel-stage">
          <h3>Discover</h3>
          <p>A search or a friend's tip brings them to the site</p>
        </li>
        <li class="funnel-stage">
          <h3>Browse</h3>
          <p>The treatment menu and gallery set the mood</p>
        </li>
        <li class="funnel-stage">
          <h3>Compare</h3>
          <p>Ambience and packages weigh you against nearby spas</p>
        </li>
        <li class="funnel-stage">
          <h3>Book</h3>
          <p>Service, therapist, and slot locked in on the spot</p>
        </li>
        <li class="funnel-stage">
          <h3>Return</h3>
          <p>A calm first visit, then rebooking &amp; gifting</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ========== FAQ ========== -->
  <section class="section faq-section" id="faq" style="background: var(--bg-alt);" aria-label="Frequently asked questions about spa website design in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">FAQ</p>
        <h2>Spa <span class="highlight">Website</span> Questions Answered</h2>
      </div>
      <div class="faq-list">
        <details class="faq-item reveal reveal-d1">
          <summary>How much does a spa website cost in Singapore?</summary>
          <div class="faq-answer"><p>Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>Can you add online booking to my spa website?</summary>
          <div class="faq-answer"><p>Yes. We integrate with Fresha, Booksy, and other booking platforms used by spas in Singapore. Clients browse the treatment menu, pick a therapist, choose a time slot, and confirm — all on your website. That removes the phone tag and reduces no-shows because the booking is locked in the moment they decide.</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>Can you sell gift vouchers on my spa website?</summary>
          <div class="faq-answer"><p>Yes. We build voucher purchase into the site so clients can buy a fixed treatment or a monetary value online at any hour — useful around Mother's Day, birthdays, anniversaries, and corporate gifting in Singapore. Vouchers keep earning even when your treatment rooms are full.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>Can you convey my spa's ambience on the website?</summary>
          <div class="faq-answer"><p>Yes. Atmosphere is what sells a spa, so we lead with high-quality imagery, a calm colour palette, and optional ambient video. A gallery gives first-time visitors a feel for the room, the treatments, and the mood before they arrive — which makes booking a smaller leap.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>Will my spa website work well on mobile?</summary>
          <div class="faq-answer"><p>Yes, and it's the priority. Most spa bookings happen on a phone, often late in the evening. Every page is built mobile-first with fast loads, clear navigation, and a tap-to-book button always within reach, so a tired visitor can go from browsing to booked in a few taps.</p></div>
        </details>
      </div>
    </div>
  </section>

  <!-- Related Services -->
  <section class="section" id="related-services" aria-label="Related services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Explore More</p>
        <h2>More <span class="highlight">Spa</span> Services</h2>
      </div>
      <div class="related-services-grid reveal">
          <a href="/spa-marketing-singapore/" class="related-service-link">Spa Marketing</a>
          <a href="/spa-seo-singapore/" class="related-service-link">Spa SEO</a>
          <a href="/spa-ai-search-optimisation-singapore/" class="related-service-link">Spa GEO</a>
          <a href="/spa-google-ads-singapore/" class="related-service-link">Spa Google Ads</a>
          <a href="/spa-social-media-singapore/" class="related-service-link">Spa Social Media</a>
          <a href="/spa-branding-singapore/" class="related-service-link">Spa Branding</a>
      </div>
    </div>
  </section>
</ServiceLayout>
