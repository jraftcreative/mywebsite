---
import ServiceLayout from '../layouts/ServiceLayout.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Social Media Agency for TCM Clinics Singapore",
    "description": "Social media agency for TCM clinics in Singapore. Bilingual wellness education, physician-led content and community management that builds trust and books appointments within TCMPB and MOH advertising rules.",
    "provider": {
      "@type": "Organization",
      "name": "Jraft Creative",
      "url": "https://jraftcreative.com/",
      "logo": "https://jraftcreative.com/images/logo.png",
      "telephone": "+6582234578",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "60 Paya Lebar Road, Paya Lebar Square",
        "postalCode": "409051",
        "addressLocality": "Singapore",
        "addressCountry": "SG"
      }
    },
    "areaServed": { "@type": "Country", "name": "Singapore" },
    "serviceType": "TCM Clinic Social Media"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "Which platforms should a TCM clinic in Singapore be on?", "acceptedAnswer": { "@type": "Answer", "text": "For most clinics, Instagram and TikTok carry short physician explainers and seasonal wellness tips, while 小红书 (Xiaohongshu) reaches Chinese-speaking wellness audiences who research before they book. We usually recommend depth on two platforms rather than a thin presence on five." } },
      { "@type": "Question", "name": "What should a TCM clinic actually post?", "acceptedAnswer": { "@type": "Answer", "text": "Physician-led explainers that demystify a treatment are the strongest content a clinic has — what acupuncture actually feels like, what tuina is for, what a first consultation involves. Around that we build seasonal wellness education, herbal soup and acupressure self-care tips, and warm introductions to your practitioners. Education and reassurance build far more bookings than promotion." } },
      { "@type": "Question", "name": "Are there advertising rules for TCM content in Singapore?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. The Traditional Chinese Medicine Practitioners Board and MOH advertising guidelines restrict treatment claims and testimonials used as proof of results. Every post we produce is written to stay within those rules and reviewed for compliance before it reaches you for approval." } },
      { "@type": "Question", "name": "Should our TCM content be in English or Chinese?", "acceptedAnswer": { "@type": "Answer", "text": "Both. Many TCM patients in Singapore are Chinese-speaking and search and scroll in Chinese, while a growing younger and English-speaking audience is discovering TCM for wellness. We produce bilingual content so a caption, a reel or a 小红书 post lands naturally with each audience rather than reading as a translation." } },
      { "@type": "Question", "name": "How does social media bring in appointments for a TCM clinic?", "acceptedAnswer": { "@type": "Answer", "text": "Rarely with a single post. Social validates you — a patient who has watched your physician calmly explain what a treatment involves arrives ready to book. We track profile-to-website clicks, saved and shared posts, and enquiries that mention social, not follower count." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "Social Media Agency for TCM Clinics Singapore", "item": "https://jraftcreative.com/tcm-clinic-social-media-singapore/" }
    ]
  }
];
---

<style is:global>
  /* Hide the global background grid pattern on this page only */
  .animated-bg__grid { display: none; }

  /* More-prominent related-service pills — match challenge-card-v2 green treatment */
  #related-services .related-service-link {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.35);
    color: var(--text);
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  #related-services .related-service-link:hover {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.22) 0%, rgba(73, 184, 137, 0.1) 100%), rgba(20, 28, 32, 0.7);
    border-color: rgba(73, 184, 137, 0.6);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(73, 184, 137, 0.3);
  }
  .service-cta-section { background: var(--bg-alt) !important; }
  .renovation-funnel { list-style: none; padding: 0; margin: 56px 0 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 48px; }
  .funnel-stage { position: relative; text-align: center; padding: 28px 20px; background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6); border: 1px solid rgba(73, 184, 137, 0.28); border-radius: 12px; transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease; }
  .funnel-stage:hover { transform: translateY(-4px); border-color: rgba(73, 184, 137, 0.55); box-shadow: 0 16px 40px -16px rgba(73, 184, 137, 0.3); }
  .funnel-stage h3 { font-size: 1.05rem; font-weight: 600; color: var(--accent); margin: 0 0 8px 0; letter-spacing: -0.01em; }
  .funnel-stage p { font-size: 0.82rem; color: var(--text); line-height: 1.5; margin: 0; }
  .funnel-stage:not(:last-child)::after { content: '→'; position: absolute; right: -34px; top: 50%; transform: translateY(-50%); color: var(--accent); font-size: 1.6rem; font-weight: 500; z-index: 2; line-height: 1; opacity: 0.7; }
  @media (max-width: 900px) { .renovation-funnel { grid-template-columns: repeat(2, 1fr); gap: 32px; } .funnel-stage:nth-child(2n)::after, .funnel-stage:last-child::after { display: none; } .funnel-stage:nth-child(2n-1)::after { right: -22px; } }
  @media (max-width: 600px) { .renovation-funnel { grid-template-columns: 1fr; gap: 20px; } .funnel-stage::after { display: none; } }
</style>

<ServiceLayout
  title="Social Media Agency for TCM Clinics Singapore"
  description="Social media agency for TCM clinics in Singapore — bilingual, physician-led wellness content that turns followers into booked patients."
  canonical="https://jraftcreative.com/tcm-clinic-social-media-singapore/"
  ogTitle="Social Media Agency for TCM Clinics Singapore"
  ogDescription="Social media for TCM clinics in Singapore. Bilingual physician-led wellness content built to book appointments, within TCMPB rules."
  ogImage="https://jraftcreative.com/images/og-tcm.jpg"
  keywords="social media agency for tcm clinics, tcm clinic social media singapore, tcm instagram singapore, tcm tiktok, 小红书 tcm singapore, chinese medicine social media, tcm content marketing, Jraft Creative"
  schemaData={schemaData}
  heroLabel="Social Media Agency for TCM Clinics"
  heroTitle='Social Media Agency for <span class="highlight">TCM Clinics in Singapore</span>'
  heroSubtitle="Patients choose a physician they trust, and with TCM that trust often starts with understanding what a treatment actually involves. We turn your practitioners' knowledge into bilingual content that demystifies TCM, teaches everyday wellness, and books appointments — all within TCMPB rules."
  heroImage="/images/service-tcm.webp"
  heroImageAlt="TCM clinic in Singapore — social media"
  heroButtons={[
    { text: "Get a Free Content Review", href: "/contact/", class: "btn btn-primary" },
    { text: "See TCM Clinic SEO", href: "/tcm-clinic-seo-singapore/", class: "btn btn-secondary" }
  ]}
  whatsappText="Hi Jraft Creative, I need social media for my TCM clinic in Singapore."
  ctaLabel="Book More Appointments"
  ctaTitle="Get a Free TCM Content Review"
  ctaDescription="Book a free consultation and we'll look at what you post now, what your physicians could be sharing, and where the gap is between followers and booked appointments. We'll get back to you within 24 hours."
  ctaButtons={[
    { text: "Get a Free Content Review", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%20need%20social%20media%20for%20my%20TCM%20clinic%20in%20Singapore.", class: "btn btn-secondary" }
  ]}
  hideDefaultCta={false}
>

  <!-- ========== THE CHALLENGE ========== -->
  <section class="section" id="challenge" aria-label="Social Media challenges for TCM clinics in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Challenge</p>
        <h2>Patients Don't Know What TCM Involves — <span class="highlight">Content</span> Is How You <span class="highlight">Show Them</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Unfamiliarity is the sector's biggest barrier. The clinics that explain their treatments online, in both English and Chinese, before a patient ever calls, are the ones that get booked.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Uncertainty Stops the Booking</h3>
            <p>Many patients hesitate because they don't know what acupuncture feels like or what tuina is for. A warm, educational feed answers those questions and turns curiosity into a booking.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>One Language Misses Half the Room</h3>
            <p>Many TCM patients are Chinese-speaking, while a younger English-speaking audience is discovering TCM for wellness. A feed in only one language quietly loses the other.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Compliant but Still Compelling</h3>
            <p>TCM content must stay within TCMPB and MOH rules on treatment claims and testimonials. Most clinics either post nothing or drift into claims they can't make. Neither books patients.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHAT WE DELIVER ========== -->
  <section class="section" id="sub-services" style="background: var(--bg-alt);" aria-label="Social Media services for TCM clinics">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">What We Deliver</p>
        <h2>Six <span class="highlight">Content Workstreams</span> for TCM <span class="highlight">Clinics</span></h2>
      </div>
      <div class="section-content reveal">
        <p>We build a bilingual cadence around what your clinic already does each week, turning everyday practice into trust across Instagram, TikTok and 小红书. It works best alongside a clear <a href="/tcm-clinic-website-singapore/">TCM clinic website</a>, <a href="/tcm-clinic-seo-singapore/">TCM clinic SEO</a>, and <a href="/tcm-clinic-google-ads-singapore/">Google Ads</a> so every channel points to the same booking.</p>
      </div>
      <div class="service-details-grid deliver-grid">
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-reels-video.webp');">
          <div class="service-detail-card__content">
            <h3>Physician-Led Explainers</h3>
            <p>Short video of your practitioners answering common questions — 'what does acupuncture feel like', 'what is tuina for', 'what happens at a first consultation' — building trust in the physician, not just the clinic.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-content-strategy.webp');">
          <div class="service-detail-card__content">
            <h3>Seasonal Wellness Education</h3>
            <p>Compliant carousels and Stories on everyday TCM wellness — seasonal tips, nourishing herbal soups, simple acupressure self-care — the content patients save and send to family in both English and Chinese.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-graphic-design.webp');">
          <div class="service-detail-card__content">
            <h3>Behind-the-Scenes &amp; Team</h3>
            <p>Warm clinic tours and physician introductions that give your practice a personality, so a first visit feels familiar before a patient walks in.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-community-mgmt.webp');">
          <div class="service-detail-card__content">
            <h3>Community Management</h3>
            <p>Prompt, professional handling of DMs, comments and enquiries in English and Chinese — nurturing a lead from first message to booked appointment.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-meta-ads.webp');">
          <div class="service-detail-card__content">
            <h3>小红书 (Xiaohongshu) Content</h3>
            <p>For clinics serving Chinese-speaking wellness audiences, we build a 小红书 presence with the saveable, research-friendly posts that platform rewards — where patients read before they book.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-campaign-analytics.webp');">
          <div class="service-detail-card__content">
            <h3>Reporting on Enquiries</h3>
            <p>We track profile-to-enquiry, saves and shares, and bookings that mention social — follower count is context, not the result.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHY US ========== -->
  <section class="section" id="why-us" aria-label="Why choose Jraft Creative for TCM social media">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2>A <span class="highlight">Social Media Agency</span> That Respects <span class="highlight">TCMPB Standards</span></h2>
      </div>
      <div class="section-content reveal">
        <p>TCM social fails on either unfamiliarity or compliance. We handle both, in two languages, with your physicians in control of every post.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>TCMPB Compliance Expertise</h3>
            <p>Every piece is checked against Traditional Chinese Medicine Practitioners Board and MOH rules before it reaches you — educational content that stays within the boundaries, no prohibited treatment claims.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Bilingual, Not Translated</h3>
            <p>We write natively in English and Chinese so each caption, reel and 小红书 post lands with its audience — the difference between content that reads warmly and content that reads as a translation.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>You Approve Before Publishing</h3>
            <p>You and your physicians sign off every post, caption and visual. Nothing goes live without your approval.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== PATIENT JOURNEY FUNNEL ========== -->
  <section class="section" id="buyer-funnel" style="background: var(--bg-alt);" aria-label="Where social media fits the TCM patient journey">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Patient Journey</p>
        <h2>Where <span class="highlight">Social</span> Fits the <span class="highlight">Patient Journey</span></h2>
      </div>
      <div class="section-content reveal" style="margin-bottom: 24px;">
        <p>A TCM patient moves through five stages before booking. Social rarely wins the first search — its job is Validate and Compare, where physician-led education answers the questions that stop a patient booking.</p>
      </div>
      <ol class="renovation-funnel reveal">
        <li class="funnel-stage"><h3>Discover</h3><p>A reel or a saved 小红书 post puts you on the radar</p></li>
        <li class="funnel-stage"><h3>Validate</h3><p>Physician-led content demystifies the treatment</p></li>
        <li class="funnel-stage"><h3>Compare</h3><p>Reviews and warmth weigh the clinics</p></li>
        <li class="funnel-stage"><h3>Book</h3><p>DMs and profile link turn interest into a booking</p></li>
        <li class="funnel-stage"><h3>Treat</h3><p>A calm first visit, then recalls &amp; referrals</p></li>
      </ol>
    </div>
  </section>

  <!-- ========== FAQ ========== -->
  <section class="section faq-section" id="faq" style="background: var(--bg-alt);" aria-label="Frequently asked questions about TCM social media">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">FAQ</p>
        <h2>TCM Clinic Social Media — Questions Answered</h2>
      </div>
      <div class="faq-list">
        <details class="faq-item reveal reveal-d1">
          <summary>Which platforms should a TCM clinic in Singapore be on?</summary>
          <div class="faq-answer"><p>For most clinics, Instagram and TikTok carry short physician explainers and seasonal wellness tips, while 小红书 (Xiaohongshu) reaches Chinese-speaking wellness audiences who research before they book. We usually recommend depth on two platforms rather than a thin presence on five.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>What should a TCM clinic actually post?</summary>
          <div class="faq-answer"><p>Physician-led explainers that demystify a treatment are the strongest content a clinic has — what acupuncture actually feels like, what tuina is for, what a first consultation involves. Around that we build seasonal wellness education, herbal soup and acupressure self-care tips, and warm introductions to your practitioners. Education and reassurance build far more bookings than promotion.</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>Are there advertising rules for TCM content in Singapore?</summary>
          <div class="faq-answer"><p>Yes. The Traditional Chinese Medicine Practitioners Board and MOH advertising guidelines restrict treatment claims and testimonials used as proof of results. Every post we produce is written to stay within those rules and reviewed for compliance before it reaches you for approval.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>Should our TCM content be in English or Chinese?</summary>
          <div class="faq-answer"><p>Both. Many TCM patients in Singapore are Chinese-speaking and search and scroll in Chinese, while a growing younger and English-speaking audience is discovering TCM for wellness. We produce bilingual content so a caption, a reel or a 小红书 post lands naturally with each audience rather than reading as a translation.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>How does social media bring in appointments for a TCM clinic?</summary>
          <div class="faq-answer"><p>Rarely with a single post. Social validates you — a patient who has watched your physician calmly explain what a treatment involves arrives ready to book. We track profile-to-website clicks, saved and shared posts, and enquiries that mention social, not follower count.</p></div>
        </details>
      </div>
    </div>
  </section>

  <!-- Related Services -->
  <section class="section" id="related-services" aria-label="Related services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Explore More</p>
        <h2>More <span class="highlight">TCM Clinic</span> Services</h2>
      </div>
      <div class="related-services-grid reveal">
          <a href="/tcm-marketing-singapore/" class="related-service-link">TCM Clinic Marketing</a>
          <a href="/tcm-clinic-seo-singapore/" class="related-service-link">TCM Clinic SEO</a>
          <a href="/tcm-clinic-ai-search-optimisation-singapore/" class="related-service-link">TCM Clinic GEO</a>
          <a href="/tcm-clinic-google-ads-singapore/" class="related-service-link">TCM Clinic Google Ads</a>
          <a href="/tcm-clinic-branding-singapore/" class="related-service-link">TCM Clinic Branding</a>
          <a href="/tcm-clinic-website-singapore/" class="related-service-link">TCM Clinic Websites</a>
      </div>
    </div>
  </section>
</ServiceLayout>
