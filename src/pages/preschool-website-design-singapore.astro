---
import ServiceLayout from '../layouts/ServiceLayout.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Preschool Website Design Singapore",
    "description": "Custom website design for ECDA-licensed preschools in Singapore — programme pages by age group, enrolment enquiry and centre-visit booking forms, teacher profiles, consent-gated photo galleries, and local SEO.",
    "provider": {
      "@type": "Organization",
      "name": "Jraft Creative",
      "url": "https://jraftcreative.com/",
      "logo": "https://jraftcreative.com/images/logo.png",
      "telephone": "+6582234578",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "60 Paya Lebar Road, Paya Lebar Square",
        "postalCode": "409051",
        "addressLocality": "Singapore",
        "addressCountry": "SG"
      }
    },
    "areaServed": { "@type": "Country", "name": "Singapore" },
    "serviceType": "Preschool Website Design"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How much does a preschool website cost in Singapore?", "acceptedAnswer": { "@type": "Answer", "text": "Pricing depends on your goals, your enrolment targets, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote." } },
      { "@type": "Question", "name": "Can parents book a centre visit or submit an enrolment enquiry through the website?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We build centre-visit booking and enrolment enquiry forms directly into your preschool website. Parents can pick a programme by age group — playgroup, nursery, K1 or K2 — choose a visit slot, enter their child's date of birth, and receive an automated confirmation, so your admin team gets organised entries instead of scattered WhatsApp messages and paper forms." } },
      { "@type": "Question", "name": "How do you display ECDA licensing and subsidy information?", "acceptedAnswer": { "@type": "Answer", "text": "We create a dedicated section that shows your ECDA licence details, SPARK certification status, teacher-to-child ratios, and subsidy and Baby Bonus or Child Development Account information. These trust signals sit where parents naturally look while shortlisting a preschool online." } },
      { "@type": "Question", "name": "Will my preschool appear on Google Maps and local search results?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We optimise your website for local SEO and set up or enhance your Google Business Profile so your preschool appears in Google Maps and 'preschool near me' searches across neighbourhoods like Punggol, Sengkang, and Tampines. We also add location schema so Google connects your website with your physical centre." } },
      { "@type": "Question", "name": "How do you handle photos of children on the website?", "acceptedAnswer": { "@type": "Answer", "text": "Every photo of a child is consent-gated. We only publish images your centre has written parental consent to use, and we structure the gallery so you can add or remove photos easily as consent changes. This keeps your site warm and real while respecting each family's wishes." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "Preschool Website Design Singapore", "item": "https://jraftcreative.com/preschool-website-design-singapore/" }
    ]
  }
];
---

<style is:global>
  /* Hide the global background grid pattern on this page only */
  .animated-bg__grid { display: none; }

  /* More-prominent related-service pills — match challenge-card-v2 green treatment */
  #related-services .related-service-link {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.35);
    color: var(--text);
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  #related-services .related-service-link:hover {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.22) 0%, rgba(73, 184, 137, 0.1) 100%), rgba(20, 28, 32, 0.7);
    border-color: rgba(73, 184, 137, 0.6);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(73, 184, 137, 0.3);
  }

  /* Separate the CTA section from related-services with bg-alt */
  .service-cta-section {
    background: var(--bg-alt) !important;
  }

  /* Trial-to-Enrolment Funnel — 5-stage horizontal flow with green accents */
  .renovation-funnel {
    list-style: none;
    padding: 0;
    margin: 56px 0 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 48px;
    counter-reset: funnel;
  }
  .funnel-stage {
    position: relative;
    text-align: center;
    padding: 28px 20px;
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.28);
    border-radius: 12px;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .funnel-stage:hover {
    transform: translateY(-4px);
    border-color: rgba(73, 184, 137, 0.55);
    box-shadow: 0 16px 40px -16px rgba(73, 184, 137, 0.3);
  }
  .funnel-stage h3 {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--accent);
    margin: 0 0 8px 0;
    letter-spacing: -0.01em;
  }
  .funnel-stage p {
    font-size: 0.82rem;
    color: var(--text);
    line-height: 1.5;
    margin: 0;
  }
  .funnel-stage:not(:last-child)::after {
    content: '→';
    position: absolute;
    right: -34px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--accent);
    font-size: 1.6rem;
    font-weight: 500;
    z-index: 2;
    line-height: 1;
    opacity: 0.7;
  }
  @media (max-width: 900px) {
    .renovation-funnel {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }
    .funnel-stage:nth-child(2n)::after,
    .funnel-stage:last-child::after {
      display: none;
    }
    .funnel-stage:nth-child(2n-1)::after {
      right: -22px;
    }
  }
  @media (max-width: 600px) {
    .renovation-funnel {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .funnel-stage::after {
      display: none;
    }
  }
</style>

<ServiceLayout
  title="Preschool Website Design Singapore — Web Design Agency"
  description="Web design agency for preschools in Singapore — programme pages by age group, enrolment enquiry and centre-visit booking forms, teacher profiles."
  canonical="https://jraftcreative.com/preschool-website-design-singapore/"
  ogTitle="Preschool Website Design Singapore — Web Design Agency"
  ogDescription="Custom website design for ECDA-licensed preschools in Singapore. Programme pages by age group, enrolment enquiry forms, centre-visit booking, and local SEO."
  ogImage="https://jraftcreative.com/images/og-preschool.jpg"
  keywords="web design agency for preschools, preschool website design singapore, preschool web design, nursery website singapore, childcare website design, early childhood centre website, ECDA preschool website, Jraft Creative"
  schemaData={schemaData}
  heroLabel="Web Design Agency for Preschools"
  heroTitle='Web Design Agency for <span class="highlight">Preschools in Singapore</span>'
  heroSubtitle="Parents research three to five preschools online before scheduling a single visit. We build websites that showcase your programmes by age group, highlight your teachers, and make booking a centre tour effortless — so a parent's visit to your site becomes a booked tour or an enrolment enquiry."
  heroImage="/images/service-childcare.webp"
  heroImageAlt="Teacher reading with a young child at a Singapore preschool"
  heroButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "See Preschool SEO", href: "/preschool-seo-singapore/", class: "btn btn-secondary" }
  ]}
  whatsappText="Hi Jraft Creative, I need a website for my preschool in Singapore."
  ctaLabel="Ready to Fill Your Next Intake?"
  ctaTitle="Get Your Preschool Online"
  ctaDescription="Tell us about your centre and we'll recommend the right website scope. Free consultation — no obligations, no pressure."
  ctaButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%20need%20a%20website%20for%20my%20preschool%20in%20Singapore.", class: "btn btn-secondary" }
  ]}
  hideDefaultCta={false}
>

  <!-- ========== THE CHALLENGE ========== -->
  <section class="section" id="challenge" aria-label="Website challenges for preschools in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Challenge</p>
        <h2>Parents Are <span class="highlight">Comparing Centres</span> — Can They <span class="highlight">Find Yours</span>?</h2>
      </div>
      <div class="section-content reveal">
        <p>Parents shortlist preschools side by side — programmes, teachers, daily routine, location — long before they ever call or book a visit.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>A Facebook Page Isn't Enough</h3>
            <p>Parents want programmes by age group, teacher backgrounds, photos and a way to book a visit in one place. A directory listing in Punggol or Sengkang answers none of it.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Parents Research Thoroughly</h3>
            <p>They check the ECDA licence, read the daily routine, look at classroom photos and compare subsidy details. Anything missing is a reason to choose another centre.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>First Impressions Decide It</h3>
            <p>From large chains to single-centre preschools, Singapore's early childhood scene is crowded. Your site is what decides whether a parent enquires or scrolls past.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHAT WE BUILD ========== -->
  <section class="section" id="sub-services" style="background: var(--bg-alt);" aria-label="Preschool website design services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">What We Build</p>
        <h2>Six <span class="highlight">Pillars</span> of a Preschool <span class="highlight">Website</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Every site is built to turn a browsing parent into a booked centre visit, not just to look good. Pair it with our <a href="/preschool-seo-singapore/">preschool SEO</a>, <a href="/preschool-social-media-marketing-singapore/">social media marketing</a>, and <a href="/preschool-advertising-singapore/">preschool advertising</a> for one system that fills your intake.</p>
      </div>
      <div class="service-details-grid deliver-grid">
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-business-website.webp');">
          <div class="service-detail-card__content">
            <h3>Programme Pages by Age Group</h3>
            <p>A page for each level — playgroup, nursery, K1 and K2 — covering the curriculum approach, daily routine, enrichment and teacher-to-child ratios, so parents see exactly what their child's day looks like.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-landing-page.webp');">
          <div class="service-detail-card__content">
            <h3>Centre-Visit &amp; Enquiry Forms</h3>
            <p>Parents book a tour or send an enrolment enquiry directly from the site — programme, visit slot, child's date of birth, automated confirmations. Fewer phone calls for your front desk.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-local-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Teacher Profiles</h3>
            <p>Qualifications, years of experience and teaching approach, with headshots that give parents confidence in the people caring for their child every day.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-graphic-design.webp');">
          <div class="service-detail-card__content">
            <h3>Consent-Gated Photo Gallery</h3>
            <p>Warm, real photos of classrooms, outdoor play and learning corners — published only where you have written parental consent, and easy to update as consent changes.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-reels-video.webp');">
          <div class="service-detail-card__content">
            <h3>ECDA Licence &amp; Subsidy Info</h3>
            <p>A clear section for your ECDA licence, SPARK status, teacher-to-child ratios and subsidy and Child Development Account details, so families can verify your credentials at a glance.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-speed-vitals.webp');">
          <div class="service-detail-card__content">
            <h3>Mobile-First, Search-Ready</h3>
            <p>Fast mobile loads, tap-to-call buttons and schema built in from day one, so the site works for parents scrolling on the MRT and is ready to rank rather than needing rescuing later.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHY US ========== -->
  <section class="section" id="why-us" aria-label="Why choose Jraft Creative as your preschool web design agency">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2>A <span class="highlight">Web Design Agency</span> That Knows <span class="highlight">Preschools</span></h2>
      </div>
      <div class="section-content reveal">
        <p>We build for the specific problem preschools have — competing locally in neighbourhoods like Tampines, Jurong and Woodlands, then turning an enquiry into a booked visit and an enrolment. It is one strand of our wider <a href="/industries/education/">education marketing in Singapore</a>, and it starts with the fundamentals of a <a href="/blog/good-business-website-singapore/">good business website</a>.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Early Childhood Experience</h3>
            <p>We know the local landscape — ECDA licensing, SPARK, subsidy displays and what parents in Bishan or Ang Mo Kio expect to see before they book a visit.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Live Before Your Next Intake</h3>
            <p>Most preschool sites go live within two to three weeks, so you start capturing enquiries before the next intake or open house rather than after it.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Website, SEO &amp; Ads Together</h3>
            <p>We also run <a href="/preschool-seo-singapore/">preschool SEO</a> and <a href="/preschool-advertising-singapore/">preschool advertising</a> — one system for filling your intake.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== ENROLMENT FUNNEL ========== -->
  <section class="section" id="buyer-funnel" style="background: var(--bg-alt);" aria-label="Where your website fits the preschool parent journey">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Enrolment Funnel</p>
        <h2>Where Your <span class="highlight">Website</span> Fits the <span class="highlight">Parent Journey</span></h2>
      </div>
      <div class="section-content reveal" style="margin-bottom: 24px;">
        <p>Parents move through the same five stages before a child starts. Your website carries the middle three — it is where a parent validates your teachers and licence, compares you against the shortlist, and finally books the centre visit.</p>
      </div>
      <ol class="renovation-funnel reveal">
        <li class="funnel-stage">
          <h3>Discover</h3>
          <p>A search or referral brings them to the site</p>
        </li>
        <li class="funnel-stage">
          <h3>Validate</h3>
          <p>Teacher profiles, ECDA licence, classroom photos</p>
        </li>
        <li class="funnel-stage">
          <h3>Compare</h3>
          <p>Programme pages answer age group, routine and fit</p>
        </li>
        <li class="funnel-stage">
          <h3>Visit</h3>
          <p>Booking form turns interest into a scheduled tour</p>
        </li>
        <li class="funnel-stage">
          <h3>Enrol</h3>
          <p>Register for the term, settle in &amp; refer</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ========== PRICING ========== -->
  <!-- ========== FAQ ========== -->
  <section class="section faq-section" id="faq" style="background: var(--bg-alt);" aria-label="Frequently asked questions about preschool website design in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">FAQ</p>
        <h2>Preschool <span class="highlight">Website</span> Questions Answered</h2>
      </div>
      <div class="faq-list">
        <details class="faq-item reveal reveal-d1">
          <summary>How much does a preschool website cost in Singapore?</summary>
          <div class="faq-answer"><p>Pricing depends on your goals, your enrolment targets, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>Can parents book a centre visit or submit an enrolment enquiry through the website?</summary>
          <div class="faq-answer"><p>Yes. We build centre-visit booking and enrolment enquiry forms directly into your preschool website. Parents can pick a programme by age group — playgroup, nursery, K1 or K2 — choose a visit slot, enter their child's date of birth, and receive an automated confirmation, so your admin team gets organised entries instead of scattered WhatsApp messages and paper forms.</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>How do you display ECDA licensing and subsidy information?</summary>
          <div class="faq-answer"><p>We create a dedicated section that shows your ECDA licence details, SPARK certification status, teacher-to-child ratios, and subsidy and Baby Bonus or Child Development Account information. These trust signals sit where parents naturally look while shortlisting a preschool online.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>Will my preschool appear on Google Maps and local search results?</summary>
          <div class="faq-answer"><p>Yes. We optimise your website for local SEO and set up or enhance your Google Business Profile so your preschool appears in Google Maps and "preschool near me" searches across neighbourhoods like Punggol, Sengkang, and Tampines. We also add location-specific schema markup so Google connects your website with your physical centre.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>How do you handle photos of children on the website?</summary>
          <div class="faq-answer"><p>Every photo of a child is consent-gated. We only publish images your centre has written parental consent to use, and we structure the gallery so you can add or remove photos easily as consent changes. This keeps your site warm and real while respecting each family's wishes.</p></div>
        </details>
      </div>
    </div>
  </section>


  <!-- Related Services -->
  <section class="section" id="related-services" aria-label="Related services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Explore More</p>
        <h2>More <span class="highlight">Preschool</span> Services</h2>
      </div>
      <div class="related-services-grid reveal">
          <a href="/preschool-marketing-singapore/" class="related-service-link">Preschool Marketing</a>
          <a href="/preschool-seo-singapore/" class="related-service-link">Preschool SEO</a>
          <a href="/preschool-ai-search-optimisation-singapore/" class="related-service-link">Preschool GEO</a>
          <a href="/preschool-advertising-singapore/" class="related-service-link">Preschool Advertising</a>
          <a href="/preschool-social-media-marketing-singapore/" class="related-service-link">Preschool Social Media</a>
          <a href="/preschool-branding-singapore/" class="related-service-link">Preschool Branding</a>
      </div>
    </div>
  </section>
</ServiceLayout>
