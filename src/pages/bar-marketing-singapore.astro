---
import ServiceLayout from '../layouts/ServiceLayout.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Marketing Agency for Bars Singapore",
    "description": "Full-service marketing agency for bars and nightlife in Singapore — SEO, AI search, Google Ads, social, branding and websites that drive footfall, bookings and events.",
    "provider": {
      "@type": "Organization",
      "name": "Jraft Creative",
      "url": "https://jraftcreative.com/",
      "logo": "https://jraftcreative.com/images/logo.png",
      "telephone": "+6582234578",
      "address": { "@type": "PostalAddress", "streetAddress": "60 Paya Lebar Road, Paya Lebar Square", "postalCode": "409051", "addressLocality": "Singapore", "addressCountry": "SG" }
    },
    "areaServed": { "@type": "Country", "name": "Singapore" },
    "serviceType": "Bar Marketing"
  },
  { "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [
      { "@type": "Question", "name": "What does marketing for a bar involve?", "acceptedAnswer": { "@type": "Answer", "text": "Being discoverable in local search and on Google Maps, named by AI assistants, visible in paid results when people plan a night out, unmissable on social, branded as a destination, and a website that takes table and private-hire bookings." } },
      { "@type": "Question", "name": "Isn't social media enough for a bar?", "acceptedAnswer": { "@type": "Answer", "text": "Social drives discovery but misses the people actively searching 'bars near me' or 'private event venue', and it can't take a booking. The channels work together — social pulls them in, search catches intent, the site converts." } },
      { "@type": "Question", "name": "Can you help fill quiet weeknights?", "acceptedAnswer": { "@type": "Answer", "text": "Yes — that's often the highest-return work. We build targeted campaigns and event content aimed at the specific nights you need to fill, rather than spending on weekends that sell out anyway." } },
      { "@type": "Question", "name": "Do you handle private-hire and event bookings?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We build the demand and the booking path for private parties, corporate nights and events, which are usually a bar's most profitable covers." } },
      { "@type": "Question", "name": "How do you measure success?", "acceptedAnswer": { "@type": "Answer", "text": "Covers, table and event bookings, and cost per booking — not follower count or reach, which don't pay the rent." } }
    ] },
  { "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "Marketing Agency for Bars Singapore", "item": "https://jraftcreative.com/bar-marketing-singapore/" }
  ] }
];
---

<style is:global>
  /* Hide the global background grid pattern on this page only */
  .animated-bg__grid { display: none; }

  /* More-prominent related-service pills — match challenge-card-v2 green treatment */
  #related-services .related-service-link {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.35);
    color: var(--text);
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  #related-services .related-service-link:hover {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.22) 0%, rgba(73, 184, 137, 0.1) 100%), rgba(20, 28, 32, 0.7);
    border-color: rgba(73, 184, 137, 0.6);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(73, 184, 137, 0.3);
  }
  .service-cta-section { background: var(--bg-alt) !important; }
  .renovation-funnel { list-style: none; padding: 0; margin: 56px 0 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 48px; }
  .funnel-stage { position: relative; text-align: center; padding: 28px 20px; background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6); border: 1px solid rgba(73, 184, 137, 0.28); border-radius: 12px; transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease; }
  .funnel-stage:hover { transform: translateY(-4px); border-color: rgba(73, 184, 137, 0.55); box-shadow: 0 16px 40px -16px rgba(73, 184, 137, 0.3); }
  .funnel-stage h3 { font-size: 1.05rem; font-weight: 600; color: var(--accent); margin: 0 0 8px 0; letter-spacing: -0.01em; }
  .funnel-stage p { font-size: 0.82rem; color: var(--text); line-height: 1.5; margin: 0; }
  .funnel-stage:not(:last-child)::after { content: '→'; position: absolute; right: -34px; top: 50%; transform: translateY(-50%); color: var(--accent); font-size: 1.6rem; font-weight: 500; z-index: 2; line-height: 1; opacity: 0.7; }
  @media (max-width: 900px) { .renovation-funnel { grid-template-columns: repeat(2, 1fr); gap: 32px; } .funnel-stage:nth-child(2n)::after, .funnel-stage:last-child::after { display: none; } .funnel-stage:nth-child(2n-1)::after { right: -22px; } }
  @media (max-width: 600px) { .renovation-funnel { grid-template-columns: 1fr; gap: 20px; } .funnel-stage::after { display: none; } }
</style>

<ServiceLayout
  title="Marketing Agency for Bars Singapore"
  description="Marketing agency for bars in Singapore — SEO, social, ads and websites that drive footfall, table bookings and event nights."
  canonical="https://jraftcreative.com/bar-marketing-singapore/"
  ogTitle="Marketing Agency for Bars Singapore"
  ogDescription="Full-service marketing for Singapore bars and nightlife. Six channels that drive footfall, bookings and events."
  ogImage="https://jraftcreative.com/images/og-webdev.jpg"
  keywords="marketing agency for bars, bar marketing singapore, cocktail bar marketing, nightlife marketing singapore, bar social media singapore, Jraft Creative"
  schemaData={schemaData}
  heroLabel="Marketing Agency for Bars"
  heroTitle='Marketing Agency for <span class="highlight">Bars in Singapore</span>'
  heroSubtitle="In a nightlife scene this crowded, the bar people find and remember is the one that's full. We run the channels that drive footfall, bookings and event nights — social, search, ads, brand and website — judged on covers, not likes."
  heroImage="/images/service-bar.webp"
  heroImageAlt="Cocktail bar in Singapore — bar marketing"
  heroButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "See Bar Websites", href: "/bar-website-design-singapore/", class: "btn btn-secondary" }
  ]}
  whatsappText="Hi Jraft Creative, I'd like to talk about marketing for my bar in Singapore."
  ctaLabel="Fill the Room"
  ctaTitle="Get a Free Bar Marketing Review"
  ctaDescription="Book a free consultation and we'll look at how people discover you now, which nights are quiet, and which channel fills them fastest. We'll get back to you within 24 hours."
  ctaButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%27d%20like%20to%20talk%20about%20marketing%20for%20my%20bar%20in%20Singapore.", class: "btn btn-secondary" }
  ]}
  hideDefaultCta={false}
>

  <!-- ========== THE CHALLENGE ========== -->
  <section class="section" id="challenge" aria-label="Marketing challenges for bars in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Challenge</p>
        <h2>A Great <span class="highlight">Bar</span> in a Scene Where Everyone Is <span class="highlight">Shouting</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Singapore's nightlife is saturated and fast-moving. A brilliant bar with a quiet feed and no search presence simply loses the walk-in and the group booking to the one that shows up.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Discovery Happens on the Phone</h3>
            <p>People decide where to drink from Instagram, Google and reviews minutes before they move. If you're not there, you're not in the running for tonight.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Quiet Nights Bleed Money</h3>
            <p>Weekends fill themselves; Tuesdays don't. The gap between a packed Friday and an empty Wednesday is a marketing problem, not a product one.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Great Drinks, Forgettable Presence</h3>
            <p>A stunning cocktail programme with an inconsistent feed and no bookable site reads as smaller and less special than it is.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== SIX CHANNELS ========== -->
  <section class="section" id="sub-services" style="background: var(--bg-alt);" aria-label="Marketing channels for bars">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">What We Deliver</p>
        <h2>Six <span class="highlight">Marketing Channels</span> Every Bar <span class="highlight">Needs</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Each channel does a different job — from being discovered tonight to booking the private party next month.</p>
      </div>
      <div class="service-details-grid deliver-grid">
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-local-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Search &amp; Local SEO</h3>
            <p>Own 'bars near [area]', 'cocktail bar [neighbourhood]' and 'rooftop bar Singapore' searches, with a Google Business Profile built for discovery.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-ai.webp');">
          <div class="service-detail-card__content">
            <h3>AI Search &amp; GEO</h3>
            <p>Get named when someone asks an AI for a good cocktail bar in your area or the best spot for a group — the shortlist forms before they arrive.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-google-ads.webp');">
          <div class="service-detail-card__content">
            <h3>Google Ads</h3>
            <p>Fill quiet nights and promote events with tightly targeted local and interest-based campaigns, timed to when people plan a night out.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-reels-video.webp');">
          <div class="service-detail-card__content">
            <h3>Social Content</h3>
            <p>The engine bars live on — reels of drinks, atmosphere and events that make people screenshot and share to the group chat.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-graphic-design.webp');">
          <div class="service-detail-card__content">
            <h3>Brand &amp; Positioning</h3>
            <p>A brand and identity that make your bar feel like a destination, not just another unit — the difference between a walk-past and a walk-in.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-business-website.webp');">
          <div class="service-detail-card__content">
            <h3>Website That Converts</h3>
            <p>A <a href="/bar-website-design-singapore/">bar website</a> with menus, event calendar and table or private-hire booking that actually converts.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHY US ========== -->
  <section class="section" id="why-us" aria-label="Why choose Jraft Creative for bars marketing">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2>One <span class="highlight">Agency</span>, All Six <span class="highlight">Channels</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Most bars hand social to whoever's free and ignore search entirely. We run it as one system aimed at covers.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Channels That Feed Each Other</h3>
            <p>Social drives discovery, search captures intent, and the site takes the booking — each feeding the next instead of working alone.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Measured on Enquiries, Not Clicks</h3>
            <p>We report covers, bookings and event enquiries — the numbers that pay the rent — not followers that never walk in.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>One Team, Every Channel</h3>
            <p>Feed, search, Maps and site work as one, so a Friday scroll or a 'bars near me' search turns into a booked table or a full private night.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== FUNNEL ========== -->
  <section class="section" id="buyer-funnel" style="background: var(--bg-alt);" aria-label="How customers choose a bar">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Guest Journey</p>
        <h2>How People <span class="highlight">Choose a Bar Tonight</span></h2>
      </div>
      <div class="section-content reveal" style="margin-bottom: 24px;">
        <p>Discovery is fast and visual. Social and search decide whether you're an option, brand decides whether you're the one, and the site takes the booking.</p>
      </div>
      <ol class="renovation-funnel reveal">
        <li class="funnel-stage"><h3>Discover</h3><p>A reel, a search or a friend's suggestion</p></li>
        <li class="funnel-stage"><h3>Vibe-Check</h3><p>The feed and reviews sell the atmosphere</p></li>
        <li class="funnel-stage"><h3>Decide</h3><p>Location, menu and mood settle it</p></li>
        <li class="funnel-stage"><h3>Book / Walk In</h3><p>A table booking or a walk-through the door</p></li>
        <li class="funnel-stage"><h3>Return</h3><p>A great night, a follow &amp; the next group booking</p></li>
      </ol>
    </div>
  </section>

  <!-- ========== FAQ ========== -->
  <section class="section faq-section" id="faq" style="background: var(--bg-alt);" aria-label="Frequently asked questions about bars marketing">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">FAQ</p>
        <h2>Bar <span class="highlight">Marketing</span> — Questions Answered</h2>
      </div>
      <div class="faq-list">
        <details class="faq-item reveal reveal-d1">
          <summary>What does marketing for a bar involve?</summary>
          <div class="faq-answer"><p>Being discoverable in local search and on Google Maps, named by AI assistants, visible in paid results when people plan a night out, unmissable on social, branded as a destination, and a website that takes table and private-hire bookings.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>Isn't social media enough for a bar?</summary>
          <div class="faq-answer"><p>Social drives discovery but misses the people actively searching 'bars near me' or 'private event venue', and it can't take a booking. The channels work together — social pulls them in, search catches intent, the site converts.</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>Can you help fill quiet weeknights?</summary>
          <div class="faq-answer"><p>Yes — that's often the highest-return work. We build targeted campaigns and event content aimed at the specific nights you need to fill, rather than spending on weekends that sell out anyway.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>Do you handle private-hire and event bookings?</summary>
          <div class="faq-answer"><p>Yes. We build the demand and the booking path for private parties, corporate nights and events, which are usually a bar's most profitable covers.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>How do you measure success?</summary>
          <div class="faq-answer"><p>Covers, table and event bookings, and cost per booking — not follower count or reach, which don't pay the rent.</p></div>
        </details>
      </div>
    </div>
  </section>

  <!-- Related Services -->
  <section class="section" id="related-services" aria-label="Related services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Explore More</p>
        <h2>More <span class="highlight">F&amp;B</span> Services</h2>
      </div>
      <div class="related-services-grid reveal">
          <a href="/bar-website-design-singapore/" class="related-service-link">Bar Website Design</a>
          <a href="/fnb-marketing-singapore/" class="related-service-link">F&amp;B Marketing</a>
          <a href="/restaurant-marketing-singapore/" class="related-service-link">Restaurant Marketing</a>
          <a href="/cafe-marketing-singapore/" class="related-service-link">Cafe Marketing</a>
          <a href="/fnb-content-marketing-singapore/" class="related-service-link">F&amp;B Content Marketing</a>
      </div>
    </div>
  </section>
</ServiceLayout>
