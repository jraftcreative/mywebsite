---
import ServiceLayout from '../layouts/ServiceLayout.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Music School SEO Singapore",
    "description": "SEO services for music schools in Singapore. Local SEO, Google Business Profile optimisation, teacher profile SEO, course page optimisation, and content strategy to attract more students",
    "provider": {
      "@type": "Organization",
      "name": "Jraft Creative",
      "url": "https://jraftcreative.com/",
      "logo": "https://jraftcreative.com/images/logo.png",
      "telephone": "+6582234578",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "60 Paya Lebar Road, Paya Lebar Square",
        "postalCode": "409051",
        "addressLocality": "Singapore",
        "addressCountry": "SG"
      }
    },
    "areaServed": { "@type": "Country", "name": "Singapore" },
    "serviceType": "Music School SEO"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How much does SEO cost for a music school in Singapore?", "acceptedAnswer": { "@type": "Answer", "text": "Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote." } },
      { "@type": "Question", "name": "How long does it take for music school SEO to produce results?", "acceptedAnswer": { "@type": "Answer", "text": "Most music schools see measurable improvements in search rankings within 3 to 5 months. Instrument-specific and location-based keywords like 'piano lessons Bukit Timah' can rank faster than broad terms. Google Business Profile optimisation and technical fixes often deliver quick wins in the first few weeks." } },
      { "@type": "Question", "name": "What keywords do parents search for when looking for music lessons?", "acceptedAnswer": { "@type": "Answer", "text": "Common searches include 'piano lessons near me', 'violin class Singapore', 'guitar lessons for kids Singapore', 'music school [neighbourhood]', and exam-specific terms like 'ABRSM piano teacher Singapore' or 'Trinity guitar lessons'. We research the exact keywords your potential students and their parents are using." } },
      { "@type": "Question", "name": "Can you optimise individual teacher profile pages for SEO?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Teacher profile pages are a powerful SEO asset for music schools. We optimise each profile with the teacher's specialisations, qualifications, exam board experience (ABRSM, Trinity, LCM), and teaching location. This helps your school rank for specific queries like 'ABRSM Grade 8 piano teacher' or 'vocal coach Singapore'." } },
      { "@type": "Question", "name": "Do you handle SEO for music schools with multiple branches?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We create unique location pages for each branch, optimise separate Google Business Profiles, and build location-specific content so every studio ranks in its own area. Whether you have two outlets or ten across Singapore, each location gets targeted visibility in its neighbourhood." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "Music School SEO Singapore", "item": "https://jraftcreative.com/music-school-seo-singapore/" }
    ]
  }
];
---

<style is:global>
  /* Hide the global background grid pattern on this page only */
  .animated-bg__grid { display: none; }

  /* More-prominent related-service pills — match challenge-card-v2 green treatment */
  #related-services .related-service-link {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.35);
    color: var(--text);
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  #related-services .related-service-link:hover {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.22) 0%, rgba(73, 184, 137, 0.1) 100%), rgba(20, 28, 32, 0.7);
    border-color: rgba(73, 184, 137, 0.6);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(73, 184, 137, 0.3);
  }

  /* Separate the CTA section from related-services with bg-alt */
  .service-cta-section {
    background: var(--bg-alt) !important;
  }

  /* Enrolment Funnel — 5-stage horizontal flow with green accents */
  .renovation-funnel {
    list-style: none;
    padding: 0;
    margin: 56px 0 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 48px;
    counter-reset: funnel;
  }
  .funnel-stage {
    position: relative;
    text-align: center;
    padding: 28px 20px;
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.28);
    border-radius: 12px;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .funnel-stage:hover {
    transform: translateY(-4px);
    border-color: rgba(73, 184, 137, 0.55);
    box-shadow: 0 16px 40px -16px rgba(73, 184, 137, 0.3);
  }
  .funnel-stage h3 {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--accent);
    margin: 0 0 8px 0;
    letter-spacing: -0.01em;
  }
  .funnel-stage p {
    font-size: 0.82rem;
    color: var(--text);
    line-height: 1.5;
    margin: 0;
  }
  .funnel-stage:not(:last-child)::after {
    content: '→';
    position: absolute;
    right: -34px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--accent);
    font-size: 1.6rem;
    font-weight: 500;
    z-index: 2;
    line-height: 1;
    opacity: 0.7;
  }
  @media (max-width: 900px) {
    .renovation-funnel {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }
    .funnel-stage:nth-child(2n)::after,
    .funnel-stage:last-child::after {
      display: none;
    }
    .funnel-stage:nth-child(2n-1)::after {
      right: -22px;
    }
  }
  @media (max-width: 600px) {
    .renovation-funnel {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .funnel-stage::after {
      display: none;
    }
  }
</style>

<ServiceLayout
  title="Music School SEO Singapore — SEO Agency for Music Schools"
  description="SEO agency for music schools in Singapore. Local SEO, teacher profile optimisation, course-page SEO, and Google Business Profile that fills trials."
  canonical="https://jraftcreative.com/music-school-seo-singapore/"
  ogTitle="Music School SEO Singapore — SEO Agency for Music Schools"
  ogDescription="SEO agency for music schools in Singapore. Local SEO, teacher profile optimisation, course-page SEO, and Google Business Profile that fills trials."
  ogImage="https://jraftcreative.com/images/og-webdev.jpg"
  keywords="music school seo singapore, seo agency for music schools, seo for music schools, music school marketing singapore, piano lessons seo, violin class seo, music school google ranking, music education seo, Jraft Creative"
  schemaData={schemaData}
  heroLabel="SEO Agency for Music Schools"
  heroTitle='SEO Agency for <span class="highlight">Music Schools in Singapore</span>'
  heroSubtitle="Parents searching 'piano lessons near me' and 'violin class Singapore' are ready to book a trial. If your music school doesn't appear in those search results, students are walking into your competitor's studio instead. We help music schools rank higher on Google and turn search visibility into booked lessons."
  heroImage="/images/service-musicschool.webp"
  heroImageAlt="Music lesson in a Singapore studio — music school SEO"
  heroButtons={[
    { text: "Get a Free SEO Audit", href: "/contact/", class: "btn btn-primary" },
    { text: "See Music School Google Ads", href: "/music-school-google-ads-singapore/", class: "btn btn-secondary" }
  ]}
  whatsappText="Hi Jraft Creative, I need SEO for my music school in Singapore."
  ctaLabel="Get Found by More Students"
  ctaTitle="Get a Free Music School SEO Audit"
  ctaDescription="Book a free consultation and we'll review how your school currently ranks for instrument and neighbourhood searches, check your Google Business Profile, and show you where the enrolment enquiries are leaking. We'll get back to you within 24 hours."
  ctaButtons={[
    { text: "Get a Free SEO Audit", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%20need%20SEO%20for%20my%20music%20school%20in%20Singapore.", class: "btn btn-secondary" }
  ]}
  hideDefaultCta={false}
>

  <!-- ========== THE CHALLENGE ========== -->
  <section class="section" id="challenge" aria-label="SEO challenges for music schools in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Challenge</p>
        <h2>Students Search for <span class="highlight">Music Lessons</span> Online — Does Your School <span class="highlight">Show Up</span>?</h2>
      </div>
      <div class="section-content reveal">
        <p>Parents and adult learners start on Google, compare a handful of schools, and book a trial — often in one sitting.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Invisible in the Search That Matters</h3>
            <p>"Piano lessons near me" is searched thousands of times a month in Singapore. If your school isn't in those results, those students never know you exist.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Hundreds of Schools, One Pool of Students</h3>
            <p>Established chains and conservatory-trained independents compete for the same families. Schools investing in search quietly take the top positions without spending more on ads.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Search Demand Is Fragmented</h3>
            <p>Piano, violin, guitar, vocals and exam prep — each across several neighbourhoods. Without structure, schools spread thin and rank for nothing at all.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHAT WE DELIVER ========== -->
  <section class="section" id="sub-services" style="background: var(--bg-alt);" aria-label="SEO services for music schools">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">What We Deliver</p>
        <h2>Six <span class="highlight">Pillars</span> of Music School <span class="highlight">SEO</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Students search by instrument, level, exam board, location and age — so we build the site around how people actually look for lessons.</p>
      </div>
      <div class="service-details-grid deliver-grid">
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-seo-audit.webp');">
          <div class="service-detail-card__content">
            <h3>Technical SEO Audit</h3>
            <p>A full crawl for indexing issues, broken links, missing schema and slow mobile loads — the barriers stopping Google ranking you at all.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-onpage-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Course &amp; Teacher Profile Pages</h3>
            <p>A dedicated page per instrument and level, plus teacher profiles structured around qualifications and exam-board experience.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-local-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Local SEO &amp; Google Business Profile</h3>
            <p>Studio photos, lesson schedules, review management and citations — built to land you in the Maps three-pack for "near me" searches.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-ai.webp');">
          <div class="service-detail-card__content">
            <h3>Instrument Keyword Clusters</h3>
            <p>Piano, violin, guitar, drums, vocals and cello each have their own search landscape. Every instrument gets its own page and ranking strategy.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-graphic-design.webp');">
          <div class="service-detail-card__content">
            <h3>Exam Board &amp; Level Targeting</h3>
            <p>"ABRSM Grade 5 piano teacher" is a parent ready to commit. We optimise across ABRSM, Trinity, LCM and RSL at every level.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-speed-vitals.webp');">
          <div class="service-detail-card__content">
            <h3>Content Built for Research Mode</h3>
            <p>Guides answering "what age to start piano" or "ABRSM vs Trinity" — earning authority and traffic from parents still deciding.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHY US ========== -->
  <section class="section" id="why-us" aria-label="Why choose Jraft Creative as your music school SEO agency">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2>An <span class="highlight">SEO Agency</span> That Understands <span class="highlight">Music Schools</span></h2>
      </div>
      <div class="section-content reveal">
        <p>We work with education providers across Singapore that need to rank for dozens of instrument, location and level combinations.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Built Around Enrolment, Not Traffic</h3>
            <p>Rankings only matter if trials get booked. We optimise the path from search result to enquiry, not just the position.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Transparent Monthly Reporting</h3>
            <p>Rankings by instrument, organic traffic, Google Business Profile performance and enquiry data. No jargon, just whether more students are finding you.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Website, SEO &amp; Ads Together</h3>
            <p>We handle <a href="/music-school-website-singapore/">music school web design</a> and <a href="/music-school-google-ads-singapore/">Google Ads</a> under one roof — one system for student acquisition.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== ENROLMENT FUNNEL ========== -->
  <section class="section" id="buyer-funnel" style="background: var(--bg-alt);" aria-label="Where SEO fits the music parent journey">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Enrolment Funnel</p>
        <h2>Where <span class="highlight">Organic Search</span> Fits the <span class="highlight">Parent Journey</span></h2>
      </div>
      <div class="section-content reveal" style="margin-bottom: 24px;">
        <p>Parents move through the same five stages before a child starts lessons. SEO owns the earliest and the most repeated moments — Discover, when the first instrument search happens, and Validate, when a parent checks whether your teachers are credible.</p>
      </div>
      <ol class="renovation-funnel reveal">
        <li class="funnel-stage">
          <h3>Discover</h3>
          <p>Organic results catch the first instrument search</p>
        </li>
        <li class="funnel-stage">
          <h3>Validate</h3>
          <p>Teacher profiles, exam results, Google reviews</p>
        </li>
        <li class="funnel-stage">
          <h3>Compare</h3>
          <p>Shortlist studios within travel distance</p>
        </li>
        <li class="funnel-stage">
          <h3>Trial</h3>
          <p>Course pages turn the shortlist into a booking</p>
        </li>
        <li class="funnel-stage">
          <h3>Enrol</h3>
          <p>Sign for the term, renew &amp; refer</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ========== PRICING ========== -->
  <!-- ========== FAQ ========== -->
  <section class="section faq-section" id="faq" style="background: var(--bg-alt);" aria-label="Frequently asked questions about music school SEO in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">FAQ</p>
        <h2>Music School <span class="highlight">SEO</span> — Questions Answered</h2>
      </div>
      <div class="faq-list">
        <details class="faq-item reveal reveal-d1">
          <summary>How much does SEO cost for a music school in Singapore?</summary>
          <div class="faq-answer"><p>Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>How long does it take for music school SEO to produce results?</summary>
          <div class="faq-answer"><p>Most music schools see measurable improvements in search rankings within 3 to 5 months. Instrument-specific and location-based keywords like "piano lessons Bukit Timah" or "guitar class near Novena" can rank faster than broad competitive terms. Google Business Profile optimisation often delivers quick visibility gains in the first few weeks.</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>What keywords do parents search for when looking for music lessons?</summary>
          <div class="faq-answer"><p>Common searches include "piano lessons near me", "violin class Singapore", "guitar lessons for kids", "music school [neighbourhood]", and exam-specific terms like "ABRSM piano teacher Singapore" or "Trinity guitar lessons". We research and target the exact keywords your potential students and their parents are using in your area.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>Can you optimise individual teacher profile pages for SEO?</summary>
          <div class="faq-answer"><p>Yes. Teacher profile pages are a powerful SEO asset for music schools. We optimise each profile with the teacher's instrument specialisations, qualifications, exam board experience (ABRSM, Trinity, LCM), and teaching location. This helps your school rank for specific searches like "experienced violin teacher Singapore" or "vocal coach near Clementi".</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>Do you handle SEO for music schools with multiple branches?</summary>
          <div class="faq-answer"><p>Yes. We create unique location pages for each branch, optimise separate Google Business Profiles, and build location-specific content so every studio ranks in its own neighbourhood. Whether you operate from two outlets or ten across Singapore, each location receives targeted visibility in its area.</p></div>
        </details>
      </div>
    </div>
  </section>


  <!-- Related Services -->
  <section class="section" id="related-services" aria-label="Related services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Explore More</p>
        <h2>More <span class="highlight">Music School</span> Services</h2>
      </div>
      <div class="related-services-grid reveal">
          <a href="/music-school-branding-singapore/" class="related-service-link">Music School Branding</a>
          <a href="/music-school-marketing-singapore/" class="related-service-link">Full-Service Music School Marketing</a>
          <a href="/music-school-website-singapore/" class="related-service-link">Music School Website Design</a>
          <a href="/music-school-google-ads-singapore/" class="related-service-link">Music School Google Ads</a>
          <a href="/music-school-social-media-singapore/" class="related-service-link">Music School Social Media</a>
          <a href="/music-school-ai-search-optimisation-singapore/" class="related-service-link">Music School GEO / AI Search</a>
      </div>
    </div>
  </section>
</ServiceLayout>
