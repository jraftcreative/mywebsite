---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';

// ============================================================================
// 20-Minute Marketing Audit — Paid-Search Landing Page
// ----------------------------------------------------------------------------
// Single-purpose LP for the Google Ads rebuild. Cold search click → booked
// 20-minute marketing audit (form OR WhatsApp). No nav distractions.
// Brief: Marketing/Web Briefs/liam-jraft-free-audit-lp-brief-2026-07-03.md
//
// Offer wording: "20-Minute Marketing Audit" — NEVER "free". Light
// "complimentary / no obligation" reassurance only.
//
// Conversion path (must match contact.astro so Google Ads conversion fires):
//   form submit → Apps Script POST (no-cors) → set jraft_lead_ok token
//   synchronously → redirect to /thank-you/. The /thank-you/ gate reads the
//   token to avoid phantom conversions.
//
// gclid: BaseLayout already captures gclid → localStorage.jraft_gclid on
// landing and auto-injects [ref:GCLID] into all wa.me links. This page also
// reads the gclid URL param directly into a hidden field and includes it in
// the POST payload.
// ============================================================================

const WHATSAPP_NUMBER = '6582234578';
const WHATSAPP_TEXT = "Hi Jraft Creative, I'd like to book my 20-minute marketing audit.";
const waHref = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(WHATSAPP_TEXT)}`;

// Reuse AVA hero image — dark palette, on-brand holding image.
const heroImage = '/images/blog/what-is-geo-ai-search.webp';

const schemaData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    'name': '20-Minute Marketing Audit Singapore',
    'description': 'A complimentary, no-obligation 20-minute marketing audit for Singapore businesses. A live look at where you\'re losing customers across Google, AI search, and paid ads — plus the three fixes that would move the needle. Delivered by Jraft Creative, a full-service marketing agency in Singapore.',
    'provider': {
      '@type': 'Organization',
      'name': 'Jraft Creative',
      'url': 'https://jraftcreative.com/',
      'logo': 'https://jraftcreative.com/images/logo.png',
      'telephone': '+6582234578',
      'address': {
        '@type': 'PostalAddress',
        'streetAddress': '60 Paya Lebar Road, Paya Lebar Square',
        'postalCode': '409051',
        'addressLocality': 'Singapore',
        'addressCountry': 'SG'
      }
    },
    'areaServed': { '@type': 'Country', 'name': 'Singapore' },
    'serviceType': 'Marketing Audit',
    'offers': {
      '@type': 'Offer',
      'name': '20-Minute Marketing Audit',
      'description': 'A complimentary, no-obligation 20-minute live marketing audit across Google/SEO visibility, AI search (GEO) presence, and paid ads & tracking. No lock-in. Reply within 24 hours.',
      'url': 'https://jraftcreative.com/marketing-audit-singapore/',
      'availability': 'https://schema.org/InStock',
      'eligibleRegion': { '@type': 'Country', 'name': 'Singapore' }
    }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    'itemListElement': [
      { '@type': 'ListItem', 'position': 1, 'name': 'Home', 'item': 'https://jraftcreative.com/' },
      { '@type': 'ListItem', 'position': 2, 'name': '20-Minute Marketing Audit Singapore', 'item': 'https://jraftcreative.com/marketing-audit-singapore/' }
    ]
  }
];
---

<BaseLayout
  title="20-Minute Marketing Audit Singapore | Jraft Creative"
  description="A live look at where you're losing customers across Google, AI search, and ads — plus the 3 fixes that'd move the needle. Complimentary. No obligation. Singapore-based."
  canonical="https://jraftcreative.com/marketing-audit-singapore/"
  ogTitle="20-Minute Marketing Audit Singapore | Jraft Creative"
  ogDescription="A live look at where you're losing customers across Google, AI search, and ads — plus the 3 fixes that'd move the needle. Complimentary. No obligation."
  ogImage="https://jraftcreative.com/images/og-seo.jpg"
  keywords="marketing audit singapore, free marketing audit singapore, digital marketing agency singapore, seo agency singapore, google ads audit singapore, marketing consultation singapore, jraft creative"
  schemaData={schemaData}
  preloadImage={heroImage}
>
  <Hero
    title='20-Minute <span class="highlight">Marketing Audit</span>'
    subtitle="A live look at where you're losing customers across Google, AI search, and ads — plus the 3 fixes that'd move the needle. Complimentary. No obligation."
    backgroundImage={heroImage}
    heroLabel="Marketing Audit · Singapore"
    heroClass="service-hero maud-hero"
    buttons={[
      { text: "Book my 20-min audit", href: "#audit-form", class: "btn btn-primary" },
      { text: "Message us on WhatsApp", href: waHref, class: "btn btn-secondary" }
    ]}
  />

  <!-- ========== HERO TRUST LINE ========== -->
  <section class="section maud-trustline" aria-label="Reassurance">
    <div class="container">
      <p class="maud-trustline__text reveal">
        Singapore-based · No lock-in · Reply within 24 hours
      </p>
    </div>
  </section>

  <!-- ========== PROOF STRIP ========== -->
  <section class="section maud-proof" aria-label="Why trust us">
    <div class="container">
      <div class="maud-proof__grid reveal">
        <div class="maud-proof__item">
          <span class="maud-proof__mark" aria-hidden="true">◆</span>
          <p class="maud-proof__text">
            We got <strong>our own site cited in Google&rsquo;s AI Overview</strong> — we run the GEO playbook on ourselves first.
            <a href="/geo-agency-singapore/" class="maud-proof__link">See how &rarr;</a>
          </p>
        </div>
        <div class="maud-proof__item">
          <span class="maud-proof__mark" aria-hidden="true">◆</span>
          <p class="maud-proof__text">
            We run <strong>live client campaigns across Google, Meta, and TikTok</strong> — the audit shows you what we&rsquo;d actually do, not a generic checklist.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHAT THE AUDIT COVERS ========== -->
  <section class="section maud-section-alt" id="what-we-check" aria-label="What the audit covers">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">What We Check</p>
        <h2>Twenty minutes. Three surfaces where customers slip away.</h2>
      </div>

      <ul class="maud-cards reveal">
        <li class="maud-card">
          <span class="maud-card__num" aria-hidden="true">01</span>
          <h3>Google &amp; SEO visibility</h3>
          <p>Where you rank for the searches that bring buyers &mdash; and the pages quietly leaking them to competitors.</p>
        </li>
        <li class="maud-card">
          <span class="maud-card__num" aria-hidden="true">02</span>
          <h3>AI search (GEO) presence</h3>
          <p>Whether ChatGPT, Gemini, and Google&rsquo;s AI Overviews name you when your customer asks &mdash; or name someone else.</p>
        </li>
        <li class="maud-card">
          <span class="maud-card__num" aria-hidden="true">03</span>
          <h3>Paid ads &amp; tracking</h3>
          <p>If you run ads, whether the money&rsquo;s working and the conversions are even being counted correctly.</p>
        </li>
      </ul>
    </div>
  </section>

  <!-- ========== WHY JRAFT ========== -->
  <section class="section" id="why-jraft" aria-label="Why Jraft Creative">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2>A straight read on your marketing &mdash; not a sales pitch in disguise.</h2>
      </div>

      <ul class="maud-why reveal">
        <li class="maud-why__item">
          <h3>Full-service under one roof</h3>
          <p>SEO, AI search, paid ads, social, and web &mdash; so the audit connects the dots instead of pushing one product.</p>
        </li>
        <li class="maud-why__item">
          <h3>Measured on leads and revenue</h3>
          <p>We care about enquiries and sales, not impressions and vanity metrics. That&rsquo;s the lens for the whole 20 minutes.</p>
        </li>
        <li class="maud-why__item">
          <h3>No lock-in</h3>
          <p>Take the three fixes and run them yourself, or hand them to your current team. If we&rsquo;re a fit, we&rsquo;ll say so &mdash; no pressure.</p>
        </li>
      </ul>
    </div>
  </section>

  <!-- ========== THE FORM ========== -->
  <section class="section maud-section-alt maud-form-section" id="audit-form" aria-label="Book your marketing audit">
    <div class="container">
      <div class="maud-form-wrap reveal">
        <div class="maud-form-intro">
          <p class="section-label">Book Your Audit</p>
          <h2>Book my 20-minute marketing audit</h2>
          <p class="maud-form-desc">Tell us where to look and how to reach you. We&rsquo;ll come back within 24 hours to lock in a time. Complimentary, no obligation.</p>
        </div>

        <form class="maud-form" id="auditForm" novalidate>
          <div class="maud-form-fields">
            <div class="form-group">
              <label for="name">Name <span class="required">*</span></label>
              <input type="text" id="name" name="name" placeholder="Your full name" required autocomplete="name" aria-required="true">
              <span class="form-error" id="nameError" role="alert" aria-live="polite"></span>
            </div>

            <div class="form-group">
              <label for="business">Business name</label>
              <input type="text" id="business" name="business" placeholder="Your business" autocomplete="organization">
            </div>

            <div class="form-group">
              <label for="website">Website URL</label>
              <input type="url" id="website" name="website" placeholder="https://yourbusiness.com" autocomplete="url" inputmode="url">
            </div>

            <div class="form-group">
              <label for="contact">WhatsApp or email <span class="required">*</span></label>
              <input type="text" id="contact" name="contact" placeholder="+65 XXXX XXXX or you@company.com" required aria-required="true" autocomplete="off">
              <span class="form-error" id="contactError" role="alert" aria-live="polite"></span>
            </div>

            <!-- Honeypot — hidden from real users, filled by bots. Renamed from
                 "website" (now a real field) to "company_website". -->
            <div class="maud-hp" aria-hidden="true">
              <label for="company_website">Company website</label>
              <input type="text" id="company_website" name="company_website" tabindex="-1" autocomplete="off">
            </div>

            <!-- gclid capture (populated on load if present in URL / localStorage) -->
            <input type="hidden" id="gclid" name="gclid" value="">

            <button type="submit" class="btn btn-primary maud-submit" id="submitBtn" aria-label="Book my 20-minute marketing audit">Book My Audit</button>
            <p class="maud-form-fineprint">No spam. We reply within 24 hours.</p>
          </div>

          <div class="form-error-state" role="alert" aria-live="polite">
            <span class="form-error-icon" aria-hidden="true">!</span>
            <h3>Something went wrong</h3>
            <p>We couldn&rsquo;t send that. Please try again or message us on <a href={waHref} target="_blank" rel="noopener">WhatsApp</a>.</p>
            <button type="button" class="btn btn-primary maud-retry" aria-label="Try again">Try Again</button>
          </div>
        </form>
      </div>
    </div>
  </section>

  <!-- ========== WHATSAPP ALTERNATIVE ========== -->
  <section class="section maud-wa" aria-label="Book via WhatsApp">
    <div class="container">
      <div class="maud-wa__inner reveal">
        <h2 class="maud-wa__title">Prefer to just message us?</h2>
        <p class="maud-wa__copy">Tap below and we&rsquo;ll pick it up from there &mdash; same 20-minute audit, no form.</p>
        <a href={waHref} class="btn maud-wa__btn" target="_blank" rel="noopener" aria-label="Book your audit on WhatsApp">
          <svg viewBox="0 0 32 32" width="20" height="20" fill="currentColor" aria-hidden="true" style="margin-right:8px;vertical-align:-3px;"><path d="M16.004 0h-.008C7.174 0 0 7.176 0 16.004c0 3.5 1.13 6.742 3.05 9.378L1.054 31.29l6.118-1.962A15.91 15.91 0 0 0 16.004 32C24.826 32 32 24.826 32 16.004S24.826 0 16.004 0zm9.302 22.602c-.39 1.1-2.276 2.106-3.156 2.17-.796.058-1.78.082-2.872-.278a26.3 26.3 0 0 1-2.6-1.074c-4.576-2.186-7.566-6.826-7.796-7.142-.222-.316-1.836-2.478-1.836-4.726 0-2.248 1.162-3.356 1.574-3.814.39-.434.858-.542 1.144-.542.286 0 .572.004.82.014.264.012.618-.1.966.738.39.938 1.294 3.224 1.408 3.458.112.234.19.508.038.82-.15.316-.226.512-.448.79-.222.278-.468.62-.668.832-.222.234-.454.49-.196.962.26.47 1.154 1.906 2.478 3.088 1.702 1.52 3.136 1.99 3.582 2.214.448.222.708.19.968-.114.26-.306 1.118-1.302 1.416-1.75.298-.448.596-.37.998-.222.404.148 2.566 1.21 3.006 1.432.44.222.734.334.844.518.112.186.112 1.074-.278 2.174z"/></svg>
          Book on WhatsApp
        </a>
      </div>
    </div>
  </section>

  <!-- ========== CLOSING CTA ========== -->
  <section class="section maud-closing" aria-label="Closing call to action">
    <div class="container">
      <div class="maud-closing__inner reveal">
        <h2>Twenty minutes could change where your next 20 customers come from.</h2>
        <p class="maud-closing__copy">A live look across Google, AI search, and ads &mdash; plus the three fixes that&rsquo;d move the needle. Complimentary. No obligation.</p>
        <div class="maud-closing__buttons">
          <a href="#audit-form" class="btn btn-primary">Book my 20-min audit</a>
          <a href={waHref} class="btn btn-secondary" target="_blank" rel="noopener">Message us on WhatsApp</a>
        </div>
        <p class="maud-closing__trust">Singapore-based · No lock-in · Reply within 24 hours</p>
      </div>
    </div>
  </section>

  <!-- WhatsApp Button -->
  <a href={waHref} class="whatsapp-btn" target="_blank" rel="noopener" aria-label="Chat on WhatsApp" slot="after-footer">
    <svg viewBox="0 0 32 32" width="28" height="28" fill="#fff" aria-hidden="true"><path d="M16.004 0h-.008C7.174 0 0 7.176 0 16.004c0 3.5 1.13 6.742 3.05 9.378L1.054 31.29l6.118-1.962A15.91 15.91 0 0 0 16.004 32C24.826 32 32 24.826 32 16.004S24.826 0 16.004 0zm9.302 22.602c-.39 1.1-2.276 2.106-3.156 2.17-.796.058-1.78.082-2.872-.278a26.3 26.3 0 0 1-2.6-1.074c-4.576-2.186-7.566-6.826-7.796-7.142-.222-.316-1.836-2.478-1.836-4.726 0-2.248 1.162-3.356 1.574-3.814.39-.434.858-.542 1.144-.542.286 0 .572.004.82.014.264.012.618-.1.966.738.39.938 1.294 3.224 1.408 3.458.112.234.19.508.038.82-.15.316-.226.512-.448.79-.222.278-.468.62-.668.832-.222.234-.454.49-.196.962.26.47 1.154 1.906 2.478 3.088 1.702 1.52 3.136 1.99 3.582 2.214.448.222.708.19.968-.114.26-.306 1.118-1.302 1.416-1.75.298-.448.596-.37.998-.222.404.148 2.566 1.21 3.006 1.432.44.222.734.334.844.518.112.186.112 1.074-.278 2.174z"/></svg>
  </a>

  <!-- Audit form validation & submission (mirrors contact.astro gate + redirect) -->
  <script is:inline>
    function validateField(field, errorEl, rules) {
      var value = field.value.trim();
      for (var i = 0; i < rules.length; i++) {
        if (!rules[i].test(value)) {
          errorEl.textContent = rules[i].message;
          field.classList.add('form-input-error');
          field.setAttribute('aria-invalid', 'true');
          field.setAttribute('aria-describedby', errorEl.id);
          return false;
        }
      }
      errorEl.textContent = '';
      field.classList.remove('form-input-error');
      field.removeAttribute('aria-invalid');
      field.removeAttribute('aria-describedby');
      return true;
    }

    var nameField = document.getElementById('name');
    var contactField = document.getElementById('contact');
    var nameError = document.getElementById('nameError');
    var contactError = document.getElementById('contactError');

    var nameRules = [
      { test: function(v) { return v.length > 0; }, message: 'Please enter your name.' },
      { test: function(v) { return v.length >= 2; }, message: 'Name must be at least 2 characters.' }
    ];
    // Accept either an email OR a phone-like string (WhatsApp).
    var contactRules = [
      { test: function(v) { return v.length > 0; }, message: 'Please enter your WhatsApp number or email.' },
      {
        test: function(v) {
          var isEmail = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v);
          var digits = v.replace(/[^0-9]/g, '');
          var isPhone = digits.length >= 8;
          return isEmail || isPhone;
        },
        message: 'Enter a valid WhatsApp number or email so we can reach you.'
      }
    ];

    nameField.addEventListener('blur', function() { validateField(nameField, nameError, nameRules); });
    contactField.addEventListener('blur', function() { validateField(contactField, contactError, contactRules); });
    nameField.addEventListener('input', function() { if (nameField.classList.contains('form-input-error')) validateField(nameField, nameError, nameRules); });
    contactField.addEventListener('input', function() { if (contactField.classList.contains('form-input-error')) validateField(contactField, contactError, contactRules); });

    // --- gclid capture: URL param first, then BaseLayout's stored value ---
    (function() {
      var gclidField = document.getElementById('gclid');
      if (!gclidField) return;
      var gclid = '';
      try {
        gclid = new URLSearchParams(window.location.search).get('gclid') || '';
      } catch (e) {}
      if (!gclid) {
        try { gclid = localStorage.getItem('jraft_gclid') || ''; } catch (e) {}
      }
      if (gclid) gclidField.value = gclid;
    })();

    var APPS_SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbyyazRDsSx4C2NFFY1K1wJm6QH9v0cjZkDRcFKraSVrrg3nIjnaEe7UOyKCxhCe9TQWiQ/exec';

    document.getElementById('auditForm').addEventListener('submit', function (e) {
      e.preventDefault();
      var form = this;

      var nameValid = validateField(nameField, nameError, nameRules);
      var contactValid = validateField(contactField, contactError, contactRules);

      if (!nameValid || !contactValid) {
        if (!nameValid) nameField.focus();
        else contactField.focus();
        return;
      }

      // Honeypot check — if filled, silently reject (bots only)
      var honeypot = document.getElementById('company_website');
      if (honeypot && honeypot.value) {
        return;
      }

      var btn = document.getElementById('submitBtn');
      var name = nameField.value.trim();
      var business = document.getElementById('business').value.trim();
      var website = document.getElementById('website').value.trim();
      var contact = contactField.value.trim();
      var gclid = document.getElementById('gclid').value.trim();

      // Route the single "contact" field into email/phone for the CRM.
      var isEmail = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(contact);
      var email = isEmail ? contact : '';
      var phone = isEmail ? '' : contact;

      // Auto-built message so the CRM row is readable without a message field.
      var message = '20-min audit request — Business: ' + (business || 'n/a') + ', Website: ' + (website || 'n/a');

      btn.textContent = 'Booking...';
      btn.disabled = true;
      btn.setAttribute('aria-busy', 'true');

      // Landing page attribution (set by BaseLayout on first load)
      var landingPage = '/marketing-audit-singapore/';
      var landingReferrer = 'direct';
      try {
        landingPage = sessionStorage.getItem('jraft_landing_page') || window.location.pathname;
        landingReferrer = sessionStorage.getItem('jraft_landing_referrer') || 'direct';
      } catch (e) {}

      var data = {
        name: name,
        company: business,
        email: email,
        phone: phone,
        website: website,
        message: message,
        gclid: gclid,
        landing_page: landingPage,
        landing_referrer: landingReferrer
      };

      if (APPS_SCRIPT_URL !== 'PASTE_YOUR_APPS_SCRIPT_URL_HERE') {
        fetch(APPS_SCRIPT_URL, {
          method: 'POST',
          mode: 'no-cors',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        }).then(function () {
          // Set gate token SYNCHRONOUSLY before redirect so /thank-you/ fires the
          // Google Ads conversion. Fail open if sessionStorage is blocked.
          try { sessionStorage.setItem('jraft_lead_ok', String(Date.now())); } catch (e) {}
          window.location.href = '/thank-you/?lp=' + encodeURIComponent(landingPage) + '&ref=' + encodeURIComponent(landingReferrer);
        }).catch(function () {
          btn.textContent = 'Book My Audit';
          btn.disabled = false;
          btn.removeAttribute('aria-busy');
          form.querySelector('.maud-form-fields').style.display = 'none';
          form.querySelector('.form-error-state').style.display = 'flex';
        });
      }
    });

    var retryBtn = document.querySelector('.maud-retry');
    if (retryBtn) {
      retryBtn.addEventListener('click', function () {
        var form = document.getElementById('auditForm');
        form.querySelector('.form-error-state').style.display = 'none';
        form.querySelector('.maud-form-fields').style.display = 'block';
        var btn = document.getElementById('submitBtn');
        btn.textContent = 'Book My Audit';
        btn.disabled = false;
        btn.removeAttribute('aria-busy');
      });
    }
  </script>

<style>
  /* ============================================================
     20-Minute Marketing Audit LP styles
     ----------------------------------------------------------
     Dark-theme palette using site CSS vars from global.css.
     Mirrors the AVA page's restraint — quiet, dense, confident.
     ============================================================ */

  /* Trust line under hero */
  .maud-trustline {
    padding: 26px 0 8px;
    text-align: center;
  }
  .maud-trustline__text {
    margin: 0;
    font-size: 0.9rem;
    letter-spacing: 0.02em;
    color: var(--text-muted, #7a7a8c);
    text-transform: uppercase;
  }

  /* Section-alt rhythm */
  .maud-section-alt {
    background: var(--bg-alt, rgba(13, 13, 20, 0.6));
  }

  /* Proof strip */
  .maud-proof {
    padding: 32px 0 40px;
  }
  .maud-proof__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    max-width: 940px;
    margin: 0 auto;
  }
  .maud-proof__item {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 20px 22px;
    background: var(--bg-card, #12121b);
    border: 1px solid var(--border, rgba(255, 255, 255, 0.06));
    border-radius: var(--radius-sm, 10px);
  }
  .maud-proof__mark {
    color: var(--accent, #39BB9D);
    font-size: 0.8rem;
    line-height: 1.7;
    flex-shrink: 0;
  }
  .maud-proof__text {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--text-secondary, #c4c4cc);
  }
  .maud-proof__text strong { color: var(--text, #f0f0f2); }
  .maud-proof__link {
    display: inline-block;
    margin-top: 4px;
    color: var(--accent, #39BB9D);
    text-decoration: none;
    font-weight: 600;
    white-space: nowrap;
  }
  .maud-proof__link:hover { color: var(--accent-hover, #5dcf9e); }
  @media (max-width: 720px) {
    .maud-proof__grid { grid-template-columns: 1fr; }
  }

  /* What we check — 3 offset cards (not a cookie-cutter grid) */
  .maud-cards {
    list-style: none;
    padding: 0;
    margin: 34px 0 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .maud-card {
    position: relative;
    padding: 30px 24px 26px;
    background: var(--bg-card, #12121b);
    border: 1px solid var(--border, rgba(255, 255, 255, 0.06));
    border-radius: var(--radius-sm, 10px);
    overflow: hidden;
