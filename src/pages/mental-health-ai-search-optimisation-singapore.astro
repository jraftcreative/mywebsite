---
import ServiceLayout from '../layouts/ServiceLayout.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "GEO Agency for Therapy Practices Singapore",
    "description": "GEO and AI search optimisation agency for therapy and counselling practices in Singapore. Get your practice named when people ask ChatGPT, Gemini and Google AI Mode for a therapist or counsellor.",
    "provider": {
      "@type": "Organization",
      "name": "Jraft Creative",
      "url": "https://jraftcreative.com/",
      "logo": "https://jraftcreative.com/images/logo.png",
      "telephone": "+6582234578",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "60 Paya Lebar Road, Paya Lebar Square",
        "postalCode": "409051",
        "addressLocality": "Singapore",
        "addressCountry": "SG"
      }
    },
    "areaServed": { "@type": "Country", "name": "Singapore" },
    "serviceType": "Mental Health AI Search Optimisation"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "What is GEO for a therapy or counselling practice?", "acceptedAnswer": { "@type": "Answer", "text": "Generative Engine Optimisation is the work of getting your practice named when someone asks an AI assistant rather than searching Google. Ask ChatGPT for a couples counsellor near Novena and you get a shortlist of a few practices, not ten links. GEO is about being on that list, which depends on different signals from traditional SEO." } },
      { "@type": "Question", "name": "How is this different from the SEO you already do?", "acceptedAnswer": { "@type": "Answer", "text": "SEO earns a ranking position; GEO earns a mention inside a generated answer. Ranking factors still matter, but AI systems lean far more on structured data, entity clarity and how consistently your practice is described across the web. A practice can rank well and still never be named by an assistant — that is the gap we close." } },
      { "@type": "Question", "name": "What makes an AI name one therapy practice over another?", "acceptedAnswer": { "@type": "Answer", "text": "Specificity and corroboration. AI systems favour practices whose specialisations, therapist credentials and locations are stated clearly and confirmed in more than one place — your site, your Google Business Profile, professional directories and third-party listings. Vague copy gives a model nothing to match a person's question against." } },
      { "@type": "Question", "name": "Can you show whether it is working?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We monitor prompts a real client would use — by concern and neighbourhood — across ChatGPT, Gemini, Perplexity and Google AI Mode, and track whether your practice appears and how it is described. That gives an AI Visibility baseline, a mention-versus-citation rate, and a monthly movement report." } },
      { "@type": "Question", "name": "Is it too early to invest in AI search for a mental health practice?", "acceptedAnswer": { "@type": "Answer", "text": "It is early, and that is the argument for doing it. Very few Singapore therapy and counselling practices have done any of this work, so the competitive bar is low in a way it has not been in Google search for years. The practices that establish clean, accurate entity data now are the ones AI systems will keep drawing on as adoption grows." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "GEO Agency for Therapy Practices Singapore", "item": "https://jraftcreative.com/mental-health-ai-search-optimisation-singapore/" }
    ]
  }
];
---

<style is:global>
  /* Hide the global background grid pattern on this page only */
  .animated-bg__grid { display: none; }

  /* More-prominent related-service pills — match challenge-card-v2 green treatment */
  #related-services .related-service-link {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.35);
    color: var(--text);
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  #related-services .related-service-link:hover {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.22) 0%, rgba(73, 184, 137, 0.1) 100%), rgba(20, 28, 32, 0.7);
    border-color: rgba(73, 184, 137, 0.6);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(73, 184, 137, 0.3);
  }
  .service-cta-section { background: var(--bg-alt) !important; }
  .renovation-funnel { list-style: none; padding: 0; margin: 56px 0 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 48px; }
  .funnel-stage { position: relative; text-align: center; padding: 28px 20px; background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6); border: 1px solid rgba(73, 184, 137, 0.28); border-radius: 12px; transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease; }
  .funnel-stage:hover { transform: translateY(-4px); border-color: rgba(73, 184, 137, 0.55); box-shadow: 0 16px 40px -16px rgba(73, 184, 137, 0.3); }
  .funnel-stage h3 { font-size: 1.05rem; font-weight: 600; color: var(--accent); margin: 0 0 8px 0; letter-spacing: -0.01em; }
  .funnel-stage p { font-size: 0.82rem; color: var(--text); line-height: 1.5; margin: 0; }
  .funnel-stage:not(:last-child)::after { content: '→'; position: absolute; right: -34px; top: 50%; transform: translateY(-50%); color: var(--accent); font-size: 1.6rem; font-weight: 500; z-index: 2; line-height: 1; opacity: 0.7; }
  @media (max-width: 900px) { .renovation-funnel { grid-template-columns: repeat(2, 1fr); gap: 32px; } .funnel-stage:nth-child(2n)::after, .funnel-stage:last-child::after { display: none; } .funnel-stage:nth-child(2n-1)::after { right: -22px; } }
  @media (max-width: 600px) { .renovation-funnel { grid-template-columns: 1fr; gap: 20px; } .funnel-stage::after { display: none; } }
</style>

<ServiceLayout
  title="GEO Agency for Therapy Practices Singapore"
  description="GEO agency for therapy and counselling practices in Singapore — get named when people ask ChatGPT, Gemini and Google AI Mode for a therapist."
  canonical="https://jraftcreative.com/mental-health-ai-search-optimisation-singapore/"
  ogTitle="GEO Agency for Therapy Practices Singapore"
  ogDescription="AI search optimisation for Singapore therapy and counselling practices. Get named when people ask ChatGPT, Gemini and Perplexity for a therapist."
  ogImage="https://jraftcreative.com/images/og-mentalhealth.jpg"
  keywords="geo agency for therapy practices, mental health ai search optimisation singapore, therapist chatgpt optimisation, ai search optimisation for counsellors, generative engine optimisation mental health, Jraft Creative"
  schemaData={schemaData}
  heroLabel="GEO Agency for Therapy Practices"
  heroTitle='GEO Agency for <span class="highlight">Therapy Practices in Singapore</span>'
  heroSubtitle="People looking for support have started asking AI which therapist to see. The answer names two or three practices — and if yours isn't one of them, you were never in the conversation. We help counselling and psychology practices become the answer AI assistants give."
  heroImage="/images/service-mentalhealth.webp"
  heroImageAlt="Mental health professional in a Singapore clinic"
  heroButtons={[
    { text: "Get an AI Visibility Audit", href: "/contact/", class: "btn btn-primary" },
    { text: "See Mental Health Websites", href: "/mental-health-clinic-website-singapore/", class: "btn btn-secondary" }
  ]}
  whatsappText="Hi Jraft Creative, I'd like to know if my therapy practice shows up in AI search."
  ctaLabel="Be the Answer"
  ctaTitle="Find Out What AI Says About Your Practice"
  ctaDescription="Book a free consultation and we'll run the prompts a real client would use — by concern and neighbourhood — across ChatGPT, Gemini and Perplexity, and show you exactly where your practice currently stands. We'll get back to you within 24 hours."
  ctaButtons={[
    { text: "Get an AI Visibility Audit", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%27d%20like%20to%20know%20if%20my%20therapy%20practice%20shows%20up%20in%20AI%20search.", class: "btn btn-secondary" }
  ]}
  hideDefaultCta={false}
>

  <!-- ========== THE CHALLENGE ========== -->
  <section class="section" id="challenge" aria-label="AI Search Optimisation challenges for therapy practices in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Challenge</p>
        <h2>People Are Asking <span class="highlight">AI</span> for a Therapist — and It Names <span class="highlight">Two or Three</span></h2>
      </div>
      <div class="section-content reveal">
        <p>A generated answer has no page two. Either your practice is on the shortlist an assistant gives, or it does not exist to the person asking — often at the moment they have finally decided to reach out.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Ranking Well Isn't Enough</h3>
            <p>A practice can sit on page one of Google and never be mentioned by ChatGPT. AI systems weigh structured data and entity clarity, not just position.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Vague Copy Gives AI Nothing</h3>
            <p>'Compassionate care for every stage of life' can't be matched to 'couples counselling near Katong'. Clear specialisations are what get you named.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>The Lane Is Still Open</h3>
            <p>Almost no Singapore therapy practice has done this work. The bar is far lower than it has been in Google search for a decade — for now.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHAT WE DELIVER ========== -->
  <section class="section" id="sub-services" style="background: var(--bg-alt);" aria-label="AI Search Optimisation services for therapy practices">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">What We Deliver</p>
        <h2>Six <span class="highlight">GEO Workstreams</span> for Therapy <span class="highlight">Practices</span></h2>
      </div>
      <div class="section-content reveal">
        <p>We make your specialisations, therapist credentials and locations unambiguous to a machine — then prove it moved. This work sits alongside your <a href="/mental-health-clinic-website-singapore/">mental health website</a> and <a href="/mental-health-google-ads-singapore/">Google Ads</a>, so people find you whichever way they search.</p>
      </div>
      <div class="service-details-grid deliver-grid">
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-seo-audit.webp');">
          <div class="service-detail-card__content">
            <h3>AI Visibility Audit</h3>
            <p>We run the prompts clients actually use across ChatGPT, Gemini and Perplexity, and record whether you appear and how you're described.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-onpage-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Practice Schema &amp; Entities</h3>
            <p>LocalBusiness, FAQ and person structured data for your practice, each service and every therapist — so specialisations, credentials and locations are machine-readable facts, not prose.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-content-strategy.webp');">
          <div class="service-detail-card__content">
            <h3>Answer-Engine Content</h3>
            <p>Clear question-and-answer pages on the concerns people ask about — anxiety, couples work, child and family support — written in the plain, extractable form models quote back.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-ai.webp');">
          <div class="service-detail-card__content">
            <h3>Credential &amp; Listing Authority</h3>
            <p>Therapist qualifications, SMC or SRP registration and professional listings corroborated across your site, profile and reputable directories — the checks an assistant makes before it names you.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-local-seo.webp');">
          <div class="service-detail-card__content">
            <h3>llms.txt &amp; Machine Access</h3>
            <p>An llms.txt file and clean crawl paths that tell AI systems, in plain terms, who you are, what you offer and where — so each location is read as its own entity, not blended with a practice down the road.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-campaign-analytics.webp');">
          <div class="service-detail-card__content">
            <h3>Query-Bank Monitoring</h3>
            <p>A tracked bank of concern and neighbourhood prompts, re-run monthly, reporting your AI Visibility Score and mention-versus-citation rate — so visibility is measured, not asserted.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHY US ========== -->
  <section class="section" id="why-us" aria-label="Why choose Jraft Creative for mental health ai search optimisation">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2>A <span class="highlight">GEO Agency</span> That Has Been <span class="highlight">Cited Itself</span></h2>
      </div>
      <div class="section-content reveal">
        <p>We practise this on our own site and publish the method rather than keeping it a black box. If you're new to the topic, our primer on <a href="/blog/what-is-geo-ai-search-optimisation/">what GEO and AI search optimisation is</a> explains how it works, and it sits within our wider <a href="/industries/healthcare/">healthcare marketing in Singapore</a> practice — so the sensitivity a mental health brand needs is built in, not bolted on.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>We've Earned AI Citations</h3>
            <p>We wrote up <a href="/blog/how-we-got-cited-in-google-ai-overview-singapore/">how we got cited in Google's AI Overview</a> for niche Singapore queries — method, not marketing.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>We Already Run Mental Health Search</h3>
            <p>We handle <a href="/mental-health-marketing-singapore/">mental health marketing</a> and <a href="/mental-health-google-ads-singapore/">Google Ads</a>, so we know the questions people ask before they reach out.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Measured, Not Claimed</h3>
            <p>Baseline first, monthly query-bank re-runs after. If your visibility hasn't moved, the report says so — see our <a href="/geo-agency-singapore/">GEO programme</a>.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== CLIENT JOURNEY FUNNEL ========== -->
  <section class="section" id="buyer-funnel" style="background: var(--bg-alt);" aria-label="Where ai search optimisation fits the client journey">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Client Journey</p>
        <h2>Where <span class="highlight">AI Search</span> Fits the <span class="highlight">Client Journey</span></h2>
      </div>
      <div class="section-content reveal" style="margin-bottom: 24px;">
        <p>AI has moved to the very front of the journey. Where someone once opened Google and browsed a list, many now ask an assistant for a shortlist — which means the first decision is made before your website is ever visited.</p>
      </div>
      <ol class="renovation-funnel reveal">
        <li class="funnel-stage"><h3>Ask</h3><p>Someone asks an AI which therapist to see</p></li>
        <li class="funnel-stage"><h3>Shortlist</h3><p>Two or three practices get named — or you don't</p></li>
        <li class="funnel-stage"><h3>Validate</h3><p>They check credentials, approach and location</p></li>
        <li class="funnel-stage"><h3>Reach Out</h3><p>The shortlist turns into a first enquiry</p></li>
        <li class="funnel-stage"><h3>First Session</h3><p>A comfortable first visit, then continued support</p></li>
      </ol>
    </div>
  </section>

  <!-- ========== FAQ ========== -->
  <section class="section faq-section" id="faq" style="background: var(--bg-alt);" aria-label="Frequently asked questions about mental health ai search optimisation">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">FAQ</p>
        <h2>Mental Health GEO — Questions Answered</h2>
      </div>
      <div class="faq-list">
        <details class="faq-item reveal reveal-d1">
          <summary>What is GEO for a therapy or counselling practice?</summary>
          <div class="faq-answer"><p>Generative Engine Optimisation is the work of getting your practice named when someone asks an AI assistant rather than searching Google. Ask ChatGPT for a couples counsellor near Novena and you get a shortlist of a few practices, not ten links. GEO is about being on that list, which depends on different signals from traditional SEO.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>How is this different from the SEO you already do?</summary>
          <div class="faq-answer"><p>SEO earns a ranking position; GEO earns a mention inside a generated answer. Ranking factors still matter, but AI systems lean far more on structured data, entity clarity and how consistently your practice is described across the web. A practice can rank well and still never be named by an assistant — that is the gap we close.</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>What makes an AI name one therapy practice over another?</summary>
          <div class="faq-answer"><p>Specificity and corroboration. AI systems favour practices whose specialisations, therapist credentials and locations are stated clearly and confirmed in more than one place — your site, your Google Business Profile, professional directories and third-party listings. Vague copy gives a model nothing to match a person's question against.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>Can you show whether it is working?</summary>
          <div class="faq-answer"><p>Yes. We monitor prompts a real client would use — by concern and neighbourhood, from anxiety therapy in Orchard to a child psychologist near Tampines — across ChatGPT, Gemini, Perplexity and Google AI Mode, and track whether your practice appears and how it is described. That gives an AI Visibility baseline, a mention-versus-citation rate, and a monthly movement report.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>Is it too early to invest in AI search for a mental health practice?</summary>
          <div class="faq-answer"><p>It is early, and that is the argument for doing it. Very few Singapore therapy and counselling practices have done any of this work, so the competitive bar is low in a way it has not been in Google search for years. The practices that establish clean, accurate entity data now — across Novena, Bishan, Tanjong Pagar and beyond — are the ones AI systems will keep drawing on as adoption grows.</p></div>
        </details>
      </div>
    </div>
  </section>

  <!-- Related Services -->
  <section class="section" id="related-services" aria-label="Related services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Explore More</p>
        <h2>More <span class="highlight">Mental Health</span> Services</h2>
      </div>
      <div class="related-services-grid reveal">
          <a href="/mental-health-marketing-singapore/" class="related-service-link">Mental Health Marketing</a>
          <a href="/mental-health-google-ads-singapore/" class="related-service-link">Mental Health Google Ads</a>
          <a href="/mental-health-social-media-singapore/" class="related-service-link">Mental Health Social Media</a>
          <a href="/mental-health-clinic-website-singapore/" class="related-service-link">Mental Health Websites</a>
      </div>
    </div>
  </section>
</ServiceLayout>
