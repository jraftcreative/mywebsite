---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import IndustryCard from '../components/IndustryCard.astro';
import BlogCard from '../components/BlogCard.astro';
import { getCollection } from 'astro:content';

const latestPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Jraft Creative",
    "legalName": "Jraft Creative Pte. Ltd.",
    "description": "Full-service marketing agency in Singapore specialising in website development, SEO, paid performance marketing, and social media content creation.",
    "url": "https://jraftcreative.com/",
    "logo": "https://jraftcreative.com/images/logo.png",
    "email": "contact@jraftcreative.com",
    "telephone": "+6582234578",
    "foundingDate": "2025",
    "foundingLocation": {
      "@type": "Place",
      "name": "Singapore"
    },
    "numberOfEmployees": {
      "@type": "QuantitativeValue",
      "minValue": 1,
      "maxValue": 10
    },
    "areaServed": {
      "@type": "Country",
      "name": "Singapore"
    },
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Marketing Services",
      "itemListElement": [
        {
          "@type": "OfferCatalog",
          "name": "Website Development",
          "description": "Custom business websites, ecommerce stores, web applications, and landing pages.",
          "itemListElement": [
            { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Business Website", "description": "Custom-designed, mobile-responsive website up to 5 pages with contact form and basic SEO setup" } },
            { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Ecommerce Store", "description": "Full online store with product catalogue, secure checkout, and inventory management" } },
            { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Web Application", "description": "Booking systems, client portals, dashboards, and custom operational tools" } }
          ]
        },
        {
          "@type": "OfferCatalog",
          "name": "SEO & Performance Optimisation",
          "description": "Technical SEO audits, on-page optimisation, local SEO, link building, and analytics.",
          "itemListElement": [
            { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Technical SEO Audit", "description": "Comprehensive site crawl, indexing fixes, schema markup, and site architecture improvements" } },
            { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Local SEO", "description": "Google Business Profile optimisation, local citations, review management, and map pack rankings" } }
          ]
        },
        {
          "@type": "OfferCatalog",
          "name": "Paid Performance Marketing",
          "description": "Google Ads, Meta Ads, TikTok Ads, YouTube Ads, retargeting, and conversion tracking.",
          "itemListElement": [
            { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Google Ads Management", "description": "Search and display campaign setup, bid management, and Quality Score optimisation" } },
            { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Meta Ads Management", "description": "Facebook and Instagram audience targeting, creative production, and A/B testing" } }
          ]
        },
        {
          "@type": "OfferCatalog",
          "name": "Social Media Content Creation",
          "description": "Content strategy, branded graphics, Reels, TikTok videos, captions, and community management.",
          "itemListElement": [
            { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Social Media Management", "description": "Monthly content calendars, graphic design, video production, and community management" } }
          ]
        }
      ]
    },
    "serviceType": [
      "Website Development",
      "SEO & Performance Optimisation",
      "Paid Performance Marketing",
      "Social Media Content Creation"
    ],
    "knowsAbout": [
      "Web Design",
      "Ecommerce",
      "Google Ads",
      "Meta Ads",
      "Search Engine Optimisation",
      "Social Media Marketing",
      "Digital Marketing Strategy",
      "Content Marketing",
      "Local SEO Singapore",
      "TikTok Marketing",
      "Landing Page Optimisation"
    ],
    "image": "https://jraftcreative.com/images/og-image.jpg",
    "currenciesAccepted": "SGD",
    "paymentAccepted": "Bank Transfer, PayNow",
    "founder": {
      "@type": "Person",
      "name": "Jeremy Cheong",
      "url": "https://jraftcreative.com/about/jeremy/"
    },
    "sameAs": [
      "https://www.instagram.com/jraftcreative",
      "https://www.linkedin.com/company/jraftcreative",
      "https://www.tiktok.com/@jraftcreative"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Jraft Creative",
    "alternateName": ["JRaft Creative", "Jraft"],
    "url": "https://jraftcreative.com/",
    "potentialAction": {
      "@type": "SearchAction",
      "target": "https://jraftcreative.com/blog/?q={search_term_string}",
      "query-input": "required name=search_term_string"
    },
    "speakable": {
      "@type": "SpeakableSpecification",
      "cssSelector": [".section-header h2", ".section-content p", ".hero-subtitle"]
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "name": "Jraft Creative",
    "description": "Jraft Creative is a full-service digital marketing agency in Singapore offering website development, SEO, paid ads management, and social media content creation for small and medium businesses.",
    "url": "https://jraftcreative.com/",
    "telephone": "+6582234578",
    "areaServed": {
      "@type": "Country",
      "name": "Singapore"
    },
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Digital Marketing Services",
      "itemListElement": [
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Website Development", "description": "Custom websites, ecommerce stores, and web applications" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "SEO Services", "description": "Search engine optimisation, technical audits, and local SEO" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Paid Ads Management", "description": "Google Ads and Meta Ads campaign management" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Social Media Marketing", "description": "Content creation and community management" } }
      ]
    }
  }
];

const webDevSubItems = [
  { title: "Business Websites", description: "Custom-designed, mobile-responsive sites that showcase your brand and convert visitors." },
  { title: "Ecommerce Stores", description: "Online stores with product catalogs, secure checkout, and inventory management." },
  { title: "Web Applications", description: "Booking systems, client portals, dashboards, and custom operational tools." },
  { title: "Landing Pages", description: "High-converting campaign pages for promotions and lead generation." },
  { title: "AI Integration", description: "Chatbots, automated workflows, and AI-powered features for smarter business." }
];

const seoSubItems = [
  { title: "Technical SEO Audit", description: "Comprehensive site crawl, indexing fixes, schema markup, and site architecture improvements." },
  { title: "On-Page Optimisation", description: "Keyword research, meta tags, content optimisation, and internal linking strategy." },
  { title: "Speed & Core Web Vitals", description: "Page speed optimisation, image compression, caching, and performance monitoring." },
  { title: "Analytics & Reporting", description: "Google Analytics 4 setup, Search Console, conversion tracking, and monthly performance reports." },
  { title: "Local SEO", description: "Google Business Profile optimisation, local citations, review management, and map pack rankings." }
];

const adsSubItems = [
  { title: "Google Ads (Search & Display)", description: "Keyword targeting, ad copywriting, bid management, and Quality Score optimisation." },
  { title: "Meta Ads (Facebook & Instagram)", description: "Audience targeting, creative production, A/B testing, and conversion campaigns." },
  { title: "TikTok & YouTube Ads", description: "Video ad campaigns, interest-based targeting, and brand awareness at scale." },
  { title: "Retargeting & Remarketing", description: "Pixel setup, custom audiences, lookalike targeting, and cross-platform retargeting funnels." },
  { title: "Campaign Analytics & Optimisation", description: "Conversion tracking, ROAS reporting, budget allocation, and continuous campaign refinement." }
];

const geoSubItems = [
  { title: "AI Visibility Audit", description: "Test 20-30 target prompts across ChatGPT, Gemini, Perplexity, and Copilot. Benchmark against competitors and identify gaps." },
  { title: "Schema & Entity Optimisation", description: "Advanced JSON-LD markup, Organization/Service/FAQ schemas, and llms.txt implementation so AI knows exactly who you are." },
  { title: "Citation-Ready Content", description: "Answer-first formatting, comparison tables, and FAQ sections that AI engines can extract and cite directly." },
  { title: "Authority & Reputation Building", description: "Build your presence on review platforms, directories, and authority sites that AI trusts and references." },
  { title: "AI Visibility Monitoring", description: "Monthly tracking of Brand Visibility Score, Citation Rate, and Share of Voice across all major AI platforms." }
];

const socialSubItems = [
  { title: "Content Strategy & Planning", description: "Monthly content calendars, pillar themes, and platform-specific strategies aligned to your goals." },
  { title: "Graphic Design & Visuals", description: "Branded carousels, infographics, quote cards, and on-brand static posts for all platforms." },
  { title: "Reels & Short-form Video", description: "Trending-format vertical videos for Instagram Reels, TikTok, and YouTube Shorts." },
  { title: "Copywriting & Captions", description: "Engaging captions, hashtag strategy, and platform-optimised copy that drives interaction." },
  { title: "Community Management", description: "Comment moderation, DM responses, engagement tracking, and audience growth tactics." }
];
---

<BaseLayout
  title="Marketing Agency Singapore — Jraft Creative"
  description="Singapore marketing agency building websites, SEO, paid ads, and social content for SMEs who want clear strategy and work that actually ships."
  canonical="https://jraftcreative.com/"
  ogTitle="Marketing Agency Singapore — Jraft Creative"
  ogDescription="Singapore marketing agency building websites, SEO, paid ads, and social content for SMEs who want clear strategy and work that actually ships."
  keywords="Jraft Creative, marketing agency Singapore, web design Singapore, SEO agency, paid ads management, social media marketing, website development, ecommerce"
  preloadImage="/images/hero.webp"
  schemaData={schemaData}
  hreflang={[
    { lang: "en-sg", href: "https://jraftcreative.com/" },
    { lang: "x-default", href: "https://jraftcreative.com/" }
  ]}
>

  <!-- ========== HERO (kinetic type — PREVIEW) ========== -->
  <section class="hero home-hero-kinetic" aria-label="Page introduction">
    <video class="hero-bg-video" autoplay muted loop playsinline preload="none" poster="/images/hero.webp" aria-hidden="true">
      <source src="/videos/hero-home.mp4" type="video/mp4">
    </video>
    <div class="home-hero-overlay" aria-hidden="true"></div>
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="container">
      <span class="hero-label hero-anim hero-anim-1">Full-service marketing agency · Singapore</span>
      <h1 class="hero-anim hero-anim-2">
        The marketing agency in Singapore<br>that gets your brand<br><span class="kinetic" aria-hidden="true"><span class="kinetic-track"><span>seen.</span><span>found.</span><span>booked.</span><span>recommended.</span></span></span>
        <span class="visually-hidden">that gets your brand seen, found, booked, and recommended.</span>
      </h1>
      <p class="hero-anim hero-anim-3">Websites, SEO, GEO, Meta &amp; Google Ads, and social media content creation — one team that does the work, and shows you what it brought back.</p>
      <div class="hero-buttons hero-anim hero-anim-4">
        <a href="/contact/" class="btn btn-primary">Start Your Project</a>
        <a href="/services/website-development/#portfolio" class="btn btn-secondary">View Our Work</a>
      </div>
    </div>
  </section>

  <!-- ========== TRUSTED BY (PREVIEW — confirm naming permission per client) ========== -->
  <section class="trust-by" aria-label="Trusted by">
    <div class="container">
      <p class="tb-label">Trusted by businesses across Singapore</p>
      <div class="tb-names">
        <span>Music with Pat</span>
        <span>Maple Bear Jurong Gateway</span>
        <span>AX Beauty</span>
        <span>Janice Chan</span>
        <span>Eshine Curtain &amp; Blinds</span>
        <span class="tb-more">…and many more</span>
      </div>
    </div>
  </section>

  <!-- ========== PROOF: we practise what we sell (PREVIEW) ========== -->
  <section class="section proof" aria-label="Proof of results">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2>We do for ourselves exactly what we'd do for you</h2>
        <p>Most agencies talk. Here's the proof — the same playbook, run on our own business and our clients'.</p>
      </div>
      <div class="proof-grid reveal">
        <div class="proof-card">
          <div class="pc-stat">#1 in Singapore</div>
          <div class="pc-text">Our own pages rank #1 on Google for competitive niches — like "marketing agency for gyms" and "for interior designers." We earned those rankings the same way we'd earn yours.</div>
        </div>
        <div class="proof-card">
          <div class="pc-stat">Cited by Google AI</div>
          <div class="pc-text">Jraft Creative is named in Google's AI Overview for competitive local searches — the new front page of search. We build that AI visibility for clients too.</div>
        </div>
        <div class="proof-card">
          <div class="pc-stat">3 → 15 a month</div>
          <div class="pc-text">For Music with Pat, a private music teacher, we lifted trial sign-ups from about 3 a month to around 15 with a rebuilt Google Ads setup.</div>
        </div>
      </div>
    </div>
  </section>

  <style>
    /* Kinetic-type hero (preview) — no stock image, pure brand */
    .home-hero-kinetic {
      position: relative;
      background: #0b0b0f;
      overflow: hidden;
    }
    .home-hero-kinetic .hero-bg-video {
      position: absolute; inset: 0; width: 100%; height: 100%;
      object-fit: cover; z-index: 0;
    }
    .home-hero-overlay {
      position: absolute; inset: 0; z-index: 1;
      background:
        linear-gradient(180deg, rgba(8,8,13,0.74) 0%, rgba(8,8,13,0.64) 42%, rgba(8,8,13,0.86) 100%),
        radial-gradient(ellipse at 50% 42%, rgba(8,8,13,0.35) 0%, rgba(8,8,13,0.62) 70%);
    }
    .home-hero-kinetic .hero-glow { z-index: 1; }
    .home-hero-kinetic .container { position: relative; z-index: 2; }
    @media (prefers-reduced-motion: reduce) {
      .home-hero-kinetic .hero-bg-video { display: none; }
    }
    .home-hero-kinetic h1 { line-height: 1.08; }
    .kinetic {
      display: block;
      text-align: center;
      height: 1.1em;
      overflow: hidden;
      color: var(--accent);
    }
    .kinetic-track {
      display: flex;
      flex-direction: column;
      align-items: center;
      animation: kinetic-cycle 9s cubic-bezier(0.7, 0, 0.3, 1) infinite;
    }
    .kinetic-track > span { height: 1.1em; line-height: 1.1em; white-space: nowrap; }
    @keyframes kinetic-cycle {
      0%, 18%  { transform: translateY(0); }
      25%, 43% { transform: translateY(-1.1em); }
      50%, 68% { transform: translateY(-2.2em); }
      75%, 93% { transform: translateY(-3.3em); }
      100%     { transform: translateY(0); }
    }
    @media (prefers-reduced-motion: reduce) {
      .kinetic-track { animation: none; }
    }
    .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

    /* Trusted-by strip */
    .trust-by { padding: 30px 0; border-top: 1px solid rgba(255,255,255,0.06); border-bottom: 1px solid rgba(255,255,255,0.06); background: #0d0d12; }
    .trust-by .container { text-align: center; }
    .tb-label { font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: #9aa0a6; margin-bottom: 16px; }
    .tb-names { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 12px 28px; }
    .tb-names span { font-weight: 600; font-size: 1.05rem; color: #d7dade; opacity: 0.9; }
    .tb-names .tb-more { color: var(--accent); opacity: 1; }

    /* Proof block */
    .proof {
      position: relative;
      overflow: hidden;
      background:
        radial-gradient(120% 82% at 50% 6%, rgba(73,184,137,0.16) 0%, rgba(73,184,137,0.04) 30%, transparent 58%),
        linear-gradient(180deg, #10141a 0%, #0a0b0e 100%);
    }
    .proof::before {
      content: '';
      position: absolute; inset: 0; z-index: 0; pointer-events: none;
      background-image:
        linear-gradient(rgba(255,255,255,0.045) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,0.045) 1px, transparent 1px);
      background-size: 46px 46px;
      -webkit-mask-image: radial-gradient(ellipse 78% 68% at 50% 42%, #000 0%, transparent 78%);
      mask-image: radial-gradient(ellipse 78% 68% at 50% 42%, #000 0%, transparent 78%);
    }
    .proof > .container { position: relative; z-index: 1; }
    .proof-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 26px; margin-top: 40px; }
    .proof-card {
      padding: 32px;
      border: 1px solid rgba(73,184,137,0.30);
      border-radius: 16px;
      background: linear-gradient(160deg, rgba(22,30,34,0.78) 0%, rgba(13,17,20,0.78) 100%);
      box-shadow: 0 26px 60px -32px rgba(0,0,0,0.95), inset 0 1px 0 rgba(255,255,255,0.05);
      transition: transform 0.32s ease, border-color 0.32s ease, box-shadow 0.32s ease;
    }
    .proof-card:hover {
      transform: translateY(-5px);
      border-color: rgba(73,184,137,0.6);
      box-shadow: 0 34px 74px -30px rgba(73,184,137,0.38);
    }
    .proof-card .pc-stat { font-weight: 800; font-size: clamp(1.5rem, 3vw, 2.1rem); color: var(--accent); line-height: 1.1; }
    .proof-card .pc-text { margin-top: 12px; color: #c7cbd1; font-size: 0.98rem; line-height: 1.55; }
    @media (max-width: 820px) { .proof-grid { grid-template-columns: 1fr; } }
  </style>

  <!-- ========== SERVICES ========== -->
  <section class="section" id="services" aria-label="Our services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Services</p>
        <h2>What We Do</h2>
      </div>
      <div class="section-content reveal">
        <p><a href="/services/website-development/">Websites</a>, <a href="/services/seo-performance/">SEO</a>, <a href="/google-ads-agency-singapore/">Google Ads</a>, <a href="/services/social-media/">social</a>, and <a href="/geo-agency-singapore/">AI search (GEO)</a> — one team, under one roof. Strategy through execution, measured on what it brings back.</p>
      </div>
      <div class="services-grid services-grid-5">
        <ServiceCard
          title="Website Development"
          description="Custom websites, stores, and web apps — designed to convert and built to scale."
          backgroundImage="/images/service-webdev.webp"
          id="serviceWebDev"
          revealClass="reveal-d1"
          expandable={true}
          subItems={webDevSubItems}
        />
        <ServiceCard
          title="SEO & Performance"
          description="Search engine optimisation, speed optimisation, and analytics setup to maximise your online visibility and rankings."
          backgroundImage="/images/service-seo.webp"
          id="serviceSeo"
          revealClass="reveal-d2"
          expandable={true}
          subItems={seoSubItems}
        />
        <ServiceCard
          title="Paid Performance Marketing"
          description="Google Ads, Meta Ads, and data-driven paid campaigns that deliver measurable ROI and qualified leads."
          backgroundImage="/images/service-ads.webp"
          id="serviceAds"
          revealClass="reveal-d3"
          expandable={true}
          subItems={adsSubItems}
        />
        <ServiceCard
          title="Social Media Content Creation"
          description="Scroll-stopping visuals, reels, and copy for Instagram, TikTok, Facebook, and LinkedIn that build your brand."
          backgroundImage="/images/service-social.webp"
          id="serviceSocial"
          revealClass="reveal-d4"
          expandable={true}
          subItems={socialSubItems}
        />
        <ServiceCard
          title="AI Search Optimisation (GEO)"
          description="Get your brand recommended by ChatGPT, Gemini, and Perplexity. AI visibility audits, content optimisation, and citation monitoring."
          backgroundImage="/images/service-seo.webp"
          id="serviceGeo"
          revealClass="reveal-d1"
          expandable={true}
          subItems={geoSubItems}
        />
      </div>

    </div>
  </section>


  <!-- ========== TRUST BAR ========== -->
  <section class="trust-bar" aria-label="Trust statistics">
    <div class="container">
      <div class="trust-inner reveal">
        <p class="trust-label">Trusted by businesses across Singapore</p>
        <div class="trust-stats">
          <div class="trust-stat">
            <span class="number">15+</span>
            <span class="label">Projects Delivered</span>
          </div>
          <div class="trust-stat">
            <span class="number">6</span>
            <span class="label">Industries Served</span>
          </div>
          <div class="trust-stat">
            <span class="number">100%</span>
            <span class="label">Client Satisfaction</span>
          </div>
          <div class="trust-stat">
            <span class="number">2 wks</span>
            <span class="label">Avg. Turnaround</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== INDUSTRIES ========== -->
  <section class="section" id="industries" aria-label="Industries we serve">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Industries</p>
        <h2>Who We Work With</h2>
        <p>Deep expertise in industries where we deliver the most impact.</p>
      </div>
      <div class="industries-grid">
        <IndustryCard title="Music & Creative" description="Music schools, studios, performers, and creative agencies." backgroundImage="/images/industry-music.webp" revealClass="reveal-d1" href="/music-school-website-singapore/" />
        <IndustryCard title="F&B & Hospitality" description="Restaurants, cafes, catering, and food delivery brands." backgroundImage="/images/industry-fnb.webp" revealClass="reveal-d2" href="/fnb-marketing-singapore/" />
        <IndustryCard title="Retail & Ecommerce" description="Fashion, lifestyle, specialty goods, and DTC brands." backgroundImage="/images/industry-retail.webp" revealClass="reveal-d3" href="/ecommerce-website-singapore/" />
        <IndustryCard title="Education" description="Tuition centres, enrichment schools, online courses, and edtech." backgroundImage="/images/industry-education.webp" revealClass="reveal-d4" href="/education-marketing-agency-singapore/" />
        <IndustryCard title="Property" description="Real estate agencies, property developers, and listings platforms." backgroundImage="/images/industry-property.webp" revealClass="reveal-d5" href="/property-agent-website-singapore/" />
        <IndustryCard title="Insurance" description="Insurance agents, brokerages, and financial advisory firms." backgroundImage="/images/industry-insurance.webp" revealClass="reveal-d5" href="/insurance-agent-website-singapore/" />
        <IndustryCard title="Interior Design" description="Interior design studios, renovation firms, and design-led trades." backgroundImage="/images/service-interior.webp" revealClass="reveal-d5" href="/interior-designer-marketing-singapore/" />
      </div>
      <div class="section-content reveal" style="margin-top: 2rem; text-align: center;">
        <p>See our industry-specific solutions: <a href="/fnb-website-design-singapore/">F&amp;B website design</a>, <a href="/ecommerce-website-singapore/">ecommerce websites</a>, <a href="/beauty-salon-website-singapore/">beauty &amp; salon websites</a>, <a href="/clinic-website-design-singapore/">clinic websites</a>, <a href="/education-marketing-agency-singapore/">education marketing</a>, <a href="/small-business-website-singapore/">small business websites</a>, and <a href="/startup-website-singapore/">startup websites</a>.</p>
      </div>
    </div>
  </section>

  <!-- ========== PROCESS ========== -->
  <section class="section" id="process" aria-label="Our process">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">How We Work</p>
        <h2>Simple, Transparent Process</h2>
        <p>From first call to launch in as fast as 2 weeks.</p>
      </div>
      <div class="process-grid">
        <div class="process-step reveal reveal-d1">
          <h3>Discovery</h3>
          <p>We learn about your business, goals, and audience to define the project scope.</p>
        </div>
        <div class="process-step reveal reveal-d2">
          <h3>Design</h3>
          <p>We create mockups and prototypes for your review. Iterate until it's perfect.</p>
        </div>
        <div class="process-step reveal reveal-d3">
          <h3>Build</h3>
          <p>We develop and test your site with clean code, fast performance, and mobile responsiveness.</p>
        </div>
        <div class="process-step reveal reveal-d4">
