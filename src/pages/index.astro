---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import IndustryCard from '../components/IndustryCard.astro';
import BlogCard from '../components/BlogCard.astro';
import { getCollection } from 'astro:content';

const latestPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

// Trusted-by conveyor — client logos in the order Jeremy specified (naming cleared).
// s = per-logo scale so visual weight is even (square icons bigger, wide wordmarks smaller).
const clientLogos = [
  { src: '/images/clients/maplebear-jg.webp', alt: 'Maple Bear Jurong Gateway', s: 1.35 },
  { src: '/images/clients/pike-six.webp', alt: 'PIKE SIX', s: 1.15 },
  { src: '/images/clients/ax-beauty.webp', alt: 'AX Beauty', s: 1.25 },
  { src: '/images/clients/kairos.webp', alt: 'Kairos Advisory', s: 0.9 },
  { src: '/images/clients/mbjc-sengkang.webp', alt: 'Maple Bear Junior Club, Sengkang Campus', s: 1.35 },
  { src: '/images/clients/music-with-pat.webp', alt: 'Music with Pat', s: 1.35 },
  { src: '/images/clients/translatr.webp', alt: 'Translatr', s: 1.15 },
];

// Homepage FAQ — plain answers, consult-first (no fixed pricing), rendered + emitted as FAQPage schema
const faqs = [
  {
    q: "What does Jraft Creative do?",
    a: "We're a full-service marketing agency in Singapore. Under one roof we build websites, run SEO and AI search (GEO), manage Google and Meta ads, and create social media content — so you're not stitching together five different vendors.",
  },
  {
    q: "Do you work with small businesses and startups?",
    a: "Yes. Most of our clients are small and medium Singapore businesses. We scope the work to where you are, whether that's a first website or a full growth programme.",
  },
  {
    q: "How much does it cost to work with you?",
    a: "It depends on what you actually need, so we don't publish fixed packages. Tell us your goals on a short call and we'll put together a plan and a clear quote, with no obligation.",
  },
  {
    q: "How quickly can you get started?",
    a: "A straightforward website can go live in as fast as two weeks, and marketing campaigns can start sooner. We'll give you a realistic timeline once we understand the scope.",
  },
  {
    q: "Do you only work with businesses in Singapore?",
    a: "We're Singapore-based and most of our work is local, but we take on clients elsewhere when it's a good fit. If you're outside Singapore, just ask.",
  },
  {
    q: "What makes you different from other agencies?",
    a: "One team handles everything, and we report plainly on what the work brings back — leads, bookings, and sales, not vanity metrics. We also run these same channels for our own business, so you can see the results before you hire us.",
  },
];

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map((f) => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Jraft Creative",
    "legalName": "Jraft Creative Pte. Ltd.",
    "description": "Full-service marketing agency in Singapore specialising in website development, SEO, paid performance marketing, and social media content creation.",
    "url": "https://jraftcreative.com/",
    "logo": "https://jraftcreative.com/images/logo.png",
    "email": "contact@jraftcreative.com",
    "telephone": "+6582234578",
    "foundingDate": "2025",
    "foundingLocation": {
      "@type": "Place",
      "name": "Singapore"
    },
    "numberOfEmployees": {
      "@type": "QuantitativeValue",
      "minValue": 1,
      "maxValue": 10
    },
    "areaServed": {
      "@type": "Country",
      "name": "Singapore"
    },
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Marketing Services",
      "itemListElement": [
        {
          "@type": "OfferCatalog",
          "name": "Website Development",
          "description": "Custom business websites, ecommerce stores, web applications, and landing pages.",
          "itemListElement": [
            { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Business Website", "description": "Custom-designed, mobile-responsive website up to 5 pages with contact form and basic SEO setup" } },
            { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Ecommerce Store", "description": "Full online store with product catalogue, secure checkout, and inventory management" } },
            { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Web Application", "description": "Booking systems, client portals, dashboards, and custom operational tools" } }
          ]
        },
        {
          "@type": "OfferCatalog",
          "name": "SEO & Performance Optimisation",
          "description": "Technical SEO audits, on-page optimisation, local SEO, link building, and analytics.",
          "itemListElement": [
            { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Technical SEO Audit", "description": "Comprehensive site crawl, indexing fixes, schema markup, and site architecture improvements" } },
            { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Local SEO", "description": "Google Business Profile optimisation, local citations, review management, and map pack rankings" } }
          ]
        },
        {
          "@type": "OfferCatalog",
          "name": "Paid Performance Marketing",
          "description": "Google Ads, Meta Ads, TikTok Ads, YouTube Ads, retargeting, and conversion tracking.",
          "itemListElement": [
            { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Google Ads Management", "description": "Search and display campaign setup, bid management, and Quality Score optimisation" } },
            { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Meta Ads Management", "description": "Facebook and Instagram audience targeting, creative production, and A/B testing" } }
          ]
        },
        {
          "@type": "OfferCatalog",
          "name": "Social Media Content Creation",
          "description": "Content strategy, branded graphics, Reels, TikTok videos, captions, and community management.",
          "itemListElement": [
            { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Social Media Management", "description": "Monthly content calendars, graphic design, video production, and community management" } }
          ]
        }
      ]
    },
    "serviceType": [
      "Website Development",
      "SEO & Performance Optimisation",
      "Paid Performance Marketing",
      "Social Media Content Creation"
    ],
    "knowsAbout": [
      "Web Design",
      "Ecommerce",
      "Google Ads",
      "Meta Ads",
      "Search Engine Optimisation",
      "Social Media Marketing",
      "Digital Marketing Strategy",
      "Content Marketing",
      "Local SEO Singapore",
      "TikTok Marketing",
      "Landing Page Optimisation"
    ],
    "image": "https://jraftcreative.com/images/og-image.jpg",
    "currenciesAccepted": "SGD",
    "paymentAccepted": "Bank Transfer, PayNow",
    "founder": {
      "@type": "Person",
      "name": "Jeremy Cheong",
      "url": "https://jraftcreative.com/about/jeremy/"
    },
    "sameAs": [
      "https://www.instagram.com/jraftcreative",
      "https://www.linkedin.com/company/jraftcreative",
      "https://www.tiktok.com/@jraftcreative"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Jraft Creative",
    "alternateName": ["JRaft Creative", "Jraft"],
    "url": "https://jraftcreative.com/",
    "potentialAction": {
      "@type": "SearchAction",
      "target": "https://jraftcreative.com/blog/?q={search_term_string}",
      "query-input": "required name=search_term_string"
    },
    "speakable": {
      "@type": "SpeakableSpecification",
      "cssSelector": [".section-header h2", ".section-content p", ".hero-subtitle"]
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "name": "Jraft Creative",
    "description": "Jraft Creative is a full-service digital marketing agency in Singapore offering website development, SEO, paid ads management, and social media content creation for small and medium businesses.",
    "url": "https://jraftcreative.com/",
    "telephone": "+6582234578",
    "areaServed": {
      "@type": "Country",
      "name": "Singapore"
    },
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Digital Marketing Services",
      "itemListElement": [
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Website Development", "description": "Custom websites, ecommerce stores, and web applications" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "SEO Services", "description": "Search engine optimisation, technical audits, and local SEO" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Paid Ads Management", "description": "Google Ads and Meta Ads campaign management" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Social Media Marketing", "description": "Content creation and community management" } }
      ]
    }
  }
];

const webDevSubItems = [
  { title: "Business Websites", description: "Custom-designed, mobile-responsive sites that showcase your brand and convert visitors." },
  { title: "Ecommerce Stores", description: "Online stores with product catalogs, secure checkout, and inventory management." },
  { title: "Web Applications", description: "Booking systems, client portals, dashboards, and custom operational tools." },
  { title: "Landing Pages", description: "High-converting campaign pages for promotions and lead generation." },
  { title: "AI Integration", description: "Chatbots, automated workflows, and AI-powered features for smarter business." }
];

const seoSubItems = [
  { title: "Technical SEO Audit", description: "Comprehensive site crawl, indexing fixes, schema markup, and site architecture improvements." },
  { title: "On-Page Optimisation", description: "Keyword research, meta tags, content optimisation, and internal linking strategy." },
  { title: "Speed & Core Web Vitals", description: "Page speed optimisation, image compression, caching, and performance monitoring." },
  { title: "Analytics & Reporting", description: "Google Analytics 4 setup, Search Console, conversion tracking, and monthly performance reports." },
  { title: "Local SEO", description: "Google Business Profile optimisation, local citations, review management, and map pack rankings." }
];

const adsSubItems = [
  { title: "Google Ads (Search & Display)", description: "Keyword targeting, ad copywriting, bid management, and Quality Score optimisation." },
  { title: "Meta Ads (Facebook & Instagram)", description: "Audience targeting, creative production, A/B testing, and conversion campaigns." },
  { title: "TikTok & YouTube Ads", description: "Video ad campaigns, interest-based targeting, and brand awareness at scale." },
  { title: "Retargeting & Remarketing", description: "Pixel setup, custom audiences, lookalike targeting, and cross-platform retargeting funnels." },
  { title: "Campaign Analytics & Optimisation", description: "Conversion tracking, ROAS reporting, budget allocation, and continuous campaign refinement." }
];

const geoSubItems = [
  { title: "AI Visibility Audit", description: "Test 20-30 target prompts across ChatGPT, Gemini, Perplexity, and Copilot. Benchmark against competitors and identify gaps." },
  { title: "Schema & Entity Optimisation", description: "Advanced JSON-LD markup, Organization/Service/FAQ schemas, and llms.txt implementation so AI knows exactly who you are." },
  { title: "Citation-Ready Content", description: "Answer-first formatting, comparison tables, and FAQ sections that AI engines can extract and cite directly." },
  { title: "Authority & Reputation Building", description: "Build your presence on review platforms, directories, and authority sites that AI trusts and references." },
  { title: "AI Visibility Monitoring", description: "Monthly tracking of Brand Visibility Score, Citation Rate, and Share of Voice across all major AI platforms." }
];

const socialSubItems = [
  { title: "Content Strategy & Planning", description: "Monthly content calendars, pillar themes, and platform-specific strategies aligned to your goals." },
  { title: "Graphic Design & Visuals", description: "Branded carousels, infographics, quote cards, and on-brand static posts for all platforms." },
  { title: "Reels & Short-form Video", description: "Trending-format vertical videos for Instagram Reels, TikTok, and YouTube Shorts." },
  { title: "Copywriting & Captions", description: "Engaging captions, hashtag strategy, and platform-optimised copy that drives interaction." },
  { title: "Community Management", description: "Comment moderation, DM responses, engagement tracking, and audience growth tactics." }
];
---

<BaseLayout
  title="Marketing Agency Singapore — Jraft Creative"
  description="Singapore marketing agency building websites, SEO, paid ads, and social content for SMEs who want clear strategy and work that actually ships."
  canonical="https://jraftcreative.com/"
  ogTitle="Marketing Agency Singapore — Jraft Creative"
  ogDescription="Singapore marketing agency building websites, SEO, paid ads, and social content for SMEs who want clear strategy and work that actually ships."
  keywords="Jraft Creative, marketing agency Singapore, web design Singapore, SEO agency, paid ads management, social media marketing, website development, ecommerce"
  preloadImage="/images/hero.webp"
  schemaData={schemaData}
  hreflang={[
    { lang: "en-sg", href: "https://jraftcreative.com/" },
    { lang: "x-default", href: "https://jraftcreative.com/" }
  ]}
>

  <!-- ========== HERO (kinetic type — PREVIEW) ========== -->
  <section class="hero home-hero-kinetic" aria-label="Page introduction">
    <video class="hero-bg-video" autoplay muted loop playsinline preload="none" poster="/images/hero.webp" aria-hidden="true">
      <source src="/videos/hero-home.mp4" type="video/mp4">
    </video>
    <div class="home-hero-overlay" aria-hidden="true"></div>
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="container">
      <span class="hero-label hero-anim hero-anim-1">Full-service marketing agency · Singapore</span>
      <h1 class="hero-anim hero-anim-2">
        The marketing agency in Singapore<br>that gets your brand<br><span class="kinetic" aria-hidden="true"><span class="kinetic-track"><span>seen.</span><span>found.</span><span>booked.</span><span>recommended.</span></span></span>
        <span class="visually-hidden">that gets your brand seen, found, booked, and recommended.</span>
      </h1>
      <p class="hero-anim hero-anim-3">Websites, SEO, GEO, Meta &amp; Google Ads, and social media content creation — one team that does the work, and shows you what it brought back.</p>
      <div class="hero-buttons hero-anim hero-anim-4">
        <a href="/contact/" class="btn btn-primary">Start Your Project</a>
        <a href="/services/website-development/#portfolio" class="btn btn-secondary">View Our Work</a>
      </div>
    </div>
  </section>

  <!-- ========== TRUSTED BY — client-logo conveyor (naming cleared by Jeremy) ========== -->
  <section class="trust-by" aria-label="Trusted by businesses in Singapore">
    <div class="container">
      <p class="tb-label">Trusted by businesses in Singapore</p>
    </div>
    <div class="container">
      <div class="tb-static">
        {clientLogos.map((logo) => (
          <img class="tb-logo" src={logo.src} alt={logo.alt} style={`--s:${logo.s}`} width="150" height="46" loading="lazy" decoding="async" />
        ))}
        <span class="tb-more">…and many more</span>
      </div>
    </div>
  </section>

  <!-- ========== PROOF: we practise what we sell (PREVIEW) ========== -->
  <section class="section proof" aria-label="Proof of results">
    <div class="container proof-layout">
      <div class="proof-intro reveal">
        <p class="section-label">Proof</p>
        <h2>We market our own business the way we market yours</h2>
        <p class="proof-sub">The same strategies we run for clients, applied to Jraft Creative — and the results they've produced.</p>
      </div>
      <div class="proof-list reveal">
        <div class="proof-row">
          <div class="pr-stat">#1 in Singapore</div>
          <div class="pr-text">Ranked first on Google for competitive search terms across multiple industries — earned through organic search, not ad spend.</div>
        </div>
        <div class="proof-row">
          <div class="pr-stat">Cited by AI Search</div>
          <div class="pr-text">Cited in Google's AI Overview and named by ChatGPT for competitive local queries — the same AI visibility we build across ChatGPT, Perplexity, and Gemini for clients.</div>
        </div>
        <div class="proof-row">
          <div class="pr-stat">5× more sign-ups</div>
          <div class="pr-text">A rebuilt Google Ads campaign multiplied a Singapore music teacher's monthly trial bookings fivefold.</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Homepage: keep the dark base (.animated-bg paints var(--bg)) but drop the grid + off-brand orbs for a consistent dark surface -->
  <style is:global>
    .animated-bg__grid { display: none; }
  </style>

  <style>
    /* Kinetic-type hero (preview) — no stock image, pure brand */
    .home-hero-kinetic {
      position: relative;
      background: #0b0b0f;
      overflow: hidden;
    }
    .home-hero-kinetic .hero-bg-video {
      position: absolute; inset: 0; width: 100%; height: 100%;
      object-fit: cover; z-index: 0;
    }
    .home-hero-overlay {
      position: absolute; inset: 0; z-index: 1;
      background:
        linear-gradient(180deg, rgba(8,8,13,0.74) 0%, rgba(8,8,13,0.64) 42%, rgba(8,8,13,0.86) 100%),
        radial-gradient(ellipse at 50% 42%, rgba(8,8,13,0.35) 0%, rgba(8,8,13,0.62) 70%);
    }
    .home-hero-kinetic .hero-glow { z-index: 1; }
    .home-hero-kinetic .container { position: relative; z-index: 2; }
    @media (prefers-reduced-motion: reduce) {
      .home-hero-kinetic .hero-bg-video { display: none; }
    }
    .home-hero-kinetic h1 { line-height: 1.08; }
    .kinetic {
      display: block;
      text-align: center;
      height: 1.1em;
      overflow: hidden;
      color: var(--accent);
    }
    .kinetic-track {
      display: flex;
      flex-direction: column;
      align-items: center;
      animation: kinetic-cycle 9s cubic-bezier(0.7, 0, 0.3, 1) infinite;
    }
    .kinetic-track > span { height: 1.1em; line-height: 1.1em; white-space: nowrap; }
    @keyframes kinetic-cycle {
      0%, 18%  { transform: translateY(0); }
      25%, 43% { transform: translateY(-1.1em); }
      50%, 68% { transform: translateY(-2.2em); }
      75%, 93% { transform: translateY(-3.3em); }
      100%     { transform: translateY(0); }
    }
    @media (prefers-reduced-motion: reduce) {
      .kinetic-track { animation: none; }
    }
    .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

    /* Trusted-by conveyor */
    .trust-by { padding: 46px 0; border-top: 1px solid rgba(255,255,255,0.06); border-bottom: 1px solid rgba(255,255,255,0.06); background: #0d0d12; overflow: hidden; }
    .trust-by .container { text-align: center; }
    .tb-label { font-size: 0.76rem; letter-spacing: 0.14em; text-transform: uppercase; color: #9aa0a6; margin-bottom: 30px; }
    .tb-static { display: flex; flex-wrap: nowrap; align-items: center; justify-content: space-between; gap: 24px; --tb-h: 38px; }
    .tb-static .tb-logo { margin-right: 0; }
    @media (max-width: 980px) {
      .tb-static {
        --tb-h: 32px; gap: 32px;
        justify-content: flex-start;
        overflow-x: auto; scrollbar-width: none; -ms-overflow-style: none;
      }
      .tb-static::-webkit-scrollbar { display: none; }
    }
    @media (max-width: 640px) { .tb-static { --tb-h: 28px; gap: 26px; } .tb-more { font-size: 0.9rem; } }
    .tb-logo {
      height: calc(var(--tb-h) * var(--s, 1)); width: auto; max-width: 160px;
      object-fit: contain; flex: 0 0 auto; opacity: 0.82;
      transition: opacity 0.25s ease;
    }
    .tb-logo:hover { opacity: 1; }
    .tb-more { color: var(--accent); font-weight: 600; font-size: 0.98rem; white-space: nowrap; flex: 0 0 auto; }

    /* sections stay transparent so the site-wide animated backdrop (orbs over #08080d) shows through —
       identical to the about/service pages */
    #blog, #faq { position: relative; }
    #blog > .container, #faq > .container { position: relative; z-index: 1; }
    .hp-faq-list { max-width: 820px; margin: 48px auto 0; display: flex; flex-direction: column; gap: 12px; }
    .hp-faq-item {
      border: 1px solid rgba(255,255,255,0.10); border-radius: 12px;
      background: rgba(255,255,255,0.02); overflow: hidden;
      transition: border-color 0.2s ease;
    }
    .hp-faq-item > summary {
      cursor: pointer; list-style: none; padding: 20px 56px 20px 22px;
      font-weight: 600; font-size: 1.05rem; color: #f5f7f6; position: relative;
    }
    .hp-faq-item > summary::-webkit-details-marker { display: none; }
    .hp-faq-item > summary::after {
      content: '+'; position: absolute; right: 22px; top: 50%; transform: translateY(-50%);
      font-size: 1.5rem; line-height: 1; color: var(--accent); transition: transform 0.2s ease;
    }
    .hp-faq-item[open] > summary::after { content: '\2212'; }
    .hp-faq-item[open] { border-color: rgba(73,184,137,0.4); }
    .hp-faq-item > p {
      margin: 0; padding: 0 22px 20px; color: var(--text-muted); line-height: 1.7; font-size: 0.96rem;
    }

    /* Proof block */
    .proof {
      position: relative;
      overflow: hidden;
      min-height: 100svh;
      display: flex;
      align-items: center;
    }
    .proof-layout {
      position: relative; z-index: 1; width: 100%;
      display: grid;
      grid-template-columns: 0.92fr 1.08fr;
      gap: 72px;
      align-items: center;
    }
    .proof-intro { text-align: left; }
    .proof-intro h2 { font-size: clamp(2rem, 3.6vw, 3.1rem); line-height: 1.06; margin: 14px 0 20px; }
    .proof-intro .proof-sub { color: #aeb4bb; font-size: 1.06rem; line-height: 1.6; max-width: 36ch; }
    .proof-cta { margin-top: 28px; }
    .proof-list { display: flex; flex-direction: column; }
    .proof-row {
      padding: 30px 0;
      border-top: 1px solid rgba(255,255,255,0.09);
      transition: padding-left 0.3s ease, border-color 0.3s ease;
    }
    .proof-list .proof-row:last-child { border-bottom: 1px solid rgba(255,255,255,0.09); }
    .proof-row:hover { padding-left: 12px; border-color: rgba(73,184,137,0.45); }
    .pr-stat { font-weight: 800; font-size: clamp(1.7rem, 3vw, 2.5rem); color: var(--accent); line-height: 1.04; letter-spacing: -0.015em; }
    .pr-text { margin-top: 10px; color: #c1c6cc; font-size: 1.02rem; line-height: 1.58; max-width: 54ch; }
    @media (max-width: 900px) {
      .proof { min-height: auto; padding: 76px 0; }
      .proof-layout { grid-template-columns: 1fr; gap: 40px; }
      .proof-intro .proof-sub { max-width: none; }
    }


    /* services section background — consistent with hero/proof (preview) */
    #services {
      position: relative;
      min-height: 100svh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 48px 0 96px;
    }
    #services > .container { position: relative; z-index: 1; width: 100%; }

    /* process — connected journey (homepage-only, scoped hp-* classes) */
    #process.hp-proc {
      position: relative; overflow: hidden;
      display: flex; flex-direction: column; justify-content: center;
      min-height: 82vh; padding: 72px 0;
    }
    #process.hp-proc > .container { width: 100%; }
    #process.hp-proc > .container { position: relative; z-index: 1; }
    .hp-flow {
      list-style: none; margin: 56px 0 0; padding: 0;
      display: grid; grid-template-columns: repeat(4, 1fr); gap: 0 30px;
    }
    .hp-step { position: relative; }
    .hp-step-top { display: flex; align-items: center; gap: 16px; margin-bottom: 24px; height: 14px; }
    .hp-dot {
      flex: 0 0 auto; width: 13px; height: 13px; border-radius: 50%;
      background: var(--accent); box-shadow: 0 0 0 5px rgba(73,184,137,0.14);
      transition: box-shadow 0.25s ease, transform 0.25s ease;
    }
    .hp-line { flex: 1 1 auto; height: 1px; background: linear-gradient(90deg, rgba(73,184,137,0.5), rgba(73,184,137,0.04)); }
    .hp-step h3 { font-size: 1.18rem; font-weight: 700; margin: 0 0 10px; letter-spacing: -0.01em; }
    .hp-step p { font-size: 0.92rem; line-height: 1.65; color: var(--text-muted); margin: 0; max-width: 26ch; }
    .hp-step:hover .hp-dot { box-shadow: 0 0 0 7px rgba(73,184,137,0.22); transform: scale(1.15); }
