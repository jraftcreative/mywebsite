  <script>
    (function () {
      const stage = document.getElementById('svcTrack');
      if (!stage) return;
      const items = Array.from(stage.querySelectorAll('.svc-card-link'));
      const n = items.length;
      if (!n) return;
      let active = 0;

      function render() {
        items.forEach((el, i) => {
          let off = i - active;
          if (off > n / 2) off -= n;
          if (off < -n / 2) off += n;
          const abs = Math.abs(off);
          const visible = abs <= 2;
          const tx = off * 64;
          const tz = -abs * 190;
          const ry = -off * 40;
          const sc = Math.max(0.6, 1 - abs * 0.17);
          el.style.transform = 'translateX(' + tx + '%) translateZ(' + tz + 'px) rotateY(' + ry + 'deg) scale(' + sc + ')';
          el.style.opacity = visible ? (abs === 0 ? '1' : String(0.72 - abs * 0.2)) : '0';
          el.style.filter = abs === 0 ? 'none' : 'brightness(' + (1 - abs * 0.3) + ')';
          el.style.zIndex = String(100 - abs);
          el.style.pointerEvents = visible ? 'auto' : 'none';
        });
      }
      function go(d) { active = (active + d + n) % n; render(); }

      // arrows: one click = one card
      const prev = document.querySelector('.svc-prev');
      const next = document.querySelector('.svc-next');
      prev && prev.addEventListener('click', function () { go(-1); });
      next && next.addEventListener('click', function () { go(1); });

      // click a side card to bring it to centre; centre card follows its link
      items.forEach(function (el, i) {
        el.addEventListener('click', function (e) { if (i !== active) { e.preventDefault(); active = i; render(); } });
      });

      // gentle auto-rotate on its own, paused while hovering the carousel
      const carousel = stage.closest('.svc-carousel');
      let auto = setInterval(function () { go(1); }, 5000);
      if (carousel) {
        carousel.addEventListener('mouseenter', function () { clearInterval(auto); auto = null; });
        carousel.addEventListener('mouseleave', function () { if (!auto) auto = setInterval(function () { go(1); }, 5000); });
      }

      render();
    })();
  </script>



