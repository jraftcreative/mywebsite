---
import ServiceLayout from '../layouts/ServiceLayout.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Marketing Agency for Wedding Businesses Singapore",
    "description": "Full-service marketing agency for wedding businesses in Singapore — bridal, photographers, planners and venues. SEO, AI search, ads, social, branding and websites that book couples.",
    "provider": {
      "@type": "Organization",
      "name": "Jraft Creative",
      "url": "https://jraftcreative.com/",
      "logo": "https://jraftcreative.com/images/logo.png",
      "telephone": "+6582234578",
      "address": { "@type": "PostalAddress", "streetAddress": "60 Paya Lebar Road, Paya Lebar Square", "postalCode": "409051", "addressLocality": "Singapore", "addressCountry": "SG" }
    },
    "areaServed": { "@type": "Country", "name": "Singapore" },
    "serviceType": "Wedding Marketing"
  },
  { "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [
      { "@type": "Question", "name": "What does marketing for a wedding business involve?", "acceptedAnswer": { "@type": "Answer", "text": "Being found in service-and-style search, named by AI assistants, visible in paid results and remarketing during planning season, unmissable on social with real work, branded for your kind of couple, and a website that turns a browse into a completed enquiry." } },
      { "@type": "Question", "name": "We get bookings from Instagram — why do more?", "acceptedAnswer": { "@type": "Answer", "text": "Instagram builds desire but misses couples actively searching Google, can't be relied on for reach, and rarely closes an enquiry cleanly. Search and a proper enquiry flow capture the couples who are ready now." } },
      { "@type": "Question", "name": "Does this work for photographers, planners and bridal alike?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. The journey is the same — inspiration, shortlist, enquiry — but we angle the search terms, portfolio content and positioning to your specific service and the couples you want." } },
      { "@type": "Question", "name": "When should we ramp up marketing?", "acceptedAnswer": { "@type": "Answer", "text": "Around engagement and planning peaks — the months after year-end and mid-year proposals — when couples begin shortlisting. We hold a baseline year-round and scale into those windows." } },
      { "@type": "Question", "name": "How do you measure success?", "acceptedAnswer": { "@type": "Answer", "text": "Booked enquiries and cost per enquiry, then enquiry-to-booking. Saves, reach and followers are context, never the result." } }
    ] },
  { "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "Marketing Agency for Wedding Businesses Singapore", "item": "https://jraftcreative.com/wedding-marketing-singapore/" }
  ] }
];
---

<style is:global>
  /* Hide the global background grid pattern on this page only */
  .animated-bg__grid { display: none; }

  /* More-prominent related-service pills — match challenge-card-v2 green treatment */
  #related-services .related-service-link {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.35);
    color: var(--text);
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  #related-services .related-service-link:hover {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.22) 0%, rgba(73, 184, 137, 0.1) 100%), rgba(20, 28, 32, 0.7);
    border-color: rgba(73, 184, 137, 0.6);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(73, 184, 137, 0.3);
  }
  .service-cta-section { background: var(--bg-alt) !important; }
  .renovation-funnel { list-style: none; padding: 0; margin: 56px 0 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 48px; }
  .funnel-stage { position: relative; text-align: center; padding: 28px 20px; background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6); border: 1px solid rgba(73, 184, 137, 0.28); border-radius: 12px; transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease; }
  .funnel-stage:hover { transform: translateY(-4px); border-color: rgba(73, 184, 137, 0.55); box-shadow: 0 16px 40px -16px rgba(73, 184, 137, 0.3); }
  .funnel-stage h3 { font-size: 1.05rem; font-weight: 600; color: var(--accent); margin: 0 0 8px 0; letter-spacing: -0.01em; }
  .funnel-stage p { font-size: 0.82rem; color: var(--text); line-height: 1.5; margin: 0; }
  .funnel-stage:not(:last-child)::after { content: '→'; position: absolute; right: -34px; top: 50%; transform: translateY(-50%); color: var(--accent); font-size: 1.6rem; font-weight: 500; z-index: 2; line-height: 1; opacity: 0.7; }
  @media (max-width: 900px) { .renovation-funnel { grid-template-columns: repeat(2, 1fr); gap: 32px; } .funnel-stage:nth-child(2n)::after, .funnel-stage:last-child::after { display: none; } .funnel-stage:nth-child(2n-1)::after { right: -22px; } }
  @media (max-width: 600px) { .renovation-funnel { grid-template-columns: 1fr; gap: 20px; } .funnel-stage::after { display: none; } }
</style>

<ServiceLayout
  title="Marketing Agency for Wedding Businesses Singapore"
  description="Marketing agency for wedding businesses in Singapore — bridal, photographers, planners and venues. SEO, social and websites that book couples."
  canonical="https://jraftcreative.com/wedding-marketing-singapore/"
  ogTitle="Marketing Agency for Wedding Businesses Singapore"
  ogDescription="Full-service marketing for Singapore wedding businesses. Six channels that turn browsing couples into booked enquiries."
  ogImage="https://jraftcreative.com/images/og-webdev.jpg"
  keywords="marketing agency for wedding businesses, wedding marketing singapore, wedding vendor marketing, bridal marketing singapore, wedding photographer marketing, Jraft Creative"
  schemaData={schemaData}
  heroLabel="Marketing Agency for Wedding Businesses"
  heroTitle='Marketing Agency for <span class="highlight">Wedding Businesses in Singapore</span>'
  heroSubtitle="Couples plan intensively, compare obsessively and spend big. Whether you're a bridal boutique, photographer, planner or venue, we run the channels that book them — search, social, ads, brand and website — judged on booked enquiries, not likes."
  heroImage="/images/service-wedding.webp"
  heroImageAlt="Wedding in Singapore — wedding business marketing"
  heroButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "See Wedding Websites", href: "/wedding-website-design-singapore/", class: "btn btn-secondary" }
  ]}
  whatsappText="Hi Jraft Creative, I'd like to talk about marketing for my wedding business in Singapore."
  ctaLabel="Book More Couples"
  ctaTitle="Get a Free Wedding Marketing Review"
  ctaDescription="Book a free consultation and we'll look at how couples find you now, where enquiries drop off, and which channel books more of them. We'll get back to you within 24 hours."
  ctaButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%27d%20like%20to%20talk%20about%20marketing%20for%20my%20wedding%20business%20in%20Singapore.", class: "btn btn-secondary" }
  ]}
  hideDefaultCta={false}
>

  <!-- ========== THE CHALLENGE ========== -->
  <section class="section" id="challenge" aria-label="Marketing challenges for wedding businesses in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Challenge</p>
        <h2>Couples Compare <span class="highlight">Everything</span> Before They Enquire</h2>
      </div>
      <div class="section-content reveal">
        <p>A wedding is a once-in-a-lifetime, high-value purchase, so couples research relentlessly and shortlist hard. Whichever vendor is visible, credible and easy to enquire with wins the booking.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>A Crowded, Portfolio-Led Field</h3>
            <p>Every bridal boutique, photographer and planner looks lovely online. Without visibility and a distinct point of view, you blur into an endless scroll of pretty.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Couples Search by Style &amp; Service</h3>
            <p>'Wedding photographer Singapore', 'bridal boutique', 'wedding planner budget' — specific, high-intent searches. If those don't find you, a competitor is booked.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Enquiries Leak Between Platforms</h3>
            <p>Couples move from Instagram to Google to your site to a form. Every clumsy step between inspiration and enquiry loses a booking you'd already half-won.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== SIX CHANNELS ========== -->
  <section class="section" id="sub-services" style="background: var(--bg-alt);" aria-label="Marketing channels for wedding businesses">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">What We Deliver</p>
        <h2>Six <span class="highlight">Marketing Channels</span> Every Wedding Business <span class="highlight">Needs</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Each channel does a different job in the same journey — from a couple's first inspiration search to a booked consultation.</p>
      </div>
      <div class="service-details-grid deliver-grid">
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-local-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Search &amp; Local SEO</h3>
            <p>Rank for service-and-style searches — 'wedding photographer Singapore', 'ROM bridal', 'wedding planner' — and the long-tail couples actually type.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-ai.webp');">
          <div class="service-detail-card__content">
            <h3>AI Search &amp; GEO</h3>
            <p>Get named when a couple asks an AI to recommend a wedding photographer, planner or venue in their style and budget.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-google-ads.webp');">
          <div class="service-detail-card__content">
            <h3>Google Ads</h3>
            <p>Capture high-intent searches and remarket to couples who browsed but didn't enquire, timed to engagement and planning season.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-reels-video.webp');">
          <div class="service-detail-card__content">
            <h3>Social Content</h3>
            <p>Real weddings, styled shoots and behind-the-scenes — the portfolio content couples save, share and book from.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-graphic-design.webp');">
          <div class="service-detail-card__content">
            <h3>Brand &amp; Positioning</h3>
            <p>A brand and point of view that make you the obvious choice for your kind of couple, so you compete on fit, not just price.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-business-website.webp');">
          <div class="service-detail-card__content">
            <h3>Website That Converts</h3>
            <p>A <a href="/wedding-website-design-singapore/">wedding business website</a> with a portfolio, packages clarity and an enquiry flow that couples actually complete.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHY US ========== -->
  <section class="section" id="why-us" aria-label="Why choose Jraft Creative for wedding businesses marketing">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2>One <span class="highlight">Agency</span>, All Six <span class="highlight">Channels</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Most wedding vendors live on Instagram alone and miss the couples searching Google with intent. We run it as one system.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Channels That Feed Each Other</h3>
            <p>Social builds desire, search captures the ready-to-book couple, and the site closes the enquiry — each feeding the next.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Measured on Enquiries, Not Clicks</h3>
            <p>We report booked enquiries and cost per enquiry — the number that fills your calendar — not saves or reach.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>One Team, Every Channel</h3>
            <p>Portfolio, search, social and enquiry flow are built together, so a couple who saves a real wedding meets your packages and a form they actually finish.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== FUNNEL ========== -->
  <section class="section" id="buyer-funnel" style="background: var(--bg-alt);" aria-label="How customers choose a wedding business">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Booking Journey</p>
        <h2>How Couples <span class="highlight">Choose a Wedding Vendor</span></h2>
      </div>
      <div class="section-content reveal" style="margin-bottom: 24px;">
        <p>Couples move from inspiration to shortlist to enquiry. Social and search decide whether you're found, brand and portfolio decide whether you're shortlisted, and the site takes the enquiry.</p>
      </div>
      <ol class="renovation-funnel reveal">
        <li class="funnel-stage"><h3>Discover</h3><p>An inspiration search, a save or a referral</p></li>
        <li class="funnel-stage"><h3>Shortlist</h3><p>Portfolio and style decide who makes the cut</p></li>
        <li class="funnel-stage"><h3>Compare</h3><p>Packages, availability and fit weighed up</p></li>
        <li class="funnel-stage"><h3>Enquire</h3><p>A completed enquiry — the real conversion</p></li>
        <li class="funnel-stage"><h3>Book</h3><p>A signed couple, then referrals &amp; reviews</p></li>
      </ol>
    </div>
  </section>

  <!-- ========== FAQ ========== -->
  <section class="section faq-section" id="faq" style="background: var(--bg-alt);" aria-label="Frequently asked questions about wedding businesses marketing">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">FAQ</p>
        <h2>Wedding <span class="highlight">Marketing</span> — Questions Answered</h2>
      </div>
      <div class="faq-list">
        <details class="faq-item reveal reveal-d1">
          <summary>What does marketing for a wedding business involve?</summary>
          <div class="faq-answer"><p>Being found in service-and-style search, named by AI assistants, visible in paid results and remarketing during planning season, unmissable on social with real work, branded for your kind of couple, and a website that turns a browse into a completed enquiry.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>We get bookings from Instagram — why do more?</summary>
          <div class="faq-answer"><p>Instagram builds desire but misses couples actively searching Google, can't be relied on for reach, and rarely closes an enquiry cleanly. Search and a proper enquiry flow capture the couples who are ready now.</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>Does this work for photographers, planners and bridal alike?</summary>
          <div class="faq-answer"><p>Yes. The journey is the same — inspiration, shortlist, enquiry — but we angle the search terms, portfolio content and positioning to your specific service and the couples you want.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>When should we ramp up marketing?</summary>
          <div class="faq-answer"><p>Around engagement and planning peaks — the months after year-end and mid-year proposals — when couples begin shortlisting. We hold a baseline year-round and scale into those windows.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>How do you measure success?</summary>
          <div class="faq-answer"><p>Booked enquiries and cost per enquiry, then enquiry-to-booking. Saves, reach and followers are context, never the result.</p></div>
        </details>
      </div>
    </div>
  </section>

  <!-- Related Services -->
  <section class="section" id="related-services" aria-label="Related services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Explore More</p>
        <h2>More <span class="highlight">Wedding</span> Services</h2>
      </div>
      <div class="related-services-grid reveal">
          <a href="/wedding-website-design-singapore/" class="related-service-link">Wedding Website Design</a>
          <a href="/event-company-marketing-singapore/" class="related-service-link">Event Company Marketing</a>
          <a href="/branding-agency-singapore/" class="related-service-link">Branding Agency</a>
          <a href="/services/social-media/" class="related-service-link">Social Media Marketing</a>
          <a href="/services/seo-performance/" class="related-service-link">SEO &amp; Performance</a>
      </div>
    </div>
  </section>
</ServiceLayout>
