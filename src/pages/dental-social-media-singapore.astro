---
import ServiceLayout from '../layouts/ServiceLayout.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Social Media Agency for Dental Clinics Singapore",
    "description": "Social media agency for dental clinics in Singapore. Treatment education, dentist-led content and community management that builds trust and books appointments within SDC and MOH rules.",
    "provider": {
      "@type": "Organization",
      "name": "Jraft Creative",
      "url": "https://jraftcreative.com/",
      "logo": "https://jraftcreative.com/images/logo.png",
      "telephone": "+6582234578",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "60 Paya Lebar Road, Paya Lebar Square",
        "postalCode": "409051",
        "addressLocality": "Singapore",
        "addressCountry": "SG"
      }
    },
    "areaServed": { "@type": "Country", "name": "Singapore" },
    "serviceType": "Dental Social Media"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "Which platforms should a dental clinic in Singapore be on?", "acceptedAnswer": { "@type": "Answer", "text": "For most clinics, Facebook and Instagram reach the adult and parent audience, while TikTok reaches younger patients considering cosmetic and orthodontic treatment. We usually recommend depth on two platforms rather than a thin presence on five." } },
      { "@type": "Question", "name": "What should a dental clinic actually post?", "acceptedAnswer": { "@type": "Answer", "text": "Dentist-led explainers that ease anxiety are the strongest content a clinic has. Around that we build treatment education, aftercare tips, team and behind-the-scenes content, and compliant patient stories. Reassurance and education convert far better than promotion." } },
      { "@type": "Question", "name": "Are there advertising rules for dental content in Singapore?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. The Singapore Dental Council ethical code and MOH advertising guidelines restrict claims, testimonials and before/after imagery. Every post we produce is reviewed for compliance before it reaches you for approval." } },
      { "@type": "Question", "name": "Do we need consent to feature patients?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Any patient image, story or result requires written consent, and must still fall within SDC advertising rules. We build a simple consent step into your process so it's handled properly, not chased after the fact." } },
      { "@type": "Question", "name": "How does social media bring in appointments?", "acceptedAnswer": { "@type": "Answer", "text": "Rarely with a single post. Social validates you — a patient who has seen your dentists explain a procedure calmly arrives ready to book. We track that through profile-to-website clicks and enquiries that mention social, not follower count." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "Social Media Agency for Dental Clinics Singapore", "item": "https://jraftcreative.com/dental-social-media-singapore/" }
    ]
  }
];
---

<style is:global>
  /* Hide the global background grid pattern on this page only */
  .animated-bg__grid { display: none; }

  /* More-prominent related-service pills — match challenge-card-v2 green treatment */
  #related-services .related-service-link {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.35);
    color: var(--text);
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  #related-services .related-service-link:hover {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.22) 0%, rgba(73, 184, 137, 0.1) 100%), rgba(20, 28, 32, 0.7);
    border-color: rgba(73, 184, 137, 0.6);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(73, 184, 137, 0.3);
  }
  .service-cta-section { background: var(--bg-alt) !important; }
  .renovation-funnel { list-style: none; padding: 0; margin: 56px 0 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 48px; }
  .funnel-stage { position: relative; text-align: center; padding: 28px 20px; background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6); border: 1px solid rgba(73, 184, 137, 0.28); border-radius: 12px; transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease; }
  .funnel-stage:hover { transform: translateY(-4px); border-color: rgba(73, 184, 137, 0.55); box-shadow: 0 16px 40px -16px rgba(73, 184, 137, 0.3); }
  .funnel-stage h3 { font-size: 1.05rem; font-weight: 600; color: var(--accent); margin: 0 0 8px 0; letter-spacing: -0.01em; }
  .funnel-stage p { font-size: 0.82rem; color: var(--text); line-height: 1.5; margin: 0; }
  .funnel-stage:not(:last-child)::after { content: '→'; position: absolute; right: -34px; top: 50%; transform: translateY(-50%); color: var(--accent); font-size: 1.6rem; font-weight: 500; z-index: 2; line-height: 1; opacity: 0.7; }
  @media (max-width: 900px) { .renovation-funnel { grid-template-columns: repeat(2, 1fr); gap: 32px; } .funnel-stage:nth-child(2n)::after, .funnel-stage:last-child::after { display: none; } .funnel-stage:nth-child(2n-1)::after { right: -22px; } }
  @media (max-width: 600px) { .renovation-funnel { grid-template-columns: 1fr; gap: 20px; } .funnel-stage::after { display: none; } }
</style>

<ServiceLayout
  title="Social Media Agency for Dental Clinics Singapore"
  description="Social media agency for dental clinics in Singapore — dentist-led education and treatment content that turns followers into booked patients."
  canonical="https://jraftcreative.com/dental-social-media-singapore/"
  ogTitle="Social Media Agency for Dental Clinics Singapore"
  ogDescription="Social media for dental clinics in Singapore. Dentist-led education and treatment content built to book appointments, within SDC rules."
  ogImage="https://jraftcreative.com/images/og-webdev.jpg"
  keywords="social media agency for dental clinics, dental clinic social media singapore, dentist instagram singapore, dental tiktok, dental content marketing, Jraft Creative"
  schemaData={schemaData}
  heroLabel="Social Media Agency for Dental Clinics"
  heroTitle='Social Media Agency for <span class="highlight">Dental Clinics in Singapore</span>'
  heroSubtitle="Patients choose a dentist they trust, and trust is built long before the first visit. We turn your dentists' expertise into content that eases anxiety, answers real questions, and books appointments — all within SDC rules."
  heroImage="/images/service-dental.webp"
  heroImageAlt="Dental clinic in Singapore — social media"
  heroButtons={[
    { text: "Get a Free Content Review", href: "/contact/", class: "btn btn-primary" },
    { text: "See Dental SEO", href: "/dental-seo-singapore/", class: "btn btn-secondary" }
  ]}
  whatsappText="Hi Jraft Creative, I need social media for my dental clinic in Singapore."
  ctaLabel="Book More Appointments"
  ctaTitle="Get a Free Dental Content Review"
  ctaDescription="Book a free consultation and we'll look at what you post now, what your dentists could be sharing, and where the gap is between followers and booked appointments. We'll get back to you within 24 hours."
  ctaButtons={[
    { text: "Get a Free Content Review", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%20need%20social%20media%20for%20my%20dental%20clinic%20in%20Singapore.", class: "btn btn-secondary" }
  ]}
  hideDefaultCta={false}
>

  <!-- ========== THE CHALLENGE ========== -->
  <section class="section" id="challenge" aria-label="Social Media challenges for dental clinics in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Challenge</p>
        <h2>Patients Fear the Dentist — <span class="highlight">Content</span> Is How You <span class="highlight">Disarm It</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Dental anxiety is the sector's biggest barrier. The clinics that reassure patients online, before they ever call, are the ones that get booked.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Anxiety Stops the Booking</h3>
            <p>Many patients delay care out of fear. A warm, educational feed does the reassuring that a price list never can — and turns dread into a booking.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>An Empty Feed Reads as Distant</h3>
            <p>A quiet or clinical profile makes a nervous patient more hesitant. Consistent, human content signals a clinic that will look after them.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Compliant but Still Compelling</h3>
            <p>Dental content must stay within SDC and MOH rules on claims and testimonials. Most clinics either post nothing or risk non-compliance. Neither books patients.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHAT WE DELIVER ========== -->
  <section class="section" id="sub-services" style="background: var(--bg-alt);" aria-label="Social Media services for dental clinics">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">What We Deliver</p>
        <h2>Six <span class="highlight">Content Workstreams</span> for Dental <span class="highlight">Clinics</span></h2>
      </div>
      <div class="section-content reveal">
        <p>We build a cadence around what your clinic already does each week, turning routine expertise into trust.</p>
      </div>
      <div class="service-details-grid deliver-grid">
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-reels-video.webp');">
          <div class="service-detail-card__content">
            <h3>Dentist-Led Explainers</h3>
            <p>Short video of your dentists answering common worries — 'does a root canal hurt', 'how long do implants last' — building trust in the person, not just the clinic.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-content-strategy.webp');">
          <div class="service-detail-card__content">
            <h3>Treatment Education Content</h3>
            <p>Clear, compliant carousels and Stories on procedures, aftercare and what to expect — the content that turns a nervous browser into a confident patient.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-graphic-design.webp');">
          <div class="service-detail-card__content">
            <h3>Behind-the-Scenes &amp; Team</h3>
            <p>Warm clinic tours and team introductions that make a first visit feel familiar and safe before a patient walks in.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-community-mgmt.webp');">
          <div class="service-detail-card__content">
            <h3>Community Management</h3>
            <p>Prompt, professional handling of DMs, comments and enquiries — nurturing a lead from first message to booked appointment.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-meta-ads.webp');">
          <div class="service-detail-card__content">
            <h3>Compliant Patient Stories</h3>
            <p>Results and experiences shared with proper consent and within SDC rules — real reassurance without crossing advertising lines.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-campaign-analytics.webp');">
          <div class="service-detail-card__content">
            <h3>Reporting on Enquiries</h3>
            <p>We track profile-to-enquiry and bookings that mention social — follower count is context, not the result.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHY US ========== -->
  <section class="section" id="why-us" aria-label="Why choose Jraft Creative for dental social media">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2>A <span class="highlight">Social Media Agency</span> That Respects <span class="highlight">Clinical Standards</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Dental social fails on either anxiety or compliance. We handle both, with your clinical team in control of every post.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>SDC Compliance Expertise</h3>
            <p>Every piece is checked against Singapore Dental Council and MOH rules before it reaches you — engaging content that stays within the boundaries.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Dentist-Centric Content</h3>
            <p>We put your dentists at the centre. A trusted, familiar face eases anxiety and converts far better than generic brand posts.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>You Approve Before Publishing</h3>
            <p>You and your clinical team sign off every post, caption and visual. Nothing goes live without your approval.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== PATIENT JOURNEY FUNNEL ========== -->
  <section class="section" id="buyer-funnel" style="background: var(--bg-alt);" aria-label="Where social media fits the patient journey">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Patient Journey</p>
        <h2>Where <span class="highlight">Social</span> Fits the <span class="highlight">Patient Journey</span></h2>
      </div>
      <div class="section-content reveal" style="margin-bottom: 24px;">
        <p>A dental patient moves through five stages before booking. Social rarely wins the first search — its job is Validate and Compare, where dentist-led content eases the anxiety that stops a patient booking.</p>
      </div>
      <ol class="renovation-funnel reveal">
        <li class="funnel-stage"><h3>Discover</h3><p>A reel or a share puts you on the radar</p></li>
        <li class="funnel-stage"><h3>Validate</h3><p>Dentist-led content eases the fear</p></li>
        <li class="funnel-stage"><h3>Compare</h3><p>Reviews and warmth weigh the clinics</p></li>
        <li class="funnel-stage"><h3>Book</h3><p>DMs and profile link turn interest into a booking</p></li>
        <li class="funnel-stage"><h3>Treat</h3><p>A calm first visit, then recalls &amp;amp; referrals</p></li>
      </ol>
    </div>
  </section>

  <!-- ========== FAQ ========== -->
  <section class="section faq-section" id="faq" style="background: var(--bg-alt);" aria-label="Frequently asked questions about dental social media">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">FAQ</p>
        <h2>Dental Social Media — Questions Answered</h2>
      </div>
      <div class="faq-list">
        <details class="faq-item reveal reveal-d1">
          <summary>Which platforms should a dental clinic in Singapore be on?</summary>
          <div class="faq-answer"><p>For most clinics, Facebook and Instagram reach the adult and parent audience, while TikTok reaches younger patients considering cosmetic and orthodontic treatment. We usually recommend depth on two platforms rather than a thin presence on five.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>What should a dental clinic actually post?</summary>
          <div class="faq-answer"><p>Dentist-led explainers that ease anxiety are the strongest content a clinic has. Around that we build treatment education, aftercare tips, team and behind-the-scenes content, and compliant patient stories. Reassurance and education convert far better than promotion.</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>Are there advertising rules for dental content in Singapore?</summary>
          <div class="faq-answer"><p>Yes. The Singapore Dental Council ethical code and MOH advertising guidelines restrict claims, testimonials and before/after imagery. Every post we produce is reviewed for compliance before it reaches you for approval.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>Do we need consent to feature patients?</summary>
          <div class="faq-answer"><p>Yes. Any patient image, story or result requires written consent, and must still fall within SDC advertising rules. We build a simple consent step into your process so it's handled properly, not chased after the fact.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>How does social media bring in appointments?</summary>
          <div class="faq-answer"><p>Rarely with a single post. Social validates you — a patient who has seen your dentists explain a procedure calmly arrives ready to book. We track that through profile-to-website clicks and enquiries that mention social, not follower count.</p></div>
        </details>
      </div>
    </div>
  </section>

  <!-- Related Services -->
  <section class="section" id="related-services" aria-label="Related services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Explore More</p>
        <h2>More <span class="highlight">Dental Clinic</span> Services</h2>
      </div>
      <div class="related-services-grid reveal">
          <a href="/dental-seo-singapore/" class="related-service-link">Dental SEO</a>
          <a href="/dental-website-design-singapore/" class="related-service-link">Dental Website Design</a>
          <a href="/dental-google-ads-singapore/" class="related-service-link">Dental Google Ads</a>
          <a href="/dental-marketing-singapore/" class="related-service-link">Full-Service Dental Marketing</a>
          <a href="/dental-branding-singapore/" class="related-service-link">Dental Branding</a>
          <a href="/dental-ai-search-optimisation-singapore/" class="related-service-link">Dental GEO / AI Search</a>
      </div>
    </div>
  </section>
</ServiceLayout>
