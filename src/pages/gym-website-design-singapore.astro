---
import ServiceLayout from '../layouts/ServiceLayout.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Gym Website Design Singapore",
    "description": "Conversion-focused website design for gyms and fitness studios in Singapore — free-trial booking, online membership sign-up, class timetables, trainer bios, facilities galleries, and mobile-first speed for commercial gyms, 24-hour gyms, boutique studios, personal training, and group classes.",
    "provider": {
      "@type": "Organization",
      "name": "Jraft Creative",
      "url": "https://jraftcreative.com/",
      "logo": "https://jraftcreative.com/images/logo.png",
      "telephone": "+6582234578",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "60 Paya Lebar Road, Paya Lebar Square",
        "postalCode": "409051",
        "addressLocality": "Singapore",
        "addressCountry": "SG"
      }
    },
    "areaServed": { "@type": "Country", "name": "Singapore" },
    "serviceType": "Gym Website Design"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How much does a gym website cost in Singapore?", "acceptedAnswer": { "@type": "Answer", "text": "Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote." } },
      { "@type": "Question", "name": "Can visitors book a free trial and sign up for membership on the website?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. That's the whole point of the build. We wire in free-trial booking with date and time selection, plus online membership sign-up so a member can choose a plan, enter payment details, and start without visiting your front desk. We work with the booking and payment tools available in Singapore, or integrate the system you already use." } },
      { "@type": "Question", "name": "Can you display our class timetable and keep it easy to update?", "acceptedAnswer": { "@type": "Answer", "text": "Absolutely. We build a live class schedule that visitors can filter by class type, trainer, or location — HIIT, spin, CrossFit, strength, and group sessions — and set it up so your team can update times without touching code. Members check what's on today or next week without messaging your front desk." } },
      { "@type": "Question", "name": "Do you build for commercial gyms, 24-hour gyms, and boutique studios?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We build for commercial gyms, 24-hour access gyms, boutique studios, personal training businesses, and group-class brands. Each site is designed around how your business actually runs — access model, membership tiers, class formats, and the way you convert a first-time visitor into a booked trial." } },
      { "@type": "Question", "name": "How long does it take to build a gym website?", "acceptedAnswer": { "@type": "Answer", "text": "Most gym websites go live within about 2 weeks. Sites with trial booking, membership sign-up, trainer bios, and a facilities gallery take a little longer, and multi-location builds with member portals longer still. We give you a clear timeline before we start." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "Gym Website Design Singapore", "item": "https://jraftcreative.com/gym-website-design-singapore/" }
    ]
  }
];
---

<style is:global>
  /* Hide the global background grid pattern on this page only */
  .animated-bg__grid { display: none; }

  /* More-prominent related-service pills — match challenge-card-v2 green treatment */
  #related-services .related-service-link {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.35);
    color: var(--text);
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  #related-services .related-service-link:hover {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.22) 0%, rgba(73, 184, 137, 0.1) 100%), rgba(20, 28, 32, 0.7);
    border-color: rgba(73, 184, 137, 0.6);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(73, 184, 137, 0.3);
  }

  /* Separate the CTA section from related-services with bg-alt */
  .service-cta-section {
    background: var(--bg-alt) !important;
  }

  /* Force even service card grid on desktop per locked landing-page pattern */
  #sub-services .deliver-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }
  @media (max-width: 900px) {
    #sub-services .deliver-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 600px) {
    #sub-services .deliver-grid { grid-template-columns: 1fr; }
  }

  /* Gym Website Flow — horizontal process flow with green accents */
  .renovation-funnel {
    list-style: none;
    padding: 0;
    margin: 56px 0 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 48px;
    counter-reset: funnel;
  }
  .funnel-stage {
    position: relative;
    text-align: center;
    padding: 28px 20px;
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.28);
    border-radius: 12px;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .funnel-stage:hover {
    transform: translateY(-4px);
    border-color: rgba(73, 184, 137, 0.55);
    box-shadow: 0 16px 40px -16px rgba(73, 184, 137, 0.3);
  }
  .funnel-stage h3 {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--accent);
    margin: 0 0 8px 0;
    letter-spacing: -0.01em;
  }
  .funnel-stage p {
    font-size: 0.82rem;
    color: var(--text);
    line-height: 1.5;
    margin: 0;
  }
  .funnel-stage:not(:last-child)::after {
    content: '→';
    position: absolute;
    right: -34px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--accent);
    font-size: 1.6rem;
    font-weight: 500;
    z-index: 2;
    line-height: 1;
    opacity: 0.7;
  }
  @media (max-width: 900px) {
    .renovation-funnel {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }
    .funnel-stage:nth-child(2n)::after,
    .funnel-stage:last-child::after {
      display: none;
    }
    .funnel-stage:nth-child(2n-1)::after {
      right: -22px;
    }
  }
  @media (max-width: 600px) {
    .renovation-funnel {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .funnel-stage::after {
      display: none;
    }
  }
</style>

<ServiceLayout
  title="Gym Website Design Singapore — Jraft Creative"
  description="Conversion-focused website design for gyms in Singapore — free-trial booking, membership sign-up, class timetables, trainer bios, mobile-first speed."
  canonical="https://jraftcreative.com/gym-website-design-singapore/"
  ogTitle="Gym Website Design Singapore — Jraft Creative"
  ogDescription="Website design for gyms and fitness studios in Singapore. Free-trial booking, online membership sign-up, class timetables, trainer bios, facilities gallery."
  ogImage="https://jraftcreative.com/images/og-gym.jpg"
  keywords="gym website design singapore, fitness studio website singapore, 24 hour gym website singapore, boutique gym website singapore, personal training website singapore, crossfit website singapore, gym web design, Jraft Creative"
  schemaData={schemaData}
  heroLabel="Gym Website Design"
  heroTitle='Website Design for <span class="highlight">Gyms in Singapore</span>'
  heroSubtitle="People find a gym on their phone, then decide in seconds whether to book. We build conversion-focused gym websites — free-trial booking, online membership sign-up, class timetables, and trainer bios that load fast — so a visitor from Tanjong Pagar to Tampines turns into a booked trial, not a bounce."
  heroImage="/images/service-gym.webp"
  heroButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "See How We Work", href: "/process/", class: "btn btn-secondary" }
  ]}
  whatsappText="Hi Jraft Creative, I need a website for my gym in Singapore."
  ctaLabel="Ready to Fill More Trials?"
  ctaTitle="Get Your Gym Online"
  ctaDescription="Tell us about your gym and we'll recommend the right website approach. Free consultation — no obligations, no pressure."
  ctaButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%20need%20a%20website%20for%20my%20gym%20in%20Singapore.", class: "btn btn-secondary" }
  ]}
>

  <!-- ========== THE CHALLENGE ========== -->
  <section class="section" id="challenge" aria-label="Why gyms need a proper website">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Challenge</p>
        <h2>People Search "Gym Near Me" <span class="highlight">on Their Phone</span> — Does Yours <span class="highlight">Win the Booking</span>?</h2>
      </div>
      <div class="section-content reveal">
        <p>Singapore's fitness market is crowded, from Orchard to Jurong. Most people compare a few gyms on their phone and book the first free trial that's easy to grab. A slow or confusing site loses them to the gym next door.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>The Trial Is Buried</h3>
            <p>Prospects want one thing first: how to try the gym. If booking a free trial means a DM and a wait, most give up and open the next tab instead of signing up.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Social Isn't Enough</h3>
            <p>Instagram builds awareness but vanishes in a day. Someone deciding between a 24-hour gym and a boutique studio needs the timetable, trainers, and facilities in one place, working around the clock.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Slow on Mobile Loses</h3>
            <p>Most gym searches happen on the go, on data. A heavy site that stalls for a few seconds bleeds bookings before the timetable even loads — and Google buries slow pages in local results.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHAT WE BUILD ========== -->
  <section class="section" id="sub-services" style="background: var(--bg-alt);" aria-label="Gym website design services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">What We Build</p>
        <h2>What We Build for <span class="highlight">Gyms</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Every gym site we build is made to turn a visitor into a booked trial or member — free-trial booking front and centre, membership sign-up online, a live timetable, and trainer bios. Pair it with <a href="/gym-seo-singapore/">gym SEO</a> so you rank for "gym near me", <a href="/gym-google-ads-singapore/">gym Google Ads</a> to drive trial bookings, and <a href="/gym-social-media-singapore/">gym social media</a> to keep classes full.</p>
      </div>
      <div class="service-details-grid deliver-grid">
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-business-website.webp');">
          <div class="service-detail-card__content">
            <h3>Free-Trial &amp; Class Booking</h3>
            <p>The whole site points to one action — booking a trial or reserving a class. Date and time selection, automated confirmations, and reminders that cut no-shows and keep HIIT, spin, and strength sessions full.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-landing-page.webp');">
          <div class="service-detail-card__content">
            <h3>Online Membership Sign-Up</h3>
            <p>Members choose a plan, enter their details, and start online — no front-desk visit. Built for commercial gyms, 24-hour access, and boutique studios, with the payment tools available in Singapore.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-local-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Class Timetable &amp; Trainer Bios</h3>
            <p>A live schedule visitors filter by class type, trainer, or location, plus profile pages showing each trainer's specialisations and experience — CrossFit, spin, personal training — so people know who they'll train with.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-graphic-design.webp');">
          <div class="service-detail-card__content">
            <h3>Facilities Gallery &amp; Mobile Speed</h3>
            <p>A gallery of your floor, equipment, and studios so prospects see the space before they visit — built mobile-first and tuned to load fast on data, with tap-to-call and tap-to-book always within reach.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHY CHOOSE US ========== -->
  <section class="section" id="why-us" aria-label="Why choose Jraft Creative for gym website design">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2>Why Choose Us for Your <span class="highlight">Gym Website</span></h2>
      </div>
      <div class="section-content reveal">
        <p>We understand how gyms in Singapore actually run — trial-to-member conversion, membership tiers, class scheduling, and the difference between a commercial gym, a 24-hour access model, and a boutique studio. A website is one part of our wider <a href="/industries/fitness/">fitness marketing services</a>.</p>
      </div>
      <div class="service-details-grid" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Built to Convert</h3>
            <p>Every page is designed around one job: turning a visitor into a booked trial or a signed-up member. Clear calls to action, fast forms, and a booking path that never makes prospects hunt.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Fast Turnaround</h3>
            <p>Most gym sites go live in about 2 weeks — quick enough to catch a new location opening in Bugis or Novena, a rebrand, or a New Year sign-up push without missing the demand.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>One Agency, All Channels</h3>
            <p>Beyond the site, we run SEO, social, and Google Ads — so your whole online presence pulls in one direction while you concentrate on your members and your floor.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WEBSITE FLOW ========== -->
  <section class="section" id="website-flow" style="background: var(--bg-alt);" aria-label="How we build your gym website">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">How It Works</p>
        <h2>From First Call to <span class="highlight">Booked Trials</span></h2>
      </div>
      <div class="section-content reveal" style="margin-bottom: 24px;">
        <p>We run the same four-step build on every gym — clear, quick, and made to start taking trial bookings the moment you go live. For the thinking behind it, our guide on <a href="/blog/good-business-website-singapore/">what makes a good business website in Singapore</a> covers the essentials.</p>
      </div>
      <ol class="renovation-funnel reveal">
        <li class="funnel-stage">
          <h3>Discover</h3>
          <p>We map your classes, trainers, and booking needs</p>
        </li>
        <li class="funnel-stage">
          <h3>Design</h3>
          <p>Bespoke gym design, built mobile-first</p>
        </li>
        <li class="funnel-stage">
          <h3>Build</h3>
          <p>Booking, sign-up, and timetable wired and tested</p>
        </li>
        <li class="funnel-stage">
          <h3>Launch</h3>
          <p>Live in about 2 weeks, tuned for bookings</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ========== FAQ ========== -->
  <section class="section faq-section" id="faq" aria-label="Frequently asked questions about gym website design in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">FAQ</p>
        <h2><span class="highlight">Gym Website</span> — Questions <span class="highlight">Answered</span></h2>
      </div>
      <div class="faq-list">
        <details class="faq-item reveal reveal-d1">
          <summary>How much does a gym website cost in Singapore?</summary>
          <div class="faq-answer"><p>Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>Can visitors book a free trial and sign up for membership on the website?</summary>
          <div class="faq-answer"><p>Yes. That's the whole point of the build. We wire in free-trial booking with date and time selection, plus online membership sign-up so a member can choose a plan, enter payment details, and start without visiting your front desk. We work with the booking and payment tools available in Singapore, or integrate the system you already use.</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>Can you display our class timetable and keep it easy to update?</summary>
          <div class="faq-answer"><p>Absolutely. We build a live class schedule that visitors can filter by class type, trainer, or location — HIIT, spin, CrossFit, strength, and group sessions — and set it up so your team can update times without touching code. Members check what's on today or next week without messaging your front desk.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>Do you build for commercial gyms, 24-hour gyms, and boutique studios?</summary>
          <div class="faq-answer"><p>Yes. We build for commercial gyms, 24-hour access gyms, boutique studios, personal training businesses, and group-class brands. Each site is designed around how your business actually runs — access model, membership tiers, class formats, and the way you convert a first-time visitor into a booked trial.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>How long does it take to build a gym website?</summary>
          <div class="faq-answer"><p>Most gym websites go live within about 2 weeks. Sites with trial booking, membership sign-up, trainer bios, and a facilities gallery take a little longer, and multi-location builds with member portals longer still. We give you a clear timeline before we start.</p></div>
        </details>
      </div>
    </div>
  </section>


  <!-- Related Services -->
  <section class="section" id="related-services" aria-label="Related services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Explore More</p>
        <h2>More Gym Services</h2>
      </div>
      <div class="related-services-grid reveal">
          <a href="/gym-marketing-singapore/" class="related-service-link">Gym Marketing</a>
          <a href="/gym-seo-singapore/" class="related-service-link">Gym SEO</a>
          <a href="/gym-ai-search-optimisation-singapore/" class="related-service-link">Gym GEO</a>
          <a href="/gym-google-ads-singapore/" class="related-service-link">Gym Google Ads</a>
          <a href="/gym-social-media-singapore/" class="related-service-link">Gym Social Media</a>
          <a href="/gym-branding-singapore/" class="related-service-link">Gym Branding</a>
      </div>
    </div>
  </section>
</ServiceLayout>
