---
import ServiceLayout from '../layouts/ServiceLayout.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Gym Google Ads Singapore",
    "description": "Google Search ads (and Meta where it fits) for gyms and fitness centres in Singapore — capturing 'gym near me', '24 hour gym', and 'personal trainer' searches, free-trial and membership lead ads, retargeting, and conversion tracking that fills the floor.",
    "provider": {
      "@type": "Organization",
      "name": "Jraft Creative",
      "url": "https://jraftcreative.com/",
      "logo": "https://jraftcreative.com/images/logo.png",
      "telephone": "+6582234578",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "60 Paya Lebar Road, Paya Lebar Square",
        "postalCode": "409051",
        "addressLocality": "Singapore",
        "addressCountry": "SG"
      }
    },
    "areaServed": { "@type": "Country", "name": "Singapore" },
    "serviceType": "Gym Paid Advertising"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How much should my gym spend on ads?", "acceptedAnswer": { "@type": "Answer", "text": "It depends on your goals, your catchment, and how many free trials you can handle a week — there's no one-size number. We size the budget to fill the trial slots you actually have, then scale as the cost per lead proves out. Book a consultation and we'll recommend a figure." } },
      { "@type": "Question", "name": "Google Ads or Meta Ads — which is better for a gym?", "acceptedAnswer": { "@type": "Answer", "text": "Google is primary for gyms. It captures people already searching 'gym near me', '24 hour gym Tampines', or 'personal trainer Novena' — the moment they're ready to join. Meta and Instagram build demand and run retargeting around it. We recommend the exact mix in your strategy session." } },
      { "@type": "Question", "name": "Do New Year and post-holiday campaigns really work for gyms?", "acceptedAnswer": { "@type": "Answer", "text": "January and the post-holiday weeks are the biggest search surge of the year for gyms. We build the campaigns in December so they're live and optimised before the rush, with free-trial and membership offers ready to capture resolution-driven searchers at the lowest cost per lead of the year." } },
      { "@type": "Question", "name": "How quickly will I see trial sign-ups from ads?", "acceptedAnswer": { "@type": "Answer", "text": "Google ads can drive sign-ups within the first week, unlike SEO. Campaigns usually need 2 to 4 weeks of data to reach peak performance as we optimise toward the lowest cost per booked trial and per new member." } },
      { "@type": "Question", "name": "How do you prove ads actually bring in members?", "acceptedAnswer": { "@type": "Answer", "text": "We wire conversion tracking with GCLID across your free-trial form, membership enquiries, and WhatsApp before spend starts. Every lead ties back to the keyword, ad, and campaign that produced it, so you see the real cost per trial and cost per member — not impressions." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "Gym Google Ads Singapore", "item": "https://jraftcreative.com/gym-google-ads-singapore/" }
    ]
  }
];
---

<style is:global>
  .animated-bg__grid { display: none; }

  #related-services .related-service-link {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.35);
    color: var(--text);
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  #related-services .related-service-link:hover {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.22) 0%, rgba(73, 184, 137, 0.1) 100%), rgba(20, 28, 32, 0.7);
    border-color: rgba(73, 184, 137, 0.6);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(73, 184, 137, 0.3);
  }

  .service-cta-section { background: var(--bg-alt) !important; }

  #sub-services .deliver-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }
  @media (max-width: 900px) { #sub-services .deliver-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { #sub-services .deliver-grid { grid-template-columns: 1fr; } }

  .renovation-funnel {
    list-style: none;
    padding: 0;
    margin: 56px 0 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 48px;
    counter-reset: funnel;
  }
  .funnel-stage {
    position: relative;
    text-align: center;
    padding: 28px 20px;
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.28);
    border-radius: 12px;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .funnel-stage:hover {
    transform: translateY(-4px);
    border-color: rgba(73, 184, 137, 0.55);
    box-shadow: 0 16px 40px -16px rgba(73, 184, 137, 0.3);
  }
  .funnel-stage h3 { font-size: 1.05rem; font-weight: 600; color: var(--accent); margin: 0 0 8px 0; letter-spacing: -0.01em; }
  .funnel-stage p { font-size: 0.82rem; color: var(--text); line-height: 1.5; margin: 0; }
  .funnel-stage:not(:last-child)::after {
    content: '→';
    position: absolute;
    right: -34px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--accent);
    font-size: 1.6rem;
    font-weight: 500;
    z-index: 2;
    line-height: 1;
    opacity: 0.7;
  }
  @media (max-width: 900px) {
    .renovation-funnel { grid-template-columns: repeat(2, 1fr); gap: 32px; }
    .funnel-stage:nth-child(2n)::after, .funnel-stage:last-child::after { display: none; }
    .funnel-stage:nth-child(2n-1)::after { right: -22px; }
  }
  @media (max-width: 600px) {
    .renovation-funnel { grid-template-columns: 1fr; gap: 20px; }
    .funnel-stage::after { display: none; }
  }
</style>

<ServiceLayout
  title="Gym Google Ads Singapore — Jraft Creative"
  description="Google Ads for gyms in Singapore — high-intent search, the January surge, free-trial and membership lead ads, and tracking that fills the floor."
  canonical="https://jraftcreative.com/gym-google-ads-singapore/"
  ogTitle="Gym Google Ads Singapore — Jraft Creative"
  ogDescription="Google Ads for gyms in Singapore. Search, the New Year surge, and retargeting that fills free trials and memberships — with tracking that proves every lead."
  ogImage="https://jraftcreative.com/images/og-gym.jpg"
  keywords="gym google ads singapore, gym advertising singapore, google ads for gyms, 24 hour gym ads singapore, personal trainer ads singapore, fitness centre ads singapore, Jraft Creative"
  schemaData={schemaData}
  heroLabel="Gym Google Ads"
  heroTitle='Google Ads for <span class="highlight">Gyms in Singapore</span>'
  heroSubtitle="When someone searches 'gym near me', '24 hour gym Tampines', or 'personal trainer Novena', paid ads put you in front of them the moment they're ready to join — with tracking that proves every free trial and membership back to the dollar that won it."
  heroImage="/images/service-gym.webp"
  heroButtons={[
    { text: "Get a Free Ad Strategy", href: "/contact/", class: "btn btn-primary" },
    { text: "See How We Work", href: "/process/", class: "btn btn-secondary" }
  ]}
  whatsappText="Hi Jraft Creative, I need Google Ads for my gym in Singapore."
  ctaLabel="Ready to Fill Your Gym Floor?"
  ctaTitle='Get a Free <span class="highlight">Gym Ad Strategy</span>'
  ctaDescription="Book a free consultation and we'll map the keywords, budget, and tracking that will fill your free trials and memberships — and show you what a booked lead should cost. No obligations."
  ctaButtons={[
    { text: "Get a Free Ad Strategy", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%20need%20Google%20Ads%20for%20my%20gym%20in%20Singapore.", class: "btn btn-secondary" }
  ]}
>

  <!-- ========== THE CHALLENGE ========== -->
  <section class="section" id="challenge" aria-label="Why gyms need paid ads in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Challenge</p>
        <h2>Spending on Ads Without <span class="highlight">Filling the Floor</span>?</h2>
      </div>
      <div class="section-content reveal">
        <p>Most gyms either boost a post and hope, or leave the "gym near me" searches to whichever competitor showed up first. Both leave the free trials empty. The gyms winning the sign-ups run tracked search campaigns that catch people the moment they decide to join.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Boosting Isn't a Strategy</h3>
            <p>Hitting "boost" on a workout clip spends money without a plan — no proper targeting, no conversion goal, no idea which dollar brought a free-trial sign-up. Just spend, and a vague hope it worked.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>The High-Intent Search You're Missing</h3>
            <p>"24 hour gym Tampines", "personal trainer Novena", "gym near me" — these searchers are ready to join now. If your ad isn't in that result, a competitor's takes the click and the member.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>No Tracking, No Truth</h3>
            <p>Without conversion tracking and GCLID wired properly, you can't tell a booked trial from a wasted click — so you can't scale what fills the floor or cut what drains the budget.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHAT WE DELIVER ========== -->
  <section class="section" id="sub-services" style="background: var(--bg-alt);" aria-label="Paid ad services for gyms">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">What We Deliver</p>
        <h2>Ads Built to Fill <span class="highlight">Free Trials</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Google Search captures the people already looking for a gym; Meta and Instagram build demand and keep you in front of them until they act. We run both, wired to a page and a sign-up form built to convert. Pair it with a fast <a href="/gym-website-design-singapore/">gym website</a>, ongoing <a href="/gym-seo-singapore/">gym SEO</a>, and <a href="/gym-social-media-singapore/">gym social media</a> for a floor that fills year-round.</p>
      </div>
      <div class="service-details-grid deliver-grid">
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-google-ads.webp');">
          <div class="service-detail-card__content">
            <h3>Google Search Ads</h3>
            <p>Capture high-intent searches like "24 hour gym Jurong" and "gym near me" with tightly-themed campaigns across Tanjong Pagar, Bugis, Tampines, Orchard, and Paya Lebar — sending ready-to-join searchers to a page built to convert.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-meta-ads.webp');">
          <div class="service-detail-card__content">
            <h3>Free-Trial &amp; Membership Lead Ads</h3>
            <p>Dedicated campaigns for free-trial passes, membership enquiries, and personal training sign-ups — the offers people actually search for — pointed at a form built to capture the lead on the first click.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-retargeting.jpg');">
          <div class="service-detail-card__content">
            <h3>Retargeting</h3>
            <p>The person who viewed your timetable or pricing but didn't sign up gets a timely reminder across Google and Instagram — recovering the trials that would otherwise slip away.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-campaign-analytics.webp');">
          <div class="service-detail-card__content">
            <h3>Tracking &amp; Reporting</h3>
            <p>Conversion events and GCLID wired and tested before a dollar is spent — so every trial and membership ties back to the campaign that won it. Monthly reporting on cost per lead, not impressions.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHY CHOOSE US ========== -->
  <section class="section" id="why-us" aria-label="Why choose Jraft Creative for gym ads">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2>Campaigns Built to Prove <span class="highlight">Cost Per Member</span></h2>
      </div>
      <div class="section-content reveal">
        <p>We run paid media the way it should be run for a membership business — tracking first, tuned to sign-ups, and reported in the numbers that decide whether your floor is growing. Paid ads are one part of our full <a href="/industries/fitness/">fitness marketing services</a>.</p>
      </div>
      <div class="service-details-grid" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Tracking Before Spend</h3>
            <p>We wire and test conversion tracking before launch. A silent tracking failure looks exactly like "no demand" — we never let your ad spend fly blind.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Built for the January Surge</h3>
            <p>We build the campaigns in December so they're live before the post-holiday fitness rush — the biggest search surge of the year — with trial and membership offers ready when demand peaks.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>No Lock-In, Real Numbers</h3>
            <p>Month-to-month, with reporting on cost per trial and cost per member — the numbers that matter, not vanity reach and impressions. Your ad spend goes straight to Google, never marked up.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== ADS FLOW ========== -->
  <section class="section" id="ads-flow" style="background: var(--bg-alt);" aria-label="How gym ads work">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">How It Works</p>
        <h2>From <span class="highlight">Wasted Spend</span> to <span class="highlight">New Members</span></h2>
      </div>
      <div class="section-content reveal" style="margin-bottom: 24px;">
        <p>Four steps, run in order, so no dollar goes out before we can measure what it brings back. Not sure which platform to back? Our guide on <a href="/blog/google-ads-vs-meta-ads-singapore/">Google Ads vs Meta Ads in Singapore</a> breaks down where each one wins.</p>
      </div>
      <ol class="renovation-funnel reveal">
        <li class="funnel-stage">
          <h3>Strategy</h3>
          <p>Goals, budget, and keyword plan set</p>
        </li>
        <li class="funnel-stage">
          <h3>Track</h3>
          <p>Conversions and GCLID wired and tested</p>
        </li>
        <li class="funnel-stage">
          <h3>Launch</h3>
          <p>Search and social campaigns go live</p>
        </li>
        <li class="funnel-stage">
          <h3>Optimise</h3>
          <p>Scale what books trials, cut the rest</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ========== FAQ ========== -->
  <section class="section faq-section" id="faq" aria-label="Frequently asked questions about gym ads in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">FAQ</p>
        <h2><span class="highlight">Gym Ads</span> — Questions <span class="highlight">Answered</span></h2>
      </div>
      <div class="faq-list">
        <details class="faq-item reveal reveal-d1">
          <summary>How much should my gym spend on ads?</summary>
          <div class="faq-answer"><p>It depends on your goals, your catchment, and how many free trials you can handle a week — there's no one-size number. We size the budget to fill the trial slots you actually have, then scale as the cost per lead proves out. Book a consultation and we'll recommend a figure.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>Google Ads or Meta Ads — which is better for a gym?</summary>
          <div class="faq-answer"><p>Google is primary for gyms. It captures people already searching "gym near me", "24 hour gym Tampines", or "personal trainer Novena" — the moment they're ready to join. Meta and Instagram build demand and run retargeting around it. We recommend the exact mix in your strategy session.</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>Do New Year and post-holiday campaigns really work for gyms?</summary>
          <div class="faq-answer"><p>January and the post-holiday weeks are the biggest search surge of the year for gyms. We build the campaigns in December so they're live and optimised before the rush, with free-trial and membership offers ready to capture resolution-driven searchers at the lowest cost per lead of the year.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>How quickly will I see trial sign-ups from ads?</summary>
          <div class="faq-answer"><p>Google ads can drive sign-ups within the first week, unlike SEO. Campaigns usually need 2 to 4 weeks of data to reach peak performance as we optimise toward the lowest cost per booked trial and per new member.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>How do you prove ads actually bring in members?</summary>
          <div class="faq-answer"><p>We wire conversion tracking with GCLID across your free-trial form, membership enquiries, and WhatsApp before spend starts. Every lead ties back to the keyword, ad, and campaign that produced it, so you see the real cost per trial and cost per member — not impressions.</p></div>
        </details>
      </div>
    </div>
  </section>


  <!-- Related Services -->
  <section class="section" id="related-services" aria-label="Related services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Explore More</p>
        <h2>More Gym Services</h2>
      </div>
      <div class="related-services-grid reveal">
          <a href="/gym-marketing-singapore/" class="related-service-link">Gym Marketing</a>
          <a href="/gym-seo-singapore/" class="related-service-link">Gym SEO</a>
          <a href="/gym-ai-search-optimisation-singapore/" class="related-service-link">Gym GEO</a>
          <a href="/gym-social-media-singapore/" class="related-service-link">Gym Social Media</a>
          <a href="/gym-branding-singapore/" class="related-service-link">Gym Branding</a>
          <a href="/gym-website-design-singapore/" class="related-service-link">Gym Websites</a>
      </div>
    </div>
  </section>
</ServiceLayout>
