---
import ServiceLayout from '../layouts/ServiceLayout.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Aesthetics Clinic Google Ads Singapore",
    "description": "Google Ads management for aesthetics clinics in Singapore — target patients searching for Botox, fillers, laser treatments, and aesthetic procedures. MOH-compliant ad campaigns",
    "provider": {
      "@type": "Organization",
      "name": "Jraft Creative",
      "url": "https://jraftcreative.com/",
      "logo": "https://jraftcreative.com/images/logo.png",
      "telephone": "+6582234578",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "60 Paya Lebar Road, Paya Lebar Square",
        "postalCode": "409051",
        "addressLocality": "Singapore",
        "addressCountry": "SG"
      }
    },
    "areaServed": { "@type": "Country", "name": "Singapore" },
    "serviceType": "Google Ads Management for Aesthetics Clinics"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How much do Google Ads cost for aesthetics clinics in Singapore?", "acceptedAnswer": { "@type": "Answer", "text": "Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote." } },
      { "@type": "Question", "name": "Are Google Ads for aesthetics clinics MOH-compliant?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. All our ad copy is written in compliance with MOH advertising guidelines for medical aesthetics in Singapore. We avoid prohibited before/after claims, unsubstantiated results, and misleading language — ensuring your campaigns run without policy violations or account suspensions." } },
      { "@type": "Question", "name": "Which aesthetic treatments should I advertise on Google?", "acceptedAnswer": { "@type": "Answer", "text": "We recommend starting with your highest-margin treatments that have strong search volume — typically Botox, dermal fillers, laser treatments, and body contouring. We analyse search data specific to Singapore to identify which procedures have the best cost-per-consultation ratio for your clinic." } },
      { "@type": "Question", "name": "How do you track consultations from Google Ads?", "acceptedAnswer": { "@type": "Answer", "text": "We set up conversion tracking to monitor form submissions, phone calls, WhatsApp enquiries, and online booking completions from ad traffic. Each consultation request is attributed to the specific keyword and ad that generated it, giving you clear visibility into your cost per patient acquisition." } },
      { "@type": "Question", "name": "Can you help my aesthetics clinic outrank competitors on Google?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We conduct thorough competitor analysis to identify gaps in their keyword coverage and ad strategies. By targeting underserved treatment keywords, crafting more compelling ad copy, and optimising landing pages for conversion, we help your clinic capture patients that competitors are missing." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "Aesthetics Clinic Google Ads Singapore", "item": "https://jraftcreative.com/aesthetics-clinic-google-ads-singapore/" }
    ]
  }
];
---

<style is:global>
  /* Hide the global background grid pattern on this page only */
  .animated-bg__grid { display: none; }

  /* More-prominent related-service pills — match challenge-card-v2 green treatment */
  #related-services .related-service-link {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.35);
    color: var(--text);
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  #related-services .related-service-link:hover {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.22) 0%, rgba(73, 184, 137, 0.1) 100%), rgba(20, 28, 32, 0.7);
    border-color: rgba(73, 184, 137, 0.6);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(73, 184, 137, 0.3);
  }
  .service-cta-section { background: var(--bg-alt) !important; }
  .renovation-funnel { list-style: none; padding: 0; margin: 56px 0 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 48px; }
  .funnel-stage { position: relative; text-align: center; padding: 28px 20px; background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6); border: 1px solid rgba(73, 184, 137, 0.28); border-radius: 12px; transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease; }
  .funnel-stage:hover { transform: translateY(-4px); border-color: rgba(73, 184, 137, 0.55); box-shadow: 0 16px 40px -16px rgba(73, 184, 137, 0.3); }
  .funnel-stage h3 { font-size: 1.05rem; font-weight: 600; color: var(--accent); margin: 0 0 8px 0; letter-spacing: -0.01em; }
  .funnel-stage p { font-size: 0.82rem; color: var(--text); line-height: 1.5; margin: 0; }
  .funnel-stage:not(:last-child)::after { content: '→'; position: absolute; right: -34px; top: 50%; transform: translateY(-50%); color: var(--accent); font-size: 1.6rem; font-weight: 500; z-index: 2; line-height: 1; opacity: 0.7; }
  @media (max-width: 900px) { .renovation-funnel { grid-template-columns: repeat(2, 1fr); gap: 32px; } .funnel-stage:nth-child(2n)::after, .funnel-stage:last-child::after { display: none; } .funnel-stage:nth-child(2n-1)::after { right: -22px; } }
  @media (max-width: 600px) { .renovation-funnel { grid-template-columns: 1fr; gap: 20px; } .funnel-stage::after { display: none; } }
</style>

<ServiceLayout
  title="Google Ads Agency for Aesthetics Clinics Singapore"
  description="Google Ads management for aesthetics clinics in Singapore. MOH-compliant campaigns targeting Botox, fillers, laser treatments, and aesthetic procedures."
  canonical="https://jraftcreative.com/aesthetics-clinic-google-ads-singapore/"
  ogTitle="Google Ads Agency for Aesthetics Clinics Singapore"
  ogDescription="Google Ads for aesthetics clinics in Singapore. MOH-compliant campaigns that drive consultation bookings. Plans"
  ogImage="https://jraftcreative.com/images/og-ads.jpg"
  keywords="aesthetics clinic google ads singapore, aesthetic clinic advertising singapore, google ads for aesthetics, ppc aesthetics clinic singapore, aesthetics clinic marketing singapore, Jraft Creative"
  schemaData={schemaData}
  heroLabel="Google Ads Agency for Aesthetics Clinics"
  heroTitle='Google Ads Agency for <span class="highlight">Aesthetics Clinics in Singapore</span>'
  heroSubtitle="Patients are searching for aesthetic treatments right now. We build and manage MOH-compliant Google Ads campaigns that position your clinic at the top of search results — driving consultation bookings for Botox, fillers, laser treatments, and more."
  heroImage="/images/service-aesthetics.webp"
  heroButtons={[
    { text: "Get a Free Ad Strategy", href: "/contact/", class: "btn btn-primary" },
    { text: "See How We Work", href: "/process/", class: "btn btn-secondary" }
  ]}
  whatsappText="Hi Jraft Creative, I need Google Ads for my aesthetics clinic in Singapore."
  ctaLabel="Grow Your Consultations"
  ctaTitle="Get a Free Aesthetics Clinic Ads Strategy Session"
  ctaDescription="Book a free consultation and we'll review your current ad performance, analyse your competitive landscape, and identify the highest-converting treatment keywords for your clinic. We'll get back to you within 24 hours."
  ctaButtons={[
    { text: "Get a Free Ad Strategy", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%20need%20Google%20Ads%20for%20my%20aesthetics%20clinic%20in%20Singapore.", class: "btn btn-secondary" }
  ]}
>

  <!-- ========== THE CHALLENGE ========== -->
  <section class="section" id="challenge" aria-label="Google Ads challenges for aesthetics clinics">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Challenge</p>
        <h2>Losing Patients to Clinics That <span class="highlight">Advertise Smarter</span>?</h2>
      </div>
      <div class="section-content reveal">
        <p>Singapore's medical aesthetics market runs past S$1 billion a year, and the clinics visible at the moment of search win the high-value consultations.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Invisible at the Moment of Intent</h3>
            <p>When a patient searches "Botox Singapore" or "aesthetic clinic near me", they book with whoever appears — even if your doctors are more experienced.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Expensive Keywords, Wasted Budget</h3>
            <p>Terms like "dermal fillers" and "laser treatment" are costly. A poorly managed account burns the budget without producing a single consultation.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>MOH Rules Restrict the Copy</h3>
            <p>Medical advertising limits what you can claim. Without compliant copy, ads get disapproved or, worse, the account gets suspended.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHAT WE DELIVER ========== -->
  <section class="section" id="sub-services" style="background: var(--bg-alt);" aria-label="Google Ads services for aesthetics clinics">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">What We Deliver</p>
        <h2>Six <span class="highlight">Pillars</span> of Aesthetics Clinic <span class="highlight">Google Ads</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Every campaign is MOH-compliant, treatment-specific, and judged on booked consultations rather than clicks.</p>
      </div>
      <div class="service-details-grid deliver-grid">
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-google-ads.webp');">
          <div class="service-detail-card__content">
            <h3>Treatment-Specific Campaigns</h3>
            <p>Keyword campaigns for what patients actually search — "Botox Singapore price", "HIFU face lift", "pigmentation laser" — high-intent, ready to book.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-meta-ads.webp');">
          <div class="service-detail-card__content">
            <h3>Competitor &amp; Brand Bidding</h3>
            <p>Strategic bids on competitor and branded treatment terms to intercept patients comparing clinics at the point of decision.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-campaign-analytics.webp');">
          <div class="service-detail-card__content">
            <h3>MOH-Compliant Ad Copy</h3>
            <p>Ads written within MOH guidelines — no exaggerated claims, no prohibited before/after imagery — protecting your account and reputation.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-landing-page.webp');">
          <div class="service-detail-card__content">
            <h3>Retargeting &amp; Consultation Funnels</h3>
            <p>Remarketing re-engages patients who visited but didn't book, keeping your clinic top of mind until they're ready to schedule.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-local-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Location &amp; Radius Targeting</h3>
            <p>Ads focused on the catchment around your clinic and the districts patients travel from, so budget follows patients who can actually attend.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-analytics-reporting.webp');">
          <div class="service-detail-card__content">
            <h3>Cost-Per-Consultation Reporting</h3>
            <p>We track click to booked consultation and report cost per consultation by treatment — so you know which campaigns actually pay for themselves.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHY US ========== -->
  <section class="section" id="why-us" aria-label="Why choose Jraft Creative for aesthetics clinic Google Ads">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2>A <span class="highlight">Google Ads Agency</span> That Knows <span class="highlight">Aesthetics</span></h2>
      </div>
      <div class="section-content reveal">
        <p>We manage aesthetics ad accounts across Singapore and know the line between compliant copy that converts and risky copy that gets suspended.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Medical Aesthetics Expertise</h3>
            <p>We understand MOH advertising rules, treatment terminology and how a patient decides — so campaigns are built by a team that knows the risks.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Transparent Ad Spend</h3>
            <p>Your budget goes straight to Google, never marked up. The account stays in your name, so you see every dollar and what each consultation costs.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Tracked to the Consultation</h3>
            <p>We report cost per booked consultation, not clicks — and also run <a href="/aesthetics-clinic-seo-singapore/">clinic SEO</a> and <a href="/aesthetics-clinic-website-singapore/">websites</a> to convert the traffic.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== PATIENT JOURNEY FUNNEL ========== -->
  <section class="section" id="buyer-funnel" style="background: var(--bg-alt);" aria-label="Where Google Ads fits the patient journey">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Patient Journey</p>
        <h2>Where <span class="highlight">Google Ads</span> Fits the <span class="highlight">Patient Journey</span></h2>
      </div>
      <div class="section-content reveal" style="margin-bottom: 24px;">
        <p>An aesthetics patient moves through five stages before booking. Google Ads owns the two highest-intent moments — Discover, when they first search a treatment, and Consult, when a remarketing ad brings a researcher back to book.</p>
      </div>
      <ol class="renovation-funnel reveal">
        <li class="funnel-stage"><h3>Discover</h3><p>An ad captures the first treatment search</p></li>
        <li class="funnel-stage"><h3>Research</h3><p>They read treatment detail and credentials</p></li>
        <li class="funnel-stage"><h3>Compare</h3><p>Before/after and reviews weigh the clinics</p></li>
        <li class="funnel-stage"><h3>Consult</h3><p>Remarketing brings them back to book</p></li>
        <li class="funnel-stage"><h3>Treat</h3><p>A first visit, then repeat &amp; referral</p></li>
      </ol>
    </div>
  </section>

  <!-- ========== PRICING ========== -->
  <!-- ========== FAQ ========== -->
  <section class="section faq-section" id="faq" style="background: var(--bg-alt);" aria-label="Frequently asked questions about Google Ads for aesthetics clinics">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">FAQ</p>
        <h2>Aesthetics Clinic <span class="highlight">Google Ads</span> — Questions Answered</h2>
      </div>
      <div class="faq-list">
        <details class="faq-item reveal reveal-d1">
          <summary>How much do Google Ads cost for aesthetics clinics in Singapore?</summary>
          <div class="faq-answer"><p>Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>Are Google Ads for aesthetics clinics MOH-compliant?</summary>
          <div class="faq-answer"><p>Yes. All our ad copy is written in compliance with MOH advertising guidelines for medical aesthetics in Singapore. We avoid prohibited before/after claims, unsubstantiated results, and misleading language — ensuring your campaigns run without policy violations or account suspensions.</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>Which aesthetic treatments should I advertise on Google?</summary>
          <div class="faq-answer"><p>We recommend starting with your highest-margin treatments that have strong search volume — typically Botox, dermal fillers, laser treatments, and body contouring. We analyse search data specific to Singapore to identify which procedures have the best cost-per-consultation ratio for your clinic.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>How do you track consultations from Google Ads?</summary>
          <div class="faq-answer"><p>We set up conversion tracking to monitor form submissions, phone calls, WhatsApp enquiries, and online booking completions from ad traffic. Each consultation request is attributed to the specific keyword and ad that generated it, giving you clear visibility into your cost per patient acquisition.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>Can you help my aesthetics clinic outrank competitors on Google?</summary>
          <div class="faq-answer"><p>Yes. We conduct thorough competitor analysis to identify gaps in their keyword coverage and ad strategies. By targeting underserved treatment keywords, crafting more compelling ad copy, and optimising landing pages for conversion, we help your clinic capture patients that competitors are missing.</p></div>
        </details>
      </div>
    </div>
  </section>


  <!-- Related Services -->
  <section class="section" id="related-services" aria-label="Related services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Explore More</p>
        <h2>More Aesthetics Clinic Services</h2>
      </div>
      <div class="related-services-grid reveal">
          <a href="/aesthetics-clinic-seo-singapore/" class="related-service-link">Aesthetics Clinic SEO</a>
          <a href="/aesthetics-clinic-website-singapore/" class="related-service-link">Aesthetics Clinic Website</a>
          <a href="/aesthetics-clinic-social-media-singapore/" class="related-service-link">Aesthetics Clinic Social Media</a>
          <a href="/aesthetics-clinic-marketing-singapore/" class="related-service-link">Aesthetics Clinic Marketing</a>
          <a href="/aesthetics-clinic-branding-singapore/" class="related-service-link">Aesthetics Clinic Branding</a>
          <a href="/aesthetics-clinic-ai-search-optimisation-singapore/" class="related-service-link">Aesthetics Clinic GEO / AI Search</a>
          <a href="/aesthetics-content-marketing-singapore/" class="related-service-link">Aesthetics Content Marketing</a>
      </div>
    </div>
  </section>
</ServiceLayout>