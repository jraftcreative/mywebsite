---
import ServiceLayout from '../layouts/ServiceLayout.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Google Ads Agency for Mental Health Clinics Singapore",
    "description": "Google Ads agency for mental health practices in Singapore. High-intent search campaigns, neighbourhood targeting and confidential enquiry tracking, built to reach people seeking therapy within Google's healthcare advertising policies.",
    "provider": {
      "@type": "Organization",
      "name": "Jraft Creative",
      "url": "https://jraftcreative.com/",
      "logo": "https://jraftcreative.com/images/logo.png",
      "telephone": "+6582234578",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "60 Paya Lebar Road, Paya Lebar Square",
        "postalCode": "409051",
        "addressLocality": "Singapore",
        "addressCountry": "SG"
      }
    },
    "areaServed": { "@type": "Country", "name": "Singapore" },
    "serviceType": "Mental Health Google Ads"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How much do Google Ads cost for a mental health practice in Singapore?", "acceptedAnswer": { "@type": "Answer", "text": "It depends on the services you promote and your area. Terms like 'therapist Singapore' and 'couples therapy' are among the more competitive searches, while neighbourhood and niche terms cost less. Book a consultation and we'll scope a budget matched to the enquiries you want to reach and give you a transparent quote." } },
      { "@type": "Question", "name": "Can you advertise mental health services on Google in Singapore?", "acceptedAnswer": { "@type": "Answer", "text": "Yes, within Google's healthcare advertising policies. We complete the required advertiser verification and write compliant copy that avoids restricted sensitive-category targeting, so your ads run without disapprovals or account risk." } },
      { "@type": "Question", "name": "How do you keep the ad copy sensitive and appropriate?", "acceptedAnswer": { "@type": "Answer", "text": "Every ad and landing page is written with care — no fear-based language, no stigmatising terms, no pressure. We describe your services plainly and warmly, acknowledging that reaching out for support is a meaningful step, and we never make claims about outcomes or recovery." } },
      { "@type": "Question", "name": "How do you track whether the ads lead to enquiries?", "acceptedAnswer": { "@type": "Answer", "text": "We set up conversion tracking with GCLID for enquiry forms, booking requests and WhatsApp clicks, then attribute each to the keyword and ad that produced it. Tracking is aggregate — no personally identifiable information enters the ad platform — so we report cost per enquiry while protecting confidentiality." } },
      { "@type": "Question", "name": "Can Google Ads work for a new or solo practice?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Ads let you appear based on relevance and bid rather than years of reputation, so a new therapist or small practice can reach people actively searching for support in its area from day one." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "Google Ads Agency for Mental Health Clinics Singapore", "item": "https://jraftcreative.com/mental-health-google-ads-singapore/" }
    ]
  }
];
---

<style is:global>
  /* Hide the global background grid pattern on this page only */
  .animated-bg__grid { display: none; }

  /* More-prominent related-service pills — match challenge-card-v2 green treatment */
  #related-services .related-service-link {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.35);
    color: var(--text);
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  #related-services .related-service-link:hover {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.22) 0%, rgba(73, 184, 137, 0.1) 100%), rgba(20, 28, 32, 0.7);
    border-color: rgba(73, 184, 137, 0.6);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(73, 184, 137, 0.3);
  }
  .service-cta-section { background: var(--bg-alt) !important; }
  .renovation-funnel { list-style: none; padding: 0; margin: 56px 0 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 48px; }
  .funnel-stage { position: relative; text-align: center; padding: 28px 20px; background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6); border: 1px solid rgba(73, 184, 137, 0.28); border-radius: 12px; transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease; }
  .funnel-stage:hover { transform: translateY(-4px); border-color: rgba(73, 184, 137, 0.55); box-shadow: 0 16px 40px -16px rgba(73, 184, 137, 0.3); }
  .funnel-stage h3 { font-size: 1.05rem; font-weight: 600; color: var(--accent); margin: 0 0 8px 0; letter-spacing: -0.01em; }
  .funnel-stage p { font-size: 0.82rem; color: var(--text); line-height: 1.5; margin: 0; }
  .funnel-stage:not(:last-child)::after { content: '→'; position: absolute; right: -34px; top: 50%; transform: translateY(-50%); color: var(--accent); font-size: 1.6rem; font-weight: 500; z-index: 2; line-height: 1; opacity: 0.7; }
  @media (max-width: 900px) { .renovation-funnel { grid-template-columns: repeat(2, 1fr); gap: 32px; } .funnel-stage:nth-child(2n)::after, .funnel-stage:last-child::after { display: none; } .funnel-stage:nth-child(2n-1)::after { right: -22px; } }
  @media (max-width: 600px) { .renovation-funnel { grid-template-columns: 1fr; gap: 20px; } .funnel-stage::after { display: none; } }
</style>

<ServiceLayout
  title="Google Ads for Mental Health Clinics Singapore"
  description="Google Ads agency for mental health practices in Singapore — high-intent therapy search campaigns and confidential enquiry tracking, done with care."
  canonical="https://jraftcreative.com/mental-health-google-ads-singapore/"
  ogTitle="Google Ads for Mental Health Clinics Singapore"
  ogDescription="Google Ads for mental health practices in Singapore. High-intent search campaigns and confidential enquiry tracking, built to reach people seeking help."
  ogImage="https://jraftcreative.com/images/og-mentalhealth.jpg"
  keywords="google ads agency for mental health clinics, mental health google ads singapore, therapist ppc singapore, counselling ads singapore, psychologist advertising singapore, therapy ads, Jraft Creative"
  schemaData={schemaData}
  heroLabel="Google Ads Agency for Mental Health Clinics"
  heroTitle='Google Ads Agency for <span class="highlight">Mental Health Clinics in Singapore</span>'
  heroSubtitle="When someone finally searches for a therapist, counsellor or psychologist, they are taking a brave first step. We run Google Ads for mental health practices that meet those searches — by service, by neighbourhood, with the sensitivity and confidentiality this field asks for."
  heroImage="/images/service-mentalhealth.webp"
  heroImageAlt="Mental health professional in a Singapore clinic"
  heroButtons={[
    { text: "Get a Free Ad Strategy", href: "/contact/", class: "btn btn-primary" },
    { text: "See Mental Health Marketing", href: "/mental-health-marketing-singapore/", class: "btn btn-secondary" }
  ]}
  whatsappText="Hi Jraft Creative, I need Google Ads for my mental health practice in Singapore."
  ctaLabel="Reach People Seeking Support"
  ctaTitle="Get a Free Mental Health Ads Strategy Session"
  ctaDescription="Book a free consultation and we'll review your current ad performance, look at which services are worth bidding on in your area, and map the terms people near your practice are searching. We'll get back to you within 24 hours."
  ctaButtons={[
    { text: "Get a Free Ad Strategy", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%20need%20Google%20Ads%20for%20my%20mental%20health%20practice%20in%20Singapore.", class: "btn btn-secondary" }
  ]}
  hideDefaultCta={false}
>

  <!-- ========== THE CHALLENGE ========== -->
  <section class="section" id="challenge" aria-label="Google Ads challenges for mental health clinics in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Challenge</p>
        <h2>Paying for Clicks That Never <span class="highlight">Reach the Right Person</span>?</h2>
      </div>
      <div class="section-content reveal">
        <p>More Singaporeans than ever are searching for support, and the first search is often the hardest step they take. A poorly built account spends the budget on the wrong searches and never connects with the people who need you.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>High-Cost, High-Waste Keywords</h3>
            <p>'Therapist Singapore' and 'couples counselling' draw strong competition. Broad, untuned campaigns burn budget on browsers and rival practices instead of people ready to reach out.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>The Moment Is Easily Missed</h3>
            <p>Someone decides to seek help and searches once. If your practice is not visible at that moment, they may delay reaching out or choose whoever appeared first.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Google Restricts Sensitive Targeting</h3>
            <p>Mental health advertising sits under Google's healthcare policies. Without verification and compliant copy, ads get disapproved — or worse, the account is suspended mid-campaign.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHAT WE DELIVER ========== -->
  <section class="section" id="sub-services" style="background: var(--bg-alt);" aria-label="Google Ads services for mental health clinics">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">What We Deliver</p>
        <h2>Six <span class="highlight">Pillars</span> of Mental Health <span class="highlight">Google Ads</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Every campaign is service-specific, policy-compliant, and judged on confidential enquiries rather than clicks. It pairs naturally with a purpose-built <a href="/mental-health-clinic-website-singapore/">mental health clinic website</a> and steady <a href="/mental-health-social-media-singapore/">mental health social media</a> for long-term presence.</p>
      </div>
      <div class="service-details-grid deliver-grid">
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-google-ads.webp');">
          <div class="service-detail-card__content">
            <h3>High-Intent Search Campaigns</h3>
            <p>Separate campaigns for 'therapist Singapore', 'counselling near me', 'couples therapy' and 'child psychologist Singapore' — so budget follows the services you most want to fill.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-meta-ads.webp');">
          <div class="service-detail-card__content">
            <h3>Neighbourhood &amp; Radius Targeting</h3>
            <p>Ads focused on the estates around your practice — Novena, Orchard, Tanjong Pagar, Tampines, Bishan, Katong — and the MRT lines that feed it, so you stop paying for clicks from too far to attend.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-local-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Policy-Compliant Ad Copy</h3>
            <p>Ad copy written within Google's healthcare policies — proper advertiser verification, no restricted sensitive-category targeting, and no claims about outcomes — protecting your account and your standing.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-landing-page.webp');">
          <div class="service-detail-card__content">
            <h3>Confidential Enquiry &amp; Booking Ads</h3>
            <p>Campaigns pointed at simple, discreet enquiry and booking forms, so a click becomes a private first conversation without the searcher feeling exposed or pressured.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-campaign-analytics.webp');">
          <div class="service-detail-card__content">
            <h3>Confidential Conversion Tracking</h3>
            <p>GCLID-based conversion tracking that ties each enquiry to the keyword and ad behind it, kept aggregate so no personally identifiable information enters the ad platform — compliant with PDPA.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-analytics-reporting.webp');">
          <div class="service-detail-card__content">
            <h3>Cost-Per-Enquiry Reporting</h3>
            <p>We track click to confidential enquiry and report cost per enquiry by service, so you know exactly what reaching each new client costs — no vanity metrics.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHY US ========== -->
  <section class="section" id="why-us" aria-label="Why choose Jraft Creative for mental health google ads">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2>A <span class="highlight">Google Ads Agency</span> Built for <span class="highlight">Mental Health Practices</span></h2>
      </div>
      <div class="section-content reveal">
        <p>We manage mental health ad accounts to a single number — cost per confidential enquiry — and keep every campaign compliant and kind. It sits inside our wider <a href="/industries/healthcare/">healthcare marketing in Singapore</a> practice, and if you are weighing channels, our guide to <a href="/blog/google-ads-vs-meta-ads-singapore/">Google Ads versus Meta Ads in Singapore</a> is a useful place to start.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Sensitivity as Standard</h3>
            <p>Every ad and landing page is written to reduce barriers, not create pressure. We understand people searching for therapy are vulnerable, so the messaging offers safety and warmth — never fear or stigma.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Transparent Ad Spend</h3>
            <p>Your budget goes straight to Google, never marked up. The account stays in your name, so you see every dollar and what each new enquiry costs.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Healthcare Compliance Handled</h3>
            <p>We navigate Google's healthcare advertiser verification and Singapore's PDPA so your advertising runs cleanly and never compromises the trust your clients place in you.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== CLIENT JOURNEY FUNNEL ========== -->
  <section class="section" id="buyer-funnel" style="background: var(--bg-alt);" aria-label="Where google ads fits the client journey">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Client Journey</p>
        <h2>Where <span class="highlight">Google Ads</span> Fits the <span class="highlight">Journey to Support</span></h2>
      </div>
      <div class="section-content reveal" style="margin-bottom: 24px;">
        <p>Someone seeking help moves through several stages before booking. Google Ads meets them at the two highest-intent moments — Discover, when they first search a service, and Enquire, when a return visit and a welcoming page make reaching out feel safe.</p>
      </div>
      <ol class="renovation-funnel reveal">
        <li class="funnel-stage"><h3>Discover</h3><p>An ad meets the first search for support</p></li>
        <li class="funnel-stage"><h3>Research</h3><p>They read your approach and therapist profiles</p></li>
        <li class="funnel-stage"><h3>Consider</h3><p>Reviews, location and fit weigh the options</p></li>
        <li class="funnel-stage"><h3>Enquire</h3><p>A discreet form or WhatsApp opens the door</p></li>
        <li class="funnel-stage"><h3>Begin</h3><p>A warm first session, then ongoing care</p></li>
      </ol>
    </div>
  </section>

  <!-- ========== FAQ ========== -->
  <section class="section faq-section" id="faq" style="background: var(--bg-alt);" aria-label="Frequently asked questions about mental health google ads">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">FAQ</p>
        <h2>Mental Health Google Ads — Questions Answered</h2>
      </div>
      <div class="faq-list">
        <details class="faq-item reveal reveal-d1">
          <summary>How much do Google Ads cost for a mental health practice in Singapore?</summary>
          <div class="faq-answer"><p>It depends on the services you promote and your area. Terms like 'therapist Singapore' and 'couples therapy' are among the more competitive searches, while neighbourhood and niche terms cost less. Book a consultation and we'll scope a budget matched to the enquiries you want to reach and give you a transparent quote.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>Can you advertise mental health services on Google in Singapore?</summary>
          <div class="faq-answer"><p>Yes, within Google's healthcare advertising policies. We complete the required advertiser verification and write compliant copy that avoids restricted sensitive-category targeting, so your ads run without disapprovals or account risk.</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>How do you keep the ad copy sensitive and appropriate?</summary>
          <div class="faq-answer"><p>Every ad and landing page is written with care — no fear-based language, no stigmatising terms, no pressure. We describe your services plainly and warmly, acknowledging that reaching out for support is a meaningful step, and we never make claims about outcomes or recovery.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>How do you track whether the ads lead to enquiries?</summary>
          <div class="faq-answer"><p>We set up conversion tracking with GCLID for enquiry forms, booking requests and WhatsApp clicks, then attribute each to the keyword and ad that produced it. Tracking is aggregate — no personally identifiable information enters the ad platform — so we report cost per enquiry while protecting confidentiality.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>Can Google Ads work for a new or solo practice?</summary>
          <div class="faq-answer"><p>Yes. Ads let you appear based on relevance and bid rather than years of reputation, so a new therapist or small practice can reach people actively searching for support in its area from day one.</p></div>
        </details>
      </div>
    </div>
  </section>

  <!-- Related Services -->
  <section class="section" id="related-services" aria-label="Related services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Explore More</p>
        <h2>More <span class="highlight">Mental Health</span> Services</h2>
      </div>
      <div class="related-services-grid reveal">
          <a href="/mental-health-marketing-singapore/" class="related-service-link">Mental Health Marketing</a>
          <a href="/mental-health-ai-search-optimisation-singapore/" class="related-service-link">Mental Health GEO</a>
          <a href="/mental-health-social-media-singapore/" class="related-service-link">Mental Health Social Media</a>
          <a href="/mental-health-clinic-website-singapore/" class="related-service-link">Mental Health Websites</a>
      </div>
    </div>
  </section>
</ServiceLayout>
