---
import ServiceLayout from '../layouts/ServiceLayout.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Aesthetics Clinic Website Design Singapore",
    "description": "Professional website design for aesthetics clinics in Singapore. Treatment pages, before/after galleries, doctor profiles, MOH-compliant content, and consultation booking.",
    "provider": {
      "@type": "Organization",
      "name": "Jraft Creative",
      "url": "https://jraftcreative.com/",
      "logo": "https://jraftcreative.com/images/logo.png",
      "telephone": "+6582234578",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "60 Paya Lebar Road, Paya Lebar Square",
        "postalCode": "409051",
        "addressLocality": "Singapore",
        "addressCountry": "SG"
      }
    },
    "areaServed": { "@type": "Country", "name": "Singapore" },
    "serviceType": "Aesthetics Clinic Website Design"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How much does an aesthetics clinic website cost in Singapore?", "acceptedAnswer": { "@type": "Answer", "text": "Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote." } },
      { "@type": "Question", "name": "Do you ensure MOH advertising compliance for aesthetics websites?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. All aesthetics clinic websites we build follow Singapore's Ministry of Health (MOH) Healthcare Services Advertising guidelines. We avoid prohibited claims, ensure treatment descriptions use approved language, and structure content so your website promotes your clinic without violating advertising regulations." } },
      { "@type": "Question", "name": "Can you build before and after galleries for my aesthetics clinic?", "acceptedAnswer": { "@type": "Answer", "text": "Yes, with the appropriate consent and compliance handling. Before/after galleries are one of the most persuasive elements on an aesthetics site, so we build them properly — filtered by treatment, displayed with patient consent, and structured to stay within MOH advertising rules." } },
      { "@type": "Question", "name": "Do you create individual doctor profile pages?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Doctor profiles are essential for building patient trust. We create professional profile pages featuring qualifications, specialisations, years of experience, and professional affiliations. For multi-doctor clinics, each doctor gets their own dedicated page with consultation booking linked directly." } },
      { "@type": "Question", "name": "How long does it take to build an aesthetics clinic website?", "acceptedAnswer": { "@type": "Answer", "text": "Most aesthetics clinic websites go live within 3–4 weeks due to the detailed treatment content and compliance review required. Starter sites with fewer pages can be ready in 2 weeks. We provide a clear timeline and work closely with your team to ensure all content meets MOH advertising standards." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "Aesthetics Clinic Website Singapore", "item": "https://jraftcreative.com/aesthetics-clinic-website-singapore/" }
    ]
  }
];
---

<style is:global>
  /* Hide the global background grid pattern on this page only */
  .animated-bg__grid { display: none; }

  /* More-prominent related-service pills — match challenge-card-v2 green treatment */
  #related-services .related-service-link {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.35);
    color: var(--text);
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  #related-services .related-service-link:hover {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.22) 0%, rgba(73, 184, 137, 0.1) 100%), rgba(20, 28, 32, 0.7);
    border-color: rgba(73, 184, 137, 0.6);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(73, 184, 137, 0.3);
  }

  /* Separate the CTA section from related-services with bg-alt */
  .service-cta-section {
    background: var(--bg-alt) !important;
  }

  /* Patient Journey Funnel — 5-stage horizontal flow with green accents */
  .renovation-funnel {
    list-style: none;
    padding: 0;
    margin: 56px 0 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 48px;
    counter-reset: funnel;
  }
  .funnel-stage {
    position: relative;
    text-align: center;
    padding: 28px 20px;
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.28);
    border-radius: 12px;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .funnel-stage:hover {
    transform: translateY(-4px);
    border-color: rgba(73, 184, 137, 0.55);
    box-shadow: 0 16px 40px -16px rgba(73, 184, 137, 0.3);
  }
  .funnel-stage h3 {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--accent);
    margin: 0 0 8px 0;
    letter-spacing: -0.01em;
  }
  .funnel-stage p {
    font-size: 0.82rem;
    color: var(--text);
    line-height: 1.5;
    margin: 0;
  }
  .funnel-stage:not(:last-child)::after {
    content: '→';
    position: absolute;
    right: -34px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--accent);
    font-size: 1.6rem;
    font-weight: 500;
    z-index: 2;
    line-height: 1;
    opacity: 0.7;
  }
  @media (max-width: 900px) {
    .renovation-funnel {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }
    .funnel-stage:nth-child(2n)::after,
    .funnel-stage:last-child::after {
      display: none;
    }
    .funnel-stage:nth-child(2n-1)::after {
      right: -22px;
    }
  }
  @media (max-width: 600px) {
    .renovation-funnel {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .funnel-stage::after {
      display: none;
    }
  }
</style>

<ServiceLayout
  title="Aesthetics Clinic Website — Web Design Agency"
  description="Website design for aesthetics clinics in Singapore. Treatment pages, before/after galleries, doctor profiles, MOH-compliant content."
  canonical="https://jraftcreative.com/aesthetics-clinic-website-singapore/"
  ogTitle="Aesthetics Clinic Website — Web Design Agency"
  ogDescription="Website design for aesthetics clinics in Singapore. Treatment pages, before/after galleries, doctor profiles, and MOH-compliant content."
  ogImage="https://jraftcreative.com/images/og-webdev.jpg"
  keywords="aesthetics clinic website design singapore, aesthetics clinic website singapore, aesthetic clinic web design, medical aesthetics website, clinic booking website, doctor profile website, MOH compliant website, Jraft Creative"
  schemaData={schemaData}
  heroLabel="Web Design Agency for Aesthetics Clinics"
  heroTitle='Web Design Agency for <span class="highlight">Aesthetics Clinics in Singapore</span>'
  heroSubtitle="Your clinic's website is where patients decide to trust you with their appearance. We build professional, MOH-compliant websites for aesthetics clinics with treatment pages, doctor profiles, before/after galleries, and consultation booking — designed to convert enquiries into appointments."
  heroImage="/images/service-aesthetics.webp"
  heroImageAlt="Aesthetics clinic treatment room in Singapore — aesthetics clinic web design"
  heroButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "See Our Work", href: "/services/website-development/#portfolio", class: "btn btn-secondary" }
  ]}
  whatsappText="Hi Jraft Creative, I need a website for my aesthetics clinic in Singapore."
  ctaLabel="Ready to Get Started?"
  ctaTitle="Get Your Aesthetics Clinic Online"
  ctaDescription="Book a free consultation and tell us about your clinic. We'll get back to you within 24 hours with a tailored proposal covering design, compliance, and booking integration."
  ctaButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%20need%20a%20website%20for%20my%20aesthetics%20clinic%20in%20Singapore.", class: "btn btn-secondary" }
  ]}
  hideDefaultCta={false}
>

  <!-- ========== THE CHALLENGE ========== -->
  <section class="section" id="challenge" aria-label="Why aesthetics clinics need a proper website">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Challenge</p>
        <h2>Patients Research Before They Book — Is Your <span class="highlight">Website Convincing Them</span>?</h2>
      </div>
      <div class="section-content reveal">
        <p>Aesthetics is a high-consideration, trust-driven decision. A patient reads credentials, compares results and checks compliance long before they ever call.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>A High-Consideration Choice</h3>
            <p>Patients study doctor credentials, treatment options and before/after results before committing. A thin website loses them to a clinic that answers those questions.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Trust Social Media Can't Build</h3>
            <p>An Instagram feed can't present qualifications, procedure detail and real outcomes at the depth a first-time patient needs to feel safe booking.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>MOH Rules Most Agencies Miss</h3>
            <p>Your content must promote the clinic without prohibited claims. A generalist web agency doesn't know the guidelines — we build compliant from day one.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHAT WE BUILD ========== -->
  <section class="section" id="sub-services" style="background: var(--bg-alt);" aria-label="Aesthetics clinic website design services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">What We Build</p>
        <h2>Six <span class="highlight">Pillars</span> of an Aesthetics Clinic <span class="highlight">Website</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Every element is built around patient trust and conversion — from first research to a confirmed consultation.</p>
      </div>
      <div class="service-details-grid deliver-grid">
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-business-website.webp');">
          <div class="service-detail-card__content">
            <h3>Treatment Pages</h3>
            <p>A dedicated page per treatment — Botox, fillers, laser, HIFU, thread lifts — covering procedure, outcome and recovery in MOH-compliant language.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-landing-page.webp');">
          <div class="service-detail-card__content">
            <h3>Doctor Profiles &amp; Trust Signals</h3>
            <p>Qualifications, specialisations and affiliations, with accreditation badges and testimonials placed to build confidence at every step.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-local-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Before &amp; After Gallery</h3>
            <p>Interactive sliders filtered by treatment — the single most persuasive element for a patient comparing clinics, shown with proper consent.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-graphic-design.webp');">
          <div class="service-detail-card__content">
            <h3>Consultation Booking</h3>
            <p>Book directly on the site — pick a treatment, choose a doctor, take a slot. It removes the gap between "I'm interested" and "I have an appointment".</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-onpage-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Search-Ready Foundations</h3>
            <p>Clean structure, schema and fast mobile loads built in, so the site can rank for treatment searches rather than needing rescuing later.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-speed-vitals.webp');">
          <div class="service-detail-card__content">
            <h3>Private, Mobile-First Experience</h3>
            <p>Patients research treatments discreetly on their phones. Every page is built mobile-first, fast, and easy to book from in a tap.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHY CHOOSE US ========== -->
  <section class="section" id="why-us" aria-label="Why choose Jraft Creative for aesthetics clinic website design">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2>A <span class="highlight">Web Design Agency</span> That Knows <span class="highlight">MOH Rules</span></h2>
      </div>
      <div class="section-content reveal">
        <p>A site that's compelling enough to attract patients, detailed enough to answer them, and compliant enough to keep you safe.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>MOH Compliance Built In</h3>
            <p>Every page follows MOH Healthcare Services Advertising rules — no prohibited claims, no misleading testimonials, no non-compliant pricing tactics.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Trust-Focused Design</h3>
            <p>Aesthetics is a trust industry. Doctor profiles, accreditations and real results are designed to reassure a patient considering treatment for the first time.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Website, SEO &amp; Ads Together</h3>
            <p>We also run <a href="/aesthetics-clinic-seo-singapore/">clinic SEO</a> and <a href="/aesthetics-clinic-google-ads-singapore/">Google Ads</a> — one agency for the clinic's whole online presence.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== PATIENT JOURNEY FUNNEL ========== -->
  <section class="section" id="buyer-funnel" style="background: var(--bg-alt);" aria-label="Where your website fits the patient journey">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Patient Journey</p>
        <h2>Where Your <span class="highlight">Website</span> Fits the <span class="highlight">Patient Journey</span></h2>
      </div>
      <div class="section-content reveal" style="margin-bottom: 24px;">
        <p>An aesthetics patient moves through the same five stages before booking. Your website carries the middle three — it is where they research the treatment, compare you against other clinics, and finally book the consultation.</p>
      </div>
      <ol class="renovation-funnel reveal">
        <li class="funnel-stage">
          <h3>Discover</h3>
          <p>A search or referral brings them to the site</p>
        </li>
        <li class="funnel-stage">
          <h3>Research</h3>
          <p>Treatment pages and doctor profiles answer the detail</p>
        </li>
        <li class="funnel-stage">
          <h3>Compare</h3>
          <p>Before/after results weigh you against other clinics</p>
        </li>
        <li class="funnel-stage">
          <h3>Consult</h3>
          <p>Booking turns interest into a scheduled consultation</p>
        </li>
        <li class="funnel-stage">
          <h3>Treat</h3>
          <p>A confident first visit, then repeat &amp; referral</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ========== FAQ ========== -->
  <section class="section faq-section" id="faq" style="background: var(--bg-alt);" aria-label="Frequently asked questions about aesthetics clinic website design in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">FAQ</p>
        <h2>Aesthetics Clinic <span class="highlight">Website</span> Questions Answered</h2>
      </div>
      <div class="faq-list">
        <details class="faq-item reveal reveal-d1">
          <summary>How much does an aesthetics clinic website cost in Singapore?</summary>
          <div class="faq-answer"><p>Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>Do you ensure MOH advertising compliance for aesthetics websites?</summary>
          <div class="faq-answer"><p>Yes. All aesthetics clinic websites we build follow Singapore's Ministry of Health (MOH) Healthcare Services Advertising guidelines. We avoid prohibited claims, ensure treatment descriptions use approved language, and structure content so your website promotes your clinic without violating advertising regulations.</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>Can you build before and after galleries for my aesthetics clinic?</summary>
          <div class="faq-answer"><p>Yes, with the appropriate consent and compliance handling. Before/after galleries are one of the most persuasive elements on an aesthetics site, so we build them properly — filtered by treatment, displayed with patient consent, and structured to stay within MOH advertising rules.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>Do you create individual doctor profile pages?</summary>
          <div class="faq-answer"><p>Yes. Doctor profiles are essential for building patient trust. We create professional profile pages featuring qualifications, specialisations, years of experience, and professional affiliations. For multi-doctor clinics, each doctor gets their own dedicated page with consultation booking linked directly.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>How long does it take to build an aesthetics clinic website?</summary>
          <div class="faq-answer"><p>Most aesthetics clinic websites go live within 3–4 weeks due to the detailed treatment content and compliance review required. Starter sites with fewer pages can be ready in 2 weeks. We provide a clear timeline and work closely with your team to ensure all content meets MOH advertising standards.</p></div>
        </details>
      </div>
    </div>
  </section>

  <!-- Related Services -->
  <section class="section" id="related-services" aria-label="Related services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Explore More</p>
        <h2>More <span class="highlight">Aesthetics Clinic</span> Services</h2>
      </div>
      <div class="related-services-grid reveal">
          <a href="/aesthetics-clinic-seo-singapore/" class="related-service-link">Aesthetics Clinic SEO</a>
          <a href="/aesthetics-clinic-google-ads-singapore/" class="related-service-link">Aesthetics Clinic Google Ads</a>
          <a href="/aesthetics-clinic-social-media-singapore/" class="related-service-link">Aesthetics Clinic Social Media</a>
          <a href="/aesthetics-clinic-marketing-singapore/" class="related-service-link">Aesthetics Clinic Marketing</a>
          <a href="/aesthetics-clinic-branding-singapore/" class="related-service-link">Aesthetics Clinic Branding</a>
          <a href="/aesthetics-clinic-ai-search-optimisation-singapore/" class="related-service-link">Aesthetics Clinic GEO / AI Search</a>
          <a href="/aesthetics-content-marketing-singapore/" class="related-service-link">Aesthetics Content Marketing</a>
      </div>
    </div>
  </section>
</ServiceLayout>
