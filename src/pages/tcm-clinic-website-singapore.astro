---
import ServiceLayout from '../layouts/ServiceLayout.astro';
import RelatedServices from '../components/RelatedServices.astro';
import MarketingFunnelBlock from '../components/MarketingFunnelBlock.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "TCM Clinic Website Design Singapore",
    "description": "Professional website design for Traditional Chinese Medicine clinics in Singapore. Service pages, practitioner profiles, bilingual EN/CN content, and online appointment booking — custom-quoted to your scope.",
    "provider": {
      "@type": "Organization",
      "name": "Jraft Creative",
      "url": "https://jraftcreative.com/",
      "logo": "https://jraftcreative.com/images/logo.png",
      "telephone": "+6582234578",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "60 Paya Lebar Road, Paya Lebar Square",
        "postalCode": "409051",
        "addressLocality": "Singapore",
        "addressCountry": "SG"
      }
    },
    "areaServed": { "@type": "Country", "name": "Singapore" },
    "serviceType": "TCM Clinic Website Design"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How much does a TCM clinic website cost in Singapore?", "acceptedAnswer": { "@type": "Answer", "text": "Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote." } },
      { "@type": "Question", "name": "Can you build a bilingual website in English and Chinese for my TCM clinic?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Many TCM patients search in Chinese, so we can build your site bilingual — service descriptions, practitioner profiles and the booking flow available in both English and Chinese, with a language toggle, scoped to what your clinic needs. We also optimise for both English and Mandarin search terms so patients find you whichever language they use." } },
      { "@type": "Question", "name": "Do TCM clinic websites need to follow advertising regulations in Singapore?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. The Singapore TCM Practitioners Board and MOH set advertising rules for traditional medicine. Your website must avoid prohibited or unsubstantiated claims, and registered physicians can be presented with their Board registration as a credibility signal. We keep the content within these rules." } },
      { "@type": "Question", "name": "Can patients book TCM appointments online through the website?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We integrate online appointment booking on most projects. Patients choose a physician, treatment type and time slot, then receive automated confirmations and reminders — cutting phone calls and reducing no-shows for your clinic." } },
      { "@type": "Question", "name": "How long does it take to build a TCM clinic website?", "acceptedAnswer": { "@type": "Answer", "text": "Most TCM clinic websites go live within 2–3 weeks. A standard 5-page site can be ready in about 2 weeks, while bilingual builds or projects with online booking and multi-location pages may take 3–4 weeks. We provide a clear timeline before starting." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "TCM Clinic Website Design Singapore", "item": "https://jraftcreative.com/tcm-clinic-website-singapore/" }
    ]
  }
];
---

<style is:global>
  /* Hide the global background grid pattern on this page only */
  .animated-bg__grid { display: none; }

  /* More-prominent related-service pills — match challenge-card-v2 green treatment */
  #related-services .related-service-link {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.35);
    color: var(--text);
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  #related-services .related-service-link:hover {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.22) 0%, rgba(73, 184, 137, 0.1) 100%), rgba(20, 28, 32, 0.7);
    border-color: rgba(73, 184, 137, 0.6);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(73, 184, 137, 0.3);
  }
  .service-cta-section { background: var(--bg-alt) !important; }
  .renovation-funnel { list-style: none; padding: 0; margin: 56px 0 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 48px; }
  .funnel-stage { position: relative; text-align: center; padding: 28px 20px; background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6); border: 1px solid rgba(73, 184, 137, 0.28); border-radius: 12px; transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease; }
  .funnel-stage:hover { transform: translateY(-4px); border-color: rgba(73, 184, 137, 0.55); box-shadow: 0 16px 40px -16px rgba(73, 184, 137, 0.3); }
  .funnel-stage h3 { font-size: 1.05rem; font-weight: 600; color: var(--accent); margin: 0 0 8px 0; letter-spacing: -0.01em; }
  .funnel-stage p { font-size: 0.82rem; color: var(--text); line-height: 1.5; margin: 0; }
  .funnel-stage:not(:last-child)::after { content: '→'; position: absolute; right: -34px; top: 50%; transform: translateY(-50%); color: var(--accent); font-size: 1.6rem; font-weight: 500; z-index: 2; line-height: 1; opacity: 0.7; }
  @media (max-width: 900px) { .renovation-funnel { grid-template-columns: repeat(2, 1fr); gap: 32px; } .funnel-stage:nth-child(2n)::after, .funnel-stage:last-child::after { display: none; } .funnel-stage:nth-child(2n-1)::after { right: -22px; } }
  @media (max-width: 600px) { .renovation-funnel { grid-template-columns: 1fr; gap: 20px; } .funnel-stage::after { display: none; } }
</style>

<ServiceLayout
  title="TCM Clinic Website — Web Design Agency"
  description="Custom websites for Singapore TCM clinics — online booking, service pages, bilingual EN/CN, mobile-first. Live in 2–3 weeks. Custom-quoted to your scope."
  canonical="https://jraftcreative.com/tcm-clinic-website-singapore/"
  ogTitle="TCM Clinic Website — Web Design Agency"
  ogDescription="Custom websites for Singapore TCM clinics — online booking, service pages, bilingual EN/CN, mobile-first. Live in 2–3 weeks. Custom-quoted to your scope."
  ogImage="https://jraftcreative.com/images/og-tcm.jpg"
  keywords="TCM clinic website design singapore, TCM website singapore, traditional chinese medicine website, TCM web design singapore, chinese medicine clinic website, acupuncture clinic website singapore, TCM digital marketing singapore, Jraft Creative"
  schemaData={schemaData}
  heroLabel="Web Design Agency for TCM Clinics"
  heroTitle='Web Design Agency for <span class="highlight">TCM Clinics in Singapore</span>'
  heroSubtitle="Your clinic needs more than a directory listing. We build fast, mobile-friendly websites for Traditional Chinese Medicine practices — with service pages for acupuncture, herbal medicine, tuina and cupping, registered-physician profiles, bilingual English and Chinese content, and online appointment booking. TCM website design and development that turns a search into a booked appointment."
  heroImage="/images/service-tcm.webp"
  heroButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "See Our Work", href: "/about/", class: "btn btn-secondary" }
  ]}
  whatsappText="Hi Jraft Creative, I need a website for my TCM clinic in Singapore."
  ctaLabel="Ready to Get Started?"
  ctaTitle="Get Your TCM Clinic Online"
  ctaDescription="Book a free consultation and tell us about your TCM practice. We'll get back to you within 24 hours with a tailored proposal."
  ctaButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%20need%20a%20website%20for%20my%20TCM%20clinic%20in%20Singapore.", class: "btn btn-secondary" }
  ]}
  hideDefaultCta={false}
>

  <!-- ========== THE CHALLENGE ========== -->
  <section class="section" id="challenge" aria-label="Why TCM clinics need a proper website">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Challenge</p>
        <h2>Patients Are Searching for a TCM Physician <span class="highlight">Online</span></h2>
      </div>
      <div class="section-content reveal">
        <p>From Chinatown and Toa Payoh to Ang Mo Kio, Tampines, Jurong and Katong, patients now search before they walk in — and many search in Chinese. Your website is the first impression, and it has to build trust in minutes.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Walk-Ins Alone Aren't Enough</h3>
            <p>If your clinic still relies on foot traffic and word of mouth, you miss the patients who search Google first and book with the clinic that shows up.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Patients Want to Understand, Then Book</h3>
            <p>Many patients aren't sure what acupuncture, herbal medicine or tuina involves. They want clear service pages and a registered physician they can trust — then a way to book without calling.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Advertising Rules Apply</h3>
            <p>Your site must follow Singapore TCM Practitioners Board and MOH advertising rules — no prohibited or unsubstantiated claims. A generic agency won't know them; we do.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHAT WE BUILD ========== -->
  <section class="section" id="sub-services" style="background: var(--bg-alt);" aria-label="TCM clinic website design services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">What We Build</p>
        <h2>Six <span class="highlight">Pillars</span> of a TCM Clinic <span class="highlight">Website</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Every element is built around patient trust and booking. We also run <a href="/tcm-clinic-seo-singapore/">TCM clinic SEO</a>, <a href="/tcm-clinic-google-ads-singapore/">Google Ads</a> and <a href="/tcm-clinic-branding-singapore/">clinic branding</a>, so the whole online presence works together.</p>
      </div>
      <div class="service-details-grid deliver-grid">
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-business-website.webp');">
          <div class="service-detail-card__content">
            <h3>Service Pages by Modality</h3>
            <p>A dedicated page for each service — acupuncture, herbal medicine 中药, tuina 推拿 and cupping 拔罐 — explaining what a session involves and a clear next step to book.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-landing-page.webp');">
          <div class="service-detail-card__content">
            <h3>Physician Profiles &amp; Credentials</h3>
            <p>A profile page per physician — training, areas of focus, languages spoken and Board registration — because patients want to know who will treat them.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-local-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Online Appointment Booking</h3>
            <p>Patients book directly — physician, service and time slot — with automated confirmations and reminders that cut no-shows and free the front desk.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-graphic-design.webp');">
          <div class="service-detail-card__content">
            <h3>Bilingual English &amp; Chinese</h3>
            <p>A language toggle with properly translated content, optimised for both English and Mandarin search — because many TCM patients look for a clinic in Chinese.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-onpage-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Search-Ready Foundations</h3>
            <p>Clean structure, schema and fast mobile loads built in, so the site can rank for TCM and treatment searches rather than needing rescuing later.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-speed-vitals.webp');">
          <div class="service-detail-card__content">
            <h3>Mobile-First &amp; Fast</h3>
            <p>Patients search on their phones, often at home or on the MRT. Every page is built mobile-first and fast, with tap-to-call and tap-to-book.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHY US ========== -->
  <section class="section" id="why-us" aria-label="Why choose Jraft Creative for TCM website design">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2>A <span class="highlight">Web Design Agency</span> That Knows <span class="highlight">TCM Trust</span></h2>
      </div>
      <div class="section-content reveal">
        <p>A site compelling enough to attract patients, clear enough to answer them, and compliant enough to keep your practice safe.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Healthcare Website Experience</h3>
            <p>We understand TCM Practitioners Board and MOH advertising rules, patient-privacy considerations and the trust signals — registration, reviews, compliant content — that matter in healthcare.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Live In Two to Three Weeks</h3>
            <p>Most TCM sites go live within two to three weeks, so a new practice or a refreshed brand is working online when you need it.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Website, SEO &amp; Ads Together</h3>
            <p>We also run <a href="/tcm-clinic-seo-singapore/">TCM clinic SEO</a> and <a href="/tcm-clinic-google-ads-singapore/">Google Ads</a> — one agency for the clinic's whole online presence.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== PATIENT JOURNEY FUNNEL ========== -->
  <section class="section" id="buyer-funnel" style="background: var(--bg-alt);" aria-label="Where your website fits the patient journey">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Patient Journey</p>
        <h2>Where Your <span class="highlight">Website</span> Fits the <span class="highlight">Patient Journey</span></h2>
      </div>
      <div class="section-content reveal" style="margin-bottom: 24px;">
        <p>A TCM patient moves through five stages before booking. Your website carries the middle three — it is where they learn about the treatment, compare you against other clinics, and finally book.</p>
      </div>
      <ol class="renovation-funnel reveal">
        <li class="funnel-stage"><h3>Discover</h3><p>A search or referral brings them to the site</p></li>
        <li class="funnel-stage"><h3>Research</h3><p>Service pages and physician profiles answer it</p></li>
        <li class="funnel-stage"><h3>Compare</h3><p>Credentials and reviews weigh you against others</p></li>
        <li class="funnel-stage"><h3>Book</h3><p>Online booking turns interest into an appointment</p></li>
        <li class="funnel-stage"><h3>Return</h3><p>A good first visit, then follow-ups &amp; referrals</p></li>
      </ol>
    </div>
  </section>

  <!-- ========== FAQ ========== -->
  <section class="section faq-section" id="faq" style="background: var(--bg-alt);" aria-label="Frequently asked questions about TCM website design in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">FAQ</p>
        <h2>TCM <span class="highlight">Website</span> Questions Answered</h2>
      </div>
      <div class="faq-list">
        <details class="faq-item reveal reveal-d1">
          <summary>How much does a TCM clinic website cost in Singapore?</summary>
          <div class="faq-answer"><p>Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>Can you build a bilingual website in English and Chinese for my TCM clinic?</summary>
          <div class="faq-answer"><p>Yes. Many TCM patients search in Chinese, so we can build your site bilingual — service descriptions, practitioner profiles and the booking flow available in both English and Chinese, with a language toggle, scoped to what your clinic needs. We also optimise for both English and Mandarin search terms so patients find you whichever language they use.</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>Do TCM clinic websites need to follow advertising regulations in Singapore?</summary>
          <div class="faq-answer"><p>Yes. The Singapore TCM Practitioners Board and MOH set advertising rules for traditional medicine. Your website must avoid prohibited or unsubstantiated claims, and registered physicians can be presented with their Board registration as a credibility signal. We keep the content within these rules.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>Can patients book TCM appointments online through the website?</summary>
          <div class="faq-answer"><p>Yes. We integrate online appointment booking on most projects. Patients choose a physician, treatment type and time slot, then receive automated confirmations and reminders — cutting phone calls and reducing no-shows for your clinic.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>How long does it take to build a TCM clinic website?</summary>
          <div class="faq-answer"><p>Most TCM clinic websites go live within 2–3 weeks. A standard 5-page site can be ready in about 2 weeks, while bilingual builds or projects with online booking and multi-location pages may take 3–4 weeks. We provide a clear timeline before starting.</p></div>
        </details>
      </div>
    </div>
  </section>


  <section class="section" id="related-services" aria-label="Related services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Explore More</p>
        <h2>More <span class="highlight">TCM Clinic</span> Services</h2>
      </div>
      <div class="related-services-grid reveal">
          <a href="/tcm-marketing-singapore/" class="related-service-link">TCM Clinic Marketing</a>
          <a href="/tcm-clinic-seo-singapore/" class="related-service-link">TCM Clinic SEO</a>
          <a href="/tcm-clinic-ai-search-optimisation-singapore/" class="related-service-link">TCM Clinic GEO</a>
          <a href="/tcm-clinic-google-ads-singapore/" class="related-service-link">TCM Clinic Google Ads</a>
          <a href="/tcm-clinic-social-media-singapore/" class="related-service-link">TCM Clinic Social Media</a>
          <a href="/tcm-clinic-branding-singapore/" class="related-service-link">TCM Clinic Branding</a>
      </div>
    </div>
  </section>

  <MarketingFunnelBlock
    industry="TCM clinic"
    marketingHref="/tcm-marketing-singapore/"
    outcomeLine="See how we'd bring in new patients — TCMPB-compliant"
    ctaText="TCM Clinic Marketing Singapore"
  />

</ServiceLayout>
