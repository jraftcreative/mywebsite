---
import ServiceLayout from '../layouts/ServiceLayout.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Enrichment Centre SEO Singapore",
    "description": "SEO services for enrichment centres in Singapore. Local SEO, Google Business Profile optimisation, programme-page SEO, and parent-focused content strategy to attract more enrolment enquiries",
    "provider": {
      "@type": "Organization",
      "name": "Jraft Creative",
      "url": "https://jraftcreative.com/",
      "logo": "https://jraftcreative.com/images/logo.png",
      "telephone": "+6582234578",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "60 Paya Lebar Road, Paya Lebar Square",
        "postalCode": "409051",
        "addressLocality": "Singapore",
        "addressCountry": "SG"
      }
    },
    "areaServed": { "@type": "Country", "name": "Singapore" },
    "serviceType": "Enrichment Centre SEO"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How much does SEO cost for an enrichment centre in Singapore?", "acceptedAnswer": { "@type": "Answer", "text": "Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote." } },
      { "@type": "Question", "name": "How long does it take for enrichment centre SEO to produce results?", "acceptedAnswer": { "@type": "Answer", "text": "Most enrichment centres see measurable improvements in search rankings within 3 to 5 months. Programme-specific and neighbourhood searches like 'coding class for kids Tampines' or 'speech and drama Bishan' can rank faster than broad terms. Google Business Profile optimisation often delivers quick visibility gains in the first few weeks." } },
      { "@type": "Question", "name": "What keywords do parents search for when looking for enrichment classes?", "acceptedAnswer": { "@type": "Answer", "text": "Common searches include 'enrichment centre near me', 'coding class for kids Singapore', 'speech and drama Tampines', 'creative writing enrichment Bishan', 'abacus class near me', and age-specific terms like 'phonics class for toddlers'. We research the exact keywords parents in your area are using and target the programmes you actually run." } },
      { "@type": "Question", "name": "Can SEO help parents find my enrichment centre on Google Maps?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Local SEO and Google Business Profile optimisation are core parts of our work. We optimise your listing with accurate class details, photos, parent reviews, and location data so your centre appears in the Google Maps three-pack when parents search 'enrichment centre near me' in Bukit Timah, Jurong East, Punggol, or wherever you operate." } },
      { "@type": "Question", "name": "Do you handle SEO for enrichment centres with multiple branches?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We create unique location pages for each branch, optimise separate Google Business Profiles, and build neighbourhood-specific content so every centre ranks in its own area. Whether you run two outlets or ten across Singapore, each location gets targeted visibility where its families live." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "Enrichment Centre SEO Singapore", "item": "https://jraftcreative.com/enrichment-centre-seo-singapore/" }
    ]
  }
];
---

<style is:global>
  /* Hide the global background grid pattern on this page only */
  .animated-bg__grid { display: none; }

  /* More-prominent related-service pills — match challenge-card-v2 green treatment */
  #related-services .related-service-link {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.35);
    color: var(--text);
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  #related-services .related-service-link:hover {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.22) 0%, rgba(73, 184, 137, 0.1) 100%), rgba(20, 28, 32, 0.7);
    border-color: rgba(73, 184, 137, 0.6);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(73, 184, 137, 0.3);
  }

  /* Separate the CTA section from related-services with bg-alt */
  .service-cta-section {
    background: var(--bg-alt) !important;
  }

  /* Enrolment Funnel — 5-stage horizontal flow with green accents */
  .renovation-funnel {
    list-style: none;
    padding: 0;
    margin: 56px 0 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 48px;
    counter-reset: funnel;
  }
  .funnel-stage {
    position: relative;
    text-align: center;
    padding: 28px 20px;
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.28);
    border-radius: 12px;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .funnel-stage:hover {
    transform: translateY(-4px);
    border-color: rgba(73, 184, 137, 0.55);
    box-shadow: 0 16px 40px -16px rgba(73, 184, 137, 0.3);
  }
  .funnel-stage h3 {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--accent);
    margin: 0 0 8px 0;
    letter-spacing: -0.01em;
  }
  .funnel-stage p {
    font-size: 0.82rem;
    color: var(--text);
    line-height: 1.5;
    margin: 0;
  }
  .funnel-stage:not(:last-child)::after {
    content: '→';
    position: absolute;
    right: -34px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--accent);
    font-size: 1.6rem;
    font-weight: 500;
    z-index: 2;
    line-height: 1;
    opacity: 0.7;
  }
  @media (max-width: 900px) {
    .renovation-funnel {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }
    .funnel-stage:nth-child(2n)::after,
    .funnel-stage:last-child::after {
      display: none;
    }
    .funnel-stage:nth-child(2n-1)::after {
      right: -22px;
    }
  }
  @media (max-width: 600px) {
    .renovation-funnel {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .funnel-stage::after {
      display: none;
    }
  }
</style>

<ServiceLayout
  title="Enrichment Centre SEO Singapore — Rank Higher on Google"
  description="SEO agency for enrichment centres in Singapore. Local SEO, Google Business Profile, and programme-page optimisation that fills class enquiries."
  canonical="https://jraftcreative.com/enrichment-centre-seo-singapore/"
  ogTitle="Enrichment Centre SEO Singapore — Rank Higher on Google"
  ogDescription="SEO agency for enrichment centres in Singapore. Local SEO, Google Business Profile, and programme-page optimisation that fills class enquiries."
  ogImage="https://jraftcreative.com/images/og-enrichment.jpg"
  keywords="enrichment centre seo singapore, seo agency for enrichment centres, seo for enrichment centres, enrichment centre marketing singapore, coding class for kids seo, speech and drama seo, enrichment centre google ranking, enrichment centre local seo, Jraft Creative"
  schemaData={schemaData}
  heroLabel="SEO Agency for Enrichment Centres"
  heroTitle='SEO Agency for <span class="highlight">Enrichment Centres in Singapore</span>'
  heroSubtitle="Parents searching 'enrichment centre near me' and 'coding class for kids Singapore' are ready to book a trial. If your centre doesn't appear in those results, families are enrolling with the centre down the street instead. We help enrichment centres rank higher on Google and turn search visibility into enrolment enquiries."
  heroImage="/images/service-enrichment.webp"
  heroImageAlt="Enrichment centre learning materials in Singapore"
  heroButtons={[
    { text: "Get a Free SEO Audit", href: "/contact/", class: "btn btn-primary" },
    { text: "See Enrichment Centre Google Ads", href: "/enrichment-centre-google-ads-singapore/", class: "btn btn-secondary" }
  ]}
  whatsappText="Hi Jraft Creative, I need SEO for my enrichment centre in Singapore."
  ctaLabel="Get Found by More Parents"
  ctaTitle="Get a Free Enrichment Centre SEO Audit"
  ctaDescription="Book a free consultation and we'll review how your centre currently ranks for programme and neighbourhood searches, check your Google Business Profile, and show you where the enrolment enquiries are leaking. We'll get back to you within 24 hours."
  ctaButtons={[
    { text: "Get a Free SEO Audit", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%20need%20SEO%20for%20my%20enrichment%20centre%20in%20Singapore.", class: "btn btn-secondary" }
  ]}
  hideDefaultCta={false}
>

  <!-- ========== THE CHALLENGE ========== -->
  <section class="section" id="challenge" aria-label="SEO challenges for enrichment centres in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Challenge</p>
        <h2>Parents Search for <span class="highlight">Enrichment Classes</span> Online — Does Your Centre <span class="highlight">Show Up</span>?</h2>
      </div>
      <div class="section-content reveal">
        <p>Parents start on Google, compare a handful of centres, and book a trial — often in one sitting. This is core <a href="/industries/education/">education marketing in Singapore</a>, and it starts with appearing in the searches that matter. Our guide on <a href="/blog/rank-google-maps-singapore/">how to rank on Google Maps in Singapore</a> shows why the local three-pack decides who gets the "near me" enquiry.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Invisible in the Search That Matters</h3>
            <p>"Enrichment centre near me" and "coding class for kids Singapore" are searched thousands of times a month. If your centre isn't in those results, those parents never know you exist.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Hundreds of Centres, One Pool of Families</h3>
            <p>Established chains and independent studios compete for the same parents. Centres investing in search quietly take the top positions without spending more on ads.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Search Demand Is Fragmented</h3>
            <p>Speech and drama, creative writing, abacus, coding, art and phonics — each across several neighbourhoods. Without structure, centres spread thin and rank for nothing at all.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHAT WE DELIVER ========== -->
  <section class="section" id="sub-services" style="background: var(--bg-alt);" aria-label="SEO services for enrichment centres">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">What We Deliver</p>
        <h2>Six <span class="highlight">Pillars</span> of Enrichment Centre <span class="highlight">SEO</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Parents search by programme, age, skill and neighbourhood — so we build the site around how families actually look for classes. It pairs with your <a href="/enrichment-centre-website-singapore/">enrichment centre website</a>, <a href="/enrichment-centre-social-media-singapore/">social media</a>, and <a href="/enrichment-centre-google-ads-singapore/">Google Ads</a> under one roof.</p>
      </div>
      <div class="service-details-grid deliver-grid">
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-seo-audit.webp');">
          <div class="service-detail-card__content">
            <h3>Technical SEO Audit</h3>
            <p>A full crawl for indexing issues, broken links, missing schema and slow mobile loads — the barriers stopping Google ranking you at all.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-onpage-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Programme &amp; Class Pages</h3>
            <p>A dedicated page per programme and age band — speech and drama, coding, abacus, art — structured around what parents ask before they enrol.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-local-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Local SEO &amp; Google Business Profile</h3>
            <p>Centre photos, class schedules, review management and citations — built to land you in the Maps three-pack for "near me" searches across your neighbourhoods.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-ai.webp');">
          <div class="service-detail-card__content">
            <h3>Programme Keyword Clusters</h3>
            <p>Coding and STEM, creative writing, abacus and mental math, public speaking and phonics each have their own search landscape. Every programme gets its own page and ranking strategy.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-graphic-design.webp');">
          <div class="service-detail-card__content">
            <h3>Age &amp; Level Targeting</h3>
            <p>"Phonics class for toddlers" and "creative writing for Primary 3" are parents ready to enquire. We optimise across preschool, lower primary and upper primary levels.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-speed-vitals.webp');">
          <div class="service-detail-card__content">
            <h3>Content Built for Research Mode</h3>
            <p>Guides answering "what age to start coding" or "how to choose a speech and drama class" — earning authority and traffic from parents still deciding.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHY US ========== -->
  <section class="section" id="why-us" aria-label="Why choose Jraft Creative as your enrichment centre SEO agency">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2>An <span class="highlight">SEO Agency</span> That Understands <span class="highlight">Enrichment Centres</span></h2>
      </div>
      <div class="section-content reveal">
        <p>We work with education providers across Singapore that need to rank for dozens of programme, neighbourhood and age combinations.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Built Around Enrolment, Not Traffic</h3>
            <p>Rankings only matter if enquiries come in. We optimise the path from search result to enrolment enquiry, not just the position on the page.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Transparent Monthly Reporting</h3>
            <p>Rankings by programme, organic traffic, Google Business Profile performance and enquiry data. No jargon, just whether more parents are finding you.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Website, SEO &amp; Ads Together</h3>
            <p>We handle <a href="/enrichment-centre-website-singapore/">enrichment centre web design</a> and <a href="/enrichment-centre-google-ads-singapore/">Google Ads</a> under one roof — one system for enrolment enquiries.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== ENROLMENT FUNNEL ========== -->
  <section class="section" id="buyer-funnel" style="background: var(--bg-alt);" aria-label="Where SEO fits the enrichment parent journey">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Enrolment Funnel</p>
        <h2>Where <span class="highlight">Organic Search</span> Fits the <span class="highlight">Parent Journey</span></h2>
      </div>
      <div class="section-content reveal" style="margin-bottom: 24px;">
        <p>Parents move through the same five stages before a child starts a programme. SEO owns the earliest and the most repeated moments — Discover, when the first programme search happens, and Validate, when a parent checks whether your teachers and reviews are credible.</p>
      </div>
      <ol class="renovation-funnel reveal">
        <li class="funnel-stage">
          <h3>Discover</h3>
          <p>Organic results catch the first programme search</p>
        </li>
        <li class="funnel-stage">
          <h3>Validate</h3>
          <p>Teacher profiles, class details, Google reviews</p>
        </li>
        <li class="funnel-stage">
          <h3>Compare</h3>
          <p>Shortlist centres within travel distance</p>
        </li>
        <li class="funnel-stage">
          <h3>Trial</h3>
          <p>Programme pages turn the shortlist into a booking</p>
        </li>
        <li class="funnel-stage">
          <h3>Enrol</h3>
          <p>Sign for the term, renew &amp; refer</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ========== PRICING ========== -->
  <!-- ========== FAQ ========== -->
  <section class="section faq-section" id="faq" style="background: var(--bg-alt);" aria-label="Frequently asked questions about enrichment centre SEO in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">FAQ</p>
        <h2>Enrichment Centre <span class="highlight">SEO</span> — Questions Answered</h2>
      </div>
      <div class="faq-list">
        <details class="faq-item reveal reveal-d1">
          <summary>How much does SEO cost for an enrichment centre in Singapore?</summary>
          <div class="faq-answer"><p>Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>How long does it take for enrichment centre SEO to produce results?</summary>
          <div class="faq-answer"><p>Most enrichment centres see measurable improvements in search rankings within 3 to 5 months. Programme-specific and neighbourhood searches like "coding class for kids Tampines" or "speech and drama Bishan" can rank faster than broad competitive terms. Google Business Profile optimisation often delivers quick visibility gains in the first few weeks.</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>What keywords do parents search for when looking for enrichment classes?</summary>
          <div class="faq-answer"><p>Common searches include "enrichment centre near me", "coding class for kids Singapore", "speech and drama Tampines", "creative writing enrichment Bishan", "abacus class near me", and age-specific terms like "phonics class for toddlers". We research the exact keywords parents in your area are using and target the programmes you actually run.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>Can SEO help parents find my enrichment centre on Google Maps?</summary>
          <div class="faq-answer"><p>Yes. Local SEO and Google Business Profile optimisation are core parts of our work. We optimise your listing with accurate class details, photos, parent reviews, and location data so your centre appears in the Google Maps three-pack when parents search "enrichment centre near me" in Bukit Timah, Jurong East, Punggol, or wherever you operate.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>Do you handle SEO for enrichment centres with multiple branches?</summary>
          <div class="faq-answer"><p>Yes. We create unique location pages for each branch, optimise separate Google Business Profiles, and build neighbourhood-specific content so every centre ranks in its own area. Whether you run two outlets or ten across Singapore — Woodlands, Ang Mo Kio, Tampines and beyond — each location gets targeted visibility where its families live.</p></div>
        </details>
      </div>
    </div>
  </section>


  <!-- Related Services -->
  <section class="section" id="related-services" aria-label="Related services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Explore More</p>
        <h2>More <span class="highlight">Enrichment Centre</span> Services</h2>
      </div>
      <div class="related-services-grid reveal">
          <a href="/enrichment-centre-marketing-singapore/" class="related-service-link">Enrichment Centre Marketing</a>
          <a href="/enrichment-centre-ai-search-optimisation-singapore/" class="related-service-link">Enrichment Centre GEO</a>
          <a href="/enrichment-centre-google-ads-singapore/" class="related-service-link">Enrichment Centre Google Ads</a>
          <a href="/enrichment-centre-social-media-singapore/" class="related-service-link">Enrichment Centre Social Media</a>
          <a href="/enrichment-centre-branding-singapore/" class="related-service-link">Enrichment Centre Branding</a>
          <a href="/enrichment-centre-website-singapore/" class="related-service-link">Enrichment Centre Websites</a>
      </div>
    </div>
  </section>
</ServiceLayout>
