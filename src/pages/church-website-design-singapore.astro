---
import ServiceLayout from '../layouts/ServiceLayout.astro';
import RelatedServices from '../components/RelatedServices.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Church Website Design Singapore",
    "description": "Website design for churches and places of worship in Singapore. Service times, sermon media, event calendars, online giving, and ministry pages.",
    "provider": {
      "@type": "Organization",
      "name": "Jraft Creative",
      "url": "https://jraftcreative.com/",
      "logo": "https://jraftcreative.com/images/logo.png",
      "telephone": "+6582234578",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "60 Paya Lebar Road, Paya Lebar Square",
        "postalCode": "409051",
        "addressLocality": "Singapore",
        "addressCountry": "SG"
      }
    },
    "areaServed": { "@type": "Country", "name": "Singapore" },
    "serviceType": "Church Website Design"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How much does a church website cost in Singapore?", "acceptedAnswer": { "@type": "Answer", "text": "It depends on your congregation's needs and the scope of the site — service pages, sermon media, an event calendar, online giving, and how much your team wants to manage themselves. There's no one-size package. Book a friendly consultation and we'll scope exactly what your church needs and share a clear quote." } },
      { "@type": "Question", "name": "Can you add online giving to our church website?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We build secure giving pages with the payment options Singapore congregations use — PayNow, card, and bank transfer — and support one-time gifts, recurring giving, and designated funds for missions or building projects. We connect it to a trusted provider so members can give in a few taps." } },
      { "@type": "Question", "name": "Will the website include a sermon archive?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We build sermon media pages that organise recordings by date, speaker, series, or Scripture reference. Members can listen to audio, watch video, and download notes, and we can connect live streaming so people who can't attend in person can still worship with you." } },
      { "@type": "Question", "name": "Can you build an event calendar with registration?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We create a calendar for services, retreats, camps, prayer meetings, and community events. Members can view details and register online, which cuts down on manual sign-ups over WhatsApp and gives your admin team a clear headcount before the day." } },
      { "@type": "Question", "name": "Is the website easy for our volunteers to update?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Your staff and volunteers shouldn't need a developer to post a sermon or change a service time. We build clear, simple content areas your team can manage themselves, and we hand over a short walkthrough so someone on your team feels confident from day one." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "Church Website Design Singapore", "item": "https://jraftcreative.com/church-website-design-singapore/" }
    ]
  }
];
---

<style is:global>
  /* Hide the global background grid pattern on this page only */
  .animated-bg__grid { display: none; }

  /* More-prominent related-service pills — match challenge-card-v2 green treatment */
  #related-services .related-service-link {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.35);
    color: var(--text);
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  #related-services .related-service-link:hover {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.22) 0%, rgba(73, 184, 137, 0.1) 100%), rgba(20, 28, 32, 0.7);
    border-color: rgba(73, 184, 137, 0.6);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(73, 184, 137, 0.3);
  }

  /* Separate the CTA section from related-services with bg-alt */
  .service-cta-section {
    background: var(--bg-alt) !important;
  }

  /* Enrolment Funnel — 5-stage horizontal flow with green accents */
  .renovation-funnel {
    list-style: none;
    padding: 0;
    margin: 56px 0 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 48px;
    counter-reset: funnel;
  }
  .funnel-stage {
    position: relative;
    text-align: center;
    padding: 28px 20px;
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.28);
    border-radius: 12px;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .funnel-stage:hover {
    transform: translateY(-4px);
    border-color: rgba(73, 184, 137, 0.55);
    box-shadow: 0 16px 40px -16px rgba(73, 184, 137, 0.3);
  }
  .funnel-stage h3 {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--accent);
    margin: 0 0 8px 0;
    letter-spacing: -0.01em;
  }
  .funnel-stage p {
    font-size: 0.82rem;
    color: var(--text);
    line-height: 1.5;
    margin: 0;
  }
  .funnel-stage:not(:last-child)::after {
    content: '→';
    position: absolute;
    right: -34px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--accent);
    font-size: 1.6rem;
    font-weight: 500;
    z-index: 2;
    line-height: 1;
    opacity: 0.7;
  }
  @media (max-width: 900px) {
    .renovation-funnel {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }
    .funnel-stage:nth-child(2n)::after,
    .funnel-stage:last-child::after {
      display: none;
    }
    .funnel-stage:nth-child(2n-1)::after {
      right: -22px;
    }
  }
  @media (max-width: 600px) {
    .renovation-funnel {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .funnel-stage::after {
      display: none;
    }
  }
</style>

<ServiceLayout
  title="Church Website Design Singapore — Jraft Creative"
  description="Website design for churches in Singapore. Service times, sermon media, event calendars, online giving, and ministry pages built for your congregation."
  canonical="https://jraftcreative.com/church-website-design-singapore/"
  ogTitle="Church Website Design Singapore — Jraft Creative"
  ogDescription="Website design for churches in Singapore. Service times, sermon media, event calendars, online giving, and ministry pages built for your congregation."
  ogImage="https://jraftcreative.com/images/og-webdev.jpg"
  keywords="church website design singapore, church web design singapore, ministry website singapore, religious organisation website, online giving church singapore, sermon archive website, Jraft Creative"
  schemaData={schemaData}
  heroLabel="Church Website Design"
  heroTitle='Website Design for <span class="highlight">Churches in Singapore</span>'
  heroSubtitle="Your congregation deserves more than a Facebook group. We build warm, welcoming websites for churches and places of worship — with service times, sermon media, event calendars, and online giving that keep your community connected all week."
  heroImage="/images/service-church.webp"
  heroImageAlt="Church website in Singapore"
  heroButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "See Our Work", href: "/about/", class: "btn btn-secondary" }
  ]}
  whatsappText="Hi Jraft Creative, I need a website for my church in Singapore."
  ctaLabel="Ready to Get Started?"
  ctaTitle="Bring Your Church Online"
  ctaDescription="Book a free consultation and tell us about your church. We'll get back to you within 24 hours with a tailored proposal — whether you're a new church plant, an established congregation, or a multi-campus ministry."
  ctaButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%20need%20a%20website%20for%20my%20church%20in%20Singapore.", class: "btn btn-secondary" }
  ]}
  hideDefaultCta={false}
>

  <!-- ========== THE CHALLENGE ========== -->
  <section class="section" id="challenge" aria-label="Why churches in Singapore need a proper website">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Challenge</p>
        <h2>Your Members Are <span class="highlight">Looking Online</span> — What Do They <span class="highlight">Find?</span></h2>
      </div>
      <div class="section-content reveal">
        <p>When someone searches "church near Jurong" or "Sunday service times Singapore", they want the basics in seconds — when you gather, where you are, and what to expect on a first visit. Too many congregations still live on a Facebook group and WhatsApp broadcasts, so a newcomer lands on an outdated listing with no clear next step. A proper website answers those questions warmly, before anyone has to ask.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Scattered Across Social Feeds</h3>
            <p>Service times sit in one Facebook post, sermons in another, event details buried in a WhatsApp thread. A visitor has to hunt for the essentials, and most give up before they find them. Without a home base online, your church's presence is only as current as the last person who remembered to post.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Newcomers Can't Find the Basics</h3>
            <p>A first-time visitor is often nervous. They want to know the service times, where to park, what to wear, and whether there's something for their children — before they ever walk through the door. When those answers aren't easy to find, that first step feels harder than it should, and many quietly decide to stay home.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Volunteers Fielding the Same Questions</h3>
            <p>Members want to re-watch last week's sermon, sign up for a retreat, or give their tithe online. Without a website, each of these becomes a separate message to the church office. Volunteers spend hours answering questions a well-built site could handle on its own, all week and after hours.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHAT WE DELIVER ========== -->
  <section class="section" id="sub-services" style="background: var(--bg-alt);" aria-label="Church website design deliverables">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">What We Deliver</p>
        <h2>Six <span class="highlight">Pillars</span> of a Church <span class="highlight">Website</span></h2>
      </div>
      <div class="section-content reveal">
        <p>A church website isn't a storefront and it isn't a generic brochure — it's a digital extension of your ministry. We design every element around the way Singapore congregations actually gather: welcoming newcomers, serving members through the week, and reflecting your church's heart. If you're weighing what makes a site genuinely useful, our guide to a <a href="/blog/good-business-website-singapore/">good website in Singapore</a> is a helpful starting point. Pair the build with <a href="/services/website-development/">website development</a> and ongoing <a href="/services/social-media/">social media</a> to keep your community connected between Sundays.</p>
      </div>
      <div class="service-details-grid deliver-grid">
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-business-website.webp');">
          <div class="service-detail-card__content">
            <h3>Service Times &amp; Visitor Info</h3>
            <p>A clear, welcoming home for the essentials — service times, location and parking, what to expect, and what's on for children and families. The reassuring first-visit details that help a nervous newcomer feel invited, front and centre where they'll actually see them.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-onpage-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Sermon Media &amp; Archive</h3>
            <p>Give your congregation access to past teachings organised by date, speaker, series, or Scripture reference. Audio playback, video embeds, and downloadable notes — with live streaming connected so members who can't attend in person can still worship along.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-graphic-design.webp');">
          <div class="service-detail-card__content">
            <h3>Event Calendar &amp; Registration</h3>
            <p>List services, retreats, camps, prayer meetings, and community events in one calendar. Members view details and register online, which cuts down on manual sign-ups and gives your admin team a clear headcount well before the day arrives.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-local-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Online Giving &amp; Donations</h3>
            <p>Make tithes and offerings simple with secure giving pages. We integrate PayNow, card, and bank transfer, with support for one-time gifts, recurring giving, and designated funds for missions or building projects — all in a few taps.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-ai.webp');">
          <div class="service-detail-card__content">
            <h3>Ministry &amp; Community Pages</h3>
            <p>Showcase your ministries — youth, children, worship, small groups, missions — with pages that explain what each one does, when they meet, and how to get involved. Help newcomers find their place and take a first step into the life of the church.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-speed-vitals.webp');">
          <div class="service-detail-card__content">
            <h3>Mobile Speed &amp; Core Web Vitals</h3>
            <p>People search for a church on their phones, often on the way somewhere. Every site is built mobile-first and tuned for fast load times and strong Core Web Vitals, so your pages are ready the moment a visitor arrives and easy for your team to keep current.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHY CHOOSE US ========== -->
  <section class="section" id="why-us" aria-label="Why choose Jraft Creative for church website design">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2>A <span class="highlight">Web Partner</span> That Understands <span class="highlight">Church Life</span></h2>
      </div>
      <div class="section-content reveal">
        <p>A church website isn't a commercial storefront — it's a way to welcome visitors, serve members, and share your mission clearly. Every design decision we make is guided by that, so the finished site feels like your church and works the way your church actually runs.</p>
      </div>
      <div class="service-details-grid" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>We Design Around Church Rhythms</h3>
            <p>Churches operate differently from businesses. We build around the rhythms of church life — weekly services, seasonal events, ministry sign-ups, and giving seasons — so your website supports the way your congregation gathers rather than fighting against it.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Warm &amp; Welcoming, Never Salesy</h3>
            <p>You're building a community, not selling a product. We write and design with a warm, welcoming tone that reflects your church's heart, making it genuinely easy for a newcomer to learn about your beliefs, find a service, and take a first step.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Easy for Your Team to Run</h3>
            <p>Your staff and volunteers shouldn't need a developer to post a sermon or change a service time. We build clear, simple content areas your team can manage, and we handle SEO, social, and more in-house so leadership can focus on the congregation.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== THE VISITOR JOURNEY ========== -->
  <section class="section" id="buyer-funnel" style="background: var(--bg-alt);" aria-label="The Visitor Journey — where your website fits the newcomer's path">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Visitor Journey</p>
        <h2>Where Your <span class="highlight">Website</span> Fits the <span class="highlight">Newcomer's Path</span></h2>
      </div>
      <div class="section-content reveal" style="margin-bottom: 24px;">
        <p>Most people who find their way to a church in Singapore move through the same five stages before they truly belong. Your website walks alongside them from the first search to a settled place in the community — and keeps members connected at every step.</p>
      </div>
      <ol class="renovation-funnel reveal">
        <li class="funnel-stage">
          <h3>Discover</h3>
          <p>Google search, Maps, a friend's invite</p>
        </li>
        <li class="funnel-stage">
          <h3>Explore</h3>
          <p>Service times, beliefs &amp; sermons</p>
        </li>
        <li class="funnel-stage">
          <h3>Visit</h3>
          <p>Plan a first Sunday with confidence</p>
        </li>
        <li class="funnel-stage">
          <h3>Connect</h3>
          <p>Join a ministry or small group</p>
        </li>
        <li class="funnel-stage">
          <h3>Belong</h3>
          <p>Give, serve &amp; grow together</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ========== FAQ ========== -->
  <section class="section faq-section" id="faq" style="background: var(--bg-alt);" aria-label="Frequently asked questions about church website design in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">FAQ</p>
        <h2>Church Website <span class="highlight">Questions Answered</span></h2>
      </div>
      <div class="faq-list">
        <details class="faq-item reveal reveal-d1">
          <summary>How much does a church website cost in Singapore?</summary>
          <div class="faq-answer"><p>It depends on your congregation's needs and the scope of the site — service pages, sermon media, an event calendar, online giving, and how much your team wants to manage themselves. There's no one-size package. Book a friendly consultation and we'll scope exactly what your church needs and share a clear quote.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>Can you add online giving to our church website?</summary>
          <div class="faq-answer"><p>Yes. We build secure giving pages with the payment options Singapore congregations use — PayNow, card, and bank transfer — and support one-time gifts, recurring giving, and designated funds for missions or building projects. We connect it to a trusted provider so members can give in a few taps.</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>Will the website include a sermon archive?</summary>
          <div class="faq-answer"><p>Yes. We build sermon media pages that organise recordings by date, speaker, series, or Scripture reference. Members can listen to audio, watch video, and download notes, and we can connect live streaming so people who can't attend in person can still worship with you.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>Can you build an event calendar with registration?</summary>
          <div class="faq-answer"><p>Yes. We create a calendar for services, retreats, camps, prayer meetings, and community events. Members can view details and register online, which cuts down on manual sign-ups over WhatsApp and gives your admin team a clear headcount before the day.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>Is the website easy for our volunteers to update?</summary>
          <div class="faq-answer"><p>Yes. Your staff and volunteers shouldn't need a developer to post a sermon or change a service time. We build clear, simple content areas your team can manage themselves, and we hand over a short walkthrough so someone on your team feels confident from day one.</p></div>
        </details>
      </div>
    </div>
  </section>


  <RelatedServices topic="website" />

</ServiceLayout>
