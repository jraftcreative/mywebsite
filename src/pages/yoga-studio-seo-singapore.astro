---
import ServiceLayout from '../layouts/ServiceLayout.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Yoga Studio SEO Singapore",
    "description": "SEO services for yoga studios in Singapore. Local SEO, Google Business Profile optimisation, class-specific keyword strategy, and content marketing to fill your mat spaces",
    "provider": {
      "@type": "Organization",
      "name": "Jraft Creative",
      "url": "https://jraftcreative.com/",
      "logo": "https://jraftcreative.com/images/logo.png",
      "telephone": "+6582234578",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "60 Paya Lebar Road, Paya Lebar Square",
        "postalCode": "409051",
        "addressLocality": "Singapore",
        "addressCountry": "SG"
      }
    },
    "areaServed": { "@type": "Country", "name": "Singapore" },
    "serviceType": "Yoga Studio SEO"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How much does SEO cost for a yoga studio in Singapore?", "acceptedAnswer": { "@type": "Answer", "text": "Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote." } },
      { "@type": "Question", "name": "How long does it take for yoga studio SEO to show results?", "acceptedAnswer": { "@type": "Answer", "text": "Most yoga studios see measurable ranking improvements within 3 to 4 months. Google Business Profile optimisation and technical fixes can produce quick wins in weeks. Location-specific keywords like 'yoga studio Bugis' or 'hot yoga Tanjong Pagar' often rank faster than broad national terms." } },
      { "@type": "Question", "name": "Can SEO help my yoga studio rank in Google Maps?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Google Business Profile optimisation and local SEO are central to our yoga studio SEO service. We optimise your listing categories, upload studio photos, manage student reviews, and build local citations so your studio appears in the Maps 3-pack for 'yoga near me' searches in your area." } },
      { "@type": "Question", "name": "What keywords do people search when looking for yoga in Singapore?", "acceptedAnswer": { "@type": "Answer", "text": "Common search terms include 'yoga near me', 'hot yoga Singapore', 'yoga studio Bugis', 'prenatal yoga near me', 'vinyasa class near me', and style-specific queries like 'yin yoga Singapore' or 'aerial yoga class'. We research the exact terms driving sign-ups in your area and build your SEO strategy around them." } },
      { "@type": "Question", "name": "Do you work with yoga studios that have multiple locations?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Multi-studio yoga SEO is a core capability. We create unique, optimised location pages for each branch, manage individual Google Business Profiles, build location-specific citations, and ensure consistent NAP data across all directories so each studio ranks independently in its own neighbourhood." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "Yoga Studio SEO Singapore", "item": "https://jraftcreative.com/yoga-studio-seo-singapore/" }
    ]
  }
];
---

<style is:global>
  /* Hide the global background grid pattern on this page only */
  .animated-bg__grid { display: none; }

  /* More-prominent related-service pills — match challenge-card-v2 green treatment */
  #related-services .related-service-link {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.35);
    color: var(--text);
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  #related-services .related-service-link:hover {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.22) 0%, rgba(73, 184, 137, 0.1) 100%), rgba(20, 28, 32, 0.7);
    border-color: rgba(73, 184, 137, 0.6);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(73, 184, 137, 0.3);
  }

  /* Separate the CTA section from related-services with bg-alt */
  .service-cta-section {
    background: var(--bg-alt) !important;
  }

  /* Force even service card grid on desktop per locked landing-page pattern */
  #sub-services .deliver-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }
  @media (max-width: 900px) {
    #sub-services .deliver-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 600px) {
    #sub-services .deliver-grid { grid-template-columns: 1fr; }
  }

  /* Yoga SEO Flow — horizontal process flow with green accents */
  .renovation-funnel {
    list-style: none;
    padding: 0;
    margin: 56px 0 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 48px;
    counter-reset: funnel;
  }
  .funnel-stage {
    position: relative;
    text-align: center;
    padding: 28px 20px;
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.28);
    border-radius: 12px;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .funnel-stage:hover {
    transform: translateY(-4px);
    border-color: rgba(73, 184, 137, 0.55);
    box-shadow: 0 16px 40px -16px rgba(73, 184, 137, 0.3);
  }
  .funnel-stage h3 {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--accent);
    margin: 0 0 8px 0;
    letter-spacing: -0.01em;
  }
  .funnel-stage p {
    font-size: 0.82rem;
    color: var(--text);
    line-height: 1.5;
    margin: 0;
  }
  .funnel-stage:not(:last-child)::after {
    content: '→';
    position: absolute;
    right: -34px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--accent);
    font-size: 1.6rem;
    font-weight: 500;
    z-index: 2;
    line-height: 1;
    opacity: 0.7;
  }
  @media (max-width: 900px) {
    .renovation-funnel {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }
    .funnel-stage:nth-child(2n)::after,
    .funnel-stage:last-child::after {
      display: none;
    }
    .funnel-stage:nth-child(2n-1)::after {
      right: -22px;
    }
  }
  @media (max-width: 600px) {
    .renovation-funnel {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .funnel-stage::after {
      display: none;
    }
  }
</style>

<ServiceLayout
  title="Yoga Studio SEO Singapore — Jraft Creative"
  description="SEO services for yoga studios in Singapore. Local SEO, Google Business Profile optimisation, class-specific landing pages."
  canonical="https://jraftcreative.com/yoga-studio-seo-singapore/"
  ogTitle="Yoga Studio SEO Singapore — Jraft Creative"
  ogDescription="SEO for yoga studios in Singapore. Local search optimisation, Google Maps ranking, and class-specific content to drive sign-ups."
  ogImage="https://jraftcreative.com/images/og-yoga.jpg"
  keywords="yoga studio seo singapore, yoga seo, seo for yoga studios, hot yoga seo, vinyasa yoga seo, yoga google ranking, yoga local seo, yoga marketing singapore, Jraft Creative"
  schemaData={schemaData}
  heroLabel="Yoga Studio SEO"
  heroTitle='SEO for <span class="highlight">Yoga Studios in Singapore</span>'
  heroSubtitle="When someone searches 'yoga near me' or 'hot yoga Singapore', they book from the studios ranking on page one and in the Maps 3-pack. It's rarely the studio with the best teachers — it's the one that shows up first. We get your studio there."
  heroImage="/images/service-yoga.webp"
  heroButtons={[
    { text: "Get a Free SEO Audit", href: "/contact/", class: "btn btn-primary" },
    { text: "See How We Work", href: "/process/", class: "btn btn-secondary" }
  ]}
  whatsappText="Hi Jraft Creative, I need SEO for my yoga studio in Singapore."
  ctaLabel="Ready to Rank Higher?"
  ctaTitle="Get Your Yoga Studio Found on Google"
  ctaDescription="Book a free SEO audit and we'll show you exactly where your yoga studio stands in local search compared to nearby competitors. We'll respond within 24 hours."
  ctaButtons={[
    { text: "Get a Free SEO Audit", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%20need%20SEO%20for%20my%20yoga%20studio%20in%20Singapore.", class: "btn btn-secondary" }
  ]}
>

  <!-- ========== THE CHALLENGE ========== -->
  <section class="section" id="challenge" aria-label="SEO challenges for yoga studios in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Challenge</p>
        <h2>Singapore Has <span class="highlight">Hundreds of Studios</span> — Can Students <span class="highlight">Find Yours</span>?</h2>
      </div>
      <div class="section-content reveal">
        <p>Great teachers and a beautiful space count for nothing if you're invisible the moment someone searches for a class near them. Most studios lean on Instagram and ClassPass — channels they don't own — while the students ready to book today go to whoever ranks first on Google.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>The "Yoga Near Me" Moment</h3>
            <p>Someone searching "hot yoga Singapore" or "vinyasa class near me" wants to book their first class this week. If you're not in the top results and the Maps 3-pack, that trial goes to the studio that is.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>The Map-Pack Shutout</h3>
            <p>Most studios have a lovely space but thin online visibility. Without an optimised Google Business Profile and local signals, you never enter the 3-pack where "yoga near me" bookings are decided.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>The Marketplace Margin Trap</h3>
            <p>Left off page one, studios rely on ClassPass and discount platforms just to stay visible. Every booking gets a cut taken out, and your brand sits alongside a dozen competitors on the same tile.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== SERVICES ========== -->
  <section class="section" id="sub-services" style="background: var(--bg-alt);" aria-label="SEO services for yoga studios">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Our SEO Services</p>
        <h2>SEO Built for <span class="highlight">Yoga Studios</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Yoga SEO is a specialist job. Students search by style, experience level, and neighbourhood — vinyasa, hatha, hot, yin, prenatal, aerial, power, ashtanga — creating dozens of keyword combinations that each need their own page and local signals. We build around exactly how Singapore residents look for and choose a studio.</p>
        <p>Pair SEO with a purpose-built <a href="/yoga-studio-website-singapore/">yoga studio website</a>, <a href="/yoga-studio-social-media-singapore/">social media</a> to grow your community, or <a href="/yoga-studio-google-ads-singapore/">Google Ads</a> to capture demand during the New Year and post-holiday rush.</p>
      </div>
      <div class="service-details-grid deliver-grid">
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-seo-audit.webp');">
          <div class="service-detail-card__content">
            <h3>Technical SEO Audit</h3>
            <p>A full crawl to fix indexing gaps, broken links, missing schema, and slow mobile loads — the technical barriers stopping Google from ranking your studio.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-onpage-seo.webp');">
          <div class="service-detail-card__content">
            <h3>On-Page Optimisation</h3>
            <p>Keyword-optimised pages for every style — vinyasa, hatha, hot, yin, prenatal, aerial, power, ashtanga — targeting searches like "hot yoga Tanjong Pagar" and "prenatal yoga near me".</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-local-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Local SEO &amp; Google Business Profile</h3>
            <p>Correct categories, class schedules, studio photos, review management, and local citations that put you in the Maps 3-pack for every "yoga studio Bugis" search in your area.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-speed-vitals.webp');">
          <div class="service-detail-card__content">
            <h3>Class-Focused Content</h3>
            <p>Guides answering what students actually search — "hot yoga vs regular yoga", "best yoga for back pain" — that build authority and capture them while they're deciding.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHY CHOOSE US ========== -->
  <section class="section" id="why-us" aria-label="Why choose Jraft Creative for yoga studio SEO">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2>An SEO Agency That <span class="highlight">Understands Yoga</span></h2>
      </div>
      <div class="section-content reveal">
        <p>We work with fitness and wellness businesses across Singapore — we know class-based booking, peak and off-peak demand, and which searches actually convert into members who keep coming back to the mat.</p>
      </div>
      <div class="service-details-grid" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Yoga Industry Knowledge</h3>
            <p>We know the difference between vinyasa, hatha, ashtanga, and yin — and which styles drive real search volume here. Strategy tailored to how yoga students search, not a generic fitness template.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Neighbourhood-Level Local SEO</h3>
            <p>Yoga is hyper-local. We optimise for the MRT-radius searches — Tanjong Pagar, Bugis, Tiong Bahru, Holland Village, Novena, Katong — so you rank where your ideal students live and work.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>One Agency, All Channels</h3>
            <p>SEO is one piece. We also handle your website, social, and paid ads — so every channel works together to fill classes, instead of pulling in different directions.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== SEO FLOW ========== -->
  <section class="section" id="seo-flow" style="background: var(--bg-alt);" aria-label="How yoga studio SEO works">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">How It Works</p>
        <h2>How Yoga SEO <span class="highlight">Fills Your Classes</span></h2>
      </div>
      <div class="section-content reveal" style="margin-bottom: 24px;">
        <p>From first audit to booked trials, we run the same four-step system on every yoga studio we take on — and report the numbers that tie back to sign-ups.</p>
      </div>
      <ol class="renovation-funnel reveal">
        <li class="funnel-stage">
          <h3>Audit</h3>
          <p>Technical and local audit of where you rank today</p>
        </li>
        <li class="funnel-stage">
          <h3>Optimise</h3>
          <p>Style pages, on-page, and site speed fixed</p>
        </li>
        <li class="funnel-stage">
          <h3>Localise</h3>
          <p>GBP and citations built for the Maps 3-pack</p>
        </li>
        <li class="funnel-stage">
          <h3>Rank &amp; Report</h3>
          <p>Rankings, traffic, and bookings tracked monthly</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ========== FAQ ========== -->
  <section class="section faq-section" id="faq" aria-label="Frequently asked questions about yoga studio SEO in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">FAQ</p>
        <h2><span class="highlight">Yoga Studio SEO</span> — Questions <span class="highlight">Answered</span></h2>
      </div>
      <div class="faq-list">
        <details class="faq-item reveal reveal-d1">
          <summary>How much does SEO cost for a yoga studio in Singapore?</summary>
          <div class="faq-answer"><p>Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>How long does it take for yoga studio SEO to show results?</summary>
          <div class="faq-answer"><p>Most yoga studios see measurable ranking improvements within 3 to 4 months. Google Business Profile optimisation and technical fixes can produce quick wins in weeks. Location-specific keywords like "yoga studio Bugis" or "hot yoga Tanjong Pagar" often rank faster than broad competitive terms like "yoga Singapore".</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>Can SEO help my yoga studio rank in Google Maps?</summary>
          <div class="faq-answer"><p>Yes. Google Business Profile optimisation and local SEO are central to our yoga studio SEO service. We optimise your listing categories, upload studio photos, manage student reviews, and build local citations so your studio appears in the Maps 3-pack for "yoga near me" searches in your neighbourhood.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>What keywords do people search when looking for yoga in Singapore?</summary>
          <div class="faq-answer"><p>Common search terms include "yoga near me", "hot yoga Singapore", "yoga studio Bugis", "prenatal yoga near me", "vinyasa class near me", and style-specific queries like "yin yoga Singapore" or "aerial yoga class". We research the exact terms driving bookings in your area and build your SEO strategy around them.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>Do you work with yoga studios that have multiple locations?</summary>
          <div class="faq-answer"><p>Yes. Multi-studio yoga SEO is a core capability. We create unique, optimised location pages for each branch, manage individual Google Business Profiles, build location-specific citations, and ensure consistent NAP data across all directories so each studio ranks independently in its own neighbourhood.</p></div>
        </details>
      </div>
    </div>
  </section>


  <!-- Related Services -->
  <section class="section" id="related-services" aria-label="Related services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Explore More</p>
        <h2>More Yoga Studio Services</h2>
      </div>
      <div class="related-services-grid reveal">
          <a href="/yoga-studio-marketing-singapore/" class="related-service-link">Yoga Studio Marketing</a>
          <a href="/yoga-studio-geo-singapore/" class="related-service-link">Yoga Studio GEO</a>
          <a href="/yoga-studio-google-ads-singapore/" class="related-service-link">Yoga Studio Google Ads</a>
          <a href="/yoga-studio-social-media-singapore/" class="related-service-link">Yoga Studio Social Media</a>
          <a href="/yoga-studio-branding-singapore/" class="related-service-link">Yoga Studio Branding</a>
          <a href="/yoga-studio-website-singapore/" class="related-service-link">Yoga Studio Websites</a>
      </div>
    </div>
  </section>
</ServiceLayout>
</content>
</invoke>
