---
import ServiceLayout from '../../layouts/ServiceLayout.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "SEO & Performance Optimisation",
    "description": "Professional SEO services in Singapore including technical SEO audits, on-page optimisation, speed and Core Web Vitals, analytics and reporting, and local SEO.",
    "provider": {
      "@type": "Organization",
      "name": "Jraft Creative",
      "url": "https://jraftcreative.com/",
      "logo": "https://jraftcreative.com/images/logo.png",
      "telephone": "+6582234578",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "60 Paya Lebar Road, Paya Lebar Square",
        "postalCode": "409051",
        "addressLocality": "Singapore",
        "addressCountry": "SG"
      }
    },
    "areaServed": { "@type": "Country", "name": "Singapore" },
    "serviceType": "Search Engine Optimisation"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How long does SEO take to show results?", "acceptedAnswer": { "@type": "Answer", "text": "SEO is a long-term strategy. Most businesses start seeing noticeable improvements in organic traffic within 3–6 months. Competitive keywords may take longer, but quick wins like fixing technical issues can show results within weeks." } },
      { "@type": "Question", "name": "Can you guarantee first page rankings?", "acceptedAnswer": { "@type": "Answer", "text": "No legitimate SEO agency can guarantee specific rankings — Google's algorithm considers hundreds of factors. What we guarantee is a data-driven approach, transparent reporting, and continuous optimisation to improve your search visibility over time." } },
      { "@type": "Question", "name": "What's included in the monthly SEO report?", "acceptedAnswer": { "@type": "Answer", "text": "Our reports cover keyword rankings, organic traffic trends, top-performing pages, backlink profile, Core Web Vitals scores, and actionable recommendations. Reporting cadence and strategy-call frequency are scoped to your engagement on the discovery call." } },
      { "@type": "Question", "name": "How is SEO different from paid ads?", "acceptedAnswer": { "@type": "Answer", "text": "SEO drives free organic traffic by improving your site's visibility in search results — results compound over time. Paid ads deliver immediate traffic but stop the moment you pause spending. Most businesses benefit from combining both strategies." } },
      { "@type": "Question", "name": "Do I need a new website before starting SEO?", "acceptedAnswer": { "@type": "Answer", "text": "Not necessarily. We can optimise most existing websites. However, if your site has serious technical issues, slow performance, or an outdated design, we may recommend improvements first. Our technical audit will identify exactly what needs fixing." } },
      { "@type": "Question", "name": "How much does an SEO agency cost in Singapore?", "acceptedAnswer": { "@type": "Answer", "text": "Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote." } },
      { "@type": "Question", "name": "How do I choose the best SEO agency in Singapore?", "acceptedAnswer": { "@type": "Answer", "text": "Look for four things: a clear, data-driven approach (not guaranteed-rankings promises — no legitimate agency can guarantee positions), transparent monthly reporting, real results you can verify, and whether they optimise for AI search (Google's AI Overview, ChatGPT, Gemini) rather than classic Google rankings alone. Ask for a free audit first so you can judge the thinking before you commit." } },
      { "@type": "Question", "name": "Do you optimise for AI search and Google's AI Overview (GEO)?", "acceptedAnswer": { "@type": "Answer", "text": "Yes — it is a core part of our SEO. Beyond classic Google rankings, we optimise so your business is cited in AI answers across Google's AI Overview, ChatGPT, Gemini and Perplexity. We practise what we sell: Jraft Creative got its own site cited in Google's AI Overview, and we apply the same GEO approach for clients." } },
      { "@type": "Question", "name": "What is SEO?", "acceptedAnswer": { "@type": "Answer", "text": "SEO — Search Engine Optimisation — is the practice of improving your website so it appears higher in unpaid Google results when people search for what you offer. It covers three areas: technical SEO (making the site fast and easy for Google to read), on-page SEO (making each page clearly relevant to a search), and off-page SEO (building the authority and links that earn trust). In 2026 it also means optimising to be cited in AI answers like Google's AI Overview." } },
      { "@type": "Question", "name": "Why is SEO important for a Singapore business?", "acceptedAnswer": { "@type": "Answer", "text": "Because most buying decisions in Singapore start with a search, and most searchers never look past page one. SEO puts you in front of people at the exact moment they're looking to buy — and unlike ads, the traffic doesn't stop when you stop paying. For local businesses, it also captures the 'near me' map-pack searches that drive walk-ins and calls." } },
      { "@type": "Question", "name": "Is SEO a short-term or long-term strategy?", "acceptedAnswer": { "@type": "Answer", "text": "Long-term. Technical fixes can produce quick wins in weeks, but building rankings and authority for competitive terms takes months and compounds over time. That's the trade-off versus paid ads: SEO is slower to start but keeps working — and getting cheaper per lead — the longer you invest. Anyone promising overnight rankings is selling something that won't last." } },
      { "@type": "Question", "name": "Should I invest in SEO or Google Ads?", "acceptedAnswer": { "@type": "Answer", "text": "Most businesses benefit from both. Google Ads buys immediate visibility while your SEO builds — useful at launch or for time-sensitive offers. SEO earns durable, compounding traffic that lowers your cost per lead over time. A common approach is ads for speed now, SEO for the long game, then shift the mix as your organic rankings climb. We'll advise the right split on the discovery call." } },
      { "@type": "Question", "name": "Are backlinks still important in 2026?", "acceptedAnswer": { "@type": "Answer", "text": "Yes — quality backlinks are still one of Google's strongest trust signals, and they increasingly influence which brands AI engines cite too. What's changed is that quality and relevance matter far more than volume. A handful of links from reputable, on-topic Singapore sources beats hundreds of cheap directory links, which can actively harm you. We build authority the durable way, not the spammy way." } },
      { "@type": "Question", "name": "What types of businesses do you do SEO for?", "acceptedAnswer": { "@type": "Answer", "text": "We run vertical-specific SEO across clinics and aesthetics, tuition and enrichment, preschools, F&B and restaurants, beauty and hair salons, spas, gyms and fitness studios, music schools, interior designers, and more. The signals that rank a clinic differ from those that rank a tuition centre, so we use industry-specific playbooks rather than a one-size template." } },
      { "@type": "Question", "name": "Do you do local SEO and Google Business Profile?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. For any business with a physical location or a service area, local SEO is often the fastest win. We optimise your Google Business Profile, build consistent local citations, set up a review strategy, and target the map pack for 'near me' and location-based searches — the highest-intent, closest-to-conversion traffic there is." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "Services" },
      { "@type": "ListItem", "position": 3, "name": "SEO & Performance", "item": "https://jraftcreative.com/services/seo-performance/" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "ImageObject",
    "url": "https://jraftcreative.com/images/service-seo-performance.webp",
    "caption": "Google search on a screen — SEO agency Singapore for technical SEO, on-page, local SEO and rankings.",
    "description": "Hero image for Jraft Creative's SEO and performance agency landing page in Singapore. Visual identity supporting the search engine optimisation service covering technical audits, on-page optimisation, local SEO, content, authority building and Core Web Vitals."
  }
];
---

<style is:global>
  /* Hide the global background grid pattern on this page only */
  .animated-bg__grid { display: none; }

  /* More-prominent related-service pills — match challenge-card-v2 green treatment */
  #related-services .related-service-link {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.35);
    color: var(--text);
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  #related-services .related-service-link:hover {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.22) 0%, rgba(73, 184, 137, 0.1) 100%), rgba(20, 28, 32, 0.7);
    border-color: rgba(73, 184, 137, 0.6);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(73, 184, 137, 0.3);
  }

  /* Separate the CTA section from related-services with bg-alt */
  .service-cta-section {
    background: var(--bg-alt) !important;
  }

  /* Force 3x2 grid on desktop for the deliver section per locked landing-page pattern */
  #sub-services .deliver-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }
  #sub-services {
    padding-top: 72px;
    padding-bottom: 72px;
  }
  @media (max-width: 900px) {
    #sub-services .deliver-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 600px) {
    #sub-services .deliver-grid {
      grid-template-columns: 1fr;
    }
  }

  /* AI Search Buyer Funnel — 5-stage horizontal flow with green accents */
  .renovation-funnel {
    list-style: none;
    padding: 0;
    margin: 56px 0 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 48px;
    counter-reset: funnel;
  }
  .funnel-stage {
    position: relative;
    text-align: center;
    padding: 28px 20px;
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.28);
    border-radius: 12px;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .funnel-stage:hover {
    transform: translateY(-4px);
    border-color: rgba(73, 184, 137, 0.55);
    box-shadow: 0 16px 40px -16px rgba(73, 184, 137, 0.3);
  }
  .funnel-stage h3 {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--accent);
    margin: 0 0 8px 0;
    letter-spacing: -0.01em;
  }
  .funnel-stage p {
    font-size: 0.82rem;
    color: var(--text);
    line-height: 1.5;
    margin: 0;
  }
  .funnel-stage:not(:last-child)::after {
    content: '→';
    position: absolute;
    right: -34px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--accent);
    font-size: 1.6rem;
    font-weight: 500;
    z-index: 2;
    line-height: 1;
    opacity: 0.7;
  }
  @media (max-width: 900px) {
    .renovation-funnel {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }
    .funnel-stage:nth-child(2n)::after,
    .funnel-stage:last-child::after {
      display: none;
    }
    .funnel-stage:nth-child(2n-1)::after {
      right: -22px;
    }
  }
  @media (max-width: 600px) {
    .renovation-funnel {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .funnel-stage::after {
      display: none;
    }
  }
</style>

<ServiceLayout
  title="SEO Agency Singapore — SEO & Performance | Jraft Creative"
  description="SEO agency in Singapore — technical audits, on-page optimisation, local SEO, and Core Web Vitals. Book a free SEO audit."
  canonical="https://jraftcreative.com/services/seo-performance/"
  ogTitle="SEO Agency Singapore — SEO & Performance | Jraft Creative"
  ogDescription="Technical SEO, on-page optimisation, local SEO, and performance monitoring. Book a free SEO audit and we'll come back with a tailored plan."
  ogImage="https://jraftcreative.com/images/og-seo.jpg"
  keywords="SEO agency singapore, SEO services singapore, technical SEO, on-page optimisation, local SEO, Google Business Profile, search engine optimisation, Jraft Creative"
  schemaData={schemaData}
  heroLabel="SEO Agency Singapore"
  heroTitle='SEO Agency &amp; Performance Optimisation <span class="highlight">in Singapore</span>'
  heroSubtitle="Jraft Creative is a Singapore SEO agency built for how search works now — technical, on-page, and local SEO, plus AI-search (GEO) optimisation. We got our own site cited in Google's AI Overview, and we do the same for clients: measurable rankings, traffic and leads."
  heroImage="/images/service-seo-performance.webp"
  heroImageAlt="Google search on a screen — SEO agency Singapore for technical SEO, on-page, local SEO and rankings"
  hideDefaultCta={false}
  heroButtons={[
    { text: "Get a Free SEO Audit", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%27d%20like%20to%20enquire%20about%20your%20SEO%20services.", class: "btn btn-secondary" }
  ]}
  whatsappText="Hi Jraft Creative, I'd like to enquire about your SEO services."
  ctaLabel="Ready to Get Started?"
  ctaTitle="Boost Your Search Rankings"
  ctaDescription="Book a free SEO consultation and get a complimentary site audit. We'll get back to you within 24 hours."
  ctaButtons={[
    { text: "Get a Free SEO Audit", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%27d%20like%20to%20enquire%20about%20your%20SEO%20services.", class: "btn btn-secondary" }
  ]}
>

  <!-- ========== WHAT IS SEO + OLD vs MODERN TABLE ========== -->
  <section class="section" id="what-is-seo" style="background: var(--bg-alt);" aria-label="What is SEO and what changed in 2026">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Basics</p>
        <h2>What Is <span class="highlight">SEO</span> — and What <span class="highlight">Changed in 2026</span>?</h2>
      </div>
      <div class="section-content reveal">
        <p>SEO (Search Engine Optimisation) is the work of getting your website to show up when someone in Singapore searches for what you sell — without paying for the click. Rank on page one and you capture high-intent traffic that compounds month after month. Sit on page two and, for most searches, you may as well not exist.</p>
        <p>What changed in 2026 is where the answer appears. Google now puts an AI Overview above the ten blue links, and a growing share of buyers ask ChatGPT or Perplexity instead of Googling at all. Modern SEO has to win all three — the classic rankings, the AI Overview, and the AI assistants. Here's the shift:</p>
      </div>
      <div class="comparison-table-wrap reveal">
        <table class="comparison-table">
          <thead>
            <tr><th>&nbsp;</th><th>Old-School SEO</th><th>Modern SEO (2026)</th></tr>
          </thead>
          <tbody>
            <tr><td>Goal</td><td>Rank in the 10 blue links</td><td>Rank in links, AI Overview, and AI assistants</td></tr>
            <tr><td>Content</td><td>Keyword-stuffed pages</td><td>Genuinely useful, answer-shaped content</td></tr>
            <tr><td>Wins by</td><td>Backlinks and exact-match keywords</td><td>Authority, entities, topical depth, real UX</td></tr>
            <tr><td>Speed</td><td>Nice to have</td><td>Core Web Vitals are a ranking factor</td></tr>
            <tr><td>Measured by</td><td>Rankings alone</td><td>Rankings, traffic, leads, and AI citations</td></tr>
            <tr><td>Blind spot</td><td>Ignores AI search entirely</td><td>Built for how people actually search now</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ========== THE CHALLENGE ========== -->
  <section class="section" id="challenge" aria-label="The SEO challenge SG businesses face">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Challenge</p>
        <h2>Invisible on Google Means <span class="highlight">Invisible to Customers</span> — and Most Sites Are <span class="highlight">Losing Ground Daily</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Most businesses in Singapore invest in a website but never see it appear on the first page of Google. Without proper SEO, your site is effectively invisible — losing qualified organic traffic to competitors who rank higher every single day.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Buried Below the Fold</h3>
            <p>Three-quarters of searchers never click past page one. If your target keywords put you on page two or lower, you are invisible to the customers actively looking for exactly what you sell — no matter how good your offer is.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>The Technical Debt Nobody Sees</h3>
            <p>Slow page speeds, missing meta data, broken schema, and poor site architecture quietly cap your rankings. These are the exact issues search engines penalise — and the exact issues a technical audit surfaces and fixes.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>No Local Footprint</h3>
            <p>Without Google Business Profile optimisation and local citations, you miss the map pack and every "near me" search in your area — the highest-intent, closest-to-conversion traffic there is.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== PROOF: WE RANK OUR OWN PAGES ========== -->
  <section class="section" id="proof" style="background: var(--bg-alt);" aria-label="Jraft Creative's own search rankings as proof">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Receipts</p>
        <h2>The Real Test of an SEO Agency: <span class="highlight">Does It Rank Its Own Site?</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Plenty of agencies promise rankings. Fewer can show you their own. Jraft Creative ranks on page one of Google in Singapore for a range of niche searches — several at #1 — and we got our own site cited in Google's AI Overview. We build for clients exactly what we built for ourselves.</p>
      </div>
      <div class="service-details-grid" style="grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>#1 on Google</h3>
            <p>"Marketing agency for gyms" in Singapore — position one, our own page, earned organically.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>#1 on Google</h3>
            <p>"Marketing agency for music schools" — position one, ranked on the same SEO we'd run for you.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Top 3 on Google</h3>
            <p>"Marketing agency for interior designers" — page one, top three, in a competitive niche.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Cited by AI</h3>
            <p>Jraft Creative is named in Google's AI Overview across five SG verticals — the new front line of search. <a href="/blog/how-we-got-cited-in-google-ai-overview-singapore/">See how →</a></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHAT MAKES THE BEST SEO AGENCY ========== -->
  <section class="section" id="best-seo-agency" aria-label="What makes the best SEO agency in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Straight Answer</p>
        <h2>What Makes the <span class="highlight">Best SEO Agency in Singapore</span>?</h2>
      </div>
      <div class="section-content reveal">
        <p>There's no official league table, but the best SEO agency in Singapore for you is the one that can prove it does the job it sells. Four things separate a real SEO partner from a repackaged web-design shop:</p>
        <p><strong>1. It ranks its own site.</strong> If an agency can't get its own pages onto page one, be sceptical it can get yours there. Ours rank #1 for several Singapore niches — see above.</p>
        <p><strong>2. It reports honestly.</strong> Rankings, traffic and leads in plain English every month — not vanity metrics, and never a guaranteed-rankings promise no one can keep.</p>
        <p><strong>3. It works all three levers.</strong> Technical, content, and authority together — not just the easy one.</p>
        <p><strong>4. It optimises for AI search.</strong> Google's AI Overview and ChatGPT now shape what buyers see; an agency ignoring them is optimising for 2019.</p>
        <p>Judge any agency — including us — against those four, and ask for a free audit so you can see the thinking before you commit.</p>
      </div>
    </div>
  </section>

  <!-- ========== WHAT WE DELIVER ========== -->
  <section class="section" id="sub-services" style="background: var(--bg-alt);" aria-label="What Jraft Creative delivers as an SEO agency">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">What We Deliver</p>
        <h2>Six <span class="highlight">SEO Pillars</span> That Move <span class="highlight">Rankings &amp; Traffic</span></h2>
      </div>
      <div class="section-content reveal">
        <p>We build SEO programmes specifically for SG businesses — technical foundation, on-page relevance, local visibility, content strategy, authority building, and the reporting and Core Web Vitals work that keeps it all measurable. Want to go beyond Google? Our <a href="/services/ai-search-optimisation">AI Search Optimisation (GEO)</a> service gets your brand recommended by ChatGPT, Gemini, and Perplexity too.</p>
      </div>
      <div class="service-details-grid deliver-grid">
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-seo-audit.webp');">
          <div class="service-detail-card__content">
            <h3>Technical SEO Audit</h3>
            <p>Comprehensive site crawl, indexing fixes, schema markup, canonical and sitemap hygiene, and site architecture improvements so search engines can find, understand, and rank every page you care about.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-onpage-seo.webp');">
          <div class="service-detail-card__content">
            <h3>On-Page Optimisation</h3>
            <p>Keyword research, meta tags, heading structure, content optimisation, and internal linking strategy to maximise relevance and topical authority for every target search term.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-copywriting.webp');">
          <div class="service-detail-card__content">
            <h3>Content Strategy</h3>
            <p>Search-intent-led content planning, cluster and pillar mapping, and copy built to rank for commercial and informational queries while staying genuinely useful to the reader.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-local-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Local SEO &amp; Google Business Profile</h3>
            <p>Google Business Profile optimisation, local citations, review management, and map pack rankings to capture "near me" and location-based search traffic across Singapore.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-ai.webp');">
          <div class="service-detail-card__content">
            <h3>Link Building &amp; Authority</h3>
            <p>Earned links, digital PR, and directory work across sources Google trusts — the off-page authority signals that separate page-one sites from everyone stuck below. The slow compounding lever, started early.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-analytics-reporting.webp');">
          <div class="service-detail-card__content">
            <h3>Reporting &amp; Core Web Vitals</h3>
            <p>Google Analytics 4 and Search Console setup, conversion tracking, page speed and Core Web Vitals optimisation, and monthly reports covering rankings, traffic, and next actions.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHY CHOOSE US ========== -->
  <section class="section" id="why-us" aria-label="Why choose Jraft Creative as your SEO agency">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2><span class="highlight">Data, Not Guesswork</span> — SEO Built to Show Up in <span class="highlight">Reporting, Not Just Rankings</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Singapore has one of the highest internet penetration rates in the world, and most high-intent commercial research still starts on Google. Our SEO is measured on organic traffic, keyword movement, and leads — not retainer hours — with transparent monthly reporting so you always see exactly how your investment is performing.</p>
      </div>
      <div class="service-details-grid" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Technical + Content + Authority</h3>
