---
import ServiceLayout from '../../layouts/ServiceLayout.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Social Media Marketing Agency Singapore",
    "description": "Social media marketing and content creation in Singapore — content strategy, Reels and short-form video, graphic design, copywriting, and community management, built to earn attention and drive real business results.",
    "provider": {
      "@type": "Organization",
      "name": "Jraft Creative",
      "url": "https://jraftcreative.com/",
      "logo": "https://jraftcreative.com/images/logo.png",
      "telephone": "+6582234578",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "60 Paya Lebar Road, Paya Lebar Square",
        "postalCode": "409051",
        "addressLocality": "Singapore",
        "addressCountry": "SG"
      }
    },
    "areaServed": { "@type": "Country", "name": "Singapore" },
    "serviceType": "Social Media Marketing"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "What is social media marketing?", "acceptedAnswer": { "@type": "Answer", "text": "Social media marketing is the practice of building a brand and winning customers through content on platforms like Instagram, TikTok, Facebook, LinkedIn and YouTube. It covers strategy, content creation (video, graphics, copy), posting and community management, and increasingly getting your brand recommended in AI answers. Done well, it's not about posting for the sake of it — it's about earning attention from the right people and turning it into enquiries and sales." } },
      { "@type": "Question", "name": "Is social media marketing worth it for a business in Singapore?", "acceptedAnswer": { "@type": "Answer", "text": "For most Singapore businesses, yes. Singapore has one of the highest social media penetration rates in the world — around 5.4 million active users spending over two hours a day in the feed. That's where people discover brands, judge them, and decide whether to buy. The question isn't whether to be on social, it's whether your content is good enough to be noticed. Weak, inconsistent content is worse than none; strong, consistent content compounds into a real audience and a real pipeline." } },
      { "@type": "Question", "name": "Will nice-looking content actually get me customers?", "acceptedAnswer": { "@type": "Answer", "text": "Not on its own. Pretty content that isn't built around how your buyer decides gets likes and goes nowhere. We make content with a point of view — designed to earn saves, shares and enquiries, not just applause — and we measure it against business outcomes like leads and sales, not follower counts. Attention is the start; the job is turning it into customers." } },
      { "@type": "Question", "name": "What kind of social content works best in Singapore right now?", "acceptedAnswer": { "@type": "Answer", "text": "Short-form video leads — Instagram Reels and TikTok generate roughly twice the engagement of static posts, and carousels outperform single images on Instagram. But format follows audience: what works for an F&B brand chasing walk-ins differs from a B2B firm building authority on LinkedIn. We build the mix around where your buyers actually scroll and how they decide, not around whatever's trending this week." } },
      { "@type": "Question", "name": "How many posts will I get per month?", "acceptedAnswer": { "@type": "Answer", "text": "Output is scoped on the discovery call. Most engagements run 8–20 posts a month plus a mix of Stories, Reels and short-form video — sized to your platform mix, audience, and growth stage. We'd rather ship fewer, sharper pieces than pad a calendar with filler." } },
      { "@type": "Question", "name": "Do you handle video and Reels production?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We produce Reels and short-form video for Instagram, TikTok and YouTube Shorts as part of most engagements — concepts, scripting, filming guidance, and editing, handled in-house. Short-form video is where attention is in Singapore, so it's central to most of our content plans, not an add-on." } },
      { "@type": "Question", "name": "Can I approve posts before they go live?", "acceptedAnswer": { "@type": "Answer", "text": "Always. We share a content calendar with every post, caption and visual for your approval before anything is scheduled. You can request revisions at any point before publishing — nothing goes out without your sign-off." } },
      { "@type": "Question", "name": "How do you measure social media success?", "acceptedAnswer": { "@type": "Answer", "text": "We track the numbers that matter to your business, not just vanity metrics. Saves and shares (real intent), reach and engagement, website clicks, and enquiries generated from social. Monthly reports show what content performed, what didn't, and how social contributed to leads and sales — so budget goes toward what actually works." } },
      { "@type": "Question", "name": "How much does social media marketing cost in Singapore?", "acceptedAnswer": { "@type": "Answer", "text": "Pricing depends on your platform mix, content volume, and whether you want paid ads on top of organic content. We scope the exact package on a free discovery call so you only pay for the output your business needs — no rigid tiers, no padding. Tell us your goals and we'll put a clear, itemised quote in front of you." } },
      { "@type": "Question", "name": "How do I choose a social media agency in Singapore?", "acceptedAnswer": { "@type": "Answer", "text": "Check four things: results you can verify (real numbers and reviews, not just follower counts), content built to drive enquiries rather than vanity likes, one in-house team making the work instead of outsourced freelancers, and transparent pricing you can actually understand. Ask for a free audit so you can judge the thinking before you commit." } },
      { "@type": "Question", "name": "Do you optimise for AI search and getting cited in Google's AI Overview?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Jraft Creative is a full-service agency, so beyond social media we also handle Generative Engine Optimisation (GEO) — getting your business recommended inside AI answers across Google's AI Overview, ChatGPT, Gemini and Perplexity. We practise what we sell: Jraft Creative got its own site cited in Google's AI Overview, and we run the same GEO playbook for clients." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "Social Media", "item": "https://jraftcreative.com/services/social-media/" }
    ]
  }
];
---

<ServiceLayout
  title="Social Media Marketing Agency Singapore — Content That Sells"
  description="A Singapore social media agency for brands that want to be seen and to sell — Reels, TikTok, and content built for how Singaporeans scroll, and measured on real results."
  canonical="https://jraftcreative.com/services/social-media/"
  ogTitle="Social Media Marketing Agency Singapore — Content That Sells"
  ogDescription="A Singapore social media agency for brands that want to be seen and to sell — Reels, TikTok, and content built for how Singaporeans scroll, and measured on real results."
  ogImage="https://jraftcreative.com/images/og-social.jpg"
  keywords="social media marketing agency singapore, social media content creation, instagram marketing singapore, tiktok content singapore, social media agency, content strategy, Jraft Creative"
  schemaData={schemaData}
  heroLabel="Social Media Marketing Agency Singapore"
  heroTitle='Social Media Marketing Agency &amp; <span class="highlight">Content Creation in Singapore</span>'
  heroSubtitle="Jraft Creative is a Singapore social media agency for brands that want to be seen — and to sell. We make content built for how Singaporeans actually scroll: Reels, TikToks, and posts that earn attention, then turn it into customers. Not just a pretty feed — content with a point of view, measured against real business results. We got our own site cited in Google's AI Overview, and we bring that same make-it-count discipline to your channels."
  heroImage="/images/service-social.webp"
  heroVideo="/videos/hero-social.mp4"
  heroButtons={[
    { text: "Start Creating Content", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%27d%20like%20to%20enquire%20about%20your%20social%20media%20content%20creation%20services.", class: "btn btn-secondary" }
  ]}
  whatsappText="Hi Jraft Creative, I'd like to enquire about your social media content creation services."
  ctaLabel="Ready to Get Started?"
  ctaTitle="Make Content Worth Watching"
  ctaDescription="Book a free consultation and tell us about your brand — your audience, your goals, your current content. We'll come back within 24 hours with a tailored, platform-by-platform plan."
  ctaButtons={[
    { text: "Start Creating Content", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%27d%20like%20to%20enquire%20about%20your%20social%20media%20content%20creation%20services.", class: "btn btn-secondary" }
  ]}
>

  <!-- ========== POV / THE FEED ========== -->
  <section class="section" id="challenge" aria-label="Why social media matters for Singapore businesses">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Point</p>
        <h2>In Singapore, the <span class="highlight">Feed</span> Is Where People <span class="highlight">Decide</span></h2>
      </div>
      <div class="section-content reveal">
        <p>The average Singaporean spends over two hours a day in the feed. That's where they find brands, size them up, and decide whether to trust them with their money. Social media stopped being a noticeboard a long time ago. It's the shop window, the word of mouth, and the first impression, all at once.</p>
        <p>Most brands treat it as a chore — post something, anything, stay "active." The brands that win treat the feed as the main stage. The gap between the two isn't budget. It's whether the content is actually worth watching.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>The Attention Problem</h3>
            <p>Your buyer scrolls past hundreds of posts a day and stops for a handful. Content that doesn't earn that stop in the first second is invisible — no matter how much you spent making it.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>The Sameness Problem</h3>
            <p>Most feeds in your category look identical — same stock, same captions, same "we're pleased to announce." When everyone blends together, people default to whoever they've heard of. Being forgettable is expensive.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>The Likes-But-No-Sales Problem</h3>
            <p>Plenty of brands get engagement and no enquiries. Vanity metrics feel good and bank nothing. If your content isn't built around how your buyer decides, the likes are a dead end.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHAT WE MAKE ========== -->
  <section class="section" id="sub-services" style="background: var(--bg-alt);" aria-label="Our social media services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">What We Make</p>
        <h2>Content With a <span class="highlight">Point of View</span> — Built to <span class="highlight">Perform</span></h2>
      </div>
      <div class="section-content reveal">
        <p>End-to-end social media, from strategy to the last caption. As a Singapore social media agency, we plan, create and manage your presence across Instagram, TikTok, Facebook, LinkedIn and YouTube — and we build every piece to earn attention and move your business, not just fill a grid.</p>
        <p>Want more reach behind it? Pair content with <a href="/services/paid-ads/">paid ads</a>, grow organic traffic with <a href="/services/seo-performance/">SEO</a>, or convert followers on a proper <a href="/services/website-development/">website</a>. See it by industry: <a href="/tiktok-marketing-agency-singapore/">TikTok marketing</a>, <a href="/restaurant-social-media-singapore/">restaurant social</a>, <a href="/aesthetics-clinic-social-media-singapore/">aesthetics clinic social</a>, or the full-service <a href="/digital-marketing-agency-singapore/">digital marketing agency</a>.</p>
      </div>
      <div class="service-details-grid">
        <div class="service-detail-card service-detail-card--overlay reveal reveal-d1" data-bg="/images/detail-content-strategy.webp">
          <div class="service-detail-card__content">
            <h3>Content Strategy &amp; Planning</h3>
            <p>A monthly plan with a real angle — pillar themes, platform-specific formats, and a calendar built around your audience and your goals, not around posting for the sake of it.</p>
          </div>
        </div>
        <div class="service-detail-card service-detail-card--overlay reveal reveal-d2" data-bg="/images/detail-reels-video.webp">
          <div class="service-detail-card__content">
            <h3>Reels &amp; Short-form Video</h3>
            <p>The format that wins attention in Singapore. Vertical video for Reels, TikTok and Shorts — concepted, scripted and edited to stop the scroll in the first second and hold it to the end.</p>
          </div>
        </div>
        <div class="service-detail-card service-detail-card--overlay reveal reveal-d3" data-bg="/images/detail-graphic-design.webp">
          <div class="service-detail-card__content">
            <h3>Graphic Design &amp; Visuals</h3>
            <p>Carousels, infographics and static posts that look unmistakably like you — a recognisable brand in the feed, not another lookalike template.</p>
          </div>
        </div>
        <div class="service-detail-card service-detail-card--overlay reveal reveal-d1" data-bg="/images/detail-copywriting.webp">
          <div class="service-detail-card__content">
            <h3>Copywriting &amp; Captions</h3>
            <p>Words that earn the save and the share. Hooks that front-load the reason to keep reading, captions written like a person, and a hashtag approach that helps you get found.</p>
          </div>
        </div>
        <div class="service-detail-card service-detail-card--overlay reveal reveal-d2" data-bg="/images/detail-community-mgmt.webp">
          <div class="service-detail-card__content">
            <h3>Community Management</h3>
            <p>Replies, DMs and comment moderation that turn a following into a community — the unglamorous work that builds the trust people actually buy on.</p>
          </div>
        </div>
        <div class="service-detail-card service-detail-card--overlay reveal reveal-d3" data-bg="/images/detail-analytics-reporting.webp">
          <div class="service-detail-card__content">
            <h3>Reporting That's Honest</h3>
            <p>Monthly reporting on the numbers that matter — saves, shares, clicks and enquiries — with plain-English recommendations, so you always know what's working and why.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== LIKES VS CUSTOMERS TABLE ========== -->
  <section class="section" id="likes-vs-customers" aria-label="Content that gets likes vs content that gets customers">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Difference</p>
        <h2>Content That Gets <span class="highlight">Likes</span> vs Content That Gets <span class="highlight">Customers</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Both fill a feed. Only one grows a business. Here's the difference we build for:</p>
      </div>
      <div class="comparison-table-wrap reveal">
        <table class="comparison-table">
          <thead>
            <tr><th>&nbsp;</th><th>Content that gets likes</th><th>Content that gets customers</th></tr>
          </thead>
          <tbody>
            <tr><td>Goal</td><td>Look active</td><td>Earn attention, then sell</td></tr>
            <tr><td>Made for</td><td>The algorithm</td><td>How your buyer actually decides</td></tr>
            <tr><td>Measured by</td><td>Likes and follower count</td><td>Saves, shares, enquiries, sales</td></tr>
            <tr><td>Looks like</td><td>Everyone else's feed</td><td>Unmistakably you</td></tr>
            <tr><td>After six months</td><td>A tidy grid, flat sales</td><td>A known brand and real leads</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ========== PROOF / SG SOCIAL ========== -->
  <section class="section" id="proof" style="background: var(--bg-alt);" aria-label="Why social media matters in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Social Matters in Singapore</p>
        <h2>5.4 Million Singaporeans Are <span class="highlight">Active on Social Media</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Singapore has a social media penetration rate of around 92% — one of the highest in the world. Roughly 5.4 million people are active on social, spending an average of two hours and fourteen minutes a day across Instagram, TikTok, Facebook and LinkedIn. For a business, that's the largest audience you can reach consistently without paying for every impression.</p>
        <p>Short-form video leads the way: Reels and TikTok generate around twice the engagement of static image posts, and carousels outperform single images on Instagram. Yet most Singapore brands post inconsistently, with weak visuals and captions written like a memo — blending into the noise instead of building something people recognise.</p>
        <p>That gap is the opportunity. Content with a real point of view, shipped consistently, compounds into an audience that trusts you and buys from you. <a href="/services/website-development/#portfolio" class="inline-link">See our work</a>.</p>
      </div>
    </div>
  </section>

  <!-- ========== WHY US ========== -->
  <section class="section" id="why-us" aria-label="Why choose Jraft Creative for social media">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2>We Do the <span class="highlight">Rarer Thing</span>: Content People Want to Watch, <span class="highlight">Built to Sell</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Most social agencies do one of two things — make pretty content that never sells, or chase numbers that never bank. We do the harder, rarer thing: content with a point of view that people actually want to watch, built and measured to move your business. Small, senior, and Singapore-native, so the work is fast, sharp, and made by the people you actually brief.</p>
      </div>
      <div class="service-details-grid" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Creative That's Measured</h3>
            <p>We care how it looks and whether it works. Every content plan ties to business outcomes — enquiries, clicks, sales — not just likes. Pretty and pointless isn't a result.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>One In-House Team</h3>
            <p>Strategy, video, design and copy from one senior team — not a brief passed down a chain of freelancers. Consistent voice, faster turnaround, one point of contact.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Built for How SG Scrolls</h3>
            <p>We build for how Singaporeans actually discover and decide — and we optimise so your brand shows up in AI answers too. We got our own site cited in Google's AI Overview and bring that same discipline to your channels.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== FAQ ========== -->
  <section class="section faq-section" id="faq" style="background: var(--bg-alt);" aria-label="Frequently asked questions about social media marketing in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">FAQ</p>
        <h2><span class="highlight">Social Media Marketing</span> — Questions <span class="highlight">Answered</span></h2>
      </div>
      <div class="faq-list">
        <details class="faq-item reveal reveal-d1">
          <summary>What is social media marketing?</summary>
          <div class="faq-answer"><p>Social media marketing is the practice of building a brand and winning customers through content on platforms like Instagram, TikTok, Facebook, LinkedIn and YouTube. It covers strategy, content creation (video, graphics, copy), posting and community management, and increasingly getting your brand recommended in AI answers. Done well, it's not about posting for the sake of it — it's about earning attention from the right people and turning it into enquiries and sales.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>Is social media marketing worth it for a business in Singapore?</summary>
          <div class="faq-answer"><p>For most Singapore businesses, yes. Singapore has one of the highest social media penetration rates in the world — around 5.4 million active users spending over two hours a day in the feed. That's where people discover brands, judge them, and decide whether to buy. The question isn't whether to be on social, it's whether your content is good enough to be noticed. Weak, inconsistent content is worse than none; strong, consistent content compounds into a real audience and a real pipeline.</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>Will nice-looking content actually get me customers?</summary>
          <div class="faq-answer"><p>Not on its own. Pretty content that isn't built around how your buyer decides gets likes and goes nowhere. We make content with a point of view — designed to earn saves, shares and enquiries, not just applause — and we measure it against business outcomes like leads and sales, not follower counts. Attention is the start; the job is turning it into customers.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>What kind of social content works best in Singapore right now?</summary>
          <div class="faq-answer"><p>Short-form video leads — Instagram Reels and TikTok generate roughly twice the engagement of static posts, and carousels outperform single images on Instagram. But format follows audience: what works for an F&amp;B brand chasing walk-ins differs from a B2B firm building authority on LinkedIn. We build the mix around where your buyers actually scroll and how they decide, not around whatever's trending this week.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>How many posts will I get per month?</summary>
          <div class="faq-answer"><p>Output is scoped on the discovery call. Most engagements run 8–20 posts a month plus a mix of Stories, Reels and short-form video — sized to your platform mix, audience, and growth stage. We'd rather ship fewer, sharper pieces than pad a calendar with filler.</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>Do you handle video and Reels production?</summary>
          <div class="faq-answer"><p>Yes. We produce Reels and short-form video for Instagram, TikTok and YouTube Shorts as part of most engagements — concepts, scripting, filming guidance, and editing, handled in-house. Short-form video is where attention is in Singapore, so it's central to most of our content plans, not an add-on.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>Can I approve posts before they go live?</summary>
          <div class="faq-answer"><p>Always. We share a content calendar with every post, caption and visual for your approval before anything is scheduled. You can request revisions at any point before publishing — nothing goes out without your sign-off.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>How do you measure social media success?</summary>
          <div class="faq-answer"><p>We track the numbers that matter to your business, not just vanity metrics. Saves and shares (real intent), reach and engagement, website clicks, and enquiries generated from social. Monthly reports show what content performed, what didn't, and how social contributed to leads and sales — so budget goes toward what actually works.</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>How much does social media marketing cost in Singapore?</summary>
          <div class="faq-answer"><p>Pricing depends on your platform mix, content volume, and whether you want paid ads on top of organic content. We scope the exact package on a free discovery call so you only pay for the output your business needs — no rigid tiers, no padding. Tell us your goals and we'll put a clear, itemised <a href="/contact/">quote</a> in front of you.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>How do I choose a social media agency in Singapore?</summary>
          <div class="faq-answer"><p>Check four things: results you can verify (real numbers and reviews, not just follower counts), content built to drive enquiries rather than vanity likes, one in-house team making the work instead of outsourced freelancers, and transparent pricing you can actually understand. Ask for a <a href="/contact/">free audit</a> so you can judge the thinking before you commit.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>Do you optimise for AI search and getting cited in Google's AI Overview?</summary>
          <div class="faq-answer"><p>Yes. Jraft Creative is a full-service agency, so beyond social media we also handle Generative Engine Optimisation (GEO) — getting your business recommended inside AI answers across Google's AI Overview, ChatGPT, Gemini and Perplexity. We practise what we sell: Jraft Creative got its own site cited in Google's AI Overview, and we run the same <a href="/geo-agency-singapore/">GEO playbook</a> for clients — <a href="/blog/how-we-got-cited-in-google-ai-overview-singapore/">here's how</a>.</p></div>
        </details>
      </div>
    </div>
  </section>

  <!-- ========== RELATED SERVICES ========== -->
  <section class="section" id="related-services" aria-label="Related social media services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Explore More</p>
        <h2>Social Media Services by <span class="highlight">Industry</span></h2>
      </div>
      <div class="related-services-grid reveal">
        <a href="/tiktok-marketing-agency-singapore/" class="related-service-link">TikTok Marketing Agency</a>
        <a href="/restaurant-social-media-singapore/" class="related-service-link">Restaurant Social Media</a>
        <a href="/fnb-social-media-singapore/" class="related-service-link">F&amp;B Social Media</a>
        <a href="/cafe-social-media-singapore/" class="related-service-link">Cafe Social Media</a>
        <a href="/aesthetics-clinic-social-media-singapore/" class="related-service-link">Aesthetics Clinic Social</a>
        <a href="/beauty-salon-social-media-singapore/" class="related-service-link">Beauty Salon Social Media</a>
        <a href="/gym-social-media-singapore/" class="related-service-link">Gym Social Media</a>
        <a href="/spa-social-media-singapore/" class="related-service-link">Spa Social Media</a>
        <a href="/education-social-media-marketing-singapore/" class="related-service-link">Education Social Media</a>
        <a href="/tuition-centre-social-media-singapore/" class="related-service-link">Tuition Centre Social Media</a>
        <a href="/yoga-studio-social-media-singapore/" class="related-service-link">Yoga Studio Social Media</a>
        <a href="/content-marketing-agency-singapore/" class="related-service-link">Content Marketing Agency</a>
      </div>
    </div>
  </section>

</ServiceLayout>
