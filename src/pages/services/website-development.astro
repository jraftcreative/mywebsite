---
import ServiceLayout from '../../layouts/ServiceLayout.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Website Development",
    "description": "AI-ready website design and development in Singapore — sites built with server-rendered, crawlable HTML, structured data and clear entity signals so AI search engines (ChatGPT, Gemini, Google AI Overview, Perplexity) can read, understand and recommend your business — and built to convert human visitors too.",
    "provider": {
      "@type": "Organization",
      "name": "Jraft Creative",
      "url": "https://jraftcreative.com/",
      "logo": "https://jraftcreative.com/images/logo.png",
      "telephone": "+6582234578",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "60 Paya Lebar Road, Paya Lebar Square",
        "postalCode": "409051",
        "addressLocality": "Singapore",
        "addressCountry": "SG"
      }
    },
    "areaServed": { "@type": "Country", "name": "Singapore" },
    "serviceType": "Website Development"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "What does an \"AI-discoverable\" website actually mean?", "acceptedAnswer": { "@type": "Answer", "text": "It means your website is built so AI search engines — ChatGPT, Gemini, Google's AI Overview and Perplexity — can read, understand and cite it when someone asks them for a recommendation. That requires server-rendered HTML the AI crawlers can actually read, structured data (schema), clear entity signals about who you are, and content written to answer the questions your customers ask. We build all of this in from the start." } },
      { "@type": "Question", "name": "Why can't AI read most websites?", "acceptedAnswer": { "@type": "Answer", "text": "As of 2026, the major AI crawlers (including OpenAI's GPTBot and Anthropic's ClaudeBot) download your pages but do NOT run JavaScript. Sites built on Wix, many WordPress page-builders, or JavaScript-heavy frameworks render their content in the browser using JavaScript — so the AI never sees it. We build server-rendered sites where the content is in the HTML from the first byte, fully readable by AI." } },
      { "@type": "Question", "name": "Is this different from your GEO / AI Search Optimisation service?", "acceptedAnswer": { "@type": "Answer", "text": "Yes, and they work together. Website Development makes the foundation AI-ready — the build itself is discoverable. AI Search Optimisation (GEO) is the ongoing work that earns citations and grows your visibility in AI answers over time. We build you AI-ready; GEO keeps you winning the answer." } },
      { "@type": "Question", "name": "Will the site still be built to convert human visitors?", "acceptedAnswer": { "@type": "Answer", "text": "Absolutely. AI-discoverability is the new layer, not a replacement. Every site is still designed to look credible, load fast, work on mobile, and turn visitors into enquiries — the AI-readiness is built on top of a high-converting website, not instead of one." } },
      { "@type": "Question", "name": "How long does it take to build a website?", "acceptedAnswer": { "@type": "Answer", "text": "A typical business website takes 4–6 weeks from kickoff to launch. Ecommerce stores and web applications may take 8–12 weeks depending on complexity. We provide a detailed timeline during our free consultation." } },
      { "@type": "Question", "name": "How much does a website cost in Singapore?", "acceptedAnswer": { "@type": "Answer", "text": "Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote." } },
      { "@type": "Question", "name": "Do you practise this on your own site?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Jraft Creative's own website got cited in Google's AI Overview for competitive Singapore queries — no paid placement. We build clients on the same playbook we proved on ourselves." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "Services" },
      { "@type": "ListItem", "position": 3, "name": "Website Development", "item": "https://jraftcreative.com/services/website-development/" }
    ]
  }
];
---

<style is:global>
  /* Hide the global background grid pattern on this page only */
  .animated-bg__grid { display: none; }

  /* More-prominent related-service pills — match challenge-card-v2 green treatment */
  #related-services .related-service-link {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.35);
    color: var(--text);
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  #related-services .related-service-link:hover {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.22) 0%, rgba(73, 184, 137, 0.1) 100%), rgba(20, 28, 32, 0.7);
    border-color: rgba(73, 184, 137, 0.6);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(73, 184, 137, 0.3);
  }

  /* Separate the CTA section from related-services with bg-alt */
  .service-cta-section {
    background: var(--bg-alt) !important;
  }

  /* AI Discovery Funnel — 5-stage horizontal flow with green accents */
  .renovation-funnel {
    list-style: none;
    padding: 0;
    margin: 56px 0 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 48px;
    counter-reset: funnel;
  }
  .funnel-stage {
    position: relative;
    text-align: center;
    padding: 28px 20px;
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.28);
    border-radius: 12px;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .funnel-stage:hover {
    transform: translateY(-4px);
    border-color: rgba(73, 184, 137, 0.55);
    box-shadow: 0 16px 40px -16px rgba(73, 184, 137, 0.3);
  }
  .funnel-stage h3 {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--accent);
    margin: 0 0 8px 0;
    letter-spacing: -0.01em;
  }
  .funnel-stage p {
    font-size: 0.82rem;
    color: var(--text);
    line-height: 1.5;
    margin: 0;
  }
  .funnel-stage:not(:last-child)::after {
    content: '→';
    position: absolute;
    right: -34px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--accent);
    font-size: 1.6rem;
    font-weight: 500;
    z-index: 2;
    line-height: 1;
    opacity: 0.7;
  }
  @media (max-width: 900px) {
    .renovation-funnel { grid-template-columns: repeat(2, 1fr); gap: 32px; }
    .funnel-stage:nth-child(2n)::after,
    .funnel-stage:last-child::after { display: none; }
    .funnel-stage:nth-child(2n-1)::after { right: -22px; }
  }
  @media (max-width: 600px) {
    .renovation-funnel { grid-template-columns: 1fr; gap: 20px; }
    .funnel-stage::after { display: none; }
  }
</style>

<ServiceLayout
  title="AI-Ready Web Design Singapore — Websites Built to Be Found by AI | Jraft Creative"
  description="Web design agency in Singapore building AI-discoverable websites — read, understood and recommended by ChatGPT, Gemini & Google's AI Overview, and built to convert. Book a free consultation."
  canonical="https://jraftcreative.com/services/website-development/"
  ogTitle="AI-Ready Web Design Singapore — Websites Built to Be Found by AI | Jraft Creative"
  ogDescription="We build websites AI search engines can actually read, understand and recommend — and that still convert the humans who click through. Book a free consultation."
  ogImage="https://jraftcreative.com/images/og-webdev.jpg"
  keywords="ai ready website singapore, ai discoverable website, web design agency singapore, websites built for AI search, GEO website design, website development singapore, Jraft Creative"
  schemaData={schemaData}
  heroLabel="AI-Ready Web Design · Singapore"
  heroTitle='Websites Built to Be <span class="highlight">Found by AI</span>'
  heroSubtitle="Your next customer is asking ChatGPT and Google's AI for a recommendation — and most websites can't even be read by it. We build sites AI can read, understand and recommend, that still convert the humans who click through. We proved it on ourselves: Jraft Creative is cited in Google's AI Overview."
  heroImage="/images/service-webdev.webp"
  heroImageAlt="A modern, AI-discoverable business website built by Jraft Creative"
  heroButtons={[
    { text: "Start Your Project", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%27d%20like%20an%20AI-ready%20website.", class: "btn btn-secondary" }
  ]}
  whatsappText="Hi Jraft Creative, I'd like an AI-ready website."
  ctaLabel="Ready to Get Found?"
  ctaTitle='Let&apos;s Build You a Website <span class="highlight">AI Recommends</span>'
  ctaDescription="Book a free consultation and tell us about your project. We'll show you where your business stands in AI search today, and get back to you within 24 hours with a plan."
  ctaButtons={[
    { text: "Start Your Project", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%27d%20like%20an%20AI-ready%20website.", class: "btn btn-secondary" }
  ]}
  hideDefaultCta={false}
>

  <!-- ========== THE CHALLENGE ========== -->
  <section class="section" id="challenge" aria-label="Why most websites are invisible to AI">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Shift</p>
        <h2>Search Moved to <span class="highlight">AI</span>. Most Websites Got Left <span class="highlight">Invisible</span></h2>
      </div>
      <div class="section-content reveal">
        <p>People increasingly ask ChatGPT, Gemini and Google's AI for a recommendation instead of scrolling links. Here's why most Singapore websites never make it into the answer.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>AI Can't Read It</h3>
            <p>AI crawlers download your page but don't run JavaScript. Wix, most WordPress builders and JS-heavy sites render content the AI never sees — so you're invisible in the answer.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>No Structured Data</h3>
            <p>Without schema markup, AI can't tell what you do, where you are, or what you're known for — so it reaches for a competitor it understands better.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Not Written to Be Quoted</h3>
            <p>AI cites clear, specific answers. Vague brochure copy and weak entity signals give it nothing to lift — so even a good-looking site never gets mentioned.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHAT WE DELIVER ========== -->
  <section class="section" id="sub-services" style="background: var(--bg-alt);" aria-label="What makes a website AI-discoverable">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">What We Build In</p>
        <h2>Six Things We Build In So <span class="highlight">AI Can Find You</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Most agencies build a website, then try to bolt on AI visibility later. We engineer it in from the first line of code — so AI can read, understand, trust and recommend your site. Pair it with our <a href="/services/ai-search-optimisation/">AI search optimisation (GEO)</a> to grow that visibility over time.</p>
      </div>
      <div class="service-details-grid deliver-grid">
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-business-website.webp');">
          <div class="service-detail-card__content">
            <h3>Server-Rendered, Crawlable HTML</h3>
            <p>Your content lives in the HTML from the first byte — fully readable by AI crawlers that skip JavaScript. No hidden content, no invisible pages.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-ai.webp');">
          <div class="service-detail-card__content">
            <h3>Structured Data &amp; Schema</h3>
            <p>Every page ships with the schema that tells AI exactly what you do, where you serve, and why you're credible — so it can quote you correctly.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-local-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Entity Clarity</h3>
            <p>We make your business a clear, consistent entity across your site and the web, so AI and Google's Knowledge Graph recognise and trust who you are.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-graphic-design.webp');">
          <div class="service-detail-card__content">
            <h3>Citable Content Architecture</h3>
            <p>Pages structured to answer the real questions your customers ask — specific, clear and quotable, which is exactly what AI lifts into its answers.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-google-ads.webp');">
          <div class="service-detail-card__content">
            <h3>llms.txt &amp; Clean Technical Base</h3>
            <p>Open AI-crawler access, a tidy technical foundation and an llms.txt guide — the housekeeping that makes your site easy for AI to fetch and parse.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-reels-video.webp');">
          <div class="service-detail-card__content">
            <h3>Speed &amp; Core Web Vitals</h3>
            <p>Fast, lightweight pages that pass Core Web Vitals — better for AI, better for Google, and better for the humans deciding whether to stay.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHY CHOOSE US ========== -->
  <section class="section" id="why-us" aria-label="Why choose Jraft Creative for an AI-ready website">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2><span class="highlight">Websites</span> Built for the Way People <span class="highlight">Search Now</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Most agencies are still building brochure sites for a search era that's ending — then charging extra to "add SEO" that AI engines can't even read. We build the opposite: sites that are AI-native by default, on modern server-rendered foundations, and still designed to convert the humans who click through. And we don't sell a playbook we haven't run — we proved it on our own site first.</p>
      </div>
      <div class="service-details-grid" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>We Proved It on Ourselves</h3>
            <p>Jraft Creative's own site is cited in Google's AI Overview for competitive Singapore queries — no paid placement. We build clients on the same playbook.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>AI-Native, Not Bolted On</h3>
            <p>Server-rendered, schema-first builds where AI-readability is designed in from day one — not a plugin added after launch that never quite works.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Found and Chosen</h3>
            <p>One team for the whole job — a site AI recommends and humans convert on. Discoverability and conversion engineered together, not traded off.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== AI DISCOVERY FUNNEL ========== -->
  <section class="section" id="buyer-funnel" style="background: var(--bg-alt);" aria-label="How customers now find businesses through AI">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The AI Discovery Funnel</p>
        <h2>How <span class="highlight">Customers</span> Now <span class="highlight">Find You</span></h2>
      </div>
      <div class="section-content reveal" style="margin-bottom: 24px;">
        <p>When someone asks an AI for a recommendation, your website moves through five stages before it becomes an enquiry. We build for every one — so you're in the answer, not left out of it.</p>
      </div>
      <ol class="renovation-funnel reveal">
        <li class="funnel-stage">
          <h3>Ask</h3>
          <p>Customer asks ChatGPT or Google AI</p>
        </li>
        <li class="funnel-stage">
          <h3>Crawl</h3>
          <p>AI reads your site's HTML</p>
        </li>
        <li class="funnel-stage">
          <h3>Understand</h3>
          <p>Schema + entity signals</p>
        </li>
        <li class="funnel-stage">
          <h3>Recommend</h3>
          <p>AI names you in the answer</p>
        </li>
        <li class="funnel-stage">
          <h3>Convert</h3>
          <p>They click through and enquire</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ========== FAQ ========== -->
  <section class="section faq-section" id="faq" style="background: var(--bg-alt);" aria-label="Frequently asked questions about AI-ready websites">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">FAQ</p>
        <h2><span class="highlight">AI-Ready Websites</span> — Questions <span class="highlight">Answered</span></h2>
      </div>
      <div class="faq-list">
        <details class="faq-item reveal reveal-d1">
          <summary>What does an "AI-discoverable" website actually mean?</summary>
          <div class="faq-answer"><p>It means your website is built so AI search engines — ChatGPT, Gemini, Google's AI Overview and Perplexity — can read, understand and cite it when someone asks them for a recommendation. That requires server-rendered HTML the AI crawlers can actually read, structured data (schema), clear entity signals about who you are, and content written to answer the questions your customers ask. We build all of this in from the start.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>Why can't AI read most websites?</summary>
          <div class="faq-answer"><p>As of 2026, the major AI crawlers (including OpenAI's GPTBot and Anthropic's ClaudeBot) download your pages but do NOT run JavaScript. Sites built on Wix, many WordPress page-builders, or JavaScript-heavy frameworks render their content in the browser using JavaScript — so the AI never sees it. We build server-rendered sites where the content is in the HTML from the first byte, fully readable by AI.</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>Is this different from your GEO / AI Search Optimisation service?</summary>
          <div class="faq-answer"><p>Yes, and they work together. Website Development makes the foundation AI-ready — the build itself is discoverable. <a href="/services/ai-search-optimisation/">AI Search Optimisation (GEO)</a> is the ongoing work that earns citations and grows your visibility in AI answers over time. We build you AI-ready; GEO keeps you winning the answer.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>Will the site still be built to convert human visitors?</summary>
          <div class="faq-answer"><p>Absolutely. AI-discoverability is the new layer, not a replacement. Every site is still designed to look credible, load fast, work on mobile, and turn visitors into enquiries — the AI-readiness is built on top of a high-converting website, not instead of one.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>How long does it take to build a website?</summary>
          <div class="faq-answer"><p>A typical business website takes 4–6 weeks from kickoff to launch. Ecommerce stores and web applications may take 8–12 weeks depending on complexity. We provide a detailed timeline during our free consultation.</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>How much does a website cost in Singapore?</summary>
          <div class="faq-answer"><p>Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick <a href="/contact/">consultation</a> and we'll scope exactly what you need and give you a transparent quote.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>Do you practise this on your own site?</summary>
          <div class="faq-answer"><p>Yes. Jraft Creative's own website got cited in Google's AI Overview for competitive Singapore queries — no paid placement. We build clients on the same playbook we proved on ourselves — <a href="/blog/how-we-got-cited-in-google-ai-overview-singapore/">here's how</a>.</p></div>
        </details>
      </div>
    </div>
  </section>

  <!-- Related Services -->
  <section class="section" id="related-services" aria-label="Related website services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Explore More</p>
        <h2>Website Development by <span class="highlight">Industry</span></h2>
      </div>
      <div class="related-services-grid reveal">
        <a href="/ecommerce-website-singapore/" class="related-service-link">Ecommerce Website</a>
        <a href="/small-business-website-singapore/" class="related-service-link">Small Business Website</a>
        <a href="/startup-website-singapore/" class="related-service-link">Startup Website</a>
        <a href="/fnb-website-design-singapore/" class="related-service-link">F&B Website Design</a>
        <a href="/clinic-website-design-singapore/" class="related-service-link">Clinic Website</a>
        <a href="/services/ai-search-optimisation/" class="related-service-link">GEO / AI Search Optimisation</a>
      </div>
    </div>
  </section>
</ServiceLayout>
