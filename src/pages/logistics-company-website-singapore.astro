---
import ServiceLayout from '../layouts/ServiceLayout.astro';
import RelatedServices from '../components/RelatedServices.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Logistics Company Website Design Singapore",
    "description": "Professional website design for logistics companies in Singapore. Capability pages, quote request forms, coverage and shipment tracking info.",
    "provider": {
      "@type": "Organization",
      "name": "Jraft Creative",
      "url": "https://jraftcreative.com/",
      "logo": "https://jraftcreative.com/images/logo.png",
      "telephone": "+6582234578",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "60 Paya Lebar Road, Paya Lebar Square",
        "postalCode": "409051",
        "addressLocality": "Singapore",
        "addressCountry": "SG"
      }
    },
    "areaServed": { "@type": "Country", "name": "Singapore" },
    "serviceType": "Logistics Company Website Design"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How much does a logistics company website cost in Singapore?", "acceptedAnswer": { "@type": "Answer", "text": "Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote." } },
      { "@type": "Question", "name": "Do you build websites for freight forwarders, 3PLs, warehousing and last-mile firms?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We build websites for freight forwarders, third-party logistics (3PL) providers, warehousing and cold chain operators, last-mile and courier firms, movers, and customs brokers across Singapore. Each site is tailored to the services and workflows of your logistics niche." } },
      { "@type": "Question", "name": "Can you show our coverage, trade lanes and shipment tracking on the site?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We present your coverage clearly — island-wide reach across Changi, Jurong, Tuas, and the CBD, plus your trade lanes and transit times. We can also embed a tracking lookup or link to your existing carrier or TMS tracking so clients can check a container, AWB, or booking reference from your website." } },
      { "@type": "Question", "name": "Will the website help my logistics company rank on Google in Singapore?", "acceptedAnswer": { "@type": "Answer", "text": "Every website is built on clean structure with optimised titles, metas, local schema, and Google Business Profile setup — so your firm can surface for searches like 'logistics company Singapore', 'freight forwarder Singapore', or 'warehouse services Singapore' instead of being invisible. Pair it with ongoing SEO for stronger results." } },
      { "@type": "Question", "name": "How long does it take to build a logistics company website?", "acceptedAnswer": { "@type": "Answer", "text": "Most logistics company websites go live within 2-3 weeks. A 5-page site can be ready in 2 weeks, while larger projects with tracking lookups or client case study libraries may take 3-4 weeks. We provide a clear timeline before starting." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "Logistics Company Website Singapore", "item": "https://jraftcreative.com/logistics-company-website-singapore/" }
    ]
  }
];
---

<style is:global>
  /* Hide the global background grid pattern on this page only */
  .animated-bg__grid { display: none; }

  /* More-prominent related-service pills — match challenge-card-v2 green treatment */
  #related-services .related-service-link {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.35);
    color: var(--text);
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  #related-services .related-service-link:hover {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.22) 0%, rgba(73, 184, 137, 0.1) 100%), rgba(20, 28, 32, 0.7);
    border-color: rgba(73, 184, 137, 0.6);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(73, 184, 137, 0.3);
  }

  /* Separate the CTA section from related-services with bg-alt */
  .service-cta-section {
    background: var(--bg-alt) !important;
  }

  /* Enrolment Funnel — 5-stage horizontal flow with green accents */
  .renovation-funnel {
    list-style: none;
    padding: 0;
    margin: 56px 0 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 48px;
    counter-reset: funnel;
  }
  .funnel-stage {
    position: relative;
    text-align: center;
    padding: 28px 20px;
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.28);
    border-radius: 12px;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .funnel-stage:hover {
    transform: translateY(-4px);
    border-color: rgba(73, 184, 137, 0.55);
    box-shadow: 0 16px 40px -16px rgba(73, 184, 137, 0.3);
  }
  .funnel-stage h3 {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--accent);
    margin: 0 0 8px 0;
    letter-spacing: -0.01em;
  }
  .funnel-stage p {
    font-size: 0.82rem;
    color: var(--text);
    line-height: 1.5;
    margin: 0;
  }
  .funnel-stage:not(:last-child)::after {
    content: '→';
    position: absolute;
    right: -34px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--accent);
    font-size: 1.6rem;
    font-weight: 500;
    z-index: 2;
    line-height: 1;
    opacity: 0.7;
  }
  @media (max-width: 900px) {
    .renovation-funnel {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }
    .funnel-stage:nth-child(2n)::after,
    .funnel-stage:last-child::after {
      display: none;
    }
    .funnel-stage:nth-child(2n-1)::after {
      right: -22px;
    }
  }
  @media (max-width: 600px) {
    .renovation-funnel {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .funnel-stage::after {
      display: none;
    }
  }
</style>

<ServiceLayout
  title="Logistics Company Website Singapore — Jraft Creative"
  description="Website design for logistics companies in Singapore — capability pages, quote forms, coverage and shipment tracking info, case studies, mobile-first speed."
  canonical="https://jraftcreative.com/logistics-company-website-singapore/"
  ogTitle="Logistics Company Website Singapore — Jraft Creative"
  ogDescription="Website design for logistics firms in Singapore. Capability pages, quote forms, coverage and tracking info, case studies."
  ogImage="https://jraftcreative.com/images/og-webdev.jpg"
  keywords="logistics company website singapore, freight forwarder website design, logistics web design singapore, warehouse company website, 3PL website design, last-mile delivery website singapore, Jraft Creative"
  schemaData={schemaData}
  heroLabel="Logistics Websites"
  heroTitle='Website Design for <span class="highlight">Logistics Companies in Singapore</span>'
  heroSubtitle="Singapore moves the world's cargo — your website should carry that weight. We build professional, mobile-first sites for freight, warehousing, last-mile, and moving firms, with capability pages, quote forms, and coverage and tracking info built in."
  heroImage="/images/service-logistics.webp"
  heroImageAlt="Logistics company website in Singapore"
  heroButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "See Our Work", href: "/about/", class: "btn btn-secondary" }
  ]}
  whatsappText="Hi Jraft Creative, I need a website for my logistics company in Singapore."
  ctaLabel="Ready to Get Started?"
  ctaTitle="Get Your Logistics Business Online"
  ctaDescription="Book a free consultation and tell us about your operation. We'll get back to you within 24 hours with a tailored proposal."
  ctaButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%20need%20a%20website%20for%20my%20logistics%20company%20in%20Singapore.", class: "btn btn-secondary" }
  ]}
  hideDefaultCta={false}
>

  <!-- ========== THE CHALLENGE ========== -->
  <section class="section" id="challenge" aria-label="Why logistics companies need a proper website in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Challenge</p>
        <h2>Shippers <span class="highlight">Vet Your Capabilities Online</span> Before They Ever <span class="highlight">Request a Quote</span></h2>
      </div>
      <div class="section-content reveal">
        <p>When a Singapore business needs to move cargo, procurement teams and operations managers search Google, open three or four provider websites, and judge each one in seconds. They scan for the services you run, check your coverage and certifications, and shortlist the firms that look capable and reliable. Logistics is a trust-driven, contract-led purchase — and your website is doing that vetting on your behalf, whether it's built for it or not. If you want the fundamentals, our guide to <a href="/blog/good-business-website-singapore/" class="inline-link">what makes a good business website in Singapore</a> is a useful starting point.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Capabilities Are Checked First</h3>
            <p>Before a business hands you a shipment, they look for proof — the services you run, your warehouse and fleet capacity, trade lanes and coverage, and certifications like GDP, TAPA, or ISO. If those signals aren't obvious on the page, the prospect assumes the worst and moves to the next firm on the list.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>A Crowded, Commoditised Hub</h3>
            <p>Singapore is one of the world's busiest logistics hubs, with thousands of forwarders, 3PLs, warehousing, and last-mile firms chasing the same clients — and most websites read identically. Without clear differentiation on coverage, specialisation, and how you actually operate, you blur into the crowd and compete only on price.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Quote Requests That Never Arrive</h3>
            <p>A brochure site that just sits there isn't enough. The job of the website is to turn a cautious visitor into a submitted quote request — with clear capability pages, visible proof, and an easy enquiry path. Most logistics sites leave prospects with no obvious next step, so the lead quietly disappears.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHAT WE DELIVER ========== -->
  <section class="section" id="sub-services" style="background: var(--bg-alt);" aria-label="Logistics company website design deliverables">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">What We Deliver</p>
        <h2>Six <span class="highlight">Pillars</span> of a Logistics Company <span class="highlight">Website</span></h2>
      </div>
      <div class="section-content reveal">
        <p>A logistics website isn't an e-commerce store or a generic brochure. Buyers arrive cautious, comparing you against three other firms, and they need to see scope, coverage, and a clear way to get a quote. We build every element around how a Singapore shipper actually researches and shortlists a provider — from Changi and Jurong to Tuas and the CBD.</p>
        <p>We handle more than the build. Your site sits on our <a href="/services/website-development/" class="inline-link">website development</a> foundation, and we can pair it with the wider <a href="/industries/professional-services/" class="inline-link">B2B and professional services marketing</a> work that keeps qualified enquiries coming in.</p>
      </div>
      <div class="service-details-grid deliver-grid">
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-business-website.webp');">
          <div class="service-detail-card__content">
            <h3>Credibility &amp; Scale-Led Design</h3>
            <p>A clean, professional layout that signals scale and reliability the moment the page loads. Considered typography, calm colour, and a structure that puts coverage and capability first — so a prospect's instinctive "can I trust them with my cargo?" is answered before they read a word.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-onpage-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Services &amp; Capability Pages</h3>
            <p>Dedicated pages for each service you run — sea and air freight, land transport, warehousing and cold chain, last-mile delivery, moving and relocation, or customs brokerage. Each explains the scope and who it's for, so prospects self-qualify and arrive at the quote already understanding what you do.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-local-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Coverage &amp; Tracking Info</h3>
            <p>Clear coverage maps and trade lanes with transit times, plus island-wide reach across Changi, Jurong, Tuas, and the CBD. We can add a tracking lookup or link to your carrier or TMS so clients check a container, AWB, or booking reference from your site — cutting support calls.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-graphic-design.webp');">
          <div class="service-detail-card__content">
            <h3>Quote &amp; Enquiry Forms</h3>
            <p>Structured forms where shippers submit the details that matter — origin, destination, cargo type, weight, and dimensions — and request a quotation directly. Low-friction, with spam protection, tap-to-call, and WhatsApp options so an interested prospect reaches your team in a single tap.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-speed-vitals.webp');">
          <div class="service-detail-card__content">
            <h3>Client Logos &amp; Case Studies</h3>
            <p>The proof procurement teams look for — client logos, testimonials, and case studies that show the shipments you handle and the results you deliver. Positioned above the fold and on every capability page, not buried on an About page, so credibility carries through the whole journey.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-ai.webp');">
          <div class="service-detail-card__content">
            <h3>Mobile Speed &amp; SEO Foundations</h3>
            <p>Operations managers research providers on their phones, from the warehouse floor or the port terminal. Every site is built mobile-first and tuned for fast load and strong Core Web Vitals — with clean structure, optimised metas, local schema, and Google Business Profile setup baked in from day one.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHY CHOOSE US ========== -->
  <section class="section" id="why-us" aria-label="Why choose Jraft Creative for logistics company website design">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2>A <span class="highlight">Web Design Partner</span> Built for <span class="highlight">Logistics &amp; Freight</span></h2>
      </div>
      <div class="section-content reveal">
        <p>We've built websites for operators across Singapore, and we understand what turns a cautious procurement team into a submitted quote request — coverage signals, clear capabilities, and a low-friction enquiry path. We design every element of your site around that conversion.</p>
      </div>
      <div class="service-details-grid" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Logistics Industry Experience</h3>
            <p>We understand the sector — from freight forwarding workflows and warehouse operations to how procurement teams shortlist providers. Your website speaks the language of the industry, with capability pages, coverage detail, and proof built in, not generic marketing copy.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Built to Convert, Not Just Look Good</h3>
            <p>A handsome site that generates no quote requests is a wasted investment. We structure pages around the shipper's questions and decisions, with proof and clear calls to action placed exactly where they tip a visitor into submitting an enquiry or picking up the phone.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>One Agency, All Channels</h3>
            <p>A website is the foundation, but discovery and lead flow depend on more. We handle SEO, social, and paid ads in-house — an integrated system that brings the right shippers and importers to a site built to win them.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== THE CLIENT FUNNEL ========== -->
  <section class="section" id="buyer-funnel" style="background: var(--bg-alt);" aria-label="The Client Funnel — where your website fits the shipper journey">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Client Funnel</p>
        <h2>Where Your <span class="highlight">Website</span> Fits the <span class="highlight">Shipper Journey</span></h2>
      </div>
      <div class="section-content reveal" style="margin-bottom: 24px;">
        <p>Every Singapore business moves through the same five stages before appointing a logistics provider. Your website carries them from the first search to a submitted quote request — and feeds proof into every stage along the way.</p>
      </div>
      <ol class="renovation-funnel reveal">
        <li class="funnel-stage">
          <h3>Research</h3>
          <p>Google search, referrals, RFQs</p>
        </li>
        <li class="funnel-stage">
          <h3>Shortlist</h3>
          <p>Compare 3-4 firms in seconds</p>
        </li>
        <li class="funnel-stage">
          <h3>Validate</h3>
          <p>Coverage, certs &amp; case studies</p>
        </li>
        <li class="funnel-stage">
          <h3>Enquire</h3>
          <p>Request a quote or call</p>
        </li>
        <li class="funnel-stage">
          <h3>Engage</h3>
          <p>Appoint, onboard &amp; refer</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ========== PRICING ========== -->
  <!-- ========== FAQ ========== -->
  <section class="section faq-section" id="faq" style="background: var(--bg-alt);" aria-label="Frequently asked questions about logistics company website design in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">FAQ</p>
        <h2>Logistics Website <span class="highlight">Questions Answered</span></h2>
      </div>
      <div class="faq-list">
        <details class="faq-item reveal reveal-d1">
          <summary>How much does a logistics company website cost in Singapore?</summary>
          <div class="faq-answer"><p>Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>Do you build websites for freight forwarders, 3PLs, warehousing and last-mile firms?</summary>
          <div class="faq-answer"><p>Yes. We build websites for freight forwarders, third-party logistics (3PL) providers, warehousing and cold chain operators, last-mile and courier firms, movers, and customs brokers across Singapore. Each site is tailored to the services and workflows of your logistics niche.</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>Can you show our coverage, trade lanes and shipment tracking on the site?</summary>
          <div class="faq-answer"><p>Yes. We present your coverage clearly — island-wide reach across Changi, Jurong, Tuas, and the CBD, plus your trade lanes and transit times. We can also embed a tracking lookup or link to your existing carrier or TMS tracking so clients can check a container, AWB, or booking reference from your website.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>Will the website help my logistics company rank on Google in Singapore?</summary>
          <div class="faq-answer"><p>Every website is built on clean structure with optimised titles, metas, local schema, and Google Business Profile setup — so your firm can surface for searches like "logistics company Singapore", "freight forwarder Singapore", or "warehouse services Singapore" instead of being invisible. Pair it with ongoing SEO for stronger results.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>How long does it take to build a logistics company website?</summary>
          <div class="faq-answer"><p>Most logistics company websites go live within 2-3 weeks. A 5-page site can be ready in 2 weeks, while larger projects with tracking lookups or client case study libraries may take 3-4 weeks. We provide a clear timeline before starting.</p></div>
        </details>
      </div>
    </div>
  </section>


  <RelatedServices
    links={[
      { href: '/industries/professional-services/', label: 'Professional Services Marketing' },
      { href: '/services/website-development/', label: 'Website Development' },
      { href: '/services/seo-performance/', label: 'SEO &amp; Performance' },
      { href: '/services/paid-ads/', label: 'Paid Ads' }
    ]}
  />

</ServiceLayout>
</content>
</invoke>
