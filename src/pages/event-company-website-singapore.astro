---
import ServiceLayout from '../layouts/ServiceLayout.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Event Company Website Singapore",
    "description": "Professional website design for event management and production companies in Singapore. Event portfolio galleries, enquiry and RFP forms, service pages, and client logo showcases.",
    "provider": {
      "@type": "Organization",
      "name": "Jraft Creative",
      "url": "https://jraftcreative.com/",
      "logo": "https://jraftcreative.com/images/logo.png",
      "telephone": "+6582234578",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "60 Paya Lebar Road, Paya Lebar Square",
        "postalCode": "409051",
        "addressLocality": "Singapore",
        "addressCountry": "SG"
      }
    },
    "areaServed": { "@type": "Country", "name": "Singapore" },
    "serviceType": "Event Company Website"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How much does an event company website cost in Singapore?", "acceptedAnswer": { "@type": "Answer", "text": "Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote." } },
      { "@type": "Question", "name": "Can you build an event portfolio that shows past events?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. A categorised event portfolio is the core of every event company website we build. We create filterable galleries — corporate events, MICE, weddings, product launches, roadshows — with high-resolution images, event descriptions, guest count, and venue details so prospects can see the scale and quality of your work before they enquire." } },
      { "@type": "Question", "name": "Can clients send enquiries or RFPs through the website?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We build structured enquiry and RFP forms that capture event type, date, venue, guest count, and requirements — so you receive qualified briefs ready to quote instead of a one-line direct message. Forms can route to your inbox, WhatsApp, or a shared team address." } },
      { "@type": "Question", "name": "Can the website display our client logos and testimonials?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We build dedicated client-logo walls and testimonial sections that pair quotes with event photos. For an event company, proof of past corporate and brand clients is often what wins the next brief, so we give it prominence across the site." } },
      { "@type": "Question", "name": "How long does it take to build an event company website?", "acceptedAnswer": { "@type": "Answer", "text": "Most event company websites go live within 2–3 weeks. A portfolio and enquiry site can be ready in 2 weeks, while larger projects with service directories or client portals may take 3–4 weeks. We provide a clear timeline before starting." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "Event Company Website Singapore", "item": "https://jraftcreative.com/event-company-website-singapore/" }
    ]
  }
];
---

<style is:global>
  /* Hide the global background grid pattern on this page only */
  .animated-bg__grid { display: none; }

  /* More-prominent related-service pills — match challenge-card-v2 green treatment */
  #related-services .related-service-link {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.35);
    color: var(--text);
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  #related-services .related-service-link:hover {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.22) 0%, rgba(73, 184, 137, 0.1) 100%), rgba(20, 28, 32, 0.7);
    border-color: rgba(73, 184, 137, 0.6);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(73, 184, 137, 0.3);
  }

  /* Separate the CTA section from related-services with bg-alt */
  .service-cta-section {
    background: var(--bg-alt) !important;
  }

  /* Force 3x2 grid on desktop for the deliver section per locked landing-page pattern */
  #sub-services .deliver-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }
  #sub-services {
    padding-top: 72px;
    padding-bottom: 72px;
  }
  @media (max-width: 900px) {
    #sub-services .deliver-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 600px) {
    #sub-services .deliver-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Renovation Buyer Funnel — 5-stage horizontal flow with green accents */
  .renovation-funnel {
    list-style: none;
    padding: 0;
    margin: 56px 0 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 48px;
    counter-reset: funnel;
  }
  .funnel-stage {
    position: relative;
    text-align: center;
    padding: 28px 20px;
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.28);
    border-radius: 12px;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .funnel-stage:hover {
    transform: translateY(-4px);
    border-color: rgba(73, 184, 137, 0.55);
    box-shadow: 0 16px 40px -16px rgba(73, 184, 137, 0.3);
  }
  .funnel-stage h3 {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--accent);
    margin: 0 0 8px 0;
    letter-spacing: -0.01em;
  }
  .funnel-stage p {
    font-size: 0.82rem;
    color: var(--text);
    line-height: 1.5;
    margin: 0;
  }
  .funnel-stage:not(:last-child)::after {
    content: '→';
    position: absolute;
    right: -34px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--accent);
    font-size: 1.6rem;
    font-weight: 500;
    z-index: 2;
    line-height: 1;
    opacity: 0.7;
  }
  @media (max-width: 900px) {
    .renovation-funnel {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }
    .funnel-stage:nth-child(2n)::after,
    .funnel-stage:last-child::after {
      display: none;
    }
    .funnel-stage:nth-child(2n-1)::after {
      right: -22px;
    }
  }
  @media (max-width: 600px) {
    .renovation-funnel {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .funnel-stage::after {
      display: none;
    }
  }
</style>

<ServiceLayout
  title="Event Company Website Singapore — Jraft Creative"
  description="Website design for event companies in Singapore. Event portfolio galleries, enquiry and RFP forms, service pages, and client logo showcases."
  canonical="https://jraftcreative.com/event-company-website-singapore/"
  ogTitle="Event Company Website Singapore — Jraft Creative"
  ogDescription="Website design for event companies in Singapore. Portfolio galleries, enquiry and RFP forms, client logo showcases."
  ogImage="https://jraftcreative.com/images/og-webdev.jpg"
  keywords="event company website singapore, event management website design, event production company website, corporate event website singapore, MICE event website, wedding event website singapore, event planner portfolio website, Jraft Creative"
  schemaData={schemaData}
  heroLabel="Event Company Websites"
  heroTitle='Website Design for <span class="highlight">Event Companies in Singapore</span>'
  heroSubtitle="Your events do the talking — your website should too. We build fast, mobile-first websites for event management and production companies across Singapore, with categorised portfolios of past events, enquiry and RFP forms, and client logo walls built in."
  heroImage="/images/industry-creative-events.webp"
  heroImageAlt="Event company website in Singapore"
  heroButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%20need%20a%20website%20for%20my%20event%20company%20in%20Singapore.", class: "btn btn-secondary" }
  ]}
  whatsappText="Hi Jraft Creative, I need a website for my event company in Singapore."
  ctaLabel="Ready to Get Started?"
  ctaTitle='Get Your <span class="highlight">Event Portfolio</span> Online'
  ctaDescription="Book a free consultation and tell us about your event company. We'll get back to you within 24 hours with a tailored proposal."
  ctaButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%20need%20a%20website%20for%20my%20event%20company%20in%20Singapore.", class: "btn btn-secondary" }
  ]}
>

  <!-- ========== THE CHALLENGE ========== -->
  <section class="section" id="challenge" aria-label="Why event companies need a proper website">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Challenge</p>
        <h2>A Referral Sends Them — Then They <span class="highlight">Google Your Company</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Corporate HR teams, brand marketers, and couples all hear your name from a referral or spot you on Instagram — then they do what every serious buyer does and Google your company to vet it. If your site does not back up the recommendation with real event work, you lose the brief to a company whose site closes the loop. A <a href="/blog/good-business-website-singapore/" class="inline-link">website that earns trust in seconds</a> is what keeps that visit from bouncing.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>The Referral-to-Google Handoff</h3>
            <p>A prospect gets your name from a colleague or a venue partner, then Googles your company to check you out. A thin site with stock photos and a lone contact form does not give a corporate buyer the confidence to shortlist you — they bounce and enquire with the company whose site proved it could deliver.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>The Instagram-Grid Ceiling</h3>
            <p>A social grid cannot show your full body of work by category, present service lines clearly, or capture a structured brief. Buyers want to filter past events by type — corporate D&amp;D, MICE, wedding, launch, roadshow — and see guest count, venue, and outcome. A feed of square photos cannot do that.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>The Mobile-Last Mistake</h3>
            <p>Event planners and corporate buyers research vendors on their phones between meetings and site recces. A desktop-first site with heavy galleries, tiny tap targets, and slow images loses enquiries the company never even sees.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHAT WE BUILD ========== -->
  <section class="section" id="sub-services" style="background: var(--bg-alt);" aria-label="Event company website design services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">What We Build</p>
        <h2>Six <span class="highlight">Conversion Features</span> Every Event Company Site <span class="highlight">Needs</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Every event company website we deliver is purpose-built for the events industry — categorised portfolios of past events, structured enquiry and RFP forms, clear service pages, and client logo walls that turn browsers into briefs. It is one part of our <a href="/services/website-development/" class="inline-link">website development</a> service, and it plugs straight into our wider <a href="/industries/creative-events/" class="inline-link">creative and events marketing</a> work.</p>
      </div>
      <div class="service-details-grid deliver-grid">
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-business-website.webp');">
          <div class="service-detail-card__content">
            <h3>Event Portfolio Galleries</h3>
            <p>Filterable galleries of past events with high-resolution images, event descriptions, guest count, and venue details. Organised by type — corporate events, MICE, weddings, product launches, roadshows — so a prospect can find work that matches the brief they are planning.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-landing-page.webp');">
          <div class="service-detail-card__content">
            <h3>Enquiry &amp; RFP Forms</h3>
            <p>Structured forms that capture event type, date, venue, guest count, and requirements — so you receive a qualified brief ready to quote instead of a one-line message. Enquiries can route to your inbox, WhatsApp, or a shared team address for fast follow-up.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-local-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Service &amp; Package Pages</h3>
            <p>Dedicated pages for each service line — full-service production, AV and staging, decor, entertainment, MICE management — with clear scope breakdowns that set expectations before the first call and help buyers self-qualify.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-graphic-design.webp');">
          <div class="service-detail-card__content">
            <h3>Client Logos &amp; Testimonials</h3>
            <p>Client-logo walls and testimonial sections that pair quotes with event photos. Proof of the corporate and brand clients you have delivered for is often what wins the next brief, so we give it prominence across the site.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-onpage-seo.webp');">
          <div class="service-detail-card__content">
            <h3>SEO &amp; Catchment Pages</h3>
            <p>Built on a structure Google can index — clean schema, sitemap, fast mobile loads, and optional location pages for CBD and Raffles Place, Marina Bay, Orchard, Tanjong Pagar, and Bugis where your company wants to be found.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-speed-vitals.webp');">
          <div class="service-detail-card__content">
            <h3>Mobile Speed &amp; Core Web Vitals</h3>
            <p>Every site we build is mobile-first with fast load times, thumb-friendly navigation, and image optimisation. Buyers vet event vendors on their phones — a site that lags loses the enquiry before it lands.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHY CHOOSE US ========== -->
  <section class="section" id="why-us" aria-label="Why choose Jraft Creative for event company website design">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2><span class="highlight">Websites</span> Built for How <span class="highlight">Event Buyers</span> Actually Shop</h2>
      </div>
      <div class="section-content reveal">
        <p>We have built websites for design-driven and visual businesses across Singapore. We know how to present event work online in a way that turns research into a qualified brief — and we design every element of your site around that goal.</p>
      </div>
      <div class="service-details-grid" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Built for the Events Industry</h3>
            <p>We know the difference between a corporate D&amp;D, a MICE conference, a product launch, and a wedding — and we build your site to speak to each buyer. Portfolio categories, service pages, and enquiry forms are structured around how event clients actually search and buy in Singapore.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Fast Turnaround — Two Weeks</h3>
            <p>Most event company websites go live within two weeks of kickoff. Peak seasons like year-end corporate events and the wedding calendar do not wait — we deliver quickly so you can capture briefs while demand is high.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Full Digital Package</h3>
            <p>Website, SEO, social media, and paid ads under one roof. We can handle your entire online presence so you can focus on producing great events — not coordinating three vendors.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== EVENT BUYER FUNNEL ========== -->
  <section class="section" id="buyer-funnel" style="background: var(--bg-alt);" aria-label="The Event Buyer Funnel — how Singapore clients choose an event company">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Buyer Funnel</p>
        <h2>How <span class="highlight">Event Buyers</span> Actually <span class="highlight">Decide</span></h2>
      </div>
      <div class="section-content reveal" style="margin-bottom: 24px;">
        <p>From the first internal brief to a signed contract, most corporate and private event buyers in Singapore move through the same five stages. Your website is the asset that carries the visit through every one of them.</p>
      </div>
      <ol class="renovation-funnel reveal">
        <li class="funnel-stage">
          <h3>Brief</h3>
          <p>Budget, date, and goals set internally</p>
        </li>
        <li class="funnel-stage">
          <h3>Shortlist</h3>
          <p>Google, referrals, past-event portfolios</p>
        </li>
        <li class="funnel-stage">
          <h3>Proposal</h3>
          <p>RFP sent to three to five companies</p>
        </li>
        <li class="funnel-stage">
          <h3>Recce</h3>
          <p>Venue walkthroughs and pitch meetings</p>
        </li>
        <li class="funnel-stage">
          <h3>Confirm</h3>
          <p>Contract signed, deposit paid</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ========== FAQ ========== -->
  <section class="section faq-section" id="faq" style="background: var(--bg-alt);" aria-label="Frequently asked questions about event company website design in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">FAQ</p>
        <h2><span class="highlight">Event Company Website</span> — Questions <span class="highlight">Answered</span></h2>
      </div>
      <div class="faq-list">
        <details class="faq-item reveal reveal-d1">
          <summary>How much does an event company website cost in Singapore?</summary>
          <div class="faq-answer"><p>Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>Can you build an event portfolio that shows past events?</summary>
          <div class="faq-answer"><p>Yes. A categorised event portfolio is the core of every event company website we build. We create filterable galleries — corporate events, MICE, weddings, product launches, roadshows — with high-resolution images, event descriptions, guest count, and venue details so prospects can see the scale and quality of your work before they enquire.</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>Can clients send enquiries or RFPs through the website?</summary>
          <div class="faq-answer"><p>Yes. We build structured enquiry and RFP forms that capture event type, date, venue, guest count, and requirements — so you receive qualified briefs ready to quote instead of a one-line direct message. Forms can route to your inbox, WhatsApp, or a shared team address.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>Can the website display our client logos and testimonials?</summary>
          <div class="faq-answer"><p>Yes. We build dedicated client-logo walls and testimonial sections that pair quotes with event photos. For an event company, proof of past corporate and brand clients is often what wins the next brief, so we give it prominence across the site.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>How long does it take to build an event company website?</summary>
          <div class="faq-answer"><p>Most event company websites go live within 2-3 weeks. A portfolio and enquiry site can be ready in 2 weeks, while larger projects with service directories or client portals may take 3-4 weeks. We provide a clear timeline before starting.</p></div>
        </details>
      </div>
    </div>
  </section>


  <!-- Related Services -->
  <section class="section" id="related-services" aria-label="Related services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Explore More</p>
        <h2>More <span class="highlight">Event Company</span> Services</h2>
      </div>
      <div class="related-services-grid reveal">
          <a href="/industries/creative-events/" class="related-service-link">Creative &amp; Events Marketing</a>
          <a href="/services/website-development/" class="related-service-link">Website Development</a>
          <a href="/services/seo-performance/" class="related-service-link">SEO &amp; Performance</a>
          <a href="/services/social-media/" class="related-service-link">Social Media</a>
      </div>
    </div>
  </section>

</ServiceLayout>
