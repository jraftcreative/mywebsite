---
import BaseLayout from '../layouts/BaseLayout.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How Jraft Creative Works — Our Process",
    "description": "From discovery to growth, our four-step process delivers websites, SEO, AI search (GEO), paid ads, and social media for businesses in Singapore.",
    "step": [
      { "@type": "HowToStep", "position": 1, "name": "Discovery", "text": "We learn your business, goals, audience, and competitors, and define a clear scope, priorities, and a transparent quote." },
      { "@type": "HowToStep", "position": 2, "name": "Strategy", "text": "We map the plan across the channels that fit your goals — website, SEO, AI search (GEO), Google and Meta ads, and social — with a funnel, timeline, and conversion tracking." },
      { "@type": "HowToStep", "position": 3, "name": "Execute", "text": "We produce the work in-house — websites, SEO and GEO, ad campaigns, and social content — with tracking wired up so everything is measurable." },
      { "@type": "HowToStep", "position": 4, "name": "Grow & Optimise", "text": "We launch, confirm analytics, report monthly on leads and cost per lead, and keep optimising on real data. Month-to-month, no lock-in." }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How long does your process take?", "acceptedAnswer": { "@type": "Answer", "text": "It depends on the work. A straightforward website can go live in about two weeks; SEO and content build over months; ad campaigns can start within days. In Discovery we give you a realistic timeline for your specific scope before anything begins." } },
      { "@type": "Question", "name": "Do I have to sign up for everything, or can I start with one service?", "acceptedAnswer": { "@type": "Answer", "text": "Start with what you need. Plenty of clients begin with a website or a single channel, then add more once it's working. In the Strategy step we recommend only what fits your goals, and tell you what you don't need." } },
      { "@type": "Question", "name": "How much does your process cost?", "acceptedAnswer": { "@type": "Answer", "text": "There's no fixed package, because the right scope differs per business. After a short discovery call we give you a clear, transparent quote with no hidden fees. Book a consultation and we'll scope it with you." } },
      { "@type": "Question", "name": "How involved do I need to be?", "acceptedAnswer": { "@type": "Answer", "text": "As much or as little as you like. We need you for the discovery call, sign-off on the plan and designs, and the occasional piece of input, then we run the work and keep you updated in plain language." } },
      { "@type": "Question", "name": "What happens after launch?", "acceptedAnswer": { "@type": "Answer", "text": "We don't disappear. We confirm analytics and tracking, report monthly on the numbers that matter — leads, bookings, and cost per lead — and keep optimising on real data. It's month-to-month with no lock-in." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "Our Process", "item": "https://jraftcreative.com/process/" }
    ]
  }
];
---

<BaseLayout
  title="Our Marketing Process — How We Work | Jraft Creative"
  description="How Jraft Creative works — a clear, four-step process across websites, SEO, AI search, ads, and social for Singapore businesses."
  canonical="https://jraftcreative.com/process/"
  ogTitle="Our Marketing Process — How We Work | Jraft Creative"
  ogDescription="A simple, transparent process across everything we do — websites, SEO, AI search, ads, and social. From first call to results you can measure."
  keywords="marketing agency process singapore, how we work, digital marketing process, web design process, seo process, Jraft Creative process"
  schemaData={schemaData}
>

  <style is:global>
    .animated-bg__grid { display: none; }
    .faq-section { background: transparent; }
  </style>

  <!-- ========== HERO ========== -->
  <section class="process-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a> <span aria-hidden="true">/</span> <span>Our Process</span>
      </nav>
      <div class="process-hero__grid">
        <div class="process-hero__content reveal">
          <p class="section-label">How We Work</p>
          <h1>Marketing You Can <span class="highlight">Actually Follow</span></h1>
          <p class="process-hero__subtitle">Most agencies keep you guessing. We don't. One team handles your website, SEO, AI search, ads, and social — you sign off the plan before we build, then see the leads and cost per lead every month.</p>
          <div class="process-hero__cta">
            <a href="/contact/" class="btn btn-primary">Book Your Consultation</a>
            <a href="#steps" class="btn btn-secondary">See How It Works</a>
          </div>
        </div>
        <div class="process-hero__glance reveal reveal-d1">
          <p class="process-glance__label">The Four Steps</p>
          <ul class="process-glance__list">
            <li class="process-glance__item">
              <span class="process-glance__dot" aria-hidden="true"></span>
              <div class="process-glance__text"><strong>Discovery</strong><span>Your goals, audience, and scope</span></div>
            </li>
            <li class="process-glance__item">
              <span class="process-glance__dot" aria-hidden="true"></span>
              <div class="process-glance__text"><strong>Strategy</strong><span>The plan across the right channels</span></div>
            </li>
            <li class="process-glance__item">
              <span class="process-glance__dot" aria-hidden="true"></span>
              <div class="process-glance__text"><strong>Execute</strong><span>We produce and launch the work</span></div>
            </li>
            <li class="process-glance__item">
              <span class="process-glance__dot" aria-hidden="true"></span>
              <div class="process-glance__text"><strong>Grow &amp; Optimise</strong><span>Report and improve every month</span></div>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== PROCESS STEPS ========== -->
  <section class="section" id="steps" aria-label="Our 4-step process">
    <div class="container">

      <!-- Step 1: Discovery -->
      <div class="process-detail reveal">
        <div class="process-detail__marker" aria-hidden="true"><span class="process-dot"></span></div>
        <div class="process-detail__content">
          <h2>Discovery</h2>
          <p class="process-detail__lead">Every engagement starts with understanding your business — not guessing at tactics.</p>
          <p>We begin with a free consultation to learn your business, your goals, your customers, and your competitors. This is where we ask the questions that matter: what does success actually look like, who are you trying to reach, and what's holding growth back right now?</p>
          <p>You come out of it with a clear scope, the right priorities, and a transparent quote — tailored to your business, not a cookie-cutter package.</p>
          <div class="process-detail__deliverables">
            <h3>What you get</h3>
            <ul>
              <li>Free strategy consultation</li>
              <li>Market and competitor analysis</li>
              <li>Clear goals and success metrics</li>
              <li>Tailored scope and transparent quote</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Step 2: Strategy -->
      <div class="process-detail reveal">
        <div class="process-detail__marker" aria-hidden="true"><span class="process-dot"></span></div>
        <div class="process-detail__content">
          <h2>Strategy</h2>
          <p class="process-detail__lead">Before any work begins, we decide what will actually move your numbers.</p>
          <p>We map the plan across the channels that fit your goals — website, SEO, AI search (GEO), Google and Meta ads, and social. Not every business needs all of them, and we'll tell you what you don't.</p>
          <p>You'll see the funnel, the priorities, and the timeline, and approve the plan before we build. We also set up how we'll measure results, so success isn't a guess.</p>
          <div class="process-detail__deliverables">
            <h3>What you get</h3>
            <ul>
              <li>Channel plan — only what you need</li>
              <li>Funnel and messaging strategy</li>
              <li>Priorities and timeline</li>
              <li>Conversion-tracking plan</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Step 3: Execute -->
      <div class="process-detail reveal">
        <div class="process-detail__marker" aria-hidden="true"><span class="process-dot"></span></div>
        <div class="process-detail__content">
          <h2>Execute</h2>
          <p class="process-detail__lead">We do the work in-house, to a clear brief and a high standard.</p>
          <p>Whether it's a hand-coded website, an SEO and GEO build, ad campaigns, or social content, one team produces it — and wires up tracking first, so everything is measurable from day one.</p>
          <p>Websites are built lean and fast (typically 90+ on Google PageSpeed), campaigns launch only after conversion tracking is tested, and content ships to a consistent standard.</p>
          <div class="process-detail__deliverables">
            <h3>What you get</h3>
            <ul>
              <li>Hand-coded, fast, SEO-ready websites</li>
              <li>On-page SEO, schema, and GEO</li>
              <li>Google &amp; Meta ad campaigns, tracked</li>
              <li>Social content built to perform</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Step 4: Grow & Optimise -->
      <div class="process-detail reveal">
        <div class="process-detail__marker" aria-hidden="true"><span class="process-dot"></span></div>
        <div class="process-detail__content">
          <h2>Grow &amp; Optimise</h2>
          <p class="process-detail__lead">We don't disappear at launch. We measure, report, and keep improving.</p>
          <p>We take it live — deploy, analytics, and tracking confirmed — then watch the numbers that matter: leads, bookings, and cost per lead. Each month you get plain-English reporting and clear recommendations.</p>
          <p>From there we optimise on real data, not hunches. It's month-to-month with no lock-in, because you should stay for the results.</p>
          <div class="process-detail__deliverables">
            <h3>What you get</h3>
            <ul>
              <li>Launch, analytics, and tracking live</li>
              <li>Plain-English monthly reporting</li>
              <li>Ongoing optimisation from real data</li>
              <li>Month-to-month, no lock-in</li>
            </ul>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ========== WHY US ========== -->
  <section class="section" aria-label="Why work with us">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2>What Makes Us <span class="highlight">Different</span></h2>
      </div>
      <div class="process-why-grid">
        <div class="process-why-card reveal reveal-d1">
          <h3>No Lock-in Contracts</h3>
          <p>We earn your business every month. No long-term contracts, no cancellation fees. Stay because you want to, not because you have to.</p>
        </div>
        <div class="process-why-card reveal reveal-d2">
          <h3>Fast Turnaround</h3>
          <p>Most websites launch within 2–4 weeks. We move quickly without cutting corners, keeping you updated at every stage.</p>
        </div>
        <div class="process-why-card reveal reveal-d3">
          <h3>Transparent, Upfront Quotes</h3>
          <p>You'll know exactly what you're paying for before we start. No surprise invoices, no scope-creep charges. The price we quote is the price you pay.</p>
        </div>
        <div class="process-why-card reveal reveal-d1">
          <h3>Full-Service Team</h3>
          <p>Design, development, SEO, ads, and social media — all under one roof. One team, one point of contact, zero coordination headaches.</p>
        </div>
        <div class="process-why-card reveal reveal-d2">
          <h3>Singapore-Focused</h3>
          <p>We understand the local market, consumer behaviour, and business landscape. Your project is handled by people who know Singapore.</p>
        </div>
        <div class="process-why-card reveal reveal-d3">
          <h3>Results-Driven</h3>
          <p>We don't chase likes or vanity metrics — we chase leads, bookings, and revenue. Every decision is guided by data, performance, and your business goals.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== FAQ ========== -->
  <section class="section faq-section" aria-label="Process FAQs">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Common Questions</p>
        <h2>How We Work — <span class="highlight">Answered</span></h2>
      </div>
      <div class="faq-list reveal">
        <details class="faq-item">
          <summary>How long does your process take?</summary>
          <div class="faq-answer">
            <p>It depends on the work. A straightforward <a href="/services/website-development/">website</a> can go live in about two weeks; <a href="/services/seo-performance/">SEO</a> and content build over months; <a href="/services/paid-ads/">ad campaigns</a> can start within days. In Discovery we give you a realistic timeline for your specific scope before anything begins.</p>
          </div>
        </details>
        <details class="faq-item">
          <summary>Do I have to sign up for everything, or can I start with one service?</summary>
          <div class="faq-answer">
            <p>Start with what you need. Plenty of clients begin with a website or a single channel, then add more once it's working. In the Strategy step we recommend only what fits your goals — and tell you what you don't need.</p>
          </div>
        </details>
        <details class="faq-item">
          <summary>How much does your process cost?</summary>
          <div class="faq-answer">
            <p>There's no fixed package, because the right scope differs per business. After a short discovery call we give you a clear, transparent quote with no hidden fees. <a href="/contact/">Book a consultation</a> and we'll scope it with you.</p>
          </div>
        </details>
        <details class="faq-item">
          <summary>How involved do I need to be?</summary>
          <div class="faq-answer">
            <p>As much or as little as you like. We need you for the discovery call, sign-off on the plan and designs, and the occasional piece of input — then we run the work and keep you updated in plain language.</p>
          </div>
        </details>
        <details class="faq-item">
          <summary>What happens after launch?</summary>
          <div class="faq-answer">
            <p>We don't disappear. We confirm analytics and tracking, report monthly on the numbers that matter — leads, bookings, and cost per lead — and keep optimising on real data. It's month-to-month with no lock-in.</p>
          </div>
        </details>
      </div>
    </div>
  </section>

  <!-- ========== CTA ========== -->
  <section class="section cta-section" aria-label="Get started">
    <div class="container">
      <div class="cta-box reveal">
        <p class="section-label">Ready to Get Started?</p>
        <h2>Let's Build Something Great Together</h2>
        <p>Book a free consultation and tell us about your project. We'll get back to you within 24 hours.</p>
        <div class="cta-buttons">
          <a href="/contact/" class="btn btn-primary">Book Your Consultation</a>
          <a href="https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%27d%20like%20to%20learn%20more%20about%20your%20process." class="btn btn-secondary">Chat on WhatsApp</a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .process-hero {
    padding: 150px 0 70px;
    background: transparent;
    min-height: 92vh;
    display: flex;
    align-items: center;
  }

  .process-hero > .container {
    width: 100%;
  }

  .process-hero__grid {
    display: grid;
    grid-template-columns: 1fr 0.82fr;
    gap: 60px;
    align-items: center;
  }

  .process-hero__content {
    min-width: 0;
  }

  .process-hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 34px;
  }

  /* --- Hero glance card --- */
  .process-hero__glance {
    position: relative;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 36px 36px 36px 38px;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    min-width: 0;
  }

  .process-glance__label {
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 600;
    margin-bottom: 24px;
  }

  .process-glance__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 26px;
    position: relative;
  }

  .process-glance__list::before {
    content: '';
    position: absolute;
    left: 7px;
    top: 10px;
    bottom: 10px;
    width: 2px;
    background: rgba(73, 184, 137, 0.28);
  }

  .process-glance__item {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    position: relative;
  }

  .process-glance__dot {
    flex-shrink: 0;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px rgba(73, 184, 137, 0.14);
    margin-top: 3px;
    position: relative;
    z-index: 1;
  }

  .process-glance__text strong {
    display: block;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .process-glance__text span {
    display: block;
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-top: 3px;
  }

  .process-hero .breadcrumb {
    margin-bottom: 32px;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .process-hero .breadcrumb a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .process-hero .breadcrumb a:hover {
    color: var(--accent);
  }

  .process-hero .breadcrumb span {
    margin: 0 8px;
  }

  .process-hero h1 {
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 20px;
  }

  .process-hero__subtitle {
    font-size: 1.15rem;
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 640px;
  }

  /* --- Process Detail Steps --- */
  .process-detail {
    display: flex;
    gap: 48px;
    padding: 64px 0;
    border-bottom: 1px solid var(--border);
  }

  .process-detail:last-child {
    border-bottom: none;
  }

  .process-detail__marker {
    position: relative;
    flex-shrink: 0;
    width: 44px;
    display: flex;
    justify-content: center;
  }
  .process-detail__marker::before {
    content: '';
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    top: -64px;
    bottom: -64px;
    width: 2px;
    background: rgba(73, 184, 137, 0.22);
  }
  .process-detail:first-child .process-detail__marker::before { top: 14px; }
  .process-detail:last-child .process-detail__marker::before { bottom: calc(100% - 26px); }
  .process-dot {
    position: relative;
    z-index: 1;
    margin-top: 6px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 5px rgba(73, 184, 137, 0.14);
  }

  .process-detail__content h2 {
    font-size: 1.8rem;
    font-weight: 700;
    margin-bottom: 16px;
  }

  .process-detail__lead {
    font-size: 1.1rem;
    color: var(--text-secondary);
    margin-bottom: 16px;
    font-weight: 500;
  }

  .process-detail__content p {
    color: var(--text-muted);
    line-height: 1.75;
    margin-bottom: 12px;
  }

  .process-detail__deliverables {
    margin-top: 24px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 24px;
  }

  .process-detail__deliverables h3 {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin-bottom: 12px;
  }

  .process-detail__deliverables ul {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  .process-detail__deliverables li {
    font-size: 0.9rem;
    color: var(--text-secondary);
    padding-left: 20px;
    position: relative;
  }

  .process-detail__deliverables li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: 700;
  }

  /* --- Why Us Grid --- */
  .process-why-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 48px;
  }

  .process-why-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 32px 24px;
    transition: all var(--transition);
  }

  .process-why-card:hover {
    border-color: var(--border-accent);
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.3);
  }

  .process-why-card h3 {
    font-size: 1.05rem;
    font-weight: 700;
    margin-bottom: 10px;
  }

  .process-why-card p {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.65;
  }

  /* --- Responsive --- */
  @media (max-width: 900px) {
    .process-hero {
      min-height: 0;
    }

    .process-hero__grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .process-detail {
      flex-direction: column;
      gap: 16px;
      padding: 48px 0;
    }

    .process-detail__marker {
      width: auto;
      justify-content: flex-start;
    }
    .process-detail__marker::before { display: none; }

    .process-detail__deliverables ul {
      grid-template-columns: 1fr;
    }

    .process-why-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .process-hero {
      padding: 140px 0 40px;
    }

    .process-detail {
      padding: 36px 0;
    }

    .process-why-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
