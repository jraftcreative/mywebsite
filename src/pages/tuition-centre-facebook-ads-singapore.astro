---
import ServiceLayout from '../layouts/ServiceLayout.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Facebook & Instagram Ads for Tuition Centres Singapore",
    "description": "Facebook and Instagram (Meta) ads agency for tuition centres in Singapore. Catchment audience targeting, lead and click-to-message ads, enrolment and trial-class campaigns, retargeting, and pixel conversion tracking.",
    "provider": {
      "@type": "Organization",
      "name": "Jraft Creative",
      "url": "https://jraftcreative.com/",
      "logo": "https://jraftcreative.com/images/logo.png",
      "telephone": "+6582234578",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "60 Paya Lebar Road, Paya Lebar Square",
        "postalCode": "409051",
        "addressLocality": "Singapore",
        "addressCountry": "SG"
      }
    },
    "areaServed": { "@type": "Country", "name": "Singapore" },
    "serviceType": "Tuition Centre Facebook and Instagram Ads"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How much do Facebook and Instagram ads cost for a tuition centre in Singapore?", "acceptedAnswer": { "@type": "Answer", "text": "It depends on the size of your catchment, how many programmes you run, and which levels you want to fill — there is no single package. A centre advertising to parents in one neighbourhood like Punggol or Ang Mo Kio spends very differently from one running island-wide across several branches. Book a consultation and we will scope your audiences and give you a transparent quote." } },
      { "@type": "Question", "name": "How do you reach parents in our centre's catchment on Facebook and Instagram?", "acceptedAnswer": { "@type": "Answer", "text": "We build audiences around your actual catchment — a radius around your centre or specific areas like Tampines, Bishan or Bukit Timah — then layer on parent signals and interests such as parenting, primary and secondary education, and academic activities. We also build lookalike audiences from your existing parent list so Meta finds more families who resemble the ones already enrolled with you." } },
      { "@type": "Question", "name": "What kind of Facebook and Instagram ad works best for filling trial classes?", "acceptedAnswer": { "@type": "Answer", "text": "For tuition centres, lead ads and click-to-message ads that open a WhatsApp chat tend to bring the most enquiries, because a parent can ask about levels and timings without leaving the app. Short video of your classroom and teachers, and parent testimonials that describe the experience rather than promising results, carry those formats. We A/B test creative and keep whatever produces enquiries at the lowest cost." } },
      { "@type": "Question", "name": "How do you track enrolment enquiries from Meta ads?", "acceptedAnswer": { "@type": "Answer", "text": "We install the Meta pixel on your website and connect lead-form and click-to-message events, so every enquiry is attributed back to the exact ad and audience that produced it. The number that matters for a tuition centre is cost per enquiry and, where your admin process allows, how many of those enquiries turn into booked trials and enrolments — not likes or reach." } },
      { "@type": "Question", "name": "When should a tuition centre run Facebook and Instagram ads?", "acceptedAnswer": { "@type": "Answer", "text": "Demand from parents concentrates around the year-end and January intake as families plan the new academic year, ahead of major exam seasons when parents look for extra support, and during the March, June and holiday windows when schedules open up. We scale budget into those windows and keep a lower baseline through quieter months, because parents scroll Facebook and Instagram all year and awareness built early is cheaper to convert later." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "Facebook & Instagram Ads for Tuition Centres Singapore", "item": "https://jraftcreative.com/tuition-centre-facebook-ads-singapore/" }
    ]
  }
];
---
<style is:global>
  /* Hide the global background grid pattern on this page only */
  .animated-bg__grid { display: none; }

  /* More-prominent related-service pills — match challenge-card-v2 green treatment */
  #related-services .related-service-link {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.35);
    color: var(--text);
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  #related-services .related-service-link:hover {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.22) 0%, rgba(73, 184, 137, 0.1) 100%), rgba(20, 28, 32, 0.7);
    border-color: rgba(73, 184, 137, 0.6);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(73, 184, 137, 0.3);
  }

  /* Separate the CTA section from related-services with bg-alt */
  .service-cta-section {
    background: var(--bg-alt) !important;
  }

  /* Trial-to-Enrolment Funnel — 5-stage horizontal flow with green accents */
  .renovation-funnel {
    list-style: none;
    padding: 0;
    margin: 56px 0 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 48px;
    counter-reset: funnel;
  }
  .funnel-stage {
    position: relative;
    text-align: center;
    padding: 28px 20px;
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.28);
    border-radius: 12px;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .funnel-stage:hover {
    transform: translateY(-4px);
    border-color: rgba(73, 184, 137, 0.55);
    box-shadow: 0 16px 40px -16px rgba(73, 184, 137, 0.3);
  }
  .funnel-stage h3 {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--accent);
    margin: 0 0 8px 0;
    letter-spacing: -0.01em;
  }
  .funnel-stage p {
    font-size: 0.82rem;
    color: var(--text);
    line-height: 1.5;
    margin: 0;
  }
  .funnel-stage:not(:last-child)::after {
    content: '→';
    position: absolute;
    right: -34px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--accent);
    font-size: 1.6rem;
    font-weight: 500;
    z-index: 2;
    line-height: 1;
    opacity: 0.7;
  }
  @media (max-width: 900px) {
    .renovation-funnel {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }
    .funnel-stage:nth-child(2n)::after,
    .funnel-stage:last-child::after {
      display: none;
    }
    .funnel-stage:nth-child(2n-1)::after {
      right: -22px;
    }
  }
  @media (max-width: 600px) {
    .renovation-funnel {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .funnel-stage::after {
      display: none;
    }
  }
</style>

<ServiceLayout
  title="Facebook & Instagram Ads for Tuition Centres Singapore"
  description="Facebook and Instagram ads for tuition centres in Singapore — reach parents in your catchment and fill trial classes with lead and WhatsApp enquiries."
  canonical="https://jraftcreative.com/tuition-centre-facebook-ads-singapore/"
  ogTitle="Facebook & Instagram Ads for Tuition Centres Singapore"
  ogDescription="Facebook and Instagram ads for tuition centres in Singapore. Catchment targeting, lead and click-to-message ads, retargeting, and pixel tracking."
  ogImage="https://jraftcreative.com/images/og-tuition.jpg"
  keywords="facebook ads agency for tuition centres, tuition centre facebook ads singapore, instagram ads for tuition centres, meta ads tuition centre singapore, tuition centre lead ads singapore, tuition centre social advertising, Jraft Creative"
  schemaData={schemaData}
  heroLabel="Facebook & Instagram Ads Agency for Tuition Centres"
  heroTitle='Facebook &amp; Instagram Ads for <span class="highlight">Tuition Centres in Singapore</span>'
  heroSubtitle="Parents in your neighbourhood scroll Facebook and Instagram every evening — that is where the decision to look for tuition starts. We build and manage Meta ad campaigns for tuition centres that reach those parents by area and by the signals that mark them as your families, then turn the scroll into a lead or a WhatsApp enquiry."
  heroImage="/images/service-tuition.webp"
  heroImageAlt="Parent and child at a Singapore tuition centre — tuition centre Facebook and Instagram ads"
  heroButtons={[
    { text: "Get a Free Ad Strategy", href: "/contact/", class: "btn btn-primary" },
    { text: "See Tuition Centre Google Ads", href: "/tuition-centre-google-ads-singapore/", class: "btn btn-secondary" }
  ]}
  whatsappText="Hi Jraft Creative, I need Facebook and Instagram ads for my tuition centre in Singapore."
  ctaLabel="Fill Your Trial Classes"
  ctaTitle="Get a Free Tuition Centre Meta Ads Strategy Session"
  ctaDescription="Book a free consultation and we'll review your current social advertising, look at the parent audiences worth reaching in your catchment, and map the Facebook and Instagram campaign that brings enquiries to your centre. We'll get back to you within 24 hours."
  ctaButtons={[
    { text: "Get a Free Ad Strategy", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%20need%20Facebook%20and%20Instagram%20ads%20for%20my%20tuition%20centre%20in%20Singapore.", class: "btn btn-secondary" }
  ]}
  hideDefaultCta={false}
>

  <!-- ========== THE CHALLENGE ========== -->
  <section class="section" id="challenge" aria-label="Facebook and Instagram ads challenges for tuition centres in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Challenge</p>
        <h2>Your Classes Are <span class="highlight">Ready</span>. The Parents Nearby Have Never <span class="highlight">Heard of You</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Boosting a post reaches whoever the algorithm finds cheapest — rarely the parents in your catchment who are actually deciding on tuition.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Boosting Isn't Advertising</h3>
            <p>The boost button spends money on reach and likes with no audience control and no way to tell which spend produced an enquiry.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Parents Scroll Straight Past</h3>
            <p>A generic tile about a new term does nothing for a parent in Tampines who has never heard your centre's name. It reads as noise, not as an option.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Reach Without Enquiries</h3>
            <p>Thousands of impressions feel like progress until intake week arrives and the trial calendar is still empty. Reach is not the same as a booked parent.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHAT WE DELIVER ========== -->
  <section class="section" id="sub-services" style="background: var(--bg-alt);" aria-label="Facebook and Instagram ads services for tuition centres">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">What We Deliver</p>
        <h2>Six <span class="highlight">Pillars</span> of Tuition Centre <span class="highlight">Meta Ads</span></h2>
      </div>
      <div class="section-content reveal">
        <p>We run Facebook and Instagram the way a tuition centre actually fills seats — around the parents in your catchment, the levels you want to grow, and the enquiry that starts a trial. Pair it with <a href="/tuition-centre-google-ads-singapore/">Google Ads for parents already searching</a>, a <a href="/tuition-centre-website-singapore/">tuition centre website</a> the ads can send them to, and <a href="/tuition-centre-social-media-singapore/">organic social that keeps your page credible</a>.</p>
      </div>
      <div class="service-details-grid deliver-grid">
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-google-ads.webp');">
          <div class="service-detail-card__content">
            <h3>Catchment Audience Targeting</h3>
            <p>Parents in your radius or chosen areas — Jurong East, Bishan, Woodlands — layered with parenting and education signals so spend reaches families who can realistically attend.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-onpage-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Lead &amp; Click-to-Message Ads</h3>
            <p>Meta lead forms and click-to-WhatsApp ads let a parent ask about levels and timings inside the app. The enquiry is what you are buying, not the click.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-local-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Creative Built for Parents</h3>
            <p>Short classroom video, your teachers, and parent testimonials that describe the experience. We speak to how parents choose, and we never promise grades.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-graphic-design.webp');">
          <div class="service-detail-card__content">
            <h3>Trial-Class Landing &amp; Forms</h3>
            <p>Ads point to a page or form built for one action — enquire about a trial class. Every field a parent fills matches how your admin team follows up.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-business-website.webp');">
          <div class="service-detail-card__content">
            <h3>Retargeting Parents Who Visited</h3>
            <p>Parents who viewed your site, watched a video, or opened a form but didn't enquire see a follow-up ad — the reminder that brings shortlisters back to book.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-campaign-analytics.webp');">
          <div class="service-detail-card__content">
            <h3>Enrolment-Season Scaling</h3>
            <p>Budget scales into the year-end and January intake and the run-up to exam seasons, then eases back through quieter weeks — matched to your enrolment calendar.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHY US ========== -->
  <section class="section" id="why-us" aria-label="Why choose Jraft Creative as your tuition centre Facebook and Instagram ads agency">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2>A <span class="highlight">Meta Ads Agency</span> Built for <span class="highlight">Tuition Centres</span></h2>
      </div>
      <div class="section-content reveal">
        <p>We handle <a href="/industries/education/">education marketing in Singapore</a> across the funnel, so a tuition centre's Facebook and Instagram ads are planned alongside its search, site, and social — not run in isolation. If you are weighing platforms, our guide to <a href="/blog/google-ads-vs-meta-ads-singapore/">how Google Ads and Meta ads compare for Singapore lead generation</a> lays out where each one earns its budget.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>We Advertise to Parents</h3>
            <p>The decision-maker is a parent in your catchment, not a student. Every audience and every line of copy is built for how parents in Singapore weigh a centre.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Tracked to the Enquiry</h3>
            <p>The Meta pixel ties every lead and WhatsApp chat back to the ad that caused it. We report cost per enquiry, not reach — your budget goes straight to Meta, never marked up.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Calendar-Led Budgeting</h3>
            <p>Spend follows your intake and exam seasons and the levels you want to fill, with month-to-month flexibility. You keep full access to your own ad account throughout.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== ENQUIRY-TO-ENROLMENT FUNNEL ========== -->
  <section class="section" id="buyer-funnel" style="background: var(--bg-alt);" aria-label="Where Facebook and Instagram ads fit the tuition parent journey">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Enrolment Funnel</p>
        <h2>Where <span class="highlight">Meta Ads</span> Fit the <span class="highlight">Parent Journey</span></h2>
      </div>
      <div class="section-content reveal" style="margin-bottom: 24px;">
        <p>Parents move through the same five stages before a child starts at your centre. Facebook and Instagram own the two ends that search cannot — Reach, when a parent who was not yet looking first sees your centre in their feed, and Enquire, when a retargeting ad brings a shortlister back to send a lead or a WhatsApp message.</p>
      </div>
      <ol class="renovation-funnel reveal">
        <li class="funnel-stage">
          <h3>Reach</h3>
          <p>Meta ads put your centre in front of parents nearby</p>
        </li>
        <li class="funnel-stage">
          <h3>Engage</h3>
          <p>Classroom video, teachers, parent testimonials</p>
        </li>
        <li class="funnel-stage">
          <h3>Compare</h3>
          <p>Shortlist centres within travel distance</p>
        </li>
        <li class="funnel-stage">
          <h3>Enquire</h3>
          <p>Retargeting brings shortlisters back to message</p>
        </li>
        <li class="funnel-stage">
          <h3>Enrol</h3>
          <p>Book a trial, join the term &amp; refer</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ========== FAQ ========== -->
  <section class="section faq-section" id="faq" style="background: var(--bg-alt);" aria-label="Frequently asked questions about Facebook and Instagram ads for tuition centres">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">FAQ</p>
        <h2>Meta Ads for <span class="highlight">Tuition Centres</span> — Questions Answered</h2>
      </div>
      <div class="faq-list">
        <details class="faq-item reveal reveal-d1">
          <summary>How much do Facebook and Instagram ads cost for a tuition centre in Singapore?</summary>
          <div class="faq-answer"><p>It depends on the size of your catchment, how many programmes you run, and which levels you want to fill — there's no single package. A centre advertising to parents in one neighbourhood like Punggol or Ang Mo Kio spends very differently from one running island-wide across several branches. Book a consultation and we'll scope your audiences and give you a transparent quote.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>How do you reach parents in our centre's catchment on Facebook and Instagram?</summary>
          <div class="faq-answer"><p>We build audiences around your actual catchment — a radius around your centre or specific areas like Tampines, Bishan or Bukit Timah — then layer on parent signals and interests such as parenting, primary and secondary education, and academic activities. We also build lookalike audiences from your existing parent list so Meta finds more families who resemble the ones already enrolled with you.</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>What kind of Facebook and Instagram ad works best for filling trial classes?</summary>
          <div class="faq-answer"><p>For tuition centres, lead ads and click-to-message ads that open a WhatsApp chat tend to bring the most enquiries, because a parent can ask about levels and timings without leaving the app. Short video of your classroom and teachers, and parent testimonials that describe the experience rather than promising results, carry those formats. We A/B test creative and keep whatever produces enquiries at the lowest cost.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>How do you track enrolment enquiries from Meta ads?</summary>
          <div class="faq-answer"><p>We install the Meta pixel on your website and connect lead-form and click-to-message events, so every enquiry is attributed back to the exact ad and audience that produced it. The number that matters for a tuition centre is cost per enquiry and, where your admin process allows, how many of those enquiries turn into booked trials and enrolments — not likes or reach.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>When should a tuition centre run Facebook and Instagram ads?</summary>
          <div class="faq-answer"><p>Demand from parents concentrates around the year-end and January intake as families plan the new academic year, ahead of major exam seasons when parents look for extra support, and during the March, June and holiday windows when schedules open up. We scale budget into those windows and keep a lower baseline through quieter months, because parents scroll Facebook and Instagram all year and awareness built early is cheaper to convert later.</p></div>
        </details>
      </div>
    </div>
  </section>

  <!-- Related Services -->
  <section class="section" id="related-services" aria-label="Related services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Explore More</p>
        <h2>More <span class="highlight">Tuition Centre</span> Services</h2>
      </div>
      <div class="related-services-grid reveal">
          <a href="/tuition-centre-marketing-singapore/" class="related-service-link">Tuition Centre Marketing</a>
          <a href="/tuition-centre-seo-singapore/" class="related-service-link">Tuition Centre SEO</a>
          <a href="/tuition-centre-ai-search-optimisation-singapore/" class="related-service-link">Tuition Centre GEO</a>
          <a href="/tuition-centre-google-ads-singapore/" class="related-service-link">Tuition Centre Google Ads</a>
          <a href="/tuition-centre-social-media-singapore/" class="related-service-link">Tuition Centre Social Media</a>
          <a href="/tuition-centre-branding-singapore/" class="related-service-link">Tuition Centre Branding</a>
          <a href="/tuition-centre-website-singapore/" class="related-service-link">Tuition Centre Websites</a>
      </div>
    </div>
  </section>
</ServiceLayout>
