---
import ServiceLayout from '../layouts/ServiceLayout.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Tuition Centre SEO Singapore",
    "description": "SEO services for tuition centres in Singapore. Local SEO, Google Business Profile optimisation, subject and level page SEO, and parent-focused content strategy to attract more enrolment enquiries",
    "provider": {
      "@type": "Organization",
      "name": "Jraft Creative",
      "url": "https://jraftcreative.com/",
      "logo": "https://jraftcreative.com/images/logo.png",
      "telephone": "+6582234578",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "60 Paya Lebar Road, Paya Lebar Square",
        "postalCode": "409051",
        "addressLocality": "Singapore",
        "addressCountry": "SG"
      }
    },
    "areaServed": { "@type": "Country", "name": "Singapore" },
    "serviceType": "Tuition Centre SEO"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How much does SEO cost for a tuition centre in Singapore?", "acceptedAnswer": { "@type": "Answer", "text": "Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote." } },
      { "@type": "Question", "name": "How long does it take for tuition centre SEO to produce results?", "acceptedAnswer": { "@type": "Answer", "text": "Most tuition centres see measurable improvements in search rankings within 3 to 6 months. Subject and neighbourhood keywords like 'PSLE tuition Tampines' or 'English tuition Bishan' often rank faster than broad competitive terms. Google Business Profile optimisation and technical fixes usually deliver quick visibility gains in the first few weeks." } },
      { "@type": "Question", "name": "What keywords do parents search for when looking for tuition?", "acceptedAnswer": { "@type": "Answer", "text": "Common searches include 'tuition centre near me', 'PSLE tuition Tampines', 'secondary math tuition Singapore', 'English tuition Bishan', and 'A level tuition Singapore'. We research and target the exact subject, level, and neighbourhood terms parents in your area are typing into Google." } },
      { "@type": "Question", "name": "Can you optimise pages for each subject and level we teach?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. A dedicated page for each subject and level is one of the strongest SEO assets a tuition centre has. We build and optimise pages for primary and secondary tuition, PSLE prep, O-Level, A-Level, and IP — across English, Math, Science, Chinese, and Higher Chinese — so your centre ranks for specific parent searches like 'secondary math tuition Singapore' or 'Higher Chinese tuition'." } },
      { "@type": "Question", "name": "Do you handle SEO for tuition centres with multiple branches?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We create unique location pages for each branch, optimise separate Google Business Profiles, and build neighbourhood-specific content so every centre ranks in its own area — Tampines, Jurong East, Bishan, Bukit Timah, Punggol, Woodlands, and beyond. Whether you run two outlets or ten across Singapore, each location gets targeted visibility in its neighbourhood." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "Tuition Centre SEO Singapore", "item": "https://jraftcreative.com/tuition-centre-seo-singapore/" }
    ]
  }
];
---

<style is:global>
  /* Hide the global background grid pattern on this page only */
  .animated-bg__grid { display: none; }

  /* More-prominent related-service pills — match challenge-card-v2 green treatment */
  #related-services .related-service-link {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.35);
    color: var(--text);
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  #related-services .related-service-link:hover {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.22) 0%, rgba(73, 184, 137, 0.1) 100%), rgba(20, 28, 32, 0.7);
    border-color: rgba(73, 184, 137, 0.6);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(73, 184, 137, 0.3);
  }

  /* Separate the CTA section from related-services with bg-alt */
  .service-cta-section {
    background: var(--bg-alt) !important;
  }

  /* Enrolment Funnel — 5-stage horizontal flow with green accents */
  .renovation-funnel {
    list-style: none;
    padding: 0;
    margin: 56px 0 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 48px;
    counter-reset: funnel;
  }
  .funnel-stage {
    position: relative;
    text-align: center;
    padding: 28px 20px;
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.28);
    border-radius: 12px;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .funnel-stage:hover {
    transform: translateY(-4px);
    border-color: rgba(73, 184, 137, 0.55);
    box-shadow: 0 16px 40px -16px rgba(73, 184, 137, 0.3);
  }
  .funnel-stage h3 {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--accent);
    margin: 0 0 8px 0;
    letter-spacing: -0.01em;
  }
  .funnel-stage p {
    font-size: 0.82rem;
    color: var(--text);
    line-height: 1.5;
    margin: 0;
  }
  .funnel-stage:not(:last-child)::after {
    content: '→';
    position: absolute;
    right: -34px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--accent);
    font-size: 1.6rem;
    font-weight: 500;
    z-index: 2;
    line-height: 1;
    opacity: 0.7;
  }
  @media (max-width: 900px) {
    .renovation-funnel {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }
    .funnel-stage:nth-child(2n)::after,
    .funnel-stage:last-child::after {
      display: none;
    }
    .funnel-stage:nth-child(2n-1)::after {
      right: -22px;
    }
  }
  @media (max-width: 600px) {
    .renovation-funnel {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .funnel-stage::after {
      display: none;
    }
  }
</style>

<ServiceLayout
  title="Tuition Centre SEO Singapore — SEO Agency"
  description="SEO for tuition centres in Singapore — local SEO, subject/level pages, and a Google Business Profile that turns 'tuition near me' into enrolment enquiries."
  canonical="https://jraftcreative.com/tuition-centre-seo-singapore/"
  ogTitle="Tuition Centre SEO Singapore — SEO Agency"
  ogDescription="SEO agency for tuition centres in Singapore. Local SEO, subject and level page optimisation, and a Google Business Profile that turns 'tuition near me' searches into enrolment enquiries."
  ogImage="https://jraftcreative.com/images/og-tuition.jpg"
  keywords="tuition centre seo singapore, seo agency for tuition centres, seo for tuition centres, tuition centre marketing singapore, PSLE tuition seo, secondary tuition seo, tuition centre google ranking, tuition centre local seo, Jraft Creative"
  schemaData={schemaData}
  heroLabel="SEO Agency for Tuition Centres"
  heroTitle='SEO Agency for <span class="highlight">Tuition Centres in Singapore</span>'
  heroSubtitle="Parents searching 'tuition centre near me' and 'PSLE tuition Tampines' are ready to enrol. If your centre doesn't appear in those search results, those families are booking a trial lesson with your competitor instead. We help tuition centres rank higher on Google and turn search visibility into enrolment enquiries."
  heroImage="/images/service-tuition.webp"
  heroImageAlt="Tuition centre classroom in Singapore — tuition centre SEO"
  heroButtons={[
    { text: "Get a Free SEO Audit", href: "/contact/", class: "btn btn-primary" },
    { text: "See Tuition Centre Google Ads", href: "/tuition-centre-google-ads-singapore/", class: "btn btn-secondary" }
  ]}
  whatsappText="Hi Jraft Creative, I need SEO for my tuition centre in Singapore."
  ctaLabel="Get Found by More Parents"
  ctaTitle="Get a Free Tuition Centre SEO Audit"
  ctaDescription="Book a free consultation and we'll review how your centre currently ranks for subject, level, and neighbourhood searches, check your Google Business Profile, and show you where the enrolment enquiries are leaking. We'll get back to you within 24 hours."
  ctaButtons={[
    { text: "Get a Free SEO Audit", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%20need%20SEO%20for%20my%20tuition%20centre%20in%20Singapore.", class: "btn btn-secondary" }
  ]}
  hideDefaultCta={false}
>

  <!-- ========== THE CHALLENGE ========== -->
  <section class="section" id="challenge" aria-label="SEO challenges for tuition centres in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Challenge</p>
        <h2>Parents Search for <span class="highlight">Tuition</span> Online — Does Your Centre <span class="highlight">Show Up</span>?</h2>
      </div>
      <div class="section-content reveal">
        <p>Parents start on Google, compare a handful of centres near them, and book a trial — often before school pickup is over.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Invisible in the Search That Matters</h3>
            <p>"Tuition centre near me" is searched thousands of times a month in Singapore. If your centre isn't in those results, those parents never know you exist.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Crowded Market, One Pool of Parents</h3>
            <p>Established chains and neighbourhood specialists compete for the same families. Centres investing in search quietly take the top positions without spending more on ads.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Search Demand Is Fragmented</h3>
            <p>English, Math, Science, Chinese and Higher Chinese — each across PSLE, O-Level, A-Level and IP, in several neighbourhoods. Without structure, centres spread thin and rank for nothing.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHAT WE DELIVER ========== -->
  <section class="section" id="sub-services" style="background: var(--bg-alt);" aria-label="SEO services for tuition centres">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">What We Deliver</p>
        <h2>Six <span class="highlight">Pillars</span> of Tuition Centre <span class="highlight">SEO</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Parents search by subject, level, exam and neighbourhood — so we build the site around how families actually look for tuition, and pair it with a <a href="/tuition-centre-website-singapore/">tuition centre website</a> that converts, <a href="/tuition-centre-social-media-singapore/">social media</a> that keeps you top of mind, and <a href="/tuition-centre-google-ads-singapore/">Google Ads</a> for visibility while rankings build.</p>
      </div>
      <div class="service-details-grid deliver-grid">
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-seo-audit.webp');">
          <div class="service-detail-card__content">
            <h3>Technical SEO Audit</h3>
            <p>A full crawl for indexing issues, broken links, missing schema and slow mobile loads — the barriers stopping Google ranking you at all.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-onpage-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Subject &amp; Level Pages</h3>
            <p>A dedicated page per subject and level — English, Math, Science, Chinese, Higher Chinese across PSLE, O-Level, A-Level and IP — each structured to rank on its own.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-local-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Local SEO &amp; Google Business Profile</h3>
            <p>Class photos, schedules, review management and citations — built to land you in the Maps three-pack for "tuition near me" and neighbourhood searches.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-ai.webp');">
          <div class="service-detail-card__content">
            <h3>Subject Keyword Clusters</h3>
            <p>Math, Science, English and Chinese each have their own search landscape. Every subject gets its own page and ranking strategy, mapped to small-group and 1-to-1 formats.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-graphic-design.webp');">
          <div class="service-detail-card__content">
            <h3>Exam &amp; Level Targeting</h3>
            <p>"PSLE tuition Tampines" and "A level tuition Singapore" are parents ready to commit. We optimise across PSLE prep, O-Level, A-Level and IP at every level.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-speed-vitals.webp');">
          <div class="service-detail-card__content">
            <h3>Content Built for Research Mode</h3>
            <p>Guides answering "how to prepare for PSLE" or "is secondary tuition worth it" — earning authority and traffic from parents still deciding, including holiday programme demand.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHY US ========== -->
  <section class="section" id="why-us" aria-label="Why choose Jraft Creative as your tuition centre SEO agency">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2>An <span class="highlight">SEO Agency</span> That Understands <span class="highlight">Tuition Centres</span></h2>
      </div>
      <div class="section-content reveal">
        <p>We handle <a href="/industries/education/">education marketing in Singapore</a> across tuition and enrichment centres that need to rank for dozens of subject, level and neighbourhood combinations. If you want the detail on the local side, our guide on <a href="/blog/rank-google-maps-singapore/">how to rank in the Google Maps three-pack</a> walks through exactly what we optimise.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Built Around Enrolment, Not Traffic</h3>
            <p>Rankings only matter if enquiries come in. We optimise the path from search result to enquiry, not just the position on the page.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Transparent Monthly Reporting</h3>
            <p>Rankings by subject and level, organic traffic, Google Business Profile performance and enquiry data. No jargon, just whether more parents are finding you.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Website, SEO &amp; Ads Together</h3>
            <p>We handle <a href="/tuition-centre-website-singapore/">tuition centre web design</a> and <a href="/tuition-centre-google-ads-singapore/">Google Ads</a> under one roof — one system for enrolment enquiries.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== ENROLMENT FUNNEL ========== -->
  <section class="section" id="buyer-funnel" style="background: var(--bg-alt);" aria-label="Where SEO fits the parent journey for tuition centres">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Enrolment Funnel</p>
        <h2>Where <span class="highlight">Organic Search</span> Fits the <span class="highlight">Parent Journey</span></h2>
      </div>
      <div class="section-content reveal" style="margin-bottom: 24px;">
        <p>Parents move through the same five stages before a child starts tuition. SEO owns the earliest and most repeated moments — Discover, when the first subject or "near me" search happens, and Validate, when a parent checks whether your teaching is credible.</p>
      </div>
      <ol class="renovation-funnel reveal">
        <li class="funnel-stage">
          <h3>Discover</h3>
          <p>Organic results catch the first subject search</p>
        </li>
        <li class="funnel-stage">
          <h3>Validate</h3>
          <p>Teacher credentials, results, Google reviews</p>
        </li>
        <li class="funnel-stage">
          <h3>Compare</h3>
          <p>Shortlist centres within travel distance</p>
        </li>
        <li class="funnel-stage">
          <h3>Trial</h3>
          <p>Subject pages turn the shortlist into a trial</p>
        </li>
        <li class="funnel-stage">
          <h3>Enrol</h3>
          <p>Sign for the term, renew &amp; refer</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ========== PRICING ========== -->
  <!-- ========== FAQ ========== -->
  <section class="section faq-section" id="faq" style="background: var(--bg-alt);" aria-label="Frequently asked questions about tuition centre SEO in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">FAQ</p>
        <h2>Tuition Centre <span class="highlight">SEO</span> — Questions Answered</h2>
      </div>
      <div class="faq-list">
        <details class="faq-item reveal reveal-d1">
          <summary>How much does SEO cost for a tuition centre in Singapore?</summary>
          <div class="faq-answer"><p>Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>How long does it take for tuition centre SEO to produce results?</summary>
          <div class="faq-answer"><p>Most tuition centres see measurable improvements in search rankings within 3 to 6 months. Subject and neighbourhood keywords like "PSLE tuition Tampines" or "English tuition Bishan" often rank faster than broad competitive terms. Google Business Profile optimisation and technical fixes usually deliver quick visibility gains in the first few weeks.</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>What keywords do parents search for when looking for tuition?</summary>
          <div class="faq-answer"><p>Common searches include "tuition centre near me", "PSLE tuition Tampines", "secondary math tuition Singapore", "English tuition Bishan", and "A level tuition Singapore". We research and target the exact subject, level, and neighbourhood terms parents in your area — Jurong East, Punggol, Woodlands, Ang Mo Kio, Bukit Timah — are typing into Google.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>Can you optimise pages for each subject and level we teach?</summary>
          <div class="faq-answer"><p>Yes. A dedicated page for each subject and level is one of the strongest SEO assets a tuition centre has. We build and optimise pages for primary and secondary tuition, PSLE prep, O-Level, A-Level, and IP — across English, Math, Science, Chinese, and Higher Chinese, for both small-group and 1-to-1 formats — so your centre ranks for specific parent searches like "secondary math tuition Singapore" or "Higher Chinese tuition".</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>Do you handle SEO for tuition centres with multiple branches?</summary>
          <div class="faq-answer"><p>Yes. We create unique location pages for each branch, optimise separate Google Business Profiles, and build neighbourhood-specific content so every centre ranks in its own area — Tampines, Jurong East, Bishan, Bukit Timah, Punggol, Woodlands, and beyond. Whether you run two outlets or ten across Singapore, each location gets targeted visibility in its neighbourhood.</p></div>
        </details>
      </div>
    </div>
  </section>


  <!-- Related Services -->
  <section class="section" id="related-services" aria-label="Related services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Explore More</p>
        <h2>More <span class="highlight">Tuition Centre</span> Services</h2>
      </div>
      <div class="related-services-grid reveal">
          <a href="/tuition-centre-marketing-singapore/" class="related-service-link">Tuition Centre Marketing</a>
          <a href="/tuition-centre-ai-search-optimisation-singapore/" class="related-service-link">Tuition Centre GEO</a>
          <a href="/tuition-centre-google-ads-singapore/" class="related-service-link">Tuition Centre Google Ads</a>
          <a href="/tuition-centre-facebook-ads-singapore/" class="related-service-link">Tuition Centre Facebook Ads</a>
          <a href="/tuition-centre-social-media-singapore/" class="related-service-link">Tuition Centre Social Media</a>
          <a href="/tuition-centre-branding-singapore/" class="related-service-link">Tuition Centre Branding</a>
          <a href="/tuition-centre-website-singapore/" class="related-service-link">Tuition Centre Websites</a>
      </div>
    </div>
  </section>
</ServiceLayout>
</parameter>
</invoke>
