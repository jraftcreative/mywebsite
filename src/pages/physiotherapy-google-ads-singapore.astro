---
import ServiceLayout from '../layouts/ServiceLayout.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Google Ads Agency for Physiotherapy Clinics Singapore",
    "description": "Google Ads agency for physiotherapy clinics in Singapore. Condition-specific search campaigns, neighbourhood targeting and conversion tracking, built to book assessments within Singapore's healthcare advertising rules.",
    "provider": {
      "@type": "Organization",
      "name": "Jraft Creative",
      "url": "https://jraftcreative.com/",
      "logo": "https://jraftcreative.com/images/logo.png",
      "telephone": "+6582234578",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "60 Paya Lebar Road, Paya Lebar Square",
        "postalCode": "409051",
        "addressLocality": "Singapore",
        "addressCountry": "SG"
      }
    },
    "areaServed": { "@type": "Country", "name": "Singapore" },
    "serviceType": "Physiotherapy Google Ads"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How much do Google Ads cost for a physiotherapy clinic in Singapore?", "acceptedAnswer": { "@type": "Answer", "text": "It depends on the conditions you promote and your area. Terms like 'sports physio' and 'post surgery rehab' are more competitive than general neighbourhood searches. Book a consultation and we'll scope a budget matched to the treatments you want to fill and give you a transparent quote." } },
      { "@type": "Question", "name": "Which physiotherapy searches are worth advertising on?", "acceptedAnswer": { "@type": "Answer", "text": "High-intent, condition-driven searches give the best return — 'physiotherapy near me', 'sports physio', 'back pain physio', 'post surgery rehab', and 'frozen shoulder physiotherapy'. We usually anchor spend on the conditions your therapists want more of, then expand by neighbourhood from there." } },
      { "@type": "Question", "name": "Is physiotherapy advertising allowed on Google in Singapore?", "acceptedAnswer": { "@type": "Answer", "text": "Yes, within Google's healthcare advertising policies and Singapore's rules for AHPC-registered allied health providers. We write compliant ad copy that describes your scope of care without guaranteeing recovery or making misleading efficacy claims, so ads run without disapprovals or account risk." } },
      { "@type": "Question", "name": "How do you track whether the ads produce bookings?", "acceptedAnswer": { "@type": "Answer", "text": "We set up conversion tracking for booking forms, calls and WhatsApp clicks, pass GCLID through to your booking system, then attribute each enquiry to the keyword and ad that produced it. For a clinic the meaningful number is booked assessments and cost per booking, which is what we report." } },
      { "@type": "Question", "name": "Can Google Ads work for a new physiotherapy clinic?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Ads level the field because you appear based on relevance and bid, not years of referrals. A new clinic can generate enquiries from day one by targeting patients actively searching for treatment in its neighbourhood." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "Google Ads Agency for Physiotherapy Clinics Singapore", "item": "https://jraftcreative.com/physiotherapy-google-ads-singapore/" }
    ]
  }
];
---

<style is:global>
  /* Hide the global background grid pattern on this page only */
  .animated-bg__grid { display: none; }

  /* More-prominent related-service pills — match challenge-card-v2 green treatment */
  #related-services .related-service-link {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.35);
    color: var(--text);
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  #related-services .related-service-link:hover {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.22) 0%, rgba(73, 184, 137, 0.1) 100%), rgba(20, 28, 32, 0.7);
    border-color: rgba(73, 184, 137, 0.6);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(73, 184, 137, 0.3);
  }
  .service-cta-section { background: var(--bg-alt) !important; }
  .renovation-funnel { list-style: none; padding: 0; margin: 56px 0 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 48px; }
  .funnel-stage { position: relative; text-align: center; padding: 28px 20px; background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6); border: 1px solid rgba(73, 184, 137, 0.28); border-radius: 12px; transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease; }
  .funnel-stage:hover { transform: translateY(-4px); border-color: rgba(73, 184, 137, 0.55); box-shadow: 0 16px 40px -16px rgba(73, 184, 137, 0.3); }
  .funnel-stage h3 { font-size: 1.05rem; font-weight: 600; color: var(--accent); margin: 0 0 8px 0; letter-spacing: -0.01em; }
  .funnel-stage p { font-size: 0.82rem; color: var(--text); line-height: 1.5; margin: 0; }
  .funnel-stage:not(:last-child)::after { content: '→'; position: absolute; right: -34px; top: 50%; transform: translateY(-50%); color: var(--accent); font-size: 1.6rem; font-weight: 500; z-index: 2; line-height: 1; opacity: 0.7; }
  @media (max-width: 900px) { .renovation-funnel { grid-template-columns: repeat(2, 1fr); gap: 32px; } .funnel-stage:nth-child(2n)::after, .funnel-stage:last-child::after { display: none; } .funnel-stage:nth-child(2n-1)::after { right: -22px; } }
  @media (max-width: 600px) { .renovation-funnel { grid-template-columns: 1fr; gap: 20px; } .funnel-stage::after { display: none; } }
</style>

<ServiceLayout
  title="Google Ads Agency for Physiotherapy Clinics Singapore"
  description="Google Ads for physiotherapy clinics in Singapore — condition-specific campaigns for sports physio, back pain and post-op rehab that book assessments."
  canonical="https://jraftcreative.com/physiotherapy-google-ads-singapore/"
  ogTitle="Google Ads Agency for Physiotherapy Clinics Singapore"
  ogDescription="Google Ads for physiotherapy clinics in Singapore. Condition-specific campaigns and conversion tracking built to book assessments, not clicks."
  ogImage="https://jraftcreative.com/images/og-physiotherapy.jpg"
  keywords="google ads agency for physiotherapy clinics, physiotherapy clinic google ads singapore, physio ppc singapore, physiotherapy advertising singapore, sports physio ads, back pain physio ads, Jraft Creative"
  schemaData={schemaData}
  heroLabel="Google Ads Agency for Physiotherapy Clinics"
  heroTitle='Google Ads Agency for <span class="highlight">Physiotherapy Clinics in Singapore</span>'
  heroSubtitle="Someone with a fresh sports injury or a slipped disc is ready to book an assessment today. We run Google Ads for physiotherapy clinics that capture those searches — by condition, by neighbourhood, at the moment the patient decides to get help."
  heroImage="/images/hero-physiotherapy-poster.jpg"
  heroImageAlt="Physiotherapist treating a patient in a Singapore clinic — google ads"
  heroButtons={[
    { text: "Get a Free Ad Strategy", href: "/contact/", class: "btn btn-primary" },
    { text: "See Physiotherapy SEO", href: "/physiotherapy-seo-singapore/", class: "btn btn-secondary" }
  ]}
  whatsappText="Hi Jraft Creative, I need Google Ads for my physiotherapy clinic in Singapore."
  ctaLabel="Fill Your Appointment Book"
  ctaTitle="Get a Free Physiotherapy Ads Strategy Session"
  ctaDescription="Book a free consultation and we'll review your current ad performance, look at which conditions are worth bidding on in your area, and map the searches patients near your clinic are making. We'll get back to you within 24 hours."
  ctaButtons={[
    { text: "Get a Free Ad Strategy", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%20need%20Google%20Ads%20for%20my%20physiotherapy%20clinic%20in%20Singapore.", class: "btn btn-secondary" }
  ]}
  hideDefaultCta={false}
>

  <!-- ========== THE CHALLENGE ========== -->
  <section class="section" id="challenge" aria-label="Google Ads challenges for physiotherapy clinics in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Challenge</p>
        <h2>Paying for Clicks That Never <span class="highlight">Book</span>?</h2>
      </div>
      <div class="section-content reveal">
        <p>Patients searching for physio have a specific problem and want it seen now. A poorly built account spends the budget on the wrong searches and never books an assessment.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Broad Keywords, Wasted Budget</h3>
            <p>Untuned campaigns bid on 'physiotherapy' with no condition or area attached — burning spend on students, browsers and clicks from the wrong side of the island.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>High-Intent Moments Missed</h3>
            <p>A patient searching 'back pain physio Novena' or 'sports physio near me' books within the hour. If you're not visible at that moment, the appointment goes to whoever is.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Healthcare Rules Restrict the Copy</h3>
            <p>Allied health advertising is regulated. Without compliant copy, ads get disapproved — or the account gets suspended mid-campaign — and you lose visibility when it matters.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHAT WE DELIVER ========== -->
  <section class="section" id="sub-services" style="background: var(--bg-alt);" aria-label="Google Ads services for physiotherapy clinics">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">What We Deliver</p>
        <h2>Six <span class="highlight">Pillars</span> of Physiotherapy Clinic <span class="highlight">Google Ads</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Every campaign is condition-specific, compliant with Singapore's healthcare advertising rules, and judged on booked assessments rather than clicks. Not sure whether to weight Google or Meta first? Our guide to <a href="/blog/google-ads-vs-meta-ads-singapore/">Google Ads versus Meta ads for Singapore clinics</a> walks through where each channel earns its place. We also build the <a href="/physiotherapy-website-singapore/">clinic website</a>, run <a href="/physiotherapy-seo-singapore/">physiotherapy SEO</a>, and manage the <a href="/physiotherapy-social-media-singapore/">social media</a> the ads work alongside.</p>
      </div>
      <div class="service-details-grid deliver-grid">
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-google-ads.webp');">
          <div class="service-detail-card__content">
            <h3>Condition-Specific Campaigns</h3>
            <p>Separate campaigns for sports injuries, back and neck pain, post surgery rehab and elderly mobility — so budget follows the conditions your therapists most want to fill.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-meta-ads.webp');">
          <div class="service-detail-card__content">
            <h3>Urgent &amp; Same-Week Ads</h3>
            <p>High-intent campaigns for 'sports physio' and 'back pain physio' searches, plus Meta retargeting where it fits, catching patients while the injury is fresh.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-local-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Neighbourhood &amp; Radius Targeting</h3>
            <p>Ads focused on Novena, Tanjong Pagar, Orchard, Tampines, Jurong, Katong and Bishan and the MRT lines that feed them, so you stop paying for clicks from too far to attend.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-campaign-analytics.webp');">
          <div class="service-detail-card__content">
            <h3>Compliant Ad Copy</h3>
            <p>Ad copy written within Google's healthcare policies and the rules for AHPC-registered providers — describing your scope of care without guaranteeing recovery — protecting your account and your standing.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-landing-page.webp');">
          <div class="service-detail-card__content">
            <h3>Conversion-Ready Landing Pages</h3>
            <p>Condition landing pages built to turn a click into a booking — therapist credentials, clear treatment detail, trust signals and a one-tap enquiry.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-analytics-reporting.webp');">
          <div class="service-detail-card__content">
            <h3>Cost-Per-Booking Reporting</h3>
            <p>We track click to booked assessment, pass GCLID through to your booking system, and report cost per booking by condition, so you know exactly what each new patient costs.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHY US ========== -->
  <section class="section" id="why-us" aria-label="Why choose Jraft Creative for physiotherapy google ads">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2>A <span class="highlight">Google Ads Agency</span> Built for <span class="highlight">Physiotherapy Clinics</span></h2>
      </div>
      <div class="section-content reveal">
        <p>We manage physiotherapy ad accounts to a single number — cost per booked assessment — and keep every campaign compliant. It sits inside our wider <a href="/industries/healthcare/">healthcare marketing in Singapore</a> practice, so the ads, the website and the search presence pull in the same direction.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Physio Sector Expertise</h3>
            <p>We know which condition keywords convert, how to structure campaigns by treatment area, and the line between compliant copy and a disapproved ad in allied health.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Transparent Ad Spend</h3>
            <p>Your budget goes straight to Google, never marked up. The account stays in your name, so you see every dollar and what each booking costs.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Ads, SEO &amp; Website Together</h3>
            <p>We also run <a href="/physiotherapy-seo-singapore/">physiotherapy SEO</a> and build the <a href="/physiotherapy-website-singapore/">clinic website</a> the ads land on — one system, one goal.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== PATIENT JOURNEY FUNNEL ========== -->
  <section class="section" id="buyer-funnel" style="background: var(--bg-alt);" aria-label="Where google ads fits the patient journey">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Patient Journey</p>
        <h2>Where <span class="highlight">Google Ads</span> Fits the <span class="highlight">Patient Journey</span></h2>
      </div>
      <div class="section-content reveal" style="margin-bottom: 24px;">
        <p>A physio patient moves through five stages before booking. Google Ads owns the two highest-intent moments — Discover, when they first search a condition or 'physio near me', and Book, when a remarketing ad brings a researcher back.</p>
      </div>
      <ol class="renovation-funnel reveal">
        <li class="funnel-stage"><h3>Discover</h3><p>An ad captures the first condition search</p></li>
        <li class="funnel-stage"><h3>Research</h3><p>They read treatment detail and therapist credentials</p></li>
        <li class="funnel-stage"><h3>Compare</h3><p>Reviews, location and panel status weigh the clinics</p></li>
        <li class="funnel-stage"><h3>Book</h3><p>Remarketing and a clear landing page close it</p></li>
        <li class="funnel-stage"><h3>Treat</h3><p>A good first assessment, then a plan &amp; referrals</p></li>
      </ol>
    </div>
  </section>

  <!-- ========== FAQ ========== -->
  <section class="section faq-section" id="faq" style="background: var(--bg-alt);" aria-label="Frequently asked questions about physiotherapy google ads">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">FAQ</p>
        <h2>Physiotherapy Google Ads — <span class="highlight">Questions Answered</span></h2>
      </div>
      <div class="faq-list">
        <details class="faq-item reveal reveal-d1">
          <summary>How much do Google Ads cost for a physiotherapy clinic in Singapore?</summary>
          <div class="faq-answer"><p>It depends on the conditions you promote and your area. Terms like 'sports physio' and 'post surgery rehab' are more competitive than general neighbourhood searches. Book a consultation and we'll scope a budget matched to the treatments you want to fill and give you a transparent quote.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>Which physiotherapy searches are worth advertising on?</summary>
          <div class="faq-answer"><p>High-intent, condition-driven searches give the best return — 'physiotherapy near me', 'sports physio', 'back pain physio', 'post surgery rehab', and 'frozen shoulder physiotherapy'. We usually anchor spend on the conditions your therapists want more of, then expand by neighbourhood from there.</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>Is physiotherapy advertising allowed on Google in Singapore?</summary>
          <div class="faq-answer"><p>Yes, within Google's healthcare advertising policies and Singapore's rules for AHPC-registered allied health providers. We write compliant ad copy that describes your scope of care without guaranteeing recovery or making misleading efficacy claims, so ads run without disapprovals or account risk.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>How do you track whether the ads produce bookings?</summary>
          <div class="faq-answer"><p>We set up conversion tracking for booking forms, calls and WhatsApp clicks, pass GCLID through to your booking system, then attribute each enquiry to the keyword and ad that produced it. For a clinic the meaningful number is booked assessments and cost per booking, which is what we report.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>Can Google Ads work for a new physiotherapy clinic?</summary>
          <div class="faq-answer"><p>Yes. Ads level the field because you appear based on relevance and bid, not years of referrals. A new clinic can generate enquiries from day one by targeting patients actively searching for treatment in its neighbourhood.</p></div>
        </details>
      </div>
    </div>
  </section>

  <!-- Related Services -->
  <section class="section" id="related-services" aria-label="Related services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Explore More</p>
        <h2>More <span class="highlight">Physiotherapy Clinic</span> Services</h2>
      </div>
      <div class="related-services-grid reveal">
          <a href="/physiotherapy-marketing-singapore/" class="related-service-link">Physiotherapy Marketing</a>
          <a href="/physiotherapy-seo-singapore/" class="related-service-link">Physiotherapy SEO</a>
          <a href="/physiotherapy-ai-search-optimisation-singapore/" class="related-service-link">Physiotherapy GEO</a>
          <a href="/physiotherapy-social-media-singapore/" class="related-service-link">Physiotherapy Social Media</a>
          <a href="/physiotherapy-branding-singapore/" class="related-service-link">Physiotherapy Branding</a>
          <a href="/physiotherapy-website-singapore/" class="related-service-link">Physiotherapy Websites</a>
      </div>
    </div>
  </section>
</ServiceLayout>
