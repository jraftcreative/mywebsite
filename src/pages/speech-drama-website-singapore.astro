---
import ServiceLayout from '../layouts/ServiceLayout.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Speech & Drama Website Design Singapore",
    "description": "Custom website design for speech and drama enrichment schools in Singapore — programme pages by level, trial class booking, performance highlights, instructor profiles, and local SEO.",
    "provider": {
      "@type": "Organization",
      "name": "Jraft Creative",
      "url": "https://jraftcreative.com/",
      "logo": "https://jraftcreative.com/images/logo.png",
      "telephone": "+6582234578",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "60 Paya Lebar Road, Paya Lebar Square",
        "postalCode": "409051",
        "addressLocality": "Singapore",
        "addressCountry": "SG"
      }
    },
    "areaServed": { "@type": "Country", "name": "Singapore" },
    "serviceType": "Speech & Drama Website Design"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How much does a speech and drama website cost in Singapore?", "acceptedAnswer": { "@type": "Answer", "text": "Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote." } },
      { "@type": "Question", "name": "Can you add trial class booking to our speech and drama website?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We can build an online booking flow that lets parents schedule a trial class directly from your site, filter by age group and level, and receive automated confirmation emails. It reduces phone calls and back-and-forth messages for your team and lets parents sign up outside office hours." } },
      { "@type": "Question", "name": "Can you showcase student performances on the website?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We can build a performance highlights gallery for recitals, drama productions, public speaking showcases, and storytelling sessions, embedding clips from YouTube or Vimeo and optimising loading so it stays fast on any device. We only publish student footage where you have the right consent in place." } },
      { "@type": "Question", "name": "Can you help our speech and drama school rank on Google locally?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We optimise your website for terms parents actually search — like 'speech and drama classes near me', 'public speaking for kids Singapore', or 'LAMDA exam prep Singapore'. This includes on-page SEO, schema markup for educational services, Google Business Profile optimisation, and location-targeted content for areas like Tampines, Bishan, and Bukit Timah." } },
      { "@type": "Question", "name": "How long does it take to build a speech and drama school website?", "acceptedAnswer": { "@type": "Answer", "text": "Most speech and drama school websites go live within about 2 weeks. Sites with instructor profiles, booking flows, and performance galleries typically take around 3 weeks, while larger builds with online registration, show calendars, and multi-location support take 4 to 5 weeks. We provide a clear timeline before starting so you can plan around your term and performance schedule." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "Speech & Drama Website Singapore", "item": "https://jraftcreative.com/speech-drama-website-singapore/" }
    ]
  }
];
---

<style is:global>
  /* Hide the global background grid pattern on this page only */
  .animated-bg__grid { display: none; }

  /* More-prominent related-service pills — match challenge-card-v2 green treatment */
  #related-services .related-service-link {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.35);
    color: var(--text);
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  #related-services .related-service-link:hover {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.22) 0%, rgba(73, 184, 137, 0.1) 100%), rgba(20, 28, 32, 0.7);
    border-color: rgba(73, 184, 137, 0.6);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(73, 184, 137, 0.3);
  }

  /* Separate the CTA section from related-services with bg-alt */
  .service-cta-section {
    background: var(--bg-alt) !important;
  }

  /* Trial-to-Enrolment Funnel — 5-stage horizontal flow with green accents */
  .renovation-funnel {
    list-style: none;
    padding: 0;
    margin: 56px 0 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 48px;
    counter-reset: funnel;
  }
  .funnel-stage {
    position: relative;
    text-align: center;
    padding: 28px 20px;
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.28);
    border-radius: 12px;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .funnel-stage:hover {
    transform: translateY(-4px);
    border-color: rgba(73, 184, 137, 0.55);
    box-shadow: 0 16px 40px -16px rgba(73, 184, 137, 0.3);
  }
  .funnel-stage h3 {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--accent);
    margin: 0 0 8px 0;
    letter-spacing: -0.01em;
  }
  .funnel-stage p {
    font-size: 0.82rem;
    color: var(--text);
    line-height: 1.5;
    margin: 0;
  }
  .funnel-stage:not(:last-child)::after {
    content: '→';
    position: absolute;
    right: -34px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--accent);
    font-size: 1.6rem;
    font-weight: 500;
    z-index: 2;
    line-height: 1;
    opacity: 0.7;
  }
  @media (max-width: 900px) {
    .renovation-funnel {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }
    .funnel-stage:nth-child(2n)::after,
    .funnel-stage:last-child::after {
      display: none;
    }
    .funnel-stage:nth-child(2n-1)::after {
      right: -22px;
    }
  }
  @media (max-width: 600px) {
    .renovation-funnel {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .funnel-stage::after {
      display: none;
    }
  }
</style>

<ServiceLayout
  title="Speech & Drama Website Singapore — Web Design"
  description="Web design agency for speech and drama schools in Singapore — programme pages by level, trial class booking, and performance highlights."
  canonical="https://jraftcreative.com/speech-drama-website-singapore/"
  ogTitle="Speech & Drama Website Singapore — Web Design"
  ogDescription="Custom website design for speech and drama enrichment schools in Singapore. Programme pages, trial booking, performance highlights, and local SEO."
  ogImage="https://jraftcreative.com/images/og-webdev.jpg"
  keywords="web design agency for speech and drama schools, speech and drama website design singapore, speech and drama website singapore, drama school website singapore, public speaking classes website singapore, LAMDA exam prep singapore, Jraft Creative"
  schemaData={schemaData}
  heroLabel="Web Design Agency for Speech & Drama"
  heroTitle='Web Design Agency for <span class="highlight">Speech &amp; Drama Schools in Singapore</span>'
  heroSubtitle="Parents are searching for enrichment classes online before booking a single trial. We build websites that lay out your programmes by level, show off performances and exam progress, and make trial booking effortless — so you can focus on building confident young speakers."
  heroImage="/images/service-education.webp"
  heroImageAlt="Speech and drama enrichment in Singapore"
  heroButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "See Education Marketing", href: "/industries/education/", class: "btn btn-secondary" }
  ]}
  whatsappText="Hi Jraft Creative, I need a website for my speech and drama school in Singapore."
  ctaLabel="Ready to Grow Your Speech & Drama School?"
  ctaTitle="Get Your Speech & Drama School Online"
  ctaDescription="Tell us about your school and we'll recommend the right website scope. Free consultation — no obligations, no pressure."
  ctaButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%20need%20a%20website%20for%20my%20speech%20and%20drama%20school%20in%20Singapore.", class: "btn btn-secondary" }
  ]}
  hideDefaultCta={false}
>

  <!-- ========== THE CHALLENGE ========== -->
  <section class="section" id="challenge" aria-label="Website challenges for speech and drama schools in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Challenge</p>
        <h2>Parents Are <span class="highlight">Searching</span> — Can They <span class="highlight">Find Your School</span>?</h2>
      </div>
      <div class="section-content reveal">
        <p>Parents compare enrichment schools side by side — programmes, instructors, results — long before they ever call or walk in.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>A Facebook Page Isn't Enough</h3>
            <p>Parents want programmes by level, instructor backgrounds, performance clips and class times in one place. A directory listing answers none of it.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Parents Research Thoroughly</h3>
            <p>They check LAMDA and Trinity exam pathways, watch showcase videos and read what other families say. Anything missing is a reason to choose someone else.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>First Impressions Decide It</h3>
            <p>From Tampines to Bukit Timah, the enrichment scene is crowded. Your site is what decides whether a parent enquires or scrolls past.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHAT WE BUILD ========== -->
  <section class="section" id="sub-services" style="background: var(--bg-alt);" aria-label="Speech and drama website design services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">What We Build</p>
        <h2>Six <span class="highlight">Pillars</span> of a Speech &amp; Drama <span class="highlight">Website</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Every site is built to turn a browsing parent into a booked trial class, not just to look good. It is a bespoke <a href="/services/website-development/">website development</a> build shaped for <a href="/industries/education/">education marketing</a>, not a generic template.</p>
      </div>
      <div class="service-details-grid deliver-grid">
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-business-website.webp');">
          <div class="service-detail-card__content">
            <h3>Programme Pages by Level</h3>
            <p>A page per programme and level — public speaking, creative drama, storytelling, and exam prep for LAMDA and Trinity — covering age groups, class formats and learning outcomes.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-landing-page.webp');">
          <div class="service-detail-card__content">
            <h3>Trial Class Booking</h3>
            <p>Parents book directly from the site — availability by age group and level, with automated confirmations. Fewer phone calls and messages for your team.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-local-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Instructor Profiles &amp; Credentials</h3>
            <p>Qualifications, performance and directing background, and teaching approach, with headshots and clips that give parents confidence in the people guiding their child.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-graphic-design.webp');">
          <div class="service-detail-card__content">
            <h3>Performance Highlights &amp; Showcases</h3>
            <p>A gallery for recitals, productions and public speaking showcases, plus a calendar for upcoming shows and holiday workshops. Published only where you hold the right consent.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-reels-video.webp');">
          <div class="service-detail-card__content">
            <h3>Video &amp; Media Ready</h3>
            <p>Embedded performance videos and showcase reels that load fast on any device, because seeing students on stage is your strongest selling material.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-speed-vitals.webp');">
          <div class="service-detail-card__content">
            <h3>Mobile-First &amp; Search-Ready</h3>
            <p>Clean structure, fast mobile loads and schema built in from day one, so the site is ready to rank and read well on the phones most parents browse from.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHY US ========== -->
  <section class="section" id="why-us" aria-label="Why choose Jraft Creative as your speech and drama web design agency">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2>A <span class="highlight">Web Design Agency</span> That Knows <span class="highlight">Enrichment Schools</span></h2>
      </div>
      <div class="section-content reveal">
        <p>We build for the specific problem enrichment schools have — competing locally across areas like Bishan, Jurong, Katong and Novena, then converting an enquiry into a term-long enrolment. If you want the fundamentals first, read our guide to <a href="/blog/good-business-website-singapore/">what makes a good business website in Singapore</a>.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Enrichment Experience</h3>
            <p>We've built for speech and drama schools, enrichment centres and performing arts academies across Singapore, and know what turns a browsing parent into a committed student.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Live Before the Next Term</h3>
            <p>Most sites go live within about two weeks, so you start capturing trial bookings before the next intake rather than after it.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Website, SEO &amp; Social Together</h3>
            <p>We also run <a href="/services/seo-performance/">SEO and performance</a> and <a href="/services/social-media/">social media</a> — one system for filling class slots.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== ENROLMENT FUNNEL ========== -->
  <section class="section" id="buyer-funnel" style="background: var(--bg-alt);" aria-label="Where your website fits the enrichment parent journey">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Enrolment Funnel</p>
        <h2>Where Your <span class="highlight">Website</span> Fits the <span class="highlight">Parent Journey</span></h2>
      </div>
      <div class="section-content reveal" style="margin-bottom: 24px;">
        <p>Parents move through the same five stages before a child starts classes. Your website carries the middle three — it is where a parent validates your instructors, compares you against the shortlist, and finally books the trial.</p>
      </div>
      <ol class="renovation-funnel reveal">
        <li class="funnel-stage">
          <h3>Discover</h3>
          <p>A search or referral brings them to the site</p>
        </li>
        <li class="funnel-stage">
          <h3>Validate</h3>
          <p>Instructor profiles, exam pathways, performance highlights</p>
        </li>
        <li class="funnel-stage">
          <h3>Compare</h3>
          <p>Programme pages answer level, format and fit</p>
        </li>
        <li class="funnel-stage">
          <h3>Trial</h3>
          <p>Booking flow turns interest into a scheduled class</p>
        </li>
        <li class="funnel-stage">
          <h3>Enrol</h3>
          <p>Sign for the term, renew &amp; refer</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ========== PRICING ========== -->
  <!-- ========== FAQ ========== -->
  <section class="section faq-section" id="faq" style="background: var(--bg-alt);" aria-label="Frequently asked questions about speech and drama website design in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">FAQ</p>
        <h2>Speech &amp; Drama <span class="highlight">Website</span> Questions Answered</h2>
      </div>
      <div class="faq-list">
        <details class="faq-item reveal reveal-d1">
          <summary>How much does a speech and drama website cost in Singapore?</summary>
          <div class="faq-answer"><p>Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>Can you add trial class booking to our speech and drama website?</summary>
          <div class="faq-answer"><p>Yes. We can build an online booking flow that lets parents schedule a trial class directly from your site, filter by age group and level, and receive automated confirmation emails. It reduces phone calls and back-and-forth messages for your team and lets parents sign up outside office hours.</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>Can you showcase student performances on the website?</summary>
          <div class="faq-answer"><p>Yes. We can build a performance highlights gallery for recitals, drama productions, public speaking showcases, and storytelling sessions, embedding clips from YouTube or Vimeo and optimising loading so it stays fast on any device. We only publish student footage where you have the right consent in place.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>Can you help our speech and drama school rank on Google locally?</summary>
          <div class="faq-answer"><p>Yes. We optimise your website for terms parents actually search — like "speech and drama classes near me", "public speaking for kids Singapore", or "LAMDA exam prep Singapore". This includes on-page SEO, schema markup for educational services, Google Business Profile optimisation, and location-targeted content for areas like Tampines, Bishan, and Bukit Timah.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>How long does it take to build a speech and drama school website?</summary>
          <div class="faq-answer"><p>Most speech and drama school websites go live within about 2 weeks. Sites with instructor profiles, booking flows, and performance galleries typically take around 3 weeks, while larger builds with online registration, show calendars, and multi-location support take 4 to 5 weeks. We provide a clear timeline before starting so you can plan around your term and performance schedule.</p></div>
        </details>
      </div>
    </div>
  </section>


  <!-- Related Services -->
  <section class="section" id="related-services" aria-label="Related services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Explore More</p>
        <h2>More <span class="highlight">Speech &amp; Drama</span> Services</h2>
      </div>
      <div class="related-services-grid reveal">
          <a href="/industries/education/" class="related-service-link">Education Marketing</a>
          <a href="/services/website-development/" class="related-service-link">Website Development</a>
          <a href="/services/seo-performance/" class="related-service-link">SEO &amp; Performance</a>
          <a href="/services/social-media/" class="related-service-link">Social Media</a>
      </div>
    </div>
  </section>
</ServiceLayout>
