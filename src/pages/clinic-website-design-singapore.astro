---
import ServiceLayout from '../layouts/ServiceLayout.astro';
import RelatedServices from '../components/RelatedServices.astro';
import MarketingFunnelBlock from '../components/MarketingFunnelBlock.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Clinic Website Design Singapore",
    "description": "Professional website design for medical clinics in Singapore. Online appointment booking, services and doctor-profile pages, clinic hours and location, and mobile-first speed — custom-quoted to your scope.",
    "provider": {
      "@type": "Organization",
      "name": "Jraft Creative",
      "url": "https://jraftcreative.com/",
      "logo": "https://jraftcreative.com/images/logo.png",
      "telephone": "+6582234578",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "60 Paya Lebar Road, Paya Lebar Square",
        "postalCode": "409051",
        "addressLocality": "Singapore",
        "addressCountry": "SG"
      }
    },
    "areaServed": { "@type": "Country", "name": "Singapore" },
    "serviceType": "Medical Clinic Website Design"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How much does a clinic website cost in Singapore?", "acceptedAnswer": { "@type": "Answer", "text": "Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote." } },
      { "@type": "Question", "name": "Does a medical clinic website need to follow MOH advertising guidelines?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. The Ministry of Health (MOH) Private Healthcare Facilities advertising guidelines set out what a clinic can and cannot say online. We build your website to stay within those rules — no prohibited or misleading claims, proper use of qualifications, and clear disclaimers where required — and we review the content with you before it goes live." } },
      { "@type": "Question", "name": "Can you add online appointment booking to my clinic website?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We offer online appointment booking on most projects. Patients can choose a doctor, pick an available time slot, and receive an automated confirmation. We can connect the booking flow to your clinic management system or set up a standalone flow — reducing phone calls and no-shows for the front desk." } },
      { "@type": "Question", "name": "Can the website show Medisave and insurance information?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We can add clear pages for the services you offer, accepted insurance panels, corporate schemes, and Medisave-claimable services where they apply — presented factually so patients know what to expect before they visit. We keep the wording aligned with MOH advertising guidelines." } },
      { "@type": "Question", "name": "How long does it take to build a clinic website?", "acceptedAnswer": { "@type": "Answer", "text": "Most clinic websites go live within 2–3 weeks. A straightforward 5-page site can be ready in as little as 2 weeks, while larger projects with online booking, doctor-profile pages, or multi-branch features may take 3–4 weeks. We provide a clear timeline before starting work." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "Clinic Website Design Singapore", "item": "https://jraftcreative.com/clinic-website-design-singapore/" }
    ]
  }
];
---

<style is:global>
  /* Hide the global background grid pattern on this page only */
  .animated-bg__grid { display: none; }

  /* More-prominent related-service pills — match challenge-card-v2 green treatment */
  #related-services .related-service-link {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.35);
    color: var(--text);
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  #related-services .related-service-link:hover {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.22) 0%, rgba(73, 184, 137, 0.1) 100%), rgba(20, 28, 32, 0.7);
    border-color: rgba(73, 184, 137, 0.6);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(73, 184, 137, 0.3);
  }
  .service-cta-section { background: var(--bg-alt) !important; }
  .renovation-funnel { list-style: none; padding: 0; margin: 56px 0 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 48px; }
  .funnel-stage { position: relative; text-align: center; padding: 28px 20px; background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6); border: 1px solid rgba(73, 184, 137, 0.28); border-radius: 12px; transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease; }
  .funnel-stage:hover { transform: translateY(-4px); border-color: rgba(73, 184, 137, 0.55); box-shadow: 0 16px 40px -16px rgba(73, 184, 137, 0.3); }
  .funnel-stage h3 { font-size: 1.05rem; font-weight: 600; color: var(--accent); margin: 0 0 8px 0; letter-spacing: -0.01em; }
  .funnel-stage p { font-size: 0.82rem; color: var(--text); line-height: 1.5; margin: 0; }
  .funnel-stage:not(:last-child)::after { content: '→'; position: absolute; right: -34px; top: 50%; transform: translateY(-50%); color: var(--accent); font-size: 1.6rem; font-weight: 500; z-index: 2; line-height: 1; opacity: 0.7; }
  @media (max-width: 900px) { .renovation-funnel { grid-template-columns: repeat(2, 1fr); gap: 32px; } .funnel-stage:nth-child(2n)::after, .funnel-stage:last-child::after { display: none; } .funnel-stage:nth-child(2n-1)::after { right: -22px; } }
  @media (max-width: 600px) { .renovation-funnel { grid-template-columns: 1fr; gap: 20px; } .funnel-stage::after { display: none; } }
</style>

<ServiceLayout
  title="Clinic Website Design Singapore — Jraft Creative"
  description="Custom websites for Singapore medical clinics — online booking, doctor profiles, clinic info, mobile-first. GP, family and specialist practices."
  canonical="https://jraftcreative.com/clinic-website-design-singapore/"
  ogTitle="Clinic Website Design Singapore — Jraft Creative"
  ogDescription="Custom websites for Singapore medical clinics — online booking, doctor profiles, clinic info, mobile-first. GP, family and specialist practices."
  ogImage="https://jraftcreative.com/images/og-webdev.jpg"
  keywords="clinic website design singapore, medical clinic website singapore, gp clinic website singapore, doctor website design, family clinic website, specialist clinic website singapore, healthcare web design singapore, Jraft Creative"
  schemaData={schemaData}
  heroLabel="Web Design Agency for Medical Clinics"
  heroTitle='Website Design for Medical <span class="highlight">Clinics in Singapore</span>'
  heroSubtitle="Your clinic needs more than a directory listing. We build fast, mobile-first websites for GP, family, and specialist clinics — with online appointment booking, services and doctor-profile pages, clinic hours and location, and Medisave and insurance information built in. Clinic website design and development that makes it easy for patients to find you and book."
  heroImage="/images/service-clinic.webp"
  heroImageAlt="Medical clinic in Singapore"
  heroButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "See Our Work", href: "/about/", class: "btn btn-secondary" }
  ]}
  whatsappText="Hi Jraft Creative, I need a website for my clinic in Singapore."
  ctaLabel="Ready to Get Started?"
  ctaTitle="Get Your Clinic Online"
  ctaDescription="Book a free consultation and tell us about your clinic. We'll get back to you within 24 hours with a tailored proposal — whether you're a solo GP, a family practice, or a multi-branch specialist clinic."
  ctaButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%20need%20a%20website%20for%20my%20clinic%20in%20Singapore.", class: "btn btn-secondary" }
  ]}
  hideDefaultCta={false}
>

  <!-- ========== THE CHALLENGE ========== -->
  <section class="section" id="challenge" aria-label="Why medical clinics need a proper website">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Challenge</p>
        <h2>Patients Are Choosing Their Clinic <span class="highlight">Online</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Most patients search "clinic near me" or "GP in Tampines" and compare a couple of clinics before deciding where to go. Your website is the first impression, and it has to make finding your hours, services, and booking simple. See what a <a href="/blog/good-business-website-singapore/">good business website in Singapore</a> gets right.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>A Directory Listing Isn't Enough</h3>
            <p>If patients only find a basic listing with no booking option, they quietly choose the clinic down the road in Novena or Bishan that made it easy to book.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Patients Want Answers, Then Booking</h3>
            <p>Before visiting, patients want to see your services, opening hours, location, and which doctor they'll see — then book without calling during clinic hours.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Compliance Is Non-Negotiable</h3>
            <p>Your site must meet MOH Private Healthcare Facilities advertising rules — no prohibited or misleading claims. A generic agency won't know them; we do.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHAT WE BUILD ========== -->
  <section class="section" id="sub-services" style="background: var(--bg-alt);" aria-label="Medical clinic website design services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">What We Build</p>
        <h2>Six <span class="highlight">Pillars</span> of a Medical Clinic <span class="highlight">Website</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Every element is built around making it easy for patients to find you and book — as part of our <a href="/services/website-development/">website development</a> work for <a href="/industries/healthcare/">healthcare</a> providers across Singapore.</p>
      </div>
      <div class="service-details-grid deliver-grid">
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-business-website.webp');">
          <div class="service-detail-card__content">
            <h3>Online Appointment Booking</h3>
            <p>Patients book directly — doctor, time slot and reason for visit — with automated confirmations that cut no-shows and free up the front desk.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-landing-page.webp');">
          <div class="service-detail-card__content">
            <h3>Services Pages</h3>
            <p>A clear page per service — general consultation, chronic care, health screening, vaccinations, minor procedures — so patients know what you offer.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-local-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Doctor Profile Pages</h3>
            <p>Profile pages per doctor — qualifications, areas of focus and a short bio — because patients want to know who will see them before they book.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-graphic-design.webp');">
          <div class="service-detail-card__content">
            <h3>Clinic Info, Hours &amp; Location</h3>
            <p>Opening hours, address, parking and MRT directions, and a Google Map — so patients in Orchard or Tanjong Pagar can reach you without a phone call.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-onpage-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Insurance &amp; Medisave Info</h3>
            <p>Clear pages for accepted insurance panels, corporate schemes and Medisave-claimable services where they apply — stated factually so patients know what to expect.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-speed-vitals.webp');">
          <div class="service-detail-card__content">
            <h3>Mobile-First &amp; Fast</h3>
            <p>Patients search on their phones, often when unwell. Every page is built mobile-first and fast, with tap-to-call and tap-to-book.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHY US ========== -->
  <section class="section" id="why-us" aria-label="Why choose Jraft Creative for clinic website design">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2>A <span class="highlight">Web Design Agency</span> That Knows <span class="highlight">Healthcare</span></h2>
      </div>
      <div class="section-content reveal">
        <p>A site clear enough to answer patients, easy enough to book from, and compliant enough to keep your practice safe — for clinics in Jurong, Novena and across Singapore.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Healthcare Website Experience</h3>
            <p>We understand MOH advertising guidelines, PDPA requirements for patient data, and the trust signals — credentials, hours, clear services — that matter in healthcare.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Live Before You Open</h3>
            <p>Most clinic sites go live within two to three weeks, so a new practice or a refreshed brand is working when you need it.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Website, SEO &amp; Ads Together</h3>
            <p>We also run <a href="/services/seo-performance/">clinic SEO</a> and <a href="/services/paid-ads/">Google Ads</a> — one agency for the clinic's whole online presence.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== PATIENT JOURNEY FUNNEL ========== -->
  <section class="section" id="buyer-funnel" style="background: var(--bg-alt);" aria-label="Where your website fits the patient journey">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Patient Journey</p>
        <h2>Where Your <span class="highlight">Website</span> Fits the <span class="highlight">Patient Journey</span></h2>
      </div>
      <div class="section-content reveal" style="margin-bottom: 24px;">
        <p>A patient moves through five stages before booking. Your website carries the middle three — it is where they check your services, compare you against nearby clinics, and finally book.</p>
      </div>
      <ol class="renovation-funnel reveal">
        <li class="funnel-stage"><h3>Discover</h3><p>A search or referral brings them to the site</p></li>
        <li class="funnel-stage"><h3>Research</h3><p>Services and doctor profiles answer their questions</p></li>
        <li class="funnel-stage"><h3>Compare</h3><p>Hours, location and reviews weigh you against others</p></li>
        <li class="funnel-stage"><h3>Book</h3><p>Online booking turns interest into an appointment</p></li>
        <li class="funnel-stage"><h3>Visit</h3><p>A good first visit, then follow-ups &amp; referrals</p></li>
      </ol>
    </div>
  </section>

  <!-- ========== FAQ ========== -->
  <section class="section faq-section" id="faq" style="background: var(--bg-alt);" aria-label="Frequently asked questions about clinic website design in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">FAQ</p>
        <h2>Clinic <span class="highlight">Website</span> Questions Answered</h2>
      </div>
      <div class="faq-list">
        <details class="faq-item reveal reveal-d1">
          <summary>How much does a clinic website cost in Singapore?</summary>
          <div class="faq-answer"><p>Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>Does a medical clinic website need to follow MOH advertising guidelines?</summary>
          <div class="faq-answer"><p>Yes. The Ministry of Health (MOH) Private Healthcare Facilities advertising guidelines set out what a clinic can and cannot say online. We build your website to stay within those rules — no prohibited or misleading claims, proper use of qualifications, and clear disclaimers where required — and we review the content with you before it goes live.</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>Can you add online appointment booking to my clinic website?</summary>
          <div class="faq-answer"><p>Yes. We offer online appointment booking on most projects. Patients can choose a doctor, pick an available time slot, and receive an automated confirmation. We can connect the booking flow to your clinic management system or set up a standalone flow — reducing phone calls and no-shows for the front desk.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>Can the website show Medisave and insurance information?</summary>
          <div class="faq-answer"><p>Yes. We can add clear pages for the services you offer, accepted insurance panels, corporate schemes, and Medisave-claimable services where they apply — presented factually so patients know what to expect before they visit. We keep the wording aligned with MOH advertising guidelines.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>How long does it take to build a clinic website?</summary>
          <div class="faq-answer"><p>Most clinic websites go live within 2–3 weeks. A straightforward 5-page site can be ready in as little as 2 weeks, while larger projects with online booking, doctor-profile pages, or multi-branch features may take 3–4 weeks. We provide a clear timeline before starting work.</p></div>
        </details>
      </div>
    </div>
  </section>


  <section class="section" id="related-services" aria-label="Related services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Explore More</p>
        <h2>More <span class="highlight">Clinic</span> Services</h2>
      </div>
      <div class="related-services-grid reveal">
          <a href="/industries/healthcare/" class="related-service-link">Healthcare Marketing</a>
          <a href="/services/website-development/" class="related-service-link">Website Development</a>
          <a href="/services/seo-performance/" class="related-service-link">SEO &amp; Performance</a>
          <a href="/services/ai-search-optimisation/" class="related-service-link">AI Search (GEO)</a>
      </div>
    </div>
  </section>

  <MarketingFunnelBlock
    industry="medical clinic"
    marketingHref="/clinic-marketing-singapore/"
    outcomeLine="See how we'd fill your appointment book — MOH-compliant"
    ctaText="Clinic Marketing Singapore"
  />

</ServiceLayout>
