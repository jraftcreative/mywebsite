---
import ServiceLayout from '../layouts/ServiceLayout.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Pilates Studio Website Design Singapore",
    "description": "Professional website design for Pilates studios in Singapore — reformer and mat class timetables, instructor profiles with Stott, Polestar and BASI certifications, online booking, equipment showcase, membership packages, and prenatal/postnatal programmes.",
    "provider": {
      "@type": "Organization",
      "name": "Jraft Creative",
      "url": "https://jraftcreative.com/",
      "logo": "https://jraftcreative.com/images/logo.png",
      "telephone": "+6582234578",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "60 Paya Lebar Road, Paya Lebar Square",
        "postalCode": "409051",
        "addressLocality": "Singapore",
        "addressCountry": "SG"
      }
    },
    "areaServed": { "@type": "Country", "name": "Singapore" },
    "serviceType": "Pilates Studio Website Design"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How much does a Pilates studio website cost in Singapore?", "acceptedAnswer": { "@type": "Answer", "text": "Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote." } },
      { "@type": "Question", "name": "Can you integrate online booking for reformer classes?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We integrate the booking system your studio already uses — Mindbody, ClassPass, Momence, or similar — so clients see live availability, reserve a specific reformer position, and get automated confirmations and reminders. If you don't have a system yet, we'll recommend one that fits your class formats and budget." } },
      { "@type": "Question", "name": "Do you showcase Pilates equipment on the website?", "acceptedAnswer": { "@type": "Answer", "text": "Absolutely. We build dedicated equipment pages that explain each apparatus — reformer, cadillac, Wunda chair, tower, and spine corrector — with photos and descriptions of how they are used in your classes. This educates new clients who may not know the difference between mat and reformer Pilates, helping them choose the right class type." } },
      { "@type": "Question", "name": "Can you build pages for prenatal and postnatal Pilates programmes?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We create dedicated programme pages for prenatal and postnatal Pilates — explaining benefits, safety considerations, trimester-specific modifications, and instructor qualifications. These pages are essential for reaching the large number of expectant and new mothers in Singapore who search specifically for pregnancy-safe exercise options." } },
      { "@type": "Question", "name": "How long does it take to build a Pilates studio website?", "acceptedAnswer": { "@type": "Answer", "text": "Most Pilates studio websites go live within about 2 weeks. Sites with online booking, instructor profiles, and equipment showcases take a little longer, and multi-location builds with member portals longer still. We give you a clear timeline before we start." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "Pilates Studio Website Singapore", "item": "https://jraftcreative.com/pilates-studio-website-singapore/" }
    ]
  }
];
---

<style is:global>
  /* Hide the global background grid pattern on this page only */
  .animated-bg__grid { display: none; }

  /* More-prominent related-service pills — match challenge-card-v2 green treatment */
  #related-services .related-service-link {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.35);
    color: var(--text);
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  #related-services .related-service-link:hover {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.22) 0%, rgba(73, 184, 137, 0.1) 100%), rgba(20, 28, 32, 0.7);
    border-color: rgba(73, 184, 137, 0.6);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(73, 184, 137, 0.3);
  }

  /* Separate the CTA section from related-services with bg-alt */
  .service-cta-section {
    background: var(--bg-alt) !important;
  }

  /* Force even service card grid on desktop per locked landing-page pattern */
  #sub-services .deliver-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }
  @media (max-width: 900px) {
    #sub-services .deliver-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 600px) {
    #sub-services .deliver-grid { grid-template-columns: 1fr; }
  }

  /* Pilates Website Flow — horizontal process flow with green accents */
  .renovation-funnel {
    list-style: none;
    padding: 0;
    margin: 56px 0 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 48px;
    counter-reset: funnel;
  }
  .funnel-stage {
    position: relative;
    text-align: center;
    padding: 28px 20px;
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.28);
    border-radius: 12px;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .funnel-stage:hover {
    transform: translateY(-4px);
    border-color: rgba(73, 184, 137, 0.55);
    box-shadow: 0 16px 40px -16px rgba(73, 184, 137, 0.3);
  }
  .funnel-stage h3 {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--accent);
    margin: 0 0 8px 0;
    letter-spacing: -0.01em;
  }
  .funnel-stage p {
    font-size: 0.82rem;
    color: var(--text);
    line-height: 1.5;
    margin: 0;
  }
  .funnel-stage:not(:last-child)::after {
    content: '→';
    position: absolute;
    right: -34px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--accent);
    font-size: 1.6rem;
    font-weight: 500;
    z-index: 2;
    line-height: 1;
    opacity: 0.7;
  }
  @media (max-width: 900px) {
    .renovation-funnel {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }
    .funnel-stage:nth-child(2n)::after,
    .funnel-stage:last-child::after {
      display: none;
    }
    .funnel-stage:nth-child(2n-1)::after {
      right: -22px;
    }
  }
  @media (max-width: 600px) {
    .renovation-funnel {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .funnel-stage::after {
      display: none;
    }
  }
</style>

<ServiceLayout
  title="Pilates Studio Website Singapore — Jraft Creative"
  description="Website design for Pilates studios in Singapore — reformer and mat class timetables, instructor profiles with Stott."
  canonical="https://jraftcreative.com/pilates-studio-website-singapore/"
  ogTitle="Pilates Studio Website Singapore — Jraft Creative"
  ogDescription="Website design for Pilates studios in Singapore. Reformer class booking, instructor profiles, equipment showcase, membership packages."
  ogImage="https://jraftcreative.com/images/og-webdev.jpg"
  keywords="pilates studio website design singapore, pilates studio website singapore, reformer pilates website singapore, mat pilates website singapore, pilates web design, pilates class booking website, Jraft Creative"
  schemaData={schemaData}
  heroLabel="Pilates Studio Websites"
  heroTitle='Website Design for <span class="highlight">Pilates Studios in Singapore</span>'
  heroSubtitle="Reformer pilates is one of Singapore's fastest-growing fitness segments, and clients research studios online before booking their first session. We build pilates studio websites that showcase your equipment, prove your instructors' credentials, and make booking effortless — so every reformer bed stays full."
  heroImage="/images/service-pilates.webp"
  heroButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "See How We Work", href: "/process/", class: "btn btn-secondary" }
  ]}
  whatsappText="Hi Jraft Creative, I need a website for my pilates studio in Singapore."
  ctaLabel="Ready to Grow Your Pilates Studio?"
  ctaTitle="Get Your Pilates Studio Online"
  ctaDescription="Tell us about your studio and we'll recommend the right website approach. Free consultation — no obligations, no pressure."
  ctaButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%20need%20a%20website%20for%20my%20pilates%20studio%20in%20Singapore.", class: "btn btn-secondary" }
  ]}
>

  <!-- ========== THE CHALLENGE ========== -->
  <section class="section" id="challenge" aria-label="Why Pilates studios need a proper website">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Challenge</p>
        <h2>Clients Compare Studios <span class="highlight">Online</span> — Is Yours <span class="highlight">Making the Cut</span>?</h2>
      </div>
      <div class="section-content reveal">
        <p>Reformer pilates is booming across Singapore, and clients compare three to five studios online before they commit. If your website doesn't answer their questions fast, they book the studio that does.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>The Online Comparison</h3>
            <p>Before committing, clients scroll class descriptions, check instructor certifications, and look for transparent pricing. A thin or dated site quietly loses them to the studio that presents itself clearly.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Social Isn't Enough</h3>
            <p>Instagram builds awareness but disappears in 24 hours. A first-timer choosing between mat and reformer needs structured info — equipment, class sizes, certifications, how to book — working around the clock.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>The Prenatal Gap</h3>
            <p>Singapore has a large prenatal and postnatal clientele who search specifically for pregnancy-safe classes. With no page addressing safety and qualifications, a high-value segment books elsewhere.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHAT WE BUILD ========== -->
  <section class="section" id="sub-services" style="background: var(--bg-alt);" aria-label="Pilates studio website design services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">What We Build</p>
        <h2>What We Build for <span class="highlight">Pilates Studios</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Every pilates site we build is purpose-made for the industry — dedicated class pages, an equipment showcase that educates first-timers, credentialled instructor profiles, and booking built for small-group reformer formats.</p>
      </div>
      <div class="service-details-grid deliver-grid">
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-business-website.webp');">
          <div class="service-detail-card__content">
            <h3>Class Types &amp; Equipment Showcase</h3>
            <p>Dedicated pages for mat, reformer, cadillac, tower, and Wunda chair — each explaining the apparatus, intensity, and group size. Clear equipment pages turn curious first-timers into booked clients.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-landing-page.webp');">
          <div class="service-detail-card__content">
            <h3>Online Booking for Small Groups</h3>
            <p>Reformer classes cap at 8–12, so real-time availability matters. Clients see open spots, reserve a reformer position, and get automated reminders — fewer no-shows, a fuller schedule.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-local-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Instructor Profiles &amp; Certifications</h3>
            <p>Profile pages featuring Stott, Polestar, BASI, or Peak Pilates certifications and specialisations like rehab or prenatal. Training and experience give clients confidence before they book.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-graphic-design.webp');">
          <div class="service-detail-card__content">
            <h3>Prenatal, Postnatal &amp; Membership</h3>
            <p>Programme pages covering safety, trimester modifications, and qualifications — plus membership pages that lay out your packages side by side so clients compare and purchase online.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHY CHOOSE US ========== -->
  <section class="section" id="why-us" aria-label="Why choose Jraft Creative for Pilates studio website design">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2>Why Choose Us for Your <span class="highlight">Pilates Website</span></h2>
      </div>
      <div class="section-content reveal">
        <p>We understand the pilates industry in Singapore — from differentiating reformer and mat offerings to converting first-time visitors into long-term members in a competitive boutique fitness market.</p>
      </div>
      <div class="service-details-grid" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Boutique Fitness Experience</h3>
            <p>We've built for pilates studios, yoga spaces, and boutique fitness brands across Singapore. We translate the premium, small-group feel into a site that looks the part — polished, not a generic gym template.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Fast Turnaround</h3>
            <p>Most pilates sites go live in about 2 weeks — quick enough to catch a new location opening, a studio rebrand, or a seasonal promotion push without missing the demand.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>One Agency, All Channels</h3>
            <p>Beyond the site, we run SEO, social, and Google Ads — so your whole online presence pulls in one direction while you concentrate on teaching and growing the studio.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WEBSITE FLOW ========== -->
  <section class="section" id="website-flow" style="background: var(--bg-alt);" aria-label="How we build your pilates studio website">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">How It Works</p>
        <h2>From First Call to <span class="highlight">Live Bookings</span></h2>
      </div>
      <div class="section-content reveal" style="margin-bottom: 24px;">
        <p>We run the same four-step build on every pilates studio — clear, quick, and made to start taking bookings the moment you go live.</p>
      </div>
      <ol class="renovation-funnel reveal">
        <li class="funnel-stage">
          <h3>Discover</h3>
          <p>We map your classes, instructors, and booking needs</p>
        </li>
        <li class="funnel-stage">
          <h3>Design</h3>
          <p>Bespoke pilates design, built mobile-first</p>
        </li>
        <li class="funnel-stage">
          <h3>Build</h3>
          <p>Booking, schedules, and pages wired and tested</p>
        </li>
        <li class="funnel-stage">
          <h3>Launch</h3>
          <p>Live in about 2 weeks, tuned for bookings</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ========== FAQ ========== -->
  <section class="section faq-section" id="faq" aria-label="Frequently asked questions about Pilates studio website design in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">FAQ</p>
        <h2><span class="highlight">Pilates Studio Website</span> — Questions <span class="highlight">Answered</span></h2>
      </div>
      <div class="faq-list">
        <details class="faq-item reveal reveal-d1">
          <summary>How much does a Pilates studio website cost in Singapore?</summary>
          <div class="faq-answer"><p>Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>Can you integrate online booking for reformer classes?</summary>
          <div class="faq-answer"><p>Yes. We integrate the booking system your studio already uses — Mindbody, ClassPass, Momence, or similar — so clients see live availability, reserve a specific reformer position, and get automated confirmations and reminders. If you don't have a system yet, we'll recommend one that fits your class formats and budget.</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>Do you showcase Pilates equipment on the website?</summary>
          <div class="faq-answer"><p>Absolutely. We build dedicated equipment pages that explain each apparatus — reformer, cadillac, Wunda chair, tower, and spine corrector — with photos and descriptions of how they are used in your classes. This educates new clients who may not know the difference between mat and reformer Pilates, helping them choose the right class type.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>Can you build pages for prenatal and postnatal Pilates programmes?</summary>
          <div class="faq-answer"><p>Yes. We create dedicated programme pages for prenatal and postnatal Pilates — explaining benefits, safety considerations, trimester-specific modifications, and instructor qualifications. These pages are essential for reaching the large number of expectant and new mothers in Singapore who search specifically for pregnancy-safe exercise options.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>How long does it take to build a Pilates studio website?</summary>
          <div class="faq-answer"><p>Most Pilates studio websites go live within about 2 weeks. Sites with online booking, instructor profiles, and equipment showcases take a little longer, and multi-location builds with member portals longer still. We give you a clear timeline before we start.</p></div>
        </details>
      </div>
    </div>
  </section>


  <!-- Related Services -->
  <section class="section" id="related-services" aria-label="Related services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Explore More</p>
        <h2>More Pilates Services</h2>
      </div>
      <div class="related-services-grid reveal">
          <a href="/pilates-marketing-singapore/" class="related-service-link">Pilates Marketing</a>
          <a href="/pilates-seo-singapore/" class="related-service-link">Pilates SEO</a>
          <a href="/pilates-geo-singapore/" class="related-service-link">Pilates GEO</a>
          <a href="/pilates-ads-singapore/" class="related-service-link">Pilates Google &amp; Meta Ads</a>
          <a href="/pilates-social-media-singapore/" class="related-service-link">Pilates Social Media</a>
          <a href="/pilates-branding-singapore/" class="related-service-link">Pilates Branding</a>
      </div>
    </div>
  </section>
</ServiceLayout>
