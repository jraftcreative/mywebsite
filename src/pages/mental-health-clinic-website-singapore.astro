---
import ServiceLayout from '../layouts/ServiceLayout.astro';
import RelatedServices from '../components/RelatedServices.astro';
import MarketingFunnelBlock from '../components/MarketingFunnelBlock.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Mental Health Clinic Website Design Singapore",
    "description": "Website design for mental health clinics in Singapore. Therapist profiles with credentials, confidential enquiry and booking, and calm, private, mobile-first pages — custom-quoted to your scope.",
    "provider": {
      "@type": "Organization",
      "name": "Jraft Creative",
      "url": "https://jraftcreative.com/",
      "logo": "https://jraftcreative.com/images/logo.png",
      "telephone": "+6582234578",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "60 Paya Lebar Road, Paya Lebar Square",
        "postalCode": "409051",
        "addressLocality": "Singapore",
        "addressCountry": "SG"
      }
    },
    "areaServed": { "@type": "Country", "name": "Singapore" },
    "serviceType": "Mental Health Clinic Website Design"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How much does a mental health clinic website cost in Singapore?", "acceptedAnswer": { "@type": "Answer", "text": "Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote." } },
      { "@type": "Question", "name": "How do you keep enquiries and bookings confidential on a mental health website?", "acceptedAnswer": { "@type": "Answer", "text": "Confidentiality is built into every page. We use SSL encryption across the whole site, design discreet enquiry and booking forms that ask only for what's needed, and write a clear PDPA-aligned privacy policy that explains how information is handled. The aim is a private, low-pressure way for someone to reach out." } },
      { "@type": "Question", "name": "Can you build therapist and psychologist profile pages with credentials?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We build a profile page for each practitioner — qualifications, registration with the Singapore Medical Council (SMC) or the Singapore Register of Psychologists (SRP), areas of focus, therapeutic approach, languages spoken, and a personal statement. Clear credentials help a visitor decide who they'd feel comfortable speaking with." } },
      { "@type": "Question", "name": "Will the website work well on mobile?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Most people search for support privately on their phone, so every page is built mobile-first and fast, with tap-to-call and a simple tap-to-enquire step. The experience stays calm and uncluttered on a small screen, which matters when someone is already hesitant about reaching out." } },
      { "@type": "Question", "name": "How long does it take to build a mental health clinic website?", "acceptedAnswer": { "@type": "Answer", "text": "Most mental health clinic websites go live within 2–3 weeks. A standard 5-page site can be ready in 2 weeks. Larger projects with a therapist directory, multiple approach pages, or multi-location features may take 3–4 weeks. We provide a clear timeline before starting." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "Mental Health Clinic Website Design Singapore", "item": "https://jraftcreative.com/mental-health-clinic-website-singapore/" }
    ]
  }
];
---

<style is:global>
  /* Hide the global background grid pattern on this page only */
  .animated-bg__grid { display: none; }

  /* More-prominent related-service pills — match challenge-card-v2 green treatment */
  #related-services .related-service-link {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.35);
    color: var(--text);
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  #related-services .related-service-link:hover {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.22) 0%, rgba(73, 184, 137, 0.1) 100%), rgba(20, 28, 32, 0.7);
    border-color: rgba(73, 184, 137, 0.6);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(73, 184, 137, 0.3);
  }
  .service-cta-section { background: var(--bg-alt) !important; }
  .renovation-funnel { list-style: none; padding: 0; margin: 56px 0 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 48px; }
  .funnel-stage { position: relative; text-align: center; padding: 28px 20px; background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6); border: 1px solid rgba(73, 184, 137, 0.28); border-radius: 12px; transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease; }
  .funnel-stage:hover { transform: translateY(-4px); border-color: rgba(73, 184, 137, 0.55); box-shadow: 0 16px 40px -16px rgba(73, 184, 137, 0.3); }
  .funnel-stage h3 { font-size: 1.05rem; font-weight: 600; color: var(--accent); margin: 0 0 8px 0; letter-spacing: -0.01em; }
  .funnel-stage p { font-size: 0.82rem; color: var(--text); line-height: 1.5; margin: 0; }
  .funnel-stage:not(:last-child)::after { content: '→'; position: absolute; right: -34px; top: 50%; transform: translateY(-50%); color: var(--accent); font-size: 1.6rem; font-weight: 500; z-index: 2; line-height: 1; opacity: 0.7; }
  @media (max-width: 900px) { .renovation-funnel { grid-template-columns: repeat(2, 1fr); gap: 32px; } .funnel-stage:nth-child(2n)::after, .funnel-stage:last-child::after { display: none; } .funnel-stage:nth-child(2n-1)::after { right: -22px; } }
  @media (max-width: 600px) { .renovation-funnel { grid-template-columns: 1fr; gap: 20px; } .funnel-stage::after { display: none; } }
</style>

<ServiceLayout
  title="Mental Health Clinic Website — Web Design Agency"
  description="Custom websites for Singapore mental health clinics — therapist profiles, confidential booking, mobile-first, live in 2–3 weeks. Custom-quoted to your scope."
  canonical="https://jraftcreative.com/mental-health-clinic-website-singapore/"
  ogTitle="Mental Health Clinic Website — Web Design Agency"
  ogDescription="Custom websites for Singapore mental health clinics — therapist profiles, confidential booking, mobile-first, live in 2–3 weeks. Custom-quoted to your scope."
  ogImage="https://jraftcreative.com/images/og-mentalhealth.jpg"
  keywords="mental health clinic website design singapore, therapy website singapore, counselling website design, psychologist website singapore, mental health web design singapore, psychiatry clinic website, Jraft Creative"
  schemaData={schemaData}
  heroLabel="Web Design Agency for Mental Health Clinics"
  heroTitle='Web Design Agency for <span class="highlight">Mental Health Clinics in Singapore</span>'
  heroSubtitle="Someone looking for support needs to feel safe before they reach out. We build calm, private, mobile-first websites for counselling and therapy practices, psychology clinics, and psychiatry centres — with therapist profiles and credentials, clear service and approach pages, first-visit information, and confidential enquiry and booking. Mental health website design that helps a visitor take the step to book a first session."
  heroImage="/images/service-mentalhealth.webp"
  heroImageAlt="Mental health professional in a Singapore clinic"
  heroButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "See Our Work", href: "/about/", class: "btn btn-secondary" }
  ]}
  whatsappText="Hi Jraft Creative, I need a website for my mental health clinic in Singapore."
  ctaLabel="Ready to Get Started?"
  ctaTitle="Get Your Mental Health Practice Online"
  ctaDescription="Book a free consultation and tell us about your practice. We'll get back to you within 24 hours with a tailored proposal."
  ctaButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%20need%20a%20website%20for%20my%20mental%20health%20clinic%20in%20Singapore.", class: "btn btn-secondary" }
  ]}
  hideDefaultCta={false}
>

  <!-- ========== THE CHALLENGE ========== -->
  <section class="section" id="challenge" aria-label="Why mental health clinics need a proper website">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Challenge</p>
        <h2>People Look for Support <span class="highlight">Privately, Online</span></h2>
      </div>
      <div class="section-content reveal">
        <p>For many people, the first step toward support isn't a phone call — it's a quiet search from their phone. Your website is where they decide whether they feel safe enough to reach out.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>A Cold Site Turns People Away</h3>
            <p>A dated, clinical, or hard-to-navigate site can put off someone who is already hesitant. The tone and calm of the page matter as much as the words on it.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>People Research Before They Reach Out</h3>
            <p>Visitors read about approaches, check credentials, and look for someone they'd feel comfortable speaking with — long before they send an enquiry.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Privacy Comes First</h3>
            <p>Every part of the experience — enquiry form, booking step, privacy policy — has to protect confidentiality. A generic agency treats this as an afterthought; we don't.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHAT WE BUILD ========== -->
  <section class="section" id="sub-services" style="background: var(--bg-alt);" aria-label="Mental health clinic website design services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">What We Build</p>
        <h2>Six <span class="highlight">Pillars</span> of a Mental Health <span class="highlight">Website</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Every element is built around comfort, privacy, and a low-pressure first step — structured for how someone actually chooses where to seek support. Website, <a href="/mental-health-google-ads-singapore/">Google Ads</a>, and <a href="/mental-health-social-media-singapore/">social media</a> can all sit under one roof.</p>
      </div>
      <div class="service-details-grid deliver-grid">
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-business-website.webp');">
          <div class="service-detail-card__content">
            <h3>Service &amp; Approach Pages</h3>
            <p>A clear page per service — individual counselling, CBT, couples and family therapy, child and adolescent, psychiatry, corporate wellness — written in plain, warm language.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-landing-page.webp');">
          <div class="service-detail-card__content">
            <h3>Therapist &amp; Psychologist Profiles</h3>
            <p>A profile per practitioner — qualifications, SMC or SRP registration, areas of focus, approach, and languages spoken — so a visitor can find the right fit.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-local-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Confidential Enquiry &amp; Booking</h3>
            <p>A discreet, SSL-secured form that asks only for what's needed, with clear privacy assurances — a private, low-pressure way to reach out or request a first session.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-graphic-design.webp');">
          <div class="service-detail-card__content">
            <h3>First-Visit Information</h3>
            <p>Plain answers to what a first session looks like, what to expect, and how confidentiality works — the reassurance that helps a hesitant visitor take the next step.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-onpage-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Search-Ready Foundations</h3>
            <p>Clean structure, schema, and fast mobile loads built in, so the site can be found for local support searches rather than needing rescuing later.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-speed-vitals.webp');">
          <div class="service-detail-card__content">
            <h3>Mobile-First &amp; Fast</h3>
            <p>People search for support privately, on their phones. Every page is built mobile-first and fast, calm and uncluttered, with tap-to-call and tap-to-enquire.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHY US ========== -->
  <section class="section" id="why-us" aria-label="Why choose Jraft Creative for mental health website design">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2>A <span class="highlight">Web Design Agency</span> That Understands <span class="highlight">Sensitive Care</span></h2>
      </div>
      <div class="section-content reveal">
        <p>A mental health website sits in a specific corner of <a href="/industries/healthcare/">healthcare marketing in Singapore</a>, and it follows the same fundamentals as any <a href="/blog/good-business-website-singapore/">good business website</a> — only with privacy, tone, and clear credentials treated as core features rather than extras.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Sensitive, Trust-Building Design</h3>
            <p>Warm palettes, calm layouts, and copy that normalises seeking help. We design so a hesitant visitor feels welcome enough to reach out — never rushed or judged.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Privacy Handled Properly</h3>
            <p>SSL across the site, discreet forms, and a PDPA-aligned privacy policy, with practitioner credentials — SMC or SRP registration — displayed clearly and honestly.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Website, SEO &amp; Ads Together</h3>
            <p>We also run <a href="/mental-health-marketing-singapore/">mental health marketing</a> and <a href="/mental-health-google-ads-singapore/">Google Ads</a> — one agency for the whole online presence.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== PATIENT JOURNEY FUNNEL ========== -->
  <section class="section" id="buyer-funnel" style="background: var(--bg-alt);" aria-label="Where your website fits the journey to care">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Journey to Care</p>
        <h2>Where Your <span class="highlight">Website</span> Fits the <span class="highlight">Journey to Care</span></h2>
      </div>
      <div class="section-content reveal" style="margin-bottom: 24px;">
        <p>Someone seeking support moves through five stages before booking. Your website carries the middle three — it's where they explore the approach, weigh you against other practices, and finally reach out. It works the same for clinics across Novena, Orchard, Tanjong Pagar, Tampines, Bishan, and Katong.</p>
      </div>
      <ol class="renovation-funnel reveal">
        <li class="funnel-stage"><h3>Discover</h3><p>A search or referral brings them to the site</p></li>
        <li class="funnel-stage"><h3>Explore</h3><p>Approach pages and profiles answer their questions</p></li>
        <li class="funnel-stage"><h3>Compare</h3><p>Credentials and tone weigh you against others</p></li>
        <li class="funnel-stage"><h3>Reach Out</h3><p>A confidential enquiry turns hesitation into contact</p></li>
        <li class="funnel-stage"><h3>First Session</h3><p>A reassuring first visit, then ongoing care</p></li>
      </ol>
    </div>
  </section>

  <!-- ========== FAQ ========== -->
  <section class="section faq-section" id="faq" style="background: var(--bg-alt);" aria-label="Frequently asked questions about mental health website design in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">FAQ</p>
        <h2>Mental Health <span class="highlight">Website</span> Questions Answered</h2>
      </div>
      <div class="faq-list">
        <details class="faq-item reveal reveal-d1">
          <summary>How much does a mental health clinic website cost in Singapore?</summary>
          <div class="faq-answer"><p>Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>How do you keep enquiries and bookings confidential on a mental health website?</summary>
          <div class="faq-answer"><p>Confidentiality is built into every page. We use SSL encryption across the whole site, design discreet enquiry and booking forms that ask only for what's needed, and write a clear PDPA-aligned privacy policy that explains how information is handled. The aim is a private, low-pressure way for someone to reach out.</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>Can you build therapist and psychologist profile pages with credentials?</summary>
          <div class="faq-answer"><p>Yes. We build a profile page for each practitioner — qualifications, registration with the Singapore Medical Council (SMC) or the Singapore Register of Psychologists (SRP), areas of focus, therapeutic approach, languages spoken, and a personal statement. Clear credentials help a visitor decide who they'd feel comfortable speaking with.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>Will the website work well on mobile?</summary>
          <div class="faq-answer"><p>Yes. Most people search for support privately on their phone, so every page is built mobile-first and fast, with tap-to-call and a simple tap-to-enquire step. The experience stays calm and uncluttered on a small screen, which matters when someone is already hesitant about reaching out.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>How long does it take to build a mental health clinic website?</summary>
          <div class="faq-answer"><p>Most mental health clinic websites go live within 2–3 weeks. A standard 5-page site can be ready in 2 weeks. Larger projects with a therapist directory, multiple approach pages, or multi-location features may take 3–4 weeks. We provide a clear timeline before starting.</p></div>
        </details>
      </div>
    </div>
  </section>


  <section class="section" id="related-services" aria-label="Related services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Explore More</p>
        <h2>More <span class="highlight">Mental Health</span> Services</h2>
      </div>
      <div class="related-services-grid reveal">
          <a href="/mental-health-marketing-singapore/" class="related-service-link">Mental Health Marketing</a>
          <a href="/mental-health-ai-search-optimisation-singapore/" class="related-service-link">Mental Health GEO</a>
          <a href="/mental-health-google-ads-singapore/" class="related-service-link">Mental Health Google Ads</a>
          <a href="/mental-health-social-media-singapore/" class="related-service-link">Mental Health Social Media</a>
      </div>
    </div>
  </section>

  <MarketingFunnelBlock
    industry="mental health practice"
    marketingHref="/mental-health-marketing-singapore/"
    outcomeLine="See how we'd reach more people looking for support in Singapore"
    ctaText="Mental Health Marketing Singapore"
  />

</ServiceLayout>
