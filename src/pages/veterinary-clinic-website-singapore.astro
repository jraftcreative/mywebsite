---
import ServiceLayout from '../layouts/ServiceLayout.astro';
import RelatedServices from '../components/RelatedServices.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Veterinary Clinic Website Design Singapore",
    "description": "Professional website design for veterinary clinics in Singapore. Service pages, vet profiles, and online appointment booking",
    "provider": {
      "@type": "Organization",
      "name": "Jraft Creative",
      "url": "https://jraftcreative.com/",
      "logo": "https://jraftcreative.com/images/logo.png",
      "telephone": "+6582234578",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "60 Paya Lebar Road, Paya Lebar Square",
        "postalCode": "409051",
        "addressLocality": "Singapore",
        "addressCountry": "SG"
      }
    },
    "areaServed": { "@type": "Country", "name": "Singapore" },
    "serviceType": "Veterinary Clinic Website Design"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How much does a veterinary clinic website cost in Singapore?", "acceptedAnswer": { "@type": "Answer", "text": "Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote." } },
      { "@type": "Question", "name": "Can you integrate online appointment booking for my vet clinic?", "acceptedAnswer": { "@type": "Answer", "text": "Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote." } },
      { "@type": "Question", "name": "Can you include 24-hour emergency information on the website?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. For clinics that offer after-hours or 24-hour emergency services, we build prominent emergency information sections — including a dedicated emergency page, tap-to-call buttons, operating hours with holiday schedules, and clear instructions for pet owners in urgent situations. This is included in all packages." } },
      { "@type": "Question", "name": "Do veterinary websites need to follow any regulations in Singapore?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Veterinary practices in Singapore are regulated by the National Parks Board (NParks) and the Singapore Veterinary Association (SVA). Veterinarians listed on your website should hold a valid practising certificate from the Agri-Food and Veterinary Authority (AVA). We ensure all content is professional and compliant with industry standards." } },
      { "@type": "Question", "name": "How long does it take to build a veterinary clinic website?", "acceptedAnswer": { "@type": "Answer", "text": "Most veterinary clinic websites go live within 2–3 weeks. A standard 5-page site can be ready in 2 weeks. Larger projects with online booking, pet owner resource libraries, or multi-location features may take 3–4 weeks. We provide a clear timeline before starting." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "Veterinary Clinic Website Design Singapore", "item": "https://jraftcreative.com/veterinary-clinic-website-singapore/" }
    ]
  }
];
---

<style is:global>
  /* Hide the global background grid pattern on this page only */
  .animated-bg__grid { display: none; }

  /* More-prominent related-service pills — match challenge-card-v2 green treatment */
  #related-services .related-service-link {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.35);
    color: var(--text);
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  #related-services .related-service-link:hover {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.22) 0%, rgba(73, 184, 137, 0.1) 100%), rgba(20, 28, 32, 0.7);
    border-color: rgba(73, 184, 137, 0.6);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(73, 184, 137, 0.3);
  }
  .service-cta-section { background: var(--bg-alt) !important; }
  .renovation-funnel { list-style: none; padding: 0; margin: 56px 0 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 48px; }
  .funnel-stage { position: relative; text-align: center; padding: 28px 20px; background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6); border: 1px solid rgba(73, 184, 137, 0.28); border-radius: 12px; transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease; }
  .funnel-stage:hover { transform: translateY(-4px); border-color: rgba(73, 184, 137, 0.55); box-shadow: 0 16px 40px -16px rgba(73, 184, 137, 0.3); }
  .funnel-stage h3 { font-size: 1.05rem; font-weight: 600; color: var(--accent); margin: 0 0 8px 0; letter-spacing: -0.01em; }
  .funnel-stage p { font-size: 0.82rem; color: var(--text); line-height: 1.5; margin: 0; }
  .funnel-stage:not(:last-child)::after { content: '→'; position: absolute; right: -34px; top: 50%; transform: translateY(-50%); color: var(--accent); font-size: 1.6rem; font-weight: 500; z-index: 2; line-height: 1; opacity: 0.7; }
  @media (max-width: 900px) { .renovation-funnel { grid-template-columns: repeat(2, 1fr); gap: 32px; } .funnel-stage:nth-child(2n)::after, .funnel-stage:last-child::after { display: none; } .funnel-stage:nth-child(2n-1)::after { right: -22px; } }
  @media (max-width: 600px) { .renovation-funnel { grid-template-columns: 1fr; gap: 20px; } .funnel-stage::after { display: none; } }
</style>

<ServiceLayout
  title="Veterinary Clinic Website — Web Design Agency"
  description="Website design for Singapore vet clinics — service pages, vet profiles, 24-hour emergency info, online appointment booking."
  canonical="https://jraftcreative.com/veterinary-clinic-website-singapore/"
  ogTitle="Veterinary Clinic Website — Web Design Agency"
  ogDescription="Website design for Singapore vet clinics — service pages, vet profiles, 24-hour emergency info, online appointment booking."
  ogImage="https://jraftcreative.com/images/og-webdev.jpg"
  keywords="veterinary clinic website design singapore, vet clinic website singapore, veterinary website design, vet web design singapore, animal clinic website, pet clinic website singapore, Jraft Creative"
  schemaData={schemaData}
  heroLabel="Web Design Agency for Veterinary Clinics"
  heroTitle='Web Design Agency for <span class="highlight">Veterinary Clinics in Singapore</span>'
  heroSubtitle="Pet owners in Singapore are searching online for trusted vets. We build fast, mobile-friendly websites for veterinary clinics — with service pages, veterinarian profiles, 24-hour emergency information, online appointment booking, and pet owner resources."
  heroImage="/images/service-veterinary.webp"
  heroButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "See Our Work", href: "/services/website-development/#portfolio", class: "btn btn-secondary" }
  ]}
  whatsappText="Hi Jraft Creative, I need a website for my veterinary clinic in Singapore."
  ctaLabel="Ready to Get Started?"
  ctaTitle="Get Your Vet Clinic Online"
  ctaDescription="Book a free consultation and tell us about your veterinary practice. We'll get back to you within 24 hours with a tailored proposal."
  ctaButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%20need%20a%20website%20for%20my%20veterinary%20clinic%20in%20Singapore.", class: "btn btn-secondary" }
  ]}
>

  <!-- ========== THE CHALLENGE ========== -->
  <section class="section" id="challenge" aria-label="Website challenges for veterinary clinics in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Challenge</p>
        <h2>Pet Owners Are Choosing Their Vet <span class="highlight">Online</span></h2>
      </div>
      <div class="section-content reveal">
        <p>A pet owner picks a clinic from their phone — comparing services, reviews and hours before they ever call. Your website is that first impression.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>An Outdated Site Loses Owners</h3>
            <p>If your website is dated or hard to use, an anxious owner books with the clinic that made finding help easy.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Owners Need Reassurance, Fast</h3>
            <p>Before a first visit they want to see your vets, services and hours — and book without waiting for opening time.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Emergencies Reward the Findable</h3>
            <p>A frightened owner at 11pm searches for help. If your emergency info isn't obvious, the call goes elsewhere.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHAT WE DELIVER ========== -->
  <section class="section" id="sub-services" style="background: var(--bg-alt);" aria-label="Website services for veterinary clinics">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">What We Build</p>
        <h2>Six <span class="highlight">Pillars</span> of a Veterinary Clinic <span class="highlight">Website</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Every element is built around owner trust and booking — structured for how pet owners actually choose a vet.</p>
      </div>
      <div class="service-details-grid deliver-grid">
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-business-website.webp');">
          <div class="service-detail-card__content">
            <h3>Service &amp; Treatment Pages</h3>
            <p>A page per service — vaccination, sterilisation, surgery, dental, health screening — so owners find exactly what their pet needs.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-landing-page.webp');">
          <div class="service-detail-card__content">
            <h3>Veterinarian Profiles</h3>
            <p>Profiles for each vet — qualifications, special interests and a warm bio — because owners want to know who will treat their pet.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-local-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Online Appointment Booking</h3>
            <p>Owners book directly — vet, service and time — with confirmations that cut no-shows and free the front desk.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-graphic-design.webp');">
          <div class="service-detail-card__content">
            <h3>Emergency &amp; Hours, Front and Centre</h3>
            <p>Clear emergency and after-hours information where a worried owner can find it in one tap.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-onpage-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Search-Ready Foundations</h3>
            <p>Clean structure, schema and fast mobile loads built in, so the site can rank for vet searches rather than needing rescuing later.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-speed-vitals.webp');">
          <div class="service-detail-card__content">
            <h3>Mobile-First &amp; Fast</h3>
            <p>Owners search on their phones, often stressed. Every page is built mobile-first, fast, with tap-to-call and tap-to-book.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHY US ========== -->
  <section class="section" id="why-us" aria-label="Why choose Jraft Creative for veterinary website">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2>A <span class="highlight">Web Design Agency</span> That Understands <span class="highlight">Pet Owners</span></h2>
      </div>
      <div class="section-content reveal">
        <p>A site warm enough to reassure an owner, clear enough to answer them, and fast enough to catch the emergency.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Veterinary Sector Understanding</h3>
            <p>We know what makes owners trust a clinic — visible credentials, real reviews, clear emergency info — and design every element around it.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Live Before You Need It</h3>
            <p>Most vet sites go live within two to three weeks, so a new clinic or a refreshed brand is working when you need it.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Website, SEO &amp; Ads Together</h3>
            <p>We also run <a href="/veterinary-clinic-seo-singapore/">vet SEO</a> and <a href="/veterinary-clinic-google-ads-singapore/">Google Ads</a> — one agency for the whole online presence.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== FUNNEL ========== -->
  <section class="section" id="buyer-funnel" style="background: var(--bg-alt);" aria-label="Where website fits the pet-owner journey">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Owner Journey</p>
        <h2>Where <span class="highlight">Website</span> Fits the <span class="highlight">Pet-Owner Journey</span></h2>
      </div>
      <div class="section-content reveal" style="margin-bottom: 24px;">
        <p>A pet owner moves through five stages before booking. Your website carries the middle three — it is where they research the service, compare you against other clinics, and finally book.</p>
      </div>
      <ol class="renovation-funnel reveal">
        <li class="funnel-stage"><h3>Discover</h3><p>A search or referral brings them to the site</p></li>
        <li class="funnel-stage"><h3>Research</h3><p>Service pages and vet profiles answer it</p></li>
        <li class="funnel-stage"><h3>Compare</h3><p>Reviews and hours weigh you against others</p></li>
        <li class="funnel-stage"><h3>Book</h3><p>Online booking turns worry into an appointment</p></li>
        <li class="funnel-stage"><h3>Care</h3><p>A good first visit, then a lifetime of loyalty</p></li>
      </ol>
    </div>
  </section>

  <!-- ========== PRICING ========== -->
  <!-- ========== FAQ ========== -->
  <section class="section faq-section" id="faq" style="background: var(--bg-alt);" aria-label="Frequently asked questions about veterinary website design in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">FAQ</p>
        <h2>Veterinary <span class="highlight">Website</span> Questions Answered</h2>
      </div>
      <div class="faq-list">
        <details class="faq-item reveal reveal-d1">
          <summary>How much does a veterinary clinic website cost in Singapore?</summary>
          <div class="faq-answer"><p>Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>Can you integrate online appointment booking for my vet clinic?</summary>
          <div class="faq-answer"><p>Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote.</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>Can you include 24-hour emergency information on the website?</summary>
          <div class="faq-answer"><p>Yes. For clinics that offer after-hours or 24-hour emergency services, we build prominent emergency information sections — including a dedicated emergency page, tap-to-call buttons, operating hours with holiday schedules, and clear instructions for pet owners in urgent situations. This is included in all packages.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>Do veterinary websites need to follow any regulations in Singapore?</summary>
          <div class="faq-answer"><p>Yes. Veterinary practices in Singapore are regulated by the National Parks Board (NParks) and the Singapore Veterinary Association (SVA). Veterinarians listed on your website should hold a valid practising certificate from the Agri-Food and Veterinary Authority (AVA). We ensure all content is professional and compliant with industry standards.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>How long does it take to build a veterinary clinic website?</summary>
          <div class="faq-answer"><p>Most veterinary clinic websites go live within 2–3 weeks. A standard 5-page site can be ready in 2 weeks. Larger projects with online booking, pet owner resource libraries, or multi-location features may take 3–4 weeks. We provide a clear timeline before starting.</p></div>
        </details>
      </div>
    </div>
  </section>


  <section class="section" id="related-services" aria-label="Related services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Explore More</p>
        <h2>More <span class="highlight">Veterinary Clinic</span> Services</h2>
      </div>
      <div class="related-services-grid reveal">
          <a href="/veterinary-clinic-seo-singapore/" class="related-service-link">Veterinary SEO</a>
          <a href="/veterinary-clinic-google-ads-singapore/" class="related-service-link">Veterinary Google Ads</a>
          <a href="/veterinary-clinic-social-media-singapore/" class="related-service-link">Veterinary Social Media</a>
          <a href="/veterinary-clinic-branding-singapore/" class="related-service-link">Veterinary Branding</a>
          <a href="/veterinary-clinic-marketing-singapore/" class="related-service-link">Full-Service Veterinary Marketing</a>
          <a href="/veterinary-clinic-ai-search-optimisation-singapore/" class="related-service-link">Veterinary GEO / AI Search</a>
      </div>
    </div>
  </section>

</ServiceLayout>
