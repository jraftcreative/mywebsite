---
import ServiceLayout from '../layouts/ServiceLayout.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Pilates Branding Singapore",
    "description": "Branding for pilates studios in Singapore — logo and visual identity, brand strategy and positioning, brand guidelines, and class-menu and collateral design that signals a premium studio.",
    "provider": {
      "@type": "Organization",
      "name": "Jraft Creative",
      "url": "https://jraftcreative.com/",
      "logo": "https://jraftcreative.com/images/logo.png",
      "telephone": "+6582234578",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "60 Paya Lebar Road, Paya Lebar Square",
        "postalCode": "409051",
        "addressLocality": "Singapore",
        "addressCountry": "SG"
      }
    },
    "areaServed": { "@type": "Country", "name": "Singapore" },
    "serviceType": "Pilates Studio Branding"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "Why does a pilates studio need branding?", "acceptedAnswer": { "@type": "Answer", "text": "In a crowded market, branding is what makes clients choose you over the studio nearby — and what lets you hold a premium instead of competing on ClassPass discounts. It's the difference between 'a reformer studio' and 'the studio I want to be part of'." } },
      { "@type": "Question", "name": "Do you only design the logo, or the whole brand?", "acceptedAnswer": { "@type": "Answer", "text": "The whole brand. A logo alone doesn't hold up. We build the identity, colours, type, voice, and the templates and collateral that keep it consistent everywhere clients see you." } },
      { "@type": "Question", "name": "Can you rebrand my existing studio?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We handle full rebrands — refreshing or rebuilding your identity while keeping what already works, and rolling it out across your space, site, and socials so nothing looks half-changed." } },
      { "@type": "Question", "name": "Will the branding work across my website and social media?", "acceptedAnswer": { "@type": "Answer", "text": "That's the point. We design the brand as a system and apply it to your website, Instagram, ads, and print — so every touchpoint feels like the same studio." } },
      { "@type": "Question", "name": "How long does a branding project take?", "acceptedAnswer": { "@type": "Answer", "text": "It depends on scope — a focused identity is quicker than a full rebrand with collateral and guidelines. We'll give you a clear timeline once we understand what you need. Book a consultation to scope it." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "Pilates Branding Singapore", "item": "https://jraftcreative.com/pilates-branding-singapore/" }
    ]
  }
];
---

<style is:global>
  .animated-bg__grid { display: none; }

  #related-services .related-service-link {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.35);
    color: var(--text);
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  #related-services .related-service-link:hover {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.22) 0%, rgba(73, 184, 137, 0.1) 100%), rgba(20, 28, 32, 0.7);
    border-color: rgba(73, 184, 137, 0.6);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(73, 184, 137, 0.3);
  }

  .service-cta-section { background: var(--bg-alt) !important; }

  #sub-services .deliver-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }
  @media (max-width: 900px) { #sub-services .deliver-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { #sub-services .deliver-grid { grid-template-columns: 1fr; } }

  .renovation-funnel {
    list-style: none;
    padding: 0;
    margin: 56px 0 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 48px;
    counter-reset: funnel;
  }
  .funnel-stage {
    position: relative;
    text-align: center;
    padding: 28px 20px;
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.28);
    border-radius: 12px;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .funnel-stage:hover {
    transform: translateY(-4px);
    border-color: rgba(73, 184, 137, 0.55);
    box-shadow: 0 16px 40px -16px rgba(73, 184, 137, 0.3);
  }
  .funnel-stage h3 { font-size: 1.05rem; font-weight: 600; color: var(--accent); margin: 0 0 8px 0; letter-spacing: -0.01em; }
  .funnel-stage p { font-size: 0.82rem; color: var(--text); line-height: 1.5; margin: 0; }
  .funnel-stage:not(:last-child)::after {
    content: '→';
    position: absolute;
    right: -34px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--accent);
    font-size: 1.6rem;
    font-weight: 500;
    z-index: 2;
    line-height: 1;
    opacity: 0.7;
  }
  @media (max-width: 900px) {
    .renovation-funnel { grid-template-columns: repeat(2, 1fr); gap: 32px; }
    .funnel-stage:nth-child(2n)::after, .funnel-stage:last-child::after { display: none; }
    .funnel-stage:nth-child(2n-1)::after { right: -22px; }
  }
  @media (max-width: 600px) {
    .renovation-funnel { grid-template-columns: 1fr; gap: 20px; }
    .funnel-stage::after { display: none; }
  }
</style>

<ServiceLayout
  title="Pilates Branding Singapore — Jraft Creative"
  description="Branding for pilates studios in Singapore — logo and visual identity, brand strategy, guidelines, and class-menu design that signals a premium studio."
  canonical="https://jraftcreative.com/pilates-branding-singapore/"
  ogTitle="Pilates Branding Singapore — Jraft Creative"
  ogDescription="Branding for pilates studios in Singapore. Identity, positioning, and collateral that justify your price and stop clients comparing you on discounts."
  ogImage="https://jraftcreative.com/images/og-webdev.jpg"
  keywords="pilates branding singapore, pilates studio branding, pilates logo design, reformer studio brand identity, pilates rebrand, pilates marketing singapore, Jraft Creative"
  schemaData={schemaData}
  heroLabel="Pilates Branding"
  heroTitle='Branding for <span class="highlight">Pilates Studios in Singapore</span>'
  heroSubtitle="In a market where a new reformer studio opens every month, your brand is what justifies your price and stops clients comparing you on ClassPass discounts alone. We build the identity that makes your studio feel like the premium choice."
  heroImage="/images/service-pilates.webp"
  heroButtons={[
    { text: "Book a Free Brand Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "See How We Work", href: "/process/", class: "btn btn-secondary" }
  ]}
  whatsappText="Hi Jraft Creative, I need branding for my pilates studio in Singapore."
  ctaLabel="Ready to Stand Out?"
  ctaTitle='Build a <span class="highlight">Pilates Brand</span> Clients Choose'
  ctaDescription="Book a free consultation and we'll look at how your studio shows up today, where it blends in, and the brand direction that would set you apart. No obligations."
  ctaButtons={[
    { text: "Book a Free Brand Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%20need%20branding%20for%20my%20pilates%20studio%20in%20Singapore.", class: "btn btn-secondary" }
  ]}
>

  <!-- ========== THE CHALLENGE ========== -->
  <section class="section" id="challenge" aria-label="Why pilates studios need branding in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Challenge</p>
        <h2>Is Your Studio <span class="highlight">Blending In</span>?</h2>
      </div>
      <div class="section-content reveal">
        <p>A new reformer studio opens in Singapore almost every month. When every studio looks the same, clients decide on price — and a strong brand is the only thing that keeps you out of that race.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Blending Into the Crowd</h3>
            <p>Beige walls, a script logo, the same stock look as ten other studios. If clients can't tell you apart, they choose on price — and that's a race to the bottom.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Priced Like a Commodity</h3>
            <p>Without a brand that signals quality, you're compared on ClassPass credits and discount packs. A strong identity is what lets you hold a premium and attract full-fee members.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Inconsistent Everywhere</h3>
            <p>The logo on your sign, your Instagram, and your class menu don't quite match. Inconsistency reads as amateur — and undercuts the premium experience inside your studio.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHAT WE DELIVER ========== -->
  <section class="section" id="sub-services" style="background: var(--bg-alt);" aria-label="Branding services for pilates studios">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">What We Deliver</p>
        <h2>A Brand That <span class="highlight">Commands a Premium</span></h2>
      </div>
      <div class="section-content reveal">
        <p>We build the full brand — not just a logo — as one system that carries from your signage to your feed, so your studio reads as the premium choice everywhere clients meet it.</p>
      </div>
      <div class="service-details-grid deliver-grid">
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-graphic-design.webp');">
          <div class="service-detail-card__content">
            <h3>Logo &amp; Visual Identity</h3>
            <p>A distinctive logo, colour palette, and type system that captures your studio's personality and looks premium across your sign, your app, and your feed.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-copywriting.webp');">
          <div class="service-detail-card__content">
            <h3>Brand Strategy &amp; Positioning</h3>
            <p>Who you're for, what makes you different, and how you talk about it — the positioning that lifts you out of discount comparisons and gives clients a real reason to pick you.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-business-website.webp');">
          <div class="service-detail-card__content">
            <h3>Brand Guidelines</h3>
            <p>A clear style guide so every instructor, designer, and post stays consistent — your brand holds together no matter who's creating for it.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-landing-page.webp');">
          <div class="service-detail-card__content">
            <h3>Collateral &amp; Class-Menu Design</h3>
            <p>Class menus, price cards, signage, and social templates designed as one system — so every touchpoint signals the same quality, in and out of the studio.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHY CHOOSE US ========== -->
  <section class="section" id="why-us" aria-label="Why choose Jraft Creative for pilates branding">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2>Design That <span class="highlight">Sells</span>, Not Just <span class="highlight">Decorates</span></h2>
      </div>
      <div class="section-content reveal">
        <p>We treat branding as a business decision, not a beauty contest. Every choice traces back to the same goal — a studio clients choose, at the price you want to charge.</p>
      </div>
      <div class="service-details-grid" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Strategy-Led Design</h3>
            <p>We start with positioning, not a logo. The design flows from what makes your studio different — so it does a job, not just fills a moodboard.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Built for Boutique Fitness</h3>
            <p>We know the premium, small-group world pilates lives in, and we design so it reads as quality to exactly the clientele willing to pay for it.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>One Agency, All Channels</h3>
            <p>Your brand then carries straight into your website, social, and ads — one consistent studio everywhere clients meet you, built by one team.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== BRANDING FLOW ========== -->
  <section class="section" id="branding-flow" style="background: var(--bg-alt);" aria-label="How pilates branding works">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">How It Works</p>
        <h2>From <span class="highlight">Blend-In</span> to <span class="highlight">Stand-Out</span></h2>
      </div>
      <div class="section-content reveal" style="margin-bottom: 24px;">
        <p>A clear four-step process that takes your studio from generic to unmistakable — and applies it everywhere clients see you.</p>
      </div>
      <ol class="renovation-funnel reveal">
        <li class="funnel-stage">
          <h3>Discover</h3>
          <p>We learn your studio, clients, and edge</p>
        </li>
        <li class="funnel-stage">
          <h3>Strategy</h3>
          <p>Positioning and brand direction set</p>
        </li>
        <li class="funnel-stage">
          <h3>Design</h3>
          <p>Identity and collateral created</p>
        </li>
        <li class="funnel-stage">
          <h3>Rollout</h3>
          <p>Applied across every touchpoint</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ========== FAQ ========== -->
  <section class="section faq-section" id="faq" aria-label="Frequently asked questions about pilates branding in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">FAQ</p>
        <h2><span class="highlight">Pilates Branding</span> — Questions <span class="highlight">Answered</span></h2>
      </div>
      <div class="faq-list">
        <details class="faq-item reveal reveal-d1">
          <summary>Why does a pilates studio need branding?</summary>
          <div class="faq-answer"><p>In a crowded market, branding is what makes clients choose you over the studio nearby — and what lets you hold a premium instead of competing on ClassPass discounts. It's the difference between "a reformer studio" and "the studio I want to be part of".</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>Do you only design the logo, or the whole brand?</summary>
          <div class="faq-answer"><p>The whole brand. A logo alone doesn't hold up. We build the identity, colours, type, voice, and the templates and collateral that keep it consistent everywhere clients see you.</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>Can you rebrand my existing studio?</summary>
          <div class="faq-answer"><p>Yes. We handle full rebrands — refreshing or rebuilding your identity while keeping what already works, and rolling it out across your space, site, and socials so nothing looks half-changed.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>Will the branding work across my website and social media?</summary>
          <div class="faq-answer"><p>That's the point. We design the brand as a system and apply it to your website, Instagram, ads, and print — so every touchpoint feels like the same studio.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>How long does a branding project take?</summary>
          <div class="faq-answer"><p>It depends on scope — a focused identity is quicker than a full rebrand with collateral and guidelines. We'll give you a clear timeline once we understand what you need. Book a consultation to scope it.</p></div>
        </details>
      </div>
    </div>
  </section>


  <!-- Related Services -->
  <section class="section" id="related-services" aria-label="Related services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Explore More</p>
        <h2>More Pilates Services</h2>
      </div>
      <div class="related-services-grid reveal">
          <a href="/pilates-marketing-singapore/" class="related-service-link">Pilates Marketing</a>
          <a href="/pilates-seo-singapore/" class="related-service-link">Pilates SEO</a>
          <a href="/pilates-geo-singapore/" class="related-service-link">Pilates GEO</a>
          <a href="/pilates-ads-singapore/" class="related-service-link">Pilates Google &amp; Meta Ads</a>
          <a href="/pilates-social-media-singapore/" class="related-service-link">Pilates Social Media</a>
          <a href="/pilates-studio-website-singapore/" class="related-service-link">Pilates Studio Websites</a>
      </div>
    </div>
  </section>
</ServiceLayout>
