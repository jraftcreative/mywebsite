---
import ServiceLayout from '../layouts/ServiceLayout.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Aesthetics Clinic Social Media Marketing Singapore",
    "description": "Social media marketing for aesthetics clinics in Singapore. Treatment education content, MOH-compliant before/after posts, doctor Q&A videos, and trust-building campaigns to grow your patient base.",
    "provider": {
      "@type": "Organization",
      "name": "Jraft Creative",
      "url": "https://jraftcreative.com/",
      "logo": "https://jraftcreative.com/images/logo.png",
      "telephone": "+6582234578",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "60 Paya Lebar Road, Paya Lebar Square",
        "postalCode": "409051",
        "addressLocality": "Singapore",
        "addressCountry": "SG"
      }
    },
    "areaServed": { "@type": "Country", "name": "Singapore" },
    "serviceType": "Aesthetics Clinic Social Media Marketing"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How much does social media marketing cost for aesthetics clinics in Singapore?", "acceptedAnswer": { "@type": "Answer", "text": "Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote." } },
      { "@type": "Question", "name": "Is social media content for aesthetics clinics MOH-compliant?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. All our content is created in compliance with MOH advertising guidelines for medical aesthetics in Singapore. We avoid prohibited before/after claims, unsubstantiated results, and misleading imagery — ensuring your social media presence is professional and regulation-compliant." } },
      { "@type": "Question", "name": "What kind of content do you create for aesthetics clinics?", "acceptedAnswer": { "@type": "Answer", "text": "We create treatment education posts, doctor Q&A videos, clinic environment tours, patient testimonials (with consent and MOH compliance), procedure explainer Reels, and trust-building content that positions your doctors as credible experts in aesthetic medicine." } },
      { "@type": "Question", "name": "How does social media help aesthetics clinics build patient trust?", "acceptedAnswer": { "@type": "Answer", "text": "Patients considering aesthetic treatments need to trust both the clinic and the doctor before booking. We create content that humanises your medical team through Q&A sessions, educational posts about treatment safety, and behind-the-scenes clinic content that makes patients feel comfortable and informed before their first visit." } },
      { "@type": "Question", "name": "Which platforms work best for aesthetics clinics in Singapore?", "acceptedAnswer": { "@type": "Answer", "text": "Instagram is the primary platform for aesthetics clinics — treatment education carousels, procedure Reels, and Stories perform exceptionally well. TikTok is growing for aesthetic content, while Facebook remains important for reaching a slightly older demographic considering treatments like anti-ageing procedures and skin rejuvenation." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "Social Media Marketing Singapore", "item": "https://jraftcreative.com/services/social-media/" },
      { "@type": "ListItem", "position": 3, "name": "Aesthetics Clinic Social Media", "item": "https://jraftcreative.com/aesthetics-clinic-social-media-singapore/" }
    ]
  }
];
---

<style is:global>
  /* Hide the global background grid pattern on this page only */
  .animated-bg__grid { display: none; }

  /* More-prominent related-service pills — match challenge-card-v2 green treatment */
  #related-services .related-service-link {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.35);
    color: var(--text);
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  #related-services .related-service-link:hover {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.22) 0%, rgba(73, 184, 137, 0.1) 100%), rgba(20, 28, 32, 0.7);
    border-color: rgba(73, 184, 137, 0.6);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(73, 184, 137, 0.3);
  }
  .service-cta-section { background: var(--bg-alt) !important; }
  .renovation-funnel { list-style: none; padding: 0; margin: 56px 0 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 48px; }
  .funnel-stage { position: relative; text-align: center; padding: 28px 20px; background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6); border: 1px solid rgba(73, 184, 137, 0.28); border-radius: 12px; transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease; }
  .funnel-stage:hover { transform: translateY(-4px); border-color: rgba(73, 184, 137, 0.55); box-shadow: 0 16px 40px -16px rgba(73, 184, 137, 0.3); }
  .funnel-stage h3 { font-size: 1.05rem; font-weight: 600; color: var(--accent); margin: 0 0 8px 0; letter-spacing: -0.01em; }
  .funnel-stage p { font-size: 0.82rem; color: var(--text); line-height: 1.5; margin: 0; }
  .funnel-stage:not(:last-child)::after { content: '→'; position: absolute; right: -34px; top: 50%; transform: translateY(-50%); color: var(--accent); font-size: 1.6rem; font-weight: 500; z-index: 2; line-height: 1; opacity: 0.7; }
  @media (max-width: 900px) { .renovation-funnel { grid-template-columns: repeat(2, 1fr); gap: 32px; } .funnel-stage:nth-child(2n)::after, .funnel-stage:last-child::after { display: none; } .funnel-stage:nth-child(2n-1)::after { right: -22px; } }
  @media (max-width: 600px) { .renovation-funnel { grid-template-columns: 1fr; gap: 20px; } .funnel-stage::after { display: none; } }
</style>

<ServiceLayout
  title="Social Media Agency for Aesthetics Clinics"
  description="Social media marketing for aesthetics clinics in Singapore. MOH-compliant content, treatment education, doctor Q&A videos, and trust-building campaigns."
  canonical="https://jraftcreative.com/aesthetics-clinic-social-media-singapore/"
  ogTitle="Social Media Agency for Aesthetics Clinics"
  ogDescription="Social media marketing built for aesthetics clinics in Singapore. MOH-compliant content that builds patient trust and drives consultations. Plans"
  ogImage="https://jraftcreative.com/images/og-webdev.jpg"
  keywords="aesthetics clinic social media singapore, aesthetics clinic marketing singapore, social media for aesthetics clinics, aesthetic clinic instagram, aesthetics clinic digital marketing singapore, Jraft Creative"
  schemaData={schemaData}
  heroLabel="Social Media Agency for Aesthetics Clinics"
  heroTitle='Social Media Agency for <span class="highlight">Aesthetics Clinics in Singapore</span>'
  heroSubtitle="MOH-compliant content strategy, treatment education, and trust-building campaigns that position your doctors as experts and turn social media followers into consultation bookings. Professional social media management built for Singapore's aesthetics industry."
  heroImage="/images/service-aesthetics.webp"
  heroButtons={[
    { text: "Get a Free Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "See How We Work", href: "/process/", class: "btn btn-secondary" }
  ]}
  whatsappText="Hi Jraft Creative, I need social media marketing for my aesthetics clinic in Singapore."
  ctaLabel="Ready to Get Started?"
  ctaTitle="Grow Your Aesthetics Clinic with Social Media"
  ctaDescription="Book a free consultation and tell us about your clinic. We'll get back to you within 24 hours with a tailored, MOH-compliant social media strategy that builds trust and drives consultations."
  ctaButtons={[
    { text: "Get a Free Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%20need%20social%20media%20marketing%20for%20my%20aesthetics%20clinic%20in%20Singapore.", class: "btn btn-secondary" }
  ]}
>

  <!-- ========== THE CHALLENGE ========== -->
  <section class="section" id="challenge" aria-label="Social media challenges for aesthetics clinics in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Challenge</p>
        <h2>Patients Judge You by Your <span class="highlight">Feed</span> Before They Ever <span class="highlight">Call</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Aesthetics patients research on Instagram and TikTok for weeks before booking. An inactive or over-clinical feed loses them early.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>An Empty Feed Reads as Risk</h3>
            <p>A quiet or generic profile makes a first-time patient nervous. If your social looks inactive, confidence drops before they enquire.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Too Safe or Too Risky</h3>
            <p>Most clinics post bland stock photos or drift into non-compliant claims. Neither builds the trust that converts a follower into a patient.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Competitors Show Up Credibly</h3>
            <p>Clinics in Orchard and Novena run doctor Q&A and treatment explainers. Against consistent, credible content, silence quietly costs you patients.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHAT WE DELIVER ========== -->
  <section class="section" id="sub-services" style="background: var(--bg-alt);" aria-label="Social media services for aesthetics clinics">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">What We Deliver</p>
        <h2>Six <span class="highlight">Content Workstreams</span> for Aesthetics <span class="highlight">Clinics</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Every post is built to educate, build trust and book consultations — all within MOH advertising guidelines.</p>
      </div>
      <div class="service-details-grid deliver-grid">
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-reels-video.webp');">
          <div class="service-detail-card__content">
            <h3>Doctor Q&amp;A Videos</h3>
            <p>Short-form video of your doctors answering real patient questions on Botox, fillers and lasers — building personal trust in the team.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-content-strategy.webp');">
          <div class="service-detail-card__content">
            <h3>Procedure Explainer Reels</h3>
            <p>Clear, compliant explainers on how treatments work, what to expect and recovery — turning curiosity into informed confidence.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-graphic-design.webp');">
          <div class="service-detail-card__content">
            <h3>Treatment Education Carousels</h3>
            <p>MOH-compliant carousels and Stories covering outcomes, timelines and safety — the content that makes booking feel considered.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-community-mgmt.webp');">
          <div class="service-detail-card__content">
            <h3>Patient Community Management</h3>
            <p>Prompt, professional handling of DMs, comments and enquiries — nurturing a lead from first message to booked consultation.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-meta-ads.webp');">
          <div class="service-detail-card__content">
            <h3>Consent-Safe Testimonials</h3>
            <p>Patient stories and results shared with proper consent and compliance — real proof without crossing MOH lines.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-campaign-analytics.webp');">
          <div class="service-detail-card__content">
            <h3>Reporting on Enquiries</h3>
            <p>We track profile-to-enquiry and consultations that mention social — follower count is context, not the result.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHY US ========== -->
  <section class="section" id="why-us" aria-label="Why choose Jraft Creative for aesthetics clinic social media">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2>A <span class="highlight">Social Media Agency</span> That Respects <span class="highlight">Clinical Standards</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Aesthetics social fails on compliance and credibility. We handle both, with your medical team in control.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>MOH Compliance Expertise</h3>
            <p>Every piece is checked against MOH advertising rules before it reaches you — engaging content that stays inside the boundaries.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Doctor-Centric Content</h3>
            <p>We put your doctors at the centre. Doctor-led content builds trust far faster than generic brand posts, and converts better.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>You Approve Before Publishing</h3>
            <p>You and your medical team sign off every post, caption and visual. Nothing goes live without your clinical and marketing approval.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== PATIENT JOURNEY FUNNEL ========== -->
  <section class="section" id="buyer-funnel" style="background: var(--bg-alt);" aria-label="Where Social fits the patient journey">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Patient Journey</p>
        <h2>Where <span class="highlight">Social</span> Fits the <span class="highlight">Patient Journey</span></h2>
      </div>
      <div class="section-content reveal" style="margin-bottom: 24px;">
        <p>An aesthetics patient moves through five stages before booking. Social rarely wins the first search — its job is Validate and Compare, where doctor content and real results earn the trust to book.</p>
      </div>
      <ol class="renovation-funnel reveal">
        <li class="funnel-stage"><h3>Discover</h3><p>A reel or a share puts you on the radar</p></li>
        <li class="funnel-stage"><h3>Validate</h3><p>Doctor content proves clinical expertise</p></li>
        <li class="funnel-stage"><h3>Compare</h3><p>Results and reviews weigh the clinics</p></li>
        <li class="funnel-stage"><h3>Consult</h3><p>DMs and profile link turn interest into a booking</p></li>
        <li class="funnel-stage"><h3>Treat</h3><p>A confident first visit, then repeat &amp; referral</p></li>
      </ol>
    </div>
  </section>

  <!-- ========== PRICING ========== -->
  <!-- ========== FAQ ========== -->
  <section class="section faq-section" id="faq" style="background: var(--bg-alt);" aria-label="Frequently asked questions about aesthetics clinic social media marketing">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">FAQ</p>
        <h2>Aesthetics Clinic <span class="highlight">Social Media</span> — Questions Answered</h2>
      </div>
      <div class="faq-list">
        <details class="faq-item reveal reveal-d1">
          <summary>How much does social media marketing cost for aesthetics clinics in Singapore?</summary>
          <div class="faq-answer"><p>Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>Is social media content for aesthetics clinics MOH-compliant?</summary>
          <div class="faq-answer"><p>Yes. All our content is created in compliance with MOH advertising guidelines for medical aesthetics in Singapore. We avoid prohibited before/after claims, unsubstantiated results, and misleading imagery — ensuring your social media presence is professional and regulation-compliant.</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>What kind of content do you create for aesthetics clinics?</summary>
          <div class="faq-answer"><p>We create treatment education posts, doctor Q&A videos, clinic environment tours, patient testimonials (with consent and MOH compliance), procedure explainer Reels, and trust-building content that positions your doctors as credible experts in aesthetic medicine.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>How does social media help aesthetics clinics build patient trust?</summary>
          <div class="faq-answer"><p>Patients considering aesthetic treatments need to trust both the clinic and the doctor before booking. We create content that humanises your medical team through Q&A sessions, educational posts about treatment safety, and behind-the-scenes clinic content that makes patients feel comfortable and informed before their first visit.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>Which platforms work best for aesthetics clinics in Singapore?</summary>
          <div class="faq-answer"><p>Instagram is the primary platform for aesthetics clinics — treatment education carousels, procedure Reels, and Stories perform exceptionally well. TikTok is growing for aesthetic content, while Facebook remains important for reaching a slightly older demographic considering treatments like anti-ageing procedures and skin rejuvenation.</p></div>
        </details>
      </div>
    </div>
  </section>


  <!-- Related Services -->
  <section class="section" id="related-services" aria-label="Related services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Explore More</p>
        <h2>More Aesthetics Clinic Services</h2>
      </div>
      <div class="related-services-grid reveal">
          <a href="/aesthetics-clinic-seo-singapore/" class="related-service-link">Aesthetics Clinic SEO</a>
          <a href="/aesthetics-clinic-website-singapore/" class="related-service-link">Aesthetics Clinic Website</a>
          <a href="/aesthetics-clinic-google-ads-singapore/" class="related-service-link">Aesthetics Clinic Google Ads</a>
          <a href="/aesthetics-clinic-marketing-singapore/" class="related-service-link">Aesthetics Clinic Marketing</a>
          <a href="/aesthetics-clinic-branding-singapore/" class="related-service-link">Aesthetics Clinic Branding</a>
          <a href="/aesthetics-clinic-ai-search-optimisation-singapore/" class="related-service-link">Aesthetics Clinic GEO / AI Search</a>
          <a href="/aesthetics-content-marketing-singapore/" class="related-service-link">Aesthetics Content Marketing</a>
      </div>
    </div>
  </section>
</ServiceLayout>