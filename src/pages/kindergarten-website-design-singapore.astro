---
import ServiceLayout from '../layouts/ServiceLayout.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Kindergarten Website Design Singapore",
    "description": "Website design for kindergartens, preschools, and childcare centres in Singapore — programme and curriculum pages, teacher profiles, centre-visit booking, online enrolment forms, and ECDA licence display.",
    "provider": {
      "@type": "Organization",
      "name": "Jraft Creative",
      "url": "https://jraftcreative.com/",
      "logo": "https://jraftcreative.com/images/logo.png",
      "telephone": "+6582234578",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "60 Paya Lebar Road, Paya Lebar Square",
        "postalCode": "409051",
        "addressLocality": "Singapore",
        "addressCountry": "SG"
      }
    },
    "areaServed": { "@type": "Country", "name": "Singapore" },
    "serviceType": "Kindergarten Website Design"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How much does a kindergarten website cost in Singapore?", "acceptedAnswer": { "@type": "Answer", "text": "Pricing depends on your programmes, your number of branches, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what your preschool needs and give you a transparent quote." } },
      { "@type": "Question", "name": "Can you display our ECDA licence on the website?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We display your ECDA licence number, SPARK certification status, and any MOE Kindergarten registration details clearly on the site. Parents check licensing before shortlisting a centre, so putting it up front helps them feel confident enough to book a visit." } },
      { "@type": "Question", "name": "Can parents book a centre visit or submit an enrolment enquiry through the site?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We build centre-visit booking and online enrolment or waitlist forms straight into your website. Parents choose a programme such as nursery, K1, or K2, pick a preferred start date, and submit their child's details — with automated confirmation emails that cut the manual follow-up for your admin team." } },
      { "@type": "Question", "name": "Do you build websites for childcare centres and preschools too, not just kindergartens?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We build for kindergartens, preschools, and childcare centres across Singapore — from a single centre in Punggol or Tampines to a multi-branch operator. Each site is shaped around your age groups, from playgroup and nursery through K1 and K2, and your curriculum approach." } },
      { "@type": "Question", "name": "How do you handle photos of children on the website?", "acceptedAnswer": { "@type": "Answer", "text": "We build your gallery as consent-gated. Only images you have written parental consent to publish go live, and we set the gallery up so you can add or remove photos easily as consent changes. It keeps your centre aligned with PDPA and ECDA expectations while still showing families a real classroom environment." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "Kindergarten Website Design Singapore", "item": "https://jraftcreative.com/kindergarten-website-design-singapore/" }
    ]
  }
];
---

<style is:global>
  /* Hide the global background grid pattern on this page only */
  .animated-bg__grid { display: none; }

  /* More-prominent related-service pills — match challenge-card-v2 green treatment */
  #related-services .related-service-link {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.35);
    color: var(--text);
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  #related-services .related-service-link:hover {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.22) 0%, rgba(73, 184, 137, 0.1) 100%), rgba(20, 28, 32, 0.7);
    border-color: rgba(73, 184, 137, 0.6);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(73, 184, 137, 0.3);
  }

  /* Separate the CTA section from related-services with bg-alt */
  .service-cta-section {
    background: var(--bg-alt) !important;
  }

  /* Trial-to-Enrolment Funnel — 5-stage horizontal flow with green accents */
  .renovation-funnel {
    list-style: none;
    padding: 0;
    margin: 56px 0 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 48px;
    counter-reset: funnel;
  }
  .funnel-stage {
    position: relative;
    text-align: center;
    padding: 28px 20px;
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.28);
    border-radius: 12px;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .funnel-stage:hover {
    transform: translateY(-4px);
    border-color: rgba(73, 184, 137, 0.55);
    box-shadow: 0 16px 40px -16px rgba(73, 184, 137, 0.3);
  }
  .funnel-stage h3 {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--accent);
    margin: 0 0 8px 0;
    letter-spacing: -0.01em;
  }
  .funnel-stage p {
    font-size: 0.82rem;
    color: var(--text);
    line-height: 1.5;
    margin: 0;
  }
  .funnel-stage:not(:last-child)::after {
    content: '→';
    position: absolute;
    right: -34px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--accent);
    font-size: 1.6rem;
    font-weight: 500;
    z-index: 2;
    line-height: 1;
    opacity: 0.7;
  }
  @media (max-width: 900px) {
    .renovation-funnel {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }
    .funnel-stage:nth-child(2n)::after,
    .funnel-stage:last-child::after {
      display: none;
    }
    .funnel-stage:nth-child(2n-1)::after {
      right: -22px;
    }
  }
  @media (max-width: 600px) {
    .renovation-funnel {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .funnel-stage::after {
      display: none;
    }
  }
</style>

<ServiceLayout
  title="Kindergarten Website Design Singapore — Jraft Creative"
  description="Web design agency for kindergartens and preschools in Singapore — programme pages, teacher profiles, centre-visit booking, enrolment forms, ECDA licence."
  canonical="https://jraftcreative.com/kindergarten-website-design-singapore/"
  ogTitle="Kindergarten Website Design Singapore — Jraft Creative"
  ogDescription="Website design for kindergartens, preschools, and childcare centres in Singapore. Programme pages, teacher profiles, centre-visit booking, and ECDA licence display."
  ogImage="https://jraftcreative.com/images/og-webdev.jpg"
  keywords="kindergarten website design singapore, preschool website design singapore, childcare centre website singapore, preschool web design, kindergarten web design, nursery website singapore, Jraft Creative"
  schemaData={schemaData}
  heroLabel="Web Design Agency for Kindergartens"
  heroTitle='Web Design Agency for <span class="highlight">Kindergartens &amp; Preschools</span>'
  heroSubtitle="Parents shortlist kindergartens online long before they book a centre visit. We build warm, trust-building websites for preschools and childcare centres — programme pages, teacher profiles, centre-visit booking, and clear ECDA licence display — so families feel confident enough to enquire."
  heroImage="/images/service-kindergarten.webp"
  heroImageAlt="Kindergarten in Singapore"
  heroButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "Website Development", href: "/services/website-development/", class: "btn btn-secondary" }
  ]}
  whatsappText="Hi Jraft Creative, I need a website for my kindergarten in Singapore."
  ctaLabel="Ready to Fill Your Next Intake?"
  ctaTitle="Get Your Kindergarten Online"
  ctaDescription="Tell us about your preschool and we'll recommend the right website scope. Free consultation — no obligations, no pressure."
  ctaButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%20need%20a%20website%20for%20my%20kindergarten%20in%20Singapore.", class: "btn btn-secondary" }
  ]}
  hideDefaultCta={false}
>

  <!-- ========== THE CHALLENGE ========== -->
  <section class="section" id="challenge" aria-label="Website challenges for kindergartens and preschools in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Challenge</p>
        <h2>Parents Are <span class="highlight">Comparing Preschools</span> — Before They <span class="highlight">Ever Call</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Before a parent ever phones your front office, they have already searched "preschool near me", opened three or four kindergarten sites side by side, and checked whether each ECDA licence is current. The site that reads clearly and looks cared-for is the one that gets the visit. A <a href="/blog/good-business-website-singapore/">website built to do its job</a> is what earns that first enquiry.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>A Facebook Page Isn't Enough</h3>
            <p>Parents want programmes, curriculum, teacher profiles, ECDA licence and a way to book a visit in one place. A social page or directory listing answers none of it.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Parents Research Thoroughly</h3>
            <p>They read curriculum approaches, check teacher-to-child ratios and look for real classroom photos. Anything missing becomes a reason to shortlist the centre down the road instead.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>The Neighbourhood Is Crowded</h3>
            <p>From Punggol and Sengkang to Jurong and Woodlands, families often have several ECDA-licensed centres within walking distance. Your site is what decides whether they enquire or scroll on.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHAT WE BUILD ========== -->
  <section class="section" id="sub-services" style="background: var(--bg-alt);" aria-label="Kindergarten website design services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">What We Build</p>
        <h2>Six <span class="highlight">Pillars</span> of a Kindergarten <span class="highlight">Website</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Every site is built to turn a browsing parent into a booked centre visit, not just to look good. It sits on solid <a href="/services/website-development/">website development</a> and is shaped by how the wider <a href="/industries/education/">education sector</a> earns parent trust in Singapore.</p>
      </div>
      <div class="service-details-grid deliver-grid">
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-business-website.webp');">
          <div class="service-detail-card__content">
            <h3>Programme &amp; Curriculum Pages</h3>
            <p>A page per age group — playgroup, nursery, K1 and K2 — laying out your early-childhood curriculum, daily rhythm and learning outcomes, so parents picture their child's day at your centre.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-landing-page.webp');">
          <div class="service-detail-card__content">
            <h3>Centre-Visit &amp; Enrolment Forms</h3>
            <p>Parents book a centre visit or submit an enrolment or waitlist enquiry straight from the site — programme, preferred start date, automated confirmations. Fewer late-night WhatsApp messages for your admin team.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-local-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Teacher &amp; Principal Profiles</h3>
            <p>Qualifications, early-childhood training and years with young children, with warm headshots that let parents get to know the people who will look after their child.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-graphic-design.webp');">
          <div class="service-detail-card__content">
            <h3>ECDA Licence &amp; Subsidy Info</h3>
            <p>Your ECDA licence number, SPARK status and MOE Kindergarten details displayed clearly, alongside plain-English subsidy information so parents understand what support they may be eligible for.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-reels-video.webp');">
          <div class="service-detail-card__content">
            <h3>Consent-Gated Gallery</h3>
            <p>A classroom and outdoor-play gallery where only images you hold written parental consent for go live, easy to update as consent changes — real environment, handled the right way.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-speed-vitals.webp');">
          <div class="service-detail-card__content">
            <h3>Mobile-First &amp; Fast</h3>
            <p>Parents browse on their phones between school runs. Clean structure, quick mobile loads, tap-to-call and schema built in from day one, so the site is ready to be found rather than rescued later.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHY US ========== -->
  <section class="section" id="why-us" aria-label="Why choose Jraft Creative as your kindergarten web design agency">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2>A <span class="highlight">Web Design Agency</span> That Understands <span class="highlight">Preschools</span></h2>
      </div>
      <div class="section-content reveal">
        <p>We build for the specific problem preschools have — standing out in a crowded neighbourhood, then turning a parent's enquiry into a term-long enrolment.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Early-Childhood Sector Knowledge</h3>
            <p>We understand the preschool landscape — ECDA licensing, SPARK, subsidy displays and the way parents actually choose a centre — so the site is built around how kindergartens really operate.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Live Before Your Next Intake</h3>
            <p>Most preschool sites go live within two weeks, so you start capturing centre-visit bookings ahead of the new academic year or a new branch opening in Bishan or Sengkang.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Compliance-Minded By Default</h3>
            <p>Consent-gated child imagery, careful ECDA licence display and no exaggerated claims. We build to keep your centre on the right side of ECDA and PDPA expectations.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== ENROLMENT FUNNEL ========== -->
  <section class="section" id="buyer-funnel" style="background: var(--bg-alt);" aria-label="Where your website fits the parent enrolment journey">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Enrolment Funnel</p>
        <h2>Where Your <span class="highlight">Website</span> Fits the <span class="highlight">Parent Journey</span></h2>
      </div>
      <div class="section-content reveal" style="margin-bottom: 24px;">
        <p>Parents move through the same five stages before a child starts at your centre. Your website carries the middle three — it is where a parent validates your teachers and licence, compares you against the shortlist, and finally books the visit.</p>
      </div>
      <ol class="renovation-funnel reveal">
        <li class="funnel-stage">
          <h3>Discover</h3>
          <p>A search or referral brings a family to the site</p>
        </li>
        <li class="funnel-stage">
          <h3>Validate</h3>
          <p>Teacher profiles, ECDA licence, classroom photos</p>
        </li>
        <li class="funnel-stage">
          <h3>Compare</h3>
          <p>Programme pages answer age group, approach and fit</p>
        </li>
        <li class="funnel-stage">
          <h3>Visit</h3>
          <p>Booking flow turns interest into a scheduled visit</p>
        </li>
        <li class="funnel-stage">
          <h3>Enrol</h3>
          <p>Sign for the term, renew &amp; refer</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ========== PRICING ========== -->
  <!-- ========== FAQ ========== -->
  <section class="section faq-section" id="faq" style="background: var(--bg-alt);" aria-label="Frequently asked questions about kindergarten website design in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">FAQ</p>
        <h2>Kindergarten <span class="highlight">Website</span> Questions Answered</h2>
      </div>
      <div class="faq-list">
        <details class="faq-item reveal reveal-d1">
          <summary>How much does a kindergarten website cost in Singapore?</summary>
          <div class="faq-answer"><p>Pricing depends on your programmes, your number of branches, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what your preschool needs and give you a transparent quote.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>Can you display our ECDA licence on the website?</summary>
          <div class="faq-answer"><p>Yes. We display your ECDA licence number, SPARK certification status, and any MOE Kindergarten registration details clearly on the site. Parents check licensing before shortlisting a centre, so putting it up front helps them feel confident enough to book a visit.</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>Can parents book a centre visit or submit an enrolment enquiry through the site?</summary>
          <div class="faq-answer"><p>Yes. We build centre-visit booking and online enrolment or waitlist forms straight into your website. Parents choose a programme such as nursery, K1, or K2, pick a preferred start date, and submit their child's details — with automated confirmation emails that cut the manual follow-up for your admin team.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>Do you build websites for childcare centres and preschools too, not just kindergartens?</summary>
          <div class="faq-answer"><p>Yes. We build for kindergartens, preschools, and childcare centres across Singapore — from a single centre in Punggol or Tampines to a multi-branch operator. Each site is shaped around your age groups, from playgroup and nursery through K1 and K2, and your curriculum approach.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>How do you handle photos of children on the website?</summary>
          <div class="faq-answer"><p>We build your gallery as consent-gated. Only images you have written parental consent to publish go live, and we set the gallery up so you can add or remove photos easily as consent changes. It keeps your centre aligned with PDPA and ECDA expectations while still showing families a real classroom environment.</p></div>
        </details>
      </div>
    </div>
  </section>


  <!-- Related Services -->
  <section class="section" id="related-services" aria-label="Related services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Explore More</p>
        <h2>More <span class="highlight">Education</span> Services</h2>
      </div>
      <div class="related-services-grid reveal">
          <a href="/industries/education/" class="related-service-link">Education Marketing</a>
          <a href="/services/website-development/" class="related-service-link">Website Development</a>
          <a href="/services/seo-performance/" class="related-service-link">SEO &amp; Performance</a>
          <a href="/services/social-media/" class="related-service-link">Social Media</a>
      </div>
    </div>
  </section>
</ServiceLayout>
