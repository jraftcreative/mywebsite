---
import ServiceLayout from '../layouts/ServiceLayout.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Yoga Studio GEO Singapore",
    "description": "Generative Engine Optimisation (GEO) for yoga studios in Singapore — get your studio named and cited inside ChatGPT, Gemini, Perplexity, and Google AI Overviews.",
    "provider": {
      "@type": "Organization",
      "name": "Jraft Creative",
      "url": "https://jraftcreative.com/",
      "logo": "https://jraftcreative.com/images/logo.png",
      "telephone": "+6582234578",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "60 Paya Lebar Road, Paya Lebar Square",
        "postalCode": "409051",
        "addressLocality": "Singapore",
        "addressCountry": "SG"
      }
    },
    "areaServed": { "@type": "Country", "name": "Singapore" },
    "serviceType": "Yoga Studio GEO / AI Search Optimisation"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "Will my yoga studio show up in ChatGPT or Google AI Overviews?", "acceptedAnswer": { "@type": "Answer", "text": "That's the whole point of GEO. When someone asks ChatGPT, Gemini, Perplexity, or Google's AI Overviews for a hot yoga studio near Tanjong Pagar or a prenatal class in Novena, the answer names a handful of studios. We make yours one of them by giving the engines clear, verifiable signals they trust." } },
      { "@type": "Question", "name": "How is GEO different from SEO for a yoga studio?", "acceptedAnswer": { "@type": "Answer", "text": "SEO gets you ranked in Google's blue links. GEO (generative engine optimisation) gets your studio named and cited inside AI answers — ChatGPT, Gemini, Perplexity, and Google AI Overviews. They share foundations, but AI engines weigh structured data, entity clarity, and third-party mentions differently. We do both." } },
      { "@type": "Question", "name": "How do you measure AI visibility for a yoga studio?", "acceptedAnswer": { "@type": "Answer", "text": "We build a bank of the real questions students ask AI — vinyasa near Bugis, hot yoga in Orchard, aerial classes in Katong — and re-run it each month. We track your AI Visibility Score, how often you're mentioned, how often you're cited with a link, and your share of voice against nearby studios." } },
      { "@type": "Question", "name": "How long until my yoga studio gets cited by AI?", "acceptedAnswer": { "@type": "Answer", "text": "Perplexity and Google AI Overviews pull live data and can move within about 4 to 8 weeks. ChatGPT and Gemini shift more slowly as your entity authority builds across the sources they trust. We re-test monthly so you can watch the movement." } },
      { "@type": "Question", "name": "Do I need SEO too, or just GEO?", "acceptedAnswer": { "@type": "Answer", "text": "Strong technical and content SEO is the foundation GEO builds on, so we usually run them together. If your SEO is weak, we fix that first — clean structured data and clear class pages make the AI-citation work land faster." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "Yoga Studio GEO Singapore", "item": "https://jraftcreative.com/yoga-studio-geo-singapore/" }
    ]
  }
];
---

<style is:global>
  .animated-bg__grid { display: none; }

  #related-services .related-service-link {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.35);
    color: var(--text);
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  #related-services .related-service-link:hover {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.22) 0%, rgba(73, 184, 137, 0.1) 100%), rgba(20, 28, 32, 0.7);
    border-color: rgba(73, 184, 137, 0.6);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(73, 184, 137, 0.3);
  }

  .service-cta-section { background: var(--bg-alt) !important; }

  #sub-services .deliver-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }
  @media (max-width: 900px) { #sub-services .deliver-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { #sub-services .deliver-grid { grid-template-columns: 1fr; } }

  .renovation-funnel {
    list-style: none;
    padding: 0;
    margin: 56px 0 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 48px;
    counter-reset: funnel;
  }
  .funnel-stage {
    position: relative;
    text-align: center;
    padding: 28px 20px;
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.28);
    border-radius: 12px;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .funnel-stage:hover {
    transform: translateY(-4px);
    border-color: rgba(73, 184, 137, 0.55);
    box-shadow: 0 16px 40px -16px rgba(73, 184, 137, 0.3);
  }
  .funnel-stage h3 { font-size: 1.05rem; font-weight: 600; color: var(--accent); margin: 0 0 8px 0; letter-spacing: -0.01em; }
  .funnel-stage p { font-size: 0.82rem; color: var(--text); line-height: 1.5; margin: 0; }
  .funnel-stage:not(:last-child)::after {
    content: '→';
    position: absolute;
    right: -34px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--accent);
    font-size: 1.6rem;
    font-weight: 500;
    z-index: 2;
    line-height: 1;
    opacity: 0.7;
  }
  @media (max-width: 900px) {
    .renovation-funnel { grid-template-columns: repeat(2, 1fr); gap: 32px; }
    .funnel-stage:nth-child(2n)::after, .funnel-stage:last-child::after { display: none; }
    .funnel-stage:nth-child(2n-1)::after { right: -22px; }
  }
  @media (max-width: 600px) {
    .renovation-funnel { grid-template-columns: 1fr; gap: 20px; }
    .funnel-stage::after { display: none; }
  }
</style>

<ServiceLayout
  title="Yoga Studio GEO & AI Search Singapore — Jraft Creative"
  description="GEO for yoga studios in Singapore — get named and cited inside ChatGPT, Gemini, Perplexity, and Google AI Overviews."
  canonical="https://jraftcreative.com/yoga-studio-geo-singapore/"
  ogTitle="Yoga Studio GEO Singapore — Jraft Creative"
  ogDescription="Get your yoga studio named in AI search. GEO that makes ChatGPT, Gemini, Perplexity, and Google's AI recommend your studio."
  ogImage="https://jraftcreative.com/images/og-yoga.jpg"
  keywords="yoga studio geo singapore, yoga ai search optimisation, yoga studio chatgpt, generative engine optimisation yoga, yoga ai visibility, hot yoga ai search, yoga marketing singapore, Jraft Creative"
  schemaData={schemaData}
  heroLabel="Yoga Studio GEO / AI Search"
  heroTitle='Get Your <span class="highlight">Yoga Studio</span> Named in <span class="highlight">AI Search</span>'
  heroSubtitle="When someone asks ChatGPT, Gemini, or Google's AI for the best hot yoga studio near them, one studio gets named — and it takes the trial booking. GEO is how we make that studio yours."
  heroImage="/images/service-yoga.webp"
  heroButtons={[
    { text: "Get a Free AI Visibility Check", href: "/contact/", class: "btn btn-primary" },
    { text: "See How We Work", href: "/process/", class: "btn btn-secondary" }
  ]}
  whatsappText="Hi Jraft Creative, I want my yoga studio cited in AI search (GEO)."
  ctaLabel="Ready to Be the AI's Answer?"
  ctaTitle='Get Your <span class="highlight">Yoga Studio</span> Cited in AI Search'
  ctaDescription="Book a free AI visibility check and we'll show you exactly what ChatGPT, Gemini, and Google's AI say about your studio today — and who's getting named instead. No obligations."
  ctaButtons={[
    { text: "Get a Free AI Visibility Check", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%20want%20my%20yoga%20studio%20cited%20in%20AI%20search%20%28GEO%29.", class: "btn btn-secondary" }
  ]}
>

  <!-- ========== THE CHALLENGE ========== -->
  <section class="section" id="challenge" aria-label="Why yoga studios need GEO in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Challenge</p>
        <h2>Search Has <span class="highlight">Split in Two</span> — and AI Is Naming <span class="highlight">Someone Else</span></h2>
      </div>
      <div class="section-content reveal">
        <p>More students now ask ChatGPT, Gemini, or Google's AI for a recommendation than scroll ten blue links. Ask any of them for a good vinyasa class near Tiong Bahru and you get a short list of named studios. If yours isn't on it, you never enter the shortlist.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>The Answer, Not the List</h3>
            <p>People ask AI "best hot yoga near Tanjong Pagar" and get a named recommendation, not a page of links. If your studio isn't in that answer, the student never sees you at the moment they decide where to book their first class.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Ranking on Google Isn't Enough</h3>
            <p>AI engines choose who to cite differently — on entity clarity, structured data, and trusted third-party mentions, not just backlinks. A studio that ranks well on Google can still be invisible when someone asks Perplexity where to try prenatal yoga.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Your Competitor Is Getting Cited</h3>
            <p>Right now, an AI query for yin or aerial yoga in your neighbourhood is naming a studio. Every week you're not the one cited, that studio compounds the trust and takes the trial bookings you should be filling.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHAT WE DELIVER ========== -->
  <section class="section" id="sub-services" style="background: var(--bg-alt);" aria-label="GEO services for yoga studios">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">What We Deliver</p>
        <h2>How We Get Your Studio <span class="highlight">Cited</span></h2>
      </div>
      <div class="section-content reveal">
        <p>GEO is an additive layer on strong SEO. We make your studio legible to the engines, worth citing, and easy to verify — then track it every month. It pairs naturally with your <a href="/yoga-studio-seo-singapore/">yoga studio SEO</a>, your <a href="/yoga-studio-website-singapore/">studio website</a>, and the community you build on <a href="/yoga-studio-social-media-singapore/">social media</a>.</p>
      </div>
      <div class="service-details-grid deliver-grid">
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-ai.webp');">
          <div class="service-detail-card__content">
            <h3>AI Visibility Audit</h3>
            <p>We run the real questions your students ask ChatGPT, Perplexity, Gemini, and Google AI Mode — hot yoga in Orchard, beginner classes near Bugis — and map who gets cited, so you see exactly where you stand and who to overtake.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-onpage-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Schema &amp; Entity Layer</h3>
            <p>Structured data — LocalBusiness, FAQ, class schedule and instructor info — plus consistent entity signals across the web that make your studio legible and verifiable to the engines.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-content-strategy.webp');">
          <div class="service-detail-card__content">
            <h3>Answer-First Content</h3>
            <p>Class pages and FAQs rewritten to answer the exact questions AI pulls from — clear, extractable, and specific to your formats, from vinyasa and hatha to hot yoga, yin, prenatal, aerial, and power yoga, and to your neighbourhood.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-analytics-reporting.webp');">
          <div class="service-detail-card__content">
            <h3>Citation &amp; Monitoring</h3>
            <p>Building mentions on the sources AI trusts, including an llms.txt for your studio, then tracking your AI visibility month over month against nearby studios — mention rate, citation rate, and share of voice.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHY CHOOSE US ========== -->
  <section class="section" id="why-us" aria-label="Why choose Jraft Creative for yoga studio GEO">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2>We Don't Just Sell GEO — <span class="highlight">We Practise It</span></h2>
      </div>
      <div class="section-content reveal">
        <p>GEO is new, and most agencies are still guessing at it. We run the same playbook on our own studio work and on Jraft Creative itself — and report what actually moves citations.</p>
      </div>
      <div class="service-details-grid" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Cited in AI Ourselves</h3>
            <p>Jraft Creative got its own site cited in Google's AI Overview. We run the same citation playbook for your studio — receipts, not a slide deck of theory.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Built for Local Yoga</h3>
            <p>GEO tuned to neighbourhood, class format, and the way yoga students actually phrase questions to AI — hot yoga in Katong, prenatal near Novena — not a generic B2B approach bolted onto a studio.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>One Agency, All Channels</h3>
            <p>GEO sits alongside your SEO, social, ads, and website — so every signal reinforces the same authority, and the engines see one consistent, trusted studio.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== GEO FLOW ========== -->
  <section class="section" id="geo-flow" style="background: var(--bg-alt);" aria-label="How yoga studio GEO works">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">How It Works</p>
        <h2>From <span class="highlight">Invisible</span> to <span class="highlight">the Answer</span></h2>
      </div>
      <div class="section-content reveal" style="margin-bottom: 24px;">
        <p>We run the same four-step system on every studio — and re-test the AI answers monthly so you can watch your visibility climb.</p>
      </div>
      <ol class="renovation-funnel reveal">
        <li class="funnel-stage">
          <h3>Audit</h3>
          <p>Map what AI says about your studio today</p>
        </li>
        <li class="funnel-stage">
          <h3>Structure</h3>
          <p>Schema and entity signals put in place</p>
        </li>
        <li class="funnel-stage">
          <h3>Answer</h3>
          <p>Content rewritten for AI extraction</p>
        </li>
        <li class="funnel-stage">
          <h3>Monitor</h3>
          <p>Citations and visibility tracked monthly</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ========== FAQ ========== -->
  <section class="section faq-section" id="faq" aria-label="Frequently asked questions about yoga studio GEO in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">FAQ</p>
        <h2><span class="highlight">Yoga Studio GEO</span> — Questions <span class="highlight">Answered</span></h2>
      </div>
      <div class="faq-list">
        <details class="faq-item reveal reveal-d1">
          <summary>Will my yoga studio show up in ChatGPT or Google AI Overviews?</summary>
          <div class="faq-answer"><p>That's the whole point of GEO. When someone asks ChatGPT, Gemini, Perplexity, or Google's AI Overviews for a hot yoga studio near Tanjong Pagar or a prenatal class in Novena, the answer names a handful of studios. We make yours one of them by giving the engines clear, verifiable signals they trust.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>How is GEO different from SEO for a yoga studio?</summary>
          <div class="faq-answer"><p>SEO gets you ranked in Google's blue links. GEO (generative engine optimisation) gets your studio named and cited inside AI answers — ChatGPT, Gemini, Perplexity, and Google AI Overviews. They share foundations, but AI engines weigh structured data, entity clarity, and third-party mentions differently. We do both.</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>How do you measure AI visibility for a yoga studio?</summary>
          <div class="faq-answer"><p>We build a bank of the real questions students ask AI — vinyasa near Bugis, hot yoga in Orchard, aerial classes in Katong — and re-run it each month. We track your AI Visibility Score, how often you're mentioned, how often you're cited with a link, and your share of voice against nearby studios.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>How long until my yoga studio gets cited by AI?</summary>
          <div class="faq-answer"><p>Perplexity and Google AI Overviews pull live data and can move within about 4 to 8 weeks. ChatGPT and Gemini shift more slowly as your entity authority builds across the sources they trust. We re-test monthly so you can watch the movement.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>Do I need SEO too, or just GEO?</summary>
          <div class="faq-answer"><p>Strong technical and content SEO is the foundation GEO builds on, so we usually run them together. If your SEO is weak, we fix that first — clean structured data and clear class pages make the AI-citation work land faster.</p></div>
        </details>
      </div>
    </div>
  </section>


  <!-- Related Services -->
  <section class="section" id="related-services" aria-label="Related services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Explore More</p>
        <h2>More Yoga Studio Services</h2>
      </div>
      <div class="related-services-grid reveal">
          <a href="/yoga-studio-marketing-singapore/" class="related-service-link">Yoga Studio Marketing</a>
          <a href="/yoga-studio-seo-singapore/" class="related-service-link">Yoga Studio SEO</a>
          <a href="/yoga-studio-google-ads-singapore/" class="related-service-link">Yoga Studio Google Ads</a>
          <a href="/yoga-studio-social-media-singapore/" class="related-service-link">Yoga Studio Social Media</a>
          <a href="/yoga-studio-branding-singapore/" class="related-service-link">Yoga Studio Branding</a>
          <a href="/yoga-studio-website-singapore/" class="related-service-link">Yoga Studio Websites</a>
      </div>
    </div>
  </section>
</ServiceLayout>
