---
import ServiceLayout from '../layouts/ServiceLayout.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Beauty Salon Website Design Singapore",
    "description": "Website design for beauty salons in Singapore. Online booking, service menu pages, galleries of nail, lash and brow work, and mobile-first speed built to turn browsing into booked appointments.",
    "provider": {
      "@type": "Organization",
      "name": "Jraft Creative",
      "url": "https://jraftcreative.com/",
      "logo": "https://jraftcreative.com/images/logo.png",
      "telephone": "+6582234578",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "60 Paya Lebar Road, Paya Lebar Square",
        "postalCode": "409051",
        "addressLocality": "Singapore",
        "addressCountry": "SG"
      }
    },
    "areaServed": { "@type": "Country", "name": "Singapore" },
    "serviceType": "Beauty Salon Website Design"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How much does a beauty salon website cost in Singapore?", "acceptedAnswer": { "@type": "Answer", "text": "Pricing depends on your services, your salon's size, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote." } },
      { "@type": "Question", "name": "Which booking platform do you integrate with salon websites?", "acceptedAnswer": { "@type": "Answer", "text": "We integrate with the booking platforms salons in Singapore already use, including Fresha, Booksy, and Timely. If you have a platform, we embed it directly so clients can pick a service, choose a stylist or therapist, and take a time slot without leaving your site. If you're starting fresh, we'll recommend the best fit for your salon." } },
      { "@type": "Question", "name": "Can you build a gallery of my salon's nail, lash, and brow work?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. A gallery is one of the most persuasive parts of a salon website. We build filterable galleries so visitors can browse your nail art, lash sets, brow shaping, and facial work by service — the visual proof that turns a scroll into a booking." } },
      { "@type": "Question", "name": "Will my salon website work well on mobile?", "acceptedAnswer": { "@type": "Answer", "text": "Yes, and it's the priority. Most salon clients browse and book on their phone, so every site we build is designed mobile-first — fast loading, thumb-friendly navigation, and a tap-to-book button that's always within reach." } },
      { "@type": "Question", "name": "How long does it take to build a beauty salon website?", "acceptedAnswer": { "@type": "Answer", "text": "Most beauty salon websites go live within 2–3 weeks. A focused site can be ready in as little as 2 weeks, while larger projects with a full service menu, booking integration, and galleries may take 3–4 weeks. We give you a clear timeline before we start." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "Beauty Salon Website Singapore", "item": "https://jraftcreative.com/beauty-salon-website-singapore/" }
    ]
  }
];
---

<style is:global>
  /* Hide the global background grid pattern on this page only */
  .animated-bg__grid { display: none; }

  /* More-prominent related-service pills — match challenge-card-v2 green treatment */
  #related-services .related-service-link {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.35);
    color: var(--text);
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  #related-services .related-service-link:hover {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.22) 0%, rgba(73, 184, 137, 0.1) 100%), rgba(20, 28, 32, 0.7);
    border-color: rgba(73, 184, 137, 0.6);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(73, 184, 137, 0.3);
  }

  /* Separate the CTA section from related-services with bg-alt */
  .service-cta-section {
    background: var(--bg-alt) !important;
  }

  /* Patient Journey Funnel — 5-stage horizontal flow with green accents */
  .renovation-funnel {
    list-style: none;
    padding: 0;
    margin: 56px 0 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 48px;
    counter-reset: funnel;
  }
  .funnel-stage {
    position: relative;
    text-align: center;
    padding: 28px 20px;
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.28);
    border-radius: 12px;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .funnel-stage:hover {
    transform: translateY(-4px);
    border-color: rgba(73, 184, 137, 0.55);
    box-shadow: 0 16px 40px -16px rgba(73, 184, 137, 0.3);
  }
  .funnel-stage h3 {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--accent);
    margin: 0 0 8px 0;
    letter-spacing: -0.01em;
  }
  .funnel-stage p {
    font-size: 0.82rem;
    color: var(--text);
    line-height: 1.5;
    margin: 0;
  }
  .funnel-stage:not(:last-child)::after {
    content: '→';
    position: absolute;
    right: -34px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--accent);
    font-size: 1.6rem;
    font-weight: 500;
    z-index: 2;
    line-height: 1;
    opacity: 0.7;
  }
  @media (max-width: 900px) {
    .renovation-funnel {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }
    .funnel-stage:nth-child(2n)::after,
    .funnel-stage:last-child::after {
      display: none;
    }
    .funnel-stage:nth-child(2n-1)::after {
      right: -22px;
    }
  }
  @media (max-width: 600px) {
    .renovation-funnel {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .funnel-stage::after {
      display: none;
    }
  }
</style>

<ServiceLayout
  title="Beauty Salon Website — Web Design Agency"
  description="Website design for beauty salons in Singapore. Online booking, service menus, galleries of nail, lash and brow work, and mobile-first speed."
  canonical="https://jraftcreative.com/beauty-salon-website-singapore/"
  ogTitle="Beauty Salon Website — Web Design Agency"
  ogDescription="Website design for beauty salons in Singapore. Online booking, service menus, galleries of nail, lash and brow work, and mobile-first speed."
  ogImage="https://jraftcreative.com/images/og-beauty-salon.jpg"
  keywords="beauty salon website design singapore, beauty salon website singapore, nail salon website singapore, lash salon website, facial salon website, salon booking website, beauty salon web design, Jraft Creative"
  schemaData={schemaData}
  heroLabel="Web Design Agency for Beauty Salons"
  heroTitle='Web Design Agency for <span class="highlight">Beauty Salons in Singapore</span>'
  heroSubtitle="Your website is where a client decides to book with you instead of the salon down the street. We build fast, mobile-first websites for beauty salons — with online booking, a clear service menu, and a gallery of your nail, lash and brow work — designed to turn a scroll into a booked appointment."
  heroImage="/images/hero-beauty-salon.webp"
  heroImageAlt="Beauty salon in Singapore — beauty salon web design"
  heroButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "See Our Work", href: "/about/", class: "btn btn-secondary" }
  ]}
  whatsappText="Hi Jraft Creative, I need a website for my beauty salon in Singapore."
  ctaLabel="Ready to Get Started?"
  ctaTitle="Get Your Beauty Salon Online"
  ctaDescription="Book a free consultation and tell us about your salon. We'll get back to you within 24 hours with a tailored proposal covering design, booking, and your service menu."
  ctaButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%20need%20a%20website%20for%20my%20beauty%20salon%20in%20Singapore.", class: "btn btn-secondary" }
  ]}
  hideDefaultCta={false}
>

  <!-- ========== THE CHALLENGE ========== -->
  <section class="section" id="challenge" aria-label="Why beauty salons need a proper website">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Challenge</p>
        <h2>Clients Look You Up Before They Book — Is Your <span class="highlight">Website Winning Them Over</span>?</h2>
      </div>
      <div class="section-content reveal">
        <p>Booking a facial, a lash set or a full set of nails is a personal choice. A client checks your work, your services and how easy you are to reach before she ever taps "book". A salon site is the centre of your wider <a href="/industries/beauty-aesthetics/">beauty and aesthetics marketing</a>, where every other channel sends her to book.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Instagram Alone Loses Bookings</h3>
            <p>A feed shows your best photos, but it can't list your full service menu, show open time slots, or let a client book at 11pm. When she has to DM and wait, she often books somewhere quicker.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Invisible in Local Search</h3>
            <p>People search "nail salon near Orchard" or "eyelash extensions Bugis" every day. Without a proper website you don't appear, and the booking goes to a salon that does.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>A Slow Site Sends Her Away</h3>
            <p>Salon clients browse on their phone between other things. A page that loads slowly or hides the booking button loses her before she ever sees your work.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHAT WE BUILD ========== -->
  <section class="section" id="sub-services" style="background: var(--bg-alt);" aria-label="Beauty salon website design services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">What We Build</p>
        <h2>Six <span class="highlight">Pillars</span> of a Beauty Salon <span class="highlight">Website</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Every element is built around one thing — turning a client who's browsing into a client who's booked. Pair your site with <a href="/beauty-salon-seo-singapore/">salon SEO</a> to rank for local searches, <a href="/beauty-salon-social-media-singapore/">social media</a> to keep the gallery fresh, and <a href="/beauty-salon-google-ads-singapore/">Google Ads</a> to fill quiet slots.</p>
      </div>
      <div class="service-details-grid deliver-grid">
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-business-website.webp');">
          <div class="service-detail-card__content">
            <h3>Online Booking</h3>
            <p>Clients pick a service, choose a stylist or therapist, and take an open time slot right on the site — no DM, no waiting for a reply, no lost booking.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-landing-page.webp');">
          <div class="service-detail-card__content">
            <h3>Service Menu Pages</h3>
            <p>Clear, browsable pages for every service — facials, manicures and pedicures, lash extensions and lifts, brow shaping, waxing, massage — organised so she finds hers in seconds.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-local-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Gallery of Your Work</h3>
            <p>Filterable galleries of your nail art, lash sets, brow shaping and facial results. It's the visual proof that convinces a first-time client you're the right salon.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-graphic-design.webp');">
          <div class="service-detail-card__content">
            <h3>Instagram Feed Built In</h3>
            <p>Your latest posts pulled onto the site automatically, so the page always looks current — and gives visitors a reason to follow and come back.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-onpage-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Local Search Foundations</h3>
            <p>Clean structure, schema and neighbourhood pages built in, so you show up when someone searches for your service in Katong, Tampines or Holland Village.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-speed-vitals.webp');">
          <div class="service-detail-card__content">
            <h3>Mobile-First Speed</h3>
            <p>Clients book on their phone, often on the go. Every page is built mobile-first and fast, with a tap-to-book button always within thumb's reach.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHY CHOOSE US ========== -->
  <section class="section" id="why-us" aria-label="Why choose Jraft Creative for beauty salon website design">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2>A <span class="highlight">Web Design Agency</span> Built Around the <span class="highlight">Booking</span></h2>
      </div>
      <div class="section-content reveal">
        <p>A site polished enough to show off your work, clear enough to answer every question, and fast enough that she books before she gets distracted.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Designed to Convert</h3>
            <p>We design every page around the booking — the menu, the gallery, and the tap-to-book button all point a browsing client toward a confirmed appointment.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Beauty Industry Experience</h3>
            <p>We know how salon clients choose — the service menu, the gallery, and the reviews that reassure a first-time visitor she's picked the right place.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Website, SEO &amp; Ads Together</h3>
            <p>We also run <a href="/beauty-salon-seo-singapore/">salon SEO</a> and <a href="/beauty-salon-google-ads-singapore/">Google Ads</a> — one agency for your salon's whole online presence.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== CLIENT JOURNEY FUNNEL ========== -->
  <section class="section" id="buyer-funnel" style="background: var(--bg-alt);" aria-label="Where your website fits the client journey">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Client Journey</p>
        <h2>Where Your <span class="highlight">Website</span> Fits the <span class="highlight">Client Journey</span></h2>
      </div>
      <div class="section-content reveal" style="margin-bottom: 24px;">
        <p>A salon client moves through the same five stages before she sits in your chair. Your website carries the middle three — it is where she looks up your services, decides you're the salon for her, and books the slot.</p>
      </div>
      <ol class="renovation-funnel reveal">
        <li class="funnel-stage">
          <h3>Discover</h3>
          <p>A search or Instagram post brings her to the site</p>
        </li>
        <li class="funnel-stage">
          <h3>Browse</h3>
          <p>The service menu shows her exactly what you offer</p>
        </li>
        <li class="funnel-stage">
          <h3>Decide</h3>
          <p>Your gallery and reviews win her over</p>
        </li>
        <li class="funnel-stage">
          <h3>Book</h3>
          <p>She picks a service, a stylist and a slot on the spot</p>
        </li>
        <li class="funnel-stage">
          <h3>Return</h3>
          <p>A great first visit, then rebooking &amp; referral</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ========== FAQ ========== -->
  <section class="section faq-section" id="faq" style="background: var(--bg-alt);" aria-label="Frequently asked questions about beauty salon website design in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">FAQ</p>
        <h2>Beauty Salon <span class="highlight">Website</span> Questions Answered</h2>
      </div>
      <div class="faq-list">
        <details class="faq-item reveal reveal-d1">
          <summary>How much does a beauty salon website cost in Singapore?</summary>
          <div class="faq-answer"><p>Pricing depends on your services, your salon's size, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>Which booking platform do you integrate with salon websites?</summary>
          <div class="faq-answer"><p>We integrate with the booking platforms salons in Singapore already use, including Fresha, Booksy, and Timely. If you have a platform, we embed it directly so clients can pick a service, choose a stylist or therapist, and take a time slot without leaving your site. If you're starting fresh, we'll recommend the best fit for your salon.</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>Can you build a gallery of my salon's nail, lash, and brow work?</summary>
          <div class="faq-answer"><p>Yes. A gallery is one of the most persuasive parts of a salon website. We build filterable galleries so visitors can browse your nail art, lash sets, brow shaping, and facial work by service — the visual proof that turns a scroll into a booking.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>Will my salon website work well on mobile?</summary>
          <div class="faq-answer"><p>Yes, and it's the priority. Most salon clients browse and book on their phone, so every site we build is designed mobile-first — fast loading, thumb-friendly navigation, and a tap-to-book button that's always within reach. We cover the fundamentals in our guide to <a href="/blog/good-business-website-singapore/">what makes a good business website in Singapore</a>.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>How long does it take to build a beauty salon website?</summary>
          <div class="faq-answer"><p>Most beauty salon websites go live within 2–3 weeks. A focused site can be ready in as little as 2 weeks, while larger projects with a full service menu, booking integration, and galleries may take 3–4 weeks. We give you a clear timeline before we start.</p></div>
        </details>
      </div>
    </div>
  </section>

  <!-- Related Services -->
  <section class="section" id="related-services" aria-label="Related services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Explore More</p>
        <h2>More <span class="highlight">Beauty Salon</span> Services</h2>
      </div>
      <div class="related-services-grid reveal">
          <a href="/beauty-salon-marketing-singapore/" class="related-service-link">Beauty Salon Marketing</a>
          <a href="/beauty-salon-seo-singapore/" class="related-service-link">Beauty Salon SEO</a>
          <a href="/beauty-salon-ai-search-optimisation-singapore/" class="related-service-link">Beauty Salon GEO</a>
          <a href="/beauty-salon-google-ads-singapore/" class="related-service-link">Beauty Salon Google Ads</a>
          <a href="/beauty-salon-facebook-ads-singapore/" class="related-service-link">Beauty Salon Facebook Ads</a>
          <a href="/beauty-salon-social-media-singapore/" class="related-service-link">Beauty Salon Social Media</a>
          <a href="/beauty-salon-branding-singapore/" class="related-service-link">Beauty Salon Branding</a>
      </div>
    </div>
  </section>
</ServiceLayout>
