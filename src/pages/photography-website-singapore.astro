---
import ServiceLayout from '../layouts/ServiceLayout.astro';
import MarketingFunnelBlock from '../components/MarketingFunnelBlock.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Photography Website Singapore",
    "description": "Professional website design for photographers and photography studios in Singapore. Portfolio galleries, enquiry and booking, session and package pages, and fast image loading.",
    "provider": {
      "@type": "Organization",
      "name": "Jraft Creative",
      "url": "https://jraftcreative.com/",
      "logo": "https://jraftcreative.com/images/logo.png",
      "telephone": "+6582234578",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "60 Paya Lebar Road, Paya Lebar Square",
        "postalCode": "409051",
        "addressLocality": "Singapore",
        "addressCountry": "SG"
      }
    },
    "areaServed": { "@type": "Country", "name": "Singapore" },
    "serviceType": "Photography Website"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How much does a photography website cost in Singapore?", "acceptedAnswer": { "@type": "Answer", "text": "Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote." } },
      { "@type": "Question", "name": "Can you build a portfolio website that showcases my shoots?", "acceptedAnswer": { "@type": "Answer", "text": "Absolutely. Portfolio presentation is the core of every photography website we build. We create filterable galleries organised by genre — wedding, portrait, newborn, corporate, commercial, events — with full-resolution images, lazy loading, and lightbox viewing so potential clients can see the quality of your work before they enquire." } },
      { "@type": "Question", "name": "Can clients enquire and book sessions through the website?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We build enquiry and booking flows directly into your site. Clients can browse a session type, describe their shoot, pick a preferred date, and submit an enquiry — cutting the back-and-forth of arranging sessions through Instagram DMs or WhatsApp." } },
      { "@type": "Question", "name": "Will my galleries load fast on mobile?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Every site we build is mobile-first with fast image loading — WebP delivery, responsive srcsets, and lazy loading — so your galleries look sharp without slowing the page. Most photography traffic in Singapore comes from phones, so speed is designed in from the start." } },
      { "@type": "Question", "name": "How long does it take to build a photography website?", "acceptedAnswer": { "@type": "Answer", "text": "Most photography websites go live within 2–3 weeks. A focused portfolio site can be ready in 2 weeks, while larger projects with booking systems or client proofing may take 3–4 weeks. We provide a clear timeline before starting." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "Photography Website Singapore", "item": "https://jraftcreative.com/photography-website-singapore/" }
    ]
  }
];
---

<style is:global>
  /* Hide the global background grid pattern on this page only */
  .animated-bg__grid { display: none; }

  /* More-prominent related-service pills — match challenge-card-v2 green treatment */
  #related-services .related-service-link {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.35);
    color: var(--text);
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  #related-services .related-service-link:hover {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.22) 0%, rgba(73, 184, 137, 0.1) 100%), rgba(20, 28, 32, 0.7);
    border-color: rgba(73, 184, 137, 0.6);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(73, 184, 137, 0.3);
  }

  /* Separate the CTA section from related-services with bg-alt */
  .service-cta-section {
    background: var(--bg-alt) !important;
  }

  /* Force 3x2 grid on desktop for the deliver section per locked landing-page pattern */
  #sub-services .deliver-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }
  #sub-services {
    padding-top: 72px;
    padding-bottom: 72px;
  }
  @media (max-width: 900px) {
    #sub-services .deliver-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 600px) {
    #sub-services .deliver-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Renovation Buyer Funnel — 5-stage horizontal flow with green accents */
  .renovation-funnel {
    list-style: none;
    padding: 0;
    margin: 56px 0 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 48px;
    counter-reset: funnel;
  }
  .funnel-stage {
    position: relative;
    text-align: center;
    padding: 28px 20px;
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.28);
    border-radius: 12px;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .funnel-stage:hover {
    transform: translateY(-4px);
    border-color: rgba(73, 184, 137, 0.55);
    box-shadow: 0 16px 40px -16px rgba(73, 184, 137, 0.3);
  }
  .funnel-stage h3 {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--accent);
    margin: 0 0 8px 0;
    letter-spacing: -0.01em;
  }
  .funnel-stage p {
    font-size: 0.82rem;
    color: var(--text);
    line-height: 1.5;
    margin: 0;
  }
  .funnel-stage:not(:last-child)::after {
    content: '→';
    position: absolute;
    right: -34px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--accent);
    font-size: 1.6rem;
    font-weight: 500;
    z-index: 2;
    line-height: 1;
    opacity: 0.7;
  }
  @media (max-width: 900px) {
    .renovation-funnel {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }
    .funnel-stage:nth-child(2n)::after,
    .funnel-stage:last-child::after {
      display: none;
    }
    .funnel-stage:nth-child(2n-1)::after {
      right: -22px;
    }
  }
  @media (max-width: 600px) {
    .renovation-funnel {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .funnel-stage::after {
      display: none;
    }
  }
</style>

<ServiceLayout
  title="Photography Website Singapore — Jraft Creative"
  description="Website design for photographers and photography studios in Singapore. Portfolio galleries, enquiry and booking, session pages, and fast image loading."
  canonical="https://jraftcreative.com/photography-website-singapore/"
  ogTitle="Photography Website Singapore — Jraft Creative"
  ogDescription="Website design for photographers in Singapore. Portfolio galleries, enquiry and booking, fast-loading images."
  ogImage="https://jraftcreative.com/images/og-webdev.jpg"
  keywords="photography website singapore, photographer website design, photography studio website, photography portfolio website singapore, photographer web design singapore, photography booking website, Jraft Creative"
  schemaData={schemaData}
  heroLabel="Photography Websites"
  heroTitle='Website Design for <span class="highlight">Photographers in Singapore</span>'
  heroSubtitle="Your images deserve a website that does them justice. We build fast, visually stunning websites for photographers and studios — with portfolio galleries, enquiry and booking, session and package pages, and image loading tuned for mobile."
  heroImage="/images/service-photography.webp"
  heroImageAlt="Photography studio in Singapore"
  heroButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%20need%20a%20website%20for%20my%20photography%20business%20in%20Singapore.", class: "btn btn-secondary" }
  ]}
  whatsappText="Hi Jraft Creative, I need a website for my photography business in Singapore."
  ctaLabel="Ready to Get Started?"
  ctaTitle='Turn Your Portfolio Into <span class="highlight">Booked Sessions</span>'
  ctaDescription="Book a free consultation and tell us about your photography business. We'll get back to you within 24 hours with a tailored proposal."
  ctaButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%20need%20a%20website%20for%20my%20photography%20business%20in%20Singapore.", class: "btn btn-secondary" }
  ]}
>

  <!-- ========== THE CHALLENGE ========== -->
  <section class="section" id="challenge" aria-label="Why photographers need a proper website">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Challenge</p>
        <h2>Clients Find You on <span class="highlight">Instagram</span> — Then They <span class="highlight">Google You</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Couples planning a wedding, families booking a newborn or portrait session, and brands sourcing a commercial or corporate shoot all discover photographers the same way — a scroll on Instagram, then a Google search of your name. If your work lives only on a social feed, you are competing on someone else's terms. The photographer whose own site loads fast, shows the work beautifully, and makes enquiring effortless is the one who gets the booking. If you want the reasoning behind that, we wrote about <a href="/blog/good-business-website-singapore/" class="inline-link">what makes a good business website in Singapore</a>.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>The Instagram-to-Google Handoff</h3>
            <p>A client finds you on Instagram, then Googles your name to vet you before enquiring. A feed of grid thumbnails and a link in bio does not give them the confidence to book — they lose the thread and message the photographer whose own site closed the loop.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>The Portfolio-as-Feed Trap</h3>
            <p>A social feed mixes every genre into one scroll — a wedding next to a newborn next to a corporate headshot. Clients want to see one body of work at a time: galleries filtered by wedding, portrait, newborn, corporate, commercial, or events, at full resolution, so they can picture their own shoot.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>The Mobile-Last Mistake</h3>
            <p>Clients browse photographers on their phones — on the commute, at lunch, late at night. A site with heavy, slow-loading images, tiny tap targets, and galleries that stutter on mobile loses enquiries the studio never even sees.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHAT WE BUILD ========== -->
  <section class="section" id="sub-services" style="background: var(--bg-alt);" aria-label="Photography website design services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">What We Build</p>
        <h2>Six <span class="highlight">Conversion Features</span> Every Photography Site <span class="highlight">Needs</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Every photography website we deliver is purpose-built for the visual industry — high-performance galleries, enquiry and booking, client proofing, and clear session pages that turn browsers into paying clients. It sits on our <a href="/services/website-development/" class="inline-link">website development</a> foundation, and pairs with our <a href="/industries/creative-events/" class="inline-link">creative and events marketing</a> for photographers who also want to grow their reach.</p>
      </div>
      <div class="service-details-grid deliver-grid">
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-business-website.webp');">
          <div class="service-detail-card__content">
            <h3>Portfolio Galleries</h3>
            <p>Filterable galleries organised by genre — wedding, portrait, newborn, corporate, commercial, events — with full-resolution images, lightbox viewing, and responsive layouts. Clients see one body of work at a time and picture their own shoot.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-landing-page.webp');">
          <div class="service-detail-card__content">
            <h3>Enquiry &amp; Booking</h3>
            <p>Enquiry and booking flows built into the site. Clients pick a session type, describe their shoot, choose a preferred date, and submit — cutting the endless back-and-forth of arranging sessions through Instagram DMs or WhatsApp.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-local-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Client Proofing Portal</h3>
            <p>Password-protected galleries where clients view, favourite, and select their final images. A branded proofing experience that replaces clunky file-sharing links and positions your studio as the professional choice clients expect at premium rates.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-graphic-design.webp');">
          <div class="service-detail-card__content">
            <h3>Session &amp; Package Pages</h3>
            <p>Clear pages that walk clients through each session type and what they get — deliverables, turnaround, and add-ons — so they can self-qualify before they enquire. We can also fold your live Instagram feed into the site to keep it fresh with zero manual updates.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-onpage-seo.webp');">
          <div class="service-detail-card__content">
            <h3>SEO &amp; Location Pages</h3>
            <p>Built on a structure Google can index — clean schema, sitemap, and fast mobile loads — with optional location pages for Orchard, Tanjong Pagar, Bugis, Tampines, Katong, and Holland Village where your studio wants to rank for local searches.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-speed-vitals.webp');">
          <div class="service-detail-card__content">
            <h3>Fast Image Loading &amp; Core Web Vitals</h3>
            <p>Every site is mobile-first with image delivery tuned for speed — WebP, responsive srcsets, and lazy loading — so galleries stay sharp without dragging the page. Clients research on their phones, and a slow gallery loses the enquiry before it lands.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHY CHOOSE US ========== -->
  <section class="section" id="why-us" aria-label="Why choose Jraft Creative for photography website design">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2><span class="highlight">Websites</span> Built for How <span class="highlight">Clients Choose</span> a Photographer</h2>
      </div>
      <div class="section-content reveal">
        <p>We have built websites for photographers, studios, and creative professionals across Singapore. We know what a client looks for when choosing a photographer online, and we design every element of your site to let the images do the talking while making it easy for a visitor to enquire.</p>
      </div>
      <div class="service-details-grid" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Built for Visual Work</h3>
            <p>We optimise every image for web delivery — WebP, responsive srcsets, lazy loading — so your galleries load fast without turning your work into muddy thumbnails. Your photography deserves a site that presents it at its best.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Fast Turnaround — Two Weeks</h3>
            <p>Most photography websites go live within two weeks of kickoff. Peak season waits for no one — we deliver quickly so you can start converting enquiries before your calendar fills up.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Full Digital Package</h3>
            <p>Website, SEO, social media, and paid ads under one roof. We can handle your entire online presence so you can focus on shooting — not coordinating three separate vendors.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== PHOTOGRAPHY BOOKING FUNNEL ========== -->
  <section class="section" id="buyer-funnel" style="background: var(--bg-alt);" aria-label="The photography booking funnel — how Singapore clients choose a photographer">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Booking Funnel</p>
        <h2>How Clients <span class="highlight">Choose</span> and <span class="highlight">Book</span> a Photographer</h2>
      </div>
      <div class="section-content reveal" style="margin-bottom: 24px;">
        <p>From first inspiration to a paid deposit, most photography clients in Singapore move through the same five stages. Your website is the asset that carries the enquiry through every one of them.</p>
      </div>
      <ol class="renovation-funnel reveal">
        <li class="funnel-stage">
          <h3>Inspiration</h3>
          <p>Pinterest, IG Reels, TikTok, word of mouth</p>
        </li>
        <li class="funnel-stage">
          <h3>Shortlist</h3>
          <p>Google, Instagram, directories</p>
        </li>
        <li class="funnel-stage">
          <h3>Enquiry</h3>
          <p>Compare 3–5 photographers</p>
        </li>
        <li class="funnel-stage">
          <h3>Discovery</h3>
          <p>Style, package, and date confirmed</p>
        </li>
        <li class="funnel-stage">
          <h3>Book</h3>
          <p>Deposit paid, session secured</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ========== FAQ ========== -->
  <section class="section faq-section" id="faq" style="background: var(--bg-alt);" aria-label="Frequently asked questions about photography website design in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">FAQ</p>
        <h2><span class="highlight">Photography Website</span> — Questions <span class="highlight">Answered</span></h2>
      </div>
      <div class="faq-list">
        <details class="faq-item reveal reveal-d1">
          <summary>How much does a photography website cost in Singapore?</summary>
          <div class="faq-answer"><p>Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>Can you build a portfolio website that showcases my shoots?</summary>
          <div class="faq-answer"><p>Absolutely. Portfolio presentation is the core of every photography website we build. We create filterable galleries organised by genre — wedding, portrait, newborn, corporate, commercial, events — with full-resolution images, lazy loading, and lightbox viewing so potential clients can see the quality of your work before they enquire.</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>Can clients enquire and book sessions through the website?</summary>
          <div class="faq-answer"><p>Yes. We build enquiry and booking flows directly into your site. Clients can browse a session type, describe their shoot, pick a preferred date, and submit an enquiry — cutting the back-and-forth of arranging sessions through Instagram DMs or WhatsApp.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>Will my galleries load fast on mobile?</summary>
          <div class="faq-answer"><p>Yes. Every site we build is mobile-first with fast image loading — WebP delivery, responsive srcsets, and lazy loading — so your galleries look sharp without slowing the page. Most photography traffic in Singapore comes from phones, so speed is designed in from the start.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>How long does it take to build a photography website?</summary>
          <div class="faq-answer"><p>Most photography websites go live within 2-3 weeks. A focused portfolio site can be ready in 2 weeks, while larger projects with booking systems or client proofing may take 3-4 weeks. We provide a clear timeline before starting.</p></div>
        </details>
      </div>
    </div>
  </section>


  <!-- Related Services -->
  <section class="section" id="related-services" aria-label="Related services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Explore More</p>
        <h2>More <span class="highlight">Photography</span> Services</h2>
      </div>
      <div class="related-services-grid reveal">
          <a href="/industries/creative-events/" class="related-service-link">Creative &amp; Events Marketing</a>
          <a href="/services/website-development/" class="related-service-link">Website Development</a>
          <a href="/services/seo-performance/" class="related-service-link">SEO &amp; Performance</a>
          <a href="/services/social-media/" class="related-service-link">Social Media</a>
      </div>
    </div>
  </section>

  <MarketingFunnelBlock
    industry="photography studio"
    marketingHref="/industries/creative-events/"
    outcomeLine="See how we'd keep your booking calendar full"
    ctaText="Creative & Events Marketing"
  />
</ServiceLayout>
