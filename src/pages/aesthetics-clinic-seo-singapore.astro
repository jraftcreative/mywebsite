---
import ServiceLayout from '../layouts/ServiceLayout.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Aesthetics Clinic SEO Singapore",
    "description": "SEO services for aesthetics clinics in Singapore. Treatment-specific SEO, 'botox Singapore' and 'facial treatment near me' ranking, MOH-compliant content, Google Maps optimisation, and doctor profile optimisation.",
    "provider": {
      "@type": "Organization",
      "name": "Jraft Creative",
      "url": "https://jraftcreative.com/",
      "logo": "https://jraftcreative.com/images/logo.png",
      "telephone": "+6582234578",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "60 Paya Lebar Road, Paya Lebar Square",
        "postalCode": "409051",
        "addressLocality": "Singapore",
        "addressCountry": "SG"
      }
    },
    "areaServed": { "@type": "Country", "name": "Singapore" },
    "serviceType": "Aesthetics Clinic SEO"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How long does it take for aesthetics clinic SEO to show results?", "acceptedAnswer": { "@type": "Answer", "text": "Most aesthetics clinics see measurable ranking improvements within 3 to 4 months. Google Business Profile optimisation and technical fixes produce quick wins in weeks. Treatment-specific keywords like 'botox Orchard Road' or 'HIFU treatment near me' often rank faster than highly competitive terms like 'aesthetics clinic Singapore'." } },
      { "@type": "Question", "name": "Can you write MOH-compliant content for my aesthetics clinic SEO?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. All content we create follows Singapore's MOH Healthcare Services Advertising regulations. We craft treatment descriptions, blog articles, and landing page copy that attracts organic traffic while staying within advertising guidelines — no prohibited claims, no misleading before/after language, no non-compliant pricing tactics." } },
      { "@type": "Question", "name": "What keywords should my aesthetics clinic target?", "acceptedAnswer": { "@type": "Answer", "text": "High-value keywords include 'botox Singapore', 'filler treatment near me', 'HIFU Singapore', 'laser treatment Orchard', 'aesthetics clinic near me', 'facial treatment Singapore', and doctor-specific terms. We research the exact treatment keywords driving consultations in your area and build your SEO strategy around them." } },
      { "@type": "Question", "name": "Do you optimise doctor profile pages for SEO?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Doctor profile pages are valuable SEO assets. Patients search for doctors by name, by specialisation, and by treatment expertise. We optimise each profile with structured data, professional credentials, treatment specialisations, and internal links to relevant treatment pages — improving both search visibility and patient trust." } },
      { "@type": "Question", "name": "How is aesthetics SEO different from generic SEO?", "acceptedAnswer": { "@type": "Answer", "text": "Aesthetics clinics live under MOH's Healthcare Services Advertising rules, so content that would rank fine for a normal business can trigger a takedown for a clinic. Generic agencies either over-promise (violating guidelines) or play it so safe the pages never rank. Aesthetics SEO means treatment-level keyword strategy, doctor-profile optimisation, and clinically accurate content that ranks while staying fully compliant." } },
      { "@type": "Question", "name": "Do you handle Google Maps and local SEO for aesthetics clinics?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Most 'aesthetics clinic near me' and 'botox near me' searches surface the Google Maps 3-pack before any website. We optimise your Google Business Profile with the correct medical aesthetics categories, clinic photos, doctor listings, review management, and local citations so your clinic appears when patients search from Orchard, Novena, the CBD, or your own neighbourhood." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "Aesthetics Clinic SEO Singapore", "item": "https://jraftcreative.com/aesthetics-clinic-seo-singapore/" }
    ]
  }
];
---

<style is:global>
  .animated-bg__grid { display: none; }
  #related-services .related-service-link {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.35); color: var(--text); font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  #related-services .related-service-link:hover {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.22) 0%, rgba(73, 184, 137, 0.1) 100%), rgba(20, 28, 32, 0.7);
    border-color: rgba(73, 184, 137, 0.6); color: var(--accent); transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(73, 184, 137, 0.3);
  }
  .service-cta-section { background: var(--bg-alt) !important; }
  .clinic-funnel { list-style: none; padding: 0; margin: 56px 0 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 48px; }
  .funnel-stage { position: relative; text-align: center; padding: 28px 20px;
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.28); border-radius: 12px;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease; }
  .funnel-stage:hover { transform: translateY(-4px); border-color: rgba(73, 184, 137, 0.55); box-shadow: 0 16px 40px -16px rgba(73, 184, 137, 0.3); }
  .funnel-stage h3 { font-size: 1.05rem; font-weight: 600; color: var(--accent); margin: 0 0 8px 0; letter-spacing: -0.01em; }
  .funnel-stage p { font-size: 0.82rem; color: var(--text); line-height: 1.5; margin: 0; }
  .funnel-stage:not(:last-child)::after { content: '→'; position: absolute; right: -34px; top: 50%; transform: translateY(-50%); color: var(--accent); font-size: 1.6rem; font-weight: 500; z-index: 2; line-height: 1; opacity: 0.7; }
  .funnel-stage--accent { border-color: rgba(73, 184, 137, 0.7); box-shadow: 0 16px 40px -16px rgba(73, 184, 137, 0.35); }
  @media (max-width: 900px) { .clinic-funnel { grid-template-columns: repeat(2, 1fr); gap: 32px; } .funnel-stage:nth-child(2n)::after, .funnel-stage:last-child::after { display: none; } .funnel-stage:nth-child(2n-1)::after { right: -22px; } }
  @media (max-width: 600px) { .clinic-funnel { grid-template-columns: 1fr; gap: 20px; } .funnel-stage::after { display: none; } }
</style>

<ServiceLayout
  title="Aesthetics Clinic SEO Singapore — SEO Agency"
  description="SEO agency for aesthetics clinics in Singapore. Rank for 'botox Singapore', 'HIFU near me', 'filler treatment Orchard'. Treatment-specific SEO, Google Maps, doctor profile optimisation, and MOH-compliant content."
  canonical="https://jraftcreative.com/aesthetics-clinic-seo-singapore/"
  ogTitle="Aesthetics Clinic SEO Singapore — SEO Agency"
  ogDescription="SEO for aesthetics clinics in Singapore. Treatment keyword ranking, Google Maps optimisation, MOH-compliant content, and doctor profile SEO."
  ogImage="https://jraftcreative.com/images/og-webdev.jpg"
  keywords="aesthetics clinic seo singapore, aesthetic clinic seo, seo for aesthetics clinics, botox seo singapore, aesthetics clinic google ranking, medical aesthetics seo, aesthetics clinic marketing, Jraft Creative"
  schemaData={schemaData}
  heroLabel="SEO Agency for Aesthetics Clinics"
  heroTitle='SEO Agency for <span class="highlight">Aesthetics Clinics in Singapore</span>'
  heroSubtitle="Patients searching 'botox Singapore', 'filler treatment near me', and 'HIFU Singapore' are ready to book consultations. If your clinic doesn't rank on page one for these terms, you lose high-value patients to competitors who do. We build treatment-specific SEO and MOH-compliant content that gets aesthetics clinics found on Google."
  heroImage="/images/service-aesthetics.webp"
  heroImageAlt="Aesthetics clinic ranking on Google in Singapore — aesthetics clinic SEO agency"
  heroButtons={[
    { text: "Get a Free SEO Audit", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%20need%20SEO%20for%20my%20aesthetics%20clinic%20in%20Singapore.", class: "btn btn-secondary" }
  ]}
  whatsappText="Hi Jraft Creative, I need SEO for my aesthetics clinic in Singapore."
  ctaLabel="Ready to Rank Higher?"
  ctaTitle='Get Your <span class="highlight">Aesthetics Clinic</span> Found on <span class="highlight">Google</span>'
  ctaDescription="Book a free SEO audit and we'll show you exactly where your clinic stands for treatment-specific keywords compared to competitors in your area. We'll respond within 24 hours with a tailored aesthetics SEO plan."
  ctaButtons={[
    { text: "Get a Free SEO Audit", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%20need%20SEO%20for%20my%20aesthetics%20clinic%20in%20Singapore.", class: "btn btn-secondary" }
  ]}
  hideDefaultCta={false}
>

  <!-- ========== THE CHALLENGE ========== -->
  <section class="section" id="challenge" aria-label="SEO challenges for aesthetics clinics in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Challenge</p>
        <h2>Patients Research Treatments on <span class="highlight">Google</span> — Does Your Clinic <span class="highlight">Appear</span>?</h2>
      </div>
      <div class="section-content reveal">
        <p>Aesthetics treatments are high-value decisions. Before booking a Botox session or a HIFU treatment, patients spend days on Google comparing clinics, reading doctor profiles, and checking reviews. Terms like "botox Singapore", "filler treatment Orchard", and "HIFU near me" are searched thousands of times a month — and if your clinic doesn't rank, patients book with the clinics that do. Singapore's aesthetics market is one of the most competitive in the region, and MOH advertising rules make it one of the hardest to market compliantly.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Ready-to-Book Demand</h3>
            <p>A patient searching "thread lift Singapore price" has already decided they want the procedure — they just need to pick a clinic. SEO puts you in front of them at that moment of decision, not weeks earlier when they were only curious.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Social &amp; Referrals Miss This</h3>
            <p>Instagram, word-of-mouth, and referral networks work — but they miss the largest segment: people actively searching Google for a specific treatment right now. That high-intent demand only shows up if your treatment pages rank.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>A Crowded Orchard &amp; Novena Field</h3>
            <p>Clinics cluster along Orchard Road, in the Novena Medical Hub, and across the CBD, all competing for the same treatment keywords. Ranking here takes a treatment-level strategy, not a generic "aesthetics clinic Singapore" page everyone else also targets.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>MOH Advertising Constraints</h3>
            <p>MOH's Healthcare Services Advertising rules restrict how clinics promote treatments online — no prohibited claims, no misleading before/after language, no non-compliant pricing tactics. Content that violates them gets taken down; content too cautious never ranks.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Generic Agencies Get It Wrong</h3>
            <p>Most SEO agencies don't understand aesthetics compliance. They either produce content that breaches MOH guidelines or write it so conservatively it can't compete. The result is wasted retainer and pages that never reach page one.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Maps 3-Pack Wins the Click</h3>
            <p>For "aesthetics clinic near me" and "botox near me", the Google Maps 3-pack sits above every website. If your Google Business Profile isn't optimised with the right categories, photos, and reviews, you're invisible before the patient scrolls.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHAT WE DELIVER ========== -->
  <section class="section" id="sub-services" style="background: var(--bg-alt);" aria-label="SEO services we deliver for aesthetics clinics">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">What We Deliver</p>
        <h2>Six <span class="highlight">SEO Workstreams</span> Every Aesthetics Clinic <span class="highlight">Needs</span></h2>
      </div>
      <div class="section-content reveal">
        <p>We run aesthetics clinic SEO as a six-workstream system — technical audit, treatment-specific pages, local and Google Maps SEO, MOH-compliant content, doctor profile optimisation, and monthly reporting. Built for how Singapore patients research and choose an aesthetics clinic. Pair it with a professionally designed <a href="/aesthetics-clinic-website-singapore/">aesthetics clinic website</a> for a complete digital strategy.</p>
      </div>
      <div class="service-details-grid deliver-grid">
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-seo-audit.webp');">
          <div class="service-detail-card__content">
            <h3>Technical SEO Audit</h3>
            <p>Full crawl of your clinic website to surface indexing gaps, broken links, missing structured data, slow load times, and mobile issues. We fix every technical barrier stopping Google from ranking you for terms like "botox Singapore" and "aesthetics clinic near me".</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-onpage-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Treatment-Specific SEO</h3>
            <p>Dedicated, keyword-optimised pages for every procedure — Botox, dermal fillers, HIFU, laser, thread lifts, chemical peels, PRP. Each page targets the exact terms patients use: "botox Orchard Road", "filler treatment near me", "HIFU price Singapore".</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-content-strategy.webp');">
          <div class="service-detail-card__content">
            <h3>MOH-Compliant Content</h3>
            <p>Educational articles, treatment guides, and FAQ content written to attract organic traffic while staying fully within MOH advertising rules. Positions your doctors as authorities and captures search demand during the research phase before patients book.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-analytics-reporting.webp');">
          <div class="service-detail-card__content">
            <h3>Local SEO &amp; Google Maps</h3>
            <p>Google Business Profile optimisation with the correct medical aesthetics categories, clinic photos, doctor listings, review management, and local citation building — engineered to get your clinic into the Maps 3-pack for every "near me" search in your area.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-ai.webp');">
          <div class="service-detail-card__content">
            <h3>Doctor Profile Optimisation</h3>
            <p>Patients search for doctors by name, specialisation, and treatment expertise. We optimise each profile with structured data, credentials, treatment specialisations, and internal links to relevant treatment pages — lifting both search visibility and patient trust.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-campaign-analytics.webp');">
          <div class="service-detail-card__content">
            <h3>Monthly Reporting</h3>
            <p>Every month you get treatment keyword rankings, organic traffic, Google Business Profile insights, and consultation trends. We measure what matters — patient acquisition and treatment page visibility — not vanity metrics.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHY CHOOSE US ========== -->
  <section class="section" id="why-us" aria-label="Why choose Jraft Creative for aesthetics clinic SEO">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2>An SEO Agency That Understands <span class="highlight">Aesthetics &amp; Compliance</span></h2>
      </div>
      <div class="section-content reveal">
        <p>We work with healthcare and aesthetics businesses in Singapore — so we understand the regulatory landscape, the patient decision journey, and which treatment keywords actually turn searchers into consultation bookings. Pair SEO with <a href="/services/social-media/">social media</a> for trust-building education or <a href="/services/paid-ads/">Google Ads</a> to capture high-intent searches immediately.</p>
      </div>
      <div class="service-details-grid" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>MOH Advertising Expertise</h3>
            <p>Every treatment page, blog article, and meta description we create is crafted to rank on Google while staying fully within MOH Healthcare Services Advertising boundaries. No compliance risks, no content takedowns.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Treatment-Level Keyword Strategy</h3>
            <p>We go beyond generic "aesthetics clinic" terms to target high-intent searches — "botox for jawline Singapore", "under eye filler near me", "HIFU vs Thermage" — the exact queries patients type when they're ready to book.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Full Digital Presence Under One Roof</h3>
            <p>SEO is one part of patient acquisition. We also handle aesthetics clinic website design, social content, and paid ads — so your entire digital marketing works together to drive consultations and build your clinic's reputation.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== PATIENT FUNNEL ========== -->
  <section class="section" id="patient-funnel" style="background: var(--bg-alt);" aria-label="The Patient Journey — and where SEO shows up">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Patient Journey</p>
        <h2>Where <span class="highlight">SEO</span> Shows Up in the <span class="highlight">Patient Journey</span></h2>
      </div>
      <div class="section-content reveal" style="margin-bottom: 24px;">
        <p>Aesthetics patients move through five stages. SEO is the dominant channel in Research and Compare — when a patient looks up a treatment, weighs clinics, and reads doctor profiles — and it feeds the Maps 3-pack at the Consult decision point. A strong review base then compounds back into rankings.</p>
      </div>
      <ol class="clinic-funnel reveal">
        <li class="funnel-stage funnel-stage--accent">
          <h3>Research</h3>
          <p>Patient Googles a treatment &amp; symptoms (SEO-led)</p>
        </li>
        <li class="funnel-stage funnel-stage--accent">
          <h3>Compare</h3>
          <p>Reads clinic pages, doctor profiles &amp; reviews (SEO-led)</p>
        </li>
        <li class="funnel-stage">
          <h3>Consult</h3>
          <p>Books via Maps 3-pack or treatment page (high intent)</p>
        </li>
        <li class="funnel-stage">
          <h3>Treat</h3>
          <p>Care experience earns the next positive review</p>
        </li>
        <li class="funnel-stage">
          <h3>Advocate</h3>
          <p>Reviews &amp; referrals compound back into rankings</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ========== FAQ ========== -->
  <section class="section faq-section" id="faq" aria-label="Frequently asked questions about aesthetics clinic SEO in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">FAQ</p>
        <h2><span class="highlight">Aesthetics Clinic SEO</span> — Questions <span class="highlight">Answered</span></h2>
      </div>
      <div class="faq-list">
        <details class="faq-item reveal reveal-d1">
          <summary>How long does it take for aesthetics clinic SEO to show results?</summary>
          <div class="faq-answer"><p>Most aesthetics clinics see measurable ranking improvements within 3 to 4 months. Google Business Profile optimisation and technical fixes produce quick wins in weeks. Treatment-specific keywords like "botox Orchard Road" or "HIFU treatment near me" often rank faster than highly competitive terms like "aesthetics clinic Singapore".</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>Can you write MOH-compliant content for my aesthetics clinic SEO?</summary>
          <div class="faq-answer"><p>Yes. All content we create follows Singapore's MOH Healthcare Services Advertising regulations. We craft treatment descriptions, blog articles, and landing page copy that attracts organic traffic while staying within advertising guidelines — no prohibited claims, no misleading before/after language, no non-compliant pricing tactics.</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>What keywords should my aesthetics clinic target?</summary>
          <div class="faq-answer"><p>High-value keywords include "botox Singapore", "filler treatment near me", "HIFU Singapore", "laser treatment Orchard", "aesthetics clinic near me", "facial treatment Singapore", and doctor-specific terms. We research the exact treatment keywords driving consultations in your area and build your SEO strategy around them.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>Do you optimise doctor profile pages for SEO?</summary>
          <div class="faq-answer"><p>Yes. Doctor profile pages are valuable SEO assets. Patients search for doctors by name, by specialisation, and by treatment expertise. We optimise each profile with structured data, professional credentials, treatment specialisations, and internal links to relevant treatment pages — improving both search visibility and patient trust.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>How is aesthetics SEO different from generic SEO?</summary>
          <div class="faq-answer"><p>Aesthetics clinics live under MOH's Healthcare Services Advertising rules, so content that would rank fine for a normal business can trigger a takedown for a clinic. Generic agencies either over-promise (violating guidelines) or play it so safe the pages never rank. Aesthetics SEO means treatment-level keyword strategy, doctor-profile optimisation, and clinically accurate content that ranks while staying fully compliant.</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>Do you handle Google Maps and local SEO for aesthetics clinics?</summary>
          <div class="faq-answer"><p>Yes. Most "aesthetics clinic near me" and "botox near me" searches surface the Google Maps 3-pack before any website. We optimise your Google Business Profile with the correct medical aesthetics categories, clinic photos, doctor listings, review management, and local citations so your clinic appears when patients search from Orchard, Novena, the CBD, or your own neighbourhood.</p></div>
        </details>
      </div>
    </div>
  </section>

  <!-- ========== RELATED SERVICES ========== -->
  <section class="section" id="related-services" aria-label="Related services for aesthetics clinics">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Explore More</p>
        <h2>More <span class="highlight">Aesthetics Clinic</span> Services</h2>
      </div>
      <div class="related-services-grid reveal">
        <a href="/aesthetics-clinic-website-singapore/" class="related-service-link">Aesthetics Clinic Website Design</a>
        <a href="/aesthetics-clinic-marketing-singapore/" class="related-service-link">Aesthetics Clinic Marketing</a>
        <a href="/aesthetics-clinic-social-media-singapore/" class="related-service-link">Aesthetics Clinic Social Media</a>
        <a href="/aesthetics-clinic-google-ads-singapore/" class="related-service-link">Aesthetics Clinic Google Ads</a>
        <a href="/aesthetics-clinic-branding-singapore/" class="related-service-link">Aesthetics Clinic Branding</a>
      </div>
    </div>
  </section>
</ServiceLayout>
