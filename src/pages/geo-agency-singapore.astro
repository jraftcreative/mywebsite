---
import ServiceLayout from '../layouts/ServiceLayout.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "GEO Agency Singapore",
    "description": "Specialist GEO agency in Singapore — Generative Engine Optimisation to get your brand recommended by ChatGPT, Google Gemini, Perplexity, and AI Overviews.",
    "provider": {
      "@type": "Organization",
      "name": "Jraft Creative",
      "url": "https://jraftcreative.com/",
      "logo": "https://jraftcreative.com/images/logo.png",
      "telephone": "+6582234578",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "60 Paya Lebar Road, Paya Lebar Square",
        "postalCode": "409051",
        "addressLocality": "Singapore",
        "addressCountry": "SG"
      }
    },
    "areaServed": { "@type": "Country", "name": "Singapore" },
    "serviceType": "Generative Engine Optimisation (GEO)"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "What is GEO and how is it different from SEO?", "acceptedAnswer": { "@type": "Answer", "text": "GEO is Generative Engine Optimisation — getting your brand cited and recommended inside generative AI answers (ChatGPT, Gemini, Perplexity, Claude, Google AI Overviews). SEO targets the 10 blue links on a Google search page. GEO targets the AI-generated answer that increasingly appears above those links. Same business goal, different surfaces. Most GEO work overlaps with modern SEO (schema, content structure, authority) but the optimisation targets and measurement are different." } },
      { "@type": "Question", "name": "What does a GEO engagement with Jraft Creative include?", "acceptedAnswer": { "@type": "Answer", "text": "Every engagement starts with a free discovery call where we map your category, your current AI citation baseline, and the prompts your buyers actually use. From there we scope a programme across the six GEO moves we cover — AI visibility audit, schema and entity layer, answer-first content rewrite, citation and authority building, prompt and share-of-voice monitoring, and (for enterprise) sentiment defence. We also offer the AI Visibility Audit as a standalone SKU if you'd like to start with the baseline before scoping a retainer." } },
      { "@type": "Question", "name": "Which AI platforms does a GEO agency optimise for?", "acceptedAnswer": { "@type": "Answer", "text": "The five with meaningful SG traffic: ChatGPT (largest by user count), Google AI Overviews and Gemini, Perplexity (highest commercial intent), Claude (rising fast in B2B), and Microsoft Copilot. The technical layer — schema, llms.txt, content structure — applies across all five. Where they diverge is authority signals: Perplexity weighs citations heavily, ChatGPT favours Wikipedia, Gemini blends in Google Search ranking." } },
      { "@type": "Question", "name": "How long does GEO take to show results in Singapore?", "acceptedAnswer": { "@type": "Answer", "text": "Technical setup (schema, llms.txt, content restructure) ships in 2-4 weeks. First branded AI citations typically appear within 8-12 weeks. Category citations (e.g. ranking when someone asks \"best clinic in Singapore\" without your brand name) take 4-6 months and require ongoing authority work. SG-specific citation density takes slightly longer than global benchmarks because AI models lean US/UK." } },
      { "@type": "Question", "name": "Do I still need traditional SEO if I'm doing GEO?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Google still drives 60-70% of high-intent commercial search traffic in Singapore. GEO is additive, not a replacement. The work overlaps significantly though — schema, content structure, and authority signals serve both. If your Google rankings are weak we usually recommend a combined SEO + GEO engagement rather than GEO standalone." } },
      { "@type": "Question", "name": "Can you guarantee AI Overviews citations?", "acceptedAnswer": { "@type": "Answer", "text": "No. AI Overviews trigger probabilistically based on query type, user signal, and content authority. We can engineer the conditions that make citation likely — structured data, clear definitions, ranking inside Google's top 10 (the AI Overview pool draws primarily from top results). We report monthly on which of your tracked queries trigger AI Overviews and whether your brand appears. Most clients see first AI Overview citations within 6-10 weeks." } },
      { "@type": "Question", "name": "How do I get my business cited in ChatGPT or Google's AI Overview?", "acceptedAnswer": { "@type": "Answer", "text": "Start by finding out where you stand — an AI visibility audit maps the prompts your buyers use and which brands the AI names today. From there it is a mix of structured data and entity signals so AI can read you clearly, answer-first content that matches how people actually ask, third-party citations and reviews the models trust, and strong Google rankings (AI Overviews pull heavily from the top 10). We know it works because we did it for our own site — Jraft Creative is cited in Google's AI Overview — and we run the same playbook for clients." } },
      { "@type": "Question", "name": "How much does a GEO (AI search) agency cost in Singapore?", "acceptedAnswer": { "@type": "Answer", "text": "Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote." } },
      { "@type": "Question", "name": "How do I choose a GEO agency in Singapore?", "acceptedAnswer": { "@type": "Answer", "text": "GEO is new, so ask the questions that separate real practitioners from rebadged SEO. Can they show a business they have actually got cited in AI answers — ideally their own? Do they measure the right thing: your share of AI citations against competitors, not just Google rankings? Do they cover all the engines your buyers use — ChatGPT, Gemini, Perplexity and AI Overviews — not just Google? Jraft Creative got its own site cited in Google's AI Overview and reports citation share monthly." } },
      { "@type": "Question", "name": "What's the difference between GEO, AEO, and AI SEO?", "acceptedAnswer": { "@type": "Answer", "text": "They overlap and the labels are used loosely. GEO (Generative Engine Optimisation) is the broad practice of getting cited inside AI-generated answers across ChatGPT, Gemini, Perplexity and AI Overviews. AEO (Answer Engine Optimisation) is the narrower craft of structuring content to be the extracted answer — featured snippets, voice results, question-led blocks. AI SEO usually means classic SEO adapted for AI features. In practice they're one job: making your business the thing an AI confidently recommends. We deliver all three under one programme." } },
      { "@type": "Question", "name": "How do I check if ChatGPT already recommends my business?", "acceptedAnswer": { "@type": "Answer", "text": "Ask it directly. Open ChatGPT (and Gemini, and Perplexity) and type the questions your buyers actually ask — \"best clinic in Toa Payoh\", \"reliable aircon servicing near me\" — and see whether your brand is named, and which competitors are named instead. That's your baseline. Our AI Visibility Audit does this systematically across 20–30 prompts and five engines, maps who gets cited, and shows the gaps to close." } },
      { "@type": "Question", "name": "Does GEO work for small businesses in Singapore?", "acceptedAnswer": { "@type": "Answer", "text": "Yes — often better than for big brands. AI answers reward clear entities, structured data and consistent authority, not marketing budget. Under 30% of SG SME sites have correct schema, so the technical bar to get cited is the lowest it will ever be. A focused local business can become the named answer for its category and neighbourhood well before larger, slower competitors catch up." } },
      { "@type": "Question", "name": "Is SEO dead now that AI answers questions directly?", "acceptedAnswer": { "@type": "Answer", "text": "No. Google still drives the majority of high-intent commercial search in Singapore, and AI Overviews draw most of their citations from the top Google results — so strong SEO is a prerequisite for GEO, not a casualty of it. What's changed is that ranking page-one is no longer enough on its own; you also need to be the brand the AI names. The right move is both, run together." } },
      { "@type": "Question", "name": "How is GEO different from ranking in Google's AI Overview?", "acceptedAnswer": { "@type": "Answer", "text": "Google's AI Overview is one surface; GEO covers all of them. Appearing in an AI Overview means Google's AI cites you at the top of its results page. GEO also targets ChatGPT, Gemini, Perplexity, Claude and Copilot — where a growing share of Singapore buyers now ask their questions and never touch a Google results page at all. We optimise for AI Overviews and the standalone assistants together." } },
      { "@type": "Question", "name": "GEO or SEO — which should my business invest in first?", "acceptedAnswer": { "@type": "Answer", "text": "It depends on where you stand. If your Google rankings are weak, we usually start with combined SEO + GEO, because AI Overviews pull from the top results and much of the technical work serves both. If you already rank well but aren't being named by AI, GEO on its own can move fast. The free discovery call and AI Visibility Audit tell us which — we scope from evidence, not a default package." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "GEO Agency Singapore", "item": "https://jraftcreative.com/geo-agency-singapore/" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "ImageObject",
    "url": "https://jraftcreative.com/images/service-seo.webp",
    "caption": "GEO agency Singapore — getting brands recommended inside ChatGPT, Gemini, Perplexity and Google AI Overviews.",
    "description": "Hero image for Jraft Creative's GEO (Generative Engine Optimisation) agency landing page in Singapore. Visual identity supporting the AI search optimisation service that bridges Google SEO and generative AI citation work across ChatGPT, Gemini, Perplexity, Claude and Google AI Overviews."
  }
];
---

<style is:global>
  /* Hide the global background grid pattern on this page only */
  .animated-bg__grid { display: none; }

  /* More-prominent related-service pills — match challenge-card-v2 green treatment */
  #related-services .related-service-link {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.35);
    color: var(--text);
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  #related-services .related-service-link:hover {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.22) 0%, rgba(73, 184, 137, 0.1) 100%), rgba(20, 28, 32, 0.7);
    border-color: rgba(73, 184, 137, 0.6);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(73, 184, 137, 0.3);
  }

  /* Separate the CTA section from related-services with bg-alt */
  .service-cta-section {
    background: var(--bg-alt) !important;
  }

  /* Force 3x2 grid on desktop for the deliver section per locked landing-page pattern */
  #sub-services .deliver-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }
  #sub-services {
    padding-top: 72px;
    padding-bottom: 72px;
  }
  @media (max-width: 900px) {
    #sub-services .deliver-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 600px) {
    #sub-services .deliver-grid {
      grid-template-columns: 1fr;
    }
  }

  /* AI Search Buyer Funnel — 5-stage horizontal flow with green accents */
  .renovation-funnel {
    list-style: none;
    padding: 0;
    margin: 56px 0 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 48px;
    counter-reset: funnel;
  }
  .funnel-stage {
    position: relative;
    text-align: center;
    padding: 28px 20px;
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.28);
    border-radius: 12px;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .funnel-stage:hover {
    transform: translateY(-4px);
    border-color: rgba(73, 184, 137, 0.55);
    box-shadow: 0 16px 40px -16px rgba(73, 184, 137, 0.3);
  }
  .funnel-stage h3 {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--accent);
    margin: 0 0 8px 0;
    letter-spacing: -0.01em;
  }
  .funnel-stage p {
    font-size: 0.82rem;
    color: var(--text);
    line-height: 1.5;
    margin: 0;
  }
  .funnel-stage:not(:last-child)::after {
    content: '→';
    position: absolute;
    right: -34px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--accent);
    font-size: 1.6rem;
    font-weight: 500;
    z-index: 2;
    line-height: 1;
    opacity: 0.7;
  }
  @media (max-width: 900px) {
    .renovation-funnel {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }
    .funnel-stage:nth-child(2n)::after,
    .funnel-stage:last-child::after {
      display: none;
    }
    .funnel-stage:nth-child(2n-1)::after {
      right: -22px;
    }
  }
  @media (max-width: 600px) {
    .renovation-funnel {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .funnel-stage::after {
      display: none;
    }
  }
</style>

<ServiceLayout
  title="GEO Agency Singapore — Rank in ChatGPT & Gemini"
  description="Specialist GEO agency in Singapore. We get your brand recommended by ChatGPT, Gemini, Perplexity, and AI Overviews."
  canonical="https://jraftcreative.com/geo-agency-singapore/"
  ogTitle="GEO Agency Singapore — Rank in ChatGPT & Gemini"
  ogDescription="Specialist GEO agency in Singapore. Get your brand recommended by ChatGPT, Gemini, Perplexity, and Google AI Overviews."
  ogImage="https://jraftcreative.com/images/og-seo.jpg"
  keywords="geo agency singapore, generative engine optimisation agency, GEO services singapore, AI search agency, AI optimisation agency singapore, Jraft Creative"
  schemaData={schemaData}
  heroLabel="GEO Agency · Singapore"
  heroTitle='Get Your Brand <span class="highlight">Named</span> Inside <span class="highlight">ChatGPT, Gemini &amp; AI Mode</span>'
  heroSubtitle="Google I/O 2026 confirmed AI Overviews now reach 2.5 billion monthly users and AI Mode 1 billion — search is changing fast. The SG buyer who used to type your category into Google now asks an AI that names three brands, and most of the time, none of them rank page-one. GEO is what gets your business into that three-brand answer — we got our own site cited in Google's AI Overview, and we run the same playbook for clients."
  heroImage="/images/service-seo.webp"
  heroImageAlt="GEO agency Singapore — getting brands cited inside ChatGPT, Gemini, Perplexity, Claude, and Google AI Overviews"
  heroButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%27d%20like%20to%20learn%20about%20your%20GEO%20services%20in%20Singapore.", class: "btn btn-secondary" }
  ]}
  whatsappText="Hi Jraft Creative, I'd like to learn about your GEO services in Singapore."
  ctaLabel="Ready to Get Started?"
  ctaTitle='Be the <span class="highlight">Answer</span> When SG Buyers <span class="highlight">Ask an AI</span>'
  ctaDescription="Tell us your category and we'll come back within 24 hours with a tailored GEO plan to get you cited inside ChatGPT, Gemini, Perplexity and Google AI Mode."
  ctaButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%27d%20like%20to%20learn%20about%20your%20GEO%20services%20in%20Singapore.", class: "btn btn-secondary" }
  ]}
>

  <!-- ========== BEST GEO AGENCY (direct answer) ========== -->
  <section class="section" id="best-geo-agency" aria-label="Who is the best GEO agency in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Straight Answer</p>
        <h2>Who's the Best <span class="highlight">GEO Agency in Singapore</span>?</h2>
      </div>
      <div class="section-content reveal">
        <p>The honest answer: the best GEO agency is the one that can show you a business it has actually got cited inside AI answers — ideally its own. Most "GEO agencies" in Singapore bolted the term onto an SEO menu in 2024 and have never been named in a single AI Overview.</p>
        <p>Jraft Creative is a specialist Generative Engine Optimisation agency built around one job: getting your brand named when a Singapore buyer asks ChatGPT, Gemini, Perplexity or Google's AI Overview for a recommendation. We got our own site cited in Google's AI Overview across five SG verticals — and we run the same playbook for clients, measured on your share of AI citations, not retainer hours.</p>
      </div>
    </div>
  </section>

  <!-- ========== WHAT IS GEO + SEO vs GEO TABLE ========== -->
  <section class="section" id="what-is-geo" style="background: var(--bg-alt);" aria-label="What is Generative Engine Optimisation">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Basics</p>
        <h2>What Is <span class="highlight">Generative Engine Optimisation</span> (GEO)?</h2>
      </div>
      <div class="section-content reveal">
        <p>Generative Engine Optimisation (GEO) is the practice of getting your brand cited and recommended inside AI-generated answers — ChatGPT, Google Gemini and AI Overviews, Perplexity, Claude, and Microsoft Copilot. Where SEO competes for one of the ten blue links on a Google results page, GEO competes to be one of the three or four brands the AI names before the buyer scrolls at all. Same goal — getting found by a ready buyer — on a different surface.</p>
        <p>The two overlap (schema, content structure and authority feed both), but they're optimised and measured differently. Here's the plain difference:</p>
      </div>
      <div class="comparison-table-wrap reveal">
        <table class="comparison-table">
          <thead>
            <tr><th>&nbsp;</th><th>Traditional SEO</th><th>GEO (AI Search)</th></tr>
          </thead>
          <tbody>
            <tr><td>Goal</td><td>Rank in the 10 blue links</td><td>Be named in the AI's answer</td></tr>
            <tr><td>Surface</td><td>Google results page</td><td>ChatGPT, Gemini, Perplexity, AI Overviews</td></tr>
            <tr><td>Wins by</td><td>Keywords, backlinks, rankings</td><td>Entities, citations, answer-shaped content</td></tr>
            <tr><td>Content shape</td><td>Long, keyword-optimised pages</td><td>Definitional, extractable, question-led</td></tr>
            <tr><td>Measured by</td><td>Rankings and organic clicks</td><td>Citation share against competitors</td></tr>
            <tr><td>Still matters?</td><td>Yes — 60–70% of commercial search</td><td>Yes — and growing fastest</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ========== THE CHALLENGE ========== -->
  <section class="section" id="challenge" aria-label="Why SG businesses need GEO">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Challenge</p>
        <h2>The SG Search Market Has <span class="highlight">Split in Two</span> — and Most Agencies Still Only Work <span class="highlight">One Half</span></h2>
      </div>
      <div class="section-content reveal">
        <p>SG buyers research twice in 2026 — once on Google, once on an AI. Across the audits we run, fewer than 20% of brands cited inside AI answers are the same brands ranking page one on Google. Two surfaces, two games.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Google I/O 2026 Changed the Default</h3>
            <p>I/O 2026 made AI Overviews the default for 2.5 billion users. AI answers name three or four brands and stop — if you are not in that podium, you are not in the consideration set, no matter how well you rank on Google.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>The Sub-20% Overlap</h3>
            <p>Across SG audits we run, fewer than 20% of brands cited inside AI answers also rank page-one on Google for the same query. Different signals, different content shape, different game.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>The SG Schema Gap</h3>
            <p>Under 30% of SG SME sites have correct FAQPage, Organization or Service schema. The technical bar to outrank competitors inside AI answers is the lowest it will ever be. Compound now or catch up later.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== HOW AI DECIDES WHAT TO CITE ========== -->
  <section class="section" id="how-ai-cites" style="background: var(--bg-alt);" aria-label="How AI decides which brands to cite">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">How It Works</p>
        <h2>How AI <span class="highlight">Decides</span> Which Brands to <span class="highlight">Cite</span></h2>
      </div>
      <div class="section-content reveal">
        <p>AI models don't rank pages the way Google does. They retrieve and cite the sources they can read clearly, verify against other sources, and have seen consistently. Four signals decide whether that source is you.</p>
      </div>
      <div class="service-details-grid" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Entity Clarity</h3>
            <p>The model has to know what you are before it recommends you. A consistent name, category and description across your site, Google Business Profile and third-party listings tells the AI you're a real, specific business — not a vague mention it can't place.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Answer-Shaped Content</h3>
            <p>LLMs lift the sentence that answers the question cleanly — a definition, a specific number, a clear comparison. Content written as extractable answers gets cited. Walls of marketing copy get skipped.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Structured Data</h3>
            <p>Schema markup — Organization, Service, FAQPage — is how a machine reads your page without guessing. Pages with correct structured data earn markedly more AI citations than pages that leave the model to interpret raw HTML.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>External Authority</h3>
            <p>Models trust what other trusted sources say about you — reviews, directories, press, Wikipedia. Third-party validation is the single strongest predictor of whether an AI names you when a buyer asks for a recommendation.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHAT WE DELIVER ========== -->
  <section class="section" id="sub-services" aria-label="What Jraft Creative delivers as a GEO agency">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">What We Deliver</p>
        <h2>Six <span class="highlight">GEO Moves</span> That Move <span class="highlight">Citation Rate</span></h2>
      </div>
      <div class="section-content reveal">
        <p>We build GEO programmes specifically for SG businesses — audit, technical foundation, content rewrite, authority building, monitoring, and the productised AVA SKU that lets you start before a retainer.</p>
      </div>
      <div class="service-details-grid deliver-grid">
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-seo-audit.webp');">
          <div class="service-detail-card__content">
            <h3><a href="/ai-visibility-audit-singapore/">AI Visibility Audit (AVA)</a></h3>
            <p>20–30 prompts across ChatGPT, Gemini, Perplexity, Claude, AI Overviews. 8–12 page report, citation map, schema audit, two competitor benchmarks, top 5 gaps. <a href="/ai-visibility-audit-singapore/">Audit available as a standalone SKU →</a></p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-onpage-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Schema &amp; Entity Layer</h3>
            <p>Organization, Service, FAQPage, Speakable, Person, BreadcrumbList across every commercial page. llms.txt deployed. Internal linking restructured so AI crawlers map your service tree in one pass.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-copywriting.webp');">
          <div class="service-detail-card__content">
            <h3>Answer-First Content Rewrite</h3>
            <p>LLMs cite definitional opening, specific number, comparison or condition. We rewrite your top commercial pages in that shape without losing the depth Google still rewards. Same content, both surfaces.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-local-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Citation &amp; Authority Building</h3>
            <p>Earned media and directory work across the sources LLMs trust — Wikipedia, .gov.sg, Business Times, CNA, The Edge, industry directories. The slow compounding lever, started early.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-ai.webp');">
          <div class="service-detail-card__content">
            <h3>Prompt &amp; Share-of-Voice Monitoring</h3>
            <p>4 to 50+ tracked prompts across ChatGPT, Gemini, Perplexity, Claude, AI Overviews. Monthly citation reporting with competitor share-of-voice. You see what moved against baseline, not just what shipped.</p>
          </div>
        </div>
