---
import ServiceLayout from '../layouts/ServiceLayout.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Tuition Centre Website Design Singapore",
    "description": "Custom website design for tuition and enrichment centres in Singapore — programme pages by level and subject, tutor profiles, timetables, and trial-class enquiry forms.",
    "provider": {
      "@type": "Organization",
      "name": "Jraft Creative",
      "url": "https://jraftcreative.com/",
      "logo": "https://jraftcreative.com/images/logo.png",
      "telephone": "+6582234578",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "60 Paya Lebar Road, Paya Lebar Square",
        "postalCode": "409051",
        "addressLocality": "Singapore",
        "addressCountry": "SG"
      }
    },
    "areaServed": { "@type": "Country", "name": "Singapore" },
    "serviceType": "Tuition Centre Website Design"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How much does a tuition centre website cost in Singapore?", "acceptedAnswer": { "@type": "Answer", "text": "Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote." } },
      { "@type": "Question", "name": "Can you add a trial-class enquiry form to our tuition centre website?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We build trial-class and registration enquiry forms straight into your site so parents can request a slot without calling. Forms capture the child's level, preferred subject, and preferred timing, then land in your inbox with an automatic confirmation to the parent — cutting phone tag and manual admin for your front desk." } },
      { "@type": "Question", "name": "Can you build programme pages by level and subject?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Each programme gets its own page organised by level and subject — PSLE, O-Level and A-Level streams across English, Math, Science and Chinese. Every page sets out the format, class size and who the programme suits, so a parent can judge fit before they enquire." } },
      { "@type": "Question", "name": "How do you handle testimonials and student results?", "acceptedAnswer": { "@type": "Answer", "text": "We present genuine parent testimonials and student achievements as records of past work, never as promised outcomes. As an MOE-registered private education space, results are shown honestly and in context, so parents get an accurate picture of your centre without any guaranteed-grade claims." } },
      { "@type": "Question", "name": "How do you help a tuition centre website rank on Google?", "acceptedAnswer": { "@type": "Answer", "text": "We optimise your site for what parents actually search — like 'tuition near me', 'math tuition Tampines', or 'PSLE English tuition Singapore'. That covers on-page SEO, schema markup for educational organisations, Google Business Profile optimisation, and location-targeted content so each branch can surface in local search and Google Maps." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "Tuition Centre Website Singapore", "item": "https://jraftcreative.com/tuition-centre-website-singapore/" }
    ]
  }
];
---

<style is:global>
  /* Hide the global background grid pattern on this page only */
  .animated-bg__grid { display: none; }

  /* More-prominent related-service pills — match challenge-card-v2 green treatment */
  #related-services .related-service-link {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.35);
    color: var(--text);
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  #related-services .related-service-link:hover {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.22) 0%, rgba(73, 184, 137, 0.1) 100%), rgba(20, 28, 32, 0.7);
    border-color: rgba(73, 184, 137, 0.6);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(73, 184, 137, 0.3);
  }

  /* Separate the CTA section from related-services with bg-alt */
  .service-cta-section {
    background: var(--bg-alt) !important;
  }

  /* Trial-to-Enrolment Funnel — 5-stage horizontal flow with green accents */
  .renovation-funnel {
    list-style: none;
    padding: 0;
    margin: 56px 0 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 48px;
    counter-reset: funnel;
  }
  .funnel-stage {
    position: relative;
    text-align: center;
    padding: 28px 20px;
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.28);
    border-radius: 12px;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .funnel-stage:hover {
    transform: translateY(-4px);
    border-color: rgba(73, 184, 137, 0.55);
    box-shadow: 0 16px 40px -16px rgba(73, 184, 137, 0.3);
  }
  .funnel-stage h3 {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--accent);
    margin: 0 0 8px 0;
    letter-spacing: -0.01em;
  }
  .funnel-stage p {
    font-size: 0.82rem;
    color: var(--text);
    line-height: 1.5;
    margin: 0;
  }
  .funnel-stage:not(:last-child)::after {
    content: '→';
    position: absolute;
    right: -34px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--accent);
    font-size: 1.6rem;
    font-weight: 500;
    z-index: 2;
    line-height: 1;
    opacity: 0.7;
  }
  @media (max-width: 900px) {
    .renovation-funnel {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }
    .funnel-stage:nth-child(2n)::after,
    .funnel-stage:last-child::after {
      display: none;
    }
    .funnel-stage:nth-child(2n-1)::after {
      right: -22px;
    }
  }
  @media (max-width: 600px) {
    .renovation-funnel {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .funnel-stage::after {
      display: none;
    }
  }
</style>

<ServiceLayout
  title="Tuition Centre Website Singapore — Web Design Agency"
  description="Websites for tuition centres in Singapore — programme pages by level and subject, tutor profiles, timetables, and trial-class enquiry forms."
  canonical="https://jraftcreative.com/tuition-centre-website-singapore/"
  ogTitle="Tuition Centre Website Singapore — Web Design Agency"
  ogDescription="Custom website design for tuition and enrichment centres in Singapore. Programme pages by level and subject, tutor profiles, timetables, and trial-class enquiry forms."
  ogImage="https://jraftcreative.com/images/og-tuition.jpg"
  keywords="web design agency for tuition centres, tuition centre website design singapore, tuition centre website singapore, enrichment centre website singapore, tuition website design, education website singapore, Jraft Creative"
  schemaData={schemaData}
  heroLabel="Web Design Agency for Tuition Centres"
  heroTitle='Web Design Agency for <span class="highlight">Tuition Centres in Singapore</span>'
  heroSubtitle="Parents are comparing tuition centres online before they ever call. We build websites that lay out your programmes by level and subject, introduce your tutors, and turn a visit into a booked trial or an enrolment enquiry — so you can focus on teaching, not chasing leads."
  heroImage="/images/service-tuition.webp"
  heroImageAlt="Primary school students in a Singapore tuition class — tuition centre web design"
  heroButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "See Tuition Centre SEO", href: "/tuition-centre-seo-singapore/", class: "btn btn-secondary" }
  ]}
  whatsappText="Hi Jraft Creative, I need a website for my tuition centre in Singapore."
  ctaLabel="Ready to Fill Your Next Intake?"
  ctaTitle="Get Your Tuition Centre Online"
  ctaDescription="Tell us about your tuition centre and we'll recommend the right website scope. Free consultation — no obligations, no pressure."
  ctaButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%20need%20a%20website%20for%20my%20tuition%20centre%20in%20Singapore.", class: "btn btn-secondary" }
  ]}
  hideDefaultCta={false}
>

  <!-- ========== THE CHALLENGE ========== -->
  <section class="section" id="challenge" aria-label="Website challenges for tuition centres in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Challenge</p>
        <h2>Parents Are <span class="highlight">Searching</span> — Can They <span class="highlight">Find Your Centre</span>?</h2>
      </div>
      <div class="section-content reveal">
        <p>Parents shortlist centres side by side — subjects, levels, timetable, tutors — long before they ever call or walk in.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>A Facebook Page Isn't Enough</h3>
            <p>Parents want programmes, tutor credentials, class timings and a way to book a trial in one place. A directory listing answers none of it.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Parents Research Thoroughly</h3>
            <p>They read testimonials, check which levels and subjects you cover, and study the timetable against a child's school hours. Anything missing is a reason to look elsewhere.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>First Impressions Decide It</h3>
            <p>From national chains to neighbourhood centres in Tampines and Bishan, the market is crowded. Your site decides whether a parent enquires or scrolls past.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHAT WE BUILD ========== -->
  <section class="section" id="sub-services" style="background: var(--bg-alt);" aria-label="Tuition centre website design services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">What We Build</p>
        <h2>Six <span class="highlight">Pillars</span> of a Tuition Centre <span class="highlight">Website</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Every site is built to turn a browsing parent into a booked trial or an enrolment enquiry, not just to look good. It pairs naturally with <a href="/tuition-centre-seo-singapore/">tuition centre SEO</a>, <a href="/tuition-centre-social-media-singapore/">social media</a> and <a href="/tuition-centre-google-ads-singapore/">Google Ads</a> when you are ready to drive traffic to it.</p>
      </div>
      <div class="service-details-grid deliver-grid">
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-business-website.webp');">
          <div class="service-detail-card__content">
            <h3>Programme Pages by Level &amp; Subject</h3>
            <p>A page per stream — PSLE, O-Level and A-Level across English, Math, Science and Chinese — setting out format, class size and who each programme suits.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-landing-page.webp');">
          <div class="service-detail-card__content">
            <h3>Trial-Class &amp; Enrolment Enquiry Forms</h3>
            <p>Parents request a trial or register straight from the site — child's level, subject and preferred timing captured, with automatic confirmation. Fewer phone calls for your front desk.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-local-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Tutor Profiles &amp; Timetable</h3>
            <p>Qualifications, teaching background and the subjects each tutor covers, alongside a clear timetable parents can read against a child's school hours.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-graphic-design.webp');">
          <div class="service-detail-card__content">
            <h3>Testimonials &amp; Results, Handled Honestly</h3>
            <p>Genuine parent testimonials and student achievements shown as records of past work, in context — never as promised outcomes or guaranteed grades.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-reels-video.webp');">
          <div class="service-detail-card__content">
            <h3>Multi-Branch Ready</h3>
            <p>A page per branch — Jurong East, Punggol, Woodlands, Ang Mo Kio — with its own timetable, map and local targeting, so parents find the outlet nearest them.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-speed-vitals.webp');">
          <div class="service-detail-card__content">
            <h3>Mobile-First, Search-Ready Foundations</h3>
            <p>Clean structure, fast mobile loads and schema built in from day one, because parents browse on their phones between drop-offs and late at night.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHY US ========== -->
  <section class="section" id="why-us" aria-label="Why choose Jraft Creative as your tuition centre web design agency">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2>A <span class="highlight">Web Design Agency</span> That Knows <span class="highlight">Tuition Centres</span></h2>
      </div>
      <div class="section-content reveal">
        <p>We build for the specific problem tuition centres have — competing locally, then converting a parent's enquiry into a term-long enrolment. It is one part of our wider approach to <a href="/industries/education/">education marketing in Singapore</a>, and if you want the groundwork first, our guide to <a href="/blog/good-business-website-singapore/">what makes a good business website in Singapore</a> is a useful starting point.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Education Industry Experience</h3>
            <p>We've built for tuition and enrichment centres across Singapore, and we know how to structure content that moves a browsing parent towards an enquiry.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Live Before the Next Term</h3>
            <p>Most tuition centre sites go live within two weeks, so you start capturing enrolment enquiries before the next intake rather than after it.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Website, SEO &amp; Ads Together</h3>
            <p>We also run <a href="/tuition-centre-seo-singapore/">tuition centre SEO</a> and <a href="/tuition-centre-google-ads-singapore/">Google Ads</a> — one system for filling class slots.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== ENROLMENT FUNNEL ========== -->
  <section class="section" id="buyer-funnel" style="background: var(--bg-alt);" aria-label="Where your website fits the tuition parent journey">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Enrolment Funnel</p>
        <h2>Where Your <span class="highlight">Website</span> Fits the <span class="highlight">Parent Journey</span></h2>
      </div>
      <div class="section-content reveal" style="margin-bottom: 24px;">
        <p>Parents move through the same five stages before a child starts classes. Your website carries the middle three — it is where a parent validates your tutors, compares you against the shortlist, and finally requests the trial.</p>
      </div>
      <ol class="renovation-funnel reveal">
        <li class="funnel-stage">
          <h3>Discover</h3>
          <p>A search or referral brings them to the site</p>
        </li>
        <li class="funnel-stage">
          <h3>Validate</h3>
          <p>Tutor profiles, testimonials, real student results</p>
        </li>
        <li class="funnel-stage">
          <h3>Compare</h3>
          <p>Programme pages answer level, subject and fit</p>
        </li>
        <li class="funnel-stage">
          <h3>Trial</h3>
          <p>Enquiry form turns interest into a booked trial</p>
        </li>
        <li class="funnel-stage">
          <h3>Enrol</h3>
          <p>Sign for the term, renew &amp; refer</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ========== PRICING ========== -->
  <!-- ========== FAQ ========== -->
  <section class="section faq-section" id="faq" style="background: var(--bg-alt);" aria-label="Frequently asked questions about tuition centre website design in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">FAQ</p>
        <h2>Tuition Centre <span class="highlight">Website</span> Questions Answered</h2>
      </div>
      <div class="faq-list">
        <details class="faq-item reveal reveal-d1">
          <summary>How much does a tuition centre website cost in Singapore?</summary>
          <div class="faq-answer"><p>Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>Can you add a trial-class enquiry form to our tuition centre website?</summary>
          <div class="faq-answer"><p>Yes. We build trial-class and registration enquiry forms straight into your site so parents can request a slot without calling. Forms capture the child's level, preferred subject, and preferred timing, then land in your inbox with an automatic confirmation to the parent — cutting phone tag and manual admin for your front desk.</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>Can you build programme pages by level and subject?</summary>
          <div class="faq-answer"><p>Yes. Each programme gets its own page organised by level and subject — PSLE, O-Level and A-Level streams across English, Math, Science and Chinese. Every page sets out the format, class size and who the programme suits, so a parent can judge fit before they enquire.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>How do you handle testimonials and student results?</summary>
          <div class="faq-answer"><p>We present genuine parent testimonials and student achievements as records of past work, never as promised outcomes. As an MOE-registered private education space, results are shown honestly and in context, so parents get an accurate picture of your centre without any guaranteed-grade claims.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>How do you help a tuition centre website rank on Google?</summary>
          <div class="faq-answer"><p>We optimise your site for what parents actually search — like "tuition near me", "math tuition Tampines", or "PSLE English tuition Singapore". That covers on-page SEO, schema markup for educational organisations, Google Business Profile optimisation, and location-targeted content so each branch can surface in local search and Google Maps.</p></div>
        </details>
      </div>
    </div>
  </section>


  <!-- Related Services -->
  <section class="section" id="related-services" aria-label="Related services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Explore More</p>
        <h2>More <span class="highlight">Tuition Centre</span> Services</h2>
      </div>
      <div class="related-services-grid reveal">
          <a href="/tuition-centre-marketing-singapore/" class="related-service-link">Tuition Centre Marketing</a>
          <a href="/tuition-centre-seo-singapore/" class="related-service-link">Tuition Centre SEO</a>
          <a href="/tuition-centre-ai-search-optimisation-singapore/" class="related-service-link">Tuition Centre GEO</a>
          <a href="/tuition-centre-google-ads-singapore/" class="related-service-link">Tuition Centre Google Ads</a>
          <a href="/tuition-centre-facebook-ads-singapore/" class="related-service-link">Tuition Centre Facebook Ads</a>
          <a href="/tuition-centre-social-media-singapore/" class="related-service-link">Tuition Centre Social Media</a>
          <a href="/tuition-centre-branding-singapore/" class="related-service-link">Tuition Centre Branding</a>
      </div>
    </div>
  </section>
</ServiceLayout>
