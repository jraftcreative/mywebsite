---
import ServiceLayout from '../layouts/ServiceLayout.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Social Media Agency for Enrichment Centres Singapore",
    "description": "Social media agency for enrichment centres in Singapore. Class activity highlights, student showcases, parenting tips, teacher intros and holiday-programme announcements built to reach parents and fill classes.",
    "provider": {
      "@type": "Organization",
      "name": "Jraft Creative",
      "url": "https://jraftcreative.com/",
      "logo": "https://jraftcreative.com/images/logo.png",
      "telephone": "+6582234578",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "60 Paya Lebar Road, Paya Lebar Square",
        "postalCode": "409051",
        "addressLocality": "Singapore",
        "addressCountry": "SG"
      }
    },
    "areaServed": { "@type": "Country", "name": "Singapore" },
    "serviceType": "Enrichment Centre Social Media"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "Which social platforms should an enrichment centre in Singapore be on?", "acceptedAnswer": { "@type": "Answer", "text": "For most centres the parents are on Facebook and Instagram, and increasingly on TikTok. Facebook groups and Instagram are where families in areas like Tampines, Bishan and Bukit Timah compare options before they enquire. We usually recommend depth on Facebook and Instagram, with TikTok added once you have a steady stream of class footage, rather than a thin presence on five platforms at once." } },
      { "@type": "Question", "name": "What should an enrichment centre actually post?", "acceptedAnswer": { "@type": "Answer", "text": "Class activity highlights and student showcases are the strongest content an enrichment centre has, because they show parents what a lesson actually looks like. Around that we build teacher intros, short parenting and child-development tips, and holiday-programme and enrolment announcements. The mix matters: pure promotion stops working quickly, while activity and teaching content keeps parents watching and saving." } },
      { "@type": "Question", "name": "Do we need permission to post children in photos and videos?", "acceptedAnswer": { "@type": "Answer", "text": "Yes, and it should be handled properly. Your students are minors, so you need written consent from a parent or guardian before publishing a child's image or work. We help you build a simple media-consent step into your enrolment paperwork so you have permission on file up front, rather than chasing it after a showcase or performance." } },
      { "@type": "Question", "name": "How does social media actually bring in enquiries?", "acceptedAnswer": { "@type": "Answer", "text": "Social rarely closes an enrolment on its own. What it does is reassure a parent — someone who has seen your classes in action and your teachers explain their approach arrives at your enquiry form already comfortable. We track that by watching profile-to-website clicks, saves and sends, and enquiries that mention social, rather than judging the work on follower count alone." } },
      { "@type": "Question", "name": "Can this work for a small single-location centre?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. A single centre with warm teachers and engaged children often outperforms a large chain on social, because the content feels like a real place rather than a brand. The constraint is usually time, not scale, so we build a filming and posting cadence you can sustain during busy term weeks, not one that collapses the moment holiday programmes start." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "Social Media Agency for Enrichment Centres Singapore", "item": "https://jraftcreative.com/enrichment-centre-social-media-singapore/" }
    ]
  }
];
---

<style is:global>
  /* Hide the global background grid pattern on this page only */
  .animated-bg__grid { display: none; }

  /* More-prominent related-service pills — match challenge-card-v2 green treatment */
  #related-services .related-service-link {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.35);
    color: var(--text);
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  #related-services .related-service-link:hover {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.22) 0%, rgba(73, 184, 137, 0.1) 100%), rgba(20, 28, 32, 0.7);
    border-color: rgba(73, 184, 137, 0.6);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(73, 184, 137, 0.3);
  }

  /* Separate the CTA section from related-services with bg-alt */
  .service-cta-section {
    background: var(--bg-alt) !important;
  }

  /* Enrolment Funnel — 5-stage horizontal flow with green accents */
  .renovation-funnel {
    list-style: none;
    padding: 0;
    margin: 56px 0 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 48px;
    counter-reset: funnel;
  }
  .funnel-stage {
    position: relative;
    text-align: center;
    padding: 28px 20px;
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.28);
    border-radius: 12px;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .funnel-stage:hover {
    transform: translateY(-4px);
    border-color: rgba(73, 184, 137, 0.55);
    box-shadow: 0 16px 40px -16px rgba(73, 184, 137, 0.3);
  }
  .funnel-stage h3 {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--accent);
    margin: 0 0 8px 0;
    letter-spacing: -0.01em;
  }
  .funnel-stage p {
    font-size: 0.82rem;
    color: var(--text);
    line-height: 1.5;
    margin: 0;
  }
  .funnel-stage:not(:last-child)::after {
    content: '→';
    position: absolute;
    right: -34px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--accent);
    font-size: 1.6rem;
    font-weight: 500;
    z-index: 2;
    line-height: 1;
    opacity: 0.7;
  }
  @media (max-width: 900px) {
    .renovation-funnel {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }
    .funnel-stage:nth-child(2n)::after,
    .funnel-stage:last-child::after {
      display: none;
    }
    .funnel-stage:nth-child(2n-1)::after {
      right: -22px;
    }
  }
  @media (max-width: 600px) {
    .renovation-funnel {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .funnel-stage::after {
      display: none;
    }
  }
</style>

<ServiceLayout
  title="Enrichment Centre Social Media Agency Singapore"
  description="Social media for enrichment centres in Singapore — class highlights, student showcases and enrolment content that reaches parents and fills classes."
  canonical="https://jraftcreative.com/enrichment-centre-social-media-singapore/"
  ogTitle="Enrichment Centre Social Media Agency Singapore"
  ogDescription="Social media for enrichment centres in Singapore. Class highlights, student showcases, parenting tips and holiday-programme content built to reach parents and fill classes."
  ogImage="https://jraftcreative.com/images/og-enrichment.jpg"
  keywords="social media agency for enrichment centres, enrichment centre social media singapore, social media marketing for enrichment centres, enrichment centre instagram singapore, enrichment centre facebook, enrichment centre tiktok, enrichment programme marketing singapore, Jraft Creative"
  schemaData={schemaData}
  heroLabel="Social Media Agency for Enrichment Centres"
  heroTitle='Social Media Agency for <span class="highlight">Enrichment Centres in Singapore</span>'
  heroSubtitle="Your classes already produce the best marketing material you will ever have — you just aren't filming it. We turn speech and drama sessions, art projects and coding builds into content that Singapore parents actually watch, then into enquiries and enrolments."
  heroImage="/images/service-enrichment.webp"
  heroImageAlt="Children learning in a Singapore enrichment class — enrichment centre social media"
  heroButtons={[
    { text: "Get a Free Content Review", href: "/contact/", class: "btn btn-primary" },
    { text: "See Enrichment Centre SEO", href: "/enrichment-centre-seo-singapore/", class: "btn btn-secondary" }
  ]}
  whatsappText="Hi Jraft Creative, I need social media for my enrichment centre in Singapore."
  ctaLabel="Fill Your Classes"
  ctaTitle="Get a Free Enrichment Centre Content Review"
  ctaDescription="Book a free consultation and we'll look at what you're posting now, what your classes are already producing that you aren't using, and where the gap is between followers and enrolments. We'll get back to you within 24 hours."
  ctaButtons={[
    { text: "Get a Free Content Review", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%20need%20social%20media%20for%20my%20enrichment%20centre%20in%20Singapore.", class: "btn btn-secondary" }
  ]}
  hideDefaultCta={false}
>

  <!-- ========== THE CHALLENGE ========== -->
  <section class="section" id="challenge" aria-label="Social media challenges for enrichment centres in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Challenge</p>
        <h2>You Run the <span class="highlight">Best Classes</span> in the Neighbourhood — and Parents <span class="highlight">Never See Them</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Enrichment centres sit on proof most businesses would pay for — engaged children, real projects, happy parents — then post a text graphic about term dates.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Great Lessons, Then Nothing</h3>
            <p>A term of speech and drama, art and coding happens, gets a single photo in a parent chat, and is never seen by the families still deciding where to send their child.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>The Feed Goes Quiet in Term</h3>
            <p>Busy teaching weeks fill up and the page stops for a month. Parents in Tampines or Punggol checking you out in that gap see a centre that looks inactive.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Followers That Never Enquire</h3>
            <p>An audience of current parents feels good and books nothing. Reach only matters if it lands with families who haven't chosen a centre yet.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHAT WE DELIVER ========== -->
  <section class="section" id="sub-services" style="background: var(--bg-alt);" aria-label="Social media services for enrichment centres">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">What We Deliver</p>
        <h2>Six <span class="highlight">Content Workstreams</span> Every Enrichment Centre <span class="highlight">Needs</span></h2>
      </div>
      <div class="section-content reveal">
        <p>We build a cadence around what your centre already does each week, so filming becomes a habit rather than a project. It runs alongside your <a href="/enrichment-centre-website-singapore/">enrichment centre website</a>, <a href="/enrichment-centre-seo-singapore/">SEO</a> and <a href="/enrichment-centre-google-ads-singapore/">Google Ads</a> as one system.</p>
      </div>
      <div class="service-details-grid deliver-grid">
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-reels-video.webp');">
          <div class="service-detail-card__content">
            <h3>Class Activity Highlights</h3>
            <p>Short, well-shot clips of real lessons — a robotics build, a drama warm-up, an art project taking shape. The most persuasive thing a centre can post, because it shows rather than tells.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-content-strategy.webp');">
          <div class="service-detail-card__content">
            <h3>Teacher Intros</h3>
            <p>Parents choose a teacher, not a unit number. We put your instructors, their background and their approach on camera so the choice feels personal and reassuring.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-graphic-design.webp');">
          <div class="service-detail-card__content">
            <h3>Student Showcases &amp; Performances</h3>
            <p>Speech and drama performances, art displays and coding demos, shared with parental consent as a window into your classes — never framed as a promised result.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-community-mgmt.webp');">
          <div class="service-detail-card__content">
            <h3>Parenting &amp; Child-Development Tips</h3>
            <p>Short, useful clips that answer what parents actually search — when to start, what a programme builds, how to support a child at home. Content parents save and send.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-meta-ads.webp');">
          <div class="service-detail-card__content">
            <h3>Holiday Programme &amp; Enrolment Announcements</h3>
            <p>June and December holiday workshops and new-term intakes, timed for when parents in Woodlands, Jurong East and Ang Mo Kio are actively looking for activities.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-analytics-reporting.webp');">
          <div class="service-detail-card__content">
            <h3>Reporting on Enquiries, Not Likes</h3>
            <p>We track profile-to-website clicks, saves and sends, and enquiries that mention social. Follower count is context, not the result.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHY US ========== -->
  <section class="section" id="why-us" aria-label="Why choose Jraft Creative as your enrichment centre social media agency">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2>A <span class="highlight">Social Media Agency</span> That Understands <span class="highlight">Enrichment Centres</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Enrichment social fails for specific reasons — term-time capacity, media consent for children, and content that flatters current parents instead of reaching new families. It is one part of <a href="/industries/education/">education marketing in Singapore</a>, and if you want the wider picture our guide to <a href="/blog/social-media-marketing-singapore/">social media marketing for Singapore businesses</a> is a good starting point.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>A Cadence You Can Sustain</h3>
            <p>We plan around teaching weeks and holiday programmes, so the feed doesn't go silent exactly when parents are researching the next intake.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Consent-Safe by Default</h3>
            <p>Your students are minors. We build media consent into enrolment so you have written permission on file before a showcase, and we never present a child's work as a promised outcome.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Built for Enquiries, Not Vanity</h3>
            <p>Every workstream ends in an enquiry. We would rather grow steadily with the right families than quickly with an audience that never books a trial class.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== ENROLMENT FUNNEL ========== -->
  <section class="section" id="buyer-funnel" style="background: var(--bg-alt);" aria-label="Where social media fits the enrichment parent journey">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Enrolment Funnel</p>
        <h2>Where <span class="highlight">Social</span> Fits the <span class="highlight">Parent Journey</span></h2>
      </div>
      <div class="section-content reveal" style="margin-bottom: 24px;">
        <p>Parents move through the same five stages before a child starts a programme. Social rarely wins the first search — its job is Reassure and Compare, where a parent decides whether your classes are worth a trial across town.</p>
      </div>
      <ol class="renovation-funnel reveal">
        <li class="funnel-stage">
          <h3>Discover</h3>
          <p>A reel or a parent's share puts you on the radar</p>
        </li>
        <li class="funnel-stage">
          <h3>Reassure</h3>
          <p>Class highlights show the lessons really work</p>
        </li>
        <li class="funnel-stage">
          <h3>Compare</h3>
          <p>Teacher intros make the choice feel personal</p>
        </li>
        <li class="funnel-stage">
          <h3>Enquire</h3>
          <p>Profile link and DMs turn interest into a message</p>
        </li>
        <li class="funnel-stage">
          <h3>Enrol</h3>
          <p>Showcase posts keep families renewing &amp; referring</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ========== FAQ ========== -->
  <section class="section faq-section" id="faq" style="background: var(--bg-alt);" aria-label="Frequently asked questions about social media for enrichment centres">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">FAQ</p>
        <h2>Enrichment Centre <span class="highlight">Social Media</span> — Questions Answered</h2>
      </div>
      <div class="faq-list">
        <details class="faq-item reveal reveal-d1">
          <summary>Which social platforms should an enrichment centre in Singapore be on?</summary>
          <div class="faq-answer"><p>For most centres the parents are on Facebook and Instagram, and increasingly on TikTok. Facebook groups and Instagram are where families in areas like Tampines, Bishan and Bukit Timah compare options before they enquire. We usually recommend depth on Facebook and Instagram, with TikTok added once you have a steady stream of class footage, rather than a thin presence on five platforms at once.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>What should an enrichment centre actually post?</summary>
          <div class="faq-answer"><p>Class activity highlights and student showcases are the strongest content an enrichment centre has, because they show parents what a lesson actually looks like. Around that we build teacher intros, short parenting and child-development tips, and holiday-programme and enrolment announcements. The mix matters: pure promotion stops working quickly, while activity and teaching content keeps parents watching and saving.</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>Do we need permission to post children in photos and videos?</summary>
          <div class="faq-answer"><p>Yes, and it should be handled properly. Your students are minors, so you need written consent from a parent or guardian before publishing a child's image or work. We help you build a simple media-consent step into your enrolment paperwork so you have permission on file up front, rather than chasing it after a showcase or performance.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>How does social media actually bring in enquiries?</summary>
          <div class="faq-answer"><p>Social rarely closes an enrolment on its own. What it does is reassure a parent — someone who has seen your classes in action and your teachers explain their approach arrives at your enquiry form already comfortable. We track that by watching profile-to-website clicks, saves and sends, and enquiries that mention social, rather than judging the work on follower count alone.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>Can this work for a small single-location centre?</summary>
          <div class="faq-answer"><p>Yes. A single centre with warm teachers and engaged children often outperforms a large chain on social, because the content feels like a real place rather than a brand. The constraint is usually time, not scale, so we build a filming and posting cadence you can sustain during busy term weeks, not one that collapses the moment holiday programmes start.</p></div>
        </details>
      </div>
    </div>
  </section>

  <!-- Related Services -->
  <section class="section" id="related-services" aria-label="Related services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Explore More</p>
        <h2>More <span class="highlight">Enrichment Centre</span> Services</h2>
      </div>
      <div class="related-services-grid reveal">
          <a href="/enrichment-centre-marketing-singapore/" class="related-service-link">Enrichment Centre Marketing</a>
          <a href="/enrichment-centre-seo-singapore/" class="related-service-link">Enrichment Centre SEO</a>
          <a href="/enrichment-centre-ai-search-optimisation-singapore/" class="related-service-link">Enrichment Centre GEO</a>
          <a href="/enrichment-centre-google-ads-singapore/" class="related-service-link">Enrichment Centre Google Ads</a>
          <a href="/enrichment-centre-branding-singapore/" class="related-service-link">Enrichment Centre Branding</a>
          <a href="/enrichment-centre-website-singapore/" class="related-service-link">Enrichment Centre Websites</a>
      </div>
    </div>
  </section>
</ServiceLayout>
