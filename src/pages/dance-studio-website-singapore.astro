---
import ServiceLayout from '../layouts/ServiceLayout.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Dance Studio Website Design Singapore",
    "description": "Custom website design for dance studios and dance schools in Singapore — class pages by style and level, instructor bios, showcase galleries, trial and class booking, schedules, and local SEO.",
    "provider": {
      "@type": "Organization",
      "name": "Jraft Creative",
      "url": "https://jraftcreative.com/",
      "logo": "https://jraftcreative.com/images/logo.png",
      "telephone": "+6582234578",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "60 Paya Lebar Road, Paya Lebar Square",
        "postalCode": "409051",
        "addressLocality": "Singapore",
        "addressCountry": "SG"
      }
    },
    "areaServed": { "@type": "Country", "name": "Singapore" },
    "serviceType": "Dance Studio Website Design"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How much does a dance studio website cost in Singapore?", "acceptedAnswer": { "@type": "Answer", "text": "Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote." } },
      { "@type": "Question", "name": "Can you add trial and class booking to our dance studio website?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We build a booking flow that lets students and parents register for trial classes, regular sessions, and workshops directly from your website. It can display your weekly schedule by style — ballet, hip-hop, jazz, contemporary, K-pop — filter by level and age group, show instructor availability, and send automated confirmation emails. That cuts down the WhatsApp back-and-forth so your front desk spends its time welcoming dancers at the door." } },
      { "@type": "Question", "name": "How do you present instructor bios and class levels?", "acceptedAnswer": { "@type": "Answer", "text": "Each instructor gets a profile page covering their training background, performance credits, choreography highlights, and teaching approach, with professional photos and embedded clips. Every style also gets its own page setting out levels from beginner to advanced, age groups for kids and adults, session formats, and exam or recital pathways — so a dancer lands on exactly the right class for them." } },
      { "@type": "Question", "name": "Can you build a showcase gallery of our dancers?", "acceptedAnswer": { "@type": "Answer", "text": "Yes, and we do it with consent front of mind. We build galleries for recital highlights, choreography reels, and student showcases, using only footage and photos you have permission to publish — which matters when minors are involved. Videos are embedded from YouTube or Vimeo and optimised so the page stays fast even with dozens of clips. Seeing real class energy is one of the strongest reasons a visitor books a trial." } },
      { "@type": "Question", "name": "Can you help our dance studio rank on Google in Singapore?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We optimise your website for what dancers and parents actually search — like 'dance studio near me', 'K-pop dance class Singapore', 'ballet lessons for kids Tampines', or 'hip-hop classes Orchard'. That covers on-page SEO, schema markup for dance studios, Google Business Profile optimisation, and location-targeted content across areas like Bishan, Bukit Timah, Jurong, and Katong to help you show up in local results and Google Maps." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "Dance Studio Website Singapore", "item": "https://jraftcreative.com/dance-studio-website-singapore/" }
    ]
  }
];
---

<style is:global>
  /* Hide the global background grid pattern on this page only */
  .animated-bg__grid { display: none; }

  /* More-prominent related-service pills — match challenge-card-v2 green treatment */
  #related-services .related-service-link {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.35);
    color: var(--text);
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  #related-services .related-service-link:hover {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.22) 0%, rgba(73, 184, 137, 0.1) 100%), rgba(20, 28, 32, 0.7);
    border-color: rgba(73, 184, 137, 0.6);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(73, 184, 137, 0.3);
  }

  /* Separate the CTA section from related-services with bg-alt */
  .service-cta-section {
    background: var(--bg-alt) !important;
  }

  /* Trial-to-Enrolment Funnel — 5-stage horizontal flow with green accents */
  .renovation-funnel {
    list-style: none;
    padding: 0;
    margin: 56px 0 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 48px;
    counter-reset: funnel;
  }
  .funnel-stage {
    position: relative;
    text-align: center;
    padding: 28px 20px;
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.28);
    border-radius: 12px;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .funnel-stage:hover {
    transform: translateY(-4px);
    border-color: rgba(73, 184, 137, 0.55);
    box-shadow: 0 16px 40px -16px rgba(73, 184, 137, 0.3);
  }
  .funnel-stage h3 {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--accent);
    margin: 0 0 8px 0;
    letter-spacing: -0.01em;
  }
  .funnel-stage p {
    font-size: 0.82rem;
    color: var(--text);
    line-height: 1.5;
    margin: 0;
  }
  .funnel-stage:not(:last-child)::after {
    content: '→';
    position: absolute;
    right: -34px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--accent);
    font-size: 1.6rem;
    font-weight: 500;
    z-index: 2;
    line-height: 1;
    opacity: 0.7;
  }
  @media (max-width: 900px) {
    .renovation-funnel {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }
    .funnel-stage:nth-child(2n)::after,
    .funnel-stage:last-child::after {
      display: none;
    }
    .funnel-stage:nth-child(2n-1)::after {
      right: -22px;
    }
  }
  @media (max-width: 600px) {
    .renovation-funnel {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .funnel-stage::after {
      display: none;
    }
  }
</style>

<ServiceLayout
  title="Dance Studio Website Singapore — Web Design Agency"
  description="Web design agency for dance studios in Singapore — class pages by style and level, instructor bios, showcase galleries, and trial class booking."
  canonical="https://jraftcreative.com/dance-studio-website-singapore/"
  ogTitle="Dance Studio Website Singapore — Web Design Agency"
  ogDescription="Custom website design for dance studios in Singapore. Class pages by style and level, instructor bios, showcase galleries, trial booking, and local SEO."
  ogImage="https://jraftcreative.com/images/og-webdev.jpg"
  keywords="web design agency for dance studios, dance studio website design singapore, dance studio website singapore, dance school website singapore, ballet website singapore, K-pop dance class website, hip-hop dance studio website, Jraft Creative"
  schemaData={schemaData}
  heroLabel="Web Design Agency for Dance Studios"
  heroTitle='Web Design Agency for <span class="highlight">Dance Studios in Singapore</span>'
  heroSubtitle="Dancers and parents are searching for classes online before they ever step into a studio. We build websites that lay out your styles and levels, introduce your instructors, and make booking a trial class effortless — so you can focus on choreography, not chasing enquiries."
  heroImage="/images/service-dancestudio.webp"
  heroImageAlt="Dance studio in Singapore"
  heroButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "See Our Work", href: "/about/", class: "btn btn-secondary" }
  ]}
  whatsappText="Hi Jraft Creative, I need a website for my dance studio in Singapore."
  ctaLabel="Ready to Grow Your Dance Studio?"
  ctaTitle="Get Your Dance Studio Online"
  ctaDescription="Tell us about your dance studio and we'll recommend the right website scope. Free consultation — no obligations, no pressure."
  ctaButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%20need%20a%20website%20for%20my%20dance%20studio%20in%20Singapore.", class: "btn btn-secondary" }
  ]}
  hideDefaultCta={false}
>

  <!-- ========== THE CHALLENGE ========== -->
  <section class="section" id="challenge" aria-label="Website challenges for dance studios in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Challenge</p>
        <h2>Dancers Are <span class="highlight">Searching</span> — Can They <span class="highlight">Find Your Studio</span>?</h2>
      </div>
      <div class="section-content reveal">
        <p>People compare studios side by side — styles, instructors, class times — long before they message you. A studio's website is often the deciding factor, and <a href="/blog/good-business-website-singapore/">what makes a good business website in Singapore</a> is exactly what tips a browser into a booked trial.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>An Instagram Page Isn't Enough</h3>
            <p>Prospective dancers want styles, levels, instructor credits, showcase footage and open slots in one place. A social feed answers almost none of it.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Parents Research Thoroughly</h3>
            <p>For kids' classes, parents check age groups, exam and recital pathways, and reviews from other parents. Anything missing is a reason to book elsewhere.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>First Impressions Decide It</h3>
            <p>From established academies to boutique studios, Singapore's dance scene is crowded. Your site is what decides whether someone books a trial or scrolls past.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHAT WE BUILD ========== -->
  <section class="section" id="sub-services" style="background: var(--bg-alt);" aria-label="Dance studio website design services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">What We Build</p>
        <h2>Six <span class="highlight">Pillars</span> of a Dance Studio <span class="highlight">Website</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Every site is built to turn a browsing visitor into a booked trial class, not just to look good. It sits at the centre of your <a href="/services/website-development/">website development</a> and wider <a href="/industries/fitness/">fitness and movement marketing</a>.</p>
      </div>
      <div class="service-details-grid deliver-grid">
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-business-website.webp');">
          <div class="service-detail-card__content">
            <h3>Class Pages by Style &amp; Level</h3>
            <p>A page per style — ballet, hip-hop, jazz, contemporary, K-pop and more — covering levels from beginner to advanced, kids and adults, session formats, and exam or recital pathways.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-landing-page.webp');">
          <div class="service-detail-card__content">
            <h3>Trial &amp; Class Booking</h3>
            <p>Dancers book straight from the site — schedule by style, filtering by level and instructor, automated confirmations. Less WhatsApp back-and-forth for your front desk.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-local-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Instructor Bios &amp; Credits</h3>
            <p>Training background, performance credits and teaching approach, with professional photos and embedded clips that give dancers and parents confidence in your team.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-graphic-design.webp');">
          <div class="service-detail-card__content">
            <h3>Showcase Gallery, With Consent</h3>
            <p>Recital highlights, choreography reels and student showcases — published only with the permissions you hold, which matters when minors are on camera.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-reels-video.webp');">
          <div class="service-detail-card__content">
            <h3>Schedule &amp; Timetable</h3>
            <p>A clear weekly timetable and term calendar for classes, workshops and recitals, so anyone can see what runs when before they get in touch.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-speed-vitals.webp');">
          <div class="service-detail-card__content">
            <h3>Mobile-First Speed</h3>
            <p>Fast mobile loads and clean structure with schema built in from day one, because most dancers find you on a phone and won't wait for a slow page.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHY US ========== -->
  <section class="section" id="why-us" aria-label="Why choose Jraft Creative as your dance studio web design agency">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2>A <span class="highlight">Web Design Agency</span> That Knows <span class="highlight">Dance Studios</span></h2>
      </div>
      <div class="section-content reveal">
        <p>We build for the specific problem dance studios have — competing locally, then converting an enquiry into a term-long enrolment.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Dance &amp; Movement Experience</h3>
            <p>We've built for dance studios, performing arts schools and fitness studios across Singapore, and know what turns a first-time visitor into a committed dancer.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Live Before the Next Term</h3>
            <p>Most dance studio sites go live within two weeks, so you start capturing bookings before the next intake or workshop series rather than after it.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Website, SEO &amp; Social Together</h3>
            <p>We also run <a href="/services/seo-performance/">SEO and performance</a> and <a href="/services/social-media/">social media</a> — one system for filling class slots.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== ENROLMENT FUNNEL ========== -->
  <section class="section" id="buyer-funnel" style="background: var(--bg-alt);" aria-label="Where your website fits the dance student journey">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Enrolment Funnel</p>
        <h2>Where Your <span class="highlight">Website</span> Fits the <span class="highlight">Student Journey</span></h2>
      </div>
      <div class="section-content reveal" style="margin-bottom: 24px;">
        <p>Dancers and parents move through the same five stages before a first class. Your website carries the middle three — it is where they validate your instructors, compare you against the shortlist, and finally book the trial.</p>
      </div>
      <ol class="renovation-funnel reveal">
        <li class="funnel-stage">
          <h3>Discover</h3>
          <p>A search or referral brings them to the site</p>
        </li>
        <li class="funnel-stage">
          <h3>Validate</h3>
          <p>Instructor bios, showcase footage, class levels</p>
        </li>
        <li class="funnel-stage">
          <h3>Compare</h3>
          <p>Style pages answer level, age and fit</p>
        </li>
        <li class="funnel-stage">
          <h3>Trial</h3>
          <p>Booking flow turns interest into a scheduled class</p>
        </li>
        <li class="funnel-stage">
          <h3>Enrol</h3>
          <p>Sign for the term, renew &amp; refer</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ========== PRICING ========== -->
  <!-- ========== FAQ ========== -->
  <section class="section faq-section" id="faq" style="background: var(--bg-alt);" aria-label="Frequently asked questions about dance studio website design in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">FAQ</p>
        <h2>Dance Studio <span class="highlight">Website</span> Questions Answered</h2>
      </div>
      <div class="faq-list">
        <details class="faq-item reveal reveal-d1">
          <summary>How much does a dance studio website cost in Singapore?</summary>
          <div class="faq-answer"><p>Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>Can you add trial and class booking to our dance studio website?</summary>
          <div class="faq-answer"><p>Yes. We build a booking flow that lets students and parents register for trial classes, regular sessions, and workshops directly from your website. It can display your weekly schedule by style — ballet, hip-hop, jazz, contemporary, K-pop — filter by level and age group, show instructor availability, and send automated confirmation emails. That cuts down the WhatsApp back-and-forth so your front desk spends its time welcoming dancers at the door.</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>How do you present instructor bios and class levels?</summary>
          <div class="faq-answer"><p>Each instructor gets a profile page covering their training background, performance credits, choreography highlights, and teaching approach, with professional photos and embedded clips. Every style also gets its own page setting out levels from beginner to advanced, age groups for kids and adults, session formats, and exam or recital pathways — so a dancer lands on exactly the right class for them.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>Can you build a showcase gallery of our dancers?</summary>
          <div class="faq-answer"><p>Yes, and we do it with consent front of mind. We build galleries for recital highlights, choreography reels, and student showcases, using only footage and photos you have permission to publish — which matters when minors are involved. Videos are embedded from YouTube or Vimeo and optimised so the page stays fast even with dozens of clips. Seeing real class energy is one of the strongest reasons a visitor books a trial.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>Can you help our dance studio rank on Google in Singapore?</summary>
          <div class="faq-answer"><p>Yes. We optimise your website for what dancers and parents actually search — like "dance studio near me", "K-pop dance class Singapore", "ballet lessons for kids Tampines", or "hip-hop classes Orchard". This covers on-page SEO, schema markup for dance studios, Google Business Profile optimisation, and location-targeted content across areas like Bishan, Bukit Timah, Jurong, and Katong to help you show up in local results and Google Maps.</p></div>
        </details>
      </div>
    </div>
  </section>


  <!-- Related Services -->
  <section class="section" id="related-services" aria-label="Related services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Explore More</p>
        <h2>More <span class="highlight">Dance Studio</span> Services</h2>
      </div>
      <div class="related-services-grid reveal">
          <a href="/industries/fitness/" class="related-service-link">Fitness Marketing</a>
          <a href="/services/website-development/" class="related-service-link">Website Development</a>
          <a href="/services/seo-performance/" class="related-service-link">SEO &amp; Performance</a>
          <a href="/services/social-media/" class="related-service-link">Social Media</a>
      </div>
    </div>
  </section>
</ServiceLayout>
