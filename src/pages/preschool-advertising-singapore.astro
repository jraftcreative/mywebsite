---
import ServiceLayout from '../layouts/ServiceLayout.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Preschool Advertising Agency Singapore",
    "description": "Paid advertising agency for preschools in Singapore. Google Search and Facebook/Instagram campaigns that reach parents in your catchment, drive open-house registrations and centre tours, and track enquiries by neighbourhood.",
    "provider": {
      "@type": "Organization",
      "name": "Jraft Creative",
      "url": "https://jraftcreative.com/",
      "logo": "https://jraftcreative.com/images/logo.png",
      "telephone": "+6582234578",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "60 Paya Lebar Road, Paya Lebar Square",
        "postalCode": "409051",
        "addressLocality": "Singapore",
        "addressCountry": "SG"
      }
    },
    "areaServed": { "@type": "Country", "name": "Singapore" },
    "serviceType": "Preschool Advertising"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How much does preschool advertising cost in Singapore?", "acceptedAnswer": { "@type": "Answer", "text": "It depends on how many centres you run, which neighbourhoods you draw from, and how competitive your catchment is — there is no single package. Estates like Bishan or Tampines can be more contested than newer HDB towns, and Google search clicks price differently from Meta reach. Book a consultation and we will scope your catchment and give you a transparent quote." } },
      { "@type": "Question", "name": "Should my preschool run Google Ads or Facebook and Instagram ads?", "acceptedAnswer": { "@type": "Answer", "text": "They do different jobs, and most preschools benefit from both. Google Search captures parents already looking — 'preschool near me', 'childcare Punggol', 'kindergarten Sengkang'. Facebook and Instagram reach parents of the right child age inside your catchment who are not searching yet, which is where open-house invitations and centre-tour lead ads perform. We usually run search for intent and Meta for reach and retargeting." } },
      { "@type": "Question", "name": "How do you promote a preschool open house with ads?", "acceptedAnswer": { "@type": "Answer", "text": "We build a dedicated open-house campaign in the weeks before the date — Google search ads for parents actively looking, plus Facebook and Instagram event and lead ads targeted by child age and neighbourhood. A registration page captures RSVPs, and we retarget parents who viewed the invite but did not register so the room fills closer to the day." } },
      { "@type": "Question", "name": "How do you track enquiries and enrolments from ads?", "acceptedAnswer": { "@type": "Answer", "text": "We set up conversion tracking for enquiry forms, lead-form submissions, and click-to-WhatsApp taps, using GCLID on the Google side and the Meta pixel on the social side, so every enquiry ties back to the exact keyword or ad that produced it. The number we report on is cost per centre-tour enquiry, and where your admin process allows, which campaigns move an enquiry through to an enrolment." } },
      { "@type": "Question", "name": "Can ads reach parents only in my preschool's neighbourhood?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Parents choose a centre by travel time, so we target a tight radius around your premises and the estates that feed it — Punggol, Sengkang, Tampines, Jurong, Woodlands, Bishan, Ang Mo Kio, or wherever you sit. On Meta we layer parent and child-age targeting on top of the radius, and we can build lookalike audiences from your existing parent list to find similar families nearby." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "Preschool Advertising Singapore", "item": "https://jraftcreative.com/preschool-advertising-singapore/" }
    ]
  }
];
---
<style is:global>
  /* Hide the global background grid pattern on this page only */
  .animated-bg__grid { display: none; }

  /* More-prominent related-service pills — match challenge-card-v2 green treatment */
  #related-services .related-service-link {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.35);
    color: var(--text);
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  #related-services .related-service-link:hover {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.22) 0%, rgba(73, 184, 137, 0.1) 100%), rgba(20, 28, 32, 0.7);
    border-color: rgba(73, 184, 137, 0.6);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(73, 184, 137, 0.3);
  }

  /* Separate the CTA section from related-services with bg-alt */
  .service-cta-section {
    background: var(--bg-alt) !important;
  }

  /* Trial-to-Enrolment Funnel — 5-stage horizontal flow with green accents */
  .renovation-funnel {
    list-style: none;
    padding: 0;
    margin: 56px 0 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 48px;
    counter-reset: funnel;
  }
  .funnel-stage {
    position: relative;
    text-align: center;
    padding: 28px 20px;
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.28);
    border-radius: 12px;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .funnel-stage:hover {
    transform: translateY(-4px);
    border-color: rgba(73, 184, 137, 0.55);
    box-shadow: 0 16px 40px -16px rgba(73, 184, 137, 0.3);
  }
  .funnel-stage h3 {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--accent);
    margin: 0 0 8px 0;
    letter-spacing: -0.01em;
  }
  .funnel-stage p {
    font-size: 0.82rem;
    color: var(--text);
    line-height: 1.5;
    margin: 0;
  }
  .funnel-stage:not(:last-child)::after {
    content: '→';
    position: absolute;
    right: -34px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--accent);
    font-size: 1.6rem;
    font-weight: 500;
    z-index: 2;
    line-height: 1;
    opacity: 0.7;
  }
  @media (max-width: 900px) {
    .renovation-funnel {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }
    .funnel-stage:nth-child(2n)::after,
    .funnel-stage:last-child::after {
      display: none;
    }
    .funnel-stage:nth-child(2n-1)::after {
      right: -22px;
    }
  }
  @media (max-width: 600px) {
    .renovation-funnel {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .funnel-stage::after {
      display: none;
    }
  }
</style>

<ServiceLayout
  title="Preschool Advertising Singapore | Jraft Creative"
  description="Paid ads for Singapore preschools — Google and Meta campaigns that reach nearby parents, fill open houses and tours, and drive enrolment enquiries."
  canonical="https://jraftcreative.com/preschool-advertising-singapore/"
  ogTitle="Preschool Advertising Singapore | Jraft Creative"
  ogDescription="Google and Meta ads for Singapore preschools — reach parents in your catchment, fill open houses, and track centre-tour enquiries."
  ogImage="https://jraftcreative.com/images/og-preschool.jpg"
  keywords="preschool advertising singapore, google ads for preschools singapore, facebook ads preschool singapore, preschool enrolment advertising, childcare advertising singapore, preschool open house ads, Jraft Creative"
  schemaData={schemaData}
  heroLabel="Preschool Advertising Agency"
  heroTitle='Advertising for Preschools <span class="highlight">in Singapore</span>'
  heroSubtitle="A parent searching 'preschool near me' or 'childcare Punggol' is deciding where to visit this week. We build and manage Google and Facebook campaigns for preschools that reach parents in your catchment — driving open-house registrations, centre tours, and enrolment enquiries."
  heroImage="/images/service-childcare.webp"
  heroImageAlt="Teacher reading with a young child at a Singapore preschool"
  heroButtons={[
    { text: "Get a Free Ad Strategy", href: "/contact/", class: "btn btn-primary" },
    { text: "See Preschool SEO", href: "/preschool-seo-singapore/", class: "btn btn-secondary" }
  ]}
  whatsappText="Hi Jraft Creative, I need advertising for my preschool in Singapore."
  ctaLabel="Fill Your Classrooms"
  ctaTitle="Get a Free Preschool Advertising Strategy Session"
  ctaDescription="Book a free consultation and we'll review your current enrolment pipeline, look at competitor advertising in your estate, and map the Google and Meta campaigns that reach parents near your centre. We'll get back to you within 24 hours."
  ctaButtons={[
    { text: "Get a Free Ad Strategy", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%20need%20advertising%20for%20my%20preschool%20in%20Singapore.", class: "btn btn-secondary" }
  ]}
  hideDefaultCta={false}
>

  <!-- ========== THE CHALLENGE ========== -->
  <section class="section" id="challenge" aria-label="Advertising challenges for preschools in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Challenge</p>
        <h2>Parents Compare Centres <span class="highlight">Online</span> Before They Ever <span class="highlight">Call</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Word of mouth arrives on its own schedule — and rarely from the estates where you still have places to fill.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Parents Decide in One Search</h3>
            <p>A parent types "childcare near me" and shortlists whoever appears first and answers fastest. A centre with no ads simply isn't on that list.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Broad Reach Wastes Budget</h3>
            <p>Boosting a post to "parents in Singapore" buys reach across the island from families who will never drive to your estate every morning.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Open Houses Run Under-Filled</h3>
            <p>An event announced only to your existing parents draws the families already enrolled — not the new ones who could take your empty places.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHAT WE DELIVER ========== -->
  <section class="section" id="sub-services" style="background: var(--bg-alt);" aria-label="Paid advertising services for preschools">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">What We Deliver</p>
        <h2>Six <span class="highlight">Pillars</span> of Preschool <span class="highlight">Advertising</span></h2>
      </div>
      <div class="section-content reveal">
        <p>We run Google Search and Facebook and Instagram together — search to catch parents already looking, social to reach the right families nearby before they start. Pair it with a <a href="/preschool-website-design-singapore/">preschool website</a> that turns clicks into enquiries, <a href="/preschool-seo-singapore/">preschool SEO</a> for organic visibility, and <a href="/preschool-social-media-marketing-singapore/">preschool social media</a> for the full picture.</p>
      </div>
      <div class="service-details-grid deliver-grid">
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-google-ads.webp');">
          <div class="service-detail-card__content">
            <h3>Google Search Campaigns</h3>
            <p>Ads on the searches that mean intent — "preschool near me", "childcare Punggol", "kindergarten Sengkang" — so you appear the moment a parent starts looking.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-meta-ads.webp');">
          <div class="service-detail-card__content">
            <h3>Facebook &amp; Instagram Targeting</h3>
            <p>We reach parents by child age and neighbourhood — Tampines, Jurong, Woodlands, Bishan, Ang Mo Kio — with photo and video creative that shows your centre.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-landing-page.webp');">
          <div class="service-detail-card__content">
            <h3>Tour &amp; Enquiry Lead Ads</h3>
            <p>Lead forms and click-to-WhatsApp that let a parent enquire or ask for a centre tour in one tap, without leaving the feed or the search page.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-campaign-analytics.webp');">
          <div class="service-detail-card__content">
            <h3>Open-House &amp; Enrolment Windows</h3>
            <p>Dedicated campaigns timed to your open house and intake windows, with a registration page and reminders that build attendance towards the date.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-local-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Catchment Retargeting</h3>
            <p>Parents rarely enquire on the first visit. We bring back those who viewed your page or invite, kept to a radius around your premises.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-business-website.webp');">
          <div class="service-detail-card__content">
            <h3>Conversion Tracking</h3>
            <p>GCLID on Google and the Meta pixel on social tie every enquiry back to the ad that made it, so budget follows the campaigns that produce tours.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHY US ========== -->
  <section class="section" id="why-us" aria-label="Why choose Jraft Creative for preschool advertising">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2>A <span class="highlight">Paid-Media Team</span> That Knows <span class="highlight">Preschool Enrolment</span></h2>
      </div>
      <div class="section-content reveal">
        <p>We run <a href="/industries/education/">education marketing in Singapore</a> across preschools and early-childhood centres, so we build to the parent decision — first search, centre tour, signed enrolment form. If you're weighing where to put budget first, our guide on <a href="/blog/google-ads-vs-meta-ads-singapore/">Google Ads vs Meta ads in Singapore</a> walks through how the two channels pull their weight.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>We Plan Around Intake Windows</h3>
            <p>Enquiries spike before term intakes and open houses. We scale budget into those windows and hold a lower baseline through quieter months.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Catchment-Led Targeting</h3>
            <p>Spend stays tight to the estates that realistically feed your centre, not spread thin across the island where clicks look cheap but never enrol.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Tracked to the Enquiry</h3>
            <p>We report cost per centre-tour enquiry, not cost per click. Your media budget goes straight to Google and Meta, never marked up.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== ENROLMENT FUNNEL ========== -->
  <section class="section" id="buyer-funnel" style="background: var(--bg-alt);" aria-label="Where paid ads fit the preschool parent journey">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Enrolment Funnel</p>
        <h2>Where <span class="highlight">Paid Ads</span> Fit the <span class="highlight">Parent Journey</span></h2>
      </div>
      <div class="section-content reveal" style="margin-bottom: 24px;">
        <p>Parents move through the same five stages before a child starts. Paid advertising owns the two highest-intent moments — Discover, when a parent first searches, and Enquire, when a retargeted ad brings a shortlister back to book a tour.</p>
      </div>
      <ol class="renovation-funnel reveal">
        <li class="funnel-stage">
          <h3>Discover</h3>
          <p>Search or social ad meets the first look for a centre</p>
        </li>
        <li class="funnel-stage">
          <h3>Validate</h3>
          <p>Programme, ECDA licence, photos, parent reviews</p>
        </li>
        <li class="funnel-stage">
          <h3>Compare</h3>
          <p>Shortlist centres within travel distance</p>
        </li>
        <li class="funnel-stage">
          <h3>Enquire</h3>
          <p>Retargeting brings shortlisters back to book a tour</p>
        </li>
        <li class="funnel-stage">
          <h3>Enrol</h3>
          <p>Visit, enrol for the term, renew &amp; refer</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ========== FAQ ========== -->
  <section class="section faq-section" id="faq" style="background: var(--bg-alt);" aria-label="Frequently asked questions about preschool advertising">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">FAQ</p>
        <h2>Preschool <span class="highlight">Advertising</span> — Questions Answered</h2>
      </div>
      <div class="faq-list">
        <details class="faq-item reveal reveal-d1">
          <summary>How much does preschool advertising cost in Singapore?</summary>
          <div class="faq-answer"><p>It depends on how many centres you run, which neighbourhoods you draw from, and how competitive your catchment is — there's no single package. Estates like Bishan or Tampines can be more contested than newer HDB towns, and Google search clicks price differently from Meta reach. Book a consultation and we'll scope your catchment and give you a transparent quote.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>Should my preschool run Google Ads or Facebook and Instagram ads?</summary>
          <div class="faq-answer"><p>They do different jobs, and most preschools benefit from both. Google Search captures parents already looking — "preschool near me", "childcare Punggol", "kindergarten Sengkang". Facebook and Instagram reach parents of the right child age inside your catchment who aren't searching yet, which is where open-house invitations and centre-tour lead ads perform. We usually run search for intent and Meta for reach and retargeting.</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>How do you promote a preschool open house with ads?</summary>
          <div class="faq-answer"><p>We build a dedicated open-house campaign in the weeks before the date — Google search ads for parents actively looking, plus Facebook and Instagram event and lead ads targeted by child age and neighbourhood. A registration page captures RSVPs, and we retarget parents who viewed the invite but didn't register so the room fills closer to the day.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>How do you track enquiries and enrolments from ads?</summary>
          <div class="faq-answer"><p>We set up conversion tracking for enquiry forms, lead-form submissions, and click-to-WhatsApp taps, using GCLID on the Google side and the Meta pixel on the social side, so every enquiry ties back to the exact keyword or ad that produced it. The number we report on is cost per centre-tour enquiry, and where your admin process allows, which campaigns move an enquiry through to an enrolment.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>Can ads reach parents only in my preschool's neighbourhood?</summary>
          <div class="faq-answer"><p>Yes. Parents choose a centre by travel time, so we target a tight radius around your premises and the estates that feed it — Punggol, Sengkang, Tampines, Jurong, Woodlands, Bishan, Ang Mo Kio, or wherever you sit. On Meta we layer parent and child-age targeting on top of the radius, and we can build lookalike audiences from your existing parent list to find similar families nearby.</p></div>
        </details>
      </div>
    </div>
  </section>

  <!-- Related Services -->
  <section class="section" id="related-services" aria-label="Related services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Explore More</p>
        <h2>More <span class="highlight">Preschool</span> Services</h2>
      </div>
      <div class="related-services-grid reveal">
          <a href="/preschool-marketing-singapore/" class="related-service-link">Preschool Marketing</a>
          <a href="/preschool-seo-singapore/" class="related-service-link">Preschool SEO</a>
          <a href="/preschool-ai-search-optimisation-singapore/" class="related-service-link">Preschool GEO</a>
          <a href="/preschool-social-media-marketing-singapore/" class="related-service-link">Preschool Social Media</a>
          <a href="/preschool-branding-singapore/" class="related-service-link">Preschool Branding</a>
          <a href="/preschool-website-design-singapore/" class="related-service-link">Preschool Websites</a>
      </div>
    </div>
  </section>
</ServiceLayout>
