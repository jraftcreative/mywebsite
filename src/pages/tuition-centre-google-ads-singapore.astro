---
import ServiceLayout from '../layouts/ServiceLayout.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Google Ads Agency for Tuition Centres Singapore",
    "description": "Google Ads agency for tuition centres in Singapore. Subject and level campaign structure, exam-season and new-year enrolment timing, neighbourhood targeting, and trial-class enquiry tracking.",
    "provider": {
      "@type": "Organization",
      "name": "Jraft Creative",
      "url": "https://jraftcreative.com/",
      "logo": "https://jraftcreative.com/images/logo.png",
      "telephone": "+6582234578",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "60 Paya Lebar Road, Paya Lebar Square",
        "postalCode": "409051",
        "addressLocality": "Singapore",
        "addressCountry": "SG"
      }
    },
    "areaServed": { "@type": "Country", "name": "Singapore" },
    "serviceType": "Tuition Centre Google Ads"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "Which keywords should a tuition centre bid on in Singapore?", "acceptedAnswer": { "@type": "Answer", "text": "The highest-intent searches are subject plus level plus location — 'PSLE Math tuition Tampines', 'secondary science tuition near me', 'A level chemistry tuition Singapore'. Exam-stage terms like 'PSLE English tuition' or 'O level e-maths tuition' signal a committed parent with a deadline. We usually avoid broad terms like 'tuition centre' on their own, which attract browsers and price-checkers rather than parents ready to book a trial class." } },
      { "@type": "Question", "name": "When should a tuition centre run Google Ads?", "acceptedAnswer": { "@type": "Answer", "text": "Enquiries spike around the new school year in January, the mid-year intake in June and July, and in the weeks after major exam results are released, when parents reassess. We scale budgets into those windows and hold a lower baseline through quieter months, because parents search for tuition all year — a struggling term can start a search in any month." } },
      { "@type": "Question", "name": "How do you track enrolment enquiries from Google Ads?", "acceptedAnswer": { "@type": "Answer", "text": "We set up conversion tracking for enquiry forms, WhatsApp clicks, and call taps, tie each one to a GCLID, and attribute it back to the exact keyword and ad that produced it. For a tuition centre the number that matters is trial-class bookings and enrolment enquiries, not raw clicks — so we report cost per enquiry and, where your admin process allows, which subjects and branches convert from trial to enrolled." } },
      { "@type": "Question", "name": "Can Google Ads work for a single-branch or new tuition centre?", "acceptedAnswer": { "@type": "Answer", "text": "Yes, and often better than for a large chain. A single branch can dominate a tight radius around one estate and a focused set of subjects, where bidding is far cheaper than competing island-wide. Because you appear on relevance and bid rather than brand recognition, a new centre can outrank an established name for 'maths tuition' in its own neighbourhood from the first week." } },
      { "@type": "Question", "name": "Should a tuition centre use Google Ads or Facebook Ads?", "acceptedAnswer": { "@type": "Answer", "text": "They do different jobs. Google Search captures parents who are already searching for a specific subject or level — the highest-intent moment. Facebook and Instagram build awareness and re-engage parents who visited but did not enquire. Most centres start with Google to catch active demand, then layer in Meta for remarketing and to fill classes that search volume alone cannot." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "Google Ads Agency for Tuition Centres Singapore", "item": "https://jraftcreative.com/tuition-centre-google-ads-singapore/" }
    ]
  }
];
---
<style is:global>
  /* Hide the global background grid pattern on this page only */
  .animated-bg__grid { display: none; }

  /* More-prominent related-service pills — match challenge-card-v2 green treatment */
  #related-services .related-service-link {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.35);
    color: var(--text);
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  #related-services .related-service-link:hover {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.22) 0%, rgba(73, 184, 137, 0.1) 100%), rgba(20, 28, 32, 0.7);
    border-color: rgba(73, 184, 137, 0.6);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(73, 184, 137, 0.3);
  }

  /* Separate the CTA section from related-services with bg-alt */
  .service-cta-section {
    background: var(--bg-alt) !important;
  }

  /* Trial-to-Enrolment Funnel — 5-stage horizontal flow with green accents */
  .renovation-funnel {
    list-style: none;
    padding: 0;
    margin: 56px 0 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 48px;
    counter-reset: funnel;
  }
  .funnel-stage {
    position: relative;
    text-align: center;
    padding: 28px 20px;
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.28);
    border-radius: 12px;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .funnel-stage:hover {
    transform: translateY(-4px);
    border-color: rgba(73, 184, 137, 0.55);
    box-shadow: 0 16px 40px -16px rgba(73, 184, 137, 0.3);
  }
  .funnel-stage h3 {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--accent);
    margin: 0 0 8px 0;
    letter-spacing: -0.01em;
  }
  .funnel-stage p {
    font-size: 0.82rem;
    color: var(--text);
    line-height: 1.5;
    margin: 0;
  }
  .funnel-stage:not(:last-child)::after {
    content: '→';
    position: absolute;
    right: -34px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--accent);
    font-size: 1.6rem;
    font-weight: 500;
    z-index: 2;
    line-height: 1;
    opacity: 0.7;
  }
  @media (max-width: 900px) {
    .renovation-funnel {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }
    .funnel-stage:nth-child(2n)::after,
    .funnel-stage:last-child::after {
      display: none;
    }
    .funnel-stage:nth-child(2n-1)::after {
      right: -22px;
    }
  }
  @media (max-width: 600px) {
    .renovation-funnel {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .funnel-stage::after {
      display: none;
    }
  }
</style>

<ServiceLayout
  title="Google Ads Agency for Tuition Centres Singapore"
  description="Google Ads for tuition centres in Singapore — reach parents searching PSLE, O-Level and A-Level tuition and turn clicks into trial-class enquiries."
  canonical="https://jraftcreative.com/tuition-centre-google-ads-singapore/"
  ogTitle="Google Ads Agency for Tuition Centres Singapore"
  ogDescription="Google Ads for tuition centres in Singapore. Subject and level campaigns, exam-season timing, and trial-class enquiry tracking."
  ogImage="https://jraftcreative.com/images/og-tuition.jpg"
  keywords="google ads agency for tuition centres, tuition centre google ads singapore, google ads for tuition centres, advertising for tuition centres singapore, psle tuition ads singapore, tuition centre ppc, Jraft Creative"
  schemaData={schemaData}
  heroLabel="Google Ads Agency for Tuition Centres"
  heroTitle='Google Ads Agency for <span class="highlight">Tuition Centres in Singapore</span>'
  heroSubtitle="A parent searching 'PSLE Math tuition near me' on a Sunday night is ready to book a trial class that week. We build and manage Google Ads campaigns for tuition centres that capture those searches — by subject, by level, by neighbourhood, and at the enrolment moments parents actually decide."
  heroImage="/images/service-tuition.webp"
  heroImageAlt="Students in a Singapore tuition centre classroom — tuition centre Google Ads"
  heroButtons={[
    { text: "Get a Free Ad Strategy", href: "/contact/", class: "btn btn-primary" },
    { text: "See Tuition Centre SEO", href: "/tuition-centre-seo-singapore/", class: "btn btn-secondary" }
  ]}
  whatsappText="Hi Jraft Creative, I need Google Ads for my tuition centre in Singapore."
  ctaLabel="Fill Your Trial Classes"
  ctaTitle="Get a Free Tuition Centre Ads Strategy Session"
  ctaDescription="Book a free consultation and we'll review your current ad performance, look at which subjects and levels are worth bidding on in your area, and map the keywords parents near your centre are already searching. We'll get back to you within 24 hours."
  ctaButtons={[
    { text: "Get a Free Ad Strategy", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%20need%20Google%20Ads%20for%20my%20tuition%20centre%20in%20Singapore.", class: "btn btn-secondary" }
  ]}
  hideDefaultCta={false}
>

  <!-- ========== THE CHALLENGE ========== -->
  <section class="section" id="challenge" aria-label="Google Ads challenges for tuition centres in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Challenge</p>
        <h2>Your Teachers Are <span class="highlight">Ready</span>. Your Trial Calendar <span class="highlight">Isn't</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Referrals and flyers arrive on their own schedule — and rarely in the subjects or timeslots where you have seats to fill.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Parents Decide in One Search</h3>
            <p>A parent types "PSLE Math tuition near me" and enquires with whoever appears first and replies fastest. Word of mouth never reaches most of them.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Broad Keywords Burn Budget</h3>
            <p>Bidding on "tuition centre" alone buys clicks from browsers, price-checkers and parents across the island who will never travel to your estate weekly.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Enquiries Don't Match Capacity</h3>
            <p>Twelve primary English enquiries are worthless when those classes are full and your secondary science slots sit half-empty three evenings a week.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHAT WE DELIVER ========== -->
  <section class="section" id="sub-services" style="background: var(--bg-alt);" aria-label="Google Ads services for tuition centres">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">What We Deliver</p>
        <h2>Six <span class="highlight">Pillars</span> of Tuition Centre <span class="highlight">Google Ads</span></h2>
      </div>
      <div class="section-content reveal">
        <p>We structure accounts the way a tuition centre actually works — by subject, by level, and by the catchment each branch realistically draws from. Pair the ads with a conversion-ready <a href="/tuition-centre-website-singapore/">tuition centre website</a>, organic rankings through <a href="/tuition-centre-seo-singapore/">tuition centre SEO</a>, and <a href="/tuition-centre-facebook-ads-singapore/">tuition centre Facebook Ads</a> for remarketing.</p>
      </div>
      <div class="service-details-grid deliver-grid">
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-google-ads.webp');">
          <div class="service-detail-card__content">
            <h3>Subject &amp; Level Structure</h3>
            <p>Separate campaigns for English, Math, Science, Chinese and beyond, split by primary, secondary and JC. Budget follows the subjects where you have seats.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-onpage-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Exam-Stage Intent</h3>
            <p>PSLE, O Level and A Level searches are different buyers with a deadline. Exam-stage terms signal a parent already committed to acting this term.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-local-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Neighbourhood Radius Targeting</h3>
            <p>Parents choose by travel time. We target tight radii around each branch — Tampines, Jurong East, Bishan, Punggol, Woodlands — and the MRT lines that feed them.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-graphic-design.webp');">
          <div class="service-detail-card__content">
            <h3>Ad Copy Parents Respond To</h3>
            <p>We write compliant copy that speaks differently to a PSLE parent and an A Level parent — small class sizes, experienced tutors, a free trial — without over-claiming results.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-business-website.webp');">
          <div class="service-detail-card__content">
            <h3>Trial-Class Landing Pages</h3>
            <p>A dedicated page per subject or level, with booking a trial class as the single obvious action. The enquiry is what your budget is buying.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-campaign-analytics.webp');">
          <div class="service-detail-card__content">
            <h3>Enrolment-Season Scaling</h3>
            <p>We scale into the January new-year intake, the June and July mid-year enrolment, and the post-results weeks when parents reassess and search hardest.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHY US ========== -->
  <section class="section" id="why-us" aria-label="Why choose Jraft Creative as your tuition centre Google Ads agency">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2>A <span class="highlight">Google Ads Agency</span> Built for <span class="highlight">Tuition Centres</span></h2>
      </div>
      <div class="section-content reveal">
        <p>A generalist agency will build you a competent account — and miss that tuition centres convert on booked trial classes, not on clicks. Our tuition work sits inside our wider <a href="/industries/education/">education marketing in Singapore</a> practice, and if you are weighing channels, our guide to <a href="/blog/google-ads-vs-meta-ads-singapore/">Google Ads versus Meta Ads for Singapore lead generation</a> explains where each one earns its place.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>We Know the School Calendar</h3>
            <p>The January intake, mid-year enrolment and post-results weeks drive predictable enquiry spikes. We plan budget around them, not after them.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Capacity-Led Budgeting</h3>
            <p>Spend shifts towards the subjects, levels and timeslots you can actually take students in, not wherever clicks happen to be cheapest.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Tracked to the Enquiry</h3>
            <p>We report cost per booked trial class and per enrolment enquiry, not cost per click. Your budget goes straight to Google, never marked up.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== TRIAL-TO-ENROLMENT FUNNEL ========== -->
  <section class="section" id="buyer-funnel" style="background: var(--bg-alt);" aria-label="Where Google Ads fits the tuition parent journey">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Enrolment Funnel</p>
        <h2>Where <span class="highlight">Google Ads</span> Fits the <span class="highlight">Parent Journey</span></h2>
      </div>
      <div class="section-content reveal" style="margin-bottom: 24px;">
        <p>Parents move through the same five stages before a child starts classes. Google Ads owns the two highest-intent moments — Discover, when a parent first searches a subject and level, and Enquire, when a remarketed ad brings a shortlister back to book a trial class.</p>
      </div>
      <ol class="renovation-funnel reveal">
        <li class="funnel-stage">
          <h3>Discover</h3>
          <p>Google Ads captures the first subject-and-level search</p>
        </li>
        <li class="funnel-stage">
          <h3>Validate</h3>
          <p>Tutor experience, class sizes, parent reviews</p>
        </li>
        <li class="funnel-stage">
          <h3>Compare</h3>
          <p>Shortlist centres within travel distance</p>
        </li>
        <li class="funnel-stage">
          <h3>Trial</h3>
          <p>Remarketing brings shortlisters back to book</p>
        </li>
        <li class="funnel-stage">
          <h3>Enrol</h3>
          <p>Sign for the term, renew &amp; refer</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ========== FAQ ========== -->
  <section class="section faq-section" id="faq" style="background: var(--bg-alt);" aria-label="Frequently asked questions about Google Ads for tuition centres">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">FAQ</p>
        <h2>Google Ads for <span class="highlight">Tuition Centres</span> — Questions Answered</h2>
      </div>
      <div class="faq-list">
        <details class="faq-item reveal reveal-d1">
          <summary>Which keywords should a tuition centre bid on in Singapore?</summary>
          <div class="faq-answer"><p>The highest-intent searches are subject plus level plus location — "PSLE Math tuition Tampines", "secondary science tuition near me", "A level chemistry tuition Singapore". Exam-stage terms like "PSLE English tuition" or "O level e-maths tuition" signal a committed parent with a deadline. We usually avoid broad terms like "tuition centre" on their own, which attract browsers and price-checkers rather than parents ready to book a trial class.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>When should a tuition centre run Google Ads?</summary>
          <div class="faq-answer"><p>Enquiries spike around the new school year in January, the mid-year intake in June and July, and in the weeks after major exam results are released, when parents reassess. We scale budgets into those windows and hold a lower baseline through quieter months, because parents search for tuition all year — a struggling term can start a search in any month.</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>How do you track enrolment enquiries from Google Ads?</summary>
          <div class="faq-answer"><p>We set up conversion tracking for enquiry forms, WhatsApp clicks, and call taps, tie each one to a GCLID, and attribute it back to the exact keyword and ad that produced it. For a tuition centre the number that matters is trial-class bookings and enrolment enquiries, not raw clicks — so we report cost per enquiry and, where your admin process allows, which subjects and branches convert from trial to enrolled.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>Can Google Ads work for a single-branch or new tuition centre?</summary>
          <div class="faq-answer"><p>Yes, and often better than for a large chain. A single branch can dominate a tight radius around one estate — Bukit Timah, Ang Mo Kio, Woodlands — and a focused set of subjects, where bidding is far cheaper than competing island-wide. Because you appear on relevance and bid rather than brand recognition, a new centre can outrank an established name for "maths tuition" in its own neighbourhood from the first week.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>Should a tuition centre use Google Ads or Facebook Ads?</summary>
          <div class="faq-answer"><p>They do different jobs. Google Search captures parents who are already searching for a specific subject or level — the highest-intent moment. Facebook and Instagram build awareness and re-engage parents who visited but did not enquire. Most centres start with Google to catch active demand, then layer in Meta for remarketing and to fill classes that search volume alone cannot.</p></div>
        </details>
      </div>
    </div>
  </section>

  <!-- Related Services -->
  <section class="section" id="related-services" aria-label="Related services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Explore More</p>
        <h2>More <span class="highlight">Tuition Centre</span> Services</h2>
      </div>
      <div class="related-services-grid reveal">
          <a href="/tuition-centre-marketing-singapore/" class="related-service-link">Tuition Centre Marketing</a>
          <a href="/tuition-centre-seo-singapore/" class="related-service-link">Tuition Centre SEO</a>
          <a href="/tuition-centre-ai-search-optimisation-singapore/" class="related-service-link">Tuition Centre GEO</a>
          <a href="/tuition-centre-facebook-ads-singapore/" class="related-service-link">Tuition Centre Facebook Ads</a>
          <a href="/tuition-centre-social-media-singapore/" class="related-service-link">Tuition Centre Social Media</a>
          <a href="/tuition-centre-branding-singapore/" class="related-service-link">Tuition Centre Branding</a>
          <a href="/tuition-centre-website-singapore/" class="related-service-link">Tuition Centre Websites</a>
      </div>
    </div>
  </section>
</ServiceLayout>
