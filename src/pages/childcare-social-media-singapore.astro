---
import ServiceLayout from '../layouts/ServiceLayout.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Childcare Social Media Agency Singapore",
    "description": "Social media agency for childcare centres in Singapore. Facebook and Instagram content that reassures parents, shows daily care and learning-through-play, and fills enrolment and waitlists.",
    "provider": {
      "@type": "Organization",
      "name": "Jraft Creative",
      "url": "https://jraftcreative.com/",
      "logo": "https://jraftcreative.com/images/logo.png",
      "telephone": "+6582234578",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "60 Paya Lebar Road, Paya Lebar Square",
        "postalCode": "409051",
        "addressLocality": "Singapore",
        "addressCountry": "SG"
      }
    },
    "areaServed": { "@type": "Country", "name": "Singapore" },
    "serviceType": "Childcare Social Media"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "Which social platforms should a childcare centre in Singapore be on?", "acceptedAnswer": { "@type": "Answer", "text": "For most centres the parents are on Facebook and Instagram, and both matter. Facebook reaches families through neighbourhood and estate groups in areas like Punggol, Sengkang and Tampines, while Instagram is where a warm look inside the centre lands best through photos and Reels. We usually recommend depth on those two rather than a thin presence spread across five platforms." } },
      { "@type": "Question", "name": "What should a childcare centre actually post?", "acceptedAnswer": { "@type": "Answer", "text": "A reassuring look inside the centre is the strongest content you have. Around that we build learning-through-play moments, teacher and caregiver introductions, daily-routine and mealtime highlights, simple parenting tips, and timely reminders about registration windows and subsidies. The mix matters: pure enrolment promotion tires quickly, while everyday care and learning keeps parents watching and sending posts to each other." } },
      { "@type": "Question", "name": "Do you need permission to post children in photos and videos?", "acceptedAnswer": { "@type": "Answer", "text": "Yes, and it should be handled properly. Children are minors, so we only publish a child's image with written consent from a parent or guardian, and we follow your centre's own consent and privacy policy. Where consent is not on file we focus on learning spaces, activity setups, outdoor areas and branded graphics, so the feed stays full without featuring identifiable children." } },
      { "@type": "Question", "name": "How does social media actually help fill enrolment and the waitlist?", "acceptedAnswer": { "@type": "Answer", "text": "Social rarely closes a placement on its own. What it does is reassure a parent long before the centre visit, so a family that has seen your rooms, your teachers and your daily routine arrives already comfortable. We track that by watching profile-to-website clicks, open-house sign-ups and enquiries that mention social, rather than judging the work on likes or follower count." } },
      { "@type": "Question", "name": "Can this work for a single centre, not just a large chain?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. A single centre with warm teachers and a genuine daily routine often connects better than a large chain, because the content feels like a real place near home rather than a brand. The constraint is usually time during care hours, not scale, so we build a cadence your team can sustain and handle the filming, editing and captions around it." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "Childcare Social Media Agency Singapore", "item": "https://jraftcreative.com/childcare-social-media-singapore/" }
    ]
  }
];
---

<style is:global>
  /* Hide the global background grid pattern on this page only */
  .animated-bg__grid { display: none; }

  /* More-prominent related-service pills — match challenge-card-v2 green treatment */
  #related-services .related-service-link {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.35);
    color: var(--text);
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  #related-services .related-service-link:hover {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.22) 0%, rgba(73, 184, 137, 0.1) 100%), rgba(20, 28, 32, 0.7);
    border-color: rgba(73, 184, 137, 0.6);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(73, 184, 137, 0.3);
  }

  /* Separate the CTA section from related-services with bg-alt */
  .service-cta-section {
    background: var(--bg-alt) !important;
  }

  /* Enrolment Funnel — 5-stage horizontal flow with green accents */
  .renovation-funnel {
    list-style: none;
    padding: 0;
    margin: 56px 0 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 48px;
    counter-reset: funnel;
  }
  .funnel-stage {
    position: relative;
    text-align: center;
    padding: 28px 20px;
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.28);
    border-radius: 12px;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .funnel-stage:hover {
    transform: translateY(-4px);
    border-color: rgba(73, 184, 137, 0.55);
    box-shadow: 0 16px 40px -16px rgba(73, 184, 137, 0.3);
  }
  .funnel-stage h3 {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--accent);
    margin: 0 0 8px 0;
    letter-spacing: -0.01em;
  }
  .funnel-stage p {
    font-size: 0.82rem;
    color: var(--text);
    line-height: 1.5;
    margin: 0;
  }
  .funnel-stage:not(:last-child)::after {
    content: '→';
    position: absolute;
    right: -34px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--accent);
    font-size: 1.6rem;
    font-weight: 500;
    z-index: 2;
    line-height: 1;
    opacity: 0.7;
  }
  @media (max-width: 900px) {
    .renovation-funnel {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }
    .funnel-stage:nth-child(2n)::after,
    .funnel-stage:last-child::after {
      display: none;
    }
    .funnel-stage:nth-child(2n-1)::after {
      right: -22px;
    }
  }
  @media (max-width: 600px) {
    .renovation-funnel {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .funnel-stage::after {
      display: none;
    }
  }
</style>

<ServiceLayout
  title="Childcare Social Media Agency Singapore"
  description="Social media agency for childcare centres in Singapore — Facebook and Instagram content that reassures parents and fills enrolment and waitlists."
  canonical="https://jraftcreative.com/childcare-social-media-singapore/"
  ogTitle="Childcare Social Media Agency Singapore"
  ogDescription="Social media for childcare centres in Singapore. A warm look inside the centre, teacher intros and open-house posts built to fill enrolment and waitlists."
  ogImage="https://jraftcreative.com/images/og-childcare.jpg"
  keywords="childcare social media agency, childcare social media singapore, social media marketing for childcare centres, childcare instagram singapore, childcare facebook marketing, childcare enrolment content, Jraft Creative"
  schemaData={schemaData}
  heroLabel="Social Media Agency for Childcare Centres"
  heroTitle='Social Media Agency for <span class="highlight">Childcare Centres in Singapore</span>'
  heroSubtitle="Parents choose a centre they trust long before they visit — and most of that trust is now built on a phone screen. We turn everyday care, learning-through-play and your teachers into Facebook and Instagram content parents actually watch, then into enrolment enquiries and waitlist sign-ups."
  heroImage="/images/service-childcare.webp"
  heroImageAlt="Teacher reading with a young child at a Singapore childcare centre"
  heroButtons={[
    { text: "Get a Free Content Review", href: "/contact/", class: "btn btn-primary" },
    { text: "See Childcare SEO", href: "/childcare-centre-seo-singapore/", class: "btn btn-secondary" }
  ]}
  whatsappText="Hi Jraft Creative, I need social media for my childcare centre in Singapore."
  ctaLabel="Fill Your Enrolment & Waitlist"
  ctaTitle="Get a Free Childcare Content Review"
  ctaDescription="Book a free consultation and we'll look at what you're posting now, what your daily routine already gives you to work with that you aren't filming, and where the gap is between followers and enrolment enquiries. We'll get back to you within 24 hours."
  ctaButtons={[
    { text: "Get a Free Content Review", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%20need%20social%20media%20for%20my%20childcare%20centre%20in%20Singapore.", class: "btn btn-secondary" }
  ]}
  hideDefaultCta={false}
>

  <!-- ========== THE CHALLENGE ========== -->
  <section class="section" id="challenge" aria-label="Social media challenges for childcare centres in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Challenge</p>
        <h2>Parents Decide They <span class="highlight">Trust You</span> Before They Ever <span class="highlight">Walk In</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Choosing a childcare centre is one of the highest-stakes decisions a working parent makes — and most of it happens online, before your team ever meets them.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>The Day Happens, Then Vanishes</h3>
            <p>A morning full of sensory play, outdoor time and settled little ones goes by, gets nothing filmed, and is never seen by a parent deciding where to place their child.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>The Feed Goes Quiet</h3>
            <p>Care hours fill the day and the page falls silent for weeks. A parent in Punggol or Tampines checking you out in that gap sees a centre that looks inactive.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Followers Who Never Enquire</h3>
            <p>An audience of current parents feels reassuring and fills nothing. Reach only matters if it lands with families who haven't chosen a centre yet.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHAT WE DELIVER ========== -->
  <section class="section" id="sub-services" style="background: var(--bg-alt);" aria-label="Social media services for childcare centres">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">What We Deliver</p>
        <h2>Six <span class="highlight">Content Workstreams</span> Every Childcare Centre <span class="highlight">Needs</span></h2>
      </div>
      <div class="section-content reveal">
        <p>We build a cadence around what your centre already does each day, so filming becomes a habit rather than a project — and it connects to your <a href="/childcare-centre-website-singapore/">childcare website</a>, <a href="/childcare-centre-seo-singapore/">childcare SEO</a> and <a href="/childcare-centre-advertising-singapore/">childcare advertising</a> as one enrolment system.</p>
      </div>
      <div class="service-details-grid deliver-grid">
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-reels-video.webp');">
          <div class="service-detail-card__content">
            <h3>A Warm Look Inside the Centre</h3>
            <p>Short, gentle clips of learning-through-play, outdoor time and mealtimes — the single most reassuring thing a centre can post, because it shows the day rather than describing it.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-content-strategy.webp');">
          <div class="service-detail-card__content">
            <h3>Teacher &amp; Caregiver Intros</h3>
            <p>Parents entrust a person, not a building. We put your teachers, their warmth and their approach on camera so the choice to visit feels natural.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-graphic-design.webp');">
          <div class="service-detail-card__content">
            <h3>Parenting Tips &amp; Learning Moments</h3>
            <p>Simple, useful posts on settling in, routines and early learning — the content parents in Sengkang and Bishan save and forward to other families.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-community-mgmt.webp');">
          <div class="service-detail-card__content">
            <h3>Registration &amp; Open-House Posts</h3>
            <p>Timely reminders on registration windows, subsidies and open-house dates, planned around when parents in your estate are actively looking.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-meta-ads.webp');">
          <div class="service-detail-card__content">
            <h3>Consent-Safe Filming Process</h3>
            <p>Children are minors. We build media consent into your enrolment paperwork and follow your privacy policy, so permission is on file before we ever film.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-analytics-reporting.webp');">
          <div class="service-detail-card__content">
            <h3>Reporting on Enquiries, Not Likes</h3>
            <p>We track profile-to-website clicks, open-house sign-ups and enquiries that mention social. Follower count is context, not the result.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHY US ========== -->
  <section class="section" id="why-us" aria-label="Why choose Jraft Creative as your childcare social media agency">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2>A <span class="highlight">Social Media Agency</span> That Understands <span class="highlight">Childcare</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Childcare social fails for specific reasons — care-hour capacity, child privacy, and content that reassures existing parents instead of reaching new families. As a specialist in <a href="/industries/education/">education marketing in Singapore</a>, we plan around all three, and you can see the wider picture in our guide to <a href="/blog/social-media-marketing-singapore/">social media marketing in Singapore</a>.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Privacy-First, Consent-Gated</h3>
            <p>All content follows your centre's consent policy. We keep the feed full with learning spaces, activity setups and branded graphics, and only feature identifiable children with parent consent on file.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Built for Enrolment, Not Vanity</h3>
            <p>Every workstream ends in an enquiry, an open-house visit or a waitlist sign-up. We would rather reach the right families near your centre than chase an audience that never enrols.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Full Review Before Anything Goes Live</h3>
            <p>Every post, caption and photo is sent for your sign-off first. You keep complete oversight of how your centre is presented to parents — nothing publishes without approval.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== ENROLMENT FUNNEL ========== -->
  <section class="section" id="buyer-funnel" style="background: var(--bg-alt);" aria-label="Where social media fits the childcare parent journey">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Enrolment Funnel</p>
        <h2>Where <span class="highlight">Social</span> Fits the <span class="highlight">Parent Journey</span></h2>
      </div>
      <div class="section-content reveal" style="margin-bottom: 24px;">
        <p>Parents in estates like Jurong, Woodlands and Ang Mo Kio move through the same five stages before a child starts. Social rarely wins the first search — its job is Reassure and Compare, where a parent decides whether your centre is worth the visit.</p>
      </div>
      <ol class="renovation-funnel reveal">
        <li class="funnel-stage">
          <h3>Discover</h3>
          <p>A Reel or a parent's share puts you on the radar</p>
        </li>
        <li class="funnel-stage">
          <h3>Reassure</h3>
          <p>A warm look inside shows the daily care is real</p>
        </li>
        <li class="funnel-stage">
          <h3>Compare</h3>
          <p>Teacher intros make the choice feel personal</p>
        </li>
        <li class="funnel-stage">
          <h3>Visit</h3>
          <p>Open-house posts and DMs turn interest into a tour</p>
        </li>
        <li class="funnel-stage">
          <h3>Enrol</h3>
          <p>Daily posts keep families renewing &amp; referring</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ========== FAQ ========== -->
  <section class="section faq-section" id="faq" style="background: var(--bg-alt);" aria-label="Frequently asked questions about social media for childcare centres">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">FAQ</p>
        <h2>Childcare <span class="highlight">Social Media</span> — Questions Answered</h2>
      </div>
      <div class="faq-list">
        <details class="faq-item reveal reveal-d1">
          <summary>Which social platforms should a childcare centre in Singapore be on?</summary>
          <div class="faq-answer"><p>For most centres the parents are on Facebook and Instagram, and both matter. Facebook reaches families through neighbourhood and estate groups in areas like Punggol, Sengkang and Tampines, while Instagram is where a warm look inside the centre lands best through photos and Reels. We usually recommend depth on those two rather than a thin presence spread across five platforms.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>What should a childcare centre actually post?</summary>
          <div class="faq-answer"><p>A reassuring look inside the centre is the strongest content you have. Around that we build learning-through-play moments, teacher and caregiver introductions, daily-routine and mealtime highlights, simple parenting tips, and timely reminders about registration windows and subsidies. The mix matters: pure enrolment promotion tires quickly, while everyday care and learning keeps parents watching and sending posts to each other.</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>Do you need permission to post children in photos and videos?</summary>
          <div class="faq-answer"><p>Yes, and it should be handled properly. Children are minors, so we only publish a child's image with written consent from a parent or guardian, and we follow your centre's own consent and privacy policy. Where consent is not on file we focus on learning spaces, activity setups, outdoor areas and branded graphics, so the feed stays full without featuring identifiable children.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>How does social media actually help fill enrolment and the waitlist?</summary>
          <div class="faq-answer"><p>Social rarely closes a placement on its own. What it does is reassure a parent long before the centre visit, so a family that has seen your rooms, your teachers and your daily routine arrives already comfortable. We track that by watching profile-to-website clicks, open-house sign-ups and enquiries that mention social, rather than judging the work on likes or follower count.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>Can this work for a single centre, not just a large chain?</summary>
          <div class="faq-answer"><p>Yes. A single centre with warm teachers and a genuine daily routine often connects better than a large chain, because the content feels like a real place near home rather than a brand. The constraint is usually time during care hours, not scale, so we build a cadence your team can sustain and handle the filming, editing and captions around it.</p></div>
        </details>
      </div>
    </div>
  </section>

  <!-- Related Services -->
  <section class="section" id="related-services" aria-label="Related services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Explore More</p>
        <h2>More <span class="highlight">Childcare</span> Services</h2>
      </div>
      <div class="related-services-grid reveal">
          <a href="/childcare-marketing-singapore/" class="related-service-link">Childcare Marketing</a>
          <a href="/childcare-centre-seo-singapore/" class="related-service-link">Childcare SEO</a>
          <a href="/childcare-centre-ai-search-optimisation-singapore/" class="related-service-link">Childcare GEO</a>
          <a href="/childcare-centre-advertising-singapore/" class="related-service-link">Childcare Advertising</a>
          <a href="/childcare-centre-website-singapore/" class="related-service-link">Childcare Websites</a>
      </div>
    </div>
  </section>
</ServiceLayout>
