---
import ServiceLayout from '../layouts/ServiceLayout.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Martial Arts Website Design Singapore",
    "description": "Conversion-focused website design for martial arts schools in Singapore — trial-class booking, membership sign-up, class timetables by discipline and level, instructor profiles and lineage, grading information, and mobile-first speed for karate, taekwondo, BJJ, and muay thai academies.",
    "provider": {
      "@type": "Organization",
      "name": "Jraft Creative",
      "url": "https://jraftcreative.com/",
      "logo": "https://jraftcreative.com/images/logo.png",
      "telephone": "+6582234578",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "60 Paya Lebar Road, Paya Lebar Square",
        "postalCode": "409051",
        "addressLocality": "Singapore",
        "addressCountry": "SG"
      }
    },
    "areaServed": { "@type": "Country", "name": "Singapore" },
    "serviceType": "Martial Arts Website Design"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How much does a martial arts website cost in Singapore?", "acceptedAnswer": { "@type": "Answer", "text": "Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote." } },
      { "@type": "Question", "name": "Can visitors book a trial class and sign up for membership on the website?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. That's the whole point of the build. We wire in trial-class booking with date and time selection, plus online membership sign-up so a student can choose a plan, enter their details, and start without messaging your front desk. We work with the booking and payment tools available in Singapore, or integrate the system you already use." } },
      { "@type": "Question", "name": "Can you show our class timetable by discipline and level, and keep it easy to update?", "acceptedAnswer": { "@type": "Answer", "text": "Absolutely. We build a live class schedule visitors can filter by discipline and level — kids and adult karate, taekwondo, BJJ, and muay thai — and set it up so your team can update times without touching code. Students check what's on today or next week without messaging you." } },
      { "@type": "Question", "name": "Do you build for kids and adult programmes across different disciplines?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We build for single-discipline dojos and multi-discipline academies alike — karate, taekwondo, BJJ, muay thai, and more — with clear paths for both kids and adult programmes. Each site is structured around how your school actually runs, so parents find safety and grading details fast while adult practitioners find the classes and levels they want." } },
      { "@type": "Question", "name": "How long does it take to build a martial arts website?", "acceptedAnswer": { "@type": "Answer", "text": "Most martial arts websites go live within about 2 weeks. Sites with trial booking, membership sign-up, instructor profiles, and a facilities gallery take a little longer, and multi-location builds with member portals longer still. We give you a clear timeline before we start." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "Martial Arts Website Singapore", "item": "https://jraftcreative.com/martial-arts-website-singapore/" }
    ]
  }
];
---

<style is:global>
  /* Hide the global background grid pattern on this page only */
  .animated-bg__grid { display: none; }

  /* More-prominent related-service pills — match challenge-card-v2 green treatment */
  #related-services .related-service-link {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.35);
    color: var(--text);
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  #related-services .related-service-link:hover {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.22) 0%, rgba(73, 184, 137, 0.1) 100%), rgba(20, 28, 32, 0.7);
    border-color: rgba(73, 184, 137, 0.6);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(73, 184, 137, 0.3);
  }

  /* Separate the CTA section from related-services with bg-alt */
  .service-cta-section {
    background: var(--bg-alt) !important;
  }

  /* Force even service card grid on desktop per locked landing-page pattern */
  #sub-services .deliver-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }
  @media (max-width: 900px) {
    #sub-services .deliver-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 600px) {
    #sub-services .deliver-grid { grid-template-columns: 1fr; }
  }

  /* Gym Website Flow — horizontal process flow with green accents */
  .renovation-funnel {
    list-style: none;
    padding: 0;
    margin: 56px 0 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 48px;
    counter-reset: funnel;
  }
  .funnel-stage {
    position: relative;
    text-align: center;
    padding: 28px 20px;
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.28);
    border-radius: 12px;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .funnel-stage:hover {
    transform: translateY(-4px);
    border-color: rgba(73, 184, 137, 0.55);
    box-shadow: 0 16px 40px -16px rgba(73, 184, 137, 0.3);
  }
  .funnel-stage h3 {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--accent);
    margin: 0 0 8px 0;
    letter-spacing: -0.01em;
  }
  .funnel-stage p {
    font-size: 0.82rem;
    color: var(--text);
    line-height: 1.5;
    margin: 0;
  }
  .funnel-stage:not(:last-child)::after {
    content: '→';
    position: absolute;
    right: -34px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--accent);
    font-size: 1.6rem;
    font-weight: 500;
    z-index: 2;
    line-height: 1;
    opacity: 0.7;
  }
  @media (max-width: 900px) {
    .renovation-funnel {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }
    .funnel-stage:nth-child(2n)::after,
    .funnel-stage:last-child::after {
      display: none;
    }
    .funnel-stage:nth-child(2n-1)::after {
      right: -22px;
    }
  }
  @media (max-width: 600px) {
    .renovation-funnel {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .funnel-stage::after {
      display: none;
    }
  }
</style>

<ServiceLayout
  title="Martial Arts Website Singapore — Jraft Creative"
  description="Conversion-focused website design for martial arts schools in Singapore — trial-class booking, membership sign-up, timetables, instructor profiles, fast."
  canonical="https://jraftcreative.com/martial-arts-website-singapore/"
  ogTitle="Martial Arts Website Design Singapore — Jraft Creative"
  ogDescription="Website design for martial arts schools in Singapore. Trial-class booking, membership sign-up, class timetables, instructor profiles, grading info, facilities gallery."
  ogImage="https://jraftcreative.com/images/og-martialarts.jpg"
  keywords="martial arts website design singapore, martial arts website singapore, karate website singapore, taekwondo website singapore, bjj website singapore, muay thai website singapore, kids martial arts website singapore, martial arts web design, Jraft Creative"
  schemaData={schemaData}
  heroLabel="Martial Arts Website Design"
  heroTitle='Website Design for <span class="highlight">Martial Arts Schools in Singapore</span>'
  heroSubtitle="Parents and adults find a school on their phone, then decide in seconds whether to book a trial. We build conversion-focused martial arts websites — trial-class booking, membership sign-up, timetables by discipline and level, and instructor profiles that load fast — so a visitor from Tampines to Tanjong Pagar turns into a booked trial, not a bounce."
  heroImage="/images/service-martialarts.webp"
  heroImageAlt="Martial artist training at sunset in Singapore"
  heroButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "See How We Work", href: "/process/", class: "btn btn-secondary" }
  ]}
  whatsappText="Hi Jraft Creative, I need a website for my martial arts school in Singapore."
  ctaLabel="Ready to Fill More Trials?"
  ctaTitle="Get Your Martial Arts School Online"
  ctaDescription="Tell us about your school and the disciplines you teach, and we'll recommend the right website approach. Free consultation — no obligations, no pressure."
  ctaButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%20need%20a%20website%20for%20my%20martial%20arts%20school%20in%20Singapore.", class: "btn btn-secondary" }
  ]}
>

  <!-- ========== THE CHALLENGE ========== -->
  <section class="section" id="challenge" aria-label="Why martial arts schools need a proper website">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Challenge</p>
        <h2>People Search "Martial Arts Near Me" <span class="highlight">on Their Phone</span> — Does Yours <span class="highlight">Win the Trial</span>?</h2>
      </div>
      <div class="section-content reveal">
        <p>Singapore's martial arts scene is crowded, from Bukit Timah to Woodlands. A parent looking for kids' taekwondo and an adult hunting a BJJ gym both compare a few schools on their phone and book the first trial that's easy to grab. A slow or confusing site loses them to the dojo one MRT stop away.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>The Trial Is Buried</h3>
            <p>Prospects want one thing first: how to try a class. If booking a trial means a DM and a wait, most give up and open the next tab instead of stepping on the mat.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Social Isn't Enough</h3>
            <p>Instagram clips build awareness but vanish in a day. A parent choosing between karate and muay thai for their child needs the timetable, instructors, and grading path in one place, working around the clock.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Slow on Mobile Loses</h3>
            <p>Most searches happen on the go, on data. A heavy site that stalls for a few seconds bleeds bookings before the timetable even loads — and Google buries slow pages in local results.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHAT WE BUILD ========== -->
  <section class="section" id="sub-services" style="background: var(--bg-alt);" aria-label="Martial arts website design services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">What We Build</p>
        <h2>What We Build for <span class="highlight">Martial Arts Schools</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Every martial arts site we build is made to turn a visitor into a booked trial or member — trial-class booking front and centre, membership sign-up online, a live timetable by discipline and level, and instructor profiles. Pair it with <a href="/martial-arts-seo-singapore/">martial arts SEO</a> so you rank for "martial arts near me", and keep your classes full across kids and adult programmes.</p>
      </div>
      <div class="service-details-grid deliver-grid">
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-business-website.webp');">
          <div class="service-detail-card__content">
            <h3>Trial-Class &amp; Session Booking</h3>
            <p>The whole site points to one action — booking a trial or reserving a class. Discipline and time selection, automated confirmations telling students what to wear and expect, and reminders that cut no-shows and keep karate, taekwondo, BJJ, and muay thai sessions full.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-landing-page.webp');">
          <div class="service-detail-card__content">
            <h3>Online Membership Sign-Up</h3>
            <p>Students choose a plan, enter their details, and start online — no front-desk visit. Built for single-discipline dojos and multi-discipline academies alike, with the booking and payment tools available in Singapore.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-local-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Timetable, Instructors &amp; Grading</h3>
            <p>A live schedule visitors filter by discipline and level, plus profile pages showing each instructor's lineage, credentials, and experience — and clear grading paths so parents and adults see how progression works before they commit.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-graphic-design.webp');">
          <div class="service-detail-card__content">
            <h3>Facilities Gallery &amp; Mobile Speed</h3>
            <p>A gallery of your mats, equipment, and training space so prospects see the school before they visit — built mobile-first and tuned to load fast on data, with tap-to-call and tap-to-book always within reach.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHY CHOOSE US ========== -->
  <section class="section" id="why-us" aria-label="Why choose Jraft Creative for martial arts website design">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2>Why Choose Us for Your <span class="highlight">Martial Arts Website</span></h2>
      </div>
      <div class="section-content reveal">
        <p>We understand how martial arts schools in Singapore actually run — trial-to-member conversion, grading cycles, class scheduling by discipline and level, and the two very different audiences of parents and adult practitioners. A website is one part of our wider <a href="/industries/fitness/">fitness marketing in Singapore</a>.</p>
      </div>
      <div class="service-details-grid" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Built to Convert</h3>
            <p>Every page is designed around one job: turning a visitor into a booked trial or a signed-up member. Clear calls to action, fast forms, and a booking path that never makes prospects hunt.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Fast Turnaround</h3>
            <p>Most martial arts sites go live in about 2 weeks — quick enough to catch a new term, a competition season, or a kids' holiday-camp push in Jurong or Ang Mo Kio without missing the demand.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Parents &amp; Adults, Both Served</h3>
            <p>Your site serves two audiences at once. We structure content so parents find safety and grading details fast, while adult practitioners find sparring schedules and levels without wading through kids' content.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WEBSITE FLOW ========== -->
  <section class="section" id="website-flow" style="background: var(--bg-alt);" aria-label="How we build your martial arts website">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">How It Works</p>
        <h2>From First Call to <span class="highlight">Booked Trials</span></h2>
      </div>
      <div class="section-content reveal" style="margin-bottom: 24px;">
        <p>We run the same four-step build on every school — clear, quick, and made to start taking trial bookings the moment you go live. For the thinking behind it, our guide on <a href="/blog/good-business-website-singapore/">what makes a good business website in Singapore</a> covers the essentials.</p>
      </div>
      <ol class="renovation-funnel reveal">
        <li class="funnel-stage">
          <h3>Discover</h3>
          <p>We map your disciplines, instructors, and booking needs</p>
        </li>
        <li class="funnel-stage">
          <h3>Design</h3>
          <p>Bespoke school design, built mobile-first</p>
        </li>
        <li class="funnel-stage">
          <h3>Build</h3>
          <p>Booking, sign-up, and timetable wired and tested</p>
        </li>
        <li class="funnel-stage">
          <h3>Launch</h3>
          <p>Live in about 2 weeks, tuned for bookings</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ========== FAQ ========== -->
  <section class="section faq-section" id="faq" aria-label="Frequently asked questions about martial arts website design in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">FAQ</p>
        <h2><span class="highlight">Martial Arts Website</span> — Questions <span class="highlight">Answered</span></h2>
      </div>
      <div class="faq-list">
        <details class="faq-item reveal reveal-d1">
          <summary>How much does a martial arts website cost in Singapore?</summary>
          <div class="faq-answer"><p>Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>Can visitors book a trial class and sign up for membership on the website?</summary>
          <div class="faq-answer"><p>Yes. That's the whole point of the build. We wire in trial-class booking with date and time selection, plus online membership sign-up so a student can choose a plan, enter their details, and start without messaging your front desk. We work with the booking and payment tools available in Singapore, or integrate the system you already use.</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>Can you show our class timetable by discipline and level, and keep it easy to update?</summary>
          <div class="faq-answer"><p>Absolutely. We build a live class schedule visitors can filter by discipline and level — kids and adult karate, taekwondo, BJJ, and muay thai — and set it up so your team can update times without touching code. Students check what's on today or next week without messaging you.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>Do you build for kids and adult programmes across different disciplines?</summary>
          <div class="faq-answer"><p>Yes. We build for single-discipline dojos and multi-discipline academies alike — karate, taekwondo, BJJ, muay thai, and more — with clear paths for both kids and adult programmes. Each site is structured around how your school actually runs, so parents find safety and grading details fast while adult practitioners find the classes and levels they want.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>How long does it take to build a martial arts website?</summary>
          <div class="faq-answer"><p>Most martial arts websites go live within about 2 weeks. Sites with trial booking, membership sign-up, instructor profiles, and a facilities gallery take a little longer, and multi-location builds with member portals longer still. We give you a clear timeline before we start.</p></div>
        </details>
      </div>
    </div>
  </section>


  <!-- Related Services -->
  <section class="section" id="related-services" aria-label="Related services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Explore More</p>
        <h2>More Martial Arts Services</h2>
      </div>
      <div class="related-services-grid reveal">
          <a href="/martial-arts-marketing-singapore/" class="related-service-link">Martial Arts Marketing</a>
          <a href="/martial-arts-seo-singapore/" class="related-service-link">Martial Arts SEO</a>
          <a href="/martial-arts-ai-search-optimisation-singapore/" class="related-service-link">Martial Arts GEO</a>
      </div>
    </div>
  </section>
</ServiceLayout>
