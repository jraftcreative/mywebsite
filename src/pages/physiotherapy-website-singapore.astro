---
import ServiceLayout from '../layouts/ServiceLayout.astro';
import MarketingFunnelBlock from '../components/MarketingFunnelBlock.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Physiotherapy Website Design Singapore",
    "description": "Professional website design for physiotherapy clinics in Singapore. Condition and service pages, AHPC-registered therapist profiles, and online appointment booking — custom-quoted to your scope.",
    "provider": {
      "@type": "Organization",
      "name": "Jraft Creative",
      "url": "https://jraftcreative.com/",
      "logo": "https://jraftcreative.com/images/logo.png",
      "telephone": "+6582234578",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "60 Paya Lebar Road, Paya Lebar Square",
        "postalCode": "409051",
        "addressLocality": "Singapore",
        "addressCountry": "SG"
      }
    },
    "areaServed": { "@type": "Country", "name": "Singapore" },
    "serviceType": "Physiotherapy Clinic Website Design"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How much does a physiotherapy clinic website cost in Singapore?", "acceptedAnswer": { "@type": "Answer", "text": "Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote." } },
      { "@type": "Question", "name": "Can you integrate online appointment booking into my physiotherapy website?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We offer online appointment booking integration on most projects. Patients can choose a service, select a physiotherapist, pick an available time slot, and receive automated confirmation with clinic address and preparation notes — reducing phone calls and no-shows for your clinic." } },
      { "@type": "Question", "name": "Do you display therapist credentials and AHPC registration on the website?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Each physiotherapist gets a profile page featuring their AHPC registration status, academic qualifications, clinical specialisations, and years of experience. Showing AHPC-registered credentials is a key trust signal for allied-health websites in Singapore and helps patients confirm they are booking with a registered professional." } },
      { "@type": "Question", "name": "Can you include Medisave and insurance information on the website?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We build clear pages or sections explaining which insurers and corporate health plans your clinic works with, whether treatments are Medisave-claimable, and the documentation patients need. This is one of the most searched topics for physiotherapy patients and cuts down on enquiry calls." } },
      { "@type": "Question", "name": "How long does it take to build a physiotherapy clinic website?", "acceptedAnswer": { "@type": "Answer", "text": "Most physiotherapy clinic websites go live within 2–3 weeks. A focused site can be ready in about 2 weeks, while larger builds with online booking, condition pages, and multi-location support may take 3–4 weeks. We provide a clear timeline before starting." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "Physiotherapy Website Singapore", "item": "https://jraftcreative.com/physiotherapy-website-singapore/" }
    ]
  }
];
---

<style is:global>
  /* Hide the global background grid pattern on this page only */
  .animated-bg__grid { display: none; }

  /* More-prominent related-service pills — match challenge-card-v2 green treatment */
  #related-services .related-service-link {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.35);
    color: var(--text);
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  #related-services .related-service-link:hover {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.22) 0%, rgba(73, 184, 137, 0.1) 100%), rgba(20, 28, 32, 0.7);
    border-color: rgba(73, 184, 137, 0.6);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(73, 184, 137, 0.3);
  }
  .service-cta-section { background: var(--bg-alt) !important; }
  .renovation-funnel { list-style: none; padding: 0; margin: 56px 0 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 48px; }
  .funnel-stage { position: relative; text-align: center; padding: 28px 20px; background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6); border: 1px solid rgba(73, 184, 137, 0.28); border-radius: 12px; transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease; }
  .funnel-stage:hover { transform: translateY(-4px); border-color: rgba(73, 184, 137, 0.55); box-shadow: 0 16px 40px -16px rgba(73, 184, 137, 0.3); }
  .funnel-stage h3 { font-size: 1.05rem; font-weight: 600; color: var(--accent); margin: 0 0 8px 0; letter-spacing: -0.01em; }
  .funnel-stage p { font-size: 0.82rem; color: var(--text); line-height: 1.5; margin: 0; }
  .funnel-stage:not(:last-child)::after { content: '→'; position: absolute; right: -34px; top: 50%; transform: translateY(-50%); color: var(--accent); font-size: 1.6rem; font-weight: 500; z-index: 2; line-height: 1; opacity: 0.7; }
  @media (max-width: 900px) { .renovation-funnel { grid-template-columns: repeat(2, 1fr); gap: 32px; } .funnel-stage:nth-child(2n)::after, .funnel-stage:last-child::after { display: none; } .funnel-stage:nth-child(2n-1)::after { right: -22px; } }
  @media (max-width: 600px) { .renovation-funnel { grid-template-columns: 1fr; gap: 20px; } .funnel-stage::after { display: none; } }
</style>

<ServiceLayout
  title="Physiotherapy Clinic Website — Web Design Agency"
  description="Custom websites for Singapore physiotherapy clinics — online booking, condition pages, AHPC therapist profiles, mobile-first. Live in about 2 weeks."
  canonical="https://jraftcreative.com/physiotherapy-website-singapore/"
  ogTitle="Physiotherapy Clinic Website — Web Design Agency"
  ogDescription="Custom websites for Singapore physiotherapy clinics — online booking, condition pages, AHPC therapist profiles, mobile-first. Live in 2–3 weeks. Custom-quoted to your scope."
  ogImage="https://jraftcreative.com/images/og-physiotherapy.jpg"
  keywords="physiotherapy website design singapore, physiotherapy clinic website singapore, physio clinic website singapore, sports physiotherapy website, physio web design singapore, rehab clinic website singapore, physiotherapy digital marketing singapore, Jraft Creative"
  schemaData={schemaData}
  heroLabel="Web Design Agency for Physiotherapy Clinics"
  heroTitle='Web Design Agency for <span class="highlight">Physiotherapy Clinics in Singapore</span>'
  heroSubtitle="Your clinic needs more than a Google Maps pin. We build fast, mobile-first websites for physiotherapy practices — with condition and service pages, AHPC-registered therapist profiles, online appointment booking, and clear Medisave and insurance information. Physiotherapy website design and development that turns a search into a booked appointment."
  heroImage="/images/hero-physiotherapy-poster.jpg"
  heroImageAlt="Physiotherapist guiding a patient through rehabilitation exercises in a Singapore clinic"
  heroButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "See Our Work", href: "/about/", class: "btn btn-secondary" }
  ]}
  whatsappText="Hi Jraft Creative, I need a website for my physiotherapy clinic in Singapore."
  ctaLabel="Ready to Get Started?"
  ctaTitle="Get Your Physiotherapy Clinic Online"
  ctaDescription="Book a free consultation and tell us about your clinic and the treatments you offer. We'll get back to you within 24 hours with a tailored proposal."
  ctaButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%20need%20a%20website%20for%20my%20physiotherapy%20clinic%20in%20Singapore.", class: "btn btn-secondary" }
  ]}
  hideDefaultCta={false}
>

  <!-- ========== THE CHALLENGE ========== -->
  <section class="section" id="challenge" aria-label="Why physiotherapy clinics need a proper website">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Challenge</p>
        <h2>Patients Choose Their Physio <span class="highlight">Online</span></h2>
      </div>
      <div class="section-content reveal">
        <p>When someone strains a knee, needs post-op rehab, or wakes with back pain, their first move is a search — "sports physio Novena", "physiotherapy near me". Most compare two or three clinics before they book, and the one that wins is usually the clinic whose website answers their questions first. That is the foundation of healthcare marketing in Singapore, and it starts with a site built to do that job. If you want the fundamentals behind a booking-ready clinic site, our guide on <a href="/blog/good-business-website-singapore/">what makes a good business website in Singapore</a> covers the ground; you can also read how we approach <a href="/industries/healthcare/">healthcare marketing in Singapore</a> across the whole clinic.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>An Outdated Site Loses Bookings</h3>
            <p>If your website is dated, slow, or hard to read on a phone, patients quietly book the clinic in Orchard or Tampines that invested in theirs.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Patients Want Proof, Then Booking</h3>
            <p>Before committing to a course of treatment, patients want to see your therapists' AHPC credentials and specialisations — then book without waiting for office hours to call.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Cost Questions Kill Enquiries</h3>
            <p>Uncertainty over Medisave, insurance, and out-of-pocket costs stops patients booking. A clear site answers it up front and cuts the back-and-forth for your front desk.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHAT WE BUILD ========== -->
  <section class="section" id="sub-services" style="background: var(--bg-alt);" aria-label="Physiotherapy clinic website design services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">What We Build</p>
        <h2>Six <span class="highlight">Pillars</span> of a Physiotherapy Clinic <span class="highlight">Website</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Every element is built around clinical trust and booking — structured for how patients in Novena, Tanjong Pagar, Katong, and Jurong actually choose a physio. Pair the site with <a href="/physiotherapy-seo-singapore/">physiotherapy SEO</a>, <a href="/physiotherapy-social-media-singapore/">social media</a>, and <a href="/physiotherapy-google-ads-singapore/">Google Ads</a> to keep the appointment book full.</p>
      </div>
      <div class="service-details-grid deliver-grid">
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-business-website.webp');">
          <div class="service-detail-card__content">
            <h3>Condition &amp; Service Pages</h3>
            <p>A dedicated page per service — sports rehab, back pain, post-op rehab, dry needling, women's health — each explaining the condition, your approach, and a clear next step.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-landing-page.webp');">
          <div class="service-detail-card__content">
            <h3>Online Appointment Booking</h3>
            <p>Patients book directly — service, therapist, and time slot — with automated confirmations that cut no-shows and free the front desk from phone tag.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-local-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Therapist Profiles &amp; AHPC Credentials</h3>
            <p>A profile page per physiotherapist — AHPC registration, qualifications, specialisations, and a personal bio — because patients want to know who will treat them.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-graphic-design.webp');">
          <div class="service-detail-card__content">
            <h3>Medisave &amp; Insurance Pages</h3>
            <p>Clear pages on the insurers and corporate plans you accept, whether treatments are Medisave-claimable, and the documentation patients need — answered before they call.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-onpage-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Search-Ready Foundations</h3>
            <p>Clean structure, schema, and fast mobile loads built in, so the site can rank for treatment and neighbourhood searches across Bishan and beyond — not need rescuing later.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-speed-vitals.webp');">
          <div class="service-detail-card__content">
            <h3>Mobile-First &amp; Fast</h3>
            <p>Patients search on their phones, often in pain. Every page is built mobile-first and fast, with tap-to-call, tap-to-book, and directions to the nearest branch.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHY US ========== -->
  <section class="section" id="why-us" aria-label="Why choose Jraft Creative for physiotherapy website design">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2>A <span class="highlight">Web Design Agency</span> That Knows <span class="highlight">Clinical Trust</span></h2>
      </div>
      <div class="section-content reveal">
        <p>A site compelling enough to attract patients, detailed enough to answer them, and credible enough to make booking the obvious next step.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Allied-Health Website Experience</h3>
            <p>We understand the trust signals that matter in allied health — AHPC-registered credentials, clear treatment scope, honest cost information — and how to present them without overclaiming.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Live in Two to Three Weeks</h3>
            <p>Most physiotherapy sites go live within two to three weeks, so a new clinic, a therapist joining the team, or a seasonal injury peak is working when you need it.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Website, SEO &amp; Ads Together</h3>
            <p>We also run <a href="/physiotherapy-seo-singapore/">physiotherapy SEO</a> and <a href="/physiotherapy-google-ads-singapore/">Google Ads</a> — one agency for the clinic's whole online presence.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== PATIENT JOURNEY FUNNEL ========== -->
  <section class="section" id="buyer-funnel" style="background: var(--bg-alt);" aria-label="Where your website fits the patient journey">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Patient Journey</p>
        <h2>Where Your <span class="highlight">Website</span> Fits the <span class="highlight">Patient Journey</span></h2>
      </div>
      <div class="section-content reveal" style="margin-bottom: 24px;">
        <p>A physiotherapy patient moves through five stages before booking. Your website carries the middle three — it is where they research the condition, compare you against other clinics, and finally book.</p>
      </div>
      <ol class="renovation-funnel reveal">
        <li class="funnel-stage"><h3>Discover</h3><p>A search or referral brings them to the site</p></li>
        <li class="funnel-stage"><h3>Research</h3><p>Condition pages and therapist profiles answer it</p></li>
        <li class="funnel-stage"><h3>Compare</h3><p>Credentials and cost clarity weigh you against others</p></li>
        <li class="funnel-stage"><h3>Book</h3><p>Online booking turns interest into an appointment</p></li>
        <li class="funnel-stage"><h3>Treat</h3><p>A good first visit, then follow-ups &amp; referrals</p></li>
      </ol>
    </div>
  </section>

  <!-- ========== FAQ ========== -->
  <section class="section faq-section" id="faq" style="background: var(--bg-alt);" aria-label="Frequently asked questions about physiotherapy website design in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">FAQ</p>
        <h2>Physiotherapy <span class="highlight">Website</span> Questions Answered</h2>
      </div>
      <div class="faq-list">
        <details class="faq-item reveal reveal-d1">
          <summary>How much does a physiotherapy clinic website cost in Singapore?</summary>
          <div class="faq-answer"><p>Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>Can you integrate online appointment booking into my physiotherapy website?</summary>
          <div class="faq-answer"><p>Yes. We offer online appointment booking integration on most projects. Patients can choose a service, select a physiotherapist, pick an available time slot, and receive automated confirmation with clinic address and preparation notes — reducing phone calls and no-shows for your clinic.</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>Do you display therapist credentials and AHPC registration on the website?</summary>
          <div class="faq-answer"><p>Yes. Each physiotherapist gets a profile page featuring their AHPC registration status, academic qualifications, clinical specialisations, and years of experience. Showing AHPC-registered credentials is a key trust signal for allied-health websites in Singapore and helps patients confirm they are booking with a registered professional.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>Can you include Medisave and insurance information on the website?</summary>
          <div class="faq-answer"><p>Yes. We build clear pages or sections explaining which insurers and corporate health plans your clinic works with, whether treatments are Medisave-claimable, and the documentation patients need. This is one of the most searched topics for physiotherapy patients and cuts down on enquiry calls.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>How long does it take to build a physiotherapy clinic website?</summary>
          <div class="faq-answer"><p>Most physiotherapy clinic websites go live within 2–3 weeks. A focused site can be ready in about 2 weeks, while larger builds with online booking, condition pages, and multi-location support may take 3–4 weeks. We provide a clear timeline before starting.</p></div>
        </details>
      </div>
    </div>
  </section>


  <section class="section" id="related-services" aria-label="Related services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Explore More</p>
        <h2>More <span class="highlight">Physiotherapy Clinic</span> Services</h2>
      </div>
      <div class="related-services-grid reveal">
          <a href="/physiotherapy-marketing-singapore/" class="related-service-link">Physiotherapy Marketing</a>
          <a href="/physiotherapy-seo-singapore/" class="related-service-link">Physiotherapy SEO</a>
          <a href="/physiotherapy-ai-search-optimisation-singapore/" class="related-service-link">Physiotherapy GEO</a>
          <a href="/physiotherapy-google-ads-singapore/" class="related-service-link">Physiotherapy Google Ads</a>
          <a href="/physiotherapy-social-media-singapore/" class="related-service-link">Physiotherapy Social Media</a>
          <a href="/physiotherapy-branding-singapore/" class="related-service-link">Physiotherapy Branding</a>
      </div>
    </div>
  </section>

  <MarketingFunnelBlock
    industry="physiotherapy clinic"
    marketingHref="/physiotherapy-marketing-singapore/"
    outcomeLine="See how we'd bring in more booked appointments"
    ctaText="Physiotherapy Marketing Singapore"
  />

</ServiceLayout>
