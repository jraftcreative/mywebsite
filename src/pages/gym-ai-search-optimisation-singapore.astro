---
import ServiceLayout from '../layouts/ServiceLayout.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Gym AI Search Optimisation Singapore",
    "description": "Generative Engine Optimisation (GEO) for gyms in Singapore — get your gym named and cited inside ChatGPT, Gemini, Perplexity, and Google AI Overviews.",
    "provider": {
      "@type": "Organization",
      "name": "Jraft Creative",
      "url": "https://jraftcreative.com/",
      "logo": "https://jraftcreative.com/images/logo.png",
      "telephone": "+6582234578",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "60 Paya Lebar Road, Paya Lebar Square",
        "postalCode": "409051",
        "addressLocality": "Singapore",
        "addressCountry": "SG"
      }
    },
    "areaServed": { "@type": "Country", "name": "Singapore" },
    "serviceType": "Gym GEO / AI Search Optimisation"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "What is GEO and how is it different from SEO for a gym?", "acceptedAnswer": { "@type": "Answer", "text": "SEO gets your gym ranked in Google's blue links. GEO (generative engine optimisation) gets your gym named and cited inside AI answers — ChatGPT, Gemini, Perplexity, and Google AI Overviews. They share foundations, but AI engines weigh structured data, entity clarity, and third-party mentions differently. We do both." } },
      { "@type": "Question", "name": "Can AI search really send my gym new members?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. A growing share of people ask AI for a recommendation before they search or book a trial. Being the named gym in that answer — for a query like 'best gym near Tanjong Pagar' or '24 hour gym in Singapore' — puts you on the shortlist before they ever open Google Maps." } },
      { "@type": "Question", "name": "How long does GEO take to show results for a gym?", "acceptedAnswer": { "@type": "Answer", "text": "Perplexity and Google AI Overviews pull live data and can move within about 4 to 8 weeks. ChatGPT and Gemini shift more slowly as your entity authority builds across directories and review sites. We track it monthly so you see the movement." } },
      { "@type": "Question", "name": "How do you measure GEO success for a gym?", "acceptedAnswer": { "@type": "Answer", "text": "We re-run the same question bank each month — prompts like 'good gym for beginners near me' and '24 hour gym in Jurong' — and track how often your gym is mentioned, how often it's cited with a link, your share of voice versus competitors, and AI-referral traffic." } },
      { "@type": "Question", "name": "Do I need SEO before GEO for my gym?", "acceptedAnswer": { "@type": "Answer", "text": "Strong technical and content SEO is the foundation GEO builds on, so we usually run them together. If your SEO is weak, we fix that first — it makes the AI-citation work land faster." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "Gym AI Search Optimisation Singapore", "item": "https://jraftcreative.com/gym-ai-search-optimisation-singapore/" }
    ]
  }
];
---

<style is:global>
  .animated-bg__grid { display: none; }

  #related-services .related-service-link {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.35);
    color: var(--text);
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  #related-services .related-service-link:hover {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.22) 0%, rgba(73, 184, 137, 0.1) 100%), rgba(20, 28, 32, 0.7);
    border-color: rgba(73, 184, 137, 0.6);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(73, 184, 137, 0.3);
  }

  .service-cta-section { background: var(--bg-alt) !important; }

  #sub-services .deliver-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }
  @media (max-width: 900px) { #sub-services .deliver-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { #sub-services .deliver-grid { grid-template-columns: 1fr; } }

  .renovation-funnel {
    list-style: none;
    padding: 0;
    margin: 56px 0 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 48px;
    counter-reset: funnel;
  }
  .funnel-stage {
    position: relative;
    text-align: center;
    padding: 28px 20px;
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.28);
    border-radius: 12px;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .funnel-stage:hover {
    transform: translateY(-4px);
    border-color: rgba(73, 184, 137, 0.55);
    box-shadow: 0 16px 40px -16px rgba(73, 184, 137, 0.3);
  }
  .funnel-stage h3 { font-size: 1.05rem; font-weight: 600; color: var(--accent); margin: 0 0 8px 0; letter-spacing: -0.01em; }
  .funnel-stage p { font-size: 0.82rem; color: var(--text); line-height: 1.5; margin: 0; }
  .funnel-stage:not(:last-child)::after {
    content: '→';
    position: absolute;
    right: -34px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--accent);
    font-size: 1.6rem;
    font-weight: 500;
    z-index: 2;
    line-height: 1;
    opacity: 0.7;
  }
  @media (max-width: 900px) {
    .renovation-funnel { grid-template-columns: repeat(2, 1fr); gap: 32px; }
    .funnel-stage:nth-child(2n)::after, .funnel-stage:last-child::after { display: none; }
    .funnel-stage:nth-child(2n-1)::after { right: -22px; }
  }
  @media (max-width: 600px) {
    .renovation-funnel { grid-template-columns: 1fr; gap: 20px; }
    .funnel-stage::after { display: none; }
  }
</style>

<ServiceLayout
  title="Gym GEO & AI Search Singapore — Jraft Creative"
  description="GEO for gyms in Singapore — get named and cited inside ChatGPT, Gemini, Perplexity, and Google AI Overviews."
  canonical="https://jraftcreative.com/gym-ai-search-optimisation-singapore/"
  ogTitle="Gym GEO & AI Search Singapore — Jraft Creative"
  ogDescription="Get your gym named in AI search. GEO that makes ChatGPT, Gemini, Perplexity, and Google's AI recommend your gym."
  ogImage="https://jraftcreative.com/images/og-gym.jpg"
  keywords="gym ai search optimisation singapore, gym geo singapore, gym chatgpt optimisation, generative engine optimisation gym, gym ai visibility, 24 hour gym singapore ai, Jraft Creative"
  schemaData={schemaData}
  heroLabel="Gym GEO / AI Search"
  heroTitle='Get Your <span class="highlight">Gym</span> Named in <span class="highlight">AI Search</span>'
  heroSubtitle="When someone asks ChatGPT, Gemini, or Google's AI for the best gym near Tanjong Pagar or a 24 hour gym in Singapore, one gym gets named — and it takes the trial booking. GEO is how we make that gym yours."
  heroImage="/images/service-gym.webp"
  heroButtons={[
    { text: "Get a Free AI Visibility Check", href: "/contact/", class: "btn btn-primary" },
    { text: "See How We Work", href: "/process/", class: "btn btn-secondary" }
  ]}
  whatsappText="Hi Jraft Creative, I want my gym cited in AI search (GEO)."
  ctaLabel="Ready to Be the AI's Answer?"
  ctaTitle='Get Your <span class="highlight">Gym</span> Cited in AI Search'
  ctaDescription="Book a free AI visibility check and we'll show you exactly what ChatGPT, Gemini, and Google's AI say about your gym today — and who's getting named instead. No obligations."
  ctaButtons={[
    { text: "Get a Free AI Visibility Check", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%20want%20my%20gym%20cited%20in%20AI%20search%20%28GEO%29.", class: "btn btn-secondary" }
  ]}
>

  <!-- ========== THE CHALLENGE ========== -->
  <section class="section" id="challenge" aria-label="Why gyms need GEO in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Challenge</p>
        <h2>Search Has <span class="highlight">Split in Two</span> — and AI Is Naming <span class="highlight">Someone Else</span></h2>
      </div>
      <div class="section-content reveal">
        <p>More people now ask ChatGPT, Gemini, or Google's AI for a gym recommendation than scroll ten blue links. If the answer names three gyms and yours isn't one, you never enter the shortlist.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>The Answer, Not the List</h3>
            <p>People ask AI "best gym near Tanjong Pagar" or "24 hour gym in Bugis" and get a named recommendation, not a page of links. If your gym isn't in that answer, the prospect never sees you at the moment they decide.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Ranking on Google Isn't Enough</h3>
            <p>AI engines choose who to cite differently — on entity clarity, structured data, and trusted third-party mentions, not just backlinks. A gym that ranks on Google can still be invisible in AI answers.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Your Competitor Is Getting Cited</h3>
            <p>Right now, an AI query for a gym in your area is naming someone. Every week you're not the one cited, that gym compounds the trust and takes the trial bookings.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHAT WE DELIVER ========== -->
  <section class="section" id="sub-services" style="background: var(--bg-alt);" aria-label="GEO services for gyms">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">What We Deliver</p>
        <h2>How We Get Your Gym <span class="highlight">Cited</span></h2>
      </div>
      <div class="section-content reveal">
        <p>GEO is an additive layer on strong SEO. We make your gym legible to the engines, worth citing, and easy to verify — then track it every month. It pairs with your <a href="/gym-seo-singapore/">gym SEO</a>, your <a href="/gym-website-design-singapore/">gym website</a>, and your <a href="/gym-social-media-singapore/">gym social media</a> so every signal points the same way.</p>
      </div>
      <div class="service-details-grid deliver-grid">
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-ai.webp');">
          <div class="service-detail-card__content">
            <h3>AI Visibility Audit</h3>
            <p>We run the real questions your prospects ask ChatGPT, Perplexity, Gemini, and Google AI Mode — "24 hour gym in Singapore", "good gym for beginners near me" — and map who gets cited, so you see where you stand and who to overtake.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-onpage-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Schema &amp; Entity Layer</h3>
            <p>Structured data — LocalBusiness, FAQ, class, trainer and opening-hours info — plus consistent entity signals across directories and review sites that make your gym legible and verifiable to the engines.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-content-strategy.webp');">
          <div class="service-detail-card__content">
            <h3>Answer-First Content</h3>
            <p>Class pages, membership FAQs, and an llms.txt file written to answer the exact questions AI pulls from — clear, extractable, and specific to your formats, neighbourhood, and opening hours.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-analytics-reporting.webp');">
          <div class="service-detail-card__content">
            <h3>Citation &amp; Monitoring</h3>
            <p>Building mentions on the review sites and directories AI trusts, then tracking your AI visibility month over month against competitors — mention rate, citation rate, and share of voice.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHY CHOOSE US ========== -->
  <section class="section" id="why-us" aria-label="Why choose Jraft Creative for gym GEO">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2>We Don't Just Sell GEO — <span class="highlight">We Practise It</span></h2>
      </div>
      <div class="section-content reveal">
        <p>GEO is new, and most agencies are still guessing at it. We run the same playbook on our own gym work and on Jraft Creative itself — and report what actually moves citations. GEO sits within our wider <a href="/industries/fitness/">fitness marketing services</a>.</p>
      </div>
      <div class="service-details-grid" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Cited in AI Ourselves</h3>
            <p>Jraft Creative got its own site cited in Google's AI Overview. We run the same citation playbook for your gym — receipts, not a slide deck of theory.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Built for Local Fitness</h3>
            <p>GEO tuned to neighbourhood, class format, and the way gym-goers actually phrase questions to AI — from "24 hour gym in Tampines" to "personal training near Novena" — not a generic B2B approach.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>One Agency, All Channels</h3>
            <p>GEO sits alongside your SEO, social, ads, and website — so every signal reinforces the same authority, and the engines see one consistent, trusted gym.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== GEO FLOW ========== -->
  <section class="section" id="geo-flow" style="background: var(--bg-alt);" aria-label="How gym GEO works">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">How It Works</p>
        <h2>From <span class="highlight">Invisible</span> to <span class="highlight">the Answer</span></h2>
      </div>
      <div class="section-content reveal" style="margin-bottom: 24px;">
        <p>We run the same four-step system on every gym — and re-test the AI answers monthly so you can watch your visibility climb. New to this? Our guide on <a href="/blog/what-is-geo-ai-search-optimisation/">what GEO (AI search optimisation) actually is</a> explains the fundamentals.</p>
      </div>
      <ol class="renovation-funnel reveal">
        <li class="funnel-stage">
          <h3>Audit</h3>
          <p>Map what AI says about your gym today</p>
        </li>
        <li class="funnel-stage">
          <h3>Structure</h3>
          <p>Schema and entity signals put in place</p>
        </li>
        <li class="funnel-stage">
          <h3>Answer</h3>
          <p>Content rewritten for AI extraction</p>
        </li>
        <li class="funnel-stage">
          <h3>Monitor</h3>
          <p>Citations and visibility tracked monthly</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ========== FAQ ========== -->
  <section class="section faq-section" id="faq" aria-label="Frequently asked questions about gym GEO in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">FAQ</p>
        <h2><span class="highlight">Gym GEO</span> — Questions <span class="highlight">Answered</span></h2>
      </div>
      <div class="faq-list">
        <details class="faq-item reveal reveal-d1">
          <summary>What is GEO and how is it different from SEO for a gym?</summary>
          <div class="faq-answer"><p>SEO gets your gym ranked in Google's blue links. GEO (generative engine optimisation) gets your gym named and cited inside AI answers — ChatGPT, Gemini, Perplexity, and Google AI Overviews. They share foundations, but AI engines weigh structured data, entity clarity, and third-party mentions differently. We do both.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>Can AI search really send my gym new members?</summary>
          <div class="faq-answer"><p>Yes. A growing share of people ask AI for a recommendation before they search or book a trial. Being the named gym in that answer — for a query like "best gym near Tanjong Pagar" or "24 hour gym in Singapore" — puts you on the shortlist before they ever open Google Maps.</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>How long does GEO take to show results for a gym?</summary>
          <div class="faq-answer"><p>Perplexity and Google AI Overviews pull live data and can move within about 4 to 8 weeks. ChatGPT and Gemini shift more slowly as your entity authority builds across directories and review sites. We track it monthly so you see the movement.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>How do you measure GEO success for a gym?</summary>
          <div class="faq-answer"><p>We re-run the same question bank each month — prompts like "good gym for beginners near me" and "24 hour gym in Jurong" — and track how often your gym is mentioned, how often it's cited with a link, your share of voice versus competitors, and AI-referral traffic.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>Do I need SEO before GEO for my gym?</summary>
          <div class="faq-answer"><p>Strong technical and content SEO is the foundation GEO builds on, so we usually run them together. If your SEO is weak, we fix that first — it makes the AI-citation work land faster.</p></div>
        </details>
      </div>
    </div>
  </section>


  <!-- Related Services -->
  <section class="section" id="related-services" aria-label="Related services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Explore More</p>
        <h2>More Gym Services</h2>
      </div>
      <div class="related-services-grid reveal">
          <a href="/gym-marketing-singapore/" class="related-service-link">Gym Marketing</a>
          <a href="/gym-seo-singapore/" class="related-service-link">Gym SEO</a>
          <a href="/gym-google-ads-singapore/" class="related-service-link">Gym Google Ads</a>
          <a href="/gym-social-media-singapore/" class="related-service-link">Gym Social Media</a>
          <a href="/gym-branding-singapore/" class="related-service-link">Gym Branding</a>
          <a href="/gym-website-design-singapore/" class="related-service-link">Gym Websites</a>
      </div>
    </div>
  </section>
</ServiceLayout>
