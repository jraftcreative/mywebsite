---
import ServiceLayout from '../layouts/ServiceLayout.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Music School Website Design Singapore",
    "description": "Custom website design for music schools and music academies in Singapore — instrument and course pages, teacher profiles, trial lesson booking, recital calendars, and local SEO.",
    "provider": {
      "@type": "Organization",
      "name": "Jraft Creative",
      "url": "https://jraftcreative.com/",
      "logo": "https://jraftcreative.com/images/logo.png",
      "telephone": "+6582234578",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "60 Paya Lebar Road, Paya Lebar Square",
        "postalCode": "409051",
        "addressLocality": "Singapore",
        "addressCountry": "SG"
      }
    },
    "areaServed": { "@type": "Country", "name": "Singapore" },
    "serviceType": "Music School Website Design"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How much does a music school website cost in Singapore?", "acceptedAnswer": { "@type": "Answer", "text": "Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote." } },
      { "@type": "Question", "name": "Can you add online lesson booking to our music school website?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Our Business and Premium packages include an online booking system that lets students or parents schedule trial lessons, regular sessions, and makeup classes directly through your website. The system can display teacher availability, filter by instrument type, and send automated confirmation emails — reducing phone calls and admin time for your front desk." } },
      { "@type": "Question", "name": "How do you showcase teacher profiles and credentials?", "acceptedAnswer": { "@type": "Answer", "text": "Each teacher gets a dedicated profile page featuring their qualifications, performance experience, teaching philosophy, and specialisations. We can include professional headshots, embedded audio or video clips of performances, ABRSM or Trinity certification details, and student testimonials — giving prospective students confidence in your teaching team." } },
      { "@type": "Question", "name": "Can you help our music school rank for 'music school near me' on Google?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We optimise your website for keywords students and parents actually search — like 'music school near me', 'piano lessons Tampines', or 'guitar classes Singapore'. This includes on-page SEO, schema markup for music schools, Google Business Profile optimisation, and location-targeted content that helps you rank in local search results and Google Maps." } },
      { "@type": "Question", "name": "How long does it take to build a music school website?", "acceptedAnswer": { "@type": "Answer", "text": "Most music school websites go live within 2 weeks for our Starter package. Business-tier sites with teacher profiles, booking systems, and audio/video embeds typically take 3 weeks, while Premium builds with recital calendars, student portals, and multi-location support take 4–5 weeks. We provide a clear timeline before starting so you can plan around your term schedule." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "Music School Website Singapore", "item": "https://jraftcreative.com/music-school-website-singapore/" }
    ]
  }
];
---

<style is:global>
  /* Hide the global background grid pattern on this page only */
  .animated-bg__grid { display: none; }

  /* More-prominent related-service pills — match challenge-card-v2 green treatment */
  #related-services .related-service-link {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.35);
    color: var(--text);
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  #related-services .related-service-link:hover {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.22) 0%, rgba(73, 184, 137, 0.1) 100%), rgba(20, 28, 32, 0.7);
    border-color: rgba(73, 184, 137, 0.6);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(73, 184, 137, 0.3);
  }

  /* Separate the CTA section from related-services with bg-alt */
  .service-cta-section {
    background: var(--bg-alt) !important;
  }

  /* Trial-to-Enrolment Funnel — 5-stage horizontal flow with green accents */
  .renovation-funnel {
    list-style: none;
    padding: 0;
    margin: 56px 0 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 48px;
    counter-reset: funnel;
  }
  .funnel-stage {
    position: relative;
    text-align: center;
    padding: 28px 20px;
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.28);
    border-radius: 12px;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .funnel-stage:hover {
    transform: translateY(-4px);
    border-color: rgba(73, 184, 137, 0.55);
    box-shadow: 0 16px 40px -16px rgba(73, 184, 137, 0.3);
  }
  .funnel-stage h3 {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--accent);
    margin: 0 0 8px 0;
    letter-spacing: -0.01em;
  }
  .funnel-stage p {
    font-size: 0.82rem;
    color: var(--text);
    line-height: 1.5;
    margin: 0;
  }
  .funnel-stage:not(:last-child)::after {
    content: '→';
    position: absolute;
    right: -34px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--accent);
    font-size: 1.6rem;
    font-weight: 500;
    z-index: 2;
    line-height: 1;
    opacity: 0.7;
  }
  @media (max-width: 900px) {
    .renovation-funnel {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }
    .funnel-stage:nth-child(2n)::after,
    .funnel-stage:last-child::after {
      display: none;
    }
    .funnel-stage:nth-child(2n-1)::after {
      right: -22px;
    }
  }
  @media (max-width: 600px) {
    .renovation-funnel {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .funnel-stage::after {
      display: none;
    }
  }
</style>

<ServiceLayout
  title="Music School Website Singapore — Web Design Agency"
  description="Web design agency for music schools and music academies in Singapore — instrument and course pages, teacher profiles, trial lesson booking."
  canonical="https://jraftcreative.com/music-school-website-singapore/"
  ogTitle="Music School Website Singapore — Web Design Agency"
  ogDescription="Custom website design for music schools and music academies in Singapore. Instrument pages, teacher profiles, trial lesson booking, and local SEO."
  ogImage="https://jraftcreative.com/images/og-webdev.jpg"
  keywords="web design agency for music schools, music school website design singapore, music school website singapore, music academy website singapore, piano lesson website singapore, music teacher website design, Jraft Creative"
  schemaData={schemaData}
  heroLabel="Web Design Agency for Music Schools"
  heroTitle='Web Design Agency for <span class="highlight">Music Schools in Singapore</span>'
  heroSubtitle="Students and parents are searching for music schools online before booking a single trial lesson. We build websites that showcase your instruments and courses, highlight your teachers' credentials, and make booking effortless — so you can focus on teaching, not chasing enquiries."
  heroImage="/images/service-musicschool.webp"
  heroImageAlt="Music lesson in a Singapore studio — music school web design"
  heroButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "See Music School SEO", href: "/music-school-seo-singapore/", class: "btn btn-secondary" }
  ]}
  whatsappText="Hi Jraft Creative, I need a website for my music school in Singapore."
  ctaLabel="Ready to Grow Your Music School?"
  ctaTitle="Get Your Music School Online"
  ctaDescription="Tell us about your music school and we'll recommend the right website scope. Free consultation — no obligations, no pressure."
  ctaButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%20need%20a%20website%20for%20my%20music%20school%20in%20Singapore.", class: "btn btn-secondary" }
  ]}
  hideDefaultCta={false}
>

  <!-- ========== THE CHALLENGE ========== -->
  <section class="section" id="challenge" aria-label="Website challenges for music schools in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Challenge</p>
        <h2>Students Are <span class="highlight">Searching</span> — Can They <span class="highlight">Find Your School</span>?</h2>
      </div>
      <div class="section-content reveal">
        <p>Parents compare schools side by side — teachers, schedules, results — long before they ever call or walk in.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>A Facebook Page Isn't Enough</h3>
            <p>Prospective students want instruments, teacher credentials, showcases and lesson slots in one place. A directory listing answers none of it.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Parents Research Thoroughly</h3>
            <p>They compare ABRSM and Trinity results, check recital schedules and read testimonials. Anything missing is a reason to choose someone else.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>First Impressions Decide It</h3>
            <p>From chains to boutique studios, Singapore's music scene is crowded. Your site is what determines whether a parent enquires or scrolls past.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHAT WE BUILD ========== -->
  <section class="section" id="sub-services" style="background: var(--bg-alt);" aria-label="Music school website design services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">What We Build</p>
        <h2>Six <span class="highlight">Pillars</span> of a Music School <span class="highlight">Website</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Every site is built to turn a browsing parent into a booked trial lesson, not just to look good.</p>
      </div>
      <div class="service-details-grid deliver-grid">
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-business-website.webp');">
          <div class="service-detail-card__content">
            <h3>Instrument &amp; Course Pages</h3>
            <p>A page per instrument and programme, covering lesson formats, levels from beginner to diploma, and grading pathways like ABRSM and Trinity.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-landing-page.webp');">
          <div class="service-detail-card__content">
            <h3>Trial Lesson Booking</h3>
            <p>Parents book directly from the site — teacher availability, filtering by instrument, automated confirmations. Fewer phone calls for your front desk.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-local-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Teacher Profiles &amp; Credentials</h3>
            <p>Qualifications, performance background and specialisations, with headshots and audio or video clips that give parents confidence in your team.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-graphic-design.webp');">
          <div class="service-detail-card__content">
            <h3>Recitals, Events &amp; Showcases</h3>
            <p>A calendar for recitals and masterclasses plus an achievement gallery — exam results and competition wins, as proof rather than claims.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-reels-video.webp');">
          <div class="service-detail-card__content">
            <h3>Audio &amp; Video Ready</h3>
            <p>Embedded performance clips and recital videos that load fast on any device, because student work is your strongest selling material.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-speed-vitals.webp');">
          <div class="service-detail-card__content">
            <h3>Search-Ready Foundations</h3>
            <p>Clean structure, fast mobile loads and schema built in from day one, so the site is ready to rank rather than needing rescuing later.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHY US ========== -->
  <section class="section" id="why-us" aria-label="Why choose Jraft Creative as your music school web design agency">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2>A <span class="highlight">Web Design Agency</span> That Knows <span class="highlight">Music Schools</span></h2>
      </div>
      <div class="section-content reveal">
        <p>We build for the specific problem music schools have — competing locally, then converting an enquiry into a term-long enrolment.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Music Industry Experience</h3>
            <p>We've built for music schools, studios and performing arts academies across Singapore, and know what turns a browsing parent into a committed student.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Live Before the Next Term</h3>
            <p>Most music school sites go live within two weeks, so you start capturing bookings before the next intake rather than after it.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Website, SEO &amp; Ads Together</h3>
            <p>We also run <a href="/music-school-seo-singapore/">music school SEO</a> and <a href="/music-school-google-ads-singapore/">Google Ads</a> — one system for filling lesson slots.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== ENROLMENT FUNNEL ========== -->
  <section class="section" id="buyer-funnel" style="background: var(--bg-alt);" aria-label="Where your website fits the music parent journey">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Enrolment Funnel</p>
        <h2>Where Your <span class="highlight">Website</span> Fits the <span class="highlight">Parent Journey</span></h2>
      </div>
      <div class="section-content reveal" style="margin-bottom: 24px;">
        <p>Parents move through the same five stages before a child starts lessons. Your website carries the middle three — it is where a parent validates your teachers, compares you against the shortlist, and finally books the trial.</p>
      </div>
      <ol class="renovation-funnel reveal">
        <li class="funnel-stage">
          <h3>Discover</h3>
          <p>A search or referral brings them to the site</p>
        </li>
        <li class="funnel-stage">
          <h3>Validate</h3>
          <p>Teacher profiles, exam results, student showcases</p>
        </li>
        <li class="funnel-stage">
          <h3>Compare</h3>
          <p>Course pages answer level, format and fit</p>
        </li>
        <li class="funnel-stage">
          <h3>Trial</h3>
          <p>Booking flow turns interest into a scheduled lesson</p>
        </li>
        <li class="funnel-stage">
          <h3>Enrol</h3>
          <p>Sign for the term, renew &amp; refer</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ========== PRICING ========== -->
  <!-- ========== FAQ ========== -->
  <section class="section faq-section" id="faq" style="background: var(--bg-alt);" aria-label="Frequently asked questions about music school website design in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">FAQ</p>
        <h2>Music School <span class="highlight">Website</span> Questions Answered</h2>
      </div>
      <div class="faq-list">
        <details class="faq-item reveal reveal-d1">
          <summary>How much does a music school website cost in Singapore?</summary>
          <div class="faq-answer"><p>Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>Can you add online lesson booking to our music school website?</summary>
          <div class="faq-answer"><p>Yes. Our Business and Premium packages include an online booking system that lets students or parents schedule trial lessons, regular sessions, and makeup classes directly through your website. The system can display teacher availability, filter by instrument type, and send automated confirmation emails — reducing phone calls and admin time for your front desk.</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>How do you showcase teacher profiles and credentials?</summary>
          <div class="faq-answer"><p>Each teacher gets a dedicated profile page featuring their qualifications, performance experience, teaching philosophy, and specialisations. We can include professional headshots, embedded audio or video clips of performances, ABRSM or Trinity certification details, and student testimonials — giving prospective students confidence in your teaching team.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>Can you help our music school rank for "music school near me" on Google?</summary>
          <div class="faq-answer"><p>Yes. We optimise your website for keywords students and parents actually search — like "music school near me", "piano lessons Tampines", or "guitar classes Singapore". This includes on-page SEO, schema markup for music schools, Google Business Profile optimisation, and location-targeted content that helps you rank in local search results and Google Maps.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>How long does it take to build a music school website?</summary>
          <div class="faq-answer"><p>Most music school websites go live within 2 weeks for our Starter package. Business-tier sites with teacher profiles, booking systems, and audio/video embeds typically take 3 weeks, while Premium builds with recital calendars, student portals, and multi-location support take 4-5 weeks. We provide a clear timeline before starting so you can plan around your term schedule.</p></div>
        </details>
      </div>
    </div>
  </section>


  <!-- Related Services -->
  <section class="section" id="related-services" aria-label="Related services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Explore More</p>
        <h2>More <span class="highlight">Music School</span> Services</h2>
      </div>
      <div class="related-services-grid reveal">
          <a href="/music-school-seo-singapore/" class="related-service-link">Music School SEO</a>
          <a href="/music-school-google-ads-singapore/" class="related-service-link">Music School Google Ads</a>
          <a href="/music-school-social-media-singapore/" class="related-service-link">Music School Social Media</a>
      </div>
    </div>
  </section>
</ServiceLayout>
