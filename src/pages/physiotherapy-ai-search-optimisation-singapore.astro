---
import ServiceLayout from '../layouts/ServiceLayout.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "GEO Agency for Physiotherapy Clinics Singapore",
    "description": "GEO and AI search optimisation agency for physiotherapy clinics in Singapore. Get your clinic named when patients ask ChatGPT, Gemini and Google AI Mode for a physiotherapist or a treatment.",
    "provider": {
      "@type": "Organization",
      "name": "Jraft Creative",
      "url": "https://jraftcreative.com/",
      "logo": "https://jraftcreative.com/images/logo.png",
      "telephone": "+6582234578",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "60 Paya Lebar Road, Paya Lebar Square",
        "postalCode": "409051",
        "addressLocality": "Singapore",
        "addressCountry": "SG"
      }
    },
    "areaServed": { "@type": "Country", "name": "Singapore" },
    "serviceType": "Physiotherapy AI Search Optimisation"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "What is GEO for a physiotherapy clinic?", "acceptedAnswer": { "@type": "Answer", "text": "Generative Engine Optimisation is the work of getting your clinic named when a patient asks an AI assistant rather than searching Google. Ask ChatGPT for a sports physio near Novena and you get a shortlist of a few clinics, not ten links. GEO is about being on that list, which depends on different signals from traditional SEO." } },
      { "@type": "Question", "name": "How is this different from the SEO you already do?", "acceptedAnswer": { "@type": "Answer", "text": "SEO earns a ranking position; GEO earns a mention inside a generated answer. Ranking factors still matter, but AI systems lean far more on structured data, entity clarity and how consistently your clinic is described across the web. A clinic can rank well and still never be named by an assistant — that's the gap we close." } },
      { "@type": "Question", "name": "What makes an AI recommend one physiotherapy clinic over another?", "acceptedAnswer": { "@type": "Answer", "text": "Specificity and corroboration. AI systems favour clinics whose treatments, credentials and locations are stated unambiguously and confirmed in more than one place — your site, your Google Business Profile, health directories and third-party mentions. Vague copy gives a model nothing to match a patient's question against." } },
      { "@type": "Question", "name": "Can you show whether it is working?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We monitor prompts a real patient would use — by treatment and neighbourhood — across ChatGPT, Gemini, Perplexity and Google AI Mode, and track whether your clinic appears and how it's described. That gives an AI Visibility Score baseline and a monthly movement report." } },
      { "@type": "Question", "name": "Does this work follow AHPC advertising guidelines?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. The work is about how visible and accurately described your clinic is inside AI answers — structured data, entity clarity and content that is factual. We make no claims about clinical recovery or outcomes, and everything is written with AHPC advertising guidelines in mind." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "GEO Agency for Physiotherapy Clinics Singapore", "item": "https://jraftcreative.com/physiotherapy-ai-search-optimisation-singapore/" }
    ]
  }
];
---

<style is:global>
  /* Hide the global background grid pattern on this page only */
  .animated-bg__grid { display: none; }

  /* More-prominent related-service pills — match challenge-card-v2 green treatment */
  #related-services .related-service-link {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.35);
    color: var(--text);
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  #related-services .related-service-link:hover {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.22) 0%, rgba(73, 184, 137, 0.1) 100%), rgba(20, 28, 32, 0.7);
    border-color: rgba(73, 184, 137, 0.6);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(73, 184, 137, 0.3);
  }
  .service-cta-section { background: var(--bg-alt) !important; }
  .renovation-funnel { list-style: none; padding: 0; margin: 56px 0 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 48px; }
  .funnel-stage { position: relative; text-align: center; padding: 28px 20px; background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6); border: 1px solid rgba(73, 184, 137, 0.28); border-radius: 12px; transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease; }
  .funnel-stage:hover { transform: translateY(-4px); border-color: rgba(73, 184, 137, 0.55); box-shadow: 0 16px 40px -16px rgba(73, 184, 137, 0.3); }
  .funnel-stage h3 { font-size: 1.05rem; font-weight: 600; color: var(--accent); margin: 0 0 8px 0; letter-spacing: -0.01em; }
  .funnel-stage p { font-size: 0.82rem; color: var(--text); line-height: 1.5; margin: 0; }
  .funnel-stage:not(:last-child)::after { content: '→'; position: absolute; right: -34px; top: 50%; transform: translateY(-50%); color: var(--accent); font-size: 1.6rem; font-weight: 500; z-index: 2; line-height: 1; opacity: 0.7; }
  @media (max-width: 900px) { .renovation-funnel { grid-template-columns: repeat(2, 1fr); gap: 32px; } .funnel-stage:nth-child(2n)::after, .funnel-stage:last-child::after { display: none; } .funnel-stage:nth-child(2n-1)::after { right: -22px; } }
  @media (max-width: 600px) { .renovation-funnel { grid-template-columns: 1fr; gap: 20px; } .funnel-stage::after { display: none; } }
</style>

<ServiceLayout
  title="GEO Agency for Physiotherapy Clinics Singapore"
  description="GEO agency for physiotherapy clinics in Singapore — get named when patients ask ChatGPT, Gemini and Google AI Mode for a physio near them."
  canonical="https://jraftcreative.com/physiotherapy-ai-search-optimisation-singapore/"
  ogTitle="GEO Agency for Physiotherapy Clinics Singapore"
  ogDescription="AI search optimisation for Singapore physiotherapy clinics. Get named when patients ask ChatGPT, Gemini and Perplexity for a physio."
  ogImage="https://jraftcreative.com/images/og-physiotherapy.jpg"
  keywords="geo agency for physiotherapy clinics, physiotherapy ai search optimisation singapore, physio chatgpt optimisation, ai search optimisation for physiotherapists, generative engine optimisation physiotherapy, Jraft Creative"
  schemaData={schemaData}
  heroLabel="GEO Agency for Physiotherapy Clinics"
  heroTitle='GEO Agency for <span class="highlight">Physiotherapy Clinics in Singapore</span>'
  heroSubtitle="Patients have started asking AI which physio to see. The answer names two or three clinics — and if yours isn't one of them, you were never in the running. We make physiotherapy clinics the answer AI assistants give."
  heroImage="/images/hero-physiotherapy-poster.jpg"
  heroImageAlt="Physiotherapy clinic in Singapore — ai search optimisation"
  heroButtons={[
    { text: "Get an AI Visibility Audit", href: "/contact/", class: "btn btn-primary" },
    { text: "See Physiotherapy SEO", href: "/physiotherapy-seo-singapore/", class: "btn btn-secondary" }
  ]}
  whatsappText="Hi Jraft Creative, I'd like to know if my physiotherapy clinic shows up in AI search."
  ctaLabel="Be the Answer"
  ctaTitle="Find Out What AI Says About Your Clinic"
  ctaDescription="Book a free consultation and we'll run the prompts a real patient would use — by treatment and neighbourhood — across ChatGPT, Gemini and Perplexity, and show you exactly where your clinic currently stands. We'll get back to you within 24 hours."
  ctaButtons={[
    { text: "Get an AI Visibility Audit", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%27d%20like%20to%20know%20if%20my%20physiotherapy%20clinic%20shows%20up%20in%20AI%20search.", class: "btn btn-secondary" }
  ]}
  hideDefaultCta={false}
>

  <!-- ========== THE CHALLENGE ========== -->
  <section class="section" id="challenge" aria-label="AI Search Optimisation challenges for physiotherapy clinics in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Challenge</p>
        <h2>Patients Are Asking <span class="highlight">AI</span> for a Physio — and It Names <span class="highlight">Two or Three</span></h2>
      </div>
      <div class="section-content reveal">
        <p>A generated answer has no page two. Either your clinic is on the shortlist an assistant gives, or it does not exist to that patient.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Ranking Well Isn't Enough</h3>
            <p>A clinic can sit on page one of Google and never be mentioned by ChatGPT. AI systems weigh structured data and entity clarity, not just position.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Vague Copy Gives AI Nothing</h3>
            <p>'Physiotherapy for the whole family' can't be matched to 'sports physio near Novena' or 'post-ACL rehab in Tanjong Pagar'. Specificity is what gets you cited.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>The Lane Is Still Open</h3>
            <p>Almost no Singapore physiotherapy clinic has done this work. The bar is far lower than it has been in Google search for a decade — for now.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHAT WE DELIVER ========== -->
  <section class="section" id="sub-services" style="background: var(--bg-alt);" aria-label="AI Search Optimisation services for physiotherapy clinics">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">What We Deliver</p>
        <h2>Six <span class="highlight">GEO Workstreams</span> for Physiotherapy <span class="highlight">Clinics</span></h2>
      </div>
      <div class="section-content reveal">
        <p>We make your treatments, credentials and locations unambiguous to a machine — then prove it moved. This is the AI-search layer that sits alongside our <a href="/physiotherapy-seo-singapore/">physiotherapy SEO</a>, <a href="/physiotherapy-website-singapore/">clinic website</a> and <a href="/physiotherapy-social-media-singapore/">social media</a> work.</p>
      </div>
      <div class="service-details-grid deliver-grid">
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-seo-audit.webp');">
          <div class="service-detail-card__content">
            <h3>AI Visibility Audit</h3>
            <p>We run the prompts patients actually use across ChatGPT, Gemini and Perplexity, and record whether you appear and how you're described — the baseline for your AI Visibility Score.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-onpage-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Physio Schema &amp; Entities</h3>
            <p>LocalBusiness and FAQ structured data for your clinic, each treatment and every physiotherapist — so services, credentials and locations are machine-readable facts, not prose.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-content-strategy.webp');">
          <div class="service-detail-card__content">
            <h3>Answer-Engine Content</h3>
            <p>Pages that answer real patient questions directly — sports injury assessment, post-surgery rehab, lower back pain — as clear, extractable Q&amp;A in the form models quote back.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-ai.webp');">
          <div class="service-detail-card__content">
            <h3>Credential &amp; Trust Authority</h3>
            <p>Physiotherapist qualifications, specialisations and affiliations corroborated across your site, your profile, health directories and review sites — the checks an assistant makes.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-local-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Multi-Branch Location Data</h3>
            <p>Each clinic as its own entity — Novena, Orchard, Tampines, Jurong — so a neighbourhood question returns your branch rather than a competitor down the road.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-campaign-analytics.webp');">
          <div class="service-detail-card__content">
            <h3>Query-Bank Monitoring</h3>
            <p>A tracked set of treatment and neighbourhood prompts, re-run monthly, so mention rate and citation rate are measured rather than asserted.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHY US ========== -->
  <section class="section" id="why-us" aria-label="Why choose Jraft Creative for physiotherapy ai search optimisation">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2>A <span class="highlight">GEO Agency</span> That Has Been <span class="highlight">Cited Itself</span></h2>
      </div>
      <div class="section-content reveal">
        <p>We practise this on our own site and publish the method rather than keeping it a black box. If you want the plain-English version first, read <a href="/blog/what-is-geo-ai-search-optimisation/">what GEO and AI search optimisation actually is</a>. This page sits under our wider <a href="/industries/healthcare/">healthcare marketing in Singapore</a> work.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>We've Earned AI Citations</h3>
            <p>We wrote up <a href="/blog/how-we-got-cited-in-google-ai-overview-singapore/">how we got cited in Google's AI Overview</a> for niche Singapore queries — method, not marketing.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>We Already Run Physio Search</h3>
            <p>We handle <a href="/physiotherapy-seo-singapore/">physiotherapy SEO</a> and <a href="/physiotherapy-google-ads-singapore/">Google Ads</a>, so we know which patient questions precede a booking.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Measured, Not Claimed</h3>
            <p>Baseline first, monthly query-bank re-runs after. If your AI visibility hasn't moved, the report says so — see our <a href="/geo-agency-singapore/">GEO programme</a>.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== PATIENT JOURNEY FUNNEL ========== -->
  <section class="section" id="buyer-funnel" style="background: var(--bg-alt);" aria-label="Where ai search optimisation fits the patient journey">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Patient Journey</p>
        <h2>Where <span class="highlight">AI Search</span> Fits the <span class="highlight">Patient Journey</span></h2>
      </div>
      <div class="section-content reveal" style="margin-bottom: 24px;">
        <p>AI has moved to the very front of the journey. Where a patient once opened Google and browsed a list, many now ask an assistant for a shortlist — which means Discover is decided before your website is ever visited.</p>
      </div>
      <ol class="renovation-funnel reveal">
        <li class="funnel-stage"><h3>Ask</h3><p>A patient asks an AI which physio to see</p></li>
        <li class="funnel-stage"><h3>Shortlist</h3><p>Two or three clinics get named — or you don't</p></li>
        <li class="funnel-stage"><h3>Validate</h3><p>They check reviews, credentials and location</p></li>
        <li class="funnel-stage"><h3>Book</h3><p>The shortlist turns into a booked appointment</p></li>
        <li class="funnel-stage"><h3>Treat</h3><p>A good first visit, then follow-ups &amp;amp; referrals</p></li>
      </ol>
    </div>
  </section>

  <!-- ========== FAQ ========== -->
  <section class="section faq-section" id="faq" style="background: var(--bg-alt);" aria-label="Frequently asked questions about physiotherapy ai search optimisation">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">FAQ</p>
        <h2>Physiotherapy GEO — Questions Answered</h2>
      </div>
      <div class="faq-list">
        <details class="faq-item reveal reveal-d1">
          <summary>What is GEO for a physiotherapy clinic?</summary>
          <div class="faq-answer"><p>Generative Engine Optimisation is the work of getting your clinic named when a patient asks an AI assistant rather than searching Google. Ask ChatGPT for a sports physio near Novena and you get a shortlist of a few clinics, not ten links. GEO is about being on that list, which depends on different signals from traditional SEO.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>How is this different from the SEO you already do?</summary>
          <div class="faq-answer"><p>SEO earns a ranking position; GEO earns a mention inside a generated answer. Ranking factors still matter, but AI systems lean far more on structured data, entity clarity and how consistently your clinic is described across the web. A clinic can rank well and still never be named by an assistant — that's the gap we close.</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>What makes an AI recommend one physiotherapy clinic over another?</summary>
          <div class="faq-answer"><p>Specificity and corroboration. AI systems favour clinics whose treatments, credentials and locations are stated unambiguously and confirmed in more than one place — your site, your Google Business Profile, health directories and third-party mentions. Vague copy gives a model nothing to match a patient's question against.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>Can you show whether it is working?</summary>
          <div class="faq-answer"><p>Yes. We monitor prompts a real patient would use — by treatment and neighbourhood, from "sports physio in Singapore" to "physio for lower back pain near me" — across ChatGPT, Gemini, Perplexity and Google AI Mode, and track whether your clinic appears and how it's described. That gives an AI Visibility Score baseline and a monthly movement report covering mention rate and citation rate.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>Does this work follow AHPC advertising guidelines?</summary>
          <div class="faq-answer"><p>Yes. The work is about how visible and accurately described your clinic is inside AI answers — structured data, entity clarity and content that stays factual. We make no claims about clinical recovery or outcomes, only about your visibility in AI search, and everything is written with AHPC advertising guidelines in mind.</p></div>
        </details>
      </div>
    </div>
  </section>

  <!-- Related Services -->
  <section class="section" id="related-services" aria-label="Related services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Explore More</p>
        <h2>More <span class="highlight">Physiotherapy Clinic</span> Services</h2>
      </div>
      <div class="related-services-grid reveal">
          <a href="/physiotherapy-marketing-singapore/" class="related-service-link">Physiotherapy Marketing</a>
          <a href="/physiotherapy-seo-singapore/" class="related-service-link">Physiotherapy SEO</a>
          <a href="/physiotherapy-google-ads-singapore/" class="related-service-link">Physiotherapy Google Ads</a>
          <a href="/physiotherapy-social-media-singapore/" class="related-service-link">Physiotherapy Social Media</a>
          <a href="/physiotherapy-branding-singapore/" class="related-service-link">Physiotherapy Branding</a>
          <a href="/physiotherapy-website-singapore/" class="related-service-link">Physiotherapy Websites</a>
      </div>
    </div>
  </section>
</ServiceLayout>
