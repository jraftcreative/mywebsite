---
import ServiceLayout from '../layouts/ServiceLayout.astro';
import RelatedServices from '../components/RelatedServices.astro';
import MarketingFunnelBlock from '../components/MarketingFunnelBlock.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Dental Website Design Singapore",
    "description": "Professional website design for dental clinics in Singapore. Treatment pages, before/after galleries, and online appointment booking — custom-quoted to your scope.",
    "provider": {
      "@type": "Organization",
      "name": "Jraft Creative",
      "url": "https://jraftcreative.com/",
      "logo": "https://jraftcreative.com/images/logo.png",
      "telephone": "+6582234578",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "60 Paya Lebar Road, Paya Lebar Square",
        "postalCode": "409051",
        "addressLocality": "Singapore",
        "addressCountry": "SG"
      }
    },
    "areaServed": { "@type": "Country", "name": "Singapore" },
    "serviceType": "Dental Clinic Website Design"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How much does a dental clinic website cost in Singapore?", "acceptedAnswer": { "@type": "Answer", "text": "Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote." } },
      { "@type": "Question", "name": "Do dental websites need to follow MOH advertising guidelines?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. The Ministry of Health (MOH) and Singapore Dental Council have strict advertising guidelines for dental services. We ensure your website complies with these regulations — avoiding prohibited claims, using approved terminology, and including required disclaimers where necessary." } },
      { "@type": "Question", "name": "Can you integrate online appointment booking into my dental website?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We offer online appointment booking integration on most projects. Patients can select a dentist, choose a treatment type, pick an available time slot, and receive automated confirmation — reducing phone calls and no-shows for your clinic." } },
      { "@type": "Question", "name": "Can you build a before/after gallery for dental treatments?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Before/after galleries are one of the most effective features for dental websites. We build filterable galleries organised by treatment type — such as teeth whitening, veneers, or Invisalign — with proper patient consent workflows and MOH-compliant presentation." } },
      { "@type": "Question", "name": "How long does it take to build a dental clinic website?", "acceptedAnswer": { "@type": "Answer", "text": "Most dental clinic websites go live within 2–3 weeks. A simple 5-page site can be ready in as little as 2 weeks, while larger projects with online booking, before/after galleries, or multi-location features may take 3–4 weeks. We provide a clear timeline before starting." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "Dental Website Design Singapore", "item": "https://jraftcreative.com/dental-website-design-singapore/" }
    ]
  }
];
---

<style is:global>
  /* Hide the global background grid pattern on this page only */
  .animated-bg__grid { display: none; }

  /* More-prominent related-service pills — match challenge-card-v2 green treatment */
  #related-services .related-service-link {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.35);
    color: var(--text);
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  #related-services .related-service-link:hover {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.22) 0%, rgba(73, 184, 137, 0.1) 100%), rgba(20, 28, 32, 0.7);
    border-color: rgba(73, 184, 137, 0.6);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(73, 184, 137, 0.3);
  }
  .service-cta-section { background: var(--bg-alt) !important; }
  .renovation-funnel { list-style: none; padding: 0; margin: 56px 0 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 48px; }
  .funnel-stage { position: relative; text-align: center; padding: 28px 20px; background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6); border: 1px solid rgba(73, 184, 137, 0.28); border-radius: 12px; transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease; }
  .funnel-stage:hover { transform: translateY(-4px); border-color: rgba(73, 184, 137, 0.55); box-shadow: 0 16px 40px -16px rgba(73, 184, 137, 0.3); }
  .funnel-stage h3 { font-size: 1.05rem; font-weight: 600; color: var(--accent); margin: 0 0 8px 0; letter-spacing: -0.01em; }
  .funnel-stage p { font-size: 0.82rem; color: var(--text); line-height: 1.5; margin: 0; }
  .funnel-stage:not(:last-child)::after { content: '→'; position: absolute; right: -34px; top: 50%; transform: translateY(-50%); color: var(--accent); font-size: 1.6rem; font-weight: 500; z-index: 2; line-height: 1; opacity: 0.7; }
  @media (max-width: 900px) { .renovation-funnel { grid-template-columns: repeat(2, 1fr); gap: 32px; } .funnel-stage:nth-child(2n)::after, .funnel-stage:last-child::after { display: none; } .funnel-stage:nth-child(2n-1)::after { right: -22px; } }
  @media (max-width: 600px) { .renovation-funnel { grid-template-columns: 1fr; gap: 20px; } .funnel-stage::after { display: none; } }
</style>

<ServiceLayout
  title="Dental Clinic Website — Web Design Agency"
  description="Custom websites for Singapore dental clinics — online booking, treatment pages, MOH-compliant, mobile-first. Live in 2–3 weeks. Custom-quoted to your scope."
  canonical="https://jraftcreative.com/dental-website-design-singapore/"
  ogTitle="Dental Clinic Website — Web Design Agency"
  ogDescription="Custom websites for Singapore dental clinics — online booking, treatment pages, MOH-compliant, mobile-first. Live in 2–3 weeks. Custom-quoted to your scope."
  ogImage="https://jraftcreative.com/images/og-webdev.jpg"
  keywords="dental website design singapore, dental clinic website singapore, dentist website design, dental web design singapore, dental clinic web design, dental digital marketing singapore, Jraft Creative"
  schemaData={schemaData}
  heroLabel="Web Design Agency for Dental Clinics"
  heroTitle='Web Design Agency for <span class="highlight">Dental Clinics in Singapore</span>'
  heroSubtitle="Your clinic needs more than a basic listing. We build fast, mobile-friendly websites for dental practices — with treatment pages, before/after galleries, online appointment booking, and full MOH compliance built in."
  heroImage="/images/service-dental.webp"
  heroButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "See Our Work", href: "/services/website-development/#portfolio", class: "btn btn-secondary" }
  ]}
  whatsappText="Hi Jraft Creative, I need a website for my dental clinic in Singapore."
  ctaLabel="Ready to Get Started?"
  ctaTitle="Get Your Dental Clinic Online"
  ctaDescription="Book a free consultation and tell us about your dental practice. We'll get back to you within 24 hours with a tailored proposal."
  ctaButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%20need%20a%20website%20for%20my%20dental%20clinic%20in%20Singapore.", class: "btn btn-secondary" }
  ]}
  hideDefaultCta={false}
>

  <!-- ========== THE CHALLENGE ========== -->
  <section class="section" id="challenge" aria-label="Why dental clinics need a proper website">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Challenge</p>
        <h2>Patients Are Choosing Their Dentist <span class="highlight">Online</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Most patients compare two or three clinics online before booking. Your website is the first impression, and it has to build trust in minutes.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>An Outdated Site Loses Patients</h3>
            <p>If your website is dated, hard to navigate, or invisible on Google, patients quietly choose the clinic that invested in theirs.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Patients Want Proof, Then Booking</h3>
            <p>Before committing to veneers, Invisalign or implants, patients want to see results and book without calling during office hours.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Compliance Is Non-Negotiable</h3>
            <p>Your site must meet SDC and MOH advertising rules — no prohibited claims, no misleading language. A generic agency won't know them; we do.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHAT WE BUILD ========== -->
  <section class="section" id="sub-services" style="background: var(--bg-alt);" aria-label="Dental clinic website design services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">What We Build</p>
        <h2>Six <span class="highlight">Pillars</span> of a Dental Clinic <span class="highlight">Website</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Every element is built around patient trust and booking — structured for how patients actually choose a dentist.</p>
      </div>
      <div class="service-details-grid deliver-grid">
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-business-website.webp');">
          <div class="service-detail-card__content">
            <h3>Treatment Pages</h3>
            <p>A dedicated page per treatment — general dentistry, orthodontics, implants, whitening — with clear descriptions and a clear next step.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-landing-page.webp');">
          <div class="service-detail-card__content">
            <h3>Before/After Galleries</h3>
            <p>Filterable galleries by treatment — veneers, Invisalign, whitening — presented in a clean, MOH-compliant format that builds confidence.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-local-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Online Appointment Booking</h3>
            <p>Patients book directly — dentist, treatment and time slot — with automated confirmations that cut no-shows and free the front desk.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-graphic-design.webp');">
          <div class="service-detail-card__content">
            <h3>Dentist Profiles &amp; Credentials</h3>
            <p>Profile pages per dentist — qualifications, specialisations and a personal bio — because patients want to know who will treat them.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-onpage-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Search-Ready Foundations</h3>
            <p>Clean structure, schema and fast mobile loads built in, so the site can rank for treatment searches rather than needing rescuing later.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-speed-vitals.webp');">
          <div class="service-detail-card__content">
            <h3>Mobile-First &amp; Fast</h3>
            <p>Patients search on their phones, often in discomfort. Every page is built mobile-first, fast, with tap-to-call and tap-to-book.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHY US ========== -->
  <section class="section" id="why-us" aria-label="Why choose Jraft Creative for dental website design">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2>A <span class="highlight">Web Design Agency</span> That Knows <span class="highlight">Dental Trust</span></h2>
      </div>
      <div class="section-content reveal">
        <p>A site compelling enough to attract patients, detailed enough to answer them, and compliant enough to keep your practice safe.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Healthcare Website Experience</h3>
            <p>We understand SDC and MOH advertising rules, patient-privacy considerations and the trust signals — credentials, reviews, compliant content — that matter in healthcare.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Live Before You Open</h3>
            <p>Most dental sites go live within two to three weeks, so a new practice or a refreshed brand is working when you need it.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Website, SEO &amp; Ads Together</h3>
            <p>We also run <a href="/dental-seo-singapore/">dental SEO</a> and <a href="/dental-google-ads-singapore/">Google Ads</a> — one agency for the clinic's whole online presence.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== PATIENT JOURNEY FUNNEL ========== -->
  <section class="section" id="buyer-funnel" style="background: var(--bg-alt);" aria-label="Where your website fits the patient journey">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Patient Journey</p>
        <h2>Where Your <span class="highlight">Website</span> Fits the <span class="highlight">Patient Journey</span></h2>
      </div>
      <div class="section-content reveal" style="margin-bottom: 24px;">
        <p>A dental patient moves through five stages before booking. Your website carries the middle three — it is where they research the treatment, compare you against other clinics, and finally book.</p>
      </div>
      <ol class="renovation-funnel reveal">
        <li class="funnel-stage"><h3>Discover</h3><p>A search or referral brings them to the site</p></li>
        <li class="funnel-stage"><h3>Research</h3><p>Treatment pages and dentist profiles answer it</p></li>
        <li class="funnel-stage"><h3>Compare</h3><p>Results and reviews weigh you against others</p></li>
        <li class="funnel-stage"><h3>Book</h3><p>Online booking turns interest into an appointment</p></li>
        <li class="funnel-stage"><h3>Treat</h3><p>A good first visit, then recalls &amp; referrals</p></li>
      </ol>
    </div>
  </section>

  <!-- ========== FAQ ========== -->
  <section class="section faq-section" id="faq" style="background: var(--bg-alt);" aria-label="Frequently asked questions about dental website design in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">FAQ</p>
        <h2>Dental <span class="highlight">Website</span> Questions Answered</h2>
      </div>
      <div class="faq-list">
        <details class="faq-item reveal reveal-d1">
          <summary>How much does a dental clinic website cost in Singapore?</summary>
          <div class="faq-answer"><p>Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>Do dental websites need to follow MOH advertising guidelines?</summary>
          <div class="faq-answer"><p>Yes. The Ministry of Health (MOH) and Singapore Dental Council have strict advertising guidelines for dental services. We ensure your website complies with these regulations — avoiding prohibited claims, using approved terminology, and including required disclaimers where necessary.</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>Can you integrate online appointment booking into my dental website?</summary>
          <div class="faq-answer"><p>Yes. We offer online appointment booking integration on most projects. Patients can select a dentist, choose a treatment type, pick an available time slot, and receive automated confirmation — reducing phone calls and no-shows for your clinic.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>Can you build a before/after gallery for dental treatments?</summary>
          <div class="faq-answer"><p>Yes. Before/after galleries are one of the most effective features for dental websites. We build filterable galleries organised by treatment type — such as teeth whitening, veneers, or Invisalign — with proper patient consent workflows and MOH-compliant presentation.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>How long does it take to build a dental clinic website?</summary>
          <div class="faq-answer"><p>Most dental clinic websites go live within 2–3 weeks. A simple 5-page site can be ready in as little as 2 weeks, while larger projects with online booking, before/after galleries, or multi-location features may take 3–4 weeks. We provide a clear timeline before starting.</p></div>
        </details>
      </div>
    </div>
  </section>


  <section class="section" id="related-services" aria-label="Related services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Explore More</p>
        <h2>More <span class="highlight">Dental Clinic</span> Services</h2>
      </div>
      <div class="related-services-grid reveal">
          <a href="/dental-seo-singapore/" class="related-service-link">Dental SEO</a>
          <a href="/dental-google-ads-singapore/" class="related-service-link">Dental Google Ads</a>
          <a href="/dental-social-media-singapore/" class="related-service-link">Dental Social Media</a>
          <a href="/dental-marketing-singapore/" class="related-service-link">Full-Service Dental Marketing</a>
          <a href="/dental-branding-singapore/" class="related-service-link">Dental Branding</a>
          <a href="/dental-ai-search-optimisation-singapore/" class="related-service-link">Dental GEO / AI Search</a>
      </div>
    </div>
  </section>

  <MarketingFunnelBlock
    industry="dental practice"
    marketingHref="/dental-marketing-singapore/"
    outcomeLine="See how we'd bring in new patients — MOH-compliant"
    ctaText="Dental Marketing Singapore"
  />

</ServiceLayout>
