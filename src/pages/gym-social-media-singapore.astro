---
import ServiceLayout from '../layouts/ServiceLayout.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Gym Social Media Singapore",
    "description": "Social media marketing for gyms and fitness studios in Singapore — Instagram and TikTok content, workout reels, trainer and member stories, and community management that fills classes and memberships.",
    "provider": {
      "@type": "Organization",
      "name": "Jraft Creative",
      "url": "https://jraftcreative.com/",
      "logo": "https://jraftcreative.com/images/logo.png",
      "telephone": "+6582234578",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "60 Paya Lebar Road, Paya Lebar Square",
        "postalCode": "409051",
        "addressLocality": "Singapore",
        "addressCountry": "SG"
      }
    },
    "areaServed": { "@type": "Country", "name": "Singapore" },
    "serviceType": "Gym Social Media Marketing"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "What content works best for a gym?", "acceptedAnswer": { "@type": "Answer", "text": "Short-form video is the winner — workout clips, form tips, class energy, and trainer moments. It shows the atmosphere and intensity people are choosing between gyms on, and it's what Instagram and TikTok push hardest right now." } },
      { "@type": "Question", "name": "Do my trainers need to be on camera?", "acceptedAnswer": { "@type": "Answer", "text": "It helps, but it's not required. Trainer personalities build a strong pull, yet plenty of high-performing content features the floor, the equipment, class energy, and members who've given permission. We can work either way and build around who's comfortable." } },
      { "@type": "Question", "name": "Instagram or TikTok for a gym in Singapore?", "acceptedAnswer": { "@type": "Answer", "text": "Both, tuned to each. Instagram is where people research and message to book a trial. TikTok is the discovery channel that puts your gym in front of people who've never heard of you. We usually run both and cut each clip for the platform." } },
      { "@type": "Question", "name": "How often will you post?", "acceptedAnswer": { "@type": "Answer", "text": "We set a consistent cadence that fits your goals and keeps the account active without burning out the content. The exact frequency is agreed in your plan — consistency and quality matter more than raw volume." } },
      { "@type": "Question", "name": "Can you use our members in content?", "acceptedAnswer": { "@type": "Answer", "text": "Only with their permission. Member transformation stories and class footage are used with documented consent, and we can create strong content around trainers, the facility, and branded graphics when members prefer not to appear." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "Gym Social Media Singapore", "item": "https://jraftcreative.com/gym-social-media-singapore/" }
    ]
  }
];
---

<style is:global>
  .animated-bg__grid { display: none; }

  #related-services .related-service-link {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.35);
    color: var(--text);
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  #related-services .related-service-link:hover {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.22) 0%, rgba(73, 184, 137, 0.1) 100%), rgba(20, 28, 32, 0.7);
    border-color: rgba(73, 184, 137, 0.6);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(73, 184, 137, 0.3);
  }

  .service-cta-section { background: var(--bg-alt) !important; }

  #sub-services .deliver-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }
  @media (max-width: 900px) { #sub-services .deliver-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { #sub-services .deliver-grid { grid-template-columns: 1fr; } }

  .renovation-funnel {
    list-style: none;
    padding: 0;
    margin: 56px 0 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 48px;
    counter-reset: funnel;
  }
  .funnel-stage {
    position: relative;
    text-align: center;
    padding: 28px 20px;
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.28);
    border-radius: 12px;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .funnel-stage:hover {
    transform: translateY(-4px);
    border-color: rgba(73, 184, 137, 0.55);
    box-shadow: 0 16px 40px -16px rgba(73, 184, 137, 0.3);
  }
  .funnel-stage h3 { font-size: 1.05rem; font-weight: 600; color: var(--accent); margin: 0 0 8px 0; letter-spacing: -0.01em; }
  .funnel-stage p { font-size: 0.82rem; color: var(--text); line-height: 1.5; margin: 0; }
  .funnel-stage:not(:last-child)::after {
    content: '→';
    position: absolute;
    right: -34px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--accent);
    font-size: 1.6rem;
    font-weight: 500;
    z-index: 2;
    line-height: 1;
    opacity: 0.7;
  }
  @media (max-width: 900px) {
    .renovation-funnel { grid-template-columns: repeat(2, 1fr); gap: 32px; }
    .funnel-stage:nth-child(2n)::after, .funnel-stage:last-child::after { display: none; }
    .funnel-stage:nth-child(2n-1)::after { right: -22px; }
  }
  @media (max-width: 600px) {
    .renovation-funnel { grid-template-columns: 1fr; gap: 20px; }
    .funnel-stage::after { display: none; }
  }
</style>

<ServiceLayout
  title="Gym Social Media Singapore — Jraft Creative"
  description="Social media for gyms in Singapore — Instagram and TikTok content, workout reels, and community management that fill classes and memberships."
  canonical="https://jraftcreative.com/gym-social-media-singapore/"
  ogTitle="Gym Social Media Singapore — Jraft Creative"
  ogDescription="Instagram and TikTok content for gyms in Singapore. Workout reels, trainer and member stories, and community management that turn followers into trials and memberships."
  ogImage="https://jraftcreative.com/images/og-gym.jpg"
  keywords="gym social media singapore, fitness studio instagram marketing, gym tiktok singapore, gym content creation, workout reels singapore, fitness social media marketing, Jraft Creative"
  schemaData={schemaData}
  heroLabel="Gym Social Media"
  heroTitle='Social Media for <span class="highlight">Gyms &amp; Studios in Singapore</span>'
  heroSubtitle="People pick a gym on the energy and community they can feel before they walk in, and Instagram and TikTok are where that impression is made. We create content that captures your floor, your trainers, and your members — and turns followers into trials and memberships."
  heroImage="/images/service-gym.webp"
  heroButtons={[
    { text: "Get a Free Content Plan", href: "/contact/", class: "btn btn-primary" },
    { text: "See How We Work", href: "/process/", class: "btn btn-secondary" }
  ]}
  whatsappText="Hi Jraft Creative, I need social media content for my gym in Singapore."
  ctaLabel="Ready to Fill Your Floor?"
  ctaTitle='Get a Free <span class="highlight">Gym Content Plan</span>'
  ctaDescription="Book a free consultation and we'll show you the content pillars, formats, and cadence that will grow your gym's following — and turn it into trials and memberships. No obligations."
  ctaButtons={[
    { text: "Get a Free Content Plan", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%20need%20social%20media%20content%20for%20my%20gym%20in%20Singapore.", class: "btn btn-secondary" }
  ]}
>

  <!-- ========== THE CHALLENGE ========== -->
  <section class="section" id="challenge" aria-label="Why gyms need social media in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Challenge</p>
        <h2>Posting a Lot, <span class="highlight">Filling Little</span>?</h2>
      </div>
      <div class="section-content reveal">
        <p>A gym lives on energy, and there is no better place to show it than short-form video — but a busy feed isn't the same as a full floor. Members in Tanjong Pagar or Tampines have a dozen options within one MRT stop, and the content that wins them looks and works differently from content that just fills a grid.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>A Feed That Looks Like Every Other Gym</h3>
            <p>Stock motivation tiles and dumbbell shots that could belong to any chain. Sameness gets scrolled past — nothing about it says why someone should train with you over the box down the road.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Likes That Don't Fill Classes</h3>
            <p>Reach and likes feel good but don't put people on the floor. Content that isn't built to drive a trial — with a reason and a way to book — is just decoration.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>No Time to Post Consistently</h3>
            <p>Coaching classes back to back leaves no time to shoot, edit, caption, and reply. The account goes quiet — and quiet accounts don't grow or get found.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHAT WE MAKE ========== -->
  <section class="section" id="sub-services" style="background: var(--bg-alt);" aria-label="Social media services for gyms">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">What We Make</p>
        <h2>Content Built to <span class="highlight">Fill Your Floor</span></h2>
      </div>
      <div class="section-content reveal">
        <p>End-to-end social, from strategy to the last caption — planned around your classes, trainers, and community, and made to earn the save, the send, and the trial booking. It pairs naturally with your <a href="/gym-website-design-singapore/">gym website</a>, <a href="/gym-seo-singapore/">local SEO</a>, and <a href="/gym-google-ads-singapore/">Google Ads</a> so the whole funnel pulls in one direction.</p>
      </div>
      <div class="service-details-grid deliver-grid">
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-content-strategy.webp');">
          <div class="service-detail-card__content">
            <h3>Content Strategy &amp; Planning</h3>
            <p>A monthly plan with a real angle — pillar themes, platform-specific formats, and a calendar built around your classes, challenges, and community, not posting for the sake of it.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-reels-video.webp');">
          <div class="service-detail-card__content">
            <h3>Workout Reels &amp; Short-Form Video</h3>
            <p>Workout clips, class energy, form tips, and trainer moments — shot and edited to stop the scroll in the first second and hold it. The format that wins reach in Singapore.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-graphic-design.webp');">
          <div class="service-detail-card__content">
            <h3>Graphic Design &amp; Visuals</h3>
            <p>Class-schedule tiles, challenge graphics, and stories that look unmistakably like your gym — a recognisable brand in the feed, not another lookalike template.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-community-mgmt.webp');">
          <div class="service-detail-card__content">
            <h3>Community Management</h3>
            <p>Replies, DMs, and comment moderation that turn a following into a community — and answer the "how do I book a trial?" questions that quietly convert.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHY CHOOSE US ========== -->
  <section class="section" id="why-us" aria-label="Why choose Jraft Creative for gym social media">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2>Content People Watch — <span class="highlight">Built to Sell</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Plenty of agencies fill a feed. We do the rarer thing — content members actually want to watch, made and measured to bring trials and sign-ups, not just likes.</p>
      </div>
      <div class="service-details-grid" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Content That's Measured</h3>
            <p>We make content people want to watch, then judge it on saves, sends, and enquiries — the signals that actually predict trials and memberships, not vanity likes.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>One In-House Team</h3>
            <p>Strategy, filming, editing, design, and captions under one roof — consistent, on-brand, and no chasing three different freelancers for one post.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Built for How SG Scrolls</h3>
            <p>We know what performs for a Singapore fitness audience — the formats, hooks, and timing tuned to the feed your members actually use every day.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== SOCIAL FLOW ========== -->
  <section class="section" id="social-flow" style="background: var(--bg-alt);" aria-label="How gym social media works">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">How It Works</p>
        <h2>From <span class="highlight">Quiet Feed</span> to <span class="highlight">Full Classes</span></h2>
      </div>
      <div class="section-content reveal" style="margin-bottom: 24px;">
        <p>A simple monthly rhythm that keeps your gym visible, consistent, and growing — without adding to your trainers' workload.</p>
      </div>
      <ol class="renovation-funnel reveal">
        <li class="funnel-stage">
          <h3>Plan</h3>
          <p>Content pillars and monthly calendar</p>
        </li>
        <li class="funnel-stage">
          <h3>Create</h3>
          <p>Reels, statics, and captions produced</p>
        </li>
        <li class="funnel-stage">
          <h3>Publish</h3>
          <p>Posted consistently, at the right times</p>
        </li>
        <li class="funnel-stage">
          <h3>Report</h3>
          <p>Saves, sends, and enquiries tracked</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ========== FAQ ========== -->
  <section class="section faq-section" id="faq" aria-label="Frequently asked questions about gym social media in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">FAQ</p>
        <h2><span class="highlight">Gym Social Media</span> — Questions <span class="highlight">Answered</span></h2>
      </div>
      <div class="faq-list">
        <details class="faq-item reveal reveal-d1">
          <summary>What content works best for a gym?</summary>
          <div class="faq-answer"><p>Short-form video is the winner — workout clips, form tips, class energy, and trainer moments. It shows the atmosphere and intensity people are choosing between gyms on, and it's what Instagram and TikTok push hardest right now.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>Do my trainers need to be on camera?</summary>
          <div class="faq-answer"><p>It helps, but it's not required. Trainer personalities build a strong pull, yet plenty of high-performing content features the floor, the equipment, class energy, and members who've given permission. We can work either way and build around who's comfortable.</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>Instagram or TikTok for a gym in Singapore?</summary>
          <div class="faq-answer"><p>Both, tuned to each. Instagram is where people research and message to book a trial. TikTok is the discovery channel that puts your gym in front of people who've never heard of you. We usually run both and cut each clip for the platform.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>How often will you post?</summary>
          <div class="faq-answer"><p>We set a consistent cadence that fits your goals and keeps the account active without burning out the content. The exact frequency is agreed in your plan — consistency and quality matter more than raw volume.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>Can you use our members in content?</summary>
          <div class="faq-answer"><p>Only with their permission. Member transformation stories and class footage are used with documented consent, and we can create strong content around trainers, the facility, and branded graphics when members prefer not to appear.</p></div>
        </details>
      </div>
    </div>
  </section>


  <!-- Related Services -->
  <section class="section" id="related-services" aria-label="Related services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Explore More</p>
        <h2>More Gym Services</h2>
      </div>
      <div class="related-services-grid reveal">
          <a href="/gym-marketing-singapore/" class="related-service-link">Gym Marketing</a>
          <a href="/gym-seo-singapore/" class="related-service-link">Gym SEO</a>
          <a href="/gym-ai-search-optimisation-singapore/" class="related-service-link">Gym GEO</a>
          <a href="/gym-google-ads-singapore/" class="related-service-link">Gym Google Ads</a>
          <a href="/gym-branding-singapore/" class="related-service-link">Gym Branding</a>
          <a href="/gym-website-design-singapore/" class="related-service-link">Gym Websites</a>
      </div>
    </div>
  </section>
</ServiceLayout>
