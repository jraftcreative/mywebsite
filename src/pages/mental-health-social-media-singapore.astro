---
import ServiceLayout from '../layouts/ServiceLayout.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Social Media Agency for Mental Health Practices Singapore",
    "description": "Social media agency for mental health practices in Singapore. Psychoeducation, therapist introductions and community management that build trust, gently reduce stigma and encourage a first enquiry — within AHPC guidelines.",
    "provider": {
      "@type": "Organization",
      "name": "Jraft Creative",
      "url": "https://jraftcreative.com/",
      "logo": "https://jraftcreative.com/images/logo.png",
      "telephone": "+6582234578",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "60 Paya Lebar Road, Paya Lebar Square",
        "postalCode": "409051",
        "addressLocality": "Singapore",
        "addressCountry": "SG"
      }
    },
    "areaServed": { "@type": "Country", "name": "Singapore" },
    "serviceType": "Mental Health Social Media"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "Which platforms should a mental health practice in Singapore be on?", "acceptedAnswer": { "@type": "Answer", "text": "For most practices, Instagram and Facebook reach the adults and parents who quietly research support, while TikTok reaches younger people looking for accessible, everyday content. We usually recommend depth on two platforms rather than a thin presence on five." } },
      { "@type": "Question", "name": "What should a mental health practice actually post?", "acceptedAnswer": { "@type": "Answer", "text": "Calm, practical content works best — psychoeducation on common experiences like anxiety, burnout or grief, gentle coping tips, therapist introductions, and clear explainers on what a first session looks like. The aim is to make seeking help feel normal, not to diagnose or promise outcomes." } },
      { "@type": "Question", "name": "How do you keep mental health content responsible and compliant?", "acceptedAnswer": { "@type": "Answer", "text": "We work closely with your clinical team and follow AHPC advertising guidelines. We avoid diagnosing, alarmist or stigmatising language, and any promise of a cure or specific outcome. Helpline references are included where appropriate, and every post is reviewed by your licensed professionals before it goes live." } },
      { "@type": "Question", "name": "Can social media help reduce stigma around mental health in Singapore?", "acceptedAnswer": { "@type": "Answer", "text": "It can help. Thoughtful, non-judgemental content that speaks to real experiences — workplace pressure, cultural expectations, common misconceptions — gently normalises the idea of reaching out. When a trusted practitioner explains things plainly, it gives people quiet permission to take a first step." } },
      { "@type": "Question", "name": "How does social media lead to enquiries for a practice?", "acceptedAnswer": { "@type": "Answer", "text": "Rarely from a single post. Social builds familiarity and trust over time — someone who has followed your practice for weeks arrives ready to reach out. We measure that through reach, saves and sends, profile-to-website clicks and enquiries that mention social, not follower count alone." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "Social Media Agency for Mental Health Practices Singapore", "item": "https://jraftcreative.com/mental-health-social-media-singapore/" }
    ]
  }
];
---

<style is:global>
  /* Hide the global background grid pattern on this page only */
  .animated-bg__grid { display: none; }

  /* More-prominent related-service pills — match challenge-card-v2 green treatment */
  #related-services .related-service-link {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.35);
    color: var(--text);
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  #related-services .related-service-link:hover {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.22) 0%, rgba(73, 184, 137, 0.1) 100%), rgba(20, 28, 32, 0.7);
    border-color: rgba(73, 184, 137, 0.6);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(73, 184, 137, 0.3);
  }
  .service-cta-section { background: var(--bg-alt) !important; }
  .renovation-funnel { list-style: none; padding: 0; margin: 56px 0 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 48px; }
  .funnel-stage { position: relative; text-align: center; padding: 28px 20px; background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6); border: 1px solid rgba(73, 184, 137, 0.28); border-radius: 12px; transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease; }
  .funnel-stage:hover { transform: translateY(-4px); border-color: rgba(73, 184, 137, 0.55); box-shadow: 0 16px 40px -16px rgba(73, 184, 137, 0.3); }
  .funnel-stage h3 { font-size: 1.05rem; font-weight: 600; color: var(--accent); margin: 0 0 8px 0; letter-spacing: -0.01em; }
  .funnel-stage p { font-size: 0.82rem; color: var(--text); line-height: 1.5; margin: 0; }
  .funnel-stage:not(:last-child)::after { content: '→'; position: absolute; right: -34px; top: 50%; transform: translateY(-50%); color: var(--accent); font-size: 1.6rem; font-weight: 500; z-index: 2; line-height: 1; opacity: 0.7; }
  @media (max-width: 900px) { .renovation-funnel { grid-template-columns: repeat(2, 1fr); gap: 32px; } .funnel-stage:nth-child(2n)::after, .funnel-stage:last-child::after { display: none; } .funnel-stage:nth-child(2n-1)::after { right: -22px; } }
  @media (max-width: 600px) { .renovation-funnel { grid-template-columns: 1fr; gap: 20px; } .funnel-stage::after { display: none; } }
</style>

<ServiceLayout
  title="Mental Health Social Media Agency Singapore"
  description="Social media for mental health practices in Singapore — compassionate psychoeducation and therapist content that builds trust and encourages enquiries."
  canonical="https://jraftcreative.com/mental-health-social-media-singapore/"
  ogTitle="Mental Health Social Media Agency Singapore"
  ogDescription="Social media for mental health practices in Singapore. Compassionate, destigmatising content that builds trust and encourages a first enquiry, within AHPC guidelines."
  ogImage="https://jraftcreative.com/images/og-mentalhealth.jpg"
  keywords="social media agency for mental health practices, mental health social media singapore, therapist instagram singapore, counselling social media, psychoeducation content, Jraft Creative"
  schemaData={schemaData}
  heroLabel="Social Media Agency for Mental Health Practices"
  heroTitle='Social Media Agency for <span class="highlight">Mental Health Practices in Singapore</span>'
  heroSubtitle="People choose a practitioner they feel safe with, long before they send a message. We turn your team's expertise into calm, compassionate content that gently reduces stigma, answers real questions, and makes a first enquiry feel possible — within AHPC guidelines."
  heroImage="/images/service-mentalhealth.webp"
  heroImageAlt="Mental health professional in a Singapore clinic"
  heroButtons={[
    { text: "Get a Free Content Review", href: "/contact/", class: "btn btn-primary" },
    { text: "See Mental Health Websites", href: "/mental-health-clinic-website-singapore/", class: "btn btn-secondary" }
  ]}
  whatsappText="Hi Jraft Creative, I need social media for my mental health practice in Singapore."
  ctaLabel="Reach People Who Need Support"
  ctaTitle="Get a Free Mental Health Content Review"
  ctaDescription="Book a free consultation and we'll look at what you post now, what your team could gently be sharing, and where the gap is between followers and a first enquiry. We'll get back to you within 24 hours."
  ctaButtons={[
    { text: "Get a Free Content Review", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%20need%20social%20media%20for%20my%20mental%20health%20practice%20in%20Singapore.", class: "btn btn-secondary" }
  ]}
  hideDefaultCta={false}
>

  <!-- ========== THE CHALLENGE ========== -->
  <section class="section" id="challenge" aria-label="Social media challenges for mental health practices in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Challenge</p>
        <h2>Stigma Keeps People Quiet — <span class="highlight">Content</span> Is How You <span class="highlight">Gently Open the Door</span></h2>
      </div>
      <div class="section-content reveal">
        <p>The hardest part of mental health care is not the session — it is deciding to reach out. Many people in Singapore quietly wonder whether what they feel is normal, and whether help is even for them. The practices that speak to that hesitation online, with warmth and without judgement, are the ones people feel safe enough to message.</p>
        <p>This sits within your wider <a href="/industries/healthcare/">healthcare marketing in Singapore</a>, and social is the channel that carries the human, trust-building side of it. If you want the fundamentals first, our guide to <a href="/blog/social-media-marketing-singapore/">social media marketing in Singapore</a> is a good place to start. Whether your practice is in Novena, Orchard, Tanjong Pagar, Tampines, Bishan or Katong, a compassionate feed reaches people long before they ever call.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Stigma Stops the First Enquiry</h3>
            <p>Many people delay reaching out because seeking help still feels heavy. A calm, understanding feed does the reassuring that a service list never can — and makes that first message feel possible.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>A Quiet Feed Feels Out of Reach</h3>
            <p>An empty or overly clinical profile can leave a hesitant person more unsure. Consistent, human content signals a practice that will meet them with patience and care.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Responsible but Still Relatable</h3>
            <p>Mental health content must stay within AHPC guidelines and avoid diagnosing or alarmist language. Most practices either post nothing or post something that feels off. Neither builds trust.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHAT WE DELIVER ========== -->
  <section class="section" id="sub-services" style="background: var(--bg-alt);" aria-label="Social media services for mental health practices">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">What We Deliver</p>
        <h2>Six <span class="highlight">Content Workstreams</span> for Mental Health <span class="highlight">Practices</span></h2>
      </div>
      <div class="section-content reveal">
        <p>We build a gentle cadence around the expertise your team already shares each week, turning it into content that earns saves and sends and encourages a first enquiry. It pairs naturally with a calm <a href="/mental-health-clinic-website-singapore/">mental health clinic website</a> and, when you are ready, <a href="/mental-health-google-ads-singapore/">mental health Google Ads</a>.</p>
      </div>
      <div class="service-details-grid deliver-grid">
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-reels-video.webp');">
          <div class="service-detail-card__content">
            <h3>Therapist Introductions</h3>
            <p>Short, warm video of your practitioners sharing how they work and what a first session feels like — so a nervous person sees a real, approachable human, not just a clinic.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-content-strategy.webp');">
          <div class="service-detail-card__content">
            <h3>Psychoeducation Carousels</h3>
            <p>Clear, non-clinical carousels and Stories on common experiences like anxiety, burnout, grief and relationship strain — helping people understand what they feel, without diagnosing.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-graphic-design.webp');">
          <div class="service-detail-card__content">
            <h3>Coping &amp; Wellbeing Tips</h3>
            <p>Practical, gentle tips for everyday moments — grounding techniques, rest, boundaries — the saveable content people return to and quietly send to someone they care about.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-community-mgmt.webp');">
          <div class="service-detail-card__content">
            <h3>What-to-Expect Explainers</h3>
            <p>Reassuring content on what happens in a first session, confidentiality, and how to take the first step — removing the unknowns that hold people back.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-meta-ads.webp');">
          <div class="service-detail-card__content">
            <h3>Community Management</h3>
            <p>Thoughtful, empathetic handling of comments and DMs, directing urgent messages to appropriate helplines and nurturing a first enquiry with care and no pressure.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-campaign-analytics.webp');">
          <div class="service-detail-card__content">
            <h3>Reporting on Enquiries</h3>
            <p>We track reach, saves and sends, profile-to-enquiry and messages that mention social — follower count is context, not the result.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHY US ========== -->
  <section class="section" id="why-us" aria-label="Why choose Jraft Creative for mental health social media">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2>A <span class="highlight">Social Media Agency</span> That Respects <span class="highlight">Clinical Care</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Mental health social fails on either sensitivity or responsibility. We handle both, with your clinical team in control of every post.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Responsible Content Standards</h3>
            <p>Every piece follows AHPC guidelines and responsible communication practice — no diagnosing, no alarmist or stigmatising language, no promises of a cure or outcome. Helpline references included where appropriate.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Compassionate, Destigmatising Tone</h3>
            <p>We write with warmth and cultural sensitivity for Singapore's communities — content that meets people where they are and gently normalises reaching out, never preachy or dismissive.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>You Approve Before Publishing</h3>
            <p>You and your clinical team sign off every post, caption and visual. Nothing goes live without your approval.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== CLIENT JOURNEY FUNNEL ========== -->
  <section class="section" id="buyer-funnel" style="background: var(--bg-alt);" aria-label="Where social media fits the client journey">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Client Journey</p>
        <h2>Where <span class="highlight">Social</span> Fits the <span class="highlight">Client Journey</span></h2>
      </div>
      <div class="section-content reveal" style="margin-bottom: 24px;">
        <p>Someone considering support moves through five quiet stages before they reach out. Social rarely wins the first search — its job is Understand and Trust, where compassionate, human content eases the hesitation that holds people back.</p>
      </div>
      <ol class="renovation-funnel reveal">
        <li class="funnel-stage"><h3>Discover</h3><p>A reel or a saved post puts you on their radar</p></li>
        <li class="funnel-stage"><h3>Understand</h3><p>Psychoeducation helps them make sense of it</p></li>
        <li class="funnel-stage"><h3>Trust</h3><p>Warmth and consistency make you feel safe</p></li>
        <li class="funnel-stage"><h3>Enquire</h3><p>A DM or profile link becomes a first message</p></li>
        <li class="funnel-stage"><h3>Begin</h3><p>A calm first session, then quiet word of mouth</p></li>
      </ol>
    </div>
  </section>

  <!-- ========== FAQ ========== -->
  <section class="section faq-section" id="faq" style="background: var(--bg-alt);" aria-label="Frequently asked questions about mental health social media">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">FAQ</p>
        <h2>Mental Health Social Media — Questions Answered</h2>
      </div>
      <div class="faq-list">
        <details class="faq-item reveal reveal-d1">
          <summary>Which platforms should a mental health practice in Singapore be on?</summary>
          <div class="faq-answer"><p>For most practices, Instagram and Facebook reach the adults and parents who quietly research support, while TikTok reaches younger people looking for accessible, everyday content. We usually recommend depth on two platforms rather than a thin presence on five.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>What should a mental health practice actually post?</summary>
          <div class="faq-answer"><p>Calm, practical content works best — psychoeducation on common experiences like anxiety, burnout or grief, gentle coping tips, therapist introductions, and clear explainers on what a first session looks like. The aim is to make seeking help feel normal, not to diagnose or promise outcomes.</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>How do you keep mental health content responsible and compliant?</summary>
          <div class="faq-answer"><p>We work closely with your clinical team and follow AHPC advertising guidelines. We avoid diagnosing, alarmist or stigmatising language, and any promise of a cure or specific outcome. Helpline references are included where appropriate, and every post is reviewed by your licensed professionals before it goes live.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>Can social media help reduce stigma around mental health in Singapore?</summary>
          <div class="faq-answer"><p>It can help. Thoughtful, non-judgemental content that speaks to real experiences — workplace pressure, cultural expectations, common misconceptions — gently normalises the idea of reaching out. When a trusted practitioner explains things plainly, it gives people quiet permission to take a first step.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>How does social media lead to enquiries for a practice?</summary>
          <div class="faq-answer"><p>Rarely from a single post. Social builds familiarity and trust over time — someone who has followed your practice for weeks arrives ready to reach out. We measure that through reach, saves and sends, profile-to-website clicks and enquiries that mention social, not follower count alone.</p></div>
        </details>
      </div>
    </div>
  </section>

  <!-- Related Services -->
  <section class="section" id="related-services" aria-label="Related services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Explore More</p>
        <h2>More <span class="highlight">Mental Health</span> Services</h2>
      </div>
      <div class="related-services-grid reveal">
          <a href="/mental-health-marketing-singapore/" class="related-service-link">Mental Health Marketing</a>
          <a href="/mental-health-ai-search-optimisation-singapore/" class="related-service-link">Mental Health GEO</a>
          <a href="/mental-health-google-ads-singapore/" class="related-service-link">Mental Health Google Ads</a>
          <a href="/mental-health-clinic-website-singapore/" class="related-service-link">Mental Health Websites</a>
      </div>
    </div>
  </section>
</ServiceLayout>
