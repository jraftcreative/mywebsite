---
import ServiceLayout from '../layouts/ServiceLayout.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "GEO Agency for TCM Clinics Singapore",
    "description": "GEO and AI search optimisation agency for TCM clinics in Singapore. Get your clinic named when patients ask ChatGPT, Gemini and Google AI Mode for acupuncture, tuina or a TCM physician near them — in English and Chinese.",
    "provider": {
      "@type": "Organization",
      "name": "Jraft Creative",
      "url": "https://jraftcreative.com/",
      "logo": "https://jraftcreative.com/images/logo.png",
      "telephone": "+6582234578",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "60 Paya Lebar Road, Paya Lebar Square",
        "postalCode": "409051",
        "addressLocality": "Singapore",
        "addressCountry": "SG"
      }
    },
    "areaServed": { "@type": "Country", "name": "Singapore" },
    "serviceType": "TCM Clinic AI Search Optimisation"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "What is GEO for a TCM clinic?", "acceptedAnswer": { "@type": "Answer", "text": "Generative Engine Optimisation is the work of getting your clinic named when a patient asks an AI assistant rather than searching Google. Ask ChatGPT for a TCM clinic for acupuncture near Toa Payoh and you get a shortlist of a few clinics, not ten links. GEO is about being on that list, which depends on different signals from traditional SEO." } },
      { "@type": "Question", "name": "How is this different from the SEO you already do?", "acceptedAnswer": { "@type": "Answer", "text": "SEO earns a ranking position; GEO earns a mention inside a generated answer. Ranking factors still matter, but AI systems lean far more on structured data, entity clarity and how consistently your clinic is described across the web. A clinic can rank well and still never be named by an assistant — that's the gap we close." } },
      { "@type": "Question", "name": "Does AI search work in Chinese as well as English?", "acceptedAnswer": { "@type": "Answer", "text": "It has to for a Singapore TCM clinic. Many patients ask in Chinese — '中医推荐', '针灸诊所附近', '推拿哪里好' — and the assistant answers in Chinese. We make sure your clinic's services, physicians and locations are described clearly in both languages so you're named whichever way the question is asked." } },
      { "@type": "Question", "name": "What makes an AI recommend one TCM clinic over another?", "acceptedAnswer": { "@type": "Answer", "text": "Specificity and corroboration. AI systems favour clinics whose treatments, physician registration and locations are stated unambiguously and confirmed in more than one place — your site, your Google Business Profile, directories and third-party mentions. Vague copy gives a model nothing to match a patient's question against." } },
      { "@type": "Question", "name": "Can you show whether it is working?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We monitor prompts a real patient would use — by treatment, language and neighbourhood — across ChatGPT, Gemini, Perplexity and Google AI Mode, and track whether your clinic appears and how it's described. That gives an AI Visibility baseline and a monthly movement report on mention and citation rate." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "GEO Agency for TCM Clinics Singapore", "item": "https://jraftcreative.com/tcm-clinic-ai-search-optimisation-singapore/" }
    ]
  }
];
---

<style is:global>
  /* Hide the global background grid pattern on this page only */
  .animated-bg__grid { display: none; }

  /* More-prominent related-service pills — match challenge-card-v2 green treatment */
  #related-services .related-service-link {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.35);
    color: var(--text);
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  #related-services .related-service-link:hover {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.22) 0%, rgba(73, 184, 137, 0.1) 100%), rgba(20, 28, 32, 0.7);
    border-color: rgba(73, 184, 137, 0.6);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(73, 184, 137, 0.3);
  }
  .service-cta-section { background: var(--bg-alt) !important; }
  .renovation-funnel { list-style: none; padding: 0; margin: 56px 0 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 48px; }
  .funnel-stage { position: relative; text-align: center; padding: 28px 20px; background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6); border: 1px solid rgba(73, 184, 137, 0.28); border-radius: 12px; transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease; }
  .funnel-stage:hover { transform: translateY(-4px); border-color: rgba(73, 184, 137, 0.55); box-shadow: 0 16px 40px -16px rgba(73, 184, 137, 0.3); }
  .funnel-stage h3 { font-size: 1.05rem; font-weight: 600; color: var(--accent); margin: 0 0 8px 0; letter-spacing: -0.01em; }
  .funnel-stage p { font-size: 0.82rem; color: var(--text); line-height: 1.5; margin: 0; }
  .funnel-stage:not(:last-child)::after { content: '→'; position: absolute; right: -34px; top: 50%; transform: translateY(-50%); color: var(--accent); font-size: 1.6rem; font-weight: 500; z-index: 2; line-height: 1; opacity: 0.7; }
  @media (max-width: 900px) { .renovation-funnel { grid-template-columns: repeat(2, 1fr); gap: 32px; } .funnel-stage:nth-child(2n)::after, .funnel-stage:last-child::after { display: none; } .funnel-stage:nth-child(2n-1)::after { right: -22px; } }
  @media (max-width: 600px) { .renovation-funnel { grid-template-columns: 1fr; gap: 20px; } .funnel-stage::after { display: none; } }
</style>

<ServiceLayout
  title="GEO Agency for TCM Clinics Singapore"
  description="GEO agency for TCM clinics in Singapore — get named when patients ask ChatGPT, Gemini and Google AI Mode for acupuncture or a TCM physician near them, in English and Chinese."
  canonical="https://jraftcreative.com/tcm-clinic-ai-search-optimisation-singapore/"
  ogTitle="GEO Agency for TCM Clinics Singapore"
  ogDescription="AI search optimisation for Singapore TCM clinics. Get named when patients ask ChatGPT, Gemini and Perplexity for acupuncture or TCM — in English and Chinese."
  ogImage="https://jraftcreative.com/images/og-tcm.jpg"
  keywords="geo agency for tcm clinics, tcm clinic ai search optimisation singapore, tcm chatgpt optimisation, ai search optimisation for tcm, generative engine optimisation tcm, acupuncture ai search singapore, Jraft Creative"
  schemaData={schemaData}
  heroLabel="GEO Agency for TCM Clinics"
  heroTitle='GEO Agency for <span class="highlight">TCM Clinics in Singapore</span>'
  heroSubtitle="Patients have started asking AI which TCM clinic to visit — in English and in Chinese. The answer names two or three clinics, and if yours isn't one of them, you were never in the running. We make TCM clinics the answer AI assistants give."
  heroImage="/images/service-tcm.webp"
  heroImageAlt="TCM clinic in Singapore — ai search optimisation"
  heroButtons={[
    { text: "Get an AI Visibility Audit", href: "/contact/", class: "btn btn-primary" },
    { text: "See TCM Clinic SEO", href: "/tcm-clinic-seo-singapore/", class: "btn btn-secondary" }
  ]}
  whatsappText="Hi Jraft Creative, I'd like to know if my TCM clinic shows up in AI search."
  ctaLabel="Be the Answer"
  ctaTitle="Find Out What AI Says About Your Clinic"
  ctaDescription="Book a free consultation and we'll run the prompts a real patient would use — by treatment, language and neighbourhood — across ChatGPT, Gemini and Perplexity, and show you exactly where your TCM clinic currently stands. We'll get back to you within 24 hours."
  ctaButtons={[
    { text: "Get an AI Visibility Audit", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%27d%20like%20to%20know%20if%20my%20TCM%20clinic%20shows%20up%20in%20AI%20search.", class: "btn btn-secondary" }
  ]}
  hideDefaultCta={false}
>

  <!-- ========== THE CHALLENGE ========== -->
  <section class="section" id="challenge" aria-label="AI Search Optimisation challenges for TCM clinics in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Challenge</p>
        <h2>Patients Are Asking <span class="highlight">AI</span> for a TCM Clinic — and It Names <span class="highlight">Two or Three</span></h2>
      </div>
      <div class="section-content reveal">
        <p>A generated answer has no page two. Either your clinic is on the shortlist an assistant gives — in English or in Chinese — or it does not exist to that patient.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Ranking Well Isn't Enough</h3>
            <p>A clinic can sit on page one of Google and never be mentioned by ChatGPT. AI systems weigh structured data and entity clarity, not just position.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Two Languages, One Answer</h3>
            <p>Patients ask in English and in Chinese — '中医推荐', '针灸诊所附近'. A clinic described in only one language is invisible when the question comes in the other.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>The Lane Is Still Open</h3>
            <p>Almost no Singapore TCM clinic has done this work. The bar is far lower than it has been in Google search for a decade — for now.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHAT WE DELIVER ========== -->
  <section class="section" id="sub-services" style="background: var(--bg-alt);" aria-label="AI Search Optimisation services for TCM clinics">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">What We Deliver</p>
        <h2>Six <span class="highlight">GEO Workstreams</span> for TCM <span class="highlight">Clinics</span></h2>
      </div>
      <div class="section-content reveal">
        <p>We make your treatments, physician registration and locations unambiguous to a machine — in both languages — then prove it moved. This runs alongside your <a href="/tcm-clinic-seo-singapore/">TCM clinic SEO</a>, your <a href="/tcm-clinic-website-singapore/">clinic website</a> and your <a href="/tcm-clinic-social-media-singapore/">social channels</a>.</p>
      </div>
      <div class="service-details-grid deliver-grid">
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-seo-audit.webp');">
          <div class="service-detail-card__content">
            <h3>AI Visibility Audit</h3>
            <p>We run the prompts patients actually use — in English and Chinese — across ChatGPT, Gemini and Perplexity, and record whether you appear and how you're described.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-onpage-seo.webp');">
          <div class="service-detail-card__content">
            <h3>TCM Schema &amp; Entities</h3>
            <p>LocalBusiness and FAQ structured data for your clinic, each treatment and every physician — so services, registration and locations are machine-readable facts, not prose.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-content-strategy.webp');">
          <div class="service-detail-card__content">
            <h3>Answer-Engine Content</h3>
            <p>Clear question-and-answer pages on acupuncture, tuina, cupping and herbal consultation — written in the extractable form models quote back, in both languages.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-ai.webp');">
          <div class="service-detail-card__content">
            <h3>llms.txt &amp; Machine Access</h3>
            <p>An llms.txt file and clean, crawlable pages that give answer engines a tidy map of your clinic's services, physicians and locations to read from.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-local-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Entity &amp; Directory Authority</h3>
            <p>Your clinic name, physician registration and neighbourhood corroborated across your site, Google Business Profile, healthcare directories and third-party mentions — the checks an assistant makes.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-campaign-analytics.webp');">
          <div class="service-detail-card__content">
            <h3>Prompt Monitoring</h3>
            <p>A tracked query bank of treatment, language and neighbourhood prompts, re-run monthly, so visibility is measured on mention and citation rate rather than asserted.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHY US ========== -->
  <section class="section" id="why-us" aria-label="Why choose Jraft Creative for tcm clinic ai search optimisation">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2>A <span class="highlight">GEO Agency</span> That Has Been <span class="highlight">Cited Itself</span></h2>
      </div>
      <div class="section-content reveal">
        <p>We practise this on our own site and publish the method rather than keeping it a black box.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>We've Earned AI Citations</h3>
            <p>We wrote up <a href="/blog/how-we-got-cited-in-google-ai-overview-singapore/">how we got cited in Google's AI Overview</a> for niche Singapore queries — method, not marketing.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Bilingual by Default</h3>
            <p>Singapore's TCM patients ask in English and Chinese. We structure your clinic so it's named whichever language the assistant answers in — the gap monolingual work leaves open.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Measured, Not Claimed</h3>
            <p>Baseline first, monthly prompt re-runs after. If your AI Visibility hasn't moved, the report says so — see our <a href="/geo-agency-singapore/">GEO programme</a>.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== PATIENT JOURNEY FUNNEL ========== -->
  <section class="section" id="buyer-funnel" style="background: var(--bg-alt);" aria-label="Where ai search optimisation fits the patient journey">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Patient Journey</p>
        <h2>Where <span class="highlight">AI Search</span> Fits the <span class="highlight">Patient Journey</span></h2>
      </div>
      <div class="section-content reveal" style="margin-bottom: 24px;">
        <p>AI has moved to the very front of the journey. Where a patient once opened Google and browsed a list, many now ask an assistant for a shortlist — which means Discover is decided before your website is ever visited.</p>
      </div>
      <ol class="renovation-funnel reveal">
        <li class="funnel-stage"><h3>Ask</h3><p>A patient asks an AI which TCM clinic to visit</p></li>
        <li class="funnel-stage"><h3>Shortlist</h3><p>Two or three clinics get named — or you don't</p></li>
        <li class="funnel-stage"><h3>Validate</h3><p>They check reviews, registration and location</p></li>
        <li class="funnel-stage"><h3>Book</h3><p>The shortlist turns into a booked appointment</p></li>
        <li class="funnel-stage"><h3>Return</h3><p>A good first visit, then repeat visits &amp; referrals</p></li>
      </ol>
    </div>
  </section>

  <!-- ========== FAQ ========== -->
  <section class="section faq-section" id="faq" style="background: var(--bg-alt);" aria-label="Frequently asked questions about tcm clinic ai search optimisation">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">FAQ</p>
        <h2>TCM GEO — Questions Answered</h2>
      </div>
      <div class="faq-list">
        <details class="faq-item reveal reveal-d1">
          <summary>What is GEO for a TCM clinic?</summary>
          <div class="faq-answer"><p>Generative Engine Optimisation is the work of getting your clinic named when a patient asks an AI assistant rather than searching Google. Ask ChatGPT for a TCM clinic for acupuncture near Toa Payoh and you get a shortlist of a few clinics, not ten links. GEO is about being on that list, which depends on different signals from traditional SEO.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>How is this different from the SEO you already do?</summary>
          <div class="faq-answer"><p>SEO earns a ranking position; GEO earns a mention inside a generated answer. Ranking factors still matter, but AI systems lean far more on structured data, entity clarity and how consistently your clinic is described across the web. A clinic can rank well and still never be named by an assistant — that's the gap we close.</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>Does AI search work in Chinese as well as English?</summary>
          <div class="faq-answer"><p>It has to for a Singapore TCM clinic. Many patients ask in Chinese — "中医推荐", "针灸诊所附近", "推拿哪里好" — and the assistant answers in Chinese. We make sure your clinic's services, physicians and locations are described clearly in both languages so you're named whichever way the question is asked.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>What makes an AI recommend one TCM clinic over another?</summary>
          <div class="faq-answer"><p>Specificity and corroboration. AI systems favour clinics whose treatments, physician registration and locations are stated unambiguously and confirmed in more than one place — your site, your Google Business Profile, directories and third-party mentions. Vague copy gives a model nothing to match a patient's question against.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>Can you show whether it is working?</summary>
          <div class="faq-answer"><p>Yes. We monitor prompts a real patient would use — by treatment, language and neighbourhood — across ChatGPT, Gemini, Perplexity and Google AI Mode, and track whether your clinic appears and how it's described. That gives an AI Visibility baseline and a monthly movement report on mention and citation rate.</p></div>
        </details>
      </div>
    </div>
  </section>

  <!-- Related Services -->
  <section class="section" id="related-services" aria-label="Related services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Explore More</p>
        <h2>More <span class="highlight">TCM Clinic</span> Services</h2>
      </div>
      <div class="related-services-grid reveal">
          <a href="/tcm-marketing-singapore/" class="related-service-link">TCM Clinic Marketing</a>
          <a href="/tcm-clinic-seo-singapore/" class="related-service-link">TCM Clinic SEO</a>
          <a href="/tcm-clinic-google-ads-singapore/" class="related-service-link">TCM Clinic Google Ads</a>
          <a href="/tcm-clinic-social-media-singapore/" class="related-service-link">TCM Clinic Social Media</a>
          <a href="/tcm-clinic-branding-singapore/" class="related-service-link">TCM Clinic Branding</a>
          <a href="/tcm-clinic-website-singapore/" class="related-service-link">TCM Clinic Websites</a>
      </div>
    </div>
  </section>
</ServiceLayout>
