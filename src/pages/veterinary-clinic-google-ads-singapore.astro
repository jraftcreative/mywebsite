---
import ServiceLayout from '../layouts/ServiceLayout.astro';
import RelatedServices from '../components/RelatedServices.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Veterinary Clinic Google Ads Singapore",
    "description": "Google Ads management for veterinary clinics in Singapore — emergency vet keywords, pet owner targeting, vaccination campaigns, and service-specific advertising. Plans",
    "provider": {
      "@type": "Organization",
      "name": "Jraft Creative",
      "url": "https://jraftcreative.com/",
      "logo": "https://jraftcreative.com/images/logo.png",
      "telephone": "+6582234578",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "60 Paya Lebar Road, Paya Lebar Square",
        "postalCode": "409051",
        "addressLocality": "Singapore",
        "addressCountry": "SG"
      }
    },
    "areaServed": { "@type": "Country", "name": "Singapore" },
    "serviceType": "Google Ads Management for Veterinary Clinics"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How much should vet clinics budget for Google Ads in Singapore?", "acceptedAnswer": { "@type": "Answer", "text": "Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote." } },
      { "@type": "Question", "name": "Should vet clinics advertise emergency services on Google?", "acceptedAnswer": { "@type": "Answer", "text": "If you offer after-hours or emergency care, absolutely. Emergency vet searches like '24 hour vet' and 'emergency animal hospital near me' have the highest conversion rates because pet owners need immediate help and will call the first clinic they find. We set up call-priority campaigns with location extensions so distressed owners reach you within seconds." } },
      { "@type": "Question", "name": "How do you target pet owners in my clinic's area?", "acceptedAnswer": { "@type": "Answer", "text": "We use radius targeting around your clinic — typically 5–8 km — combined with neighbourhood keywords like 'vet clinic Bukit Timah' or 'animal hospital Tampines'. For routine services, pet owners almost always choose a conveniently located vet, so tight location targeting is essential for efficient ad spend." } },
      { "@type": "Question", "name": "Can Google Ads promote seasonal vaccination campaigns?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We create timed campaigns for annual vaccination reminders, puppy and kitten first-visit packages, and seasonal health screening promotions. These campaigns target pet owners at key moments in their pet's care cycle — building long-term patient relationships rather than one-off visits." } },
      { "@type": "Question", "name": "How do you track whether Google Ads generate actual vet appointments?", "acceptedAnswer": { "@type": "Answer", "text": "We set up conversion tracking across phone calls, online booking forms, WhatsApp messages, and Google Maps direction requests. Each conversion is attributed to the specific keyword and ad that generated it — giving you clear cost-per-appointment data so you know exactly which campaigns deliver the best return." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "Veterinary Clinic Google Ads Singapore", "item": "https://jraftcreative.com/veterinary-clinic-google-ads-singapore/" }
    ]
  }
];
---

<style is:global>
  /* Hide the global background grid pattern on this page only */
  .animated-bg__grid { display: none; }

  /* More-prominent related-service pills — match challenge-card-v2 green treatment */
  #related-services .related-service-link {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.35);
    color: var(--text);
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  #related-services .related-service-link:hover {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.22) 0%, rgba(73, 184, 137, 0.1) 100%), rgba(20, 28, 32, 0.7);
    border-color: rgba(73, 184, 137, 0.6);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(73, 184, 137, 0.3);
  }
  .service-cta-section { background: var(--bg-alt) !important; }
  .renovation-funnel { list-style: none; padding: 0; margin: 56px 0 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 48px; }
  .funnel-stage { position: relative; text-align: center; padding: 28px 20px; background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6); border: 1px solid rgba(73, 184, 137, 0.28); border-radius: 12px; transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease; }
  .funnel-stage:hover { transform: translateY(-4px); border-color: rgba(73, 184, 137, 0.55); box-shadow: 0 16px 40px -16px rgba(73, 184, 137, 0.3); }
  .funnel-stage h3 { font-size: 1.05rem; font-weight: 600; color: var(--accent); margin: 0 0 8px 0; letter-spacing: -0.01em; }
  .funnel-stage p { font-size: 0.82rem; color: var(--text); line-height: 1.5; margin: 0; }
  .funnel-stage:not(:last-child)::after { content: '→'; position: absolute; right: -34px; top: 50%; transform: translateY(-50%); color: var(--accent); font-size: 1.6rem; font-weight: 500; z-index: 2; line-height: 1; opacity: 0.7; }
  @media (max-width: 900px) { .renovation-funnel { grid-template-columns: repeat(2, 1fr); gap: 32px; } .funnel-stage:nth-child(2n)::after, .funnel-stage:last-child::after { display: none; } .funnel-stage:nth-child(2n-1)::after { right: -22px; } }
  @media (max-width: 600px) { .renovation-funnel { grid-template-columns: 1fr; gap: 20px; } .funnel-stage::after { display: none; } }
</style>

<ServiceLayout
  title="Google Ads Agency for Veterinary Clinics Singapore"
  description="Google Ads management for veterinary clinics in Singapore. Emergency vet keywords, pet owner targeting, vaccination campaigns."
  canonical="https://jraftcreative.com/veterinary-clinic-google-ads-singapore/"
  ogTitle="Google Ads Agency for Veterinary Clinics Singapore"
  ogDescription="Google Ads for vet clinics in Singapore. Emergency vet keywords, pet owner targeting, and service-specific campaigns. Plans"
  ogImage="https://jraftcreative.com/images/og-webdev.jpg"
  keywords="veterinary clinic google ads singapore, vet clinic advertising singapore, google ads for vet clinics, ppc veterinary singapore, vet marketing singapore, animal clinic ads singapore, Jraft Creative"
  schemaData={schemaData}
  heroLabel="Google Ads Agency for Veterinary Clinics"
  heroTitle='Google Ads Agency for <span class="highlight">Veterinary Clinics in Singapore</span>'
  heroSubtitle="When a pet owner searches for a vet — whether it's a 2 AM emergency or a routine vaccination — they choose the clinic that shows up first. We build Google Ads campaigns that put your veterinary practice at the top of search results, from emergency care to wellness packages and everything in between."
  heroImage="/images/service-veterinary.webp"
  heroButtons={[
    { text: "Get a Free Ad Strategy", href: "/contact/", class: "btn btn-primary" },
    { text: "See How We Work", href: "/process/", class: "btn btn-secondary" }
  ]}
  whatsappText="Hi Jraft Creative, I need Google Ads for my veterinary clinic in Singapore."
  ctaLabel="Grow Your Practice"
  ctaTitle="Get a Free Veterinary Clinic Ad Strategy Session"
  ctaDescription="Book a free consultation and we'll analyse your local competition, identify the highest-value keywords for your services, and map out a Google Ads strategy tailored to your clinic's strengths and patient capacity. We'll get back to you within 24 hours."
  ctaButtons={[
    { text: "Get a Free Ad Strategy", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%20need%20Google%20Ads%20for%20my%20veterinary%20clinic%20in%20Singapore.", class: "btn btn-secondary" }
  ]}
>

  <!-- ========== THE CHALLENGE ========== -->
  <section class="section" id="challenge" aria-label="Google Ads challenges for veterinary clinics in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Challenge</p>
        <h2>Pet Owners Are Searching — Is Your Clinic the One They <span class="highlight">Find</span>?</h2>
      </div>
      <div class="section-content reveal">
        <p>An owner with a sick pet or a new puppy is ready to book today. Google Ads puts your clinic in front of them at that moment.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Emergencies Book Immediately</h3>
            <p>A frightened owner searching '24-hour vet' books within minutes. If you're not visible then, the visit goes to whoever is.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Wasted Spend Without Structure</h3>
            <p>Broad, untuned campaigns burn budget on browsers and other clinics instead of owners ready to book a service.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>New Puppies &amp; Kittens Are Timed</h3>
            <p>First vaccinations, sterilisation and health checks happen on a schedule. Ads timed to that intent win the lifetime client.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHAT WE DELIVER ========== -->
  <section class="section" id="sub-services" style="background: var(--bg-alt);" aria-label="Google Ads services for veterinary clinics">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">What We Deliver</p>
        <h2>Six <span class="highlight">Pillars</span> of Veterinary Clinic <span class="highlight">Google Ads</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Every campaign is service-specific and judged on booked visits rather than clicks.</p>
      </div>
      <div class="service-details-grid deliver-grid">
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-google-ads.webp');">
          <div class="service-detail-card__content">
            <h3>Emergency &amp; After-Hours Campaigns</h3>
            <p>High-intent campaigns for 'emergency vet' and 'vet open now' — the moments an owner books almost immediately.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-meta-ads.webp');">
          <div class="service-detail-card__content">
            <h3>Neighbourhood Targeting</h3>
            <p>Ads focused on the estates around your clinic and the areas owners travel from, so budget follows reachable clients.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-campaign-analytics.webp');">
          <div class="service-detail-card__content">
            <h3>Service-Specific Ad Groups</h3>
            <p>Separate campaigns for vaccination, sterilisation, dental and surgery — so budget follows the services you most want to fill.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-landing-page.webp');">
          <div class="service-detail-card__content">
            <h3>Vaccination &amp; Wellness Promotions</h3>
            <p>Timed campaigns for puppy and kitten packages and annual check-ups, capturing owners at the start of a lifetime relationship.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-local-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Exotic &amp; Specialty Targeting</h3>
            <p>Low-competition, high-value searches for exotic, avian and small-mammal care where few clinics compete.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-analytics-reporting.webp');">
          <div class="service-detail-card__content">
            <h3>Cost-Per-Booking Reporting</h3>
            <p>We track click to booked visit and report cost per booking by service, so you know exactly what each new client costs.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHY US ========== -->
  <section class="section" id="why-us" aria-label="Why choose Jraft Creative for veterinary google ads">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2>A <span class="highlight">Google Ads Agency</span> Built for <span class="highlight">Vet Clinics</span></h2>
      </div>
      <div class="section-content reveal">
        <p>We manage vet ad accounts to a single number — cost per booked visit — and build for the lifetime value of a loyal client.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Pet Care Market Knowledge</h3>
            <p>We know which service keywords convert, how to structure by procedure, and how to capture the emergency moment.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Transparent Ad Spend</h3>
            <p>Your budget goes straight to Google, never marked up. The account stays in your name, so you see every dollar and cost per booking.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Ads, SEO &amp; Website Together</h3>
            <p>We also run <a href="/veterinary-clinic-seo-singapore/">vet SEO</a> and build the <a href="/veterinary-clinic-website-singapore/">website</a> the ads land on — one system, one goal.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== FUNNEL ========== -->
  <section class="section" id="buyer-funnel" style="background: var(--bg-alt);" aria-label="Where google ads fits the pet-owner journey">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Owner Journey</p>
        <h2>Where <span class="highlight">Google Ads</span> Fits the <span class="highlight">Pet-Owner Journey</span></h2>
      </div>
      <div class="section-content reveal" style="margin-bottom: 24px;">
        <p>A pet owner moves through five stages before booking. Google Ads owns the two highest-intent moments — Discover, when they first search a service or an emergency, and Book, when a remarketing ad brings a researcher back.</p>
      </div>
      <ol class="renovation-funnel reveal">
        <li class="funnel-stage"><h3>Discover</h3><p>An ad captures the first service search</p></li>
        <li class="funnel-stage"><h3>Research</h3><p>They read service detail and reviews</p></li>
        <li class="funnel-stage"><h3>Compare</h3><p>Location and hours weigh the clinics</p></li>
        <li class="funnel-stage"><h3>Book</h3><p>Remarketing and a clear page close it</p></li>
        <li class="funnel-stage"><h3>Care</h3><p>A good first visit, then a lifetime of loyalty</p></li>
      </ol>
    </div>
  </section>

  <!-- ========== PRICING ========== -->
  <!-- ========== FAQ ========== -->
  <section class="section faq-section" id="faq" style="background: var(--bg-alt);" aria-label="Frequently asked questions about Google Ads for veterinary clinics">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">FAQ</p>
        <h2>Veterinary Clinic Google Ads — Questions Answered</h2>
      </div>
      <div class="faq-list">
        <details class="faq-item reveal reveal-d1">
          <summary>How much should vet clinics budget for Google Ads in Singapore?</summary>
          <div class="faq-answer"><p>Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>Should vet clinics advertise emergency services on Google?</summary>
          <div class="faq-answer"><p>If you offer after-hours or emergency care, absolutely. Emergency vet searches like "24 hour vet" and "emergency animal hospital near me" have the highest conversion rates because pet owners need immediate help and will call the first clinic they find. We set up call-priority campaigns with location extensions so distressed owners reach you within seconds.</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>How do you target pet owners in my clinic's area?</summary>
          <div class="faq-answer"><p>We use radius targeting around your clinic — typically 5–8 km — combined with neighbourhood keywords like "vet clinic Bukit Timah" or "animal hospital Tampines". For routine services, pet owners almost always choose a conveniently located vet, so tight location targeting is essential for efficient ad spend.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>Can Google Ads promote seasonal vaccination campaigns?</summary>
          <div class="faq-answer"><p>Yes. We create timed campaigns for annual vaccination reminders, puppy and kitten first-visit packages, and seasonal health screening promotions. These campaigns target pet owners at key moments in their pet's care cycle — building long-term patient relationships rather than one-off visits.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>How do you track whether Google Ads generate actual vet appointments?</summary>
          <div class="faq-answer"><p>We set up conversion tracking across phone calls, online booking forms, WhatsApp messages, and Google Maps direction requests. Each conversion is attributed to the specific keyword and ad that generated it — giving you clear cost-per-appointment data so you know exactly which campaigns deliver the best return.</p></div>
        </details>
      </div>
    </div>
  </section>


  <section class="section" id="related-services" aria-label="Related services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Explore More</p>
        <h2>More <span class="highlight">Veterinary Clinic</span> Services</h2>
      </div>
      <div class="related-services-grid reveal">
          <a href="/veterinary-clinic-seo-singapore/" class="related-service-link">Veterinary SEO</a>
          <a href="/veterinary-clinic-website-singapore/" class="related-service-link">Veterinary Website Design</a>
          <a href="/veterinary-clinic-social-media-singapore/" class="related-service-link">Veterinary Social Media</a>
          <a href="/veterinary-clinic-branding-singapore/" class="related-service-link">Veterinary Branding</a>
          <a href="/veterinary-clinic-marketing-singapore/" class="related-service-link">Full-Service Veterinary Marketing</a>
          <a href="/veterinary-clinic-ai-search-optimisation-singapore/" class="related-service-link">Veterinary GEO / AI Search</a>
      </div>
    </div>
  </section>

</ServiceLayout>
