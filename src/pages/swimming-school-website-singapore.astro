---
import ServiceLayout from '../layouts/ServiceLayout.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Swimming School Website Design Singapore",
    "description": "Conversion-focused website design for swimming schools and swim academies in Singapore — trial-lesson booking, programme pages by level and age, instructor profiles, class schedules, water-safety content, and mobile-first speed for learn-to-swim, water safety, competitive squads, and private and group lessons.",
    "provider": {
      "@type": "Organization",
      "name": "Jraft Creative",
      "url": "https://jraftcreative.com/",
      "logo": "https://jraftcreative.com/images/logo.png",
      "telephone": "+6582234578",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "60 Paya Lebar Road, Paya Lebar Square",
        "postalCode": "409051",
        "addressLocality": "Singapore",
        "addressCountry": "SG"
      }
    },
    "areaServed": { "@type": "Country", "name": "Singapore" },
    "serviceType": "Swimming School Website Design"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How much does a swimming school website cost in Singapore?", "acceptedAnswer": { "@type": "Answer", "text": "Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote." } },
      { "@type": "Question", "name": "Can parents book a trial lesson and enrol on the website?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. That's a core part of the build. We wire in trial-lesson booking with level, age, and pool selection, plus term enrolment and makeup-session booking, and automated confirmation emails with the pool address, what to bring, and safety reminders. We work with the booking tools available in Singapore, or integrate the system you already use." } },
      { "@type": "Question", "name": "How do you display pool locations and facilities on the website?", "acceptedAnswer": { "@type": "Answer", "text": "Each pool location gets a dedicated page with an embedded map, facility photos, water depth and changing-room details, parking and MRT directions, and the class schedule for that venue. For schools across multiple condominiums, public pools, or private facilities in Singapore, we build a location finder so parents can choose the pool nearest them." } },
      { "@type": "Question", "name": "Can you help our swimming school show up on Google locally?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We optimise your website for the keywords parents actually search — like 'swimming lessons near me', 'baby swim class Singapore', or 'learn to swim Tampines'. That includes on-page SEO, schema markup, Google Business Profile optimisation, and location pages that help you show up in local results and Google Maps for each pool area you serve." } },
      { "@type": "Question", "name": "How long does it take to build a swimming school website?", "acceptedAnswer": { "@type": "Answer", "text": "Most swimming school websites go live within about 2 weeks. Sites with trial booking, instructor profiles, and multi-location scheduling take a little longer, and larger builds with progress tracking longer still. We give you a clear timeline before we start so you can plan around your term schedule." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "Swimming School Website Singapore", "item": "https://jraftcreative.com/swimming-school-website-singapore/" }
    ]
  }
];
---

<style is:global>
  /* Hide the global background grid pattern on this page only */
  .animated-bg__grid { display: none; }

  /* More-prominent related-service pills — match challenge-card-v2 green treatment */
  #related-services .related-service-link {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.35);
    color: var(--text);
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  #related-services .related-service-link:hover {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.22) 0%, rgba(73, 184, 137, 0.1) 100%), rgba(20, 28, 32, 0.7);
    border-color: rgba(73, 184, 137, 0.6);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(73, 184, 137, 0.3);
  }

  /* Separate the CTA section from related-services with bg-alt */
  .service-cta-section {
    background: var(--bg-alt) !important;
  }

  /* Force even service card grid on desktop per locked landing-page pattern */
  #sub-services .deliver-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }
  @media (max-width: 900px) {
    #sub-services .deliver-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 600px) {
    #sub-services .deliver-grid { grid-template-columns: 1fr; }
  }

  /* Gym Website Flow — horizontal process flow with green accents */
  .renovation-funnel {
    list-style: none;
    padding: 0;
    margin: 56px 0 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 48px;
    counter-reset: funnel;
  }
  .funnel-stage {
    position: relative;
    text-align: center;
    padding: 28px 20px;
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.28);
    border-radius: 12px;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .funnel-stage:hover {
    transform: translateY(-4px);
    border-color: rgba(73, 184, 137, 0.55);
    box-shadow: 0 16px 40px -16px rgba(73, 184, 137, 0.3);
  }
  .funnel-stage h3 {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--accent);
    margin: 0 0 8px 0;
    letter-spacing: -0.01em;
  }
  .funnel-stage p {
    font-size: 0.82rem;
    color: var(--text);
    line-height: 1.5;
    margin: 0;
  }
  .funnel-stage:not(:last-child)::after {
    content: '→';
    position: absolute;
    right: -34px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--accent);
    font-size: 1.6rem;
    font-weight: 500;
    z-index: 2;
    line-height: 1;
    opacity: 0.7;
  }
  @media (max-width: 900px) {
    .renovation-funnel {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }
    .funnel-stage:nth-child(2n)::after,
    .funnel-stage:last-child::after {
      display: none;
    }
    .funnel-stage:nth-child(2n-1)::after {
      right: -22px;
    }
  }
  @media (max-width: 600px) {
    .renovation-funnel {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .funnel-stage::after {
      display: none;
    }
  }
</style>

<ServiceLayout
  title="Swimming School Website Singapore — Jraft Creative"
  description="Website design for swimming schools in Singapore — trial booking, programme pages by level and age, instructor profiles, mobile-first speed."
  canonical="https://jraftcreative.com/swimming-school-website-singapore/"
  ogTitle="Swimming School Website Singapore — Jraft Creative"
  ogDescription="Website design for swimming schools and swim academies in Singapore. Trial-lesson booking, programme pages by level and age, instructor profiles, and schedules."
  ogImage="https://jraftcreative.com/images/og-webdev.jpg"
  keywords="swimming school website design singapore, swimming school website singapore, swim school website singapore, swimming lessons website singapore, learn to swim website singapore, swim academy website design, Jraft Creative"
  schemaData={schemaData}
  heroLabel="Swimming School Websites"
  heroTitle='Website Design for <span class="highlight">Swimming Schools in Singapore</span>'
  heroSubtitle="Parents find a swim school on their phone, then decide in seconds whether to book a trial. We build conversion-focused swimming school websites — trial-lesson booking, programme pages by level and age, instructor profiles, and schedules that load fast — so a family from Tampines to Bukit Timah turns into a booked trial, not a bounce."
  heroImage="/images/service-swimmingschool.webp"
  heroImageAlt="Swimming school in Singapore"
  heroButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "See How We Work", href: "/process/", class: "btn btn-secondary" }
  ]}
  whatsappText="Hi Jraft Creative, I need a website for my swimming school in Singapore."
  ctaLabel="Ready to Fill More Trials?"
  ctaTitle="Get Your Swimming School Online"
  ctaDescription="Tell us about your swimming school and we'll recommend the right website approach. Free consultation — no obligations, no pressure."
  ctaButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%20need%20a%20website%20for%20my%20swimming%20school%20in%20Singapore.", class: "btn btn-secondary" }
  ]}
>

  <!-- ========== THE CHALLENGE ========== -->
  <section class="section" id="challenge" aria-label="Why swimming schools need a proper website">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Challenge</p>
        <h2>Parents Search "Swimming Lessons Near Me" <span class="highlight">on Their Phone</span> — Does Yours <span class="highlight">Win the Booking</span>?</h2>
      </div>
      <div class="section-content reveal">
        <p>Singapore's swim-school market is crowded, from Woodlands to Katong. Most parents compare a few schools on their phone and book the first trial lesson that's easy to grab. A slow or confusing site loses them to the school down the road.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Booking a Trial Shouldn't Be Hard</h3>
            <p>Parents want one thing first: how to try a class. If booking a trial lesson means a DM and a wait, most families give up and open the next tab instead of enrolling.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Social Isn't Enough</h3>
            <p>Instagram builds awareness but vanishes in a day. A parent choosing between learn-to-swim and a competitive squad needs the programmes, instructors, and pool details in one place, working around the clock.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Slow on Mobile Loses</h3>
            <p>Most swim-school searches happen on the go, on data. A heavy site that stalls for a few seconds bleeds enquiries before the schedule even loads — and Google buries slow pages in local results.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHAT WE BUILD ========== -->
  <section class="section" id="sub-services" style="background: var(--bg-alt);" aria-label="Swimming school website design services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">What We Build</p>
        <h2>What We Build for <span class="highlight">Swimming Schools</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Every swim-school site we build is made to turn a visitor into a booked trial or an enrolled swimmer — trial booking front and centre, programme pages by level and age, instructor profiles, and a live schedule. It's a focused <a href="/services/website-development/">website development</a> build that fits inside our wider <a href="/industries/fitness/">fitness marketing</a> work, so every channel points the same way.</p>
      </div>
      <div class="service-details-grid deliver-grid">
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-business-website.webp');">
          <div class="service-detail-card__content">
            <h3>Trial &amp; Class Booking</h3>
            <p>The whole site points to one action — booking a trial or reserving a class. Level and age selection, automated confirmations with the pool address and what to bring, and reminders that cut no-shows and keep learn-to-swim and squad sessions full.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-landing-page.webp');">
          <div class="service-detail-card__content">
            <h3>Programme Pages by Level &amp; Age</h3>
            <p>Dedicated pages for every programme — baby and parent-child, learn-to-swim, stroke correction, competitive squads, and adult lessons — with class structure, instructor-to-student ratios, age groups, and water-safety stages so parents know exactly where their child fits.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-local-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Instructor Profiles &amp; Schedule</h3>
            <p>Profile pages showing each instructor's certifications, coaching experience, and specialisations, plus a live schedule parents filter by level, age, or pool — so families know who they'll swim with and when.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-graphic-design.webp');">
          <div class="service-detail-card__content">
            <h3>Pool Info &amp; Mobile Speed</h3>
            <p>Location pages with maps, facility photos, water depth, changing rooms, and parking or MRT directions — built mobile-first and tuned to load fast on data, with tap-to-call and tap-to-book always within reach.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHY CHOOSE US ========== -->
  <section class="section" id="why-us" aria-label="Why choose Jraft Creative for swimming school website design">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2>Why Choose Us for Your <span class="highlight">Swimming School Website</span></h2>
      </div>
      <div class="section-content reveal">
        <p>We understand how swimming schools in Singapore actually run — trial-to-enrolment conversion, programmes by level and age, class scheduling, and the water-safety expectations parents bring. A website is one part of our wider <a href="/industries/fitness/">fitness marketing services</a>.</p>
      </div>
      <div class="service-details-grid" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Built to Convert</h3>
            <p>Every page is designed around one job: turning a visitor into a booked trial or an enrolled swimmer. Clear calls to action, fast forms, and a booking path that never makes parents hunt.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Fast Turnaround</h3>
            <p>Most swim-school sites go live in about 2 weeks — quick enough to catch a new term opening in Bishan or Jurong, a rebrand, or a peak-enrolment push without missing the demand.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>One Agency, All Channels</h3>
            <p>Beyond the site, we run SEO, social, and Google Ads — so your whole online presence pulls in one direction while you focus on your swimmers and the pool deck.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WEBSITE FLOW ========== -->
  <section class="section" id="website-flow" style="background: var(--bg-alt);" aria-label="How we build your swimming school website">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">How It Works</p>
        <h2>From First Call to <span class="highlight">Booked Trials</span></h2>
      </div>
      <div class="section-content reveal" style="margin-bottom: 24px;">
        <p>We run the same four-step build on every swim school — clear, quick, and made to start taking trial bookings the moment you go live. For the thinking behind it, our guide on <a href="/blog/good-business-website-singapore/">what makes a good business website in Singapore</a> covers the essentials.</p>
      </div>
      <ol class="renovation-funnel reveal">
        <li class="funnel-stage">
          <h3>Discover</h3>
          <p>We map your programmes, instructors, and booking needs</p>
        </li>
        <li class="funnel-stage">
          <h3>Design</h3>
          <p>Bespoke swim-school design, built mobile-first</p>
        </li>
        <li class="funnel-stage">
          <h3>Build</h3>
          <p>Booking, profiles, and schedule wired and tested</p>
        </li>
        <li class="funnel-stage">
          <h3>Launch</h3>
          <p>Live in about 2 weeks, tuned for bookings</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ========== FAQ ========== -->
  <section class="section faq-section" id="faq" aria-label="Frequently asked questions about swimming school website design in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">FAQ</p>
        <h2><span class="highlight">Swimming School Website</span> — Questions <span class="highlight">Answered</span></h2>
      </div>
      <div class="faq-list">
        <details class="faq-item reveal reveal-d1">
          <summary>How much does a swimming school website cost in Singapore?</summary>
          <div class="faq-answer"><p>Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>Can parents book a trial lesson and enrol on the website?</summary>
          <div class="faq-answer"><p>Yes. That's a core part of the build. We wire in trial-lesson booking with level, age, and pool selection, plus term enrolment and makeup-session booking, and automated confirmation emails with the pool address, what to bring, and safety reminders. We work with the booking tools available in Singapore, or integrate the system you already use.</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>How do you display pool locations and facilities on the website?</summary>
          <div class="faq-answer"><p>Each pool location gets a dedicated page with an embedded map, facility photos, water depth and changing-room details, parking and MRT directions, and the class schedule for that venue. For schools across multiple condominiums, public pools, or private facilities in Singapore, we build a location finder so parents can choose the pool nearest them.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>Can you help our swimming school show up on Google locally?</summary>
          <div class="faq-answer"><p>Yes. We optimise your website for the keywords parents actually search — like "swimming lessons near me", "baby swim class Singapore", or "learn to swim Tampines". That includes on-page SEO, schema markup, Google Business Profile optimisation, and location pages that help you show up in local results and Google Maps for each pool area you serve.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>How long does it take to build a swimming school website?</summary>
          <div class="faq-answer"><p>Most swimming school websites go live within about 2 weeks. Sites with trial booking, instructor profiles, and multi-location scheduling take a little longer, and larger builds with progress tracking longer still. We give you a clear timeline before we start so you can plan around your term schedule.</p></div>
        </details>
      </div>
    </div>
  </section>


  <!-- Related Services -->
  <section class="section" id="related-services" aria-label="Related services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Explore More</p>
        <h2>More <span class="highlight">Swimming School Services</span></h2>
      </div>
      <div class="related-services-grid reveal">
          <a href="/industries/fitness/" class="related-service-link">Fitness Marketing</a>
          <a href="/services/website-development/" class="related-service-link">Website Development</a>
          <a href="/services/seo-performance/" class="related-service-link">SEO &amp; Performance</a>
          <a href="/services/social-media/" class="related-service-link">Social Media</a>
      </div>
    </div>
  </section>
</ServiceLayout>
