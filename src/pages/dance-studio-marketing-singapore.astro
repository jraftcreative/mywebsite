---
import ServiceLayout from '../layouts/ServiceLayout.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Marketing Agency for Dance Studios Singapore",
    "description": "Full-service marketing agency for dance studios in Singapore — SEO, AI search, Google Ads, social, branding and websites that fill classes for kids and adults.",
    "provider": {
      "@type": "Organization",
      "name": "Jraft Creative",
      "url": "https://jraftcreative.com/",
      "logo": "https://jraftcreative.com/images/logo.png",
      "telephone": "+6582234578",
      "address": { "@type": "PostalAddress", "streetAddress": "60 Paya Lebar Road, Paya Lebar Square", "postalCode": "409051", "addressLocality": "Singapore", "addressCountry": "SG" }
    },
    "areaServed": { "@type": "Country", "name": "Singapore" },
    "serviceType": "Dance Studio Marketing"
  },
  { "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [
      { "@type": "Question", "name": "What does marketing for a dance studio involve?", "acceptedAnswer": { "@type": "Answer", "text": "Being found in style-and-location search, named by AI assistants, visible in paid results during intake and recital seasons, showing class energy and results on social, positioning as a serious studio, and a website that converts a search into a booked trial." } },
      { "@type": "Question", "name": "We fill by word of mouth — why market?", "acceptedAnswer": { "@type": "Answer", "text": "Referrals plateau and fill only your popular classes. Marketing reaches new dancers for the styles, times and adult classes your current families don't." } },
      { "@type": "Question", "name": "How quickly does it work?", "acceptedAnswer": { "@type": "Answer", "text": "Paid search produces trial enquiries within days; organic and AI visibility take three to five months. We launch the fastest channel that fits your budget and build the durable ones underneath." } },
      { "@type": "Question", "name": "Do you work with studios of one or two teachers?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. A focused studio can own a tight radius and a couple of styles far more cheaply than a large school competing island-wide. The strategy is narrower; the outcome is a full timetable." } },
      { "@type": "Question", "name": "How do you measure success?", "acceptedAnswer": { "@type": "Answer", "text": "Booked trials, cost per trial, and how many dancers stay past the first term. Video views are context, not the measure." } }
    ] },
  { "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "Marketing Agency for Dance Studios Singapore", "item": "https://jraftcreative.com/dance-studio-marketing-singapore/" }
  ] }
];
---

<style is:global>
  /* Hide the global background grid pattern on this page only */
  .animated-bg__grid { display: none; }

  /* More-prominent related-service pills — match challenge-card-v2 green treatment */
  #related-services .related-service-link {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.35);
    color: var(--text);
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  #related-services .related-service-link:hover {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.22) 0%, rgba(73, 184, 137, 0.1) 100%), rgba(20, 28, 32, 0.7);
    border-color: rgba(73, 184, 137, 0.6);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(73, 184, 137, 0.3);
  }
  .service-cta-section { background: var(--bg-alt) !important; }
  .renovation-funnel { list-style: none; padding: 0; margin: 56px 0 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 48px; }
  .funnel-stage { position: relative; text-align: center; padding: 28px 20px; background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6); border: 1px solid rgba(73, 184, 137, 0.28); border-radius: 12px; transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease; }
  .funnel-stage:hover { transform: translateY(-4px); border-color: rgba(73, 184, 137, 0.55); box-shadow: 0 16px 40px -16px rgba(73, 184, 137, 0.3); }
  .funnel-stage h3 { font-size: 1.05rem; font-weight: 600; color: var(--accent); margin: 0 0 8px 0; letter-spacing: -0.01em; }
  .funnel-stage p { font-size: 0.82rem; color: var(--text); line-height: 1.5; margin: 0; }
  .funnel-stage:not(:last-child)::after { content: '→'; position: absolute; right: -34px; top: 50%; transform: translateY(-50%); color: var(--accent); font-size: 1.6rem; font-weight: 500; z-index: 2; line-height: 1; opacity: 0.7; }
  @media (max-width: 900px) { .renovation-funnel { grid-template-columns: repeat(2, 1fr); gap: 32px; } .funnel-stage:nth-child(2n)::after, .funnel-stage:last-child::after { display: none; } .funnel-stage:nth-child(2n-1)::after { right: -22px; } }
  @media (max-width: 600px) { .renovation-funnel { grid-template-columns: 1fr; gap: 20px; } .funnel-stage::after { display: none; } }
</style>

<ServiceLayout
  title="Marketing Agency for Dance Studios Singapore"
  description="Marketing agency for dance studios in Singapore — SEO, ads, social and websites that fill ballet, hip-hop and adult classes."
  canonical="https://jraftcreative.com/dance-studio-marketing-singapore/"
  ogTitle="Marketing Agency for Dance Studios Singapore"
  ogDescription="Full-service marketing for Singapore dance studios. Six channels that fill kids and adult dance classes."
  ogImage="https://jraftcreative.com/images/og-webdev.jpg"
  keywords="marketing agency for dance studios, dance studio marketing singapore, dance school marketing, ballet school marketing, dance class advertising singapore, Jraft Creative"
  schemaData={schemaData}
  heroLabel="Marketing Agency for Dance Studios"
  heroTitle='Marketing Agency for <span class="highlight">Dance Studios in Singapore</span>'
  heroSubtitle="From ballet exams to hip-hop crews to adult classes, your studio has more to sell than any feed shows. We run the channels that fill your timetable — search, ads, social, brand and website — judged on booked trials and enrolled dancers."
  heroImage="/images/service-dancestudio.webp"
  heroImageAlt="Dance studio class in Singapore — dance studio marketing"
  heroButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "See Dance Studio Websites", href: "/dance-studio-website-singapore/", class: "btn btn-secondary" }
  ]}
  whatsappText="Hi Jraft Creative, I'd like to talk about marketing for my dance studio in Singapore."
  ctaLabel="Fill Your Timetable"
  ctaTitle="Get a Free Dance Studio Marketing Review"
  ctaDescription="Book a free consultation and we'll look at how dancers and parents find you now, which classes sit empty, and which channel fills them fastest. We'll get back to you within 24 hours."
  ctaButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%27d%20like%20to%20talk%20about%20marketing%20for%20my%20dance%20studio%20in%20Singapore.", class: "btn btn-secondary" }
  ]}
  hideDefaultCta={false}
>

  <!-- ========== THE CHALLENGE ========== -->
  <section class="section" id="challenge" aria-label="Marketing challenges for dance studios in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Challenge</p>
        <h2>A Studio Full of <span class="highlight">Talent</span>, a Timetable Full of <span class="highlight">Gaps</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Dance studios grow on recitals and referrals, then plateau. The classes with space are rarely the ones your current families fill.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Referrals Fill the Wrong Classes</h3>
            <p>Word of mouth clusters in popular styles and times. Your quieter classes — adult, weekday, a new genre — need reaching new people, not the same circle.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Parents &amp; Dancers Search by Style</h3>
            <p>'Ballet class for kids', 'hip-hop class [estate]', 'adult dance class' — style-and-location searches. If those don't find you, another studio answers.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Your Best Content Never Gets Filmed</h3>
            <p>Recitals, exam results and class energy are the most persuasive marketing you have — and most of it lives on a phone, shared once.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== SIX CHANNELS ========== -->
  <section class="section" id="sub-services" style="background: var(--bg-alt);" aria-label="Marketing channels for dance studios">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">What We Deliver</p>
        <h2>Six <span class="highlight">Marketing Channels</span> Every Dance Studio <span class="highlight">Needs</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Each channel does a different job in the same journey — from a first search to a booked trial class.</p>
      </div>
      <div class="service-details-grid deliver-grid">
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-local-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Search &amp; Local SEO</h3>
            <p>Rank for style-and-location searches — 'ballet [estate]', 'K-pop dance class', 'adult beginner dance' — and own the Maps three-pack.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-ai.webp');">
          <div class="service-detail-card__content">
            <h3>AI Search &amp; GEO</h3>
            <p>Get named when someone asks an AI for a good dance studio near them for a specific style, age or level.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-google-ads.webp');">
          <div class="service-detail-card__content">
            <h3>Google Ads</h3>
            <p>Capture intake and recital-season demand with campaigns split by style and age, so budget follows the classes you need to fill.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-reels-video.webp');">
          <div class="service-detail-card__content">
            <h3>Social Content</h3>
            <p>Recital clips, class energy and exam results — dance is the most watchable content there is, and we turn it into trials.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-graphic-design.webp');">
          <div class="service-detail-card__content">
            <h3>Brand &amp; Positioning</h3>
            <p>Positioning that separates a serious studio (exams, progression, performance) from a drop-in class, so you can charge for it.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-business-website.webp');">
          <div class="service-detail-card__content">
            <h3>Website That Converts</h3>
            <p>A <a href="/dance-studio-website-singapore/">dance studio website</a> with styles, levels, a timetable and a trial booking that converts.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHY US ========== -->
  <section class="section" id="why-us" aria-label="Why choose Jraft Creative for dance studios marketing">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2>One <span class="highlight">Agency</span>, All Six <span class="highlight">Channels</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Most studios use separate vendors who never share what's converting. We run it as one system.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Channels That Feed Each Other</h3>
            <p>Ads show which styles and times convert; that decides the SEO pages and the recital clips we cut. A single team turns that into fuller classes; vendors don't.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Measured on Enquiries, Not Clicks</h3>
            <p>We measure trials booked and trial-to-enrolment by class — the number that fills your timetable, not views on a recital video.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>One Team, Every Channel</h3>
            <p>Site, search, social and ads are built together, so someone who sees a routine on TikTok lands on that exact class and a trial booking.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== FUNNEL ========== -->
  <section class="section" id="buyer-funnel" style="background: var(--bg-alt);" aria-label="How customers choose a dance studio">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Enrolment Funnel</p>
        <h2>How Dancers &amp; Parents <span class="highlight">Choose a Studio</span></h2>
      </div>
      <div class="section-content reveal" style="margin-bottom: 24px;">
        <p>Every channel owns a stage — search and AI decide whether you're considered, social and brand prove the energy and quality, and the website turns interest into a booked trial.</p>
      </div>
      <ol class="renovation-funnel reveal">
        <li class="funnel-stage"><h3>Discover</h3><p>A search, AI answer or a friend's recommendation</p></li>
        <li class="funnel-stage"><h3>Validate</h3><p>Recitals, exam results and class energy prove it</p></li>
        <li class="funnel-stage"><h3>Compare</h3><p>Style, level, timetable and price weighed up</p></li>
        <li class="funnel-stage"><h3>Trial</h3><p>A booked class — the only real conversion</p></li>
        <li class="funnel-stage"><h3>Enrol</h3><p>Sign for the term, progress &amp; refer</p></li>
      </ol>
    </div>
  </section>

  <!-- ========== FAQ ========== -->
  <section class="section faq-section" id="faq" style="background: var(--bg-alt);" aria-label="Frequently asked questions about dance studios marketing">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">FAQ</p>
        <h2>Dance Studio <span class="highlight">Marketing</span> — Questions Answered</h2>
      </div>
      <div class="faq-list">
        <details class="faq-item reveal reveal-d1">
          <summary>What does marketing for a dance studio involve?</summary>
          <div class="faq-answer"><p>Being found in style-and-location search, named by AI assistants, visible in paid results during intake and recital seasons, showing class energy and results on social, positioning as a serious studio, and a website that converts a search into a booked trial.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>We fill by word of mouth — why market?</summary>
          <div class="faq-answer"><p>Referrals plateau and fill only your popular classes. Marketing reaches new dancers for the styles, times and adult classes your current families don't.</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>How quickly does it work?</summary>
          <div class="faq-answer"><p>Paid search produces trial enquiries within days; organic and AI visibility take three to five months. We launch the fastest channel that fits your budget and build the durable ones underneath.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>Do you work with studios of one or two teachers?</summary>
          <div class="faq-answer"><p>Yes. A focused studio can own a tight radius and a couple of styles far more cheaply than a large school competing island-wide. The strategy is narrower; the outcome is a full timetable.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>How do you measure success?</summary>
          <div class="faq-answer"><p>Booked trials and cost per trial, then trial-to-enrolment. Follower count and impressions are context, never the result.</p></div>
        </details>
      </div>
    </div>
  </section>

  <!-- Related Services -->
  <section class="section" id="related-services" aria-label="Related services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Explore More</p>
        <h2>More <span class="highlight">Dance Studio</span> Services</h2>
      </div>
      <div class="related-services-grid reveal">
          <a href="/dance-studio-website-singapore/" class="related-service-link">Dance Studio Website Design</a>
          <a href="/education-marketing-agency-singapore/" class="related-service-link">Full-Service Education Marketing</a>
          <a href="/education-ai-search-optimisation-singapore/" class="related-service-link">Education GEO / AI Search</a>
          <a href="/music-school-marketing-singapore/" class="related-service-link">Music School Marketing</a>
          <a href="/gym-marketing-singapore/" class="related-service-link">Fitness Marketing</a>
      </div>
    </div>
  </section>
</ServiceLayout>
