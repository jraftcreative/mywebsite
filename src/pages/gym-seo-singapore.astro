---
import ServiceLayout from '../layouts/ServiceLayout.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Gym SEO Singapore",
    "description": "SEO services for gyms and fitness centres in Singapore. Local SEO, Google Business Profile optimisation, membership-focused keyword strategy, and content marketing to fill your gym floor",
    "provider": {
      "@type": "Organization",
      "name": "Jraft Creative",
      "url": "https://jraftcreative.com/",
      "logo": "https://jraftcreative.com/images/logo.png",
      "telephone": "+6582234578",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "60 Paya Lebar Road, Paya Lebar Square",
        "postalCode": "409051",
        "addressLocality": "Singapore",
        "addressCountry": "SG"
      }
    },
    "areaServed": { "@type": "Country", "name": "Singapore" },
    "serviceType": "Gym SEO"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How much does SEO cost for a gym in Singapore?", "acceptedAnswer": { "@type": "Answer", "text": "Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote." } },
      { "@type": "Question", "name": "How long does it take for gym SEO to show results?", "acceptedAnswer": { "@type": "Answer", "text": "Most gyms see measurable ranking improvements within 3 to 4 months. Google Business Profile optimisation and technical fixes can produce quick wins in weeks. Location-specific keywords like 'gym near Tanjong Pagar' or 'personal trainer Tampines' often rank faster than broad competitive terms like 'gym Singapore'." } },
      { "@type": "Question", "name": "Can SEO help my gym rank in Google Maps?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Google Business Profile optimisation and local SEO are central to our gym SEO service. We optimise your listing categories, upload facility photos, manage member reviews, and build local citations so your gym appears in the Maps 3-pack for 'gym near me' and '24 hour gym Singapore' searches in your area." } },
      { "@type": "Question", "name": "What keywords do people search when looking for a gym in Singapore?", "acceptedAnswer": { "@type": "Answer", "text": "Common search terms include 'gym near me', '24 hour gym Singapore', 'personal trainer Tampines', 'HIIT class near me', 'gym membership Jurong', 'CrossFit Singapore', and 'group fitness class near me'. We research the exact terms driving trials and sign-ups in your area and optimise your gym's presence around them." } },
      { "@type": "Question", "name": "Do you work with gyms that have multiple locations?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Multi-location gym SEO is a core capability. We create unique, optimised location pages for each branch, manage individual Google Business Profiles, build location-specific citations, and ensure consistent NAP data across all directories so each gym ranks independently in its own neighbourhood." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "Gym SEO Singapore", "item": "https://jraftcreative.com/gym-seo-singapore/" }
    ]
  }
];
---

<style is:global>
  /* Hide the global background grid pattern on this page only */
  .animated-bg__grid { display: none; }

  /* More-prominent related-service pills — match challenge-card-v2 green treatment */
  #related-services .related-service-link {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.35);
    color: var(--text);
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  #related-services .related-service-link:hover {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.22) 0%, rgba(73, 184, 137, 0.1) 100%), rgba(20, 28, 32, 0.7);
    border-color: rgba(73, 184, 137, 0.6);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(73, 184, 137, 0.3);
  }

  /* Separate the CTA section from related-services with bg-alt */
  .service-cta-section {
    background: var(--bg-alt) !important;
  }

  /* Force even service card grid on desktop per locked landing-page pattern */
  #sub-services .deliver-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }
  @media (max-width: 900px) {
    #sub-services .deliver-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 600px) {
    #sub-services .deliver-grid { grid-template-columns: 1fr; }
  }

  /* Gym SEO Flow — horizontal process flow with green accents */
  .renovation-funnel {
    list-style: none;
    padding: 0;
    margin: 56px 0 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 48px;
    counter-reset: funnel;
  }
  .funnel-stage {
    position: relative;
    text-align: center;
    padding: 28px 20px;
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.28);
    border-radius: 12px;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .funnel-stage:hover {
    transform: translateY(-4px);
    border-color: rgba(73, 184, 137, 0.55);
    box-shadow: 0 16px 40px -16px rgba(73, 184, 137, 0.3);
  }
  .funnel-stage h3 {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--accent);
    margin: 0 0 8px 0;
    letter-spacing: -0.01em;
  }
  .funnel-stage p {
    font-size: 0.82rem;
    color: var(--text);
    line-height: 1.5;
    margin: 0;
  }
  .funnel-stage:not(:last-child)::after {
    content: '→';
    position: absolute;
    right: -34px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--accent);
    font-size: 1.6rem;
    font-weight: 500;
    z-index: 2;
    line-height: 1;
    opacity: 0.7;
  }
  @media (max-width: 900px) {
    .renovation-funnel {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }
    .funnel-stage:nth-child(2n)::after,
    .funnel-stage:last-child::after {
      display: none;
    }
    .funnel-stage:nth-child(2n-1)::after {
      right: -22px;
    }
  }
  @media (max-width: 600px) {
    .renovation-funnel {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .funnel-stage::after {
      display: none;
    }
  }
</style>

<ServiceLayout
  title="Gym SEO Singapore — Jraft Creative"
  description="SEO services for gyms and fitness centres in Singapore. Local SEO, Google Business Profile optimisation, membership and personal-training landing pages."
  canonical="https://jraftcreative.com/gym-seo-singapore/"
  ogTitle="Gym SEO Singapore — Jraft Creative"
  ogDescription="SEO for gyms and fitness centres in Singapore. Local search optimisation, Google Maps ranking, and membership-focused content to drive trials and sign-ups."
  ogImage="https://jraftcreative.com/images/og-gym.jpg"
  keywords="gym seo singapore, fitness centre seo, seo for gyms, 24 hour gym seo, personal training seo, gym google ranking, gym local seo, gym marketing singapore, Jraft Creative"
  schemaData={schemaData}
  heroLabel="Gym SEO"
  heroTitle='SEO for <span class="highlight">Gyms & Fitness Studios in Singapore</span>'
  heroSubtitle="When someone searches 'gym near me' or '24 hour gym Singapore', the gyms ranking on page one and in the Maps 3-pack get the trial booking and the sign-up. From boutique studios to 24-hour chains, we get your gym in front of the members searching in your neighbourhood."
  heroImage="/images/service-gym.webp"
  heroButtons={[
    { text: "Get a Free SEO Audit", href: "/contact/", class: "btn btn-primary" },
    { text: "See How We Work", href: "/process/", class: "btn btn-secondary" }
  ]}
  whatsappText="Hi Jraft Creative, I need SEO for my gym in Singapore."
  ctaLabel="Ready to Rank Higher?"
  ctaTitle="Get Your Gym Found on Google"
  ctaDescription="Book a free SEO audit and we'll show you exactly where your gym stands in local search compared to nearby competitors. We'll respond within 24 hours."
  ctaButtons={[
    { text: "Get a Free SEO Audit", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%20need%20SEO%20for%20my%20gym%20in%20Singapore.", class: "btn btn-secondary" }
  ]}
>

  <!-- ========== THE CHALLENGE ========== -->
  <section class="section" id="challenge" aria-label="SEO challenges for gyms in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Challenge</p>
        <h2>Hundreds of Gyms Compete — Is Yours the One <span class="highlight">Members Find</span>?</h2>
      </div>
      <div class="section-content reveal">
        <p>Great equipment, strong trainers, and a prime location count for nothing if you're invisible the moment someone searches for a gym near them.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>The "Gym Near Me" Moment</h3>
            <p>Someone searching "24 hour gym Jurong" or "personal trainer Tampines" is ready to book a trial today. If you're not in the top results and the Maps 3-pack, that member walks into the gym that is.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>The Map-Pack Shutout</h3>
            <p>Most gyms have a full timetable but thin online visibility. Without an optimised Google Business Profile and local signals, you never enter the 3-pack where "gym near me" trials are won.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>The Aggregator Margin Trap</h3>
            <p>Left off page one, gyms lean on ClassPass and discount platforms just to stay visible — eroding margins and filling classes with drop-ins who never convert into loyal members.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== SERVICES ========== -->
  <section class="section" id="sub-services" style="background: var(--bg-alt);" aria-label="SEO services for gyms">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Our SEO Services</p>
        <h2>SEO Built for <span class="highlight">Gyms and Fitness Studios</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Gym SEO is a specialist job — members search by service, class type, opening hours, and neighbourhood. We build around exactly how Singapore residents look for and choose a gym, and pair it with a fast <a href="/gym-website-design-singapore/">gym website</a>, <a href="/gym-social-media-singapore/">social media</a>, and <a href="/gym-google-ads-singapore/">Google Ads</a> so every channel works together.</p>
      </div>
      <div class="service-details-grid deliver-grid">
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-seo-audit.webp');">
          <div class="service-detail-card__content">
            <h3>Technical SEO Audit</h3>
            <p>A full crawl to fix indexing gaps, broken links, missing schema, and slow mobile loads — the technical barriers stopping Google from ranking your gym.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-onpage-seo.webp');">
          <div class="service-detail-card__content">
            <h3>On-Page Optimisation</h3>
            <p>Keyword-optimised pages for every offering — personal training, group classes, HIIT, spin, CrossFit, strength — targeting searches like "personal trainer Tampines" and "HIIT class near me".</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-local-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Local SEO &amp; Google Business Profile</h3>
            <p>Correct categories, opening hours, facility photos, review management, and local citations that put you in the Maps 3-pack for every "gym near me" and "24 hour gym Singapore" search in your area.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-speed-vitals.webp');">
          <div class="service-detail-card__content">
            <h3>Membership-Focused Content</h3>
            <p>Guides answering what members actually search — "how to choose a gym in Singapore", "personal training vs group classes" — that build authority and capture prospects while they're deciding.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHY CHOOSE US ========== -->
  <section class="section" id="why-us" aria-label="Why choose Jraft Creative for gym SEO">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2>An SEO Agency That <span class="highlight">Understands Gyms</span></h2>
      </div>
      <div class="section-content reveal">
        <p>We work with fitness businesses across Singapore — we know membership and free-trial models, peak and off-peak demand, and which searches actually convert into members who stay. SEO is one part of our full <a href="/industries/fitness/">fitness marketing services</a>.</p>
      </div>
      <div class="service-details-grid" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Fitness Industry Knowledge</h3>
            <p>We know the difference between personal-training searches, group-class discovery, and 24-hour access queries — and which drive real search volume here. Strategy built around how members search, not a generic template.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Neighbourhood-Level Local SEO</h3>
            <p>Members want a gym close to home or the office. We optimise for the MRT-radius searches — Tanjong Pagar, Bugis, Tampines, Jurong, Novena, Paya Lebar — so you rank where your ideal members live and work.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>One Agency, All Channels</h3>
            <p>SEO is one piece. We also handle your website, social, and paid ads — so every channel works together to fill classes and sign up members, instead of pulling in different directions.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== SEO FLOW ========== -->
  <section class="section" id="seo-flow" style="background: var(--bg-alt);" aria-label="How gym SEO works">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">How It Works</p>
        <h2>How Gym SEO <span class="highlight">Fills Your Floor</span></h2>
      </div>
      <div class="section-content reveal" style="margin-bottom: 24px;">
        <p>From first audit to booked trials, we run the same four-step system on every gym we take on — and report the numbers that tie back to sign-ups. Our guide on <a href="/blog/rank-google-maps-singapore/">how to rank in Google Maps in Singapore</a> covers the local-search side in detail.</p>
      </div>
      <ol class="renovation-funnel reveal">
        <li class="funnel-stage">
          <h3>Audit</h3>
          <p>Technical and local audit of where you rank today</p>
        </li>
        <li class="funnel-stage">
          <h3>Optimise</h3>
          <p>Service pages, on-page, and site speed fixed</p>
        </li>
        <li class="funnel-stage">
          <h3>Localise</h3>
          <p>GBP and citations built for the Maps 3-pack</p>
        </li>
        <li class="funnel-stage">
          <h3>Rank &amp; Report</h3>
          <p>Rankings, traffic, and trials tracked monthly</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ========== FAQ ========== -->
  <section class="section faq-section" id="faq" aria-label="Frequently asked questions about gym SEO in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">FAQ</p>
        <h2><span class="highlight">Gym SEO</span> — Questions <span class="highlight">Answered</span></h2>
      </div>
      <div class="faq-list">
        <details class="faq-item reveal reveal-d1">
          <summary>How much does SEO cost for a gym in Singapore?</summary>
          <div class="faq-answer"><p>Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>How long does it take for gym SEO to show results?</summary>
          <div class="faq-answer"><p>Most gyms see measurable ranking improvements within 3 to 4 months. Google Business Profile optimisation and technical fixes can produce quick wins in weeks. Location-specific keywords like "gym near Tanjong Pagar" or "personal trainer Tampines" often rank faster than broad competitive terms like "gym Singapore".</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>Can SEO help my gym rank in Google Maps?</summary>
          <div class="faq-answer"><p>Yes. Google Business Profile optimisation and local SEO are central to our gym SEO service. We optimise your listing categories, upload facility photos, manage member reviews, and build local citations so your gym appears in the Maps 3-pack for "gym near me" and "24 hour gym Singapore" searches in your area.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>What keywords do people search when looking for a gym in Singapore?</summary>
          <div class="faq-answer"><p>Common search terms include "gym near me", "24 hour gym Singapore", "personal trainer Tampines", "HIIT class near me", "gym membership Jurong", "CrossFit Singapore", and "group fitness class near me". We research the exact terms driving trials and sign-ups in your area and build your SEO strategy around them.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>Do you work with gyms that have multiple locations?</summary>
          <div class="faq-answer"><p>Yes. Multi-location gym SEO is a core capability. We create unique, optimised location pages for each branch, manage individual Google Business Profiles, build location-specific citations, and ensure consistent NAP data across all directories so each gym ranks independently in its own neighbourhood.</p></div>
        </details>
      </div>
    </div>
  </section>


  <!-- Related Services -->
  <section class="section" id="related-services" aria-label="Related services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Explore More</p>
        <h2>More Gym Services</h2>
      </div>
      <div class="related-services-grid reveal">
          <a href="/gym-marketing-singapore/" class="related-service-link">Gym Marketing</a>
          <a href="/gym-ai-search-optimisation-singapore/" class="related-service-link">Gym GEO</a>
          <a href="/gym-google-ads-singapore/" class="related-service-link">Gym Google Ads</a>
          <a href="/gym-social-media-singapore/" class="related-service-link">Gym Social Media</a>
          <a href="/gym-branding-singapore/" class="related-service-link">Gym Branding</a>
          <a href="/gym-website-design-singapore/" class="related-service-link">Gym Websites</a>
      </div>
    </div>
  </section>
</ServiceLayout>
