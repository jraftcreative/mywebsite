---
import ServiceLayout from '../layouts/ServiceLayout.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "GEO Agency for Education Singapore",
    "description": "GEO and AI search optimisation agency for education businesses in Singapore — tuition centres, enrichment, preschools and music schools. Get named when parents ask ChatGPT, Gemini and Google AI Mode.",
    "provider": {
      "@type": "Organization",
      "name": "Jraft Creative",
      "url": "https://jraftcreative.com/",
      "logo": "https://jraftcreative.com/images/logo.png",
      "telephone": "+6582234578",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "60 Paya Lebar Road, Paya Lebar Square",
        "postalCode": "409051",
        "addressLocality": "Singapore",
        "addressCountry": "SG"
      }
    },
    "areaServed": { "@type": "Country", "name": "Singapore" },
    "serviceType": "Education AI Search Optimisation"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "What is GEO for an education business?", "acceptedAnswer": { "@type": "Answer", "text": "Generative Engine Optimisation is the work of getting your centre named when a parent asks an AI assistant rather than searching Google. Ask ChatGPT for the best enrichment programme for a P3 child in Bishan and you get a shortlist of two or three names, not a page of results. GEO is about being on that shortlist, which depends on different signals from traditional SEO." } },
      { "@type": "Question", "name": "We run several programmes under one brand. Does that help or hurt?", "acceptedAnswer": { "@type": "Answer", "text": "It hurts by default and helps once it is structured. A group running tuition, enrichment and a preschool usually describes everything in one blurred paragraph, so an AI cannot tell which programme answers which question. Mapping each programme, level and branch as a distinct entity is what lets a model surface the right one for the right parent." } },
      { "@type": "Question", "name": "How is this different from the SEO we already pay for?", "acceptedAnswer": { "@type": "Answer", "text": "SEO earns a ranking position; GEO earns a mention inside a generated answer. Ranking factors still matter, but AI systems lean far more on structured data, entity clarity and whether your claims are corroborated elsewhere. A centre can rank on page one and still never be named by an assistant — that is the gap this closes." } },
      { "@type": "Question", "name": "Can you prove it is working?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We track a set of prompts a real parent would use — by subject, level, programme and neighbourhood — across ChatGPT, Gemini, Perplexity and Google AI Mode, then re-run them monthly. You get a visibility baseline and a movement report, including how your centre is being described when it does appear." } },
      { "@type": "Question", "name": "Is it too early to invest in this?", "acceptedAnswer": { "@type": "Answer", "text": "It is early, which is the argument for moving now. Very few Singapore education providers have done any of this work, so the bar is far lower than it has been in Google search for years. The centres that establish clean entity data early are the ones assistants keep citing as parent adoption grows." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "GEO Agency for Education Singapore", "item": "https://jraftcreative.com/education-ai-search-optimisation-singapore/" }
    ]
  }
];
---

<style is:global>
  /* Hide the global background grid pattern on this page only */
  .animated-bg__grid { display: none; }

  /* More-prominent related-service pills — match challenge-card-v2 green treatment */
  #related-services .related-service-link,
  #geo-by-centre-type .related-service-link {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.35);
    color: var(--text);
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  #related-services .related-service-link:hover,
  #geo-by-centre-type .related-service-link:hover {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.22) 0%, rgba(73, 184, 137, 0.1) 100%), rgba(20, 28, 32, 0.7);
    border-color: rgba(73, 184, 137, 0.6);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(73, 184, 137, 0.3);
  }

  /* Separate the CTA section from related-services with bg-alt */
  .service-cta-section {
    background: var(--bg-alt) !important;
  }

  /* Enrolment Funnel — 5-stage horizontal flow with green accents */
  .renovation-funnel {
    list-style: none;
    padding: 0;
    margin: 56px 0 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 48px;
    counter-reset: funnel;
  }
  .funnel-stage {
    position: relative;
    text-align: center;
    padding: 28px 20px;
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.28);
    border-radius: 12px;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .funnel-stage:hover {
    transform: translateY(-4px);
    border-color: rgba(73, 184, 137, 0.55);
    box-shadow: 0 16px 40px -16px rgba(73, 184, 137, 0.3);
  }
  .funnel-stage h3 {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--accent);
    margin: 0 0 8px 0;
    letter-spacing: -0.01em;
  }
  .funnel-stage p {
    font-size: 0.82rem;
    color: var(--text);
    line-height: 1.5;
    margin: 0;
  }
  .funnel-stage:not(:last-child)::after {
    content: '→';
    position: absolute;
    right: -34px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--accent);
    font-size: 1.6rem;
    font-weight: 500;
    z-index: 2;
    line-height: 1;
    opacity: 0.7;
  }
  @media (max-width: 900px) {
    .renovation-funnel {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }
    .funnel-stage:nth-child(2n)::after,
    .funnel-stage:last-child::after {
      display: none;
    }
    .funnel-stage:nth-child(2n-1)::after {
      right: -22px;
    }
  }
  @media (max-width: 600px) {
    .renovation-funnel {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .funnel-stage::after {
      display: none;
    }
  }
</style>

<ServiceLayout
  title="GEO Agency for Education Singapore"
  description="GEO agency for education businesses in Singapore — tuition, enrichment, preschools and music schools named when parents ask ChatGPT and Gemini."
  canonical="https://jraftcreative.com/education-ai-search-optimisation-singapore/"
  ogTitle="GEO Agency for Education Singapore"
  ogDescription="AI search optimisation for Singapore education providers. Get your programmes named when parents ask ChatGPT, Gemini and Perplexity."
  ogImage="https://jraftcreative.com/images/og-webdev.jpg"
  keywords="geo agency for education, education ai search optimisation singapore, ai search optimisation for education, education chatgpt optimisation, generative engine optimisation education singapore, Jraft Creative"
  schemaData={schemaData}
  heroLabel="GEO Agency for Education"
  heroTitle='GEO Agency for <span class="highlight">Education Businesses in Singapore</span>'
  heroSubtitle="Parents now ask an AI which centre to send their child to, and the answer names two or three. If you run several programmes under one brand, the risk is worse — an assistant that can't tell your enrichment from your tuition recommends neither."
  heroImage="/images/service-education.webp"
  heroImageAlt="Students in a Singapore education centre — education AI search optimisation"
  heroButtons={[
    { text: "Get an AI Visibility Audit", href: "/contact/", class: "btn btn-primary" },
    { text: "See Education SEO", href: "/education-seo-singapore/", class: "btn btn-secondary" }
  ]}
  whatsappText="Hi Jraft Creative, I'd like to know if my education business shows up in AI search."
  ctaLabel="Be the Answer"
  ctaTitle="Find Out What AI Says About Your Centre"
  ctaDescription="Book a free consultation and we'll run the prompts a real parent would use — by subject, level, programme and neighbourhood — across ChatGPT, Gemini and Perplexity, and show you where each of your programmes currently stands. We'll get back to you within 24 hours."
  ctaButtons={[
    { text: "Get an AI Visibility Audit", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%27d%20like%20to%20know%20if%20my%20education%20business%20shows%20up%20in%20AI%20search.", class: "btn btn-secondary" }
  ]}
  hideDefaultCta={false}
>

  <!-- ========== THE CHALLENGE ========== -->
  <section class="section" id="challenge" aria-label="AI search challenges for education businesses in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Challenge</p>
        <h2>One Brand, <span class="highlight">Several Programmes</span> — and AI Can't Tell Them <span class="highlight">Apart</span></h2>
      </div>
      <div class="section-content reveal">
        <p>The bigger your programme range, the easier it is for an assistant to describe you as nothing in particular.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Blurred Programme Identity</h3>
            <p>Tuition, enrichment and preschool described in one paragraph gives a model nothing to match against a parent asking about a specific level.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Branches That Don't Exist to AI</h3>
            <p>Multi-outlet groups often have one address in their data. Ask about a neighbourhood you operate in and the assistant names a competitor.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Ranking Well Changes Nothing</h3>
            <p>A centre can hold page one on Google and never be cited by ChatGPT. Generated answers weigh structure and corroboration, not position.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHAT WE DELIVER ========== -->
  <section class="section" id="sub-services" style="background: var(--bg-alt);" aria-label="GEO services for education businesses">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">What We Deliver</p>
        <h2>Six <span class="highlight">GEO Workstreams</span> for <span class="highlight">Education Groups</span></h2>
      </div>
      <div class="section-content reveal">
        <p>We separate your programmes, levels and branches into things a machine can tell apart — then measure whether it worked.</p>
      </div>
      <div class="service-details-grid deliver-grid">
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-seo-audit.webp');">
          <div class="service-detail-card__content">
            <h3>AI Visibility Audit</h3>
            <p>We run the prompts parents actually use across ChatGPT, Gemini and Perplexity, per programme, and record where you appear.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-onpage-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Programme &amp; Course Entities</h3>
            <p>Each programme becomes a distinct structured entity — subject, level, age range, format — instead of a line in a shared blurb.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-local-seo.webp');">
          <div class="service-detail-card__content">
            <h3>Multi-Branch Location Data</h3>
            <p>Every outlet gets its own entity and profile, so a neighbourhood question returns your centre rather than the chain down the road.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-content-strategy.webp');">
          <div class="service-detail-card__content">
            <h3>Parent-Question Answer Content</h3>
            <p>Direct answers to what parents actually ask about streaming, levels and timing — written in the form models quote back.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-campaign-analytics.webp');">
          <div class="service-detail-card__content">
            <h3>Prompt Monitoring by Programme</h3>
            <p>Tracked prompts per subject, level and branch, re-run monthly, so visibility is measured per programme rather than in aggregate.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-analytics-reporting.webp');">
          <div class="service-detail-card__content">
            <h3>Multi-Platform Coverage</h3>
            <p>ChatGPT, Gemini, Perplexity and Google AI Mode cite differently. We work all four rather than optimising for one.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== GEO BY CENTRE TYPE — hub to niche spokes ========== -->
  <section class="section" id="geo-by-centre-type" aria-label="GEO by education centre type">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">By Centre Type</p>
        <h2><span class="highlight">AI Search</span> Built for Your Type of <span class="highlight">Centre</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Each segment gets asked different questions. Where we've built the detail out, it lives on its own page.</p>
      </div>
      <div class="related-services-grid reveal">
          <a href="/education-website-design-singapore/" class="related-service-link">Education Website Design</a>
          <a href="/tuition-centre-ai-search-optimisation-singapore/" class="related-service-link">GEO for Tuition Centres</a>
          <a href="/music-school-ai-search-optimisation-singapore/" class="related-service-link">GEO for Music Schools</a>
          <a href="/preschool-ai-search-optimisation-singapore/" class="related-service-link">GEO for Preschools</a>
          <a href="/geo-agency-singapore/" class="related-service-link">The Full GEO Programme</a>
      </div>
    </div>
  </section>

  <!-- ========== WHY US ========== -->
  <section class="section" id="why-us" style="background: var(--bg-alt);" aria-label="Why choose Jraft Creative as your education GEO agency">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2>A <span class="highlight">GEO Agency</span> That Has Been <span class="highlight">Cited Itself</span></h2>
      </div>
      <div class="section-content reveal">
        <p>We run this on our own site and publish the method rather than treating it as a black box.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>We've Earned AI Citations</h3>
            <p>We wrote up <a href="/blog/how-we-got-cited-in-google-ai-overview-singapore/">how we got cited in Google's AI Overview</a> for niche Singapore queries — method, not marketing.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>We Already Run Education Search</h3>
            <p>We handle <a href="/education-seo-singapore/">SEO</a> and <a href="/education-google-ads-singapore/">Google Ads</a> for centres across Singapore, so we know which parent questions convert.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Measured, Not Claimed</h3>
            <p>Baseline first, monthly re-runs after. If visibility hasn't moved on a programme, the report says so.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== ENROLMENT FUNNEL ========== -->
  <section class="section" id="buyer-funnel" aria-label="Where AI search fits the parent journey">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Enrolment Funnel</p>
        <h2>Where <span class="highlight">AI Search</span> Fits the <span class="highlight">Parent Journey</span></h2>
      </div>
      <div class="section-content reveal" style="margin-bottom: 24px;">
        <p>AI has moved to the front of the journey. Where a parent once opened Google and browsed, many now ask an assistant for a shortlist — so the field narrows before your website is ever opened.</p>
      </div>
      <ol class="renovation-funnel reveal">
        <li class="funnel-stage">
          <h3>Ask</h3>
          <p>A parent asks an AI which centre suits their child</p>
        </li>
        <li class="funnel-stage">
          <h3>Shortlist</h3>
          <p>Two or three centres get named — or you don't</p>
        </li>
        <li class="funnel-stage">
          <h3>Validate</h3>
          <p>They check results, teachers and reviews</p>
        </li>
        <li class="funnel-stage">
          <h3>Trial</h3>
          <p>The shortlist turns into a booked trial class</p>
        </li>
        <li class="funnel-stage">
          <h3>Enrol</h3>
          <p>Sign for the term, renew &amp; refer</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ========== FAQ ========== -->
  <section class="section faq-section" id="faq" style="background: var(--bg-alt);" aria-label="Frequently asked questions about GEO for education businesses">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">FAQ</p>
        <h2>GEO for <span class="highlight">Education</span> — Questions Answered</h2>
      </div>
      <div class="faq-list">
        <details class="faq-item reveal reveal-d1">
          <summary>What is GEO for an education business?</summary>
          <div class="faq-answer"><p>Generative Engine Optimisation is the work of getting your centre named when a parent asks an AI assistant rather than searching Google. Ask ChatGPT for the best enrichment programme for a P3 child in Bishan and you get a shortlist of two or three names, not a page of results. GEO is about being on that shortlist, which depends on different signals from traditional SEO.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>We run several programmes under one brand. Does that help or hurt?</summary>
          <div class="faq-answer"><p>It hurts by default and helps once it's structured. A group running tuition, enrichment and a preschool usually describes everything in one blurred paragraph, so an AI can't tell which programme answers which question. Mapping each programme, level and branch as a distinct entity is what lets a model surface the right one for the right parent.</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>How is this different from the SEO we already pay for?</summary>
          <div class="faq-answer"><p>SEO earns a ranking position; GEO earns a mention inside a generated answer. Ranking factors still matter, but AI systems lean far more on structured data, entity clarity and whether your claims are corroborated elsewhere. A centre can rank on page one and still never be named by an assistant — that's the gap this closes.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>Can you prove it is working?</summary>
          <div class="faq-answer"><p>Yes. We track a set of prompts a real parent would use — by subject, level, programme and neighbourhood — across ChatGPT, Gemini, Perplexity and Google AI Mode, then re-run them monthly. You get a visibility baseline and a movement report, including how your centre is being described when it does appear.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>Is it too early to invest in this?</summary>
          <div class="faq-answer"><p>It's early, which is the argument for moving now. Very few Singapore education providers have done any of this work, so the bar is far lower than it has been in Google search for years. The centres that establish clean entity data early are the ones assistants keep citing as parent adoption grows.</p></div>
        </details>
      </div>
    </div>
  </section>

  <!-- Related Services -->
  <section class="section" id="related-services" aria-label="Related services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Explore More</p>
        <h2>More <span class="highlight">Education</span> Services</h2>
      </div>
      <div class="related-services-grid reveal">
          <a href="/education-seo-singapore/" class="related-service-link">Education SEO</a>
          <a href="/education-google-ads-singapore/" class="related-service-link">Education Google Ads</a>
          <a href="/education-social-media-marketing-singapore/" class="related-service-link">Education Social Media</a>
          <a href="/education-content-marketing-singapore/" class="related-service-link">Education Content Marketing</a>
          <a href="/education-branding-agency-singapore/" class="related-service-link">Education Branding</a>
          <a href="/education-marketing-agency-singapore/" class="related-service-link">Full-Service Education Marketing</a>
      </div>
    </div>
  </section>
</ServiceLayout>
