---
import ServiceLayout from '../layouts/ServiceLayout.astro';

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Childcare Centre Website Design Singapore",
    "description": "Custom website design for childcare centres in Singapore — programme pages by age, enrolment and waitlist forms, centre-visit booking, ECDA licence and subsidy info, and local SEO.",
    "provider": {
      "@type": "Organization",
      "name": "Jraft Creative",
      "url": "https://jraftcreative.com/",
      "logo": "https://jraftcreative.com/images/logo.png",
      "telephone": "+6582234578",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "60 Paya Lebar Road, Paya Lebar Square",
        "postalCode": "409051",
        "addressLocality": "Singapore",
        "addressCountry": "SG"
      }
    },
    "areaServed": { "@type": "Country", "name": "Singapore" },
    "serviceType": "Childcare Centre Website Design"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How much does a childcare centre website cost in Singapore?", "acceptedAnswer": { "@type": "Answer", "text": "Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote." } },
      { "@type": "Question", "name": "Can parents submit enrolment and waitlist applications online?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We build online enrolment and waitlist forms directly into your website. Parents choose their preferred programme — infant care, playgroup, nursery, or full-day kindergarten — submit their child's details and preferred start date, and receive automated confirmation emails. That reduces phone calls and walk-in admin for your front desk staff." } },
      { "@type": "Question", "name": "Can you display our ECDA licence and subsidy details on the website?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We prominently display your ECDA licence number, SPARK certification, and subsidy and Baby Bonus eligibility on your website. Parents actively check for these when shortlisting centres, so visible, accurate compliance builds trust and sets you apart from unlicensed operators." } },
      { "@type": "Question", "name": "Can you help our centre rank for 'childcare near me' on Google?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We build every site with local SEO fundamentals — location-specific keywords, Google Business Profile optimisation, structured-data markup, and neighbourhood targeting. This helps your centre show up for searches like 'infant care Punggol', 'childcare near Tampines', or 'playgroup Bishan' so nearby parents find you first." } },
      { "@type": "Question", "name": "How long does it take to build a childcare centre website?", "acceptedAnswer": { "@type": "Answer", "text": "Most childcare centre websites go live within 2 weeks for a Starter build. Sites with programme pages, enrolment and tour-booking forms, and a consent-gated photo gallery typically take 3 weeks, while larger multi-centre builds with parent portals take 4–5 weeks. We give you a clear timeline before starting so you can plan around your enrolment cycle." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jraftcreative.com/" },
      { "@type": "ListItem", "position": 2, "name": "Childcare Centre Website Singapore", "item": "https://jraftcreative.com/childcare-centre-website-singapore/" }
    ]
  }
];
---

<style is:global>
  /* Hide the global background grid pattern on this page only */
  .animated-bg__grid { display: none; }

  /* More-prominent related-service pills — match challenge-card-v2 green treatment */
  #related-services .related-service-link {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.35);
    color: var(--text);
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  #related-services .related-service-link:hover {
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.22) 0%, rgba(73, 184, 137, 0.1) 100%), rgba(20, 28, 32, 0.7);
    border-color: rgba(73, 184, 137, 0.6);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px rgba(73, 184, 137, 0.3);
  }

  /* Separate the CTA section from related-services with bg-alt */
  .service-cta-section {
    background: var(--bg-alt) !important;
  }

  /* Trial-to-Enrolment Funnel — 5-stage horizontal flow with green accents */
  .renovation-funnel {
    list-style: none;
    padding: 0;
    margin: 56px 0 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 48px;
    counter-reset: funnel;
  }
  .funnel-stage {
    position: relative;
    text-align: center;
    padding: 28px 20px;
    background: linear-gradient(135deg, rgba(73, 184, 137, 0.14) 0%, rgba(73, 184, 137, 0.06) 100%), rgba(20, 28, 32, 0.6);
    border: 1px solid rgba(73, 184, 137, 0.28);
    border-radius: 12px;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .funnel-stage:hover {
    transform: translateY(-4px);
    border-color: rgba(73, 184, 137, 0.55);
    box-shadow: 0 16px 40px -16px rgba(73, 184, 137, 0.3);
  }
  .funnel-stage h3 {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--accent);
    margin: 0 0 8px 0;
    letter-spacing: -0.01em;
  }
  .funnel-stage p {
    font-size: 0.82rem;
    color: var(--text);
    line-height: 1.5;
    margin: 0;
  }
  .funnel-stage:not(:last-child)::after {
    content: '→';
    position: absolute;
    right: -34px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--accent);
    font-size: 1.6rem;
    font-weight: 500;
    z-index: 2;
    line-height: 1;
    opacity: 0.7;
  }
  @media (max-width: 900px) {
    .renovation-funnel {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }
    .funnel-stage:nth-child(2n)::after,
    .funnel-stage:last-child::after {
      display: none;
    }
    .funnel-stage:nth-child(2n-1)::after {
      right: -22px;
    }
  }
  @media (max-width: 600px) {
    .renovation-funnel {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .funnel-stage::after {
      display: none;
    }
  }
</style>

<ServiceLayout
  title="Childcare Centre Website Singapore — Web Design"
  description="Web design agency for childcare centres in Singapore — enrolment and waitlist forms, programme pages by age, ECDA licence display, tour booking."
  canonical="https://jraftcreative.com/childcare-centre-website-singapore/"
  ogTitle="Childcare Centre Website Singapore — Web Design"
  ogDescription="Custom website design for childcare centres in Singapore. Programme pages by age, enrolment and waitlist forms, ECDA licence display, and centre-visit booking."
  ogImage="https://jraftcreative.com/images/og-childcare.jpg"
  keywords="web design agency for childcare centres, childcare centre website design singapore, childcare website singapore, infant care website singapore, preschool website design singapore, daycare website design, Jraft Creative"
  schemaData={schemaData}
  heroLabel="Web Design Agency for Childcare Centres"
  heroTitle='Web Design Agency for <span class="highlight">Childcare Centres in Singapore</span>'
  heroSubtitle="Parents research childcare options online long before they book a visit. We build mobile-first websites that lay out your programmes by age, show your ECDA licence and safety routines, and make it easy to enquire, join a waitlist, or book a centre visit — so a parent's visit becomes a booked tour, not a bounce."
  heroImage="/images/service-childcare.webp"
  heroImageAlt="Teacher reading with a young child at a Singapore childcare centre"
  heroButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "See Childcare SEO", href: "/childcare-centre-seo-singapore/", class: "btn btn-secondary" }
  ]}
  whatsappText="Hi Jraft Creative, I need a website for my childcare centre in Singapore."
  ctaLabel="Ready to Fill Your Next Intake?"
  ctaTitle="Get Your Childcare Centre Online"
  ctaDescription="Tell us about your centre and we'll recommend the right website scope. Free consultation — no obligations, no pressure."
  ctaButtons={[
    { text: "Book Your Consultation", href: "/contact/", class: "btn btn-primary" },
    { text: "Chat on WhatsApp", href: "https://wa.me/6582234578?text=Hi%20Jraft%20Creative%2C%20I%20need%20a%20website%20for%20my%20childcare%20centre%20in%20Singapore.", class: "btn btn-secondary" }
  ]}
  hideDefaultCta={false}
>

  <!-- ========== THE CHALLENGE ========== -->
  <section class="section" id="challenge" aria-label="Website challenges for childcare centres in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Challenge</p>
        <h2>Parents Are <span class="highlight">Shortlisting</span> — Before They Ever <span class="highlight">Visit Your Centre</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Families start their search months ahead, comparing centres side by side — programmes, routines, licence, fees — long before they call or walk in. This sits alongside our broader <a href="/industries/education/">education marketing in Singapore</a>, and the fundamentals in our guide to <a href="/blog/good-business-website-singapore/">what makes a good business website</a> apply here too.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>A Facebook Page Isn't Enough</h3>
            <p>Parents want programmes by age, daily routines, your ECDA licence and a way to enquire in one place. A directory listing or an outdated page answers none of it.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Parents Research Thoroughly</h3>
            <p>They check licence and SPARK status, read the daily schedule, look at safety and staff, and weigh subsidy and Baby Bonus. Anything missing is a reason to choose someone else.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>First Impressions Decide It</h3>
            <p>From Punggol to Jurong, the heartland childcare market is crowded. Your site is what decides whether a parent books a visit or scrolls to the centre down the road.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHAT WE BUILD ========== -->
  <section class="section" id="sub-services" style="background: var(--bg-alt);" aria-label="Childcare centre website design services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">What We Build</p>
        <h2>Six <span class="highlight">Pillars</span> of a Childcare Centre <span class="highlight">Website</span></h2>
      </div>
      <div class="section-content reveal">
        <p>Every site is built to turn a browsing parent into a booked centre visit or waitlist enquiry, not just to look good. It also pairs with <a href="/childcare-centre-seo-singapore/">childcare SEO</a>, <a href="/childcare-social-media-singapore/">social media</a>, and <a href="/childcare-centre-advertising-singapore/">advertising</a> as one system for filling your intake.</p>
      </div>
      <div class="service-details-grid deliver-grid">
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-business-website.webp');">
          <div class="service-detail-card__content">
            <h3>Programme Pages by Age</h3>
            <p>A page per programme — infant care, playgroup, nursery, full-day kindergarten — covering curriculum approach, learning goals and enrichment, so parents know exactly what their child's day looks like.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-landing-page.webp');">
          <div class="service-detail-card__content">
            <h3>Enquiry, Waitlist &amp; Tour Booking</h3>
            <p>Parents enquire, join the waitlist, or book a centre visit directly from the site — any time. Forms capture the child's age, preferred programme and start date, with automated confirmations that cut admin.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-local-seo.webp');">
          <div class="service-detail-card__content">
            <h3>ECDA Licence &amp; Subsidy Info</h3>
            <p>Clear pages for your ECDA licence and SPARK status, plus subsidy and Baby Bonus guidance. Parents verify these when shortlisting, and visible, accurate compliance builds trust straight away.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d1" style="background-image: url('/images/detail-graphic-design.webp');">
          <div class="service-detail-card__content">
            <h3>Safety &amp; Daily Routine Pages</h3>
            <p>Drop-off and pick-up, meals and nap times, health and hygiene, teacher-to-child ratios — the details that reassure a parent their child is in safe, capable hands every day.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d2" style="background-image: url('/images/detail-reels-video.webp');">
          <div class="service-detail-card__content">
            <h3>Teacher Profiles &amp; Photo Gallery</h3>
            <p>Profiles for your educators — qualifications, experience and approach — alongside a consent-gated photo gallery of classrooms and outdoor spaces, so images only go live once permission is in place.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 deliver-card-with-bg reveal reveal-d3" style="background-image: url('/images/detail-speed-vitals.webp');">
          <div class="service-detail-card__content">
            <h3>Mobile-First, Search-Ready</h3>
            <p>Clean structure, fast mobile loads and schema built in from day one — because most parent searches happen on a phone, and the site should be ready to rank rather than needing rescuing later.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHY US ========== -->
  <section class="section" id="why-us" aria-label="Why choose Jraft Creative as your childcare centre web design agency">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Why Jraft Creative</p>
        <h2>A <span class="highlight">Web Design Agency</span> That Knows <span class="highlight">Childcare Centres</span></h2>
      </div>
      <div class="section-content reveal">
        <p>We build for the specific problem childcare centres have — competing locally, then turning an enquiry into a booked visit and a place in your next intake.</p>
      </div>
      <div class="service-details-grid challenge-grid-v2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div class="service-detail-card challenge-card-v2 reveal reveal-d1">
          <div class="service-detail-card__content">
            <h3>Early-Childhood Experience</h3>
            <p>We understand Singapore's childcare landscape — ECDA licensing, SPARK, and the subsidy and Baby Bonus frameworks — and design around how parents actually decide, from online research to centre visit.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d2">
          <div class="service-detail-card__content">
            <h3>Live Before Your Next Intake</h3>
            <p>Most childcare centre sites go live within two weeks, so you start capturing enquiries and tour bookings before the next enrolment cycle rather than after it.</p>
          </div>
        </div>
        <div class="service-detail-card challenge-card-v2 reveal reveal-d3">
          <div class="service-detail-card__content">
            <h3>Website, SEO &amp; Ads Together</h3>
            <p>We also run <a href="/childcare-centre-seo-singapore/">childcare SEO</a> and <a href="/childcare-centre-advertising-singapore/">childcare advertising</a> — one system for filling your waitlist across Sengkang, Woodlands and beyond.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== ENROLMENT FUNNEL ========== -->
  <section class="section" id="buyer-funnel" style="background: var(--bg-alt);" aria-label="Where your website fits the childcare parent journey">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">The Enrolment Funnel</p>
        <h2>Where Your <span class="highlight">Website</span> Fits the <span class="highlight">Parent Journey</span></h2>
      </div>
      <div class="section-content reveal" style="margin-bottom: 24px;">
        <p>Parents move through the same five stages before a child starts. Your website carries the middle three — it is where a parent validates your licence and safety, compares you against the shortlist, and finally books the centre visit.</p>
      </div>
      <ol class="renovation-funnel reveal">
        <li class="funnel-stage">
          <h3>Discover</h3>
          <p>A search or referral brings them to the site</p>
        </li>
        <li class="funnel-stage">
          <h3>Validate</h3>
          <p>ECDA licence, safety routines, teacher profiles</p>
        </li>
        <li class="funnel-stage">
          <h3>Compare</h3>
          <p>Programme pages answer age, routine and fit</p>
        </li>
        <li class="funnel-stage">
          <h3>Visit</h3>
          <p>Booking form turns interest into a scheduled tour</p>
        </li>
        <li class="funnel-stage">
          <h3>Enrol</h3>
          <p>Join the waitlist or confirm a place &amp; refer</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ========== PRICING ========== -->
  <!-- ========== FAQ ========== -->
  <section class="section faq-section" id="faq" style="background: var(--bg-alt);" aria-label="Frequently asked questions about childcare centre website design in Singapore">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">FAQ</p>
        <h2>Childcare Centre <span class="highlight">Website</span> Questions Answered</h2>
      </div>
      <div class="faq-list">
        <details class="faq-item reveal reveal-d1">
          <summary>How much does a childcare centre website cost in Singapore?</summary>
          <div class="faq-answer"><p>Pricing depends on your goals, your market, and the scope of work — there's no one-size package. Book a quick consultation and we'll scope exactly what you need and give you a transparent quote.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>Can parents submit enrolment and waitlist applications online?</summary>
          <div class="faq-answer"><p>Yes. We build online enrolment and waitlist forms directly into your website. Parents choose their preferred programme — infant care, playgroup, nursery, or full-day kindergarten — submit their child's details and preferred start date, and receive automated confirmation emails. That reduces phone calls and walk-in admin for your front desk staff.</p></div>
        </details>
        <details class="faq-item reveal reveal-d3">
          <summary>Can you display our ECDA licence and subsidy details on the website?</summary>
          <div class="faq-answer"><p>Yes. We prominently display your ECDA licence number, SPARK certification, and subsidy and Baby Bonus eligibility on your website. Parents actively check for these when shortlisting centres, so visible, accurate compliance builds trust and sets you apart from unlicensed operators.</p></div>
        </details>
        <details class="faq-item reveal reveal-d1">
          <summary>Can you help our centre rank for "childcare near me" on Google?</summary>
          <div class="faq-answer"><p>Yes. We build every site with local SEO fundamentals — location-specific keywords, Google Business Profile optimisation, structured-data markup, and neighbourhood targeting. This helps your centre show up for searches like "infant care Punggol", "childcare near Tampines", or "playgroup Bishan" so nearby parents find you first.</p></div>
        </details>
        <details class="faq-item reveal reveal-d2">
          <summary>How long does it take to build a childcare centre website?</summary>
          <div class="faq-answer"><p>Most childcare centre websites go live within 2 weeks for a Starter build. Sites with programme pages, enrolment and tour-booking forms, and a consent-gated photo gallery typically take 3 weeks, while larger multi-centre builds with parent portals take 4-5 weeks. We give you a clear timeline before starting so you can plan around your enrolment cycle.</p></div>
        </details>
      </div>
    </div>
  </section>


  <!-- Related Services -->
  <section class="section" id="related-services" aria-label="Related services">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-label">Explore More</p>
        <h2>More <span class="highlight">Childcare</span> Services</h2>
      </div>
      <div class="related-services-grid reveal">
          <a href="/childcare-marketing-singapore/" class="related-service-link">Childcare Marketing</a>
          <a href="/childcare-centre-seo-singapore/" class="related-service-link">Childcare SEO</a>
          <a href="/childcare-centre-ai-search-optimisation-singapore/" class="related-service-link">Childcare GEO</a>
          <a href="/childcare-centre-advertising-singapore/" class="related-service-link">Childcare Advertising</a>
          <a href="/childcare-social-media-singapore/" class="related-service-link">Childcare Social Media</a>
      </div>
    </div>
  </section>
</ServiceLayout>
